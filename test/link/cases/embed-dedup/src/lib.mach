# a second module embedding byte-identical content. its declaration is the one
# this case is about: within a module they already share a placement, but the object
# boundary lost the embed marker, so the final linker concatenated the bytes twice
use case.libb;

#[embed("asset_dup.bin")]
pub val LIB_ASSET: [_]u8;

#[embed("asset_other.bin")]
pub val LIB_OTHER: [_]u8;

pub fun lib_sum() i64 {
    ret (LIB_ASSET[0])::i64 + (LIB_OTHER[0])::i64 + libb.libb_sum();
}
