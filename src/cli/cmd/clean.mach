# what a clean entry names
def EntryKind: u8;

# a directory tree
val ENTRY_DIR: EntryKind = 0;
# a single file
val ENTRY_FILE: EntryKind = 1;

# one path `mach clean` removes
# ---
# rel:  the path relative to the project root, as the manifest templates expand it
# kind: ENTRY_DIR or ENTRY_FILE
rec CleanEntry {
    rel:  str;
    kind: EntryKind;
}

# `mach clean`
pub val COMMAND: args.CommandSpec = args.CommandSpec{name: "clean", aliases: nil, alias_n: 0, grammar: " <path>", summary: "remove project build output", effect: "remove every artifact and every object, IR, assembly, test, cache, staging and dependency tree a build of every cell writes, as the build plans it; a dependency never pulled was never built and adds nothing", exits: nil, exit_n: 0, terminator: "", tables: nil, table_n: 0, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: args.OPERANDS_ANY, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: run};

# `mach clean`: remove every path a build of every cell writes, as the build
# plans it: each artifact's output and the object, IR, assembly, test, cache,
# staging and dependency trees beneath each cell's work directory, dependency
# requirement cells included; a dependency never realized was never built, so
# it adds no cell. they are sorted, collapsed under their ancestors,
# and removed inside the project root; a path that escapes the root or crosses a symlink is refused. a missing path is
# not an error; "nothing to clean" prints when nothing was removed
# ---
# cx:  the call
# ret: exit.OK, or the shared code of the failure: exit.USER for a manifest error or an escaping
#      target, exit.INTERNAL for an allocator failure, exit.ENVIRONMENT for a read or removal
#      failure; a removal that fails is reported and the rest are still attempted
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    var arg: *u8 = nil;
    if (cx.inv.has_positional) { arg = cx.argv[cx.inv.positional_idx]; }
    val loc_r: res[util.ProjectLocation, fail.Fail] = util.resolve_project_location(cx.a, arg);
    if (sel loc_r.err) { ret res[i64, fail.Fail].err{loc_r.err}; }
    ret res[i64, fail.Fail].ok{clean_project(cx.report, cx.a, loc_r.ok.root)};
}

fun clean_project(r: *cli_diagnostic.Report, a: *A.Allocator, root: *u8) i64 {
    val plan_r: res[Vector[CleanEntry], fail.Fail] = build_clean_plan(a, root::str);
    if (sel plan_r.err) { ret cli_diagnostic.report_fail(r, plan_r.err, diagnostic.ORIGIN_NONE); }
    var plan: Vector[CleanEntry] = plan_r.ok;

    var removed: usize = 0;
    val code:    i64   = execute_plan(r, a, root::str, plan.data, plan.len, ?removed);
    collections_vector.dnit[CleanEntry](?plan);

    if (removed == 0 && code == exit.OK) { print.println("nothing to clean"); }
    ret code;
}

# every path a build of the project writes, relative to `root`: each cell is
# planned as `mach build --all` plans it, one plan per profile, and each
# planned unit names its artifact and the trees the build owns beneath its
# work directory. the planning session is torn down before this returns
# ---
# a:   owns the entries and a refusal
# ret: the entries, sorted and collapsed under their ancestors; err from
#      loading the manifest or planning
fun build_clean_plan(a: *A.Allocator, root: str) res[Vector[CleanEntry], fail.Fail] {
    val made: res[session.Session, fail.Fail] = toolchain.session_init(a);
    if (sel made.err) { ret res[Vector[CleanEntry], fail.Fail].err{made.err}; }
    var ps:      session.Session                    = made.ok;
    val written: res[Vector[CleanEntry], fail.Fail] = planned_entries(a, ?ps, root);
    if (sel written.ok) {
        session.dnit(?ps);
        ret written;
    }
    var kept: fail.Fail               = fail.message("failed to retain the clean planning error");
    val held: res[fail.Fail, A.Error] = fail.retain(a, written.err);
    if (sel held.ok) { kept = held.ok; }
    session.dnit(?ps);
    ret res[Vector[CleanEntry], fail.Fail].err{kept};
}

fun planned_entries(a: *A.Allocator, ps: *session.Session, root: str) res[Vector[CleanEntry], fail.Fail] {
    val loaded: res[manifest.Manifest, fail.Fail] = driver.load_manifest(ps, root);
    if (sel loaded.err) { ret res[Vector[CleanEntry], fail.Fail].err{loaded.err}; }
    var m:   manifest.Manifest = loaded.ok;
    var cli: args.CliArgs;
    cli.verbosity     = 0;
    cli.quiet         = true;
    cli.overrides     = request.overrides_init(ps.alloc);
    cli.selectors     = manifest.selectors_init(ps.alloc);
    cli.selectors.all = true;
    # a dependency never realized was never built, so it adds no cell
    val planned_r: res[build.Planned, fail.Fail] = build.plan_selection(ps.alloc, ps, ?m, root, ?cli,
        request.GOAL_ARTIFACT, manifest.ARTIFACT_DEFAULT_SET, false, driver_closure.UNREALIZED_UNBUILT);
    if (sel planned_r.err) { ret res[Vector[CleanEntry], fail.Fail].err{planned_r.err}; }
    val planned: build.Planned = planned_r.ok;

    var raw: Vector[CleanEntry] = collections_vector.init[CleanEntry](a);
    fin { collections_vector.dnit[CleanEntry](?raw); }
    var pi: usize = 0;
    for (pi < planned.plans.len) {
        val bp: *build_plan.BuildPlan = ?planned.plans.data[pi];
        var ui: usize                 = 0;
        for (ui < bp.units.len) {
            val unit:  *build_plan.BuildUnit = ?bp.units.data[ui];
            val wrote: err[fail.Fail]        = push_unit(a, ps.alloc, root, ?raw, unit);
            if (sel wrote.err) { ret res[Vector[CleanEntry], fail.Fail].err{wrote.err}; }
            ui = ui + 1;
        }
        pi = pi + 1;
    }
    ret normalize_and_collapse(a, ?raw);
}

# a unit's artifact and every tree the build owns beneath its work directory
fun push_unit(a: *A.Allocator, scratch: *A.Allocator, root: str, raw: *Vector[CleanEntry], u: *build_plan.BuildUnit) err[fail.Fail] {
    val artifact: err[fail.Fail] = push_written(a, root, raw, u.out_path, ENTRY_FILE);
    if (sel artifact.err) { ret artifact; }
    var t: u32 = 0;
    for (t < layout.TREE_COUNT) {
        val tree: res[str, fail.Fail] = layout.under(scratch, u.out_dir, layout.TREES[t]);
        if (sel tree.err) { ret err[fail.Fail].err{tree.err}; }
        val pushed: err[fail.Fail] = push_written(a, root, raw, tree.ok, ENTRY_DIR);
        if (sel pushed.err) { ret pushed; }
        t = t + 1;
    }
    ret err[fail.Fail].ok{};
}

# `path`, which the build placed beneath `root`, as the root-relative entry clean removes
fun push_written(a: *A.Allocator, root: str, v: *Vector[CleanEntry], path: str, kind: EntryKind) err[fail.Fail] {
    if (str_empty(path)) { ret err[fail.Fail].ok{}; }
    var start: usize = str_len(root);
    if (start > 0 && root[start - 1] != '/'::u8) { start = start + 1; }
    val n: usize = str_len(path);
    if (n <= start || !str_starts_with(path, root) || path[start - 1] != '/'::u8) {
        ret err[fail.Fail].err{fail.formatted_user(a, diagnostic_kind.CLEAN_PATH_INVALID, "clean target '{}' is not beneath the project root", path)};
    }
    val rel: res[str, types_string.StrError] = str_copy_slice(a, path, start, n - start);
    if (sel rel.err) { ret err[fail.Fail].err{fail.message(fail.str_text(rel.err))}; }
    ret push_entry(v, rel.ok, kind);
}

fun push_entry(v: *Vector[CleanEntry], rel: str, kind: EntryKind) err[fail.Fail] {
    if (str_empty(rel)) { ret err[fail.Fail].ok{}; }
    var e: CleanEntry;
    e.rel  = rel;
    e.kind = kind;
    val pr: res[usize, A.Error] = collections_vector.push[CleanEntry](v, e);
    if (sel pr.err) { ret err[fail.Fail].err{fail.refused(pr.err)}; }
    ret err[fail.Fail].ok{};
}

fun cmp_entry(x: *CleanEntry, y: *CleanEntry) i64 {
    ret str_compare(x.rel, y.rel);
}

fun is_ancestor(anc: str, cand: str) bool {
    val al: usize = str_len(anc);
    val cl: usize = str_len(cand);
    if (al >= cl)                    { ret false; }
    if (!str_starts_with(cand, anc)) { ret false; }
    ret cand[al] == '/'::u8;
}

fun normalize_and_collapse(a: *A.Allocator, raw: *Vector[CleanEntry]) res[Vector[CleanEntry], fail.Fail] {
    var out: Vector[CleanEntry] = collections_vector.init[CleanEntry](a);
    if (raw.len == 0) { ret res[Vector[CleanEntry], fail.Fail].ok{out}; }

    sort.sort_by[CleanEntry](raw.data, raw.len, cmp_entry);

    var i: usize = 0;
    for (i < raw.len) {
        val cur: CleanEntry = raw.data[i];
        if (out.len > 0) {
            val last: CleanEntry = out.data[out.len - 1];
            if (str_equals(cur.rel, last.rel)) {
                i = i + 1;
                cnt;
            }
            if (last.kind == ENTRY_DIR && is_ancestor(last.rel, cur.rel)) {
                i = i + 1;
                cnt;
            }
        }
        val pr: res[usize, A.Error] = collections_vector.push[CleanEntry](?out, cur);
        if (sel pr.err) {
            collections_vector.dnit[CleanEntry](?out);
            ret res[Vector[CleanEntry], fail.Fail].err{fail.refused(pr.err)};
        }
        i = i + 1;
    }
    ret res[Vector[CleanEntry], fail.Fail].ok{out};
}

# every target is validated as a canonical path beneath the project root
# before anything is removed, so a refused entry leaves the plan untouched
fun check_plan(entries: *CleanEntry, count: usize) err[fail.Fail] {
    var i: usize = 0;
    for (i < count) {
        if (!manifest.is_project_path(entries[i].rel)) { ret err[fail.Fail].err{fail.user(diagnostic_kind.CLEAN_PATH_INVALID, "clean target is not a canonical path beneath the project root")}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun execute_plan(r: *cli_diagnostic.Report, a: *A.Allocator, root: str, entries: *CleanEntry, count: usize, removed: *usize) i64 {
    val checked: err[fail.Fail] = check_plan(entries, count);
    if (sel checked.err) {
        val text: res[str, fail.Fail] = fail.format(a, "cannot reserve clean targets: {}", fail.describe(checked.err));
        if (sel text.err) { ret cli_diagnostic.report_fail(r, text.err, diagnostic.ORIGIN_NONE); }
        ret cli_diagnostic.report_fail(r, fail.with_text(checked.err, text.ok), diagnostic.ORIGIN_NONE);
    }
    var root_fd: usize = system_os.INVALID_HANDLE;
    val opened:  i64   = remove.open_path(root, ?root_fd);
    if (opened < 0) { ret cli_diagnostic.report_fail(r, fail.environment_of(diagnostic_kind.FS_OPEN, fail.format(a, "cannot open the project root: {}", system_os.error_message(opened))), diagnostic.ORIGIN_NONE); }
    fin { system_os.close(root_fd); }
    var code: i64   = exit.OK;
    var i:    usize = 0;
    for (i < count) {
        code = execute_entry(r, a, root_fd, ?entries[i], removed, code);
        i    = i + 1;
    }
    ret code;
}

fun execute_entry(r: *cli_diagnostic.Report, a: *A.Allocator, root_fd: usize, e: *CleanEntry, removed: *usize, code: i64) i64 {
    val rr: remove.Removal = remove.relative(root_fd, e.rel);
    if (rr.failed) {
        if (rr.kind == io_error.NOT_FOUND && !rr.containment) { ret code; }
        val text: res[str, fail.Fail] = fail.format(a, "cannot remove clean target '{}': {}", e.rel, remove.message(rr));
        if (rr.containment) { ret exit.worst(code, cli_diagnostic.report_fail(r, fail.user_of(diagnostic_kind.FS_REMOVE, text), diagnostic.ORIGIN_NONE)); }
        ret exit.worst(code, cli_diagnostic.report_fail(r, fail.environment_of(diagnostic_kind.FS_REMOVE, text), diagnostic.ORIGIN_NONE));
    }
    if (rr.removed == 0) { ret code; }

    print.print("removed ");
    print.println(e.rel);
    @removed = @removed + 1;
    ret code;
}

# a refusal carries no native code, and a clean target it stops is still an error
test execute_entry__a_removal_refusal_is_an_error {
    var r: cli_diagnostic.Report;
    cli_diagnostic.report_init(?r, cli_diagnostic.FORMAT_HUMAN);
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[output_testing.Output, fail.Fail] = output_testing.create(?a, "mach-clean-refusal");
    if (sel created.err) { ret 2; }
    var owner: output_testing.Output = created.ok;
    fin { output_testing.dnit(?owner); }
    var root: usize = system_os.INVALID_HANDLE;
    if (remove.open_path(owner.directory, ?root) < 0) { ret 3; }
    fin { system_os.close(root); }
    if (system_os.make_dir(root, "kept", 0o700) < 0) { ret 4; }
    val long: str = remove.t_component(?a, 256);
    if (long == nil) { ret 5; }
    var removed:  usize      = 0;
    var too_long: CleanEntry = CleanEntry{rel: long};
    if (execute_entry(?r, ?a, root, ?too_long, ?removed, 0) != exit.USER) { ret 6; }
    var trailing: CleanEntry = CleanEntry{rel: "kept/"};
    if (execute_entry(?r, ?a, root, ?trailing, ?removed, 0) != exit.USER) { ret 7; }
    var absent: CleanEntry = CleanEntry{rel: "absent"};
    if (execute_entry(?r, ?a, root, ?absent, ?removed, 0) != 0 || removed != 0) { ret 8; }
    var kept: CleanEntry = CleanEntry{rel: "kept"};
    if (execute_entry(?r, ?a, root, ?kept, ?removed, 0) != 0 || removed != 1) { ret 9; }
    ret 0;
}

# a clean target holding a name with no UTF-8 spelling, which only windows can
# hold, is removed whole: the removal walks the tree in native units
$if ($mach.build.os == $mach.os.windows) {
    test execute_entry__removes_a_tree_holding_a_name_with_no_utf8_spelling {
        var r: cli_diagnostic.Report;
        cli_diagnostic.report_init(?r, cli_diagnostic.FORMAT_HUMAN);
        var a:      A.Allocator;
        val make_r: err[A.Error] = page.make(?a);
        if (sel make_r.err) { ret 1; }
        val created: res[output_testing.Output, fail.Fail] = output_testing.create(?a, "mach-clean-unspellable");
        if (sel created.err) { ret 2; }
        var owner: output_testing.Output = created.ok;
        fin { output_testing.dnit(?owner); }
        var root: usize = system_os.INVALID_HANDLE;
        if (remove.open_path(owner.directory, ?root) < 0) { ret 3; }
        fin { system_os.close(root); }
        if (system_os.make_dir(root, "out", 0o700) < 0) { ret 4; }
        val out_r: res[str, A.Error] = types_path.join(?a, owner.directory, "out");
        if (sel out_r.err) { ret 5; }
        var out_fd: usize = system_os.INVALID_HANDLE;
        if (remove.open_dir(root, "out", ?out_fd) < 0) { ret 6; }
        var name: [4]u16;
        name[0] = 'a'::u16;
        name[1] = 0xd800;
        name[2] = 'b'::u16;
        name[3] = 0;
        var made:   usize = system_os.INVALID_HANDLE;
        val opened: i64   = system_os.open_native(out_fd, ?name[0], system_os.O_CREAT | system_os.O_EXCL | system_os.O_WRONLY, 0o600, ?made);
        system_os.close(out_fd);
        if (opened < 0) { ret 7; }
        system_os.close(made);
        var listed: res[Vector[fs.Listed], fs.FsError] = fs.read_dir(?a, out_r.ok);
        if (!sel listed.ok) { ret 8; }
        val held: bool = listed.ok.len == 1 && sel listed.ok.data[0].unspellable;
        fs.listed_free(?listed.ok);
        if (!held) { ret 9; }
        var removed: usize      = 0;
        var target:  CleanEntry = CleanEntry{rel: "out"};
        if (execute_entry(?r, ?a, root, ?target, ?removed, 0) != 0 || removed != 1) { ret 10; }
        val gone: res[bool, io_error.Error] = fs.exists(out_r.ok);
        if (!(sel gone.ok && !gone.ok)) { ret 11; }
        ret 0;
    }
}

$if ($mach.build.os != $mach.os.windows) {
    test clean_project__refuses_symlink_ancestor_escape {
        var r: cli_diagnostic.Report;
        cli_diagnostic.report_init(?r, cli_diagnostic.FORMAT_HUMAN);
        var a:      A.Allocator;
        val make_r: err[A.Error] = page.make(?a);
        if (sel make_r.err) { ret 1; }

        val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_clean_escape");
        if (sel tf_r.err) { ret 1; }
        var tf:     fs.TempFile                     = tf_r.ok;
        val base_r: res[str, types_string.StrError] = str_copy_slice(?a, fs.temp_path(?tf), 0, str_len(fs.temp_path(?tf)));
        fs.temp_close_and_remove(?tf);
        if (sel base_r.err) { ret 1; }
        val base: str = base_r.ok;

        val root_r: res[str, A.Error] = types_path.join(?a, base, "proj");
        if (sel root_r.err) { ret 1; }
        val root:      str               = root_r.ok;
        val outside_r: res[str, A.Error] = types_path.join(?a, base, "outside");
        if (sel outside_r.err) { ret 1; }
        val outside:     str               = outside_r.ok;
        val outside_x_r: res[str, A.Error] = types_path.join(?a, outside, "x");
        if (sel outside_x_r.err) { ret 1; }
        val outside_x: str = outside_x_r.ok;

        val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
        if (sel create_dir_all_r2.err) { ret 1; }
        val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, outside_x, 0o755);
        if (sel create_dir_all_r.err) { ret 1; }

        val sentinel_r: res[str, A.Error] = types_path.join(?a, outside_x, "sentinel");
        if (sel sentinel_r.err) { ret 1; }
        val sentinel:      str             = sentinel_r.ok;
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(sentinel, "s"::*u8, 1, 0o600);
        if (sel write_bytes_r.err) { ret 1; }

        val toml_path_r: res[str, A.Error] = types_path.join(?a, root, "mach.toml");
        if (sel toml_path_r.err) { ret 1; }
        val toml_path:      str             = toml_path_r.ok;
        val body:           str             = "[project]\nmach = \">=5\"\nid = \"escapetest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out\"\n\n[artifact.escapetest]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"{project.work}/x\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
        val write_bytes_r2: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
        if (sel write_bytes_r2.err) { ret 1; }

        val link_r: res[str, A.Error] = types_path.join(?a, root, "out");
        if (sel link_r.err) { ret 1; }
        val link:      str                 = link_r.ok;
        val symlink_r: err[io_error.Error] = fs.symlink(outside, link);
        if (sel symlink_r.err) { ret 1; }

        val rc:       i64                       = clean_project(?r, ?a, root::*u8);
        val exists_r: res[bool, io_error.Error] = fs.exists(sentinel);
        if (sel exists_r.err) { ret 99; }
        val survived: bool = (sel exists_r.ok && exists_r.ok);

        fs.remove_file(link);
        fs.remove_all(?a, root);
        fs.remove_all(?a, outside);

        if (rc == 0)   { ret 1; }
        if (!survived) { ret 2; }
        ret 0;
    }
}

test is_ancestor__segment_boundary_not_string_prefix {
    var bad: i32 = 0;
    if (!is_ancestor("out", "out/x"))   { bad = 1; }
    if (!is_ancestor("out", "out/x/y")) { bad = 1; }
    if (is_ancestor("out", "out2/x"))   { bad = 1; }
    if (is_ancestor("out", "out"))      { bad = 1; }
    if (is_ancestor("out/x", "out"))    { bad = 1; }
    if (is_ancestor("", "out"))         { bad = 1; }
    ret bad;
}

test normalize_and_collapse__dedups_and_collapses_descendants_only_under_a_dir_ancestor {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    var raw: Vector[CleanEntry] = collections_vector.init[CleanEntry](?a);
    push_entry(?raw, "out/x/obj", ENTRY_DIR);
    push_entry(?raw, "out/x/obj", ENTRY_DIR);
    push_entry(?raw, "out/x/obj/leftover", ENTRY_DIR);
    push_entry(?raw, "out/x/ir", ENTRY_DIR);
    push_entry(?raw, "out/x/bin/name", ENTRY_FILE);
    push_entry(?raw, "out/x/bin/name/nested", ENTRY_DIR);
    push_entry(?raw, "out/y/obj", ENTRY_DIR);

    val out_r: res[Vector[CleanEntry], fail.Fail] = normalize_and_collapse(?a, ?raw);
    if (sel out_r.err) { ret 1; }
    val out: Vector[CleanEntry] = out_r.ok;

    if (out.len != 5) { ret 2; }

    var saw_obj_leftover: bool  = false;
    var saw_bin_nested:   bool  = false;
    var i:                usize = 0;
    for (i < out.len) {
        if (str_equals(out.data[i].rel, "out/x/obj/leftover"))    { saw_obj_leftover = true; }
        if (str_equals(out.data[i].rel, "out/x/bin/name/nested")) { saw_bin_nested = true; }
        i = i + 1;
    }
    if (saw_obj_leftover) { ret 3; }
    if (!saw_bin_nested)  { ret 4; }
    ret 0;
}

test build_clean_plan__dynamic_first_out_template_still_cleans {
    var r: cli_diagnostic.Report;
    cli_diagnostic.report_init(?r, cli_diagnostic.FORMAT_HUMAN);
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_clean_dynfirst");
    if (sel tf_r.err) { ret 1; }
    var tf:   fs.TempFile = tf_r.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }

    val toml_path_r: res[str, A.Error] = types_path.join(?a, root, "mach.toml");
    if (sel toml_path_r.err) { ret 1; }
    val toml_path:     str             = toml_path_r.ok;
    val body:          str             = "[project]\nmach = \">=5\"\nid = \"dynfirst\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"{target.name}-out\"\n\n[artifact.dynfirst]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"{project.work}/bin/name\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret 1; }

    val out_dir_r: res[str, A.Error] = types_path.join(?a, root, "native-out");
    if (sel out_dir_r.err) { ret 1; }
    val out_dir:   str               = out_dir_r.ok;
    val obj_dir_r: res[str, A.Error] = types_path.join(?a, out_dir, "obj");
    if (sel obj_dir_r.err) { ret 1; }
    val obj_dir:           str             = obj_dir_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, obj_dir, 0o755);
    if (sel create_dir_all_r2.err) { ret 1; }

    val rc: i64 = clean_project(?r, ?a, root::*u8);

    var bad: i32 = 0;
    if (rc != 0) { bad = 1; }
    val exists_r: res[bool, io_error.Error] = fs.exists(obj_dir);
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

# a dependency never pulled was never built: clean does not refuse it, and still
# removes the project's own outputs
test clean_project__an_unpulled_dependency_adds_nothing_and_is_not_refused {
    var r: cli_diagnostic.Report;
    cli_diagnostic.report_init(?r, cli_diagnostic.FORMAT_HUMAN);
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val created: res[output_testing.Output, fail.Fail] = output_testing.create(?a, "mach-clean-unpulled");
    if (sel created.err) { ret 2; }
    var owner: output_testing.Output = created.ok;
    fin { output_testing.dnit(?owner); }
    val root: str = owner.directory;

    val toml_r: res[str, A.Error] = types_path.join(?a, root, "mach.toml");
    if (sel toml_r.err) { ret 3; }
    val body:  str             = "[project]\nmach = \">=5\"\nid = \"unpulled\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out\"\n\n[dep.leaf]\npath = \"dep/leaf\"\n\n[artifact.unpulled]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"{project.work}/bin/unpulled\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n";
    val wrote: err[fs.FsError] = fs.write_bytes(toml_r.ok, body::*u8, str_len(body), 0o644);
    if (sel wrote.err) { ret 3; }
    val obj_r: res[str, A.Error] = types_path.join(?a, root, "out/obj");
    if (sel obj_r.err) { ret 4; }
    val made: err[fs.FsError] = fs.create_dir_all(?a, obj_r.ok, 0o755);
    if (sel made.err) { ret 4; }

    if (clean_project(?r, ?a, root::*u8) != 0) { ret 5; }
    if (t_exists(?a, root, "out/obj"))         { ret 6; }
    ret 0;
}

test build_clean_plan__unsupported_target_artifact_pairs_are_skipped_not_errored {
    var r: cli_diagnostic.Report;
    cli_diagnostic.report_init(?r, cli_diagnostic.FORMAT_HUMAN);
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }

    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_clean_multitarget");
    if (sel tf_r.err) { ret 1; }
    var tf:   fs.TempFile = tf_r.ok;
    val root: str         = fs.temp_path(?tf);
    fs.temp_close_and_remove(?tf);
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, root, 0o755);
    if (sel create_dir_all_r.err) { ret 1; }

    val toml_path_r: res[str, A.Error] = types_path.join(?a, root, "mach.toml");
    if (sel toml_path_r.err) { ret 1; }
    val toml_path:     str             = toml_path_r.ok;
    val body:          str             = "[project]\nmach = \">=5\"\nid = \"multitarget\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.linuxonly]\nkind = \"bin\"\nentry = \"src/main.mach\"\nout = \"{project.work}/bin/name\"\ntargets = [\"linux\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
    val write_bytes_r: err[fs.FsError] = fs.write_bytes(toml_path, body::*u8, str_len(body), 0o644);
    if (sel write_bytes_r.err) { ret 1; }

    val linux_obj_r: res[str, A.Error] = types_path.join(?a, root, "out/linux/obj");
    if (sel linux_obj_r.err) { ret 1; }
    val linux_obj:         str             = linux_obj_r.ok;
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, linux_obj, 0o755);
    if (sel create_dir_all_r2.err) { ret 1; }

    val windows_dir_r: res[str, A.Error] = types_path.join(?a, root, "out/windows");
    if (sel windows_dir_r.err) { ret 1; }
    val windows_dir: str = windows_dir_r.ok;

    val rc: i64 = clean_project(?r, ?a, root::*u8);

    var bad: i32 = 0;
    if (rc != 0) { bad = 1; }
    val exists_r: res[bool, io_error.Error] = fs.exists(linux_obj);
    if (sel exists_r.err)                 { ret 99; }
    if ((sel exists_r.ok && exists_r.ok)) { bad = 1; }
    val exists_r2: res[bool, io_error.Error] = fs.exists(windows_dir);
    if (sel exists_r2.err)                  { ret 99; }
    if ((sel exists_r2.ok && exists_r2.ok)) { bad = 1; }

    fs.remove_all(?a, root);
    ret bad;
}

test execute_plan__a_refused_entry_refuses_the_whole_plan_before_deleting_anything {
    var r: cli_diagnostic.Report;
    cli_diagnostic.report_init(?r, cli_diagnostic.FORMAT_HUMAN);
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val temp_r: res[fs.TempFile, fs.FsError] = fs.temp_create(?a, "mach_clean_claims");
    if (sel temp_r.err) { ret 2; }
    var temp:   fs.TempFile                     = temp_r.ok;
    val root_r: res[str, types_string.StrError] = str_copy_slice(?a, fs.temp_path(?temp), 0, str_len(fs.temp_path(?temp)));
    val closed: err[io_error.Error]             = fs.temp_close_and_remove(?temp);
    str_free(?a, fs.temp_path(?temp));
    if (sel closed.err) { ret 3; }
    if (sel root_r.err) { ret 3; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?a, root);
        str_free(?a, root);
    }
    val left_r: res[str, A.Error] = types_path.join(?a, root, "out/a");
    if (sel left_r.err) { ret 4; }
    val left: str = left_r.ok;
    fin { str_free(?a, left); }
    val right_r: res[str, A.Error] = types_path.join(?a, root, "out/b");
    if (sel right_r.err) { ret 5; }
    val right: str = right_r.ok;
    fin { str_free(?a, right); }
    val create_dir_all_r2: err[fs.FsError] = fs.create_dir_all(?a, left, 0o755);
    if (sel create_dir_all_r2.err) { ret 6; }
    val create_dir_all_r: err[fs.FsError] = fs.create_dir_all(?a, right, 0o755);
    if (sel create_dir_all_r.err) { ret 6; }
    var entries: [2]CleanEntry;
    entries[0] = CleanEntry{rel: "out/a", kind: ENTRY_DIR};
    entries[1] = CleanEntry{rel: "../outside", kind: ENTRY_DIR};
    var removed:  usize                     = 0;
    val exists_r: res[bool, io_error.Error] = fs.exists(left);
    if (execute_plan(?r, ?a, root, ?entries[0], 2, ?removed) != exit.USER) { ret 7; }
    if (removed != 0)                                                      { ret 7; }
    if (!(sel exists_r.ok && exists_r.ok))                                 { ret 7; }
    entries[1].rel = "out/b";
    if (execute_plan(?r, ?a, root, ?entries[0], 2, ?removed) != 0 || removed != 2) { ret 12; }
    val exists_r4: res[bool, io_error.Error] = fs.exists(left);
    val exists_r5: res[bool, io_error.Error] = fs.exists(right);
    if ((sel exists_r4.ok && exists_r4.ok)) { ret 13; }
    if ((sel exists_r5.ok && exists_r5.ok)) { ret 13; }
    ret 0;
}

#[testing]
val T_STATE_MANIFEST: str = "[project]\nmach = \">=5\"\nid = \"cleanfx\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out\"\n\n[target.host]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[step.count]\nargv = [\"sh\", \"-c\", 'n=0; if [ -f counter ]; then IFS= read -r n < counter; fi; n=$((n + 1)); printf \"%s\" \"$n\" > counter']\nin = []\nout = [\"counter\"]\nneed = []\n\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = [\"step.count\"]\n\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n";

#[testing]
val T_STATE_MAIN: str = "#[symbol(\"_start\")]\nfun start() {\n    asm x86_64 {\n        mov rax, 60\n        mov rdi, 0\n        syscall\n    }\n}\n\ntest passes { ret 0; }\n";

#[testing]
fun t_build(a: *A.Allocator, root: str) i64 {
    var argv: [5]*u8;
    argv[0] = "mach"::*u8;
    argv[1] = "build"::*u8;
    argv[2] = root::*u8;
    argv[3] = "--target"::*u8;
    argv[4] = "host"::*u8;
    ret args.invoke(a, ?build.COMMAND, 5, ?argv[0]);
}

#[testing]
fun t_test(a: *A.Allocator, root: str) i64 {
    var argv: [5]*u8;
    argv[0] = "mach"::*u8;
    argv[1] = "test"::*u8;
    argv[2] = root::*u8;
    argv[3] = "--target"::*u8;
    argv[4] = "host"::*u8;
    ret args.invoke(a, ?cmd_testing.COMMAND, 5, ?argv[0]);
}

#[testing]
fun t_exists(a: *A.Allocator, root: str, rel: str) bool {
    val joined: res[str, A.Error] = types_path.join(a, root, rel);
    if (sel joined.err) { ret false; }
    val found: res[bool, io_error.Error] = fs.exists(joined.ok);
    ret sel found.ok && found.ok;
}

#[testing]
fun t_counter(a: *A.Allocator, root: str) str {
    val joined: res[str, A.Error] = types_path.join(a, root, "counter");
    if (sel joined.err) { ret ""; }
    val text: res[str, fs.FsError] = fs.read_string(a, joined.ok);
    if (sel text.err) { ret ""; }
    ret text.ok;
}

$if ($mach.build.arch == $mach.arch.x86_64 && $mach.build.os == $mach.os.linux) {
    # a default build with a step leaves objects, step stamps and test output in the
    # output directory; clean removes every one of them, and the next build reuses
    # nothing: the step runs again because its stamp went with `.cache/`. the test
    # run starts from a 5.x tree, whose dispatcher file sits where the layout needs
    # `test/<artifact>/`, and replaces it
    test clean_project__clears_objects_cache_staging_and_test_output_and_the_next_build_is_cold {
        var r: cli_diagnostic.Report;
        cli_diagnostic.report_init(?r, cli_diagnostic.FORMAT_HUMAN);
        var a:      A.Allocator;
        val make_r: err[A.Error] = page.make(?a);
        if (sel make_r.err) { ret 1; }
        val created: res[output_testing.Output, fail.Fail] = output_testing.create(?a, "mach-clean-state");
        if (sel created.err) { ret 2; }
        var owner: output_testing.Output = created.ok;
        fin { output_testing.dnit(?owner); }
        val root: str = owner.directory;

        val src_r: res[str, A.Error] = types_path.join(?a, root, "src");
        if (sel src_r.err) { ret 3; }
        val made: err[fs.FsError] = fs.create_dir_all(?a, src_r.ok, 0o755);
        if (sel made.err) { ret 3; }
        val toml_r: res[str, A.Error] = types_path.join(?a, root, "mach.toml");
        val main_r: res[str, A.Error] = types_path.join(?a, src_r.ok, "main.mach");
        if (sel toml_r.err) { ret 3; }
        if (sel main_r.err) { ret 3; }
        val wrote_toml: err[fs.FsError] = fs.write_bytes(toml_r.ok, T_STATE_MANIFEST::*u8, str_len(T_STATE_MANIFEST), 0o644);
        val wrote_main: err[fs.FsError] = fs.write_bytes(main_r.ok, T_STATE_MAIN::*u8, str_len(T_STATE_MAIN), 0o644);
        if (sel wrote_toml.err) { ret 3; }
        if (sel wrote_main.err) { ret 3; }

        if (t_build(?a, root) != 0)                                                    { ret 4; }
        if (t_build(?a, root) != 0)                                                    { ret 5; }
        if (!str_equals(t_counter(?a, root), "1"))                                     { ret 6; }
        if (!t_exists(?a, root, "out/obj") || !t_exists(?a, root, "out/.cache/steps")) { ret 7; }

        val test_r: res[str, A.Error] = types_path.join(?a, root, "out/test");
        if (sel test_r.err) { ret 8; }
        val stale_r: res[str, A.Error] = types_path.join(?a, root, "out/test/app");
        if (sel stale_r.err) { ret 8; }
        val made_test: err[fs.FsError] = fs.create_dir_all(?a, test_r.ok, 0o755);
        if (sel made_test.err) { ret 8; }
        val wrote_stale: err[fs.FsError] = fs.write_bytes(stale_r.ok, "5.x dispatcher"::*u8, 14, 0o755);
        if (sel wrote_stale.err)   { ret 8; }
        if (t_test(?a, root) != 0) { ret 13; }
        val replaced: res[bool, io_error.Error] = fs.is_dir(stale_r.ok);
        if (!(sel replaced.ok && replaced.ok)) { ret 14; }

        if (clean_project(?r, ?a, root::*u8) != 0) { ret 9; }
        var gone: [6]str = [6]str{"out/obj", "out/ir", "out/asm", "out/.cache", "out/.stage", "out/test"};
        var i:    usize  = 0;
        for (i < 6) {
            if (t_exists(?a, root, gone[i])) { ret 10; }
            i = i + 1;
        }

        if (t_build(?a, root) != 0)                { ret 11; }
        if (!str_equals(t_counter(?a, root), "2")) { ret 12; }
        ret 0;
    }
}
