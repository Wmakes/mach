val DIR_MODE:  i32 = 493;
val FILE_MODE: i32 = 420;

# `--name <id>`
val NAME: args.FlagSpec = args.FlagSpec{name: "--name", value: "id", arity: args.ARITY_VALUE, doc: "set the project identifier", default: "directory name", repeatable: false, alias_of: nil};
# `--force`
val FORCE: args.FlagSpec = args.FlagSpec{name: "--force", value: "", arity: args.ARITY_FLAG, doc: "scaffold even when mach.toml or src already exists", default: "", repeatable: false, alias_of: nil};
# `--lib`
val LIB: args.FlagSpec = args.FlagSpec{name: "--lib", value: "", arity: args.ARITY_FLAG, doc: "use the library project layout", default: "binary project layout", repeatable: false, alias_of: nil};
# `--no-deps`
val NO_DEPS: args.FlagSpec = args.FlagSpec{name: "--no-deps", value: "", arity: args.ARITY_FLAG, doc: "resolve and declare the dependencies without checking them out (resolving still needs the network)", default: "", repeatable: false, alias_of: nil};
# `--no-git`
val NO_GIT: args.FlagSpec = args.FlagSpec{name: "--no-git", value: "", arity: args.ARITY_FLAG, doc: "skip Git initialization and realize dependencies as plain checkouts", default: "", repeatable: false, alias_of: nil};

# row count of OWN
val OWN_N: usize = 5;
# the options only mach init accepts
val OWN: [OWN_N]*args.FlagSpec = [OWN_N]*args.FlagSpec{?NAME, ?FORCE, ?LIB, ?NO_DEPS, ?NO_GIT};

# length of TABLES
val TABLES_N: usize = 2;
# the option tables mach init accepts: its own and `--quiet`
val TABLES: [TABLES_N]args.TableRef = [TABLES_N]args.TableRef{
    args.TableRef{rows: ?OWN[0], n: OWN_N, accepted: nil, docs: nil},
    args.TableRef{rows: ?args.QUIETNESS[0], n: args.QUIETNESS_N, accepted: nil, docs: nil},
};

# `mach init`
pub val COMMAND: args.CommandSpec = args.CommandSpec{name: "init", aliases: nil, alias_n: 0, grammar: " [dir] [options]", summary: "scaffold a new project", effect: "create a binary or library project in the selected directory and add std at the caret range of the newest release that admits this compiler", exits: nil, exit_n: 0, terminator: "", tables: ?TABLES[0], table_n: TABLES_N, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: args.OPERANDS_ANY, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0, run: run};

# `mach init`: scaffold a project. the positional names the directory (default the working
# directory) and, unless `--name` is given, the project id, which must be a portable
# identifier. an absent directory is created whole; an existing one is filled in, and
# `--force` allows overwriting mach.toml and the entry file. `--lib` writes src/lib.mach
# and a static artifact instead of src/main.mach and binary artifacts. the std dependency
# is then added at the caret range of the release resolution picks and checked out, unless
# `--no-deps`, which still resolves the range (so needs the network) but skips the checkout.
# `--quiet` silences progress
# ---
# cx:  the call
# ret: exit.OK, or the failure: a user one for an invalid id or a refused overwrite, otherwise the
#      std dependency's own class when it could not be added
pub fun run(cx: *args.Call) res[i64, fail.Fail] {
    ret run_with(cx, ?SCAFFOLD_DEPS[0], SCAFFOLD_DEP_COUNT);
}

# `run` over an explicit scaffold dependency set
fun run_with(cx: *args.Call, deps: *ScaffoldDep, dep_count: usize) res[i64, fail.Fail] {
    val inv:     *args.ParsedInvocation = cx.inv;
    val a:       *A.Allocator           = cx.a;
    val force:   bool                   = args.given(inv, ?FORCE);
    val is_lib:  bool                   = args.given(inv, ?LIB);
    val no_deps: bool                   = args.given(inv, ?NO_DEPS);
    val no_git:  bool                   = args.given(inv, ?NO_GIT);
    val quiet:   bool                   = args.given(inv, ?args.QUIET);

    val cwd_r: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) {
        val said: res[str, std_format.FormatError] = std_format.sprint(a, "failed to read the working directory: {}", fail.env_text(cwd_r.err));
        if (sel said.err) { ret res[i64, fail.Fail].err{fail.format_refused(said.err)}; }
        ret res[i64, fail.Fail].err{fail.environment(diagnostic_kind.FS_CURRENT_DIR, said.ok)};
    }
    var cwd_owned: types_string.OwnedString = cwd_r.ok;
    val cwd:       str                      = cwd_owned.data;

    var dir: *u8 = cwd;
    if (inv.has_positional) { dir = cx.argv[inv.positional_idx]; }

    val id_r: res[str, fail.Fail] = default_project_id(a, cwd, dir::str);
    if (sel id_r.err) { ret res[i64, fail.Fail].err{id_r.err}; }
    var id:    *u8      = id_r.ok;
    val named: opt[*u8] = args.value(inv, cx.argv, ?NAME);
    if (sel named.some) { id = named.some; }

    if (!manifest.is_valid_id(id::str)) {
        ret res[i64, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.PROJECT_INVALID_ID, "'{}' is not a valid project id: a project id may contain only letters, digits, '_', or '-' (no '.', '/', or spaces); pass a valid name as the argument or with --name <name>", id::str)};
    }

    var entry_leaf:  *u8 = "main.mach";
    var entry_label: *u8 = "src/main.mach";
    if (is_lib) {
        entry_leaf  = "lib.mach";
        entry_label = "src/lib.mach";
    }

    val dest_r: res[str, fail.Fail] = destination_path(a, cwd, dir::str);
    if (sel dest_r.err) { ret res[i64, fail.Fail].err{dest_r.err}; }
    val dest:       str            = dest_r.ok;
    val scaffolded: err[fail.Fail] = scaffold(a, dest, id, is_lib, entry_leaf, entry_label, force, quiet);
    if (sel scaffolded.err) { ret res[i64, fail.Fail].err{scaffolded.err}; }
    ret dependency_stage(cx.report, a, dest, no_deps, no_git, quiet, deps, dep_count, inv.environ);
}

# a dependency every scaffold declares; it is added like `mach dep add <path> <id> --git <git>`,
# at the caret range of the release resolution picks for the running compiler
rec ScaffoldDep {
    id:  str;
    git: str;
}

val SCAFFOLD_DEP_COUNT: usize          = 1;
val SCAFFOLD_DEPS:      [1]ScaffoldDep = [1]ScaffoldDep{
    ScaffoldDep{id: "std", git: "https://github.com/briar-systems/mach-std"}
};

fun dependency_stage(r: *cli_diagnostic.Report, a: *A.Allocator, root: str, no_deps: bool, no_git: bool, quiet: bool, deps: *ScaffoldDep,
    dep_count: usize, environ: exec.Environment) res[i64, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(a);
    if (sel sr.err) { ret res[i64, fail.Fail].err{fail.prefixed(a, "failed to initialize project setup: ", sr.err)}; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    s.environ = environ;
    if (!no_git) {
        val started: err[fail.Fail] = package_edit.start(?s, root);
        if (sel started.err) { ret res[i64, fail.Fail].err{started.err}; }
    }
    var i: usize = 0;
    for (i < dep_count) {
        val dep: ScaffoldDep = deps[i];
        i = i + 1;
        var rep:   report.Report = cli_diagnostic.dependency_report(a);
        val added: i64           = cli_diagnostic.dependency_outcome(?rep, package_edit.add_release(?s, a, root, dep.id, dep.git, quiet, !no_deps, ?rep));
        report.dnit(?rep);
        if (added != exit.OK) {
            var msg_r: res[str, std_format.FormatError];
            if (no_deps) {
                msg_r = std_format.sprint(a,
                    "dependency '{}' has no resolved release; --no-deps skips only the checkout, resolving its range still needs the network. run `mach dep add <path> {} --git {}` for project '{}' once connected",
                    dep.id, dep.id, dep.git, root);
            }
            or {
                msg_r = std_format.sprint(a,
                    "dependency '{}' could not be added; run `mach dep add <path> {} --git {}` for project '{}' once the problem above is fixed", dep.id, dep.id, dep.git, root);
            }
            var said: str = "a declared dependency could not be added";
            if (sel msg_r.ok) { said = msg_r.ok; }
            # the failure reported above carries the class, and so the exit code
            cli_diagnostic.report_fail(r, fail.user(diagnostic_kind.DEP_ADD, said), diagnostic.ORIGIN_NONE);
            ret res[i64, fail.Fail].ok{added};
        }
        if (quiet) { cnt; }
        if (no_deps) {
            val hint: res[str, fail.Fail] = no_deps_hint(a, root, dep.id);
            if (sel hint.err) { ret res[i64, fail.Fail].err{hint.err}; }
            print.eprintlnf("{}", hint.ok);
        }
        or { print.eprintlnf("realized dependency '{}'", dep.id); }
    }
    ret res[i64, fail.Fail].ok{exit.OK};
}

# what --no-deps prints for a dependency it declared: the command that pins it, which is the
# one `mach dep pull` names when it refuses an unpinned version selection
fun no_deps_hint(a: *A.Allocator, root: str, id: str) res[str, fail.Fail] {
    val command: res[str, fail.Fail] = package_closure.pin_command(a, root, id);
    if (sel command.err) { ret command; }
    ret fail.format(a, "declared dependency '{}' without a checkout; run `{}` to pin and realize it", id, command.ok);
}

# the destination, rooted at the working directory and cleaned
fun destination_path(alloc: *A.Allocator, cwd: str, dir: str) res[str, fail.Fail] {
    val joined: res[str, A.Error] = types_path.resolve(alloc, cwd, dir);
    if (sel joined.err) { ret res[str, fail.Fail].err{fail.refused(joined.err)}; }
    val cleaned: res[str, A.Error] = types_path.clean(alloc, joined.ok);
    str_free(alloc, joined.ok);
    if (sel cleaned.err) { ret res[str, fail.Fail].err{fail.refused(cleaned.err)}; }
    ret res[str, fail.Fail].ok{cleaned.ok};
}

val ENTRY_ABSENT:  u8 = 0;
val ENTRY_REGULAR: u8 = 1;
val ENTRY_DIR:     u8 = 2;
val ENTRY_OTHER:   u8 = 3;

fun probe(alloc: *A.Allocator, dest: str, rel: str) res[u8, fail.Fail] {
    val joined: res[str, A.Error] = types_path.join(alloc, dest, rel);
    if (sel joined.err) { ret res[u8, fail.Fail].err{fail.refused(joined.err)}; }
    val name: str = joined.ok;
    fin { str_free(alloc, name); }
    var st:     system_os.stat_t;
    val probed: i64 = system_os.stat_path(system_os.working_dir(), name, ?st, system_os.AT_SYMLINK_NOFOLLOW);
    if (system_os.error_kind(probed) == io_error.NOT_FOUND) { ret res[u8, fail.Fail].ok{ENTRY_ABSENT}; }
    if (probed < 0)                                         { ret res[u8, fail.Fail].err{fail.environment(diagnostic_kind.FS_STAT, system_os.error_message(probed))}; }
    val kind: u32 = native.stat_mode(?st) & system_os.S_IFMT;
    if (kind == system_os.S_IFREG) { ret res[u8, fail.Fail].ok{ENTRY_REGULAR}; }
    if (kind == system_os.S_IFDIR) { ret res[u8, fail.Fail].ok{ENTRY_DIR}; }
    ret res[u8, fail.Fail].ok{ENTRY_OTHER};
}

# write one scaffold file through a sibling temporary and rename, so a
# forced overwrite of an existing file is whole or not at all
fun emit(alloc: *A.Allocator, dest: str, rel: str, text: str) err[fail.Fail] {
    val joined: res[str, A.Error] = types_path.join(alloc, dest, rel);
    if (sel joined.err) { ret err[fail.Fail].err{fail.refused(joined.err)}; }
    val name: str = joined.ok;
    fin { str_free(alloc, name); }
    ret output.replace(alloc, name, text::*u8, str_len(text), FILE_MODE);
}

fun exists_fail(a: *A.Allocator, label: *u8) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.PROJECT_FILE_EXISTS, "'{}' already exists (use --force to replace it)", label::str);
}

fun not_regular_fail(a: *A.Allocator, label: *u8) fail.Fail {
    ret fail.formatted_user(a, diagnostic_kind.PROJECT_FILE_KIND, "'{}' exists and is not a regular file", label::str);
}

# an existing manifest or entry is refused without --force; every refusal
# comes before the first write, so a refused init changes nothing
fun scaffold_checked(a: *A.Allocator, dest: str, id: *u8, is_lib: bool, entry_leaf: *u8,
    entry_label: *u8, force: bool) res[i64, fail.Fail] {
    val existing: res[u8, fail.Fail] = probe(a, dest, "");
    if (sel existing.err) { ret res[i64, fail.Fail].err{existing.err}; }
    if (existing.ok == ENTRY_REGULAR || existing.ok == ENTRY_OTHER) {
        ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.PROJECT_FILE_KIND, "the destination exists and is not a directory")};
    }
    if (existing.ok == ENTRY_DIR) {
        val manifest_r: res[u8, fail.Fail] = probe(a, dest, util.PROJECT_CONFIG_NAME);
        if (sel manifest_r.err) { ret res[i64, fail.Fail].err{manifest_r.err}; }
        if (manifest_r.ok == ENTRY_DIR || manifest_r.ok == ENTRY_OTHER) {
            ret res[i64, fail.Fail].err{not_regular_fail(a, util.PROJECT_CONFIG_NAME)};
        }
        if (manifest_r.ok == ENTRY_REGULAR && !force) {
            ret res[i64, fail.Fail].err{exists_fail(a, util.PROJECT_CONFIG_NAME)};
        }
        val source_r: res[u8, fail.Fail] = probe(a, dest, "src");
        if (sel source_r.err) { ret res[i64, fail.Fail].err{source_r.err}; }
        if (source_r.ok == ENTRY_REGULAR || source_r.ok == ENTRY_OTHER) {
            ret res[i64, fail.Fail].err{fail.user(diagnostic_kind.PROJECT_FILE_KIND, "'src' exists and is not a directory")};
        }
        val entry_r: res[u8, fail.Fail] = probe(a, dest, entry_label::str);
        if (sel entry_r.err) { ret res[i64, fail.Fail].err{entry_r.err}; }
        if (entry_r.ok == ENTRY_DIR || entry_r.ok == ENTRY_OTHER) {
            ret res[i64, fail.Fail].err{not_regular_fail(a, entry_label)};
        }
        if (entry_r.ok == ENTRY_REGULAR && !force) {
            ret res[i64, fail.Fail].err{exists_fail(a, entry_label)};
        }
    }
    val text_r: res[str, fail.Fail] = build_manifest_text(a, id, is_lib, lang_target.host_arch_id());
    if (sel text_r.err) { ret res[i64, fail.Fail].err{text_r.err}; }
    val text: str = text_r.ok;
    fin { str_free(a, text); }
    val src_r: res[str, A.Error] = types_path.join(a, dest, "src");
    if (sel src_r.err) { ret res[i64, fail.Fail].err{fail.refused(src_r.err)}; }
    val src: str = src_r.ok;
    fin { str_free(a, src); }
    val made: err[fs.FsError] = fs.create_dir_all(a, src, DIR_MODE);
    if (sel made.err) { ret res[i64, fail.Fail].err{fail.environment(diagnostic_kind.FS_CREATE, fail.fs_text(made.err))}; }
    val manifest_written: err[fail.Fail] = emit(a, dest, util.PROJECT_CONFIG_NAME, text);
    if (sel manifest_written.err) { ret res[i64, fail.Fail].err{manifest_written.err}; }
    val entry_written: err[fail.Fail] = emit(a, dest, entry_label::str, source_template(is_lib)::str);
    if (sel entry_written.err) { ret res[i64, fail.Fail].err{entry_written.err}; }
    ret res[i64, fail.Fail].ok{exit.OK};
}

fun scaffold(a: *A.Allocator, dest: str, id: *u8, is_lib: bool, entry_leaf: *u8,
    entry_label: *u8, force: bool, quiet: bool) err[fail.Fail] {
    val result: res[i64, fail.Fail] = scaffold_checked(a, dest, id, is_lib, entry_leaf, entry_label, force);
    if (sel result.err) { ret err[fail.Fail].err{result.err}; }
    if (!quiet) {
        print.eprint("created project '");
        print.eprint(id::str);
        print.eprint("'\n");
    }
    ret err[fail.Fail].ok{};
}

fun build_manifest_text(alloc: *A.Allocator, id: *u8, is_lib: bool, arch_id: u32) res[str, fail.Fail] {
    var buf: textbuild.TextBuilder = textbuild.tb_init(alloc);
    fin { textbuild.tb_dnit(?buf); }

    buf_put(?buf, "[project]\n");
    buf_put(?buf, "id = \"");
    buf_put(?buf, id);
    buf_put(?buf, "\"\n");
    buf_put(?buf, "version = \"0.1.0\"\n");
    val caret: res[str, std_format.FormatError] = driver_closure.running_mach_range_floor(alloc);
    if (sel caret.err) { ret res[str, fail.Fail].err{fail.message(fail.format_text(caret.err))}; }
    buf_put(?buf, "mach = \"");
    buf_put(?buf, caret.ok::*u8);
    buf_put(?buf, "\"\n");
    str_free(alloc, caret.ok);
    buf_put(?buf, "src = \"src\"\n");
    buf_put(?buf, "work = \"out/{target.name}/{profile.name}\"\n");
    buf_put(?buf, "\n");

    val reg_made: res[*lang_target.TargetRegistry, fail.Fail] = toolchain.registry();
    if (sel reg_made.err) { ret res[str, fail.Fail].err{fail.with_text(reg_made.err, "failed to register targets")}; }
    val reg:     *lang_target.TargetRegistry = reg_made.ok;
    var oses:    Vector[u32]                 = collections_vector.init[u32](alloc);
    val emitted: err[fail.Fail]              = emit_targets(?buf, reg, arch_id, ?oses);
    if (sel emitted.err) { ret res[str, fail.Fail].err{emitted.err}; }
    emit_artifacts(?buf, id, is_lib, ?oses);
    if (!is_lib) { emit_system_links(?buf, ?oses); }

    buf_put(?buf, "[profile.debug]\n");
    buf_put(?buf, "default = true\n");
    buf_put(?buf, "optimize = false\n");
    buf_put(?buf, "debug = true\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "\n");
    buf_put(?buf, "[profile.release]\n");
    buf_put(?buf, "optimize = true\n");
    buf_put(?buf, "debug = false\n");
    buf_put(?buf, "simd = \"scalarize\"\n");
    buf_put(?buf, "\n");

    val made: res[str, textbuild.Error] = textbuild.tb_finish(?buf);
    if (sel made.err) { ret res[str, fail.Fail].err{fail.message(textbuild.text(made.err))}; }
    ret res[str, fail.Fail].ok{made.ok};
}

fun emit_artifacts(b: *textbuild.TextBuilder, id: *u8, is_lib: bool, oses: *Vector[u32]) {
    buf_put(b, "[artifact.");
    buf_put(b, id);
    if (is_lib) {
        buf_put(b, "]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"{project.work}/lib/lib");
    }
    or {
        buf_put(b, "]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/");
    }
    buf_put(b, id);
    buf_put(b, "{artifact.suffix}\"\ntargets = [\"*\"]\n");
    if (!is_lib) {
        var listed: usize = 0;
        var i:      usize = 0;
        for (i < oses.len) {
            val library: str = catalog_os.system_library(oses.data[i]);
            i = i + 1;
            if (str_empty(library)) { cnt; }
            if (listed == 0)        { buf_put(b, "link = ["); }
            or                      { buf_put(b, ", "); }
            buf_put(b, "\"");
            buf_put_stem(b, library);
            buf_put(b, "\"");
            listed = listed + 1;
        }
        if (listed > 0) { buf_put(b, "]\n"); }
    }
    # the scaffolded library is the one the project ships prebuilt
    if (is_lib) { buf_put(b, "export = true\n"); }
    buf_put(b, "\n");
}

# a [link.<stem>] table for the system library of each scaffolded os that has one, bound to
# that os
fun emit_system_links(b: *textbuild.TextBuilder, oses: *Vector[u32]) {
    var i: usize = 0;
    for (i < oses.len) {
        val os_id:   u32 = oses.data[i];
        val library: str = catalog_os.system_library(os_id);
        i = i + 1;
        if (str_empty(library)) { cnt; }
        buf_put(b, "[link.");
        buf_put_stem(b, library);
        buf_put(b, "]\nsource = \"system\"\nname = \"");
        buf_put(b, library::*u8);
        buf_put(b, "\"\nos = [\"");
        buf_put(b, catalog_os.name_for(os_id)::*u8);
        buf_put(b, "\"]\nisa = [\"*\"]\nabi = [\"*\"]\n\n");
    }
}

# a library's name up to its first '.', the key its link table goes by
fun buf_put_stem(b: *textbuild.TextBuilder, library: str) {
    var one: [2]u8;
    one[1] = 0;
    var n: usize = 0;
    for (library[n] != 0 && library[n] != '.') {
        one[0] = library[n];
        textbuild.tb_append(b, (?one[0])::str);
        n = n + 1;
    }
}

val BIN_SOURCE_TEMPLATE: str = "use std.print;\nuse std.runtime;\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i64 {\n    print.println(\"Hello, World!\");\n    ret 0;\n}\n";

fun source_template(is_lib: bool) *u8 {
    if (is_lib) { ret ""; }
    ret BIN_SOURCE_TEMPLATE::*u8;
}

# a failed append poisons the builder, which tb_finish reports
fun buf_put(b: *textbuild.TextBuilder, s: *u8) {
    textbuild.tb_append(b, s::str);
}

fun default_project_id(a: *A.Allocator, cwd: str, dir: str) res[str, fail.Fail] {
    val abs_r: res[str, A.Error] = types_path.resolve(a, cwd, dir);
    if (sel abs_r.err) { ret res[str, fail.Fail].err{fail.refused(abs_r.err)}; }
    val clean_r: res[str, A.Error] = types_path.clean(a, abs_r.ok);
    if (sel clean_r.err) { ret res[str, fail.Fail].err{fail.refused(clean_r.err)}; }
    ret res[str, fail.Fail].ok{types_path.filename(clean_r.ok)};
}

# a target for each hosted os, in catalog order, whose native abi for the isa the registry
# composes; oses receives the os of each target written
fun emit_targets(b: *textbuild.TextBuilder, reg: *lang_target.TargetRegistry, arch_id: u32, oses: *Vector[u32]) err[fail.Fail] {
    var i: usize = 0;
    for (i < catalog_os.count()) {
        val os_name: str = catalog_os.name_at(i);
        val os_id:   u32 = catalog_os.id_for(os_name);
        i = i + 1;
        if (!catalog_os.is_hosted(os_id)) { cnt; }
        val written: res[bool, fail.Fail] = emit_target(b, reg, os_name::*u8, arch_id);
        if (sel written.err) { ret err[fail.Fail].err{written.err}; }
        if (!written.ok)     { cnt; }
        val pushed: res[usize, A.Error] = collections_vector.push[u32](oses, os_id);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# whether a target for the os was written: false where the os has no native abi for the isa
fun emit_target(b: *textbuild.TextBuilder, reg: *lang_target.TargetRegistry, os_name: *u8, arch_id: u32) res[bool, fail.Fail] {
    val abi_r: res[opt[str], fail.Fail] = scaffold_abi(reg, os_name::str, arch_id);
    if (sel abi_r.err)     { ret res[bool, fail.Fail].err{abi_r.err}; }
    if (sel abi_r.ok.none) { ret res[bool, fail.Fail].ok{false}; }
    val abi_name: str = abi_r.ok.some;
    val isa_name: str = catalog_arch.name_for(arch_id);
    buf_put(b, "[target.");
    buf_put(b, os_name);
    buf_put(b, "-");
    buf_put(b, isa_name::*u8);
    buf_put(b, "]\n");
    buf_put(b, "isa = \"");
    buf_put(b, isa_name::*u8);
    buf_put(b, "\"\n");
    buf_put(b, "os  = \"");
    buf_put(b, os_name);
    buf_put(b, "\"\n");
    buf_put(b, "abi = \"");
    buf_put(b, abi_name::*u8);
    buf_put(b, "\"\n");
    buf_put(b, "\n");
    ret res[bool, fail.Fail].ok{true};
}

# the abi init scaffolds for the system and isa, none where the pair has no
# native abi or the registry refuses the tuple
fun scaffold_abi(reg: *lang_target.TargetRegistry, os_name: str, arch_id: u32) res[opt[str], fail.Fail] {
    val os_opt: opt[*lang_target_os.OsVTable] = target_registry.find[lang_target_os.OsVTable](?reg.os, os_name);
    if (sel os_opt.none) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val abi_name: str = lang_target_os.native_abi_for(os_opt.some, arch_id);
    if (str_empty(abi_name)) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val select_r: res[lang_target.Binding, fail.Fail] = lang_target.select(reg, catalog_arch.name_for(arch_id), os_name, abi_name);
    if (sel select_r.err) {
        if (fail.is_message(select_r.err)) { ret res[opt[str], fail.Fail].err{select_r.err}; }
        ret res[opt[str], fail.Fail].ok{opt[str].none{}};
    }
    ret res[opt[str], fail.Fail].ok{opt[str].some{abi_name}};
}
