# the test-only modules no compiler entry reaches: `mach test . -a tests` runs their tests

use std.runtime;

use build_tests:                 mach.lang.build.tests;
use driver_build_tests:          mach.lang.driver.tests.build;
use driver_comptime_tests:       mach.lang.driver.tests.comptime;
use driver_deps_tests:           mach.lang.driver.tests.deps;
use driver_manifest_tests:       mach.lang.driver.tests.manifest;
use driver_query_tests:          mach.lang.driver.tests.query;
use driver_sema_tests:           mach.lang.driver.tests.sema;
use driver_tags_tests:           mach.lang.driver.tests.tags;
use driver_testing_marker_tests: mach.lang.driver.tests.testing_marker;
use sema_tests:                  mach.lang.fe.sema.tests;
use readout_tests:               mach.lang.readout.tests;
