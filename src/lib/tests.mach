# the test-only modules no compiler entry reaches: `mach test . -a tests` runs their tests

use std.runtime;

use build_tests:                 mach.lang.build.tests;
use driver_build_tests:          mach.lang.driver.tests.build;
use driver_deps_tests:           mach.lang.driver.tests.deps;
use readout_tests:               mach.lang.readout.tests;
