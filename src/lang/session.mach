use std.allocator.page;
use std.collections.map;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.process.exec;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;
use std.memory;
use types_path: std.types.path;

use lang_alloc: mach.lang.alloc;
use mach.lang.diagnostic;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.module;
use mach.lang.query;
use mach.lang.retention;
use session_embed: mach.lang.session.embed;
use lang_source:   mach.lang.source;
use mach.lang.type;
use type_query: mach.lang.type.query;

fwd module.ModuleId;
fwd module.MODULE_NIL;
fwd module.StableModuleId;
fwd module.STABLE_MODULE_NIL;

# a file's text as the session loaded it, keyed by the file's index. the source map and the
# editor hold it across builds, so no released module takes it
pub val FILE_TEXT: query.Kind = query.Kind{name: "file text", role: query.INPUT, owner: query.KEY_UNOWNED};

# an open buffer's text, standing in for the file at `path` (cleaned) on disk
rec Overlay {
    path: str;
    text: str;
}

pub rec Session {
    view_generation: u64;
    alloc:           *A.Allocator;
    build_alloc:     *A.Allocator;
    # the freeing allocator scratch work draws from and returns to: it outlives
    # the session and is shared by its codegen workers, so it is safe across
    # threads. `alloc` unless the session's owner names its root
    backing:  *A.Allocator;
    sources:  lang_source.SourceMap;
    diags:    diagnostic.DiagnosticStore;
    interner: intern.Interner;
    types:    type.TypeInterner;
    # the facts derived from the type store, read and written only by mach.lang.type.query
    type_facts: type_query.Facts;

    queries:               query.QueryDb;
    query_presentation:    *query.Presentation;
    query_failure_message: str;
    # the last query failure's places, owned through the query arena's allocator
    query_failure_places: fail.Fail;
    parse_sequence:       u64;

    # one past the highest project module id the session has an identity for;
    # below module.BUFFER_BASE, so it never wraps
    module_count: u32;

    module_fqns: map.Map[module.ModuleId, intern.StrId];
    # which loaded modules belong to the root project rather than a dependency,
    # part of a module's identity: the loader declares it when it gives the
    # module its id, and the export surface of a shared library is drawn from
    # these modules alone
    module_root_project: map.Map[module.ModuleId, bool];

    stable_ids:     map.Map[intern.StrId, module.StableModuleId];
    stable_id_next: module.StableModuleId;

    stable_to_mid: map.Map[module.StableModuleId, module.ModuleId];

    # the open buffers, one per file however its path is spelled; scanned by
    # path, as an editor holds a handful
    overlays: Vector[Overlay];

    embeds: session_embed.EmbedCache;

    # which modules the session keeps products for between builds
    retention: retention.Retention;

    # the environment the processes the session starts inherit: the process's own unless the
    # session's owner names another
    environ: exec.Environment;
}

pub fun init(alloc: *A.Allocator) res[Session, fail.Fail] {
    ret made(alloc, intern.init(alloc));
}

# a session whose names are layered over `base`: every id `base` has issued
# names the same string here, so what was planned in another session, its
# manifests and its cells, is read here as it was planned. `base` outlives the
# session and takes no new names while it lives
pub fun init_over(alloc: *A.Allocator, base: *intern.Interner) res[Session, fail.Fail] {
    ret made(alloc, intern.child_init(base, alloc));
}

fun made(alloc: *A.Allocator, names: intern.Interner) res[Session, fail.Fail] {
    var s: Session;
    s.alloc                 = alloc;
    s.parse_sequence        = 0;
    s.build_alloc           = alloc;
    s.backing               = alloc;
    s.view_generation       = 1;
    s.environ               = exec.Environment.inherit{};
    s.sources               = lang_source.init(alloc);
    s.diags                 = diagnostic.store_init(alloc);
    s.query_presentation    = nil;
    s.query_failure_message = nil;
    s.query_failure_places  = fail.reported();

    s.interner            = names;
    s.module_count        = 0;
    s.module_fqns         = map.init[module.ModuleId, intern.StrId](alloc);
    s.module_root_project = map.init[module.ModuleId, bool](alloc);
    s.stable_ids          = map.init[intern.StrId, module.StableModuleId](alloc);
    s.stable_id_next      = module.stable_id(0);
    s.stable_to_mid       = map.init[module.StableModuleId, module.ModuleId](alloc);
    # each part made so far is released when init does not complete
    var complete:    bool = false;
    var has_types:   bool = false;
    var has_queries: bool = false;
    fin {
        if (!complete) {
            if (has_queries) { query.dnit(?s.queries); }
            if (has_types)   { type.dnit(?s.types); }
            intern.dnit(?s.interner);
            diagnostic.store_dnit(?s.diags);
            lang_source.dnit(?s.sources);
        }
    }

    s.overlays   = collections_vector.init[Overlay](alloc);
    s.embeds     = session_embed.init(alloc);
    s.type_facts = type_query.facts_init(alloc);

    val opt_types: err[fail.Fail] = type.init(?s.types, alloc);
    if (sel opt_types.err) { ret res[Session, fail.Fail].err{opt_types.err}; }
    has_types = true;

    val res_queries: res[query.QueryDb, fail.Fail] = query.init(alloc);
    if (sel res_queries.err) { ret res[Session, fail.Fail].err{res_queries.err}; }
    s.queries   = res_queries.ok;
    has_queries = true;

    val res_retention: res[retention.Retention, fail.Fail] = retention.init(alloc);
    if (sel res_retention.err) { ret res[Session, fail.Fail].err{res_retention.err}; }
    s.retention = res_retention.ok;

    complete = true;
    ret res[Session, fail.Fail].ok{s};
}

# release the text and the places of the last query failure the session holds
pub fun drop_query_failure(s: *Session) {
    if (s.query_failure_message != nil) {
        str_free(s.queries.a, s.query_failure_message);
        s.query_failure_message = nil;
    }
    fail.places_dnit(s.queries.a, s.query_failure_places);
    s.query_failure_places = fail.reported();
}

# hold the text an operation handed back, allocated from the query database, as the held
# failure's text; the session owns it from here
pub fun adopt_failure_text(s: *Session, text: str) {
    if (s.query_failure_message != nil && s.query_failure_message != text) { str_free(s.queries.a, s.query_failure_message); }
    s.query_failure_message = text;
}

# hold a failure where the session presents it: its text and the places it points at are
# copied into the session's slot, replacing what the slot held, and the failure returned reads
# the held copies. text the presentation already owns stays there. a copy the allocator
# refused leaves the failure without that part and sets `lost`
# ---
# s:       the session
# failure: the failure to hold; one with no text or places empties the slot
# lost:    set when part of the failure could not be held
# ret:     the failure as the session holds it
pub fun hold_failure(s: *Session, failure: fail.Fail, lost: *bool) fail.Fail {
    var held:    fail.Fail = failure;
    val carried: opt[str]  = fail.text(failure);
    var keep:    bool      = false;
    if (sel carried.some) {
        val text: str = carried.some;
        keep = text == s.query_failure_message;
        if (!keep && (s.query_presentation == nil || text != s.query_presentation.message)) {
            val copied: res[str, A.Error] = str_dup(s.queries.a, text);
            if (sel copied.err) {
                held  = fail.with_text(failure, lang_alloc.text(copied.err));
                @lost = true;
            }
            if (sel copied.ok) {
                if (s.query_failure_message != nil) { str_free(s.queries.a, s.query_failure_message); }
                s.query_failure_message = copied.ok;
                held                    = fail.with_text(failure, copied.ok);
                keep                    = true;
            }
        }
    }
    if (!keep && s.query_failure_message != nil) {
        str_free(s.queries.a, s.query_failure_message);
        s.query_failure_message = nil;
    }
    if (!fail.same_places(held, s.query_failure_places)) {
        val copied: res[fail.Fail, A.Error] = fail.places_retain(s.queries.a, held);
        fail.places_dnit(s.queries.a, s.query_failure_places);
        s.query_failure_places = fail.reported();
        if (sel copied.err) {
            held  = fail.without_places(held);
            @lost = true;
        }
        if (sel copied.ok) {
            s.query_failure_places = copied.ok;
            held                   = copied.ok;
        }
    }
    ret held;
}

pub fun dnit(s: *Session) {
    if (s == nil) { ret; }

    var oi: usize = 0;
    for (oi < s.overlays.len) {
        str_free(s.alloc, s.overlays.data[oi].path);
        str_free(s.alloc, s.overlays.data[oi].text);
        oi = oi + 1;
    }
    collections_vector.dnit[Overlay](?s.overlays);

    s.module_count = 0;

    map.dnit[module.ModuleId, intern.StrId](?s.module_fqns);
    map.dnit[module.ModuleId, bool](?s.module_root_project);
    map.dnit[intern.StrId, module.StableModuleId](?s.stable_ids);
    map.dnit[module.StableModuleId, module.ModuleId](?s.stable_to_mid);

    if (s.query_presentation != nil) {
        query.presentation_dnit(s.query_presentation);
        s.query_presentation = nil;
    }
    drop_query_failure(s);
    retention.dnit(?s.retention);
    query.dnit(?s.queries);
    session_embed.dnit(?s.embeds);
    type_query.facts_dnit(?s.type_facts);
    type.dnit(?s.types);
    intern.dnit(?s.interner);

    diagnostic.store_dnit(?s.diags);
    lang_source.dnit(?s.sources);
}

# exhaustion permanently refuses new borrowed views while teardown remains infallible
fun expire_views(s: *Session) {
    if (s.view_generation != ~(0::u64)) { s.view_generation = s.view_generation + 1; }
}

pub fun reset_module_registry(s: *Session) {
    if (s == nil) { ret; }
    expire_views(s);

    s.module_count = 0;

    map.clear[module.ModuleId, intern.StrId](?s.module_fqns);
    map.clear[module.ModuleId, bool](?s.module_root_project);

    map.clear[module.StableModuleId, module.ModuleId](?s.stable_to_mid);
}

# one past the highest project module id the session has an identity for
pub fun module_count(s: *Session) u32 {
    ret s.module_count;
}

fun register_module_fqn(s: *Session, mid: module.ModuleId, fqn: intern.StrId) err[fail.Fail] {
    val insert_r: res[bool, A.Error] = map.insert[module.ModuleId, intern.StrId](?s.module_fqns, mid, fqn);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun register_module_root_project(s: *Session, mid: module.ModuleId, root: bool) err[fail.Fail] {
    val insert_r: res[bool, A.Error] = map.insert[module.ModuleId, bool](?s.module_root_project, mid, root);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

# a module the loader never declared is not the root project's: a dependency's
# module, or one loaded outside a project, exports nothing of its own
pub fun module_is_root_project(s: *Session, mid: module.ModuleId) bool {
    if (module.is_nil(mid)) { ret false; }
    val res_get: opt[*bool] = map.get[module.ModuleId, bool](?s.module_root_project, ?mid);
    if (sel res_get.some) { ret @res_get.some; }
    ret false;
}

pub fun module_fqn(s: *Session, mid: module.ModuleId) intern.StrId {
    if (module.is_nil(mid)) { ret intern.STR_NIL; }
    val res_get: opt[*intern.StrId] = map.get[module.ModuleId, intern.StrId](?s.module_fqns, ?mid);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret intern.STR_NIL;
}

pub fun stable_module_id(s: *Session, fqn: intern.StrId) res[module.StableModuleId, fail.Fail] {
    val res_get: opt[*module.StableModuleId] = map.get[intern.StrId, module.StableModuleId](?s.stable_ids, ?fqn);
    if (sel res_get.some) {
        ret res[module.StableModuleId, fail.Fail].ok{@res_get.some};
    }

    if (module.stable_is_nil(s.stable_id_next)) {
        ret res[module.StableModuleId, fail.Fail].err{fail.message("stable module identities are exhausted")};
    }
    val id:         module.StableModuleId = s.stable_id_next;
    val res_insert: res[bool, A.Error]    = map.insert[intern.StrId, module.StableModuleId](?s.stable_ids, fqn, id);
    if (sel res_insert.err) {
        ret res[module.StableModuleId, fail.Fail].err{fail.refused(res_insert.err)};
    }
    s.stable_id_next = module.stable_id(module.stable_index(s.stable_id_next) + 1);
    ret res[module.StableModuleId, fail.Fail].ok{id};
}

pub fun stable_module_id_lookup(s: *Session, fqn: intern.StrId) module.StableModuleId {
    val res_get: opt[*module.StableModuleId] = map.get[intern.StrId, module.StableModuleId](?s.stable_ids, ?fqn);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret module.STABLE_MODULE_NIL;
}

pub fun register_stable_mid(s: *Session, stable: module.StableModuleId, mid: module.ModuleId) err[fail.Fail] {
    val insert_r: res[bool, A.Error] = map.insert[module.StableModuleId, module.ModuleId](?s.stable_to_mid, stable, mid);
    if (sel insert_r.err) { ret err[fail.Fail].err{fail.refused(insert_r.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun module_id_for_stable(s: *Session, stable: module.StableModuleId) module.ModuleId {
    if (module.stable_is_nil(stable)) { ret module.MODULE_NIL; }
    val res_get: opt[*module.ModuleId] = map.get[module.StableModuleId, module.ModuleId](?s.stable_to_mid, ?stable);
    if (sel res_get.some) {
        ret @res_get.some;
    }
    ret module.MODULE_NIL;
}

pub fun reset_type_projection(s: *Session) err[fail.Fail] {
    if (s.queries.operation_active || s.queries.presentation_pending) {
        ret err[fail.Fail].err{fail.message("cannot replace type projections while query products are borrowed")};
    }
    expire_views(s);
    type.field_projection_reset(?s.types);
    ret err[fail.Fail].ok{};
}

# give the module `mid` its name and stable identity; a project's module also
# counts toward module_count, a standalone buffer's does not
pub fun register_module_identity(s: *Session, mid: module.ModuleId, fqn: intern.StrId, stable: module.StableModuleId) err[fail.Fail] {
    if (module.is_nil(mid)) { ret err[fail.Fail].err{fail.message("a module identity needs a module id")}; }
    var key: module.ModuleId = mid;
    expire_views(s);
    val rf: err[fail.Fail] = register_module_fqn(s, mid, fqn);
    if (sel rf.err) { ret rf; }
    val rm: err[fail.Fail] = register_stable_mid(s, stable, mid);
    if (sel rm.err) {
        map.remove[module.ModuleId, intern.StrId](?s.module_fqns, ?key);
        ret rm;
    }
    val buffer: opt[u32] = module.buffer_file(mid);
    if (sel buffer.none && module.index(mid) >= s.module_count) { s.module_count = module.index(mid) + 1; }
    ret err[fail.Fail].ok{};
}

pub fun unregister_module_identity(s: *Session, mid: module.ModuleId, stable: module.StableModuleId) {
    var key:  module.ModuleId       = mid;
    var skey: module.StableModuleId = stable;
    map.remove[module.ModuleId, intern.StrId](?s.module_fqns, ?key);
    map.remove[module.ModuleId, bool](?s.module_root_project, ?key);
    map.remove[module.StableModuleId, module.ModuleId](?s.stable_to_mid, ?skey);
}

pub fun next_parse_incarnation(s: *Session) res[u64, fail.Fail] {
    if (s.parse_sequence == ~(0::u64)) { ret res[u64, fail.Fail].err{fail.message("parsed source incarnations are exhausted")}; }
    s.parse_sequence = s.parse_sequence + 1;
    ret res[u64, fail.Fail].ok{s.parse_sequence};
}

pub fun load_source(s: *Session, path: str, text: str) res[lang_source.FileId, fail.Fail] {
    if (s.queries.operation_active || s.queries.presentation_pending) {
        ret res[lang_source.FileId, fail.Fail].err{fail.message("cannot change source inputs before the operation is released")};
    }
    val key_r: res[str, fail.Fail] = source_key(s, path);
    if (sel key_r.err) { ret res[lang_source.FileId, fail.Fail].err{key_r.err}; }
    val key: str = key_r.ok;
    fin { str_free(s.alloc, key); }
    if (str_len(text) > 0xFFFFFFFF::usize) { ret res[lang_source.FileId, fail.Fail].err{fail.message("source input exceeds the query byte extent")}; }
    val staged: res[lang_source.PreparedLoad, lang_source.Error] = lang_source.prepare_load(?s.sources, ?s.interner, key, text);
    if (sel staged.err) { ret res[lang_source.FileId, fail.Fail].err{fail.source_refused(staged.err)}; }
    var prepared: lang_source.PreparedLoad = staged.ok;
    fin { lang_source.discard_load(?prepared); }
    val input: err[fail.Fail] = query.set_input(?s.queries, ?FILE_TEXT, lang_source.file_index(prepared.id)::u64, text::*u8, str_len(text)::u32);
    if (sel input.err)    { ret res[lang_source.FileId, fail.Fail].err{input.err}; }
    if (prepared.changed) { expire_views(s); }
    ret res[lang_source.FileId, fail.Fail].ok{lang_source.commit_load(?prepared)};
}

pub rec PreparedOverlay {
    owner:   *Session;
    key:     str;
    text:    str;
    index:   usize;
    remove:  bool;
    changed: bool;
}

# the caller exclusively borrows overlay state through commit or discard
pub fun prepare_overlay(s: *Session, path: str, text: str, remove: bool) res[PreparedOverlay, fail.Fail] {
    val canonical: res[str, fail.Fail] = source_key(s, path);
    if (sel canonical.err) { ret res[PreparedOverlay, fail.Fail].err{canonical.err}; }
    var prepared: PreparedOverlay = PreparedOverlay{
        owner: s, key: canonical.ok, index: s.overlays.len, remove: remove
    };
    var complete: bool = false;
    fin {
        if (!complete) { discard_overlay(?prepared); }
    }
    var i: usize = 0;
    for (i < s.overlays.len) {
        if (str_equals(s.overlays.data[i].path, prepared.key)) {
            prepared.index = i;
            brk;
        }
        i = i + 1;
    }
    if (remove) { prepared.changed = prepared.index < s.overlays.len; }
    or {
        prepared.changed = prepared.index == s.overlays.len || !str_equals(s.overlays.data[prepared.index].text, text);
        if (prepared.changed) {
            val copied: res[str, A.Error] = str_dup(s.alloc, text);
            if (sel copied.err) { ret res[PreparedOverlay, fail.Fail].err{fail.refused(copied.err)}; }
            prepared.text = copied.ok;
            if (prepared.index == s.overlays.len) {
                val reserved: res[usize, A.Error] = collections_vector.reserve[Overlay](?s.overlays, 1);
                if (sel reserved.err) { ret res[PreparedOverlay, fail.Fail].err{fail.refused(reserved.err)}; }
            }
        }
    }
    complete = true;
    ret res[PreparedOverlay, fail.Fail].ok{prepared};
}

pub fun discard_overlay(prepared: *PreparedOverlay) {
    if (prepared.owner == nil) { ret; }
    str_free(prepared.owner.alloc, prepared.key);
    str_free(prepared.owner.alloc, prepared.text);
    prepared.owner = nil;
    prepared.key   = nil;
    prepared.text  = nil;
}

pub fun commit_overlay(prepared: *PreparedOverlay) bool {
    val s:       *Session = prepared.owner;
    val changed: bool     = prepared.changed;
    if (changed) {
        expire_views(s);
        val i: usize = prepared.index;
        if (prepared.remove) {
            str_free(s.alloc, s.overlays.data[i].path);
            str_free(s.alloc, s.overlays.data[i].text);
            val last: opt[Overlay] = collections_vector.pop[Overlay](?s.overlays);
            # the last entry fills the removed one's place
            if (sel last.some) {
                if (i != s.overlays.len) { s.overlays.data[i] = last.some; }
            }
        }
        or {
            # prepare reserved the new entry's room
            if (i == s.overlays.len) {
                collections_vector.push[Overlay](?s.overlays, Overlay{path: prepared.key, text: prepared.text});
                prepared.key = nil;
            }
            or {
                str_free(s.alloc, s.overlays.data[i].text);
                s.overlays.data[i].text = prepared.text;
            }
            prepared.text = nil;
        }
    }
    discard_overlay(prepared);
    ret changed;
}

pub fun set_overlay(s: *Session, path: str, text: str) err[fail.Fail] {
    val staged: res[PreparedOverlay, fail.Fail] = prepare_overlay(s, path, text, false);
    if (sel staged.err) { ret err[fail.Fail].err{staged.err}; }
    var prepared: PreparedOverlay = staged.ok;
    commit_overlay(?prepared);
    ret err[fail.Fail].ok{};
}

pub fun clear_overlay(s: *Session, path: str) res[bool, fail.Fail] {
    val staged: res[PreparedOverlay, fail.Fail] = prepare_overlay(s, path, nil, true);
    if (sel staged.err) { ret res[bool, fail.Fail].err{staged.err}; }
    var prepared: PreparedOverlay = staged.ok;
    ret res[bool, fail.Fail].ok{commit_overlay(?prepared)};
}

pub fun overlay_get(s: *Session, path: str) opt[str] {
    val key_r: res[str, fail.Fail] = source_key(s, path);
    if (sel key_r.err) { ret opt[str].none{}; }
    val key: str = key_r.ok;
    fin { str_free(s.alloc, key); }

    var i: usize = 0;
    for (i < s.overlays.len) {
        if (str_equals(s.overlays.data[i].path, key)) { ret opt[str].some{s.overlays.data[i].text}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

fun source_key(s: *Session, path: str) res[str, fail.Fail] {
    val cleaned: res[str, A.Error] = types_path.clean(s.alloc, path);
    if (sel cleaned.err) { ret res[str, fail.Fail].err{fail.refused(cleaned.err)}; }
    ret res[str, fail.Fail].ok{cleaned.ok};
}

test overlay__set_get_replace_clear {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[Session, fail.Fail] = init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: Session = sr.ok;
    fin { dnit(?s); }

    var bad: i32 = 0;

    val overlay_get_r: opt[str] = overlay_get(?s, "/x/a.mach");
    if (sel overlay_get_r.some) { bad = 1; }
    val absent: res[bool, fail.Fail] = clear_overlay(?s, "/x/a.mach");
    if (!(sel absent.ok && !(absent.ok))) { bad = 1; }

    val set_overlay_r: err[fail.Fail] = set_overlay(?s, "/x/a.mach", "AAA");
    if (sel set_overlay_r.err) { ret 1; }
    val set_overlay_r2: err[fail.Fail] = set_overlay(?s, "/x/b.mach", "BBB");
    if (sel set_overlay_r2.err) { ret 1; }
    if (s.overlays.len != 2)    { bad = 1; }
    val ga: opt[str] = overlay_get(?s, "/x/a.mach");
    val gb: opt[str] = overlay_get(?s, "/x/b.mach");
    if (!(sel ga.some && str_equals(ga.some, "AAA"))) { bad = 1; }
    if (!(sel gb.some && str_equals(gb.some, "BBB"))) { bad = 1; }

    val set_overlay_r3: err[fail.Fail] = set_overlay(?s, "/x/a.mach", "A2");
    if (sel set_overlay_r3.err) { ret 1; }
    if (s.overlays.len != 2)    { bad = 1; }
    val ga2: opt[str] = overlay_get(?s, "/x/a.mach");
    if (!(sel ga2.some && str_equals(ga2.some, "A2"))) { bad = 1; }

    val cleared: res[bool, fail.Fail] = clear_overlay(?s, "/x/a.mach");
    if (!(sel cleared.ok && !(!cleared.ok))) { bad = 1; }
    if (s.overlays.len != 1)                 { bad = 1; }
    val overlay_get_r2: opt[str] = overlay_get(?s, "/x/a.mach");
    if (sel overlay_get_r2.some) { bad = 1; }
    val gb2: opt[str] = overlay_get(?s, "/x/b.mach");
    if (!(sel gb2.some && str_equals(gb2.some, "BBB"))) { bad = 1; }

    ret bad;
}

test overlay__one_file_is_one_entry_however_it_is_spelled {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[Session, fail.Fail] = init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: Session = sr.ok;
    fin { dnit(?s); }

    var bad: i32 = 0;

    val set_overlay_r: err[fail.Fail] = set_overlay(?s, "/x/src/a.mach", "LIVE");
    if (sel set_overlay_r.err) { ret 1; }

    if (!ut_overlay_is(?s, "/x/./src/a.mach", "LIVE") && bad == 0)      { bad = 1; }
    if (!ut_overlay_is(?s, "/x//src/a.mach", "LIVE") && bad == 0)       { bad = 2; }
    if (!ut_overlay_is(?s, "/x/src/./a.mach", "LIVE") && bad == 0)      { bad = 3; }
    if (!ut_overlay_is(?s, "/x/lib/../src/a.mach", "LIVE") && bad == 0) { bad = 4; }

    val set_overlay_r2: err[fail.Fail] = set_overlay(?s, "/x/./src/a.mach", "NEWER");
    if (sel set_overlay_r2.err)                                   { ret 1; }
    if (s.overlays.len != 1 && bad == 0)                          { bad = 5; }
    if (!ut_overlay_is(?s, "/x/src/a.mach", "NEWER") && bad == 0) { bad = 6; }

    val overlay_get_r: opt[str] = overlay_get(?s, "/x/src/b.mach");
    if (sel overlay_get_r.some && bad == 0) { bad = 7; }
    val overlay_get_r2: opt[str] = overlay_get(?s, "/src/a.mach");
    if (sel overlay_get_r2.some && bad == 0) { bad = 8; }

    val cleared: res[bool, fail.Fail] = clear_overlay(?s, "/x//src/a.mach");
    if (!(sel cleared.ok && cleared.ok) && bad == 0) { bad = 9; }
    if (s.overlays.len != 0 && bad == 0)             { bad = 10; }

    ret bad;
}

#[testing]
fun ut_overlay_is(s: *Session, path: str, want: str) bool {
    val g: opt[str] = overlay_get(s, path);
    if (sel g.none) { ret false; }
    ret str_equals(g.some, want);
}

test load_source__source_and_overlay_keys_share_native_path_identity {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[Session, fail.Fail] = init(?alloc);
    if (sel sr.err) { ret 2; }
    var s: Session = sr.ok;
    fin { dnit(?s); }
    var first: str = "/x/./src/a.mach";
    var alias: str = "/x/src/a.mach";
    $if ($mach.build.os == $mach.os.windows) {
        first = "C:\\x/src/./a.mach";
        alias = "C:/x\\src\\a.mach";
    }
    val one: res[lang_source.FileId, fail.Fail] = load_source(?s, first, "before");
    if (sel one.err) { ret 3; }
    val two: res[lang_source.FileId, fail.Fail] = load_source(?s, alias, "after");
    if (sel two.err) { ret 4; }
    val fid: lang_source.FileId = one.ok;
    if (!lang_source.file_same(fid, two.ok)) { ret 5; }
    val file: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, fid);
    if (sel file.none)                        { ret 6; }
    if (!str_equals(file.some.text, "after")) { ret 6; }
    val set_overlay_r: err[fail.Fail] = set_overlay(?s, first, "overlay");
    if (sel set_overlay_r.err)                         { ret 7; }
    if (!ut_overlay_is(?s, file.some.path, "overlay")) { ret 8; }
    $if ($mach.build.os != $mach.os.windows) {
        val literal: res[lang_source.FileId, fail.Fail] = load_source(?s, "/x/src\\a.mach", "literal");
        if (sel literal.err)                        { ret 9; }
        if (lang_source.file_same(literal.ok, fid)) { ret 9; }
    }
    ret 0;
}

test stable_module_id__registry_reorder_and_exhaustion_preserve_existing_identities {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val opened: res[Session, fail.Fail] = init(?alloc);
    if (sel opened.err) { ret 2; }
    var s: Session = opened.ok;
    fin { dnit(?s); }
    val a: res[module.StableModuleId, fail.Fail] = stable_module_id(?s, intern.str_id(1));
    val b: res[module.StableModuleId, fail.Fail] = stable_module_id(?s, intern.str_id(2));
    if (sel a.err) { ret 3; }
    if (sel b.err) { ret 3; }
    val aid:                    module.StableModuleId = a.ok;
    val bid:                    module.StableModuleId = b.ok;
    val register_stable_mid_r2: err[fail.Fail]        = register_stable_mid(?s, aid, module.id(0));
    if (sel register_stable_mid_r2.err) { ret 4; }
    val register_stable_mid_r: err[fail.Fail] = register_stable_mid(?s, bid, module.id(1));
    if (sel register_stable_mid_r.err) { ret 4; }
    reset_module_registry(?s);
    val register_stable_mid_r4: err[fail.Fail] = register_stable_mid(?s, bid, module.id(0));
    if (sel register_stable_mid_r4.err) { ret 5; }
    val register_stable_mid_r3: err[fail.Fail] = register_stable_mid(?s, aid, module.id(1));
    if (sel register_stable_mid_r3.err)                                                                                                       { ret 5; }
    if (!module.stable_same(stable_module_id_lookup(?s, intern.str_id(1)), aid) || !module.same(module_id_for_stable(?s, aid), module.id(1))) { ret 6; }
    s.stable_id_next = module.STABLE_MODULE_NIL;
    val existing: res[module.StableModuleId, fail.Fail] = stable_module_id(?s, intern.str_id(1));
    if (sel existing.err)                      { ret 7; }
    if (!module.stable_same(existing.ok, aid)) { ret 7; }
    val refused: res[module.StableModuleId, fail.Fail] = stable_module_id(?s, intern.str_id(3));
    if (sel refused.ok) { ret 8; }
    if (!module.stable_is_nil(stable_module_id_lookup(?s, intern.str_id(3))) || s.stable_ids.len != 2
        || !module.stable_is_nil(s.stable_id_next)) { ret 9; }
    ret 0;
}

#[testing]
fun t_source_input(s: *Session, id: lang_source.FileId, expected: str, stamp: *query.Revision) i32 {
    val runtime: res[query.QueryRuntime[Session], fail.Fail] = query.runtime[Session](?s.queries);
    if (sel runtime.err) { ret 30; }
    var rt:     query.QueryRuntime[Session]     = runtime.ok;
    val opened: res[query.Operation, fail.Fail] = query.begin(?s.queries);
    if (sel opened.err) { ret 31; }
    val operation: query.Operation                 = opened.ok;
    val read:      res[query.QueryView, fail.Fail] = query.get[Session](?rt, s, ?FILE_TEXT, lang_source.file_index(id)::u64);
    var code:      i32                             = 0;
    if (sel read.err) { code = 32; }
    if (sel read.ok) {
        val view: query.QueryView = read.ok;
        if (view.value_len::usize != str_len(expected)
            || !memory.raw_equal(view.value::ptr, expected::ptr, str_len(expected))) { code = 33; }
        @stamp = view.last_changed;
    }
    val end_r: err[fail.Fail] = query.end(?s.queries, operation);
    if (sel end_r.err) { code = 34; }
    val discard_r: err[fail.Fail] = query.discard(?s.queries, operation);
    if (sel discard_r.err) { code = 35; }
    ret code;
}

#[testing]
fun t_source_publication_attempt(tracker: *T.Testing, existing: bool, ordinal: usize, finished: *bool) i32 {
    val opened: res[Session, fail.Fail] = init(T.allocator_of(tracker));
    if (sel opened.err) { ret 2; }
    var s: Session = opened.ok;
    fin { dnit(?s); }
    val path:      str                = "n4/source.mach";
    var id:        lang_source.FileId = lang_source.file_id(1);
    var old_text:  str                = nil;
    var old_lines: *usize             = nil;
    var old_stamp: query.Revision     = 0;
    if (existing) {
        val loaded: res[lang_source.FileId, fail.Fail] = load_source(?s, path, "before\ntext");
        if (sel loaded.err) { ret 3; }
        id = loaded.ok;
        val before: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, id);
        if (sel before.none) { ret 3; }
        old_text  = before.some.text;
        old_lines = before.some.lines.starts;
        val code: i32 = t_source_input(?s, id, "before\ntext", ?old_stamp);
        if (code != 0) { ret code; }
    }
    val old_len:      usize          = lang_source.count(?s.sources);
    val old_paths:    usize          = s.sources.by_path.len;
    val old_revision: query.Revision = s.queries.revision;
    T.fail_at_ordinal(tracker, T.attempt_count(tracker) + ordinal);
    val attempted: res[lang_source.FileId, fail.Fail] = load_source(?s, path, "after\ntwo\nlines");
    T.clear_failure(tracker);
    if (sel attempted.err) {
        if (lang_source.count(?s.sources) != old_len || s.sources.by_path.len != old_paths || s.queries.revision != old_revision) { ret 4; }
        if (existing) {
            val kept: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, id);
            if (sel kept.none) { ret 5; }
            if (kept.some.text != old_text || kept.some.lines.starts != old_lines
                || !str_equals(kept.some.text, "before\ntext")) { ret 5; }
            var stamp: query.Revision = 0;
            val code:  i32            = t_source_input(?s, id, "before\ntext", ?stamp);
            if (code != 0)          { ret code; }
            if (stamp != old_stamp) { ret 6; }
        }
    }
    if (sel attempted.ok) { @finished = true; }
    val retry: res[lang_source.FileId, fail.Fail] = load_source(?s, path, "after\ntwo\nlines");
    if (sel retry.err)                                                                                              { ret 7; }
    if (!lang_source.file_same(retry.ok, id))                                                                       { ret 7; }
    if (lang_source.count(?s.sources) != 2 || s.sources.by_path.len != 1 || s.queries.revision != old_revision + 1) { ret 8; }
    val file_o: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, id);
    if (sel file_o.none) { ret 9; }
    val file: *lang_source.SourceFile = file_o.some;
    if (!str_equals(file.text, "after\ntwo\nlines") || file.lines.len != 3
        || file.lines.starts[1] != 6 || file.lines.starts[2] != 10) { ret 9; }
    var new_stamp: query.Revision = 0;
    val code:      i32            = t_source_input(?s, id, "after\ntwo\nlines", ?new_stamp);
    if (code != 0)                     { ret code; }
    if (new_stamp != old_revision + 1) { ret 10; }
    ret 0;
}

test load_source__allocation_refusal_preserves_text_identity_and_query_stamp {
    var mode: u32 = 0;
    for (mode < 2) {
        var ordinal:  usize = 1;
        var finished: bool  = false;
        for (ordinal <= 64 && !finished) {
            var tracker: T.Testing;
            val make_r:  err[A.Error] = T.make(?tracker);
            if (sel make_r.err) { ret 1; }
            val code:   i32  = t_source_publication_attempt(?tracker, mode != 0, ordinal, ?finished);
            val leaked: bool = T.leaked(?tracker) || T.double_free_count(?tracker) != 0 || T.tracking_exhausted(?tracker);
            T.dnit(?tracker);
            if (code != 0) { ret code; }
            if (leaked)    { ret 11; }
            ordinal = ordinal + 1;
        }
        if (!finished || ordinal <= 2) { ret 12; }
        mode = mode + 1;
    }
    ret 0;
}

test load_source__active_and_pending_operations_refuse_before_source_mutation {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val opened: res[Session, fail.Fail] = init(?alloc);
    if (sel opened.err) { ret 2; }
    var s: Session = opened.ok;
    fin { dnit(?s); }
    val loaded: res[lang_source.FileId, fail.Fail] = load_source(?s, "n4/source.mach", "before");
    if (sel loaded.err) { ret 3; }
    val id:     lang_source.FileId           = loaded.ok;
    val file_o: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, id);
    if (sel file_o.none) { ret 3; }
    val file:     *lang_source.SourceFile         = file_o.some;
    val text:     str                             = file.text;
    val revision: query.Revision                  = s.queries.revision;
    val started:  res[query.Operation, fail.Fail] = query.begin(?s.queries);
    if (sel started.err) { ret 4; }
    val operation:     query.Operation                    = started.ok;
    val load_source_r: res[lang_source.FileId, fail.Fail] = load_source(?s, "n4/source.mach", "after");
    if (sel load_source_r.ok) { ret 5; }
    val end_r: err[fail.Fail] = query.end(?s.queries, operation);
    if (sel end_r.err) { ret 6; }
    val load_source_r2: res[lang_source.FileId, fail.Fail] = load_source(?s, "n4/new.mach", "new");
    if (sel load_source_r2.ok) { ret 7; }
    if (lang_source.count(?s.sources) != 2 || s.sources.by_path.len != 1 || file.text != text
        || !str_equals(text, "before") || s.queries.revision != revision) { ret 8; }
    val discard_r: err[fail.Fail] = query.discard(?s.queries, operation);
    if (sel discard_r.err) { ret 9; }
    val load_source_r3: res[lang_source.FileId, fail.Fail] = load_source(?s, "n4/source.mach", "after");
    if (sel load_source_r3.err) { ret 10; }
    ret 0;
}

# a stand-in module product and a stand-in file product, both inputs so a test can place them
#[testing]
val T_MODULE_PRODUCT: query.Kind = query.Kind{name: "module product", role: query.INPUT, owner: query.KEY_MODULE};
#[testing]
val T_FILE_PRODUCT:   query.Kind = query.Kind{name: "file product", role: query.INPUT, owner: query.KEY_FILE};

#[testing]
fun t_retained_products(s: *Session, stable: u32, file: u32) bool {
    var number: u32            = stable;
    val placed: err[fail.Fail] = query.set_input(?s.queries, ?T_MODULE_PRODUCT, stable::u64, (?number)::*u8, 4);
    val parsed: err[fail.Fail] = query.set_input(?s.queries, ?T_FILE_PRODUCT, file::u64, (?number)::*u8, 4);
    ret sel placed.ok && sel parsed.ok;
}

#[testing]
fun t_retention_session(alloc: *A.Allocator, s: *Session) bool {
    val made: err[A.Error] = page.make(alloc);
    if (sel made.err) { ret false; }
    val opened: res[Session, fail.Fail] = init(alloc);
    if (sel opened.err) { ret false; }
    @s = opened.ok;
    ret true;
}

#[testing]
fun t_record_round(s: *Session, id: retention.RetainerId, first: u32, count: u32, rejected: bool, finished: bool) bool {
    var i: u32 = 0;
    for (i < count) {
        val recorded: err[fail.Fail] = retention.record(?s.retention, id, (first + i)::module.StableModuleId,
            (first + i + 100)::lang_source.FileId, rejected);
        if (sel recorded.err) { ret false; }
        i = i + 1;
    }
    val ended: err[fail.Fail] = retention.end_round(?s.retention, id, finished);
    if (sel ended.err) { ret false; }
    val retired: err[fail.Fail] = retention.retire(?s.retention, ?s.queries);
    ret sel retired.ok;
}

test retention__a_module_two_retainers_name_goes_only_when_both_let_it_go {
    var alloc: A.Allocator;
    var s:     Session;
    if (!t_retention_session(?alloc, ?s)) { ret 1; }
    fin { dnit(?s); }
    val first:  res[retention.RetainerId, fail.Fail] = retention.open(?s.retention);
    val second: res[retention.RetainerId, fail.Fail] = retention.open(?s.retention);
    if (sel first.err)                                                                                                 { ret 2; }
    if (sel second.err)                                                                                                { ret 2; }
    if (retention.retainer_same(first.ok, second.ok) || retention.retainer_same(first.ok, retention.RETAINER_SESSION)) { ret 3; }
    if (!t_record_round(?s, first.ok, 5, 1, false, true))                                                              { ret 4; }
    if (!t_record_round(?s, second.ok, 5, 1, false, true))                                                             { ret 5; }
    if (!t_retained_products(?s, 5, 105))                                                                              { ret 6; }
    val released: err[fail.Fail] = retention.release(?s.retention, first.ok);
    if (sel released.err) { ret 7; }
    val retired: err[fail.Fail] = retention.retire(?s.retention, ?s.queries);
    if (sel retired.err)                                       { ret 8; }
    if (query.owned_len(?s.queries, query.KEY_MODULE, 5) != 1) { ret 9; }
    if (query.owned_len(?s.queries, query.KEY_FILE, 105) != 1) { ret 10; }
    if (retention.held_count(?s.retention) != 1)               { ret 11; }
    val both: err[fail.Fail] = retention.release(?s.retention, second.ok);
    if (sel both.err) { ret 12; }
    val gone: err[fail.Fail] = retention.retire(?s.retention, ?s.queries);
    if (sel gone.err)                                          { ret 13; }
    if (query.owned_len(?s.queries, query.KEY_MODULE, 5) != 0) { ret 14; }
    if (query.owned_len(?s.queries, query.KEY_FILE, 105) != 0) { ret 15; }
    if (retention.held_count(?s.retention) != 0)               { ret 16; }
    # a released slot is handed out again, holding nothing
    val reused: res[retention.RetainerId, fail.Fail] = retention.open(?s.retention);
    if (sel reused.err)                                                                                                 { ret 17; }
    if (!retention.retainer_same(reused.ok, first.ok) || retention.holds(?s.retention, reused.ok, module.stable_id(5))) { ret 18; }
    ret 0;
}

test retention__releasing_live_retainers_retires_their_keys_and_keeps_the_rest {
    var alloc: A.Allocator;
    var s:     Session;
    if (!t_retention_session(?alloc, ?s)) { ret 1; }
    fin { dnit(?s); }
    val root: res[retention.RetainerId, fail.Fail] = retention.open(?s.retention);
    if (sel root.err)                                    { ret 2; }
    if (!t_record_round(?s, root.ok, 1, 3, false, true)) { ret 3; }
    # the session's own retainer holds module 7 and no round was ever closed on it
    val kept: err[fail.Fail] = retention.record(?s.retention, retention.RETAINER_SESSION, module.stable_id(7), lang_source.file_id(107), false);
    if (sel kept.err) { ret 4; }
    var id: u32 = 1;
    for (id < 4) {
        if (!t_retained_products(?s, id, id + 100)) { ret 5; }
        id = id + 1;
    }
    if (!t_retained_products(?s, 7, 107)) { ret 6; }
    # a released retainer whose round is still open lets go of its attempt too
    val opened: err[fail.Fail] = retention.record(?s.retention, root.ok, module.stable_id(4), lang_source.file_id(104), false);
    if (sel opened.err)                   { ret 7; }
    if (!t_retained_products(?s, 4, 104)) { ret 8; }
    val released: err[fail.Fail] = retention.release(?s.retention, root.ok);
    if (sel released.err) { ret 9; }
    val retired: err[fail.Fail] = retention.retire(?s.retention, ?s.queries);
    if (sel retired.err)                                       { ret 10; }
    if (query.shard_len(?s.queries, ?T_MODULE_PRODUCT) != 1)   { ret 11; }
    if (query.shard_len(?s.queries, ?T_FILE_PRODUCT) != 1)     { ret 12; }
    if (query.owned_len(?s.queries, query.KEY_MODULE, 7) != 1) { ret 13; }
    if (retention.held_count(?s.retention) != 1)               { ret 14; }
    # releasing twice is a no-op, and recording under a released retainer is refused
    val again: err[fail.Fail] = retention.release(?s.retention, root.ok);
    if (sel again.err) { ret 15; }
    val refused: err[fail.Fail] = retention.record(?s.retention, root.ok, module.stable_id(9), lang_source.file_id(109), false);
    if (sel refused.ok) { ret 16; }
    ret 0;
}

test retention__an_unfinished_or_rejected_round_keeps_the_settled_set_and_its_own {
    var alloc: A.Allocator;
    var s:     Session;
    if (!t_retention_session(?alloc, ?s)) { ret 1; }
    fin { dnit(?s); }
    val id: retention.RetainerId = retention.RETAINER_SESSION;
    if (!t_record_round(?s, id, 1, 2, false, true)) { ret 2; }
    # a plan that stopped partway: its own modules join the settled ones
    if (!t_record_round(?s, id, 3, 1, false, false))                                                                        { ret 3; }
    if (!retention.holds(?s.retention, id, module.stable_id(1)) || !retention.holds(?s.retention, id, module.stable_id(3))) { ret 4; }
    # the next failure replaces the previous failure's modules, never adds to them
    if (!t_record_round(?s, id, 4, 1, true, true))                                                                         { ret 5; }
    if (retention.holds(?s.retention, id, module.stable_id(3)) || !retention.holds(?s.retention, id, module.stable_id(4))) { ret 6; }
    if (!retention.holds(?s.retention, id, module.stable_id(2)) || retention.held_count(?s.retention) != 3)                { ret 7; }
    # an accepted round keeps exactly what it loaded
    if (!t_record_round(?s, id, 5, 1, false, true))                                                         { ret 8; }
    if (retention.held_count(?s.retention) != 1 || !retention.holds(?s.retention, id, module.stable_id(5))) { ret 9; }
    # a rejected round falls back to that one
    if (!t_record_round(?s, id, 6, 1, true, true))                                                          { ret 10; }
    if (retention.held_count(?s.retention) != 2 || !retention.holds(?s.retention, id, module.stable_id(5))) { ret 11; }
    ret 0;
}

test retention__a_file_two_modules_share_outlives_the_one_released {
    var alloc: A.Allocator;
    var s:     Session;
    if (!t_retention_session(?alloc, ?s)) { ret 1; }
    fin { dnit(?s); }
    val first:  res[retention.RetainerId, fail.Fail] = retention.open(?s.retention);
    val second: res[retention.RetainerId, fail.Fail] = retention.open(?s.retention);
    if (sel first.err)  { ret 2; }
    if (sel second.err) { ret 2; }
    val one: err[fail.Fail] = retention.record(?s.retention, first.ok, module.stable_id(5), lang_source.file_id(105), false);
    val two: err[fail.Fail] = retention.record(?s.retention, second.ok, module.stable_id(6), lang_source.file_id(105), false);
    if (sel one.err || sel two.err)       { ret 3; }
    if (!t_retained_products(?s, 5, 105)) { ret 4; }
    if (!t_retained_products(?s, 6, 105)) { ret 4; }
    val released: err[fail.Fail] = retention.release(?s.retention, first.ok);
    if (sel released.err) { ret 5; }
    val retired: err[fail.Fail] = retention.retire(?s.retention, ?s.queries);
    if (sel retired.err)                                       { ret 6; }
    if (query.owned_len(?s.queries, query.KEY_MODULE, 5) != 0) { ret 7; }
    if (query.owned_len(?s.queries, query.KEY_MODULE, 6) != 1) { ret 8; }
    if (query.owned_len(?s.queries, query.KEY_FILE, 105) != 1) { ret 9; }
    ret 0;
}

# register one module's identity at a refusal armed `ordinal` allocations after the
# session opens: a refusal publishes nothing
#[testing]
fun register_attempt(ordinal: usize, finished: *bool) i32 {
    var failing: T.Testing;
    val made:    err[A.Error] = T.make(?failing);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?failing); }
    val sr: res[Session, fail.Fail] = init(T.allocator_of(?failing));
    if (sel sr.err) { ret 2; }
    var s:   Session = sr.ok;
    var bad: i32             = 0;
    T.fail_at_ordinal(?failing, T.attempt_count(?failing) + ordinal);
    val r: err[fail.Fail] = register_module_identity(?s, module.id(3), intern.str_id(9), module.stable_id(5));
    if (sel r.err) {
        if (module_count(?s) != 0 || !intern.str_is_nil(module_fqn(?s, module.id(3)))
            || !module.is_nil(module_id_for_stable(?s, module.stable_id(5)))) { bad = 5; }
    }
    or {
        @finished = true;
        if (module_count(?s) != 4 || !intern.str_same(module_fqn(?s, module.id(3)), intern.str_id(9))
            || !module.same(module_id_for_stable(?s, module.stable_id(5)), module.id(3))) { bad = 6; }
    }
    T.clear_failure(?failing);
    dnit(?s);
    if (T.tracking_exhausted(?failing) || T.leaked(?failing) || T.double_free_count(?failing) != 0) { ret 7; }
    ret bad;
}

test register_module__an_allocation_refusal_publishes_nothing {
    var ordinal:  usize = 1;
    var finished: bool  = false;
    for (!finished && ordinal <= 64) {
        val code: i32 = register_attempt(ordinal, ?finished);
        if (code != 0) { ret code; }
        ordinal = ordinal + 1;
    }
    # the first attempt must have been refused, so a refusal was exercised
    if (!finished || ordinal <= 2) { ret 20; }
    ret 0;
}
