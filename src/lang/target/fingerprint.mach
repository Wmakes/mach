# the bytes that identify a resolved target to the build cache
use std.types.bool.bool;

use lang_fingerprint: mach.lang.fingerprint;
use mach.lang.target.binding;
use catalog_abi:  mach.lang.target.catalog.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use catalog_os:   mach.lang.target.catalog.os;
use mach.lang.target.isa;
use target_model: mach.lang.target.model;
use target_of:    mach.lang.target.of;
use mach.lang.wire;

# moves whenever the bytes a target fingerprints change meaning
val VERSION: u8 = 15;

fun b2u8(b: bool) u8 {
    if (b) { ret 1; }
    ret 0;
}

pub fun put(t: *binding.Binding, s: *wire.Sink) {
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, t.target.env_name);

    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_ARCH, catalog_arch.VERSION, catalog_arch.fingerprint_tag(t.target.arch_id));
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ARCH, VERSION, t.isa.name);

    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_ABI, catalog_abi.VERSION, catalog_abi.fingerprint_tag(t.target.abi_id));
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_ABI, VERSION, t.abi.name);
    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_ABI, VERSION, t.abi.passing);

    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_OS, catalog_os.VERSION, catalog_os.fingerprint_tag(t.target.os_id));
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_OS, VERSION, t.os.name);

    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_OF, target_of.FINGERPRINT_VERSION, t.of.fingerprint_tag);
    lang_fingerprint.put_domain_str(s, lang_fingerprint.DOMAIN_OF, VERSION, t.of.name);

    lang_fingerprint.put_domain_u32(s, lang_fingerprint.DOMAIN_DEBUG, VERSION, t.target.debug_id);

    var backend_kind: u8 = 0;
    if (isa.emits_whole_module(t.isa)) { backend_kind = 1; }
    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_BACKEND, VERSION, backend_kind);

    lang_fingerprint.put_domain_u64(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.target.base);
    lang_fingerprint.put_domain_u64(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.target.page_size);
    lang_fingerprint.put_domain_u64(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.target.stack_reserve);
    lang_fingerprint.put_domain_u64(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.target.stack_commit);
    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, b2u8(t.target.variadic_args_on_stack));
    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, b2u8(t.target.fixed_args_natural_size));
    lang_fingerprint.put_domain_u32(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.target.reg_arg_align);
    lang_fingerprint.put_domain_u32(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.target.reg_arg_extend);
    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, b2u8(t.target.agg_arg_natural_align));
    lang_fingerprint.put_domain_u8(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.abi.half);
    lang_fingerprint.put_domain_u32(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.target.va_list_size);
    lang_fingerprint.put_domain_u32(s, lang_fingerprint.DOMAIN_IMAGE, VERSION, t.target.va_list_align);

    model_put(?t.target.model, s);
    fs_policy_put(?t.target.fs_policy, s);
}

fun fs_policy_put(p: *catalog_os.FsPolicy, s: *wire.Sink) {
    val d: lang_fingerprint.Domain = lang_fingerprint.DOMAIN_FS_POLICY;
    val v: u8                      = VERSION;

    lang_fingerprint.put_domain_str(s, d, v, p.sysroot);
    lang_fingerprint.put_domain_str(s, d, v, p.toolchain_root);
    lang_fingerprint.put_domain_str(s, d, v, p.dynamic_interpreter);
    lang_fingerprint.put_domain_str(s, d, v, p.platform_lib);
    lang_fingerprint.put_domain_u32(s, d, v, p.libdir_len);

    var li: u32 = 0;
    for (li < p.libdir_len) {
        lang_fingerprint.put_domain_str(s, d, v, p.libdirs[li]);
        li = li + 1;
    }
}

# a resolved model is the registered template, which the compiler build fixes,
# with the selection applied to it and the convention's stack rules over it;
# the template and the convention are named above, so the selection is what
# tells two models of one compiler apart, and no field of the model is mirrored
fun model_put(m: *target_model.Machine, s: *wire.Sink) {
    lang_fingerprint.put_domain_u64(s, lang_fingerprint.DOMAIN_TARGET_MODEL, VERSION, m.extensions);
}
