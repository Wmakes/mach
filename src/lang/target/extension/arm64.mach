use mach.lang.target.extension;

# the aarch64 extension vocabulary over the AdvSIMD baseline
pub val SHA2: u64 = 0x1;

# FEAT_SB, the speculation barrier `sb` (Armv8.0 optional, Armv8.5 mandatory)
pub val SB: u64 = 0x2;

# FEAT_AES, the aese, aesd, aesmc and aesimc rounds
pub val AES: u64 = 0x4;

# FEAT_PMULL, the 64x64 carry-less pmull and pmull2. the architecture reports
# it as a higher value of the one ID_AA64ISAR0_EL1.AES field, so it brings aes
pub val PMULL: u64 = 0x8;

# FEAT_FP16, half-precision arithmetic, comparison and integer conversion on
# the h registers (Armv8.2 optional). converting between half and single or
# double precision is the base FP and needs no extension
pub val FP16: u64 = 0x10;

val ROW_COUNT: u32 = 5;

# masc's aarch64 catalog spells these as llvm does, where `aes` names both FEAT_AES and
# FEAT_PMULL and `sha2` both FEAT_SHA256 and FEAT_SHA1, and has no `pmull`, so mach's
# spellings are its own until the catalog names each of them one to one (#4779)
val ROWS: [ROW_COUNT]extension.Extension = [ROW_COUNT]extension.Extension{
    extension.Extension{name: "sha2", bit: SHA2},
    extension.Extension{name: "sb", bit: SB},
    extension.Extension{name: "aes", bit: AES},
    extension.Extension{name: "pmull", bit: PMULL, implies: AES},
    extension.Extension{name: "fp16", bit: FP16},
};

pub val TABLE: extension.Table = extension.Table{source: "mach's aarch64 vocabulary", catalog: nil, rows: ?ROWS[0], count: ROW_COUNT};
