use aarch64_extension: masc.isa.aarch64.extension;

use mach.lang.target.extension;

# the aarch64 extensions the code generator emits against, over the AdvSIMD
# baseline, each a row of masc's aarch64 catalog, which names it and says what it
# implies

# the sha256h, sha256h2, sha256su0 and sha256su1 rounds. masc's FEAT_SHA1 and
# FEAT_SHA256 imply each other, and `sha2` names both and stands for FEAT_SHA1,
# so the row is FEAT_SHA1
pub val SHA2: u64 = 0x1;

# FEAT_SB, the speculation barrier `sb` (Armv8.0 optional, Armv8.5 mandatory)
pub val SB: u64 = 0x2;

# FEAT_AES, the aese, aesd, aesmc and aesimc rounds
pub val AES: u64 = 0x4;

# FEAT_PMULL, the 64x64 carry-less pmull and pmull2. the architecture reports
# it as a higher value of the one ID_AA64ISAR0_EL1.AES field, so it brings aes
pub val PMULL: u64 = 0x8;

# FEAT_FP16, half-precision arithmetic, comparison and integer conversion on
# the h registers (Armv8.2 optional). converting between half and single or
# double precision is the base FP and needs no extension
pub val FP16: u64 = 0x10;

val ROW_COUNT: u32 = 5;

val ROWS: [ROW_COUNT]extension.Extension = [ROW_COUNT]extension.Extension{
    extension.Extension{handle: aarch64_extension.id.SHA1, bit: SHA2},
    extension.Extension{handle: aarch64_extension.id.SB, bit: SB},
    extension.Extension{handle: aarch64_extension.id.AES, bit: AES},
    extension.Extension{handle: aarch64_extension.id.PMULL, bit: PMULL},
    extension.Extension{handle: aarch64_extension.id.FP16, bit: FP16},
};

pub val TABLE: extension.Table = extension.Table{source: "masc's aarch64 catalog", catalog: ?aarch64_extension.CATALOG, rows: ?ROWS[0], count: ROW_COUNT};
