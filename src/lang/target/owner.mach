# the owners' row each mach target means
#
# a mach target cell, an operating system, an instruction set and a calling
# convention, names one target row of mirl's, which is the tuple of rows the
# lower layers own: mink's architecture and system, mirl's convention and masc's
# baseline. the cell states that tuple as its owners spell it and mirl resolves
# it, so mach states which row it means and none of the row's facts. a cell no
# owner has a row for yet keeps mach's own facts until one does (#4779)
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;

use mirl.ir.module.Tuple;
use types:       mirl.ir.type;
use mirl_target: mirl.target;

use mach.lang.fail;
use mach.lang.layout;
use catalog_abi:  mach.lang.target.catalog.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use catalog_os:   mach.lang.target.catalog.os;

# one mach target cell and the tuple its owners spell it by
# ---
# os, arch, abi: the cell, by mach's catalog ids
# system:       mink's system row
# architecture: mink's architecture row
# convention:   mirl's convention row, "" where mirl's row states none
# baseline:     the selection masc reads the row's baseline from, "" where the
#               row states none
rec Named {
    os:           u32;
    arch:         u32;
    abi:          u32;
    system:       str;
    architecture: str;
    convention:   str;
    baseline:     str;
}

# every cell an owner has a row for. riscv64 linux under lp64d is mirl's rv64gc
# row. riscv32 freestanding is rv32imac under ilp32, the imac row mirl#192 added
# beside its rv32i floor, as mach's riscv32 freestanding has always selected imac
val NAMED_COUNT: usize              = 10;
val NAMED:       [NAMED_COUNT]Named = [NAMED_COUNT]Named{
    Named{os: catalog_os.LINUX, arch: catalog_arch.X86_64, abi: catalog_abi.SYSV, system: "linux", architecture: "x86_64", convention: "", baseline: ""},
    Named{os: catalog_os.DARWIN, arch: catalog_arch.X86_64, abi: catalog_abi.SYSV, system: "darwin", architecture: "x86_64", convention: "", baseline: ""},
    Named{os: catalog_os.WINDOWS, arch: catalog_arch.X86_64, abi: catalog_abi.WIN64, system: "windows", architecture: "x86_64", convention: "", baseline: ""},
    Named{os: catalog_os.FREESTANDING, arch: catalog_arch.X86_64, abi: catalog_abi.SYSV, system: "freestanding", architecture: "x86_64", convention: "", baseline: ""},
    Named{os: catalog_os.LINUX, arch: catalog_arch.AARCH64, abi: catalog_abi.AAPCS64, system: "linux", architecture: "aarch64", convention: "", baseline: ""},
    Named{os: catalog_os.DARWIN, arch: catalog_arch.AARCH64, abi: catalog_abi.AAPCS64, system: "darwin", architecture: "aarch64", convention: "", baseline: ""},
    Named{os: catalog_os.FREESTANDING, arch: catalog_arch.AARCH64, abi: catalog_abi.AAPCS64, system: "freestanding", architecture: "aarch64", convention: "", baseline: ""},
    Named{os: catalog_os.LINUX, arch: catalog_arch.RISCV64, abi: catalog_abi.LP64D, system: "linux", architecture: "riscv64", convention: "lp64d", baseline: "rv64gc"},
    Named{os: catalog_os.FREESTANDING, arch: catalog_arch.RISCV32, abi: catalog_abi.ILP32, system: "freestanding", architecture: "riscv32", convention: "ilp32", baseline: "rv32imac"},
    Named{os: catalog_os.VULKAN, arch: catalog_arch.SPIRV, abi: catalog_abi.SPIRV, system: "vulkan", architecture: "spirv", convention: "", baseline: ""},
};

fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

fun named_of(os_id: u32, arch_id: u32, abi_id: u32) opt[*Named] {
    var i: usize = 0;
    for (i < NAMED_COUNT) {
        val n: *Named = ?NAMED[i];
        if (n.os == os_id && n.arch == arch_id && n.abi == abi_id) { ret opt[*Named].some{n}; }
        i = i + 1;
    }
    ret opt[*Named].none{};
}

# the mirl row a named cell means, refused when mirl names no row so: the table
# here and mirl's rows disagree
fun row_of_named(a: *A.Allocator, n: *Named) res[*mirl_target.Target, fail.Fail] {
    val tuple: Tuple                                            = Tuple{arch: view_of(n.architecture), system: view_of(n.system), convention: view_of(n.convention), baseline: view_of(n.baseline)};
    val found: res[opt[*mirl_target.Target], mirl_target.Error] = mirl_target.row_of(a, tuple);
    if (sel found.err) {
        ret res[*mirl_target.Target, fail.Fail].err{fail.formatted(a, "target: mirl refused the tuple {} {} {} {}", n.architecture, n.system, n.convention, n.baseline)};
    }
    if (sel found.ok.none) {
        ret res[*mirl_target.Target, fail.Fail].err{fail.formatted(a, "target: mirl has no row for the tuple {} {} {} {}", n.architecture, n.system, n.convention, n.baseline)};
    }
    ret res[*mirl_target.Target, fail.Fail].ok{found.ok.some};
}

# the mirl row the cell of `os_id`, `arch_id` and `abi_id` means, none for a cell no
# owner has a row for yet
pub fun row_for(a: *A.Allocator, os_id: u32, arch_id: u32, abi_id: u32) res[opt[*mirl_target.Target], fail.Fail] {
    val n: opt[*Named] = named_of(os_id, arch_id, abi_id);
    if (sel n.none) { ret res[opt[*mirl_target.Target], fail.Fail].ok{opt[*mirl_target.Target].none{}}; }
    val row: res[*mirl_target.Target, fail.Fail] = row_of_named(a, n.some);
    if (sel row.err) { ret res[opt[*mirl_target.Target], fail.Fail].err{row.err}; }
    ret res[opt[*mirl_target.Target], fail.Fail].ok{opt[*mirl_target.Target].some{row.ok}};
}

# the extent mirl lays `shape` out at on `l`'s target, in the default address space
fun extent_of(l: *mirl_target.Layout, t: *types.Table, shape: types.Shape) res[layout.Extent, mirl_target.Error] {
    val ty: res[types.Type, types.Error] = types.intern(t, shape);
    if (sel ty.err) { ret res[layout.Extent, mirl_target.Error].err{mirl_target.Error.types{ty.err}}; }
    val e: res[mirl_target.Extent, mirl_target.Error] = mirl_target.extent(l, ty.ok, types.DEFAULT_SPACE);
    if (sel e.err) { ret res[layout.Extent, mirl_target.Error].err{e.err}; }
    ret res[layout.Extent, mirl_target.Error].ok{layout.extent(e.ok.size::u32, e.ok.align::u32)};
}

# the format of a float width
fun format_of(bits: u32) types.Format {
    if (bits == 16) { ret types.BINARY16; }
    if (bits == 32) { ret types.BINARY32; }
    ret types.BINARY64;
}

# the extents mirl's data layout of `row` gives every primitive. a pointer mirl
# holds logically, with no representation in memory, has none
pub fun scalars_of(a: *A.Allocator, row: *mirl_target.Target) res[layout.Scalars, fail.Fail] {
    var t: types.Table = types.init(a);
    fin { types.dnit(?t); }
    var l: mirl_target.Layout = mirl_target.of(row, ?t);
    var s: layout.Scalars     = layout.scalars_none();
    var i: usize              = 0;
    for (i < 5) {
        val e: res[layout.Extent, mirl_target.Error] = extent_of(?l, ?t, types.Shape.integer{types.Integer{width: layout.INTEGER_WIDTHS[i]}});
        if (sel e.err) { ret res[layout.Scalars, fail.Fail].err{fail.formatted(a, "target: mirl lays out no {}-bit integer on this target", layout.INTEGER_WIDTHS[i])}; }
        s.integers[i] = e.ok;
        i             = i + 1;
    }
    i = 0;
    for (i < 3) {
        val e: res[layout.Extent, mirl_target.Error] = extent_of(?l, ?t, types.Shape.float{types.Float{format: format_of(layout.FLOAT_WIDTHS[i])}});
        if (sel e.err) { ret res[layout.Scalars, fail.Fail].err{fail.formatted(a, "target: mirl lays out no {}-bit float on this target", layout.FLOAT_WIDTHS[i])}; }
        s.floats[i] = e.ok;
        i           = i + 1;
    }
    val p: res[layout.Extent, mirl_target.Error] = extent_of(?l, ?t, types.Shape.pointer{types.Pointer{space: types.DEFAULT_SPACE}});
    if (sel p.ok) { s.pointer = opt[layout.Extent].some{p.ok}; }
    or (sel p.err) {
        if (!(sel p.err.unsized)) { ret res[layout.Scalars, fail.Fail].err{fail.message("target: mirl lays out no pointer on this target")}; }
    }
    s.held = true;
    ret res[layout.Scalars, fail.Fail].ok{s};
}

# a type graph of the test below: node `id` is `nodes[id]`, and field `i` of an
# aggregate is the node `kids[nodes[id].child + i]`
#[testing]
rec TGraph {
    nodes: *layout.Node;
    kids:  *u32;
}

#[testing]
fun t_describe(g: *TGraph, id: u32) layout.Node {
    ret g.nodes[id];
}

#[testing]
fun t_field(g: *TGraph, id: u32, i: u32) u32 {
    ret g.kids[g.nodes[id].child + i];
}

#[testing]
fun t_scalar(bytes: u32, float: bool) layout.Node {
    var n: layout.Node = layout.node(layout.NODE_SCALAR);
    n.bytes = bytes;
    n.float = float;
    ret n;
}

#[testing]
fun t_aggregate(first_kid: u32, count: u32, overlays: bool) layout.Node {
    var n: layout.Node = layout.node(layout.NODE_AGGREGATE);
    n.child       = first_kid;
    n.field_count = count;
    n.overlays    = overlays;
    ret n;
}

#[testing]
fun t_type(t: *types.Table, shape: types.Shape) types.Type {
    val ty: res[types.Type, types.Error] = types.intern(t, shape);
    if (sel ty.err) { ret types.Type{index: 0xFFFFFFFF}; }
    ret ty.ok;
}

# whether mach's extent of node `id` is mirl's extent of `ty` on `l`'s target
#[testing]
fun t_agrees(g: *TGraph, id: u32, m: layout.Machine, l: *mirl_target.Layout, ty: types.Type) bool {
    val ours: layout.Extent                              = layout.extent_of[TGraph](g, t_describe, t_field, id, m);
    val owns: res[mirl_target.Extent, mirl_target.Error] = mirl_target.extent(l, ty, types.DEFAULT_SPACE);
    if (!ours.ok)    { ret false; }
    if (sel owns.ok) { ret ours.size::u64 == owns.ok.size && ours.align::u64 == owns.ok.align; }
    ret false;
}

# every named cell means a row of mirl's, and on each the size and alignment mach lays
# every primitive and representative aggregates out at are mirl's
test scalars_of__every_primitive_and_aggregate_agrees_with_mirl_on_every_target {
    var a: A.Allocator;
    page.make(?a);
    var i: usize = 0;
    for (i < NAMED_COUNT) {
        val row: res[*mirl_target.Target, fail.Fail] = row_of_named(?a, ?NAMED[i]);
        if (sel row.err) { ret 1; }
        val held: res[layout.Scalars, fail.Fail] = scalars_of(?a, row.ok);
        if (sel held.err) { ret 2; }
        val m: layout.Machine = layout.with_scalars(layout.machine(8, 128, 128), held.ok);

        var t: types.Table = types.init(?a);
        fin { types.dnit(?t); }
        var l: mirl_target.Layout = mirl_target.of(row.ok, ?t);

        # the primitives u8 to u128, f16 to f64 and the pointer at 0..8, then
        # rec {u8, u64}, rec {u16, u128, u8}, [3]u32, uni {u8, f64} and
        # rec {rec {u8, u64}, f16, u32}
        var nodes: [14]layout.Node;
        var tys:   [14]types.Type;
        var k:     u32 = 0;
        for (k < 5) {
            nodes[k] = t_scalar(layout.INTEGER_WIDTHS[k] / 8, false);
            tys[k]   = t_type(?t, types.Shape.integer{types.Integer{width: layout.INTEGER_WIDTHS[k]}});
            k        = k + 1;
        }
        for (k < 8) {
            nodes[k] = t_scalar(layout.FLOAT_WIDTHS[k - 5] / 8, true);
            tys[k]   = t_type(?t, types.Shape.float{types.Float{format: format_of(layout.FLOAT_WIDTHS[k - 5])}});
            k        = k + 1;
        }
        nodes[8] = layout.node(layout.NODE_POINTER);
        tys[8]   = t_type(?t, types.Shape.pointer{types.Pointer{space: types.DEFAULT_SPACE}});
        val kids: [10]u32 = [10]u32{0, 3, 1, 4, 0, 0, 7, 9, 5, 2};
        val g:    TGraph  = TGraph{nodes: ?nodes[0], kids: ?kids[0]};
        nodes[9]        = t_aggregate(0, 2, false);
        nodes[10]       = t_aggregate(2, 3, false);
        nodes[11]       = layout.node(layout.NODE_ARRAY);
        nodes[11].child = 2;
        nodes[11].count = 3;
        nodes[12]       = t_aggregate(5, 2, true);
        nodes[13]       = t_aggregate(7, 3, false);
        var members: [10]types.Type;
        k = 0;
        for (k < 10) {
            members[k] = tys[kids[k]];
            k          = k + 1;
        }
        val none: opt[Slice[u64]] = opt[Slice[u64]].none{};
        tys[9]     = t_type(?t, types.Shape.structure{types.Structure{members: Slice[types.Type]{data: ?members[0], size: 2}, offsets: none}});
        tys[10]    = t_type(?t, types.Shape.structure{types.Structure{members: Slice[types.Type]{data: ?members[2], size: 3}, offsets: none}});
        tys[11]    = t_type(?t, types.Shape.array{types.Array{count: 3, element: tys[2], stride: opt[u64].none{}}});
        tys[12]    = t_type(?t, types.Shape.union{types.Union{members: Slice[types.Type]{data: ?members[5], size: 2}}});
        members[7] = tys[9];
        tys[13]    = t_type(?t, types.Shape.structure{types.Structure{members: Slice[types.Type]{data: ?members[7], size: 3}, offsets: none}});

        k = 0;
        for (k < 14) {
            # a pointer mirl holds logically lays out nowhere, and mach keeps its own
            if (k != 8 || sel held.ok.pointer.some) {
                if (!t_agrees(?g, k, m, ?l, tys[k])) { ret 10 + k::i32; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}
