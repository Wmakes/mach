use mink_spirv: mink.catalog.os.spirv;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use catalog_arch:   mach.lang.target.catalog.arch;
use catalog_os:     mach.lang.target.catalog.os;
use target_of:      mach.lang.target.of;
use lang_target_os: mach.lang.target.os;

# vulkan runs spir-v modules only: no loader maps them, no entry is fixed (the
# module names its own entry points) and no runtime is linked
val FS_POLICY: catalog_os.FsPolicy = catalog_os.FsPolicy{
    sysroot:             "",
    toolchain_root:      "",
    dynamic_interpreter: "",
    platform_lib:        "",
    libdir_len:          0,
};

val SUPPORTED_OFS: [1]str = [1]str{"spirv"};

# a spir-v module has no va_list, so the os declares no row of its own for spirv and
# runs any isa its one format covers, which is spirv alone
val ISA_ANY: lang_target_os.IsaRow = lang_target_os.IsaRow{
    arch:      catalog_arch.UNKNOWN,
    abis:      lang_target_os.AbiSet{names: [lang_target_os.ABI_MAX]str{"", "", "", ""}, len: 0, unconstrained: true},
    fs_policy: ?FS_POLICY,
};

pub val VTABLE: lang_target_os.OsVTable = lang_target_os.OsVTable{
    id:                 catalog_os.VULKAN,
    name:               mink_spirv.VULKAN.name,
    default_of:         "spirv",
    supported_ofs:      ?SUPPORTED_OFS[0],
    supported_of_count: 1,
    isa_rows:           nil,
    isa_row_count:      0,
    isa_any:            ?ISA_ANY,
    entry_symbol:       "",
    c_symbol_prefix:    "",
    base_addr:          0,
    page_size:          0,
    stack_probe:        false,
    mapped_by_loader:   false,
    naming:             target_of.SystemNaming{static_prefix: "lib", static_suffix: ".a", executable_suffix: ""},
};
