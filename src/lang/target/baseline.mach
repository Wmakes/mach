# a target's baseline: the selection of masc's catalog for its instruction set the
# target stands on before the extensions it adds, spelled as masc spells one (an
# isa string such as `rv32imc` on riscv)
#
# masc reads and spells the selection, closes it over the catalog's implications
# and says whether the architecture enters it, so mach states none of the grammar.
# mach keeps only which catalog rows its code generator emits against, as the
# selection bits of the instruction set's extension table
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.allocator.page;
use std.collections.bitset;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.text.string.str_dup_range;

use masc_diagnostic: masc.core.diagnostic;
use masc_extension:  masc.core.extension;
use masc.core.requirement;
use masc_set:   masc.core.set;
use masc_state: masc.core.state;
use masc_isa:   masc.isa.isa;
use mink_arch:  mink.catalog.arch;

use mach.lang.fail;
use catalog_arch: mach.lang.target.catalog.arch;
use mach.lang.target.extension;
use extension_riscv: mach.lang.target.extension.riscv;

# masc's set for mink's architecture `arch`, nil when masc registers none
fun set_of(arch: *mink_arch.Arch) *masc_set.Set {
    if (arch == nil) { ret nil; }
    val s: opt[*masc_set.Set] = masc_set.find(?masc_isa.REGISTRY, arch);
    if (sel s.none) { ret nil; }
    ret s.some;
}

# whether masc's catalog for mink's architecture `arch` spells a selection, as
# riscv's isa strings do, so a target of it takes a `baseline`
pub fun spells(arch: *mink_arch.Arch) bool {
    val s: *masc_set.Set = set_of(arch);
    if (s == nil || s.extensions == nil) { ret false; }
    ret s.extensions.syntax != ?masc_extension.LIST;
}

# whether a target of mink's architecture `arch` takes a `baseline`: masc's catalog
# for it spells a selection, and `t`, the table mach's code generator emits against,
# is that catalog's. aarch64's masc spells, but mach's vocabulary for it is its own
# until #4779
pub fun takes_baseline(arch: *mink_arch.Arch, t: *extension.Table) bool {
    if (!spells(arch) || t == nil) { ret false; }
    ret t.catalog == set_of(arch).extensions;
}

# the catalog arch id of the first instruction set whose masc catalog reads
# `spelling` as a selection its architecture enters, catalog_arch.UNKNOWN when none
# does, as an isa written as the selection it meant names its architecture
pub fun entered_by(a: *A.Allocator, spelling: str) u32 {
    var i: usize = 0;
    for (i < catalog_arch.count()) {
        val id:   u32             = catalog_arch.id_for(catalog_arch.name_at(i));
        val arch: *mink_arch.Arch = catalog_arch.owner_of(id);
        if (spells(arch)) {
            val read: res[masc_extension.Selection, fail.Fail] = entered(a, arch, spelling);
            if (sel read.ok) {
                var s: masc_extension.Selection = read.ok;
                masc_extension.release(?s);
                ret id;
            }
        }
        i = i + 1;
    }
    ret catalog_arch.UNKNOWN;
}

# the selection masc's catalog for mink's architecture `arch` reads from `spelling`,
# closed over its implications, refused when the catalog does not read it and when
# the architecture does not enter it, as `rv64gc` on riscv32 or an e base on an i
# architecture; released with masc_extension.release
fun entered(a: *A.Allocator, arch: *mink_arch.Arch, spelling: str) res[masc_extension.Selection, fail.Fail] {
    val set: *masc_set.Set = set_of(arch);
    if (!spells(arch)) {
        ret res[masc_extension.Selection, fail.Fail].err{fail.message("its extension catalog spells no selection")};
    }
    val row: opt[*masc_set.Arch] = masc_set.arch_of(set, arch);
    if (sel row.none) {
        ret res[masc_extension.Selection, fail.Fail].err{fail.message("masc's instruction set has no row for the architecture")};
    }
    var chosen: res[masc_extension.Selection, masc_extension.Error] = masc_extension.select(a, set.extensions, spelling, masc_diagnostic.START);
    if (sel chosen.err) {
        ret res[masc_extension.Selection, fail.Fail].err{fail.formatted(a, "masc's catalog refuses it: {}", refusal_text(chosen.err))};
    }
    var s:   masc_extension.Selection                  = chosen.ok;
    val ctx: res[masc_state.Context, masc_state.Error] = masc_state.make(?s, ?set.states, row.some.initial);
    if (sel ctx.err) {
        masc_extension.release(?s);
        ret res[masc_extension.Selection, fail.Fail].err{fail.message("it states an execution state the architecture does not run under")};
    }
    var held: masc_state.Context = ctx.ok;
    if (!masc_state.admits(?held, row.some.enters)) {
        masc_extension.release(?s);
        ret res[masc_extension.Selection, fail.Fail].err{fail.formatted(a, "it is not a selection {} enters", arch.name)};
    }
    ret res[masc_extension.Selection, fail.Fail].ok{s};
}

# the text of masc's refusal of a selection
fun refusal_text(e: masc_extension.Error) str {
    if (sel e.refused)  { ret e.refused.message; }
    if (sel e.conflict) { ret "it holds two extensions that conflict"; }
    ret "out of memory";
}

# the bits of `t` a selection holds: each row the code generator emits against
fun bits_of(t: *extension.Table, s: *masc_extension.Selection) u64 {
    var bits: u64 = 0;
    var i:    u32 = 0;
    for (i < t.count) {
        if (masc_extension.has(s, t.rows[i].handle)) { bits = bits | t.rows[i].bit; }
        i = i + 1;
    }
    ret bits;
}

# the bits of the extension table `t` that the selection `spelling` holds, read by
# masc's catalog for mink's architecture `arch` and closed over its implications
pub fun select(a: *A.Allocator, arch: *mink_arch.Arch, t: *extension.Table, spelling: str) res[u64, fail.Fail] {
    val read: res[masc_extension.Selection, fail.Fail] = entered(a, arch, spelling);
    if (sel read.err) { ret res[u64, fail.Fail].err{read.err}; }
    var s: masc_extension.Selection = read.ok;
    fin { masc_extension.release(?s); }
    ret res[u64, fail.Fail].ok{bits_of(t, ?s)};
}

# the selection holding each row of `t` in `bits` and the state mink's architecture
# `arch` enters, unclosed, so it spells exactly the rows the code generator emits
# against; released with masc_extension.release
fun selection_of(a: *A.Allocator, arch: *mink_arch.Arch, t: *extension.Table, bits: u64) res[masc_extension.Selection, fail.Fail] {
    val set: *masc_set.Set = set_of(arch);
    if (!spells(arch) || t == nil || t.catalog != set.extensions) {
        ret res[masc_extension.Selection, fail.Fail].err{fail.message("baseline: the instruction set spells no selection")};
    }
    val made: res[bitset.Bitset, A.Error] = bitset.init(a, t.catalog.count::usize);
    if (sel made.err) { ret res[masc_extension.Selection, fail.Fail].err{fail.refused(made.err)}; }
    var s: masc_extension.Selection = masc_extension.Selection{catalog: t.catalog, members: made.ok};
    s.stated.len = 0;
    var i: u32 = 0;
    for (i < t.count) {
        if ((bits & t.rows[i].bit) != 0) { bitset.set(?s.members, t.rows[i].handle::usize); }
        i = i + 1;
    }
    val row: opt[*masc_set.Arch] = masc_set.arch_of(set, arch);
    if (sel row.some) {
        if (row.some.enters.len > 0) {
            val enters: requirement.Ids = row.some.enters.at[0].all;
            var k:      u32             = 0;
            for (k < enters.len && k < masc_extension.MAX_STATED) {
                s.stated.at[k] = enters.at[k];
                s.stated.len   = k + 1;
                k              = k + 1;
            }
        }
    }
    ret res[masc_extension.Selection, fail.Fail].ok{s};
}

# the spelling masc gives the rows of `t` in `bits` on mink's architecture `arch`,
# with each member's revision when `versioned`, as an object's attributes state the
# selection it was built for; owned by `a`
pub fun spell(a: *A.Allocator, arch: *mink_arch.Arch, t: *extension.Table, bits: u64, versioned: bool) res[str, fail.Fail] {
    val made: res[masc_extension.Selection, fail.Fail] = selection_of(a, arch, t, bits);
    if (sel made.err) { ret res[str, fail.Fail].err{made.err}; }
    var s: masc_extension.Selection = made.ok;
    fin { masc_extension.release(?s); }
    var out: Vector[u8] = collections_vector.init[u8](a);
    var r:   err[A.Error];
    if (versioned) { r = masc_extension.spell_versioned(?s, ?out); }
    or             { r = masc_extension.spell(?s, ?out); }
    if (sel r.err) {
        collections_vector.dnit[u8](?out);
        ret res[str, fail.Fail].err{fail.refused(r.err)};
    }
    val copied: res[str, A.Error] = str_dup_range(a, out.data::str, 0, out.len);
    collections_vector.dnit[u8](?out);
    if (sel copied.err) { ret res[str, fail.Fail].err{fail.refused(copied.err)}; }
    ret res[str, fail.Fail].ok{copied.ok};
}

# masc reads riscv's isa strings for the architecture that enters them, spells the
# selection mach emits against so it reads back, and spells nothing for x86
test select__reads_masc_s_spelling_for_the_entering_architecture {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    val rv64: *mink_arch.Arch     = catalog_arch.owner_of(catalog_arch.RISCV64);
    val rv32: *mink_arch.Arch     = catalog_arch.owner_of(catalog_arch.RISCV32);
    val wide: res[u64, fail.Fail] = select(?a, rv64, ?extension_riscv.TABLE, "rv64gc");
    if (sel wide.err) { ret 2; }
    or (sel wide.ok) {
        if (wide.ok != extension_riscv.DEFAULT64) { ret 3; }
    }
    val cross: res[u64, fail.Fail] = select(?a, rv32, ?extension_riscv.TABLE, "rv64gc");
    if (sel cross.ok) { ret 4; }
    val small: res[u64, fail.Fail] = select(?a, rv32, ?extension_riscv.TABLE, "rv32imc");
    if (sel small.err)                                                                                             { ret 5; }
    if (entered_by(?a, "rv32imc") != catalog_arch.RISCV32 || entered_by(?a, "rv64gc_zfh") != catalog_arch.RISCV64) { ret 6; }
    if (entered_by(?a, "x86_64") != catalog_arch.UNKNOWN || entered_by(?a, "rv32e") != catalog_arch.UNKNOWN)       { ret 7; }
    if (spells(catalog_arch.owner_of(catalog_arch.X86_64)) || !spells(rv32))                                       { ret 8; }
    val spelled: res[str, fail.Fail] = spell(?a, rv64, ?extension_riscv.TABLE, extension_riscv.DEFAULT64 | extension_riscv.ZKT, false);
    if (sel spelled.err) { ret 9; }
    val back: res[u64, fail.Fail] = select(?a, rv64, ?extension_riscv.TABLE, spelled.ok);
    if (sel back.err) { ret 10; }
    or (sel back.ok) {
        if (back.ok != (extension_riscv.DEFAULT64 | extension_riscv.ZKT)) { ret 11; }
    }
    ret 0;
}

# every instruction set whose default baseline is named has a catalog that spells it,
# and its architecture enters it. aarch64's catalog spells, but its default waits on
# mach's vocabulary for it (#4779)
test default_baseline__named_exactly_where_masc_spells_a_selection {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var i: usize = 0;
    for (i < catalog_arch.count()) {
        val id:      u32 = catalog_arch.id_for(catalog_arch.name_at(i));
        val default: str = catalog_arch.default_baseline(id);
        if (default != nil && !spells(catalog_arch.owner_of(id))) { ret 2; }
        if (default != nil && entered_by(?a, default) != id)      { ret 3; }
        i = i + 1;
    }
    ret 0;
}
