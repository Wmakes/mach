use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.encoding.leb128;
use std_format: std.format;
use std.text.string.str_free;
use std.types.char.char_is_digit;

use target_baseline: mach.lang.target.baseline;
use catalog_arch:    mach.lang.target.catalog.arch;
use extension_riscv: mach.lang.target.extension.riscv;

use A: std.allocator;

use lang_checked: mach.lang.checked;
use target_of:    mach.lang.target.of;

# the e_flags bits riscv defines: compressed instructions, the float abi, and
# the RV32E/RV64E calling convention
pub val EF_RVC:              u32 = 0x1;
pub val EF_FLOAT_ABI_SOFT:   u32 = 0x0;
pub val EF_FLOAT_ABI_SINGLE: u32 = 0x2;
pub val EF_FLOAT_ABI_DOUBLE: u32 = 0x4;
pub val EF_RVE:              u32 = 0x8;

# the type of the `.riscv.attributes` section
pub val SHT_ATTRIBUTES: u32 = 0x70000003;

# the e_flags word of an object whose abi passes floats in `float_arg_bits`-wide
# registers
pub fun flags(float_arg_bits: u32, has_compressed: bool) u32 {
    var word: u32 = EF_FLOAT_ABI_SOFT;
    if (float_arg_bits == 32) { word = EF_FLOAT_ABI_SINGLE; }
    if (float_arg_bits == 64) { word = EF_FLOAT_ABI_DOUBLE; }
    if (has_compressed)       { word = word | EF_RVC; }
    ret word;
}

# the e_flags bits that name the float abi, which every linked object shares
pub val FLAGS_ABI: u32 = EF_FLOAT_ABI_SINGLE | EF_FLOAT_ABI_DOUBLE;

# the float abi the bits `abi_bits` of an e_flags word name, for a refusal
pub fun flags_abi_name(abi_bits: u32) str {
    if (abi_bits == EF_FLOAT_ABI_SOFT)   { ret "soft-float"; }
    if (abi_bits == EF_FLOAT_ABI_SINGLE) { ret "single-precision hard-float"; }
    if (abi_bits == EF_FLOAT_ABI_DOUBLE) { ret "double-precision hard-float"; }
    ret "an unrecognized float";
}

# the e_flags word of an object built for `target`, which holds no compressed instructions
pub fun target_flags(target: *target_of.ObjectTarget) u32 {
    ret flags(target.float_arg_bits, false);
}

# the attribute section of an object built for `target`
pub fun target_attributes(alloc: *A.Allocator, target: *target_of.ObjectTarget, out_len: *u32) res[*u8, fail.Fail] {
    ret attributes_build(alloc, target.pointer_width * 8, target.extensions, target.float_arg_bits, false, out_len);
}

# an input's attribute section and e_flags against what `target` can link
pub fun target_attributes_validate(bytes: *u8, len: u32, target: *target_of.ObjectTarget, flags: u32) err[fail.Fail] {
    ret attributes_validate(bytes, len, target.pointer_width * 8, flags);
}

val TAG_STACK_ALIGN:        u32 = 4;
val TAG_ARCH:               u32 = 5;
val TAG_UNALIGNED_ACCESS:   u32 = 6;
val TAG_PRIV_SPEC:          u32 = 8;
val TAG_PRIV_SPEC_MINOR:    u32 = 10;
val TAG_PRIV_SPEC_REVISION: u32 = 12;

val STACK_ALIGN: u32 = 16;

val MAX_EXTS:          u32 = 64;
val MAX_NAME:          u32 = 24;
val MAX_UNKNOWN:       u32 = 16;
val MAX_UNKNOWN_VALUE: u32 = 64;

pub rec Ext {
    name:     [24]u8;
    name_len: u32;
    major:    u32;
    minor:    u32;
}

pub rec Arch {
    xlen:  u32;
    exts:  [64]Ext;
    count: u32;
}

rec Unknown {
    tag:       u32;
    is_str:    bool;
    value:     [64]u8;
    value_len: u32;
}

pub rec Attrs {
    arch:            Arch;
    has_arch:        bool;
    stack_align:     u32;
    has_stack_align: bool;
    unaligned:       u32;
    has_unaligned:   bool;
    priv:            [3]u32;
    has_priv:        [3]bool;
    unknown:         [16]Unknown;
    unknown_count:   u32;
}

val SINGLE_ORDER: str = "mafdqlcbkjtpvn";

fun attrs_blank(at: *Attrs) {
    at.arch.xlen       = 0;
    at.arch.count      = 0;
    at.has_arch        = false;
    at.stack_align     = 0;
    at.has_stack_align = false;
    at.unaligned       = 0;
    at.has_unaligned   = false;
    var i: u32 = 0;
    for (i < 3) {
        at.priv[i]     = 0;
        at.has_priv[i] = false;
        i              = i + 1;
    }
    at.unknown_count = 0;
}

fun is_lower(c: u8) bool {
    ret c >= 97 && c <= 122;
}

fun single_rank(c: u8) i64 {
    val n: i64 = str_len(SINGLE_ORDER)::i64;
    var i: i64 = 0;
    for (i < n) {
        if (SINGLE_ORDER[i::usize]::u8 == c) { ret i; }
        i = i + 1;
    }
    ret -1;
}

fun name_cmp(a: *Ext, b: *Ext) i64 {
    var i: u32 = 0;
    for (i < a.name_len && i < b.name_len) {
        if (a.name[i] != b.name[i]) { ret (a.name[i]::i64) - (b.name[i]::i64); }
        i = i + 1;
    }
    ret (a.name_len::i64) - (b.name_len::i64);
}

fun same_ext(a: *Ext, b: *Ext) bool {
    ret name_cmp(a, b) == 0;
}

# a uleb128 value at @pos that fits u32, advancing @pos past it; none when the
# bytes there are not one
fun read_uleb(buf: *u8, len: u32, pos: *u32) opt[u32] {
    if (@pos >= len) { ret opt[u32].none{}; }
    val got: res[leb128.Unsigned, leb128.Error] = leb128.get_unsigned(?buf[@pos], (len - @pos)::usize);
    if (sel got.err)               { ret opt[u32].none{}; }
    if (got.ok.value > 0xFFFFFFFF) { ret opt[u32].none{}; }
    @pos = @pos + got.ok.size::u32;
    ret opt[u32].some{got.ok.value::u32};
}

# a decimal number at @p that fits u32, advancing @p past it; none when the
# text there is not one
fun read_number(s: *u8, len: u32, p: *u32) opt[u32] {
    val start: u32   = @p;
    var acc:   usize = 0;
    for (@p < len && char_is_digit(s[@p])) {
        val scaled: res[usize, lang_checked.Cause] = lang_checked.usize_mul(acc, 10);
        if (sel scaled.err) { ret opt[u32].none{}; }
        val summed: res[usize, lang_checked.Cause] = lang_checked.usize_add(
            scaled.ok, (s[@p] - 48)::usize);
        if (sel summed.err) { ret opt[u32].none{}; }
        acc = summed.ok;
        @p  = @p + 1;
    }
    if (@p == start) { ret opt[u32].none{}; }
    val narrowed: res[u32, lang_checked.Cause] = lang_checked.usize_to_u32(acc);
    if (sel narrowed.err) { ret opt[u32].none{}; }
    ret opt[u32].some{narrowed.ok};
}

# a multi-letter extension runs to the next `_` and may carry digits in its name, as
# `zve64d` and `zvl128b` do, so its version is the trailing `<major>[p<minor>]`
fun parse_multi(s: *u8, len: u32, p: *u32, e: *Ext) bool {
    val start: u32 = @p;
    var end:   u32 = start;
    for (end < len && s[end] != 95) {
        if (!is_lower(s[end]) && !char_is_digit(s[end])) { ret false; }
        end = end + 1;
    }
    @p = end;

    var cut: u32 = end;
    for (cut > start && char_is_digit(s[cut - 1])) { cut = cut - 1; }
    if (cut < end && cut > start + 1 && s[cut - 1] == 112 && char_is_digit(s[cut - 2])) {
        var major_at: u32 = cut - 1;
        for (major_at > start && char_is_digit(s[major_at - 1])) { major_at = major_at - 1; }
        var q:      u32      = major_at;
        val read_1: opt[u32] = read_number(s, cut - 1, ?q);
        if (sel read_1.none) { ret false; }
        e.major = read_1.some;
        q       = cut;
        val read_2: opt[u32] = read_number(s, end, ?q);
        if (sel read_2.none) { ret false; }
        e.minor = read_2.some;
        cut     = major_at;
    }
    or (cut < end) {
        var q:      u32      = cut;
        val read_3: opt[u32] = read_number(s, end, ?q);
        if (sel read_3.none) { ret false; }
        e.major = read_3.some;
    }

    if (cut - start < 2 || cut - start > MAX_NAME) { ret false; }
    var i: u32 = 0;
    for (i < cut - start) {
        e.name[i] = s[start + i];
        i         = i + 1;
    }
    e.name_len = cut - start;
    ret true;
}

pub fun parse_arch(s: *u8, len: u32, out: *Arch) bool {
    out.xlen  = 0;
    out.count = 0;
    if (len < 5)                    { ret false; }
    if (s[0] != 114 || s[1] != 118) { ret false; }
    var p:      u32      = 2;
    var xlen:   u32      = 0;
    val read_4: opt[u32] = read_number(s, len, ?p);
    if (sel read_4.none) { ret false; }
    xlen = read_4.some;
    if (xlen != 32 && xlen != 64) { ret false; }
    out.xlen = xlen;

    for (p < len) {
        if (s[p] == 95) {
            p = p + 1;
            cnt;
        }
        if (!is_lower(s[p])) { ret false; }

        var e: Ext;
        e.name_len = 0;
        e.major    = 0;
        e.minor    = 0;

        if (s[p] == 122 || s[p] == 115 || s[p] == 120) {
            if (!parse_multi(s, len, ?p, ?e)) { ret false; }
        }
        or {
            e.name[0]  = s[p];
            e.name_len = 1;
            p          = p + 1;
        }

        if (e.name_len == 1 && p < len && char_is_digit(s[p])) {
            val read_5: opt[u32] = read_number(s, len, ?p);
            if (sel read_5.none) { ret false; }
            e.major = read_5.some;
            if (p < len && s[p] == 112) {
                p = p + 1;
                if (p >= len || !char_is_digit(s[p])) { ret false; }
                val read_6: opt[u32] = read_number(s, len, ?p);
                if (sel read_6.none) { ret false; }
                e.minor = read_6.some;
            }
        }

        if (out.count >= MAX_EXTS) { ret false; }
        var i: u32 = 0;
        for (i < out.count) {
            if (same_ext(?out.exts[i], ?e)) { ret false; }
            i = i + 1;
        }
        out.exts[out.count] = e;
        out.count           = out.count + 1;
    }
    ret out.count > 0;
}

fun merge_arch(a: *Arch, b: *Arch) err[fail.Fail] {
    if (a.xlen == 0) {
        @a = @b;
        ret err[fail.Fail].ok{};
    }
    if (b.xlen == 0) { ret err[fail.Fail].ok{}; }
    if (a.xlen != b.xlen) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_ABI_MISMATCH, "declares a register width in Tag_RISCV_arch that the inputs before it do not (rv32 with rv64)")};
    }
    var i: u32 = 0;
    for (i < b.count) {
        var found: bool = false;
        var j:     u32  = 0;
        for (j < a.count) {
            if (same_ext(?a.exts[j], ?b.exts[i])) {
                found = true;
                if (b.exts[i].major > a.exts[j].major
                    || (b.exts[i].major == a.exts[j].major
                    && b.exts[i].minor > a.exts[j].minor)) {
                    a.exts[j].major = b.exts[i].major;
                    a.exts[j].minor = b.exts[i].minor;
                }
                brk;
            }
            j = j + 1;
        }
        if (!found) {
            if (a.count >= MAX_EXTS) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_INPUT_INVALID, "declares more RISC-V extensions than the attribute merge can hold")};
            }
            a.exts[a.count] = b.exts[i];
            a.count         = a.count + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun merge_unknown(at: *Attrs, u: *Unknown) err[fail.Fail] {
    var i: u32 = 0;
    for (i < at.unknown_count) {
        if (at.unknown[i].tag == u.tag) {
            var same: bool = at.unknown[i].value_len == u.value_len;
            var k:    u32  = 0;
            for (same && k < u.value_len) {
                if (at.unknown[i].value[k] != u.value[k]) { same = false; }
                k = k + 1;
            }
            if (same) { ret err[fail.Fail].ok{}; }
            at.unknown[i]    = at.unknown[at.unknown_count - 1];
            at.unknown_count = at.unknown_count - 1;
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }
    if (at.unknown_count >= MAX_UNKNOWN) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_INPUT_INVALID, "carries more unrecognized .riscv.attributes tags than the linker merges")};
    }
    at.unknown[at.unknown_count] = @u;
    at.unknown_count             = at.unknown_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun parse_body(body: *u8, len: u32, out: *Attrs) err[fail.Fail] {
    attrs_blank(out);
    if (body == nil || len == 0) { ret err[fail.Fail].ok{}; }
    var p: u32 = 0;
    for (p < len) {
        val tag_o: opt[u32] = read_uleb(body, len, ?p);
        if (sel tag_o.none) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_INPUT_INVALID, "has a truncated .riscv.attributes tag")};
        }
        val tag:    u32  = tag_o.some;
        val is_str: bool = (tag & 1) == 1;
        if (is_str) {
            val start: u32 = p;
            for (p < len && body[p] != 0) { p = p + 1; }
            if (p >= len) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_INPUT_INVALID, "has an unterminated .riscv.attributes string")};
            }
            val slen: u32 = p - start;
            p = p + 1;
            if (tag == TAG_ARCH) {
                if (out.has_arch) { ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_INPUT_INVALID, "declares Tag_RISCV_arch twice")}; }
                if (!parse_arch(?body[start], slen, ?out.arch)) {
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_INPUT_INVALID, "declares a Tag_RISCV_arch that is not a readable ISA string")};
                }
                out.has_arch = true;
            }
            or {
                if (slen > MAX_UNKNOWN_VALUE) {
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_INPUT_INVALID, "carries an unrecognized .riscv.attributes string longer than the linker merges")};
                }
                var u: Unknown;
                u.tag       = tag;
                u.is_str    = true;
                u.value_len = slen;
                var k: u32 = 0;
                for (k < slen) {
                    u.value[k] = body[start + k];
                    k          = k + 1;
                }
                val mr: err[fail.Fail] = merge_unknown(out, ?u);
                if (sel mr.err) { ret mr; }
            }
            cnt;
        }

        val v_o: opt[u32] = read_uleb(body, len, ?p);
        if (sel v_o.none) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_INPUT_INVALID, "has a truncated .riscv.attributes value")};
        }
        val v: u32 = v_o.some;
        if (tag == TAG_STACK_ALIGN) {
            out.stack_align     = v;
            out.has_stack_align = true;
            cnt;
        }
        if (tag == TAG_UNALIGNED_ACCESS) {
            out.unaligned     = v;
            out.has_unaligned = true;
            cnt;
        }
        if (tag == TAG_PRIV_SPEC) {
            out.priv[0]     = v;
            out.has_priv[0] = true;
            cnt;
        }
        if (tag == TAG_PRIV_SPEC_MINOR) {
            out.priv[1]     = v;
            out.has_priv[1] = true;
            cnt;
        }
        if (tag == TAG_PRIV_SPEC_REVISION) {
            out.priv[2]     = v;
            out.has_priv[2] = true;
            cnt;
        }

        var u2: Unknown;
        u2.tag       = tag;
        u2.is_str    = false;
        u2.value_len = leb128.unsigned_size(v::u64)::u32;
        leb128.put_unsigned(?u2.value[0], v::u64);
        val mr2: err[fail.Fail] = merge_unknown(out, ?u2);
        if (sel mr2.err) { ret mr2; }
    }
    ret err[fail.Fail].ok{};
}

fun merge_attrs(a: *Attrs, b: *Attrs) err[fail.Fail] {
    if (b.has_arch) {
        val ar: err[fail.Fail] = merge_arch(?a.arch, ?b.arch);
        if (sel ar.err) { ret ar; }
        a.has_arch = true;
    }

    if (b.has_stack_align) {
        if (a.has_stack_align && a.stack_align != b.stack_align) {
            ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_ABI_MISMATCH, "declares a Tag_RISCV_stack_align the inputs before it do not")};
        }
        a.stack_align     = b.stack_align;
        a.has_stack_align = true;
    }

    if (b.has_unaligned) {
        if (!a.has_unaligned || b.unaligned > a.unaligned) { a.unaligned = b.unaligned; }
        a.has_unaligned = true;
    }

    var i: u32 = 0;
    for (i < 3) {
        if (b.has_priv[i]) {
            if (a.has_priv[i] && a.priv[i] != b.priv[i]) {
                a.has_priv[i] = false;
                a.priv[i]     = 0;
            }
            or {
                a.priv[i]     = b.priv[i];
                a.has_priv[i] = true;
            }
        }
        i = i + 1;
    }

    var k: u32 = 0;
    for (k < b.unknown_count) {
        val ur: err[fail.Fail] = merge_unknown(a, ?b.unknown[k]);
        if (sel ur.err) { ret ur; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun arch_string_size(a: *Arch) u32 {
    var n: u32 = 2 + decimal_size(a.xlen);
    var i: u32 = 0;
    for (i < a.count) {
        if (i > 0) { n = n + 1; }
        n = n + a.exts[i].name_len;
        n = n + decimal_size(a.exts[i].major) + 1 + decimal_size(a.exts[i].minor);
        i = i + 1;
    }
    ret n;
}

fun decimal_size(v: u32) u32 {
    var digits: [std_format.DECIMAL_MAX]u8;
    ret std_format.put_u64(?digits[0], v::u64)::u32;
}

fun write_decimal(buf: *u8, pos: u32, v: u32) u32 {
    ret std_format.put_u64(?buf[pos], v::u64)::u32;
}

fun sort_exts(a: *Arch) {
    var i: u32 = 1;
    for (i < a.count) {
        var j: u32 = i;
        for (j > 0 && ext_before(?a.exts[j], ?a.exts[j - 1])) {
            var tmp: Ext = a.exts[j];
            a.exts[j]     = a.exts[j - 1];
            a.exts[j - 1] = tmp;
            j             = j - 1;
        }
        i = i + 1;
    }
}

fun ext_before(x: *Ext, y: *Ext) bool {
    val xk: u32 = ext_class(x);
    val yk: u32 = ext_class(y);
    if (xk != yk) { ret xk < yk; }
    if (xk == 1)  { ret single_rank(x.name[0]) < single_rank(y.name[0]); }
    ret name_cmp(x, y) < 0;
}

fun ext_class(e: *Ext) u32 {
    if (e.name_len == 1 && (e.name[0] == 105 || e.name[0] == 101)) { ret 0; }
    if (e.name_len == 1)                                           { ret 1; }
    ret 2;
}

pub fun serialize(alloc: *A.Allocator, at: *Attrs, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    sort_exts(?at.arch);

    var n: u32 = 0;
    if (at.has_stack_align) { n = n + leb128.unsigned_size(TAG_STACK_ALIGN::u64)::u32 + leb128.unsigned_size(at.stack_align::u64)::u32; }
    if (at.has_arch)        { n = n + leb128.unsigned_size(TAG_ARCH::u64)::u32 + arch_string_size(?at.arch) + 1; }
    if (at.has_unaligned)   { n = n + leb128.unsigned_size(TAG_UNALIGNED_ACCESS::u64)::u32 + leb128.unsigned_size(at.unaligned::u64)::u32; }
    var i: u32 = 0;
    for (i < 3) {
        if (at.has_priv[i]) { n = n + leb128.unsigned_size(priv_tag(i)::u64)::u32 + leb128.unsigned_size(at.priv[i]::u64)::u32; }
        i = i + 1;
    }
    var k: u32 = 0;
    for (k < at.unknown_count) {
        n = n + leb128.unsigned_size(at.unknown[k].tag::u64)::u32 + at.unknown[k].value_len;
        if (at.unknown[k].is_str) { n = n + 1; }
        k = k + 1;
    }
    if (n == 0) { ret res[*u8, fail.Fail].ok{nil}; }

    val br: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel br.err) { ret res[*u8, fail.Fail].err{fail.refused(br.err)}; }
    val buf: *u8 = br.ok;

    var p: u32 = 0;
    if (at.has_stack_align) {
        p = p + leb128.put_unsigned(?buf[p], TAG_STACK_ALIGN::u64)::u32;
        p = p + leb128.put_unsigned(?buf[p], at.stack_align::u64)::u32;
    }
    if (at.has_arch) {
        p      = p + leb128.put_unsigned(?buf[p], TAG_ARCH::u64)::u32;
        p      = p + write_arch_string(buf, p, ?at.arch);
        buf[p] = 0;
        p      = p + 1;
    }
    if (at.has_unaligned) {
        p = p + leb128.put_unsigned(?buf[p], TAG_UNALIGNED_ACCESS::u64)::u32;
        p = p + leb128.put_unsigned(?buf[p], at.unaligned::u64)::u32;
    }
    i = 0;
    for (i < 3) {
        if (at.has_priv[i]) {
            p = p + leb128.put_unsigned(?buf[p], priv_tag(i)::u64)::u32;
            p = p + leb128.put_unsigned(?buf[p], at.priv[i]::u64)::u32;
        }
        i = i + 1;
    }
    k = 0;
    for (k < at.unknown_count) {
        p = p + leb128.put_unsigned(?buf[p], at.unknown[k].tag::u64)::u32;
        var b: u32 = 0;
        for (b < at.unknown[k].value_len) {
            buf[p + b] = at.unknown[k].value[b];
            b          = b + 1;
        }
        p = p + at.unknown[k].value_len;
        if (at.unknown[k].is_str) {
            buf[p] = 0;
            p      = p + 1;
        }
        k = k + 1;
    }

    @out_len = n;
    ret res[*u8, fail.Fail].ok{buf};
}

fun priv_tag(i: u32) u32 {
    if (i == 0) { ret TAG_PRIV_SPEC; }
    if (i == 1) { ret TAG_PRIV_SPEC_MINOR; }
    ret TAG_PRIV_SPEC_REVISION;
}

fun write_arch_string(buf: *u8, pos: u32, a: *Arch) u32 {
    var p: u32 = pos;
    buf[p]     = 114;
    buf[p + 1] = 118;
    p          = p + 2;
    p          = p + write_decimal(buf, p, a.xlen);
    var i: u32 = 0;
    for (i < a.count) {
        if (i > 0) {
            buf[p] = 95;
            p      = p + 1;
        }
        var k: u32 = 0;
        for (k < a.exts[i].name_len) {
            buf[p + k] = a.exts[i].name[k];
            k          = k + 1;
        }
        p      = p + a.exts[i].name_len;
        p      = p + write_decimal(buf, p, a.exts[i].major);
        buf[p] = 112;
        p      = p + 1;
        p      = p + write_decimal(buf, p, a.exts[i].minor);
        i      = i + 1;
    }
    ret p - pos;
}

pub fun attributes_build(alloc: *A.Allocator, xlen_bits: u32, extension_bits: u64, float_arg_bits: u32,
    has_compressed: bool, out_len: *u32) res[*u8, fail.Fail] {
    @out_len = 0;
    if ((xlen_bits != 32 && xlen_bits != 64) || !extension_riscv.has(extension_bits, extension_riscv.I)) {
        ret res[*u8, fail.Fail].err{fail.message("riscv attributes: invalid selected ISA capabilities")};
    }
    if ((float_arg_bits != 0 && float_arg_bits != 32 && float_arg_bits != 64)
        || (float_arg_bits == 32 && !extension_riscv.has(extension_bits, extension_riscv.F))
        || (float_arg_bits == 64 && !extension_riscv.has(extension_bits, extension_riscv.D))) {
        ret res[*u8, fail.Fail].err{fail.message("riscv attributes: float ABI requires an unavailable F or D extension")};
    }
    if (has_compressed && !extension_riscv.has(extension_bits, extension_riscv.C)) {
        ret res[*u8, fail.Fail].err{fail.message("riscv attributes: compressed instructions require the C extension")};
    }
    var at: Attrs;
    attrs_blank(?at);
    var arch: u32 = catalog_arch.RISCV64;
    if (xlen_bits == 32) { arch = catalog_arch.RISCV32; }
    val spelled: res[str, fail.Fail] = target_baseline.spell(alloc, catalog_arch.owner_of(arch), ?extension_riscv.TABLE, extension_bits, true);
    if (sel spelled.err) { ret res[*u8, fail.Fail].err{spelled.err}; }
    val parsed: bool = parse_arch(spelled.ok::*u8, str_len(spelled.ok)::u32, ?at.arch);
    str_free(alloc, spelled.ok);
    if (!parsed) { ret res[*u8, fail.Fail].err{fail.message("riscv attributes: masc's versioned spelling of the selection does not read as a Tag_RISCV_arch")}; }
    at.has_arch = true;

    at.stack_align     = STACK_ALIGN;
    at.has_stack_align = true;

    at.unaligned     = 0;
    at.has_unaligned = true;

    ret serialize(alloc, ?at, out_len);
}

# refuses only what cannot link into the target: an attribute section that does not parse,
# a Tag_RISCV_arch of another XLEN, or the RV32E/RV64E calling convention, which no target
# uses. the extensions an object names are merged into the output and never refused, since
# whether mach generates code for one says nothing about linking an object that uses it.
# the float ABI in the flags is checked where every input's flags are merged
pub fun attributes_validate(bytes: *u8, len: u32, xlen_bits: u32, flags: u32) err[fail.Fail] {
    if ((flags & EF_RVE) != 0) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_ABI_MISMATCH, "was built for the RV32E/RV64E calling convention, which the target does not use")};
    }
    if (len == 0)     { ret err[fail.Fail].ok{}; }
    if (bytes == nil) { ret err[fail.Fail].err{fail.message("missing RISC-V attribute bytes")}; }
    var at:     Attrs;
    val parsed: err[fail.Fail] = parse_body(bytes, len, ?at);
    if (sel parsed.err) { ret parsed; }
    if (!at.has_arch)   { ret err[fail.Fail].ok{}; }
    if (at.arch.xlen != xlen_bits) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_ABI_MISMATCH, "declares a Tag_RISCV_arch whose XLEN differs from the target's")};
    }
    ret err[fail.Fail].ok{};
}

pub fun attributes_merge(alloc: *A.Allocator, a: *u8, a_len: u32,
    b: *u8, b_len: u32, out_len: *u32) res[*u8, fail.Fail] {
    var acc: Attrs;
    val pa:  err[fail.Fail] = parse_body(a, a_len, ?acc);
    if (sel pa.err) { ret res[*u8, fail.Fail].err{pa.err}; }

    var other: Attrs;
    val pb:    err[fail.Fail] = parse_body(b, b_len, ?other);
    if (sel pb.err) { ret res[*u8, fail.Fail].err{pb.err}; }

    val mr: err[fail.Fail] = merge_attrs(?acc, ?other);
    if (sel mr.err) { ret res[*u8, fail.Fail].err{mr.err}; }

    ret serialize(alloc, ?acc, out_len);
}
