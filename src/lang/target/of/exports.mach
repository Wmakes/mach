# the export-request list of a relocatable object: the names a module asks the
# link to export whoever defines them, one per `fwd` re-export. no format shared
# by elf and mach-o has a native per-object export directive, so both carry the
# list in a mach-specific section the emitter writes and the parser consumes:
# `u32 version`, `u32 count`, then per name `u32 len`, the bytes, padded to 4.
# coff spells the same request natively as a `.drectve /EXPORT:` of a name the
# object does not define, so it does not carry this section.

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.intern;
use target_of: mach.lang.target.of;
use mach.lang.target.of.bin;
use of_plan: mach.lang.target.of.plan;
use mach.lang.wire;
use std.memory;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

pub val SECTION_NAME: str = ".mach.exports";
pub val VERSION:      u32 = 1;

val PAD: [4]u8 = [4]u8{0, 0, 0, 0};

fun put_requests(w: *wire.Sink, img: *target_of.ObjectImage) {
    wire.put_u32(w, VERSION);
    wire.put_u32(w, img.export_request_count);
    var i: u32 = 0;
    for (i < img.export_request_count) {
        val nm:   str   = bin.resolve_name(img.interner, img.export_requests[i]);
        val nlen: usize = str_len(nm);
        wire.put_sized(w, nm::*u8, nlen);
        wire.put_bytes(w, ?PAD[0], of_plan.align_bounded(nlen, 4) - nlen);
        i = i + 1;
    }
}

# the section blob for an image's request list, or a nil blob when the list is
# empty. the caller owns the bytes
pub fun encode(alloc: *A.Allocator, img: *target_of.ObjectImage, out_bytes: **u8, out_len: *u32) err[fail.Fail] {
    @out_bytes = nil;
    @out_len   = 0;
    if (img.export_request_count == 0) { ret err[fail.Fail].ok{}; }

    var i: u32 = 0;
    for (i < img.export_request_count) {
        val nm: str = bin.resolve_name(img.interner, img.export_requests[i]);
        if (nm == nil || str_len(nm) == 0) {
            ret err[fail.Fail].err{fail.message("export request name did not resolve")};
        }
        i = i + 1;
    }
    var measure: wire.Sink = wire.measure();
    put_requests(?measure, img);
    if (measure.len > 0xFFFFFFFF) { ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "export request section exceeds the section size field")}; }

    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, measure.len);
    if (sel rb.err) { ret err[fail.Fail].err{fail.message("export request section alloc failed")}; }
    var w: wire.Sink = wire.fixed(rb.ok, measure.len);
    put_requests(?w, img);
    @out_bytes = rb.ok;
    @out_len   = measure.len::u32;
    ret err[fail.Fail].ok{};
}

# reads the request list out of section `index` into the image and consumes
# the section, leaving a zero-length husk the linker skips. a husk written
# back out reads as no requests. the image must hold no requests yet: a parse
# fills the list exactly once
pub fun decode(alloc: *A.Allocator, itn: *intern.Interner, img: *target_of.ObjectImage, index: u32) err[fail.Fail] {
    if (img.export_request_count != 0) {
        ret err[fail.Fail].err{fail.message("export requests decoded twice into one image")};
    }
    val sec: *target_of.Section = ?img.sections[index];
    if (sec.len == 0) { ret err[fail.Fail].ok{}; }
    val blob: *u8   = sec.bytes;
    val blen: usize = sec.len::usize;
    if (blob == nil || blen < 8) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "malformed .mach.exports section")}; }
    var r: wire.Source = wire.source(blob, blen);
    if (wire.take_u32(?r) != VERSION) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_UNSUPPORTED, "unsupported .mach.exports version")};
    }
    val count: u32 = wire.take_u32(?r);
    if (count::usize > wire.remaining(?r) / 4) { ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "malformed .mach.exports count")}; }

    var names: *intern.StrId = nil;
    if (count > 0) {
        val na: res[*intern.StrId, A.Error] = A.zallocate[intern.StrId](alloc, count::usize);
        if (sel na.err) { ret err[fail.Fail].err{fail.message("export request alloc failed")}; }
        names = na.ok;
    }

    var i: u32 = 0;
    for (i < count) {
        if (wire.remaining(?r) < 4) {
            A.deallocate[intern.StrId](alloc, names, count::usize);
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "truncated .mach.exports record")};
        }
        val nlen: usize = wire.take_u32(?r)::usize;
        if (nlen == 0 || nlen > wire.remaining(?r) || of_plan.align_bounded(nlen, 4) > wire.remaining(?r)) {
            A.deallocate[intern.StrId](alloc, names, count::usize);
            ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "malformed .mach.exports record")};
        }
        val name: *u8               = wire.take_bytes(?r, of_plan.align_bounded(nlen, 4));
        val nb:   res[*u8, A.Error] = A.allocate[u8](alloc, nlen + 1);
        if (sel nb.err) {
            A.deallocate[intern.StrId](alloc, names, count::usize);
            ret err[fail.Fail].err{fail.message("export request name alloc failed")};
        }
        val nbuf: *u8 = nb.ok;
        memory.raw_copy(nbuf::ptr, name::ptr, nlen);
        nbuf[nlen] = 0;
        val nir: res[intern.StrId, A.Error] = intern.add(itn, nbuf::str);
        A.deallocate[u8](alloc, nbuf, nlen + 1);
        if (sel nir.err) {
            A.deallocate[intern.StrId](alloc, names, count::usize);
            ret err[fail.Fail].err{fail.refused(nir.err)};
        }
        names[i] = nir.ok;
        i        = i + 1;
    }

    img.export_requests      = names;
    img.export_request_count = count;
    img.export_request_cap   = count;

    A.deallocate[u8](alloc, sec.bytes, sec.len::usize);
    sec.bytes = nil;
    sec.len   = 0;
    ret err[fail.Fail].ok{};
}

# the index of the section named `name`, or none
pub fun find(img: *target_of.ObjectImage, name: intern.StrId) opt[u32] {
    var i: u32 = 0;
    for (i < img.section_count) {
        if (intern.str_same(img.sections[i].name, name)) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# a view of `img` whose sections are the input's plus one carrying `bytes`:
# a zero-length section already named `name` (the husk an earlier parse left)
# is filled in place, otherwise the section is appended. every other array is
# shared with the input, so only the sections array is freed by `release`
pub fun with_section(alloc: *A.Allocator, img: *target_of.ObjectImage, name: intern.StrId,
    template: target_of.Section, bytes: *u8, len: u32, out: *target_of.ObjectImage) err[fail.Fail] {
    @out = @img;
    val n0:   u32 = img.section_count;
    var slot: u32 = n0;
    var i:    u32 = 0;
    for (i < n0) {
        if (intern.str_same(img.sections[i].name, name) && img.sections[i].len == 0) {
            slot = i;
            brk;
        }
        i = i + 1;
    }
    var n1: u32 = n0;
    if (slot == n0) { n1 = n0 + 1; }
    val gs: res[*target_of.Section, A.Error] = A.zallocate[target_of.Section](alloc, n1::usize);
    if (sel gs.err) { ret err[fail.Fail].err{fail.message("section append failed")}; }
    val secs: *target_of.Section = gs.ok;
    i = 0;
    for (i < n0) {
        secs[i] = img.sections[i];
        i       = i + 1;
    }
    secs[slot]        = template;
    secs[slot].name   = name;
    secs[slot].bytes  = bytes;
    secs[slot].len    = len;
    out.sections      = secs;
    out.section_count = n1;
    out.section_cap   = n1;
    ret err[fail.Fail].ok{};
}

pub fun release(alloc: *A.Allocator, view: *target_of.ObjectImage) {
    if (view.sections != nil && view.section_cap > 0) {
        A.deallocate[target_of.Section](alloc, view.sections, view.section_cap::usize);
    }
    view.sections      = nil;
    view.section_count = 0;
    view.section_cap   = 0;
}
