# the build id: a content identity every linked image carries, written by the
# format writer after layout and read back by a running compiler from its own
# mapped headers. it is the compiler-identity component of the object cache
# key: a sha-256 over the bytes the loader maps with the note payload as zero,
# so byte-identical images carry identical ids and nothing outside the image
# bytes enters it. the byte layouts live here so the writers and the run-time
# reader share one definition.

use std.crypto.hash.sha256;
use std.encoding.binary;
use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.str;

pub val DIGEST_LEN: usize = 32;
pub val UUID_LEN:   usize = 16;

# elf: `.note.gnu.build-id`, namesz / descsz / type / "GNU\0" / descriptor
val     ELF_NOTE_NAMESZ:  u32   = 4;
val     ELF_NOTE_TYPE:    u32   = 3;
pub val ELF_NOTE_HEADER:  usize = 16;
pub val ELF_NOTE_SIZE:    usize = 48;
pub val ELF_NOTE_ALIGN:   usize = 4;
pub val ELF_NOTE_SECTION: str   = ".note.gnu.build-id";

pub fun write_elf_note_header(buf: *u8, off: usize) {
    binary.put_uint(?buf[off], ELF_NOTE_NAMESZ::u64, 4, binary.LITTLE);
    binary.put_uint(?buf[off + 4], DIGEST_LEN::u64, 4, binary.LITTLE);
    binary.put_uint(?buf[off + 8], ELF_NOTE_TYPE::u64, 4, binary.LITTLE);
    buf[off + 12] = 'G';
    buf[off + 13] = 'N';
    buf[off + 14] = 'U';
    buf[off + 15] = 0;
}

pub fun elf_note_header_valid(note: *u8) bool {
    ret binary.get_uint(?note[0], 4, binary.LITTLE)::u32 == ELF_NOTE_NAMESZ
        && binary.get_uint(?note[4], 4, binary.LITTLE)::u32 == DIGEST_LEN::u32
        && binary.get_uint(?note[8], 4, binary.LITTLE)::u32 == ELF_NOTE_TYPE
        && note[12] == 'G' && note[13] == 'N' && note[14] == 'U' && note[15] == 0;
}

# the 16-byte form: the first 16 digest bytes with the rfc 4122 version 4 and
# variant 1 bits forced, as ld64 and lld shape a content-derived uuid
pub fun uuid_from_digest(digest: *u8, out: *u8) {
    var i: usize = 0;
    for (i < UUID_LEN) {
        out[i] = digest[i];
        i      = i + 1;
    }
    out[6] = (out[6] & 0x0F) | 0x40;
    out[8] = (out[8] & 0x3F) | 0x80;
}

# pe: one IMAGE_DEBUG_DIRECTORY entry then the codeview record
# "RSDS" / guid / age / empty path, both inside the `.buildid` section
pub val PE_DEBUG_DIR_SIZE:      usize = 28;
pub val PE_DEBUG_TYPE_CODEVIEW: u32   = 2;
pub val PE_CODEVIEW_SIZE:       usize = 25;
pub val PE_CODEVIEW_GUID:       usize = 4;
pub val PE_BUILDID_SIZE:        usize = 53;
pub val PE_BUILDID_SECTION:     str   = ".buildid";

# the directory entry names the record that follows it; both offsets are the
# entry's own position translated into an rva and a file offset
pub fun write_pe_debug_directory(buf: *u8, off: usize, record_rva: u32, record_file_off: u32) {
    binary.put_uint(?buf[off], 0::u64, 4, binary.LITTLE);
    binary.put_uint(?buf[off + 4], 0::u64, 4, binary.LITTLE);
    binary.put_uint(?buf[off + 8], 0::u64, 2, binary.LITTLE);
    binary.put_uint(?buf[off + 10], 0::u64, 2, binary.LITTLE);
    binary.put_uint(?buf[off + 12], PE_DEBUG_TYPE_CODEVIEW::u64, 4, binary.LITTLE);
    binary.put_uint(?buf[off + 16], PE_CODEVIEW_SIZE::u64, 4, binary.LITTLE);
    binary.put_uint(?buf[off + 20], record_rva::u64, 4, binary.LITTLE);
    binary.put_uint(?buf[off + 24], record_file_off::u64, 4, binary.LITTLE);
}

pub fun write_pe_codeview(buf: *u8, off: usize, uuid: *u8) {
    buf[off]     = 'R';
    buf[off + 1] = 'S';
    buf[off + 2] = 'D';
    buf[off + 3] = 'S';
    var i: usize = 0;
    for (i < UUID_LEN) {
        buf[off + PE_CODEVIEW_GUID + i] = uuid[i];
        i                               = i + 1;
    }
    binary.put_uint(?buf[off + 20], 1::u64, 4, binary.LITTLE);
    buf[off + 24] = 0;
}

pub fun pe_codeview_valid(record: *u8) bool {
    ret record[0] == 'R' && record[1] == 'S' && record[2] == 'D' && record[3] == 'S';
}

# sha-256 over a run of image bytes
pub fun digest_range(st: *sha256.State, buf: *u8, off: usize, len: usize) {
    if (len == 0) { ret; }
    sha256.update(st, (buf::usize + off)::*u8, len);
}
