use std.types.bool.false;
use std.types.bool.true;

use mach.lang.target.abi;
use catalog_abi:  mach.lang.target.catalog.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use isa_inst:     mach.lang.target.isa.inst;
use target_model: mach.lang.target.model;

val REG_X0:  i32 = isa_inst.REG_GP_BASE | 0;
val REG_X1:  i32 = isa_inst.REG_GP_BASE | 1;
val REG_X8:  i32 = isa_inst.REG_GP_BASE | 8;
val REG_X19: i32 = isa_inst.REG_GP_BASE | 19;
val REG_V0:  i32 = isa_inst.REG_FP_BASE | 0;

val GP_PARAM_COUNT:        i32 = 8;
val FP_PARAM_COUNT:        i32 = 8;
val GP_CALLEE_SAVED_COUNT: i32 = 10;
val FP_CALLEE_SAVED_COUNT: i32 = 8;
val CALLEE_SAVED_COUNT:    i32 = 18;

val STACK_ALIGN: u32 = 16;
val RED_ZONE:    u32 = 0;
val MAX_REG_RET: u64 = 16;

val WORD: u32 = 8;

# a 16-byte integer scalar: C.10 rounds NGRN up to even when its alignment is
# 16 and passes it in the next two registers, else C.11 sets NGRN to 8 and it
# goes to the stack at its natural 16-byte alignment. darwin hands the
# classifier an alignment of 8, so the pair starts in any register
val DOUBLE_WORD: u64 = 16;

fun gp_param_reg(index: i32) i32 {
    if (index < 0)               { ret isa_inst.REG_NONE; }
    if (index >= GP_PARAM_COUNT) { ret isa_inst.REG_NONE; }
    ret REG_X0 + index;
}

fun fp_param_reg(index: i32) i32 {
    if (index < 0)               { ret isa_inst.REG_NONE; }
    if (index >= FP_PARAM_COUNT) { ret isa_inst.REG_NONE; }
    ret isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, index);
}

val VEC_REG_BYTES: u8 = 16;

# a composite that is no HFA or HVA takes a word stack slot where fixed
# arguments are otherwise placed at their natural size, as Apple places one
fun classify_arg(vt: *abi.AbiVTable, q: *abi.ArgQuery) abi.ParamSlot {
    var hfa_members: u8 = 0;
    var hfa_elem:    u8 = 0;
    if (abi.arg_members_read(q)) { abi.homogeneous_float(vt, q.types, q.ty, ?hfa_members, ?hfa_elem); }
    var slot: abi.ParamSlot = place_arg(vt, q, hfa_members, hfa_elem);
    if (q.is_aggregate && hfa_members == 0) { slot.word_stack = true; }
    ret slot;
}

fun place_arg(vt: *abi.AbiVTable, q: *abi.ArgQuery, hfa_members: u8, hfa_elem: u8) abi.ParamSlot {
    # an empty record takes no register and no stack: clang ignores one in C on
    # linux, and Apple's arm64 ABI lets a function ignore it
    if (q.is_aggregate && q.size == 0) {
        ret abi.make_slot(abi.CLASS_GP, isa_inst.REG_NONE, 0, 0, 0);
    }

    # C.3: an HFA or HVA that does not fit the vector registers left sets NSRN
    # to 8, so no later floating-point argument takes one
    if (q.is_aggregate && hfa_members > 0) {
        if (q.fp_used + hfa_members::i32 <= FP_PARAM_COUNT) {
            ret abi.make_slot_hfa(fp_param_reg(q.fp_used), hfa_members, hfa_elem, q.size);
        }
        var hs: abi.ParamSlot = abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        hs.fp_consumed = remaining(FP_PARAM_COUNT, q.fp_used);
        ret hs;
    }

    if (q.is_aggregate && q.size > MAX_REG_RET) {
        if (q.gp_used < GP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(q.gp_used), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, isa_inst.REG_NONE, 0, 8, 0);
    }

    if (q.is_aggregate) {
        if (q.size <= 8) {
            if (q.gp_used < GP_PARAM_COUNT) {
                ret abi.make_slot(abi.CLASS_GP, gp_param_reg(q.gp_used), 0, q.size, 8);
            }
            ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        }
        # C.12: a composite of alignment 16 rounds NGRN up to even, as a 16-byte
        # integer does. its alignment is the natural one, which darwin caps at 8
        var ngrn: i32 = q.gp_used;
        if (q.align >= DOUBLE_WORD && (ngrn & 1) != 0) { ngrn = ngrn + 1; }
        if (ngrn + 2 <= GP_PARAM_COUNT) {
            var ps: abi.ParamSlot = abi.make_slot_pair(abi.CLASS_GP, gp_param_reg(ngrn), gp_param_reg(ngrn + 1), 0, q.size, WORD);
            ps.gp_consumed = ngrn + 2 - q.gp_used;
            ret ps;
        }
        # C.13: a composite that does not fit the general registers left sets
        # NGRN to 8, so no later integer argument takes one
        var cs: abi.ParamSlot = abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        cs.gp_consumed = remaining(GP_PARAM_COUNT, q.gp_used);
        ret cs;
    }

    if (q.is_vector) {
        if (q.size <= VEC_REG_BYTES::u64) {
            if (q.fp_used < FP_PARAM_COUNT) {
                ret abi.make_slot_hfa(fp_param_reg(q.fp_used), 1, VEC_REG_BYTES, q.size);
            }
            ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        }
        if (q.gp_used < GP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(q.gp_used), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, isa_inst.REG_NONE, 0, 8, 0);
    }

    if (abi.arg_is_float(vt, q)) {
        if (q.fp_used < FP_PARAM_COUNT) {
            ret abi.make_slot(abi.CLASS_FP, fp_param_reg(q.fp_used), 0, q.size, q.size::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
    }

    if (q.size == DOUBLE_WORD) {
        var ngrn: i32 = q.gp_used;
        if (q.align >= DOUBLE_WORD && (ngrn & 1) != 0) { ngrn = ngrn + 1; }
        if (ngrn + 2 <= GP_PARAM_COUNT) {
            var s: abi.ParamSlot = abi.make_slot_pair(abi.CLASS_GP, gp_param_reg(ngrn), gp_param_reg(ngrn + 1), 0, q.size, WORD);
            s.gp_consumed = ngrn + 2 - q.gp_used;
            ret s;
        }
        var st: abi.ParamSlot = abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        st.gp_consumed = remaining(GP_PARAM_COUNT, q.gp_used);
        ret st;
    }

    if (q.gp_used < GP_PARAM_COUNT) {
        ret abi.make_slot(abi.CLASS_GP, gp_param_reg(q.gp_used), 0, q.size, 8);
    }
    ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
}

fun remaining(count: i32, used: i32) i32 {
    if (used >= count) { ret 0; }
    ret count - used;
}

fun classify_return(vt: *abi.AbiVTable, q: *abi.RetQuery) abi.ParamSlot {
    var hfa_members: u8 = 0;
    var hfa_elem:    u8 = 0;
    abi.homogeneous_float(vt, q.types, q.ty, ?hfa_members, ?hfa_elem);
    if (q.size == 0) {
        ret abi.make_slot(abi.CLASS_GP, isa_inst.REG_NONE, 0, 0, 0);
    }

    if (q.is_aggregate && hfa_members > 0) {
        ret abi.make_slot_hfa(fp_param_reg(0), hfa_members, hfa_elem, q.size);
    }

    if (q.is_aggregate && q.size > MAX_REG_RET) {
        ret abi.make_slot(abi.CLASS_SRET, REG_X8, 0, 8, 8);
    }

    if (q.is_aggregate) {
        if (q.size <= 8) {
            ret abi.make_slot(abi.CLASS_GP, REG_X0, 0, q.size, 8);
        }
        ret abi.make_slot_pair(abi.CLASS_GP, REG_X0, REG_X1, 0, q.size, WORD);
    }

    if (q.is_vector) {
        if (q.size <= VEC_REG_BYTES::u64) {
            ret abi.make_slot_hfa(fp_param_reg(0), 1, VEC_REG_BYTES, q.size);
        }
        ret abi.make_slot(abi.CLASS_SRET, REG_X8, 0, 8, 8);
    }

    if (abi.ret_is_float(vt, q)) {
        ret abi.make_slot(abi.CLASS_FP, fp_param_reg(0), 0, q.size, q.size::u8);
    }

    if (q.size == DOUBLE_WORD) {
        ret abi.make_slot_pair(abi.CLASS_GP, REG_X0, REG_X1, 0, q.size, WORD);
    }
    ret abi.make_slot(abi.CLASS_GP, REG_X0, 0, q.size, 8);
}

val GP_ARGS: [8]target_model.Register = [8]target_model.Register{
    target_model.Register{id: REG_X0, size: 8},
    target_model.Register{id: REG_X0 + 1, size: 8},
    target_model.Register{id: REG_X0 + 2, size: 8},
    target_model.Register{id: REG_X0 + 3, size: 8},
    target_model.Register{id: REG_X0 + 4, size: 8},
    target_model.Register{id: REG_X0 + 5, size: 8},
    target_model.Register{id: REG_X0 + 6, size: 8},
    target_model.Register{id: REG_X0 + 7, size: 8},
};

val CALLEE_SAVED: [18]target_model.Register = [18]target_model.Register{
    target_model.Register{id: REG_X19, size: 8},
    target_model.Register{id: REG_X19 + 1, size: 8},
    target_model.Register{id: REG_X19 + 2, size: 8},
    target_model.Register{id: REG_X19 + 3, size: 8},
    target_model.Register{id: REG_X19 + 4, size: 8},
    target_model.Register{id: REG_X19 + 5, size: 8},
    target_model.Register{id: REG_X19 + 6, size: 8},
    target_model.Register{id: REG_X19 + 7, size: 8},
    target_model.Register{id: REG_X19 + 8, size: 8},
    target_model.Register{id: REG_X19 + 9, size: 8},
    target_model.Register{id: REG_V0 + 8, size: 16},
    target_model.Register{id: REG_V0 + 9, size: 16},
    target_model.Register{id: REG_V0 + 10, size: 16},
    target_model.Register{id: REG_V0 + 11, size: 16},
    target_model.Register{id: REG_V0 + 12, size: 16},
    target_model.Register{id: REG_V0 + 13, size: 16},
    target_model.Register{id: REG_V0 + 14, size: 16},
    target_model.Register{id: REG_V0 + 15, size: 16},
};

val VA_MODEL: abi.VaModel = abi.VaModel{kind: abi.VA_MODEL_REG_SAVE, float_dup_gp: false, vector_count_reg: isa_inst.REG_NONE, variadic_float_bits: 64};

pub val VTABLE: abi.AbiVTable = abi.AbiVTable{
    passing:             catalog_abi.PASSING_CARRIERS,
    id:                  catalog_abi.AAPCS64,
    name:                "aapcs64",
    arch_id:             catalog_arch.AARCH64,
    arg_passing:         classify_arg,
    ret_passing:         classify_return,
    gp_arg_regs:         target_model.RegFile{regs: ?GP_ARGS[0], count: GP_PARAM_COUNT},
    callee_saved:        target_model.RegFile{regs: ?CALLEE_SAVED[0], count: CALLEE_SAVED_COUNT},
    stack_align:         STACK_ALIGN,
    red_zone:            RED_ZONE,
    indirect_result_reg: REG_X8,
    # v8-v15 keep only their low 64 bits
    fp_callee_saved_bytes: 8,
    float_arg_bits:        64,
    arg_slot_granularity:  WORD,
    va_model:              ?VA_MODEL,
    agg_natural_align:     true,
    # a half-precision float is a floating-point type of AAPCS64: it rides an h
    # register and is an HFA member of two bytes
    half: abi.HALF_FLOAT,
};
