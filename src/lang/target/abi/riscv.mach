use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use mach.lang.target.abi;
use catalog_abi:  mach.lang.target.catalog.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use isa_inst:     mach.lang.target.isa.inst;
use target_model: mach.lang.target.model;

# the parameters of one psABI variant, which the family's one classifier reads
# from the descriptor it is called through
rec Family {
    xlen_bits:    u32;
    flen_bits:    u32;
    gp_arg_count: i32;
    fp_arg_count: i32;
}

val LP64_FAMILY:   Family = Family{xlen_bits: 64, flen_bits: 0, gp_arg_count: 8, fp_arg_count: 8};
val LP64F_FAMILY:  Family = Family{xlen_bits: 64, flen_bits: 32, gp_arg_count: 8, fp_arg_count: 8};
val LP64D_FAMILY:  Family = Family{xlen_bits: 64, flen_bits: 64, gp_arg_count: 8, fp_arg_count: 8};
val ILP32_FAMILY:  Family = Family{xlen_bits: 32, flen_bits: 0, gp_arg_count: 8, fp_arg_count: 8};
val ILP32F_FAMILY: Family = Family{xlen_bits: 32, flen_bits: 32, gp_arg_count: 8, fp_arg_count: 8};
val ILP32D_FAMILY: Family = Family{xlen_bits: 32, flen_bits: 64, gp_arg_count: 8, fp_arg_count: 8};

val REG_A0: i32 = isa_inst.REG_GP_BASE | 10;
val REG_A1: i32 = isa_inst.REG_GP_BASE | 11;
val REG_S1: i32 = isa_inst.REG_GP_BASE | 9;
val REG_S2: i32 = isa_inst.REG_GP_BASE | 18;
val REG_F0: i32 = isa_inst.REG_FP_BASE | 0;

val STACK_ALIGN: u32 = 16;
val RED_ZONE:    u32 = 0;

fun xlen_bytes(v: Family) u64 {
    ret (v.xlen_bits / 8)::u64;
}

fun max_reg_ret(v: Family) u64 {
    ret 2 * xlen_bytes(v);
}

fun float_in_fp_bank(v: Family, width: u64) bool {
    if (v.flen_bits == 0) { ret false; }
    ret (width * 8) <= v.flen_bits::u64;
}

fun gp_param_reg(v: Family, index: i32) i32 {
    if (index < 0)               { ret isa_inst.REG_NONE; }
    if (index >= v.gp_arg_count) { ret isa_inst.REG_NONE; }
    ret REG_A0 + index;
}

fun fp_param_reg(v: Family, index: i32) i32 {
    if (index < 0)               { ret isa_inst.REG_NONE; }
    if (index >= v.fp_arg_count) { ret isa_inst.REG_NONE; }
    ret isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, isa_inst.regid_index(REG_A0) + index);
}

fun two_leaf_float_count(agg: abi.AggLayout) u32 {
    var nf: u32 = 0;
    var k:  u32 = 0;
    for (k < 2) {
        if (agg.fields[k].is_float) { nf = nf + 1; }
        k = k + 1;
    }
    ret nf;
}

fun leaves_fit_fp_bank(v: Family, agg: abi.AggLayout) bool {
    var k: u32 = 0;
    for (k < 2) {
        if (agg.fields[k].is_float) {
            if (!float_in_fp_bank(v, agg.fields[k].width::u64)) { ret false; }
        }
        k = k + 1;
    }
    ret true;
}

fun make_two_leaf_slot(agg: abi.AggLayout, nf: u32, fp0: i32, fp1: i32, gp0: i32, size: u64) abi.ParamSlot {
    var ps:      [2]abi.ParamPiece;
    var fa_used: u32 = 0;
    var j:       u32 = 0;
    for (j < 2) {
        if (agg.fields[j].is_float) {
            var reg: i32 = fp0;
            if (fa_used != 0) { reg = fp1; }
            ps[j]   = abi.make_piece(abi.PIECE_FP, reg, agg.fields[j].offset::i64, 0, agg.fields[j].width);
            fa_used = fa_used + 1;
        }
        or {
            ps[j] = abi.make_piece(abi.PIECE_GP, gp0, agg.fields[j].offset::i64, 0, agg.fields[j].width);
        }
        j = j + 1;
    }
    var class: abi.ParamClass = abi.CLASS_GP;
    if (nf == 2) { class = abi.CLASS_FP; }
    ret abi.make_slot_pieces(class, ?ps[0], 2, size);
}

fun place_two_words(v: Family, gp_used: i32, size: u64) abi.ParamSlot {
    val word: u64 = xlen_bytes(v);

    if (gp_used + 2 <= v.gp_arg_count) {
        ret abi.make_slot_pair(abi.CLASS_GP, gp_param_reg(v, gp_used), gp_param_reg(v, gp_used + 1),
            0, size, word::u32);
    }

    if (gp_used + 1 == v.gp_arg_count) {
        var ps: [2]abi.ParamPiece;
        ps[0] = abi.make_piece(abi.PIECE_GP, gp_param_reg(v, gp_used), 0, 0, word::u8);
        ps[1] = abi.make_piece(abi.PIECE_STACK, isa_inst.REG_NONE, word::i64, 0, word::u8);
        ret abi.make_slot_pieces(abi.CLASS_GP, ?ps[0], 2, size);
    }

    ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, size, 0);
}

fun family_of(vt: *abi.AbiVTable) *Family {
    ret vt.family::*Family;
}

val AGG_MAX_LEAVES: u32 = 2;

# flattens an aggregate into at most `cap` scalar leaves; a union or tag is never flattened, and an aggregate
# over the cap reports cap + 1
fun collect_leaves(vt: *abi.AbiVTable, view: *abi.TypeView, ty: u32, base_off: u64, out: *abi.AggField, cap: u32, count: u32) u32 {
    if (count > cap) { ret count; }
    val f: abi.TypeFacts = abi.type_facts(view, ty);
    if (f.shape == abi.SHAPE_NONE || f.shape == abi.SHAPE_UNION || f.shape == abi.SHAPE_TAG) { ret cap + 1; }
    if (f.shape == abi.SHAPE_RECORD || f.shape == abi.SHAPE_ARRAY) {
        var c: u32 = count;
        var i: u32 = 0;
        for (i < f.count) {
            val m: abi.TypeMember = abi.type_member(view, ty, i);
            c = collect_leaves(vt, view, m.ty, base_off + m.offset, out, cap, c);
            if (c > cap) { ret c; }
            i = i + 1;
        }
        ret c;
    }
    if (count < cap) {
        out[count].is_float = abi.shape_is_float(vt, f.shape);
        out[count].offset   = base_off::u32;
        out[count].width    = f.size::u8;
    }
    ret count + 1;
}

# the one or two scalar leaves a small aggregate is passed field by field in,
# none for any other type
fun leaves(vt: *abi.AbiVTable, view: *abi.TypeView, ty: u32) abi.AggLayout {
    var out: abi.AggLayout = abi.agg_none();
    val n:   u32           = collect_leaves(vt, view, ty, 0, ?out.fields[0], AGG_MAX_LEAVES, 0);
    if (n == 1 || n == 2) { out.field_count = n::u8; }
    ret out;
}

fun classify_arg(vt: *abi.AbiVTable, q: *abi.ArgQuery) abi.ParamSlot {
    val v:           Family        = @family_of(vt);
    val word:        u64           = xlen_bytes(v);
    var hfa_members: u8            = 0;
    var hfa_elem:    u8            = 0;
    var agg:         abi.AggLayout = abi.agg_none();
    if (abi.arg_members_read(q)) {
        abi.homogeneous_float(vt, q.types, q.ty, ?hfa_members, ?hfa_elem);
        agg = leaves(vt, q.types, q.ty);
    }

    if (q.is_vector) {
        if (q.gp_used < v.gp_arg_count) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(v, q.gp_used), 0, word, word::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, isa_inst.REG_NONE, 0, word, 0);
    }

    if (q.is_aggregate && q.size > max_reg_ret(v)) {
        if (q.gp_used < v.gp_arg_count) {
            ret abi.make_slot(abi.CLASS_BYREF, gp_param_reg(v, q.gp_used), 0, word, word::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, isa_inst.REG_NONE, 0, word, 0);
    }

    if (q.is_aggregate && (hfa_members == 1 || hfa_members == 2)) {
        if (float_in_fp_bank(v, hfa_elem::u64)) {
            if (q.fp_used + hfa_members::i32 <= v.fp_arg_count) {
                ret abi.make_slot_hfa(fp_param_reg(v, q.fp_used), hfa_members, hfa_elem, q.size);
            }
        }
    }

    if (q.is_aggregate && agg.field_count == 2 && leaves_fit_fp_bank(v, agg)) {
        val nf: u32 = two_leaf_float_count(agg);
        if (nf == 2) {
            if (q.fp_used + 2 <= v.fp_arg_count) {
                ret make_two_leaf_slot(agg, 2, fp_param_reg(v, q.fp_used), fp_param_reg(v, q.fp_used + 1), isa_inst.REG_NONE, q.size);
            }
        }
        or (nf == 1) {
            if (q.fp_used < v.fp_arg_count && q.gp_used < v.gp_arg_count) {
                ret make_two_leaf_slot(agg, 1, fp_param_reg(v, q.fp_used), isa_inst.REG_NONE, gp_param_reg(v, q.gp_used), q.size);
            }
        }
    }

    if (q.is_aggregate) {
        if (q.size <= word) {
            if (q.gp_used < v.gp_arg_count) {
                ret abi.make_slot(abi.CLASS_GP, gp_param_reg(v, q.gp_used), 0, q.size, word::u8);
            }
            ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        }
        ret place_two_words(v, q.gp_used, q.size);
    }

    if (abi.arg_is_float(vt, q)) {
        if (float_in_fp_bank(v, q.size) && q.fp_used < v.fp_arg_count) {
            ret abi.make_slot(abi.CLASS_FP, fp_param_reg(v, q.fp_used), 0, q.size, q.size::u8);
        }
        if (q.size > word) { ret place_two_words(v, q.gp_used, q.size); }
        if (q.gp_used < v.gp_arg_count) {
            ret abi.make_slot(abi.CLASS_GP, gp_param_reg(v, q.gp_used), 0, q.size, word::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
    }

    if (q.size > word) { ret place_two_words(v, q.gp_used, q.size); }

    if (q.gp_used < v.gp_arg_count) {
        ret abi.make_slot(abi.CLASS_GP, gp_param_reg(v, q.gp_used), 0, q.size, word::u8);
    }
    ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
}

fun classify_return(vt: *abi.AbiVTable, q: *abi.RetQuery) abi.ParamSlot {
    val v:           Family = @family_of(vt);
    val word:        u64    = xlen_bytes(v);
    var hfa_members: u8     = 0;
    var hfa_elem:    u8     = 0;
    abi.homogeneous_float(vt, q.types, q.ty, ?hfa_members, ?hfa_elem);
    var agg: abi.AggLayout = abi.agg_none();
    if (q.is_aggregate) { agg = leaves(vt, q.types, q.ty); }

    if (q.size == 0) { ret abi.make_slot(abi.CLASS_GP, isa_inst.REG_NONE, 0, 0, 0); }

    if (q.is_vector)                               { ret abi.make_slot(abi.CLASS_SRET, REG_A0, 0, word, word::u8); }
    if (q.is_aggregate && q.size > max_reg_ret(v)) { ret abi.make_slot(abi.CLASS_SRET, REG_A0, 0, word, word::u8); }

    if (q.is_aggregate && (hfa_members == 1 || hfa_members == 2)) {
        if (float_in_fp_bank(v, hfa_elem::u64)) {
            ret abi.make_slot_hfa(fp_param_reg(v, 0), hfa_members, hfa_elem, q.size);
        }
    }

    if (q.is_aggregate && agg.field_count == 2 && leaves_fit_fp_bank(v, agg)) {
        val nf: u32 = two_leaf_float_count(agg);
        if (nf == 2) {
            ret make_two_leaf_slot(agg, 2, fp_param_reg(v, 0), fp_param_reg(v, 1), isa_inst.REG_NONE, q.size);
        }
        or (nf == 1) {
            ret make_two_leaf_slot(agg, 1, fp_param_reg(v, 0), isa_inst.REG_NONE, REG_A0, q.size);
        }
    }

    if (q.is_aggregate) {
        if (q.size <= word) { ret abi.make_slot(abi.CLASS_GP, REG_A0, 0, q.size, word::u8); }
        ret abi.make_slot_pair(abi.CLASS_GP, REG_A0, REG_A1, 0, q.size, xlen_bytes(v)::u32);
    }

    if (abi.ret_is_float(vt, q) && float_in_fp_bank(v, q.size)) {
        ret abi.make_slot(abi.CLASS_FP, fp_param_reg(v, 0), 0, q.size, q.size::u8);
    }

    if (q.size > word) {
        ret abi.make_slot_pair(abi.CLASS_GP, REG_A0, REG_A1, 0, q.size, word::u32);
    }

    ret abi.make_slot(abi.CLASS_GP, REG_A0, 0, q.size, word::u8);
}

# a0-a7 carry the integer arguments; s1-s11 and fs0-fs11 survive a call, an
# f register whole whatever the variant passes in it
val GP_ARGS64: [8]target_model.Register = [8]target_model.Register{
    target_model.Register{id: REG_A0, size: 8},
    target_model.Register{id: REG_A0 + 1, size: 8},
    target_model.Register{id: REG_A0 + 2, size: 8},
    target_model.Register{id: REG_A0 + 3, size: 8},
    target_model.Register{id: REG_A0 + 4, size: 8},
    target_model.Register{id: REG_A0 + 5, size: 8},
    target_model.Register{id: REG_A0 + 6, size: 8},
    target_model.Register{id: REG_A0 + 7, size: 8},
};

val GP_ARGS32: [8]target_model.Register = [8]target_model.Register{
    target_model.Register{id: REG_A0, size: 4},
    target_model.Register{id: REG_A0 + 1, size: 4},
    target_model.Register{id: REG_A0 + 2, size: 4},
    target_model.Register{id: REG_A0 + 3, size: 4},
    target_model.Register{id: REG_A0 + 4, size: 4},
    target_model.Register{id: REG_A0 + 5, size: 4},
    target_model.Register{id: REG_A0 + 6, size: 4},
    target_model.Register{id: REG_A0 + 7, size: 4},
};

val CALLEE_SAVED64: [23]target_model.Register = [23]target_model.Register{
    target_model.Register{id: REG_S1, size: 8},
    target_model.Register{id: REG_S2, size: 8},
    target_model.Register{id: REG_S2 + 1, size: 8},
    target_model.Register{id: REG_S2 + 2, size: 8},
    target_model.Register{id: REG_S2 + 3, size: 8},
    target_model.Register{id: REG_S2 + 4, size: 8},
    target_model.Register{id: REG_S2 + 5, size: 8},
    target_model.Register{id: REG_S2 + 6, size: 8},
    target_model.Register{id: REG_S2 + 7, size: 8},
    target_model.Register{id: REG_S2 + 8, size: 8},
    target_model.Register{id: REG_S2 + 9, size: 8},
    target_model.Register{id: REG_F0 + 8, size: 8},
    target_model.Register{id: REG_F0 + 9, size: 8},
    target_model.Register{id: REG_F0 + 18, size: 8},
    target_model.Register{id: REG_F0 + 19, size: 8},
    target_model.Register{id: REG_F0 + 20, size: 8},
    target_model.Register{id: REG_F0 + 21, size: 8},
    target_model.Register{id: REG_F0 + 22, size: 8},
    target_model.Register{id: REG_F0 + 23, size: 8},
    target_model.Register{id: REG_F0 + 24, size: 8},
    target_model.Register{id: REG_F0 + 25, size: 8},
    target_model.Register{id: REG_F0 + 26, size: 8},
    target_model.Register{id: REG_F0 + 27, size: 8},
};

val CALLEE_SAVED32: [23]target_model.Register = [23]target_model.Register{
    target_model.Register{id: REG_S1, size: 4},
    target_model.Register{id: REG_S2, size: 4},
    target_model.Register{id: REG_S2 + 1, size: 4},
    target_model.Register{id: REG_S2 + 2, size: 4},
    target_model.Register{id: REG_S2 + 3, size: 4},
    target_model.Register{id: REG_S2 + 4, size: 4},
    target_model.Register{id: REG_S2 + 5, size: 4},
    target_model.Register{id: REG_S2 + 6, size: 4},
    target_model.Register{id: REG_S2 + 7, size: 4},
    target_model.Register{id: REG_S2 + 8, size: 4},
    target_model.Register{id: REG_S2 + 9, size: 4},
    target_model.Register{id: REG_F0 + 8, size: 8},
    target_model.Register{id: REG_F0 + 9, size: 8},
    target_model.Register{id: REG_F0 + 18, size: 8},
    target_model.Register{id: REG_F0 + 19, size: 8},
    target_model.Register{id: REG_F0 + 20, size: 8},
    target_model.Register{id: REG_F0 + 21, size: 8},
