    arg_passing:                classify_arg,
    ret_passing:                classify_return,
    family:                     ?ILP32D_FAMILY,
    gp_arg_regs:                target_model.RegFile{regs: ?GP_ARGS32[0], count: GP_ARG_COUNT},
    callee_saved:               target_model.RegFile{regs: ?CALLEE_SAVED32[0], count: CALLEE_SAVED_COUNT},
    stack_align:                STACK_ALIGN,
    red_zone:                   RED_ZONE,
    indirect_result_reg:        REG_A0,
    indirect_result_in_argfile: true,
    fp_callee_saved_bytes:      16,
    float_arg_bits:             64,
    arg_slot_granularity:       4,
    va_model:                   ?VA_MODEL,
    half:                       abi.HALF_FLOAT_NANBOX,
};
