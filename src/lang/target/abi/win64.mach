use std.types.bool.bool;
use std.types.bool.true;

use mach.lang.target.abi;
use catalog_abi:  mach.lang.target.catalog.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use isa_inst:     mach.lang.target.isa.inst;
use target_model: mach.lang.target.model;

val REG_RAX: i32 = isa_inst.REG_GP_BASE | 0;
val REG_RCX: i32 = isa_inst.REG_GP_BASE | 1;
val REG_RDX: i32 = isa_inst.REG_GP_BASE | 2;
val REG_RBX: i32 = isa_inst.REG_GP_BASE | 3;
val REG_RSP: i32 = isa_inst.REG_GP_BASE | 4;
val REG_RBP: i32 = isa_inst.REG_GP_BASE | 5;
val REG_RSI: i32 = isa_inst.REG_GP_BASE | 6;
val REG_RDI: i32 = isa_inst.REG_GP_BASE | 7;
val REG_R8:  i32 = isa_inst.REG_GP_BASE | 8;
val REG_R9:  i32 = isa_inst.REG_GP_BASE | 9;
val REG_R12: i32 = isa_inst.REG_GP_BASE | 12;
val REG_R13: i32 = isa_inst.REG_GP_BASE | 13;
val REG_R14: i32 = isa_inst.REG_GP_BASE | 14;
val REG_R15: i32 = isa_inst.REG_GP_BASE | 15;

val REG_XMM0: i32 = isa_inst.REG_FP_BASE | 0;

val PARAM_SLOT_COUNT: i32 = 4;

val VEC_REG_BYTES:          u64 = 16;
val GP_PARAM_COUNT:         i32 = 4;
val FP_PARAM_COUNT:         i32 = 4;
val CALLEE_SAVED_GP_COUNT:  i32 = 9;
val CALLEE_SAVED_XMM_COUNT: i32 = 10;
val CALLEE_SAVED_COUNT:     i32 = CALLEE_SAVED_GP_COUNT + CALLEE_SAVED_XMM_COUNT;

val STACK_ALIGN:  u32 = 16;
val RED_ZONE:     u32 = 0;
val SHADOW_SPACE: u64 = 32;

fun is_by_value_size(size: u64) bool {
    ret size == 1 || size == 2 || size == 4 || size == 8;
}

# a 16-byte integer has no Microsoft rule (MSVC has no such type). the
# convention is the one GCC (mingw-w64) and Clang share: LLVM 18 made i128
# match __int128 ("Changes to the X86 Backend", LLVM 18.1 release notes), and
# llvm/llvm-project#115052 describes that convention as passing on the stack
# by reference and returning in xmm0, "identical to i128" and "the same as
# GCC". a clang -O0 probe exhibits it: the argument
# is a pointer to a caller copy like any other 16-byte object, the value
# returns in XMM0 with the low half in the low lanes
val INT128: u64 = 16;

fun slot_gp_reg(index: i32) i32 {
    if (index == 0) { ret REG_RCX; }
    if (index == 1) { ret REG_RDX; }
    if (index == 2) { ret REG_R8; }
    if (index == 3) { ret REG_R9; }
    ret isa_inst.REG_NONE;
}

fun slot_fp_reg(index: i32) i32 {
    if (index < 0)               { ret isa_inst.REG_NONE; }
    if (index >= FP_PARAM_COUNT) { ret isa_inst.REG_NONE; }
    ret isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, index);
}

fun classify_arg(vt: *abi.AbiVTable, q: *abi.ArgQuery) abi.ParamSlot {
    val slot: i32 = slot_index(q.gp_used, q.fp_used);

    if (q.is_vector) {
        if (is_by_value_size(q.size)) {
            if (slot < PARAM_SLOT_COUNT) {
                ret abi.make_slot(abi.CLASS_GP, slot_gp_reg(slot), 0, q.size, 8);
            }
            ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        }
        if (slot < PARAM_SLOT_COUNT) {
            ret abi.make_slot_indirect(abi.CLASS_VEC_BYREF, slot_gp_reg(slot), 0, 8,
                q.size, VEC_REG_BYTES::u32);
        }
        ret abi.make_slot_indirect(abi.CLASS_VEC_STACK_BYREF, isa_inst.REG_NONE, 0, 8,
            q.size, VEC_REG_BYTES::u32);
    }

    if (q.is_aggregate) {
        if (is_by_value_size(q.size)) {
            if (slot < PARAM_SLOT_COUNT) {
                ret abi.make_slot(abi.CLASS_GP, slot_gp_reg(slot), 0, q.size, 8);
            }
            ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
        }
        if (slot < PARAM_SLOT_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, slot_gp_reg(slot), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, isa_inst.REG_NONE, 0, 8, 0);
    }

    if (abi.arg_is_float(vt, q)) {
        if (slot < PARAM_SLOT_COUNT) {
            ret abi.make_slot(abi.CLASS_FP, slot_fp_reg(slot), 0, q.size, q.size::u8);
        }
        ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
    }

    if (q.size == INT128) {
        if (slot < PARAM_SLOT_COUNT) {
            ret abi.make_slot(abi.CLASS_BYREF, slot_gp_reg(slot), 0, 8, 8);
        }
        ret abi.make_slot(abi.CLASS_STACK_BYREF, isa_inst.REG_NONE, 0, 8, 0);
    }

    if (slot < PARAM_SLOT_COUNT) {
        ret abi.make_slot(abi.CLASS_GP, slot_gp_reg(slot), 0, q.size, 8);
    }
    ret abi.make_slot(abi.CLASS_STACK, isa_inst.REG_NONE, 0, q.size, 0);
}

fun classify_return(vt: *abi.AbiVTable, q: *abi.RetQuery) abi.ParamSlot {
    if (q.size == 0) {
        ret abi.make_slot(abi.CLASS_GP, isa_inst.REG_NONE, 0, 0, 0);
    }

    if (q.is_vector) {
        if (is_by_value_size(q.size)) {
            ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, q.size, 8);
        }
        if (q.size == VEC_REG_BYTES) {
            ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, q.size, q.size::u8);
        }
        ret abi.make_slot(abi.CLASS_SRET, REG_RAX, 0, 8, 8);
    }

    if (q.is_aggregate) {
        if (is_by_value_size(q.size)) {
            ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, q.size, 8);
        }
        ret abi.make_slot(abi.CLASS_SRET, REG_RAX, 0, 8, 8);
    }

    if (abi.ret_is_float(vt, q)) {
        ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, q.size, q.size::u8);
    }

    if (q.size == INT128) {
        ret abi.make_slot(abi.CLASS_FP, REG_XMM0, 0, q.size, q.size::u8);
    }
    ret abi.make_slot(abi.CLASS_GP, REG_RAX, 0, q.size, 8);
}

val GP_ARGS: [4]target_model.Register = [4]target_model.Register{
    target_model.Register{id: REG_RCX, size: 8},
    target_model.Register{id: REG_RDX, size: 8},
    target_model.Register{id: REG_R8, size: 8},
    target_model.Register{id: REG_R9, size: 8},
};

val CALLEE_SAVED: [19]target_model.Register = [19]target_model.Register{
    target_model.Register{id: REG_RBX, size: 8},
    target_model.Register{id: REG_RBP, size: 8},
    target_model.Register{id: REG_RDI, size: 8},
    target_model.Register{id: REG_RSI, size: 8},
    target_model.Register{id: REG_RSP, size: 8},
    target_model.Register{id: REG_R12, size: 8},
    target_model.Register{id: REG_R13, size: 8},
    target_model.Register{id: REG_R14, size: 8},
    target_model.Register{id: REG_R15, size: 8},
    target_model.Register{id: REG_XMM0 + 6, size: 16},
    target_model.Register{id: REG_XMM0 + 7, size: 16},
    target_model.Register{id: REG_XMM0 + 8, size: 16},
    target_model.Register{id: REG_XMM0 + 9, size: 16},
    target_model.Register{id: REG_XMM0 + 10, size: 16},
    target_model.Register{id: REG_XMM0 + 11, size: 16},
    target_model.Register{id: REG_XMM0 + 12, size: 16},
    target_model.Register{id: REG_XMM0 + 13, size: 16},
    target_model.Register{id: REG_XMM0 + 14, size: 16},
    target_model.Register{id: REG_XMM0 + 15, size: 16},
};

val VA_MODEL: abi.VaModel = abi.VaModel{kind: abi.VA_MODEL_HOME, float_dup_gp: true, vector_count_reg: isa_inst.REG_NONE, variadic_float_bits: 64};

fun slot_index(gp_used: i32, fp_used: i32) i32 {
    ret gp_used + fp_used;
}

val EIGHTBYTE: u32 = 8;

pub val VTABLE: abi.AbiVTable = abi.AbiVTable{
    passing:                    catalog_abi.PASSING_CARRIERS,
    id:                         catalog_abi.WIN64,
    name:                       "win64",
    arch_id:                    catalog_arch.X86_64,
    arg_passing:                classify_arg,
    ret_passing:                classify_return,
    gp_arg_regs:                target_model.RegFile{regs: ?GP_ARGS[0], count: GP_PARAM_COUNT},
    callee_saved:               target_model.RegFile{regs: ?CALLEE_SAVED[0], count: CALLEE_SAVED_COUNT},
    stack_align:                STACK_ALIGN,
    red_zone:                   RED_ZONE,
    shadow_space:               SHADOW_SPACE::u32,
    indirect_result_reg:        REG_RCX,
    indirect_result_in_argfile: true,
    # xmm6-xmm15 keep their low 128 bits, and not the upper half of a ymm register
    fp_callee_saved_bytes: 16,
    float_arg_bits:        64,
    arg_slot_granularity:  EIGHTBYTE,
    va_model:              ?VA_MODEL,
    # MSVC has no half type. clang passes `_Float16` as a float, in the xmm
    # register of its positional slot, and returns it in xmm0
    half: abi.HALF_FLOAT,
};
