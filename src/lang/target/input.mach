# link inputs: how a link token names a file for a target, and what kind of
# input that file is. each object format declares how its inputs are named and
# recognizes their bytes, so a token is resolved here without knowing a format
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.process.env;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use types_path: std.types.path;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_copy;
use std.types.string.str_empty;
use std.types.string.str_join;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.target.binding;
use mach.lang.target.members;
use target_of: mach.lang.target.of;
use mach.lang.target.of.ar;

pub def Kind: u8;

pub val STATIC: Kind = 0;

pub val DYNAMIC: Kind = 1;

# a resolved link input: a static file the link reads, or a shared library the
# loader finds by `text` (its loader name), through `rpath` when that is not empty
pub rec Input {
    kind:               Kind;
    text:               str;
    library:            str;
    rpath:              str;
    include_referenced: bool;
}

val PATH_CAP: usize = 4096;

# whether a token names a file by path rather than a library by name: it holds
# a separator, or it ends the way a registered object format names an input
pub fun token_is_path(tok: *u8) bool {
    if (tok == nil || str_empty(tok::str))  { ret false; }
    if (types_path.has_separator(tok::str)) { ret true; }
    var i: u32 = 0;
    for (i < members.FORMAT_COUNT) {
        val vt: *target_of.OfVTable = members.FORMATS[i];
        if (static_names(vt.inputs, tok) || shared_names(vt, tok)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun static_names(naming: *target_of.InputNaming, tok: *u8) bool {
    if (naming == nil) { ret false; }
    val n: usize = str_len(tok::str);
    var i: u32   = 0;
    for (i < naming.static_suffix_count) {
        val suffix: str   = naming.static_suffixes[i];
        val sl:     usize = str_len(suffix);
        if (n > sl && tok[n - sl - 1] == '.' && target_of.path_has_suffix(tok, suffix, naming.folds_case)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun shared_names(vt: *target_of.OfVTable, tok: *u8) bool {
    ret vt.inputs != nil && vt.inputs.shared != nil && vt.inputs.shared.names(tok);
}

# the registered format whose shared library a path names, nil when none
fun shared_format(tok: *u8) *target_of.OfVTable {
    var i: u32 = 0;
    for (i < members.FORMAT_COUNT) {
        if (shared_names(members.FORMATS[i], tok)) { ret members.FORMATS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the input a link token names for the target: a path is read as written, or
# from `root` when it is relative and not found as written; a bare name is
# searched for as a static input on `dirs` and the working directory, then as
# a shared library on `dirs` and the system's library directories
pub fun token_resolve(a: *A.Allocator, tgt: *binding.Binding, dirs: *Vector[str],
    root: str, tok: *u8) res[Input, fail.Fail] {
    val claimant: *target_of.OfVTable = shared_format(tok);
    if (claimant != nil) { ret shared_path_resolve(a, tgt, claimant, root, tok); }

    if (tgt.of == nil || tgt.of.inputs == nil) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_FORMAT,
            "'{}' cannot be linked: the target's object format takes no link inputs", tok::str)};
    }
    val naming:   *target_of.InputNaming = tgt.of.inputs;
    var buf:      [PATH_CAP]u8;
    val by_path:  bool                   = token_is_path(tok);
    var searched: res[bool, fail.Fail]   = res[bool, fail.Fail].ok{false};
    if (by_path)          { searched = path_locate(a, tok, root, ?buf[0]); }
    or                    { searched = static_search(a, naming, dirs, tok, ?buf[0]); }
    if (sel searched.err) { ret res[Input, fail.Fail].err{searched.err}; }
    val found: bool = searched.ok;
    if (!by_path && !found && naming.shared != nil && naming.shared.candidate != nil) {
        val shared: res[opt[Input], fail.Fail] = shared_search(a, tgt, naming.shared, dirs, tok);
        if (sel shared.err)     { ret res[Input, fail.Fail].err{shared.err}; }
        if (sel shared.ok.some) { ret res[Input, fail.Fail].ok{shared.ok.some}; }
    }
    if (!found) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_NOT_FOUND, "cannot find link input '{}'", tok::str)};
    }

    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, ?buf[0]);
    if (sel read.err) { ret res[Input, fail.Fail].err{unreadable(a, ?buf[0], read.err)}; }
    var bytes: Vector[u8] = read.ok;
    var valid: bool       = ar.is_archive(bytes.data, bytes.len);
    if (!valid && naming.object_matches != nil) { valid = naming.object_matches(bytes.data, bytes.len, tgt.target.arch_id); }
    collections_vector.dnit[u8](?bytes);
    if (!valid) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_INVALID,
            "'{}' is not a valid object or archive for the selected target", (?buf[0])::str)};
    }
    val copied: res[str, types_string.StrError] = str_copy(a, ?buf[0]);
    if (sel copied.err) { ret res[Input, fail.Fail].err{fail.str_refused(copied.err)}; }
    var input: Input;
    input.kind    = STATIC;
    input.text    = copied.ok;
    input.library = "";
    input.rpath   = "";
    ret res[Input, fail.Fail].ok{input};
}

# a path that names a shared library of the format `vt`
fun shared_path_resolve(a: *A.Allocator, tgt: *binding.Binding, vt: *target_of.OfVTable,
    root: str, tok: *u8) res[Input, fail.Fail] {
    val shared: *target_of.SharedNaming = vt.inputs.shared;
    if (tgt.of == nil || tgt.of.id != vt.id) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_FORMAT,
            "'{}' is {}; {} inputs require {}", tok::str, shared.noun, vt.shared_input_ext, shared.requires)};
    }
    var buf:     [PATH_CAP]u8;
    val located: res[bool, fail.Fail] = path_locate(a, tok, root, ?buf[0]);
    if (sel located.err) { ret res[Input, fail.Fail].err{located.err}; }
    if (located.ok) {
        var name:       [PATH_CAP]u8;
        val identified: res[bool, fail.Fail] = shared_identify(a, shared, tgt.target.arch_id, ?buf[0], ?name[0]);
        if (sel identified.err) { ret res[Input, fail.Fail].err{identified.err}; }
        if (!identified.ok) {
            ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_INVALID,
                "'{}' is not a loadable {} for the selected architecture", (?buf[0])::str, shared.loadable)};
        }
        ret dynamic(a, ?name[0], ?buf[0], shared.runtime_prefix);
    }
    if (shared.absent == target_of.ABSENT_BY_NAME) {
        ret dynamic(a, types_path.filename(tok::str)::*u8, nil, "");
    }
    if (shared.absent == target_of.ABSENT_BY_PATH) {
        if (!str_empty(shared.runtime_prefix) && str_starts_with(tok::str, shared.runtime_prefix)) {
            ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_RPATH_UNRESOLVED,
                "a shared library input under '{}' must resolve to an existing file so its runtime search path can be retained",
                shared.runtime_prefix)};
        }
        ret dynamic(a, tok, nil, "");
    }
    ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_NOT_FOUND, "cannot find link input '{}'", tok::str)};
}

# whether the file `path` is a shared library of the kind for the instruction
# set, its loader name written to `name` when it is
fun shared_identify(a: *A.Allocator, shared: *target_of.SharedNaming, arch_id: u32,
    path: *u8, name: *u8) res[bool, fail.Fail] {
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(a, path);
    if (sel read.err) { ret res[bool, fail.Fail].err{unreadable(a, path, read.err)}; }
    var bytes: Vector[u8] = read.ok;
    name[0] = 0;
    val ok: bool = shared.identity(bytes.data, bytes.len, arch_id, path, name, PATH_CAP);
    collections_vector.dnit[u8](?bytes);
    ret res[bool, fail.Fail].ok{ok};
}

# whether the file a path token names exists, as written or under `root` when
# relative, its path written to `buf`
fun path_locate(a: *A.Allocator, tok: *u8, root: str, buf: *u8) res[bool, fail.Fail] {
    var parts:   [1]str               = [1]str{tok::str};
    val written: res[bool, fail.Fail] = candidate_present(a, tok, buf, nil, ?parts[0], 1);
    if (sel written.err)             { ret written; }
    if (written.ok)                  { ret written; }
    if (types_path.is_abs(tok::str)) { ret written; }
    val joined: res[str, A.Error] = types_path.join(a, root, tok::str);
    if (sel joined.err) { ret res[bool, fail.Fail].err{fail.refused(joined.err)}; }
    parts[0] = joined.ok;
    ret candidate_present(a, tok, buf, nil, ?parts[0], 1);
}

# whether a static input a bare name finds on `dirs` and then the working
# directory: each suffix the format searches, with the library prefix and then
# without, its path written to `buf`
fun static_search(a: *A.Allocator, naming: *target_of.InputNaming, dirs: *Vector[str], name: *u8, buf: *u8) res[bool, fail.Fail] {
    var i: usize = 0;
    for (i <= dirs.len) {
        var dir: *u8 = nil;
        if (i < dirs.len) { dir = dirs.data[i]::*u8; }
        var s: u32 = 0;
        for (s < naming.static_suffix_count) {
            var prefixed: [4]str               = [4]str{naming.library_prefix, name::str, ".", naming.static_suffixes[s]};
            val with:     res[bool, fail.Fail] = candidate_present(a, name, buf, dir, ?prefixed[0], 4);
            if (sel with.err) { ret with; }
            if (with.ok)      { ret with; }
            val bare: res[bool, fail.Fail] = candidate_present(a, name, buf, dir, ?prefixed[1], 3);
            if (sel bare.err) { ret bare; }
            if (bare.ok)      { ret bare; }
            s = s + 1;
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

# whether `dir` and the concatenated `parts`, written to `buf`, name a file; a
# path longer than a link input's path can be is refused, naming the input `tok`
fun candidate_present(a: *A.Allocator, tok: *u8, buf: *u8, dir: *u8, parts: *str, count: u32) res[bool, fail.Fail] {
    if (!target_of.path_write(buf, PATH_CAP, dir, parts, count)) {
        ret res[bool, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_NOT_FOUND,
            "a path searched for link input '{}' is longer than {} bytes", tok::str, PATH_CAP)};
    }
    ret file_present(a, buf);
}

# the shared library a bare name finds on `dirs` and then the system's library
# directories, none when no candidate is a loadable library for the target
fun shared_search(a: *A.Allocator, tgt: *binding.Binding, shared: *target_of.SharedNaming,
    dirs: *Vector[str], name: *u8) res[opt[Input], fail.Fail] {
    var i: usize = 0;
    for (i < dirs.len) {
        val found: res[opt[Input], fail.Fail] = shared_search_in(a, tgt, shared, dirs.data[i]::*u8, name);
        if (sel found.err)     { ret found; }
        if (sel found.ok.some) { ret found; }
        i = i + 1;
    }
    var li: u32 = 0;
    for (li < tgt.target.fs_policy.libdir_len) {
        val dir: str = tgt.target.fs_policy.libdirs[li];
        if (!str_empty(dir)) {
            val found: res[opt[Input], fail.Fail] = shared_search_in(a, tgt, shared, dir::*u8, name);
            if (sel found.err)     { ret found; }
            if (sel found.ok.some) { ret found; }
        }
        li = li + 1;
    }
    ret res[opt[Input], fail.Fail].ok{opt[Input].none{}};
}

fun shared_search_in(a: *A.Allocator, tgt: *binding.Binding, shared: *target_of.SharedNaming,
    dir: *u8, name: *u8) res[opt[Input], fail.Fail] {
    var candidate: [PATH_CAP]u8;
    var index:     u32 = 0;
    for (shared.candidate(dir, name, index, ?candidate[0], PATH_CAP)) {
        index = index + 1;
        val present: res[bool, fail.Fail] = file_present(a, ?candidate[0]);
        if (sel present.err) { ret res[opt[Input], fail.Fail].err{present.err}; }
        if (!present.ok)     { cnt; }
        var loader:     [PATH_CAP]u8;
        val identified: res[bool, fail.Fail] = shared_identify(a, shared, tgt.target.arch_id, ?candidate[0], ?loader[0]);
        if (sel identified.err) { ret res[opt[Input], fail.Fail].err{identified.err}; }
        if (!identified.ok)     { cnt; }
        val made: res[Input, fail.Fail] = dynamic(a, ?loader[0], ?candidate[0], shared.runtime_prefix);
        if (sel made.err) { ret res[opt[Input], fail.Fail].err{made.err}; }
        ret res[opt[Input], fail.Fail].ok{opt[Input].some{made.ok}};
    }
    ret res[opt[Input], fail.Fail].ok{opt[Input].none{}};
}

# a shared library input named `name`; a name under `runtime_prefix` records
# the runtime search path that finds it as the file `found`
fun dynamic(a: *A.Allocator, name: *u8, found: *u8, runtime_prefix: str) res[Input, fail.Fail] {
    val copied: res[str, types_string.StrError] = str_copy(a, name);
    if (sel copied.err) { ret res[Input, fail.Fail].err{fail.str_refused(copied.err)}; }
    var input: Input;
    input.kind    = DYNAMIC;
    input.text    = copied.ok;
    input.library = "";
    input.rpath   = "";
    if (found != nil && !str_empty(runtime_prefix) && str_starts_with(name::str, runtime_prefix)) {
        val rpath: res[str, fail.Fail] = runtime_path(a, found, name, runtime_prefix);
        if (sel rpath.err) { ret res[Input, fail.Fail].err{rpath.err}; }
        input.rpath = rpath.ok;
    }
    ret res[Input, fail.Fail].ok{input};
}

# the directory a loader searches to find `found` by the part of its loader
# name after `prefix`: its parent for a bare file name, else the path less that
# suffix, which must end it
fun runtime_path(a: *A.Allocator, found: *u8, name: *u8, prefix: str) res[str, fail.Fail] {
    val abs_r: res[str, fail.Fail] = absolute(a, found::str);
    if (sel abs_r.err) { ret abs_r; }
    val abs:    str = abs_r.ok;
    val suffix: str = (name::usize + str_len(prefix))::str;
    if (!str_contains(suffix, "/")) {
        val parent_r: res[types_path.Path, A.Error] = types_path.parent(a, abs);
        if (sel parent_r.err) { ret res[str, fail.Fail].err{fail.refused(parent_r.err)}; }
        ret res[str, fail.Fail].ok{parent_r.ok};
    }
    val abs_len:    usize = str_len(abs);
    val suffix_len: usize = str_len(suffix);
    if (suffix_len == 0 || suffix[0] == '/' || abs_len <= suffix_len
        || !separated_suffix(abs, suffix) || !types_path.is_separator(abs[abs_len - suffix_len - 1])) {
        ret res[str, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_RPATH_MISMATCH,
            "the selected library path does not match its loader name's suffix after '{}'", prefix)};
    }
    var cut: usize = abs_len - suffix_len;
    if (cut > 1) { cut = cut - 1; }
    (abs::*u8)[cut] = 0;
    ret res[str, fail.Fail].ok{abs};
}

# whether `abs` ends in `suffix`; a loader name separates with '/', while `abs`
# was resolved through the host's own separators
fun separated_suffix(abs: str, suffix: str) bool {
    val abs_len:    usize = str_len(abs);
    val suffix_len: usize = str_len(suffix);
    if (suffix_len > abs_len) { ret false; }
    val at: usize = abs_len - suffix_len;
    var i:  usize = 0;
    for (i < suffix_len) {
        val have: u8 = abs[at + i];
        val want: u8 = suffix[i];
        if (have != want && !(types_path.is_separator(have) && types_path.is_separator(want))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun absolute(a: *A.Allocator, p: str) res[str, fail.Fail] {
    if (types_path.is_abs(p)) {
        val clone_r: res[types_path.Path, A.Error] = types_path.clone(a, p);
        if (sel clone_r.err) { ret res[str, fail.Fail].err{fail.refused(clone_r.err)}; }
        ret res[str, fail.Fail].ok{clone_r.ok};
    }
    val cwd_r: res[types_string.OwnedString, env.EnvError] = env.current_dir(a);
    if (sel cwd_r.err) { ret res[str, fail.Fail].err{fail.user(diagnostic_kind.FS_CURRENT_DIR, fail.env_text(cwd_r.err))}; }
    var cwd:       types_string.OwnedString      = cwd_r.ok;
    val resolve_r: res[types_path.Path, A.Error] = types_path.resolve(a, cwd.data, p);
    types_string.owned_release(?cwd);
    if (sel resolve_r.err) { ret res[str, fail.Fail].err{fail.refused(resolve_r.err)}; }
    ret res[str, fail.Fail].ok{resolve_r.ok};
}

# a system framework, which the loader finds by its install path
pub fun framework_resolve(a: *A.Allocator, tgt: *binding.Binding, name: *u8) res[Input, fail.Fail] {
    if (tgt.os == nil || str_empty(tgt.os.framework_root)) {
        ret res[Input, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_FORMAT,
            "framework link input '{}' requires a target whose system installs frameworks", name::str)};
    }
    val joined: res[str, types_string.StrError] = str_join(a, tgt.os.framework_root, "/", name::str, ".framework/", name::str);
    if (sel joined.err) { ret res[Input, fail.Fail].err{fail.str_refused(joined.err)}; }
    var input: Input;
    input.kind    = DYNAMIC;
    input.text    = joined.ok;
    input.library = "";
    input.rpath   = "";
    ret res[Input, fail.Fail].ok{input};
}

# whether `p` names a regular file; a query the system refuses, other than for
# a path that does not exist, is a failure
fun file_present(a: *A.Allocator, p: *u8) res[bool, fail.Fail] {
    val r: res[bool, io_error.Error] = fs.is_file(p);
    if (sel r.err) {
        ret res[bool, fail.Fail].err{fail.formatted_user(a, diagnostic_kind.LINK_INPUT_UNREADABLE,
            "cannot inspect link input '{}': {}", p::str, fail.io_text(r.err))};
    }
    ret res[bool, fail.Fail].ok{r.ok};
}

fun unreadable(a: *A.Allocator, path: *u8, e: fs.FsError) fail.Fail {
    if (sel e.alloc) { ret fail.refused(e.alloc); }
    ret fail.formatted_user(a, diagnostic_kind.LINK_INPUT_UNREADABLE, "cannot read link input '{}'", path::str);
}
