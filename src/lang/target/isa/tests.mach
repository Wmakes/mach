# the exit code of a test that could not read what it checks
#[testing]
val HARNESS_FAILED: i32 = 1;

#[testing]
pub fun str_slice(alloc: *A.Allocator, text: str, at: usize, len: usize) res[str, fail.Fail] {
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, len + 1);
    if (sel rb.err) { ret res[str, fail.Fail].err{fail.message("out of memory copying a name")}; }
    val buf: *u8   = rb.ok;
    var i:   usize = 0;
    for (i < len) {
        buf[i] = text[at + i]::u8;
        i      = i + 1;
    }
    buf[len] = 0;
    ret res[str, fail.Fail].ok{buf::str};
}

#[testing]
pub fun join_path(alloc: *A.Allocator, dir: str, name: str) res[str, fail.Fail] {
    val joined: res[str, A.Error] = types_path.join(alloc, dir, name);
    if (sel joined.err) { ret res[str, fail.Fail].err{fail.refused(joined.err)}; }
    ret res[str, fail.Fail].ok{joined.ok};
}

# a filesystem predicate that cannot be asked answers no
#[testing]
pub fun probe(r: res[bool, io_error.Error]) bool {
    if (sel r.ok) { ret r.ok; }
    ret false;
}

#[testing]
pub fun find_root(alloc: *A.Allocator) opt[str] {
    var prefix: str   = ".";
    var depth:  usize = 0;
    for (depth < 8) {
        val rj: res[str, fail.Fail] = join_path(alloc, prefix, "src/lang/target/isa.mach");
        if (sel rj.err)               { ret opt[str].none{}; }
        if (probe(fs.is_file(rj.ok))) { ret opt[str].some{prefix}; }

        val ru: res[str, fail.Fail] = join_path(alloc, prefix, "..");
        if (sel ru.err) { ret opt[str].none{}; }
        prefix = ru.ok;
        depth  = depth + 1;
    }
    ret opt[str].none{};
}

# the names between backticks on one markdown table row from `at`, each looked
# up as a row of `table`; the bits of the row, or none when a name is not a row
# or the line holds no name. `at` lands on the row's first `|`
#[testing]
fun doc_row_bits(text: str, at: usize, table: *extension.Table) opt[u64] {
    var bits: u64   = 0;
    var seen: bool  = false;
    var p:    usize = at;
    val n:    usize = str_len(text);
    for (p < n && text[p] != '\n') {
        if (text[p] == '`') {
            val start: usize = p + 1;
            var e:     usize = start;
            for (e < n && text[e] != '`' && text[e] != '\n') { e = e + 1; }
            if (e >= n || text[e] != '`') { ret opt[u64].none{}; }
            val bit: u64 = extension.bit_of(table, (?text[start])::str, e - start);
            if (bit == 0) { ret opt[u64].none{}; }
            bits = bits | bit;
            seen = true;
            p    = e + 1;
        }
        or { p = p + 1; }
    }
    if (!seen) { ret opt[u64].none{}; }
    ret opt[u64].some{bits};
}

# the offset just past the first occurrence of `needle` at or after `from`, or n when absent
#[testing]
fun doc_find(text: str, from: usize, needle: str) usize {
    val n:  usize = str_len(text);
    val nl: usize = str_len(needle);
    var p:  usize = from;
    for (p + nl <= n) {
        if (str_region_equals(text, p, nl, needle)) { ret p + nl; }
        p = p + 1;
    }
    ret n;
}

# doc/language/manifest.md carries the x86-64 level table, the compiler's table
# spelled through the names, and drift between them fails here
test manifest_doc__levels_match_the_compiler_table {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rr: opt[str] = find_root(?alloc);
    if (!sel rr.some) {
        print.eprintln("levels: cannot locate the source root from the working directory");
        ret HARNESS_FAILED;
    }
    val rj: res[str, fail.Fail] = join_path(?alloc, rr.some, "doc/language/manifest.md");
    if (sel rj.err) { ret HARNESS_FAILED; }
    val rt: res[str, fs.FsError] = fs.read_string(?alloc, rj.ok);
    if (sel rt.err) {
        print.eprintln("levels: cannot read doc/language/manifest.md");
        ret HARNESS_FAILED;
    }
    val text: str   = rt.ok;
    val n:    usize = str_len(text);

    # each level row lists the members beyond the level before it, in table order
    var at:    usize = doc_find(text, 0, "#### Levels");
    var below: u64   = 0;
    var i:     u32   = 0;
    for (i < extension_x64.TABLE.catalog.level_count) {
        val name:    str   = extension_x64.TABLE.catalog.levels[i].name;
        val members: u64   = extension_x64.level(name);
        var needle:  [32]u8;
        var o:       usize = 0;
        needle[o] = '|'::u8;
        o         = o + 1;
        needle[o] = ' '::u8;
        o         = o + 1;
        needle[o] = '`'::u8;
        o         = o + 1;
        var k: usize = 0;
        for (k < str_len(name)) {
            needle[o] = name[k]::u8;
            o         = o + 1;
            k         = k + 1;
        }
        needle[o] = '`'::u8;
        o         = o + 1;
        needle[o] = ' '::u8;
        o         = o + 1;
        needle[o] = '|'::u8;
        o         = o + 1;
        needle[o] = 0;
        val row: usize = doc_find(text, at, (?needle[0])::str);
        if (row >= n) {
            print.eprintlnf("levels: manifest.md has no row for {}", name);
            ret 3;
        }
        val add: opt[u64] = doc_row_bits(text, row, ?extension_x64.TABLE);
        if (!sel add.some) {
            print.eprintlnf("levels: the {} row names something that is not an x86_64 extension", name);
            ret 4;
        }
        if ((add.some & below) != 0 || (below | add.some) != members) {
            print.eprintlnf("levels: {} in manifest.md is {} but masc's x86 catalog has {}", name, x64_bits_text(below | add.some), x64_bits_text(members));
            ret 5;
        }
        below = members;
        at    = row;
        i     = i + 1;
    }
    ret 0;
}

# the x86-64 extension names in `bits`, for a failing test's report
#[testing]
fun x64_bits_text(bits: u64) str {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret "(the names could not be spelled: no allocator)"; }
    var b:     textbuild.TextBuilder = textbuild.tb_init(?a);
    val names: res[str, fail.Fail]   = target_model.spelling_finish(?b, extension.bits_append(?b, ?extension_x64.TABLE, bits));
    if (sel names.err) { ret fail.describe(names.err); }
    ret names.ok;
}

# the x86-64 table reads masc's x86 catalog: every row is the catalog row of its
# name, the levels are the catalog's, each strictly grows the one before, and
# closing a level over what its members imply adds nothing
test x64_levels__closed_bundles_of_the_catalog {
    val t: *extension.Table = ?extension_x64.TABLE;
    if (!extension.table_valid(t)) { ret 1; }
    var i: u32 = 0;
    for (i < t.count) {
        val name: str = extension.row_name(t, i);
        if (extension.row_of(t, name, str_len(name)) != ?t.rows[i]) { ret 2; }
        i = i + 1;
    }
    val v2: u64 = extension_x64.level("x86-64-v2");
    val v3: u64 = extension_x64.level("x86-64-v3");
    val v4: u64 = extension_x64.level("x86-64-v4");
    if (extension.close(t, v2) != v2 || extension.close(t, v3) != v3 || extension.close(t, v4) != v4)                        { ret 3; }
    if (v2 != (extension_x64.SSSE3 | extension_x64.SSE41 | extension_x64.SSE42 | extension_x64.POPCNT | extension_x64.CX16)) { ret 4; }
    if ((v3 & v2) != v2 || (v3 & extension_x64.AVX2) == 0 || (v3 & extension_x64.AVX512F) != 0)                              { ret 5; }
    if ((v4 & v3) != v3 || (v4 & extension_x64.AVX512VL) == 0)                                                               { ret 6; }
    if (extension_x64.level("x86-64-v5") != 0 || extension_x64.level("sse41") != 0)                                          { ret 7; }
    ret 0;
}

# the extent of the markdown table cell that starts at `at` (just past a `|`):
# its first non-blank offset and its length without trailing blanks. `at` is
# left just past the cell's closing `|`, or at n when the line has none
#[testing]
fun doc_cell(text: str, at: *usize, start: *usize, len: *usize) bool {
    val n: usize = str_len(text);
    var p: usize = @at;
    for (p < n && text[p] == ' ') { p = p + 1; }
    @start = p;
    for (p < n && text[p] != '|' && text[p] != '\n') { p = p + 1; }
    if (p >= n || text[p] != '|') { ret false; }
    var e: usize = p;
    for (e > @start && text[e - 1] == ' ') { e = e - 1; }
    @len = e - @start;
    @at  = p + 1;
    ret true;
}

# the widths a table cell spells (`8, 16, 32, 64`) as a mask of the catalog's
# width slots, none when a number is not a multiply width
#[testing]
fun doc_widths(text: str, start: usize, len: usize) opt[u64] {
    var mask: u64   = 0;
    var p:    usize = start;
    val end:  usize = start + len;
    for (p < end) {
        if (text[p] >= '0' && text[p] <= '9') {
            var v: u64 = 0;
            for (p < end && text[p] >= '0' && text[p] <= '9') {
                v = v * 10 + (text[p]::u64 - '0'::u64);
                p = p + 1;
            }
            if (v > 255 || !ct.mul_width_valid(v::u8)) { ret opt[u64].none{}; }
            mask = mask | (1::u64 << (v / 8));
        }
        or { p = p + 1; }
    }
    ret opt[u64].some{mask};
}

# the names between backticks in a table cell, each a row of the isa's
# extension vocabulary; none when a name is not one or the cell names nothing
#[testing]
fun doc_ext_bits(text: str, start: usize, len: usize, m: *target_model.Machine) opt[u64] {
    var bits: u64   = 0;
    var seen: bool  = false;
    var p:    usize = start;
    val end:  usize = start + len;
    for (p < end) {
        if (text[p] == '`') {
            val ns: usize = p + 1;
            var e:  usize = ns;
            for (e < end && text[e] != '`') { e = e + 1; }
            if (e >= end) { ret opt[u64].none{}; }
            val bit: u64 = extension.bit_of(m.extension_table, (?text[ns])::str, e - ns);
            if (bit == 0) { ret opt[u64].none{}; }
            bits = bits | bit;
            seen = true;
            p    = e + 1;
        }
        or { p = p + 1; }
    }
    if (!seen) { ret opt[u64].none{}; }
    ret opt[u64].some{bits};
}

# the row needle `| \`<isa>\` | <op> |` into `buf`, `op` spelled as given
#[testing]
fun doc_mul_needle(buf: *u8, arch: str, op: str) str {
    var o: usize = 0;
    buf[o] = '|'::u8;
    o      = o + 1;
    buf[o] = ' '::u8;
    o      = o + 1;
    buf[o] = '`'::u8;
    o      = o + 1;
    var k: usize = 0;
    for (k < str_len(arch)) {
        buf[o] = arch[k]::u8;
        o      = o + 1;
        k      = k + 1;
    }
    buf[o] = '`'::u8;
    o      = o + 1;
    buf[o] = ' '::u8;
    o      = o + 1;
    buf[o] = '|'::u8;
    o      = o + 1;
    buf[o] = ' '::u8;
    o      = o + 1;
    k      = 0;
    for (k < str_len(op)) {
        buf[o] = op[k]::u8;
        o      = o + 1;
        k      = k + 1;
    }
    buf[o] = ' '::u8;
    o      = o + 1;
    buf[o] = '|'::u8;
    o      = o + 1;
    buf[o] = 0;
    ret buf::str;
}

# one instruction set's lines of the secrecy.md multiply table against its
# registered rows: every multiply with declared scalar rows has one line
# spelling exactly those widths and their one condition, a multiply without
# rows has no line, and an isa without rows has the `none` line. `at` and
# `end` bound the table's text. 0 when they agree
#[testing]
fun doc_mul_isa(text: str, at: usize, end: usize, arch: str, m: *target_model.Machine) i32 {
    var needle: [64]u8;
    if (m.ct_mul_form_len == 0) {
        val row: usize = doc_find(text, at, doc_mul_needle(?needle[0], arch, "none"));
        if (row >= end) {
            print.eprintlnf("ct_mul: secrecy.md has no `none` line for {}, which declares no rows", arch);
            ret 1;
        }
        ret 0;
    }
    var op: u32 = 1;
    for (op < ct.CT_MUL_OP_COUNT) {
        val name: opt[str] = ct.mul_op_name(op::ct.CtMulOp);
        if (sel name.none) { ret HARNESS_FAILED; }
        var widths: u64          = 0;
        var cond:   ct.CtMulCond = ct.CT_MUL_ALWAYS;
        var ext:    u64          = 0;
        var first:  bool         = true;
        var i:      u32          = 0;
        for (i < m.ct_mul_form_len) {
            val row: *ct.CtMulForm = ?m.ct_mul_forms[i];
            if (row.op == op::ct.CtMulOp && row.lanes == 0) {
                if (!first && (row.cond != cond || row.ext != ext)) {
                    print.eprintlnf("ct_mul: {} declares `{}` under two conditions, which the table cannot spell", arch, name.some);
                    ret 2;
                }
                widths = widths | (1::u64 << (row.width::u64 / 8));
                cond   = row.cond;
                ext    = row.ext;
                first  = false;
            }
            i = i + 1;
        }
        var opq: [16]u8;
        var o:   usize = 0;
        opq[o] = '`'::u8;
        o      = o + 1;
        var k: usize = 0;
        for (k < str_len(name.some)) {
            opq[o] = name.some[k]::u8;
            o      = o + 1;
            k      = k + 1;
        }
        opq[o] = '`'::u8;
        o      = o + 1;
        opq[o] = 0;
        var row_at: usize = doc_find(text, at, doc_mul_needle(?needle[0], arch, (?opq[0])::str));
        if (widths == 0) {
            if (row_at < end) {
                print.eprintlnf("ct_mul: secrecy.md lists `{}` for {}, which declares no such row", name.some, arch);
                ret 3;
            }
            op = op + 1;
            cnt;
        }
        if (row_at >= end) {
            print.eprintlnf("ct_mul: secrecy.md has no `{}` line for {}", name.some, arch);
            ret 4;
        }
        var ws: usize = 0;
        var wl: usize = 0;
        var cs: usize = 0;
        var cl: usize = 0;
        if (!doc_cell(text, ?row_at, ?ws, ?wl) || !doc_cell(text, ?row_at, ?cs, ?cl)) {
            print.eprintlnf("ct_mul: the {} `{}` line has no widths and condition cells", arch, name.some);
            ret 5;
        }
        val doc_w:      opt[u64] = doc_widths(text, ws, wl);
        var doc_w_bits: u64      = 0;
        if (sel doc_w.some) { doc_w_bits = doc_w.some; }
        if (sel doc_w.none || doc_w_bits != widths) {
            print.eprintlnf("ct_mul: the {} `{}` line does not spell the registered widths", arch, name.some);
            ret 6;
        }
        var doc_cond: ct.CtMulCond = ct.CT_MUL_EXTENSION;
        var doc_ext:  u64          = 0;
        if (str_region_equals(text, cs, cl, "always"))        { doc_cond = ct.CT_MUL_ALWAYS; }
        or (str_region_equals(text, cs, cl, "PSTATE.DIT on")) { doc_cond = ct.CT_MUL_DIT_MODE; }
        or {
            val bits: opt[u64] = doc_ext_bits(text, cs, cl, m);
            if (sel bits.none) {
                print.eprintlnf("ct_mul: the {} `{}` condition names something outside `always`, `PSTATE.DIT on` and the isa's extensions", arch, name.some);
                ret 7;
            }
            doc_ext = bits.some;
        }
        if (doc_cond != cond || doc_ext != ext) {
            print.eprintlnf("ct_mul: the {} `{}` line does not spell the registered condition", arch, name.some);
            ret 8;
        }
        op = op + 1;
    }
    ret 0;
}

# doc/language/secrecy.md carries the constant-time multiply table: one line
# per instruction set and multiply naming the declared widths and the
# condition they hold under. It is the registered catalog spelled through the
# names, and drift between them fails here
test secrecy_doc__multiply_table_matches_the_registered_rows {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rr: opt[str] = find_root(?alloc);
    if (!sel rr.some) {
        print.eprintln("ct_mul: cannot locate the source root from the working directory");
        ret HARNESS_FAILED;
    }
    val rj: res[str, fail.Fail] = join_path(?alloc, rr.some, "doc/language/secrecy.md");
    if (sel rj.err) { ret HARNESS_FAILED; }
    val rt: res[str, fs.FsError] = fs.read_string(?alloc, rj.ok);
    if (sel rt.err) {
        print.eprintln("ct_mul: cannot read doc/language/secrecy.md");
        ret HARNESS_FAILED;
    }
    val text: str   = rt.ok;
    val n:    usize = str_len(text);
    val at:   usize = doc_find(text, 0, "| Instruction set | Multiply | Widths | Condition |");
    if (at >= n) {
        print.eprintln("ct_mul: secrecy.md has no constant-time multiply table");
        ret 1;
    }
    val end: usize = doc_find(text, at, "\n\n");

    val archs: [5]u32 = [5]u32{catalog_arch.X86_64, catalog_arch.AARCH64, catalog_arch.RISCV64, catalog_arch.RISCV32, catalog_arch.SPIRV};
    var ai:    usize  = 0;
    for (ai < 5) {
        val name: str = catalog_arch.name_for(archs[ai]);
        val bad:  i32 = doc_mul_isa(text, at, end, name, vtable_of(archs[ai]).model);
        if (bad != 0) { ret 10 + bad; }
        ai = ai + 1;
    }
    ret 0;
}

# the scalar f16 cells a model realizes natively, as a mask over the cells in
# the order half_cell_mask walks them: + - * / and compare, the binary32 and
# binary64 widenings and narrowings, then each integer conversion at 8, 16, 32
# and 64 bits (to signed, to unsigned, from signed, from unsigned)
#[testing]
fun half_cell_mask(m: *target_model.Machine) u64 {
    var mask:  u64                   = 0;
    var bit:   u64                   = 1;
    val arith: [5]target_model.VecOp = [5]target_model.VecOp{target_model.VEC_OP_ADD, target_model.VEC_OP_SUB, target_model.VEC_OP_MUL, target_model.VEC_OP_DIV, target_model.VEC_OP_CMP};
    var i:     u32                   = 0;
    for (i < 5) {
        if (target_model.half_native(m, arith[i], true, 16, 16)) { mask = mask | bit; }
        bit = bit << 1;
        i   = i + 1;
    }
    if (target_model.half_native(m, target_model.VEC_OP_FP_EXT, true, 32, 16)) { mask = mask | bit; }
    bit = bit << 1;
    if (target_model.half_native(m, target_model.VEC_OP_FP_EXT, true, 64, 16)) { mask = mask | bit; }
    bit = bit << 1;
    if (target_model.half_native(m, target_model.VEC_OP_FP_TRUNC, true, 16, 32)) { mask = mask | bit; }
    bit = bit << 1;
    if (target_model.half_native(m, target_model.VEC_OP_FP_TRUNC, true, 16, 64)) { mask = mask | bit; }
    bit = bit << 1;
    val widths: [4]u32 = [4]u32{8, 16, 32, 64};
    var w:      u32    = 0;
    for (w < 4) {
        if (target_model.half_native(m, target_model.VEC_OP_FP_TO_SI, false, widths[w], 16)) { mask = mask | bit; }
        if (target_model.half_native(m, target_model.VEC_OP_FP_TO_UI, false, widths[w], 16)) { mask = mask | (bit << 4); }
        if (target_model.half_native(m, target_model.VEC_OP_SI_TO_FP, true, 16, widths[w]))  { mask = mask | (bit << 8); }
        if (target_model.half_native(m, target_model.VEC_OP_UI_TO_FP, true, 16, widths[w]))  { mask = mask | (bit << 12); }
        bit = bit << 1;
        w   = w + 1;
    }
    ret mask;
}

#[testing]
fun half_cells_at(arch: u32, exts: u64) u64 {
    var m: target_model.Machine = @vtable_of(arch).model;
    m.extensions = exts;
    ret half_cell_mask(?m);
}

# every isa's scalar f16 rows are well formed and native exactly at their gate:
# below it every cell is the expansion
test half_rows__each_isa_realizes_its_cells_at_its_gate {
    val arith: u64 = 0x1F;
    val ext32: u64 = 0x20;
    val ext64: u64 = 0x40;
    val tr32:  u64 = 0x80;
    val tr64:  u64 = 0x100;
    # the 32- and 64-bit rows of each integer conversion: bits 2 and 3 of each nibble from bit 9
    val int32:  u64 = (0x4::u64 << 9) | (0x4::u64 << 13) | (0x4::u64 << 17) | (0x4::u64 << 21);
    val int64:  u64 = int32 << 1;
    val rvbase: u64 = extension_riscv.DEFAULT64;

    if (half_cells_at(catalog_arch.X86_64, 0) != 0)                                                                                                          { ret 2; }
    if (half_cells_at(catalog_arch.X86_64, extension_x64.level("x86-64-v3")) != (ext32 | tr32))                                                              { ret 3; }
    if (half_cells_at(catalog_arch.AARCH64, 0) != (ext32 | ext64 | tr32 | tr64))                                                                             { ret 4; }
    if (half_cells_at(catalog_arch.AARCH64, extension_arm64.FP16) != (arith | ext32 | ext64 | tr32 | tr64 | int32 | int64))                                  { ret 5; }
    if (half_cells_at(catalog_arch.RISCV64, rvbase) != 0)                                                                                                    { ret 6; }
    if (half_cells_at(catalog_arch.RISCV64, rvbase | extension_riscv.ZFHMIN) != (ext32 | ext64 | tr32 | tr64))                                               { ret 7; }
    if (half_cells_at(catalog_arch.RISCV64, rvbase | extension_riscv.ZFHMIN | extension_riscv.ZFH) != (arith | ext32 | ext64 | tr32 | tr64 | int32 | int64)) { ret 8; }
    if (half_cells_at(catalog_arch.RISCV32, rvbase | extension_riscv.ZFHMIN | extension_riscv.ZFH) != (arith | ext32 | ext64 | tr32 | tr64 | int32))         { ret 9; }
    # without D neither binary64 conversion is native
    if (half_cells_at(catalog_arch.RISCV32, extension_riscv.I | extension_riscv.F | extension_riscv.ZICSR | extension_riscv.ZFHMIN) != (ext32 | tr32)) { ret 12; }
    if (half_cells_at(catalog_arch.SPIRV, 0) != 0)                                                                                                     { ret 10; }
    if (half_cells_at(catalog_arch.SPIRV, extension_spirv.FLOAT16) != (arith | ext32 | ext64 | tr32 | tr64 | int32 | int64))                           { ret 11; }
    ret 0;
}

# the vector cells of f16 lanes a model packs, as a mask over + - * / and
# compare, the binary32 and binary64 widenings and narrowings, then the lane
# range and join; every other cell of f16 lanes must be declared as each
# lane's scalar operation, so a model that leaves one undeclared gives all ones
#[testing]
fun half_lane_mask(m: *target_model.Machine) u64 {
    if (!target_model.vector_domain_complete(m)) { ret 0xFFFFFFFFFFFFFFFF; }
    var mask:  u64                   = 0;
    var bit:   u64                   = 1;
    val arith: [5]target_model.VecOp = [5]target_model.VecOp{target_model.VEC_OP_ADD, target_model.VEC_OP_SUB, target_model.VEC_OP_MUL, target_model.VEC_OP_DIV, target_model.VEC_OP_CMP};
    var i:     u32                   = 0;
    for (i < 5) {
        if (target_model.vector_form(m, arith[i], true, 16, 16) == target_model.FORM_PACKED) { mask = mask | bit; }
        bit = bit << 1;
        i   = i + 1;
    }
    if (target_model.vector_form(m, target_model.VEC_OP_FP_EXT, true, 32, 16) == target_model.FORM_PACKED) { mask = mask | bit; }
    bit = bit << 1;
    if (target_model.vector_form(m, target_model.VEC_OP_FP_EXT, true, 64, 16) == target_model.FORM_PACKED) { mask = mask | bit; }
    bit = bit << 1;
    if (target_model.vector_form(m, target_model.VEC_OP_FP_TRUNC, true, 16, 32) == target_model.FORM_PACKED) { mask = mask | bit; }
    bit = bit << 1;
    if (target_model.vector_form(m, target_model.VEC_OP_FP_TRUNC, true, 16, 64) == target_model.FORM_PACKED) { mask = mask | bit; }
    bit = bit << 1;
    if (target_model.vector_form(m, target_model.VEC_OP_RANGE, true, 16, 16) == target_model.FORM_PACKED) { mask = mask | bit; }
    bit = bit << 1;
    if (target_model.vector_form(m, target_model.VEC_OP_CONCAT, true, 16, 16) == target_model.FORM_PACKED) { mask = mask | bit; }
    ret mask;
}

#[testing]
fun half_lanes_at(arch: u32, exts: u64) u64 {
    var m: target_model.Machine = @vtable_of(arch).model;
    m.extensions = exts;
    ret half_lane_mask(?m);
}

# every isa declares each vector cell of f16 lanes once and packs exactly its
# rows at their gate: below it a cell is each lane's scalar operation
test half_lanes__each_isa_packs_its_cells_at_its_gate {
    val arith:   u64 = 0x1F;
    val ext32:   u64 = 0x20;
    val tr32:    u64 = 0x80;
    val permute: u64 = 0x200 | 0x400;

    if (half_lanes_at(catalog_arch.X86_64, 0) != permute)                                                                   { ret 2; }
    if (half_lanes_at(catalog_arch.X86_64, extension_x64.level("x86-64-v3")) != (permute | ext32 | tr32))                   { ret 3; }
    if (half_lanes_at(catalog_arch.AARCH64, 0) != (permute | ext32 | tr32))                                                 { ret 4; }
    if (half_lanes_at(catalog_arch.AARCH64, extension_arm64.FP16) != (arith | permute | ext32 | tr32))                      { ret 5; }
    if (half_lanes_at(catalog_arch.RISCV64, extension_riscv.DEFAULT64 | extension_riscv.ZFHMIN | extension_riscv.ZFH) != 0) { ret 6; }
    if (half_lanes_at(catalog_arch.SPIRV, 0) != 0)                                                                          { ret 7; }
    if (half_lanes_at(catalog_arch.SPIRV, extension_spirv.FLOAT16) != arith)                                                { ret 8; }
    ret 0;
}

# each registered isa folds a symbol offset only within its +-16 MB window and a
# base-register displacement only where its encoding holds one: x86-64 alone
# bounds the displacement, at disp32, and spir-v, with no pc-relative symbol
# reference, bounds neither
test offset_folds__only_within_each_reach {
    val window: i64    = 16777216;
    val archs:  [5]u32 = [5]u32{catalog_arch.X86_64, catalog_arch.AARCH64, catalog_arch.RISCV64, catalog_arch.RISCV32, catalog_arch.SPIRV};
    var ai:     usize  = 0;
    for (ai < 5) {
        val m:       *target_model.Machine = vtable_of(archs[ai]).model;
        val bounded: bool                  = archs[ai] != catalog_arch.SPIRV;
        val disp32:  bool                  = archs[ai] == catalog_arch.X86_64;
        val code:    i32                   = 10 * (ai::i32 + 1);
        if (!target_model.sym_offset_folds(m, window - 1) || !target_model.sym_offset_folds(m, 0 - window)) { ret code + 1; }
        if (target_model.sym_offset_folds(m, window) != !bounded)                                           { ret code + 2; }
        if (target_model.sym_offset_folds(m, 0 - window - 1) != !bounded)                                   { ret code + 3; }
        if (target_model.sym_offset_folds(m, 2199999999) != !bounded)                                       { ret code + 4; }
        if (!target_model.mem_disp_folds(m, 2147483647) || !target_model.mem_disp_folds(m, 0 - 2147483648)) { ret code + 5; }
        if (target_model.mem_disp_folds(m, 2147483648) != !disp32)                                          { ret code + 6; }
        if (target_model.mem_disp_folds(m, 0 - 2147483649) != !disp32)                                      { ret code + 7; }
        ai = ai + 1;
    }
    if (!target_model.offset_fits(0, 0x7FFFFFFFFFFFFFFF) || !target_model.offset_fits(64, 0 - 0x7FFFFFFFFFFFFFFF)) { ret 60; }
    ret 0;
}

# the registered descriptor of an instruction set the catalog names
#[testing]
fun vtable_of(arch: u32) *isa.IsaVTable {
    if (arch == catalog_arch.X86_64)  { ret ?x64_register.VTABLE; }
    if (arch == catalog_arch.AARCH64) { ret ?arm64_register.VTABLE; }
    if (arch == catalog_arch.RISCV64) { ret ?riscv_register.VTABLE64; }
    if (arch == catalog_arch.RISCV32) { ret ?riscv_register.VTABLE32; }
    ret ?spirv_register.VTABLE;
}

#[testing]
fun isa_at(i: usize) str {
    val reg: *lang_target.TargetRegistry = toolchain.t_registry();
    if (i >= reg.isa.count::usize) { ret nil; }
    ret isa.name_of(reg.isa.members[i]);
}

#[testing]
fun os_at(i: usize) str {
    val reg: *lang_target.TargetRegistry = toolchain.t_registry();
    if (i >= reg.os.count::usize) { ret nil; }
    ret lang_target_os.name_of(reg.os.members[i]);
}

#[testing]
fun abi_at(i: usize) str {
    val reg: *lang_target.TargetRegistry = toolchain.t_registry();
    if (i >= reg.abi.count::usize) { ret nil; }
    ret abi.name_of(reg.abi.members[i]);
}

#[testing]
fun of_at(i: usize) str {
    val reg: *lang_target.TargetRegistry = toolchain.t_registry();
    if (i >= reg.of.count::usize) { ret nil; }
    ret target_of.name_of(reg.of.members[i]);
}

# the `i`th environment of every isa, counted across the isas in registry order
#[testing]
fun env_at(i: usize) str {
    val reg:  *lang_target.TargetRegistry = toolchain.t_registry();
    var left: usize                       = i;
    var k:    u32                         = 0;
    for (k < reg.isa.count) {
        val vt: *isa.IsaVTable = reg.isa.members[k];
        if (left < vt.environments.count::usize) { ret vt.environments.rows[left].name; }
        left = left - vt.environments.count::usize;
        k    = k + 1;
    }
    ret nil;
}

# the isa an inline `asm` block may be tagged with: one that declares an assembler
#[testing]
fun assembled_at(i: usize) str {
    val reg: *lang_target.TargetRegistry = toolchain.t_registry();
    if (i >= reg.isa.count::usize || !isa.has_assembly(reg.isa.members[i])) { ret nil; }
    ret isa.name_of(reg.isa.members[i]);
}

#[testing]
val AXIS_SPAN: usize = 64;

# the cell of the accepted-values row `axis` holds the registry's axis
#[testing]
fun axis_agrees(alloc: *A.Allocator, text: str, rows: lang_source.Span, axis: str, names: fun(usize) str) bool {
    val row: opt[lang_source.Span] = reference.row_named(text, rows, axis);
    if (sel row.none) {
        print.eprintlnf("manifest.md accepted tuple values: no row for {}", axis);
        ret false;
    }
    val values: opt[lang_source.Span] = reference.cell(text, row.some, 1);
    if (sel values.none) { ret false; }
    ret reference.agree(alloc, "manifest.md accepted tuple values", text, values.some, reference.WORDS_CODE, names, AXIS_SPAN);
}

# the extensions the code spans of `within` name, from the vocabulary of `m`;
# none when one names no extension of it or one repeats
#[testing]
fun spans_bits(text: str, within: lang_source.Span, m: *target_model.Machine) opt[u64] {
    var bits: u64   = 0;
    var at:   usize = within.offset;
    var w:    lang_source.Span;
    for (reference.code_next(text, ?at, within.offset + within.len, ?w)) {
        val bit: u64 = extension.bit_of(m.extension_table, (?text[w.offset])::str, w.len);
        if (bit == 0 || (bits & bit) != 0) { ret opt[u64].none{}; }
        bits = bits | bit;
    }
    ret opt[u64].some{bits};
}

# the row of the extension table whose isa cell names `name`
#[testing]
fun extension_row(text: str, rows: lang_source.Span, name: str) opt[lang_source.Span] {
    var at:   usize = rows.offset;
    var line: lang_source.Span;
    for (reference.row_next(text, ?at, rows.offset + rows.len, ?line)) {
        val first: opt[lang_source.Span] = reference.cell(text, line, 0);
        if (sel first.none) { cnt; }
        var c: usize = first.some.offset;
        var w: lang_source.Span;
        for (reference.code_next(text, ?c, first.some.offset + first.some.len, ?w)) {
            if (reference.spells(text, w, name)) { ret opt[lang_source.Span].some{line}; }
        }
    }
    ret opt[lang_source.Span].none{};
}

# the registry's axes are what manifest.md accepts, each isa's extension row is
# its vocabulary, an environment that selects extensions says which, and the
# `asm` tags of asm.md and the authoring skill are the isas with an assembler
test reference__target_lists_are_the_registry {
    var alloc: A.Allocator;
    page.make(?alloc);
    val text: opt[str] = reference.page_or_report(?alloc, "doc/language/manifest.md");
    if (sel text.none) { ret 1; }
    val rows: opt[lang_source.Span] = reference.table(text.some, 0, "| Axis  | Values |");
    if (sel rows.none)                                               { ret 2; }
    if (!axis_agrees(?alloc, text.some, rows.some, "`isa`", isa_at)) { ret 3; }
    if (!axis_agrees(?alloc, text.some, rows.some, "`os`", os_at))   { ret 3; }
    if (!axis_agrees(?alloc, text.some, rows.some, "`abi`", abi_at)) { ret 3; }
    if (!axis_agrees(?alloc, text.some, rows.some, "`of`", of_at))   { ret 3; }
    if (!axis_agrees(?alloc, text.some, rows.some, "`env`", env_at)) { ret 3; }

    val ext_rows: opt[lang_source.Span] = reference.table(text.some, 0, "| `isa` | Baseline | Extensions |");
    if (sel ext_rows.none) { ret 4; }
    val reg: *lang_target.TargetRegistry = toolchain.t_registry();
    var k:   u32                         = 0;
    for (k < reg.isa.count) {
        val vt: *isa.IsaVTable = reg.isa.members[k];
        k = k + 1;
        val m: *target_model.Machine = vt.model;
        if (m == nil || m.extension_table == nil || m.extension_table.count == 0) { cnt; }
        val row: opt[lang_source.Span] = extension_row(text.some, ext_rows.some, vt.name);
        if (sel row.none) {
            print.eprintlnf("manifest.md extensions: no row for isa {}", vt.name);
            ret 5;
        }
        val names: opt[lang_source.Span] = reference.cell(text.some, row.some, 2);
        if (sel names.none) { ret 5; }
        val bits: opt[u64] = spans_bits(text.some, names.some, m);
        if (sel bits.none) {
            print.eprintlnf("manifest.md extensions: the {} row names something twice or that is no extension of it", vt.name);
            ret 6;
        }
        if (bits.some != extension.domain(m.extension_table)) {
            print.eprintlnf("manifest.md extensions: the {} row is not the isa's vocabulary", vt.name);
            ret 6;
        }

        # each environment that selects extensions names them in one sentence, `env` selects `a`, ...
        var e: u32 = 0;
        for (e < vt.environments.count) {
            val env: *isa_environment.Environment = ?vt.environments.rows[e];
            e = e + 1;
            var needle: [64]u8;
            val lead:   str   = reference.joined(?needle[0], 64, "`", env.name, "` selects `");
            val at:     usize = reference.find(text.some, 0, lead);
            if (env.extensions == 0 && at < str_len(text.some)) {
                print.eprintlnf("manifest.md: {} is said to select extensions and selects none", env.name);
                ret 7;
            }
            if (env.extensions == 0) { cnt; }
            val stop: usize = reference.find(text.some, at, ". ");
            if (at >= str_len(text.some)) {
                print.eprintlnf("manifest.md: no sentence says which extensions {} selects", env.name);
                ret 7;
            }
            val said: opt[u64] = spans_bits(text.some, lang_source.Span{offset: at + str_len(lead) - 1, len: stop - at - str_len(lead) + 1}, m);
            if (sel said.none) { ret 7; }
            if (said.some != env.extensions) {
                print.eprintlnf("manifest.md: the extensions {} is said to select are not the ones it selects", env.name);
                ret 7;
            }
        }
    }

    val asm_page: opt[str] = reference.page_or_report(?alloc, "doc/language/asm.md");
    if (sel asm_page.none) { ret 8; }
    val tags: opt[lang_source.Span] = reference.line_after(asm_page.some, "- The tag comes from a closed set:");
    if (sel tags.none) { ret 8; }
    val first: usize = reference.find(asm_page.some, tags.some.offset, ". ");
    if (!reference.agree(?alloc, "asm.md tags", asm_page.some, lang_source.Span{offset: tags.some.offset, len: first - tags.some.offset}, reference.WORDS_CODE, assembled_at, AXIS_SPAN)) { ret 9; }
    val skill: opt[str] = reference.page_or_report(?alloc, "doc/skills/mach/SKILL.md");
    if (sel skill.none) { ret 10; }
    val skill_tags: opt[lang_source.Span] = reference.line_after(skill.some, "- The architecture tag is mandatory: one of");
    if (sel skill_tags.none)                                                                                                       { ret 10; }
    if (!reference.agree(?alloc, "SKILL.md asm tags", skill.some, skill_tags.some, reference.WORDS_CODE, assembled_at, AXIS_SPAN)) { ret 11; }
    ret 0;
}

# an instruction set that declares no assembly capability refuses `asm` in source at the
# block, before anything reaches its emitter
test asm__refused_on_an_isa_without_assembly {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val shader: str = "#[output(0)] var o: i32;\n#[stage(\"vertex\")]\nfun vs() {\n    asm spirv { nop }\n    o = 1;\n}\nfun main() i32 { ret 0; }\n";
    val native: str = "fun f() {\n    asm x86_64 { nop }\n}\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(); ret 0; }\n";

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:   session.Session                 = sr.ok;
    val pr:  res[project.Project, fail.Fail] = vec_lower(?s, ?alloc, shader, "spirv");
    var bad: i32                             = 0;
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        bad = 2;
    }
    or (!diagnostic.error_located(?s.diags, ?s.sources, "inline assembly is not available on instruction set 'spirv'", "main.mach", 4, 5)) {
        bad = 3;
    }
    session.dnit(?s);
    if (bad != 0) { ret bad; }

    val nr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel nr.err) { ret 1; }
    var n:   session.Session                 = nr.ok;
    val npr: res[project.Project, fail.Fail] = vec_lower(?n, ?alloc, native, "linux");
    if (sel npr.ok) {
        var np: project.Project = npr.ok;
        project.dnit_project(?np);
    }
    or { bad = 4; }
    session.dnit(?n);
    ret bad;
}

#[testing]
fun float_on_rv32(target_name: str, needle: str, want_refusal: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, fail.Fail] = ct_edge_project(?s, ?alloc,
        "fun main() i32 { val x: f32 = 1.0; ret x::i32; }\n", target_name);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val sem: err[fail.Fail] = driver.run_sema_pass(?p);
    if (want_refusal) {
        if (sel sem.ok)                               { ret 3; }
        if (!fail.is_reported(sem.err))               { ret 4; }
        if (!diagnostic.error_says(?s.diags, needle)) { ret 5; }
        ret 0;
    }
    if (sel sem.err)                             { ret 6; }
    if (diagnostic.error_says(?s.diags, needle)) { ret 7; }
    ret 0;
}

# the sema refusal of a float on a selection without F names the extension, not
# only the selection string; the same program on an F selection is clean
test float__refusal_names_the_missing_f_extension {
    val no_f: i32 = float_on_rv32("rv32nf",
        "which target `riscv32` does not support: the selection lacks the f extension", true);
    if (no_f != 0) { ret no_f; }
    val with_f: i32 = float_on_rv32("rv32s", "floating-point", false);
    if (with_f != 0) { ret 10 + with_f; }
    ret 0;
}

# an `op` declaration names a set the target publishes, an instruction of that set, and its operand count
test op_decl__checks_set_name_and_arity {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val arity:     str = "is not one the instruction's operand count admits";
    val bad_arity: str = "#[op(\"spirv\", \"GLSL.std.450\", \"Refract\")]\nfun refract(i: f32x3, n: f32x3) f32x3;\n\nfun main() i32 { ret 0; }\n";
    val ok_arity:  str = "#[op(\"spirv\", \"GLSL.std.450\", \"Refract\")]\nfun refract(i: f32x3, n: f32x3, eta: f32) f32x3;\n\nfun main() i32 { ret 0; }\n";
    if (!spv_diag_fired(?alloc, bad_arity, arity)) { ret 2; }
    if (spv_diag_fired(?alloc, ok_arity, arity))   { ret 3; }

    val set:     str = "defines no instruction set of this name";
    val bad_set: str = "#[op(\"spirv\", \"GLSL.std.451\", \"Sqrt\")]\nfun sq(x: f32) f32;\n\nfun main() i32 { ret 0; }\n";
    if (!spv_diag_fired(?alloc, bad_set, set)) { ret 4; }

    val name:        str = "defines no instruction of this name";
    val misspelled:  str = "#[op(\"spirv\", \"GLSL.std.450\", \"Sqrtf\")]\nfun f(x: f32) f32;\n\nfun main() i32 { ret 0; }\n";
    val ext_in_core: str = "#[op(\"spirv\", \"core\", \"Normalize\")]\nfun f(v: f32x4) f32x4;\n\nfun main() i32 { ret 0; }\n";
    val core_in_ext: str = "#[op(\"spirv\", \"GLSL.std.450\", \"OpDot\")]\nfun f(a: f32x4, b: f32x4) f32;\n\nfun main() i32 { ret 0; }\n";
    val ext_ok:      str = "#[op(\"spirv\", \"GLSL.std.450\", \"Normalize\")]\nfun f(v: f32x4) f32x4;\n\nfun main() i32 { ret 0; }\n";
    val core_ok:     str = "#[op(\"spirv\", \"core\", \"OpDot\")]\nfun f(a: f32x4, b: f32x4) f32;\n\nfun main() i32 { ret 0; }\n";
    if (!spv_diag_fired(?alloc, misspelled, name))  { ret 5; }
    if (!spv_diag_fired(?alloc, ext_in_core, name)) { ret 6; }
    if (!spv_diag_fired(?alloc, core_in_ext, name)) { ret 7; }
    if (spv_diag_fired(?alloc, ext_ok, name))       { ret 8; }
    if (spv_diag_fired(?alloc, core_ok, name))      { ret 9; }
    if (spv_diag_fired(?alloc, ext_ok, set))        { ret 10; }
    ret 0;
}

#[testing]
fun va_diag(target_name: str, src: str, needle: str) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret false; }
    val root: str = root_r.ok;

    var tsel_14921: manifest.Selectors              = manifest.t_selectors("", target_name, "");
    val pr:         res[project.Project, fail.Fail] = driver.build_project(?s, root, ?tsel_14921);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        val fired_early: bool = diagnostic.error_says(?s.diags, needle);
        ret fired_early;
    }
    var p:               project.Project = pr.ok;
    val run_sema_pass_r: err[fail.Fail]  = driver.run_sema_pass(?p);
    if (sel run_sema_pass_r.ok) {
        driver.run_lower_pass(?p);
    }
    val fired: bool = diagnostic.error_says(?p.s.diags, needle);
    project.dnit_project(?p);
    ret fired;
}

#[testing]
val VA_PRELUDE: str = "#[abi_type(\"va_list\")]\npub def VaList;\next fun sink(fmt: *u8, ap: VaList) i64;\n";

#[testing]
fun va(target_name: str, tail: str, needle: str) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val rj: res[str, std_format.FormatError] = std_format.sprint(?alloc, "{}{}", VA_PRELUDE, tail);
    if (sel rj.err) { ret false; }
    val src:   str  = rj.ok;
    val fired: bool = va_diag(target_name, src, needle);
    A.deallocate[char](?alloc, src::*char, str_len(src) + 1);
    ret fired;
}

#[testing]
val VA_EXCLUDED: str = "cannot be read, constructed, or stored in mach";

test va_list__extent_comes_from_the_target {
    val gate: str = "$if ($size_of(VaList) == 32 && $align_of(VaList) == 8) { $error(\"aapcs64 composite\"); }\n$if ($size_of(VaList) == 8 && $align_of(VaList) == 8) { $error(\"pointer shaped\"); }\nfun main() i32 { ret 0; }\n";

    if (!va("linux-arm64", gate, "aapcs64 composite")) { ret 1; }
    if (va("linux-arm64", gate, "pointer shaped"))     { ret 1; }

    if (!va("linux", gate, "pointer shaped"))   { ret 1; }
    if (va("linux", gate, "aapcs64 composite")) { ret 1; }

    if (!va("darwin-arm64", gate, "pointer shaped"))   { ret 1; }
    if (va("darwin-arm64", gate, "aapcs64 composite")) { ret 1; }

    if (!va("linux-riscv64", gate, "pointer shaped")) { ret 1; }
    if (!va("windows", gate, "pointer shaped"))       { ret 1; }
    ret 0;
}

# a va_list may only be forwarded: a copy, a field, a global, a pointer to one, a return and a cast are refused
test va_list__may_only_be_forwarded {
    val forward: str = "#[symbol(\"trace\")]\npub fun trace(fmt: *u8, ap: VaList) i64 { ret sink(fmt, ap); }\nfun main() i32 { ret 0; }\n";
    val local:   str = "#[symbol(\"trace\")]\npub fun trace(fmt: *u8, ap: VaList) i64 { val a: VaList = ap; ret sink(fmt, a); }\nfun main() i32 { ret 0; }\n";
    val field:   str = "rec Box { ap: VaList; }\nfun main() i32 { ret 0; }\n";
    val field_u: str = "uni Box { ap: VaList; n: i32; }\nfun main() i32 { ret 0; }\n";
    val global:  str = "var held: VaList;\nfun main() i32 { ret 0; }\n";
    val behind:  str = "#[symbol(\"trace\")]\npub fun trace(ap: *VaList) i64 { ret 0; }\nfun main() i32 { ret 0; }\n";
    val made:    str = "ext fun make() VaList;\nfun main() i32 { ret 0; }\n";
    val out_r:   str = "#[symbol(\"trace\")]\npub fun trace(ap: VaList) i64 { ret (ap :~ ptr)::i64; }\nfun main() i32 { ret 0; }\n";
    val out_c:   str = "#[symbol(\"trace\")]\npub fun trace(ap: VaList) i64 { ret (ap :: ptr)::i64; }\nfun main() i32 { ret 0; }\n";
    val in_r:    str = "#[symbol(\"trace\")]\npub fun trace(fmt: *u8, p: ptr) i64 { ret sink(fmt, p :~ VaList); }\nfun main() i32 { ret 0; }\n";

    if (va("linux", forward, VA_EXCLUDED))       { ret 1; }
    if (va("linux-arm64", forward, VA_EXCLUDED)) { ret 2; }
    if (!va("linux", local, VA_EXCLUDED))        { ret 3; }
    if (!va("linux", field, VA_EXCLUDED))        { ret 4; }
    if (!va("linux", field_u, VA_EXCLUDED))      { ret 5; }
    if (!va("linux", global, VA_EXCLUDED))       { ret 6; }
    if (!va("linux", behind, VA_EXCLUDED))       { ret 7; }
    if (!va("linux", made, VA_EXCLUDED))         { ret 8; }
    if (!va("linux", out_r, VA_EXCLUDED))        { ret 9; }
    if (!va("linux", out_c, VA_EXCLUDED))        { ret 10; }
    if (!va("linux", in_r, VA_EXCLUDED))         { ret 11; }
    if (!va("linux-arm64", out_r, VA_EXCLUDED))  { ret 12; }
    ret 0;
}

test abi_type__name_is_closed {
    val bad:   str = "#[abi_type(\"jmp_buf\")]\npub def JmpBuf;\nfun main() i32 { ret 0; }\n";
    val body:  str = "#[abi_type(\"va_list\")]\npub def Aliased: ptr;\nfun main() i32 { ret 0; }\n";
    val nargs: str = "#[abi_type]\npub def Nothing;\nfun main() i32 { ret 0; }\n";
    val ok:    str = "#[abi_type(\"va_list\")]\npub def VaList;\nfun main() i32 { ret 0; }\n";

    if (!va_diag("linux", bad, "no such ABI type"))                    { ret 1; }
    if (!va_diag("linux", body, "declaration has no body"))            { ret 1; }
    if (!va_diag("linux", nargs, "takes exactly one string argument")) { ret 1; }
    if (va_diag("linux", ok, "no such ABI type"))                      { ret 1; }
    ret 0;
}

#[testing]
val CT_WIDTHS: [4]u8 = [4]u8{8, 16, 32, 64};

# a one-target project for a registered tuple; a static library everywhere
# but spirv, which only builds programs
#[testing]
fun ct_mul_manifest(alloc: *A.Allocator, isa_name: str, baseline_name: str, os_name: str, abi_name: str, of_name: str) str {
    var kind: str = "static";
    var base: str = "";
    if (baseline_name != nil && str_len(baseline_name) != 0) {
        val l: res[str, std_format.FormatError] = std_format.sprint(alloc, "baseline = \"{}\"\n", baseline_name);
        if (sel l.err) { ret ""; }
        base = l.ok;
    }
    var out: str = "lib/ctmul.a";
    if (str_equals(of_name, "spirv")) {
        kind = "bin";
        out  = "bin/ctmul";
    }
    val r: res[str, std_format.FormatError] = std_format.sprint(alloc,
        "[project]\nmach = \">=5\"\nid = \"ctmul\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{{target.name}}/{{profile.name}}\"\n\n[target.t]\nisa = \"{}\"\n{}os = \"{}\"\nabi = \"{}\"\nof = \"{}\"\n\n[artifact.ctmul]\nkind = \"{}\"\nentry = \"main.mach\"\nout = \"{}\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n",
        isa_name, base, os_name, abi_name, of_name, kind, out);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

# 0 when a secret multiply lowered, 1 when a gate refused it as a variable-
# latency multiply, 2 for any other failure, which the comparison refuses
# the two spellings of a refused secret multiply: a cell the target declares
# nowhere, and a cell it declares only under a DIT the os does not guarantee
#[testing]
fun ct_is_mul_refusal(d: *diagnostic.DiagnosticStore) bool {
    if (diagnostic.error_says(d, "variable-latency integer multiply")) { ret true; }
    ret diagnostic.error_says(d, "integer multiply whose timing is data-independent only under PSTATE.DIT");
}

#[testing]
fun ct_codegen(p: *project.Project) i32 {
    val se: err[fail.Fail] = driver.run_sema_pass(p);
    if (sel se.err) { ret 2; }
    val le: err[fail.Fail] = driver.run_lower_pass(p);
    if (sel le.err) { ret 2; }
    val ce: err[fail.Fail] = driver.run_codegen_pass(p);
    if (sel ce.ok)                                                 { ret 0; }
    if (fail.is_reported(ce.err) && ct_is_mul_refusal(?p.s.diags)) { ret 1; }
    var di: usize = 0;
    for (di < diagnostic.len(?p.s.diags)) {
        print.println(p.s.diags.items.data[di].message);
        di = di + 1;
    }
    print.printf("ct_mul: codegen {}\n", fail.describe(ce.err));
    ret 2;
}

#[testing]
fun ct_op_name(op: u32) str {
    val name: opt[str] = ct.mul_op_name(op::ct.CtMulOp);
    if (sel name.some) { ret name.some; }
    ret "";
}

# the query program for one cell: a gate that reports when the cell is admitted
#[testing]
fun ct_mul_query_program(alloc: *A.Allocator, op: u32, width: u8) str {
    val name: str                              = ct_op_name(op);
    val line: res[str, std_format.FormatError] = std_format.sprint(alloc,
        "$if ($mach.build.ct_mul({}, {}) == 1) {{ $error(\"ct_mul admits {} {}\"); }}\n", name, width, name, width);
    if (sel line.err) { ret ""; }
    ret line.ok;
}

#[testing]
rec CtTuple {
    isa_name: str;
    # the target's baseline, nil for the isa's default
    baseline: str;
    os_name:  str;
    abi_name: str;
    of_name:  str;
}

# a registered instruction set a test replaced with a copy carrying its own
# rows: the members are static data, so the registry's slot is pointed at the
# copy and pointed back after
#[testing]
rec CtSwap {
    original: *isa.IsaVTable;
    index:    u32;
    vt:       isa.IsaVTable;
    model:    target_model.Machine;
}

# install `rows` on the named instruction set, nothing when row_len is 0;
# every swap is restored before its session goes
#[testing]
fun ct_mul_swap(kept: *CtSwap, isa_name: str, rows: *ct.CtMulForm, row_len: u32) {
    kept.original = nil;
    if (row_len == 0) { ret; }
    val reg: *lang_target.TargetRegistry = toolchain.t_registry();
    var ii:  u32                         = 0;
    for (ii < reg.isa.count && kept.original == nil) {
        val v: *isa.IsaVTable = reg.isa.members[ii];
        if (str_equals(v.name, isa_name)) {
            kept.original              = v;
            kept.index                 = ii;
            kept.model                 = @v.model;
            kept.model.ct_mul_forms    = rows;
            kept.model.ct_mul_form_len = row_len;
            kept.vt                    = @v;
            kept.vt.model              = ?kept.model;
            reg.isa.members[ii]        = ?kept.vt;
        }
        ii = ii + 1;
    }
}

#[testing]
fun ct_mul_restore(kept: *CtSwap) {
    if (kept.original == nil) { ret; }
    toolchain.t_registry().isa.members[kept.index] = kept.original;
}

# one build of `program` for the tuple, with the synthetic rows installed on
# its instruction set; the project, or the refusal's diagnostics searched for
# `needle`
#[testing]
fun ct_mul_build(alloc: *A.Allocator, t: *CtTuple, rows: *ct.CtMulForm, row_len: u32,
    program: str, needle: str, mask: *ct.CtMulMask, found: *bool, gate: *i32) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var kept: CtSwap;
    ct_mul_swap(?kept, t.isa_name, rows, row_len);
    fin { ct_mul_restore(?kept); }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{program};
    val root_r: res[str, fail.Fail] = driver.scaffold(alloc, ct_mul_manifest(alloc, t.isa_name, t.baseline, t.os_name, t.abi_name, t.of_name), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 4; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    var pick: manifest.Selectors              = manifest.t_selectors("", "t", "");
    val bp:   res[project.Project, fail.Fail] = driver.build_project(?s, root, ?pick);
    if (sel bp.err) {
        if (!fail.is_reported(bp.err)) { ret 5; }
        @found = diagnostic.error_says(?s.diags, needle);
        if (!@found) { ret 10; }
        ret 0;
    }
    var p: project.Project = bp.ok;
    fin { project.dnit_project(?p); }
    @mask = lang_target.ct_mul_admitted(?p.target.target);
    if (gate != nil) {
        @gate = ct_codegen(?p);
        ret 0;
    }
    val se: err[fail.Fail] = driver.run_sema_pass(?p);
    @found = diagnostic.error_says(?s.diags, needle);
    if (sel se.err && !@found) { ret 6; }
    ret 0;
}

# 0 when every build ran; `admitted` holds the query's answer per cell, in
# op then width order, and `gate_ok` per low-half width whether a secret
# multiply in an oblivious function lowered
#[testing]
fun ct_mul_run(alloc: *A.Allocator, t: *CtTuple, rows: *ct.CtMulForm, row_len: u32,
    mask: *ct.CtMulMask, admitted: *bool, gate_ok: *bool) i32 {
    var ci: usize = 0;
    var op: u32   = 1;
    for (op < ct.CT_MUL_OP_COUNT) {
        var wi: usize = 0;
        for (wi < 4) {
            val w:      u8                               = CT_WIDTHS[wi];
            val needle: res[str, std_format.FormatError] = std_format.sprint(alloc, "ct_mul admits {} {}", ct_op_name(op), w);
            if (sel needle.err) { ret 7; }
            var found: bool = false;
            val code:  i32  = ct_mul_build(alloc, t, rows, row_len, ct_mul_query_program(alloc, op, w), needle.ok, mask, ?found, nil);
            if (code != 0) { ret code; }
            admitted[ci] = found;
            ci           = ci + 1;
            wi           = wi + 1;
        }
        op = op + 1;
    }
    var gi: usize = 0;
    for (gi < 4) {
        val w:  u8                               = CT_WIDTHS[gi];
        val pr: res[str, std_format.FormatError] = std_format.sprint(alloc,
            "#[noinline]\n#[oblivious]\npub fun product(a: ^u{}, b: ^u{}) ^u{} {{ ret a * b; }}\n", w, w, w);
        if (sel pr.err) { ret 3; }
        var found: bool = false;
        var gate:  i32  = 2;
        val code:  i32  = ct_mul_build(alloc, t, rows, row_len, pr.ok, "", mask, ?found, ?gate);
        if (code != 0) { ret code; }
        if (gate == 2) { ret 9; }
        gate_ok[gi] = gate == 0;
        gi          = gi + 1;
    }
    ret 0;
}

# 0 when, for the tuple, the query answers every cell as the target's one
# decision does and the lowering gate accepts a secret low-half multiply
# exactly where the query admits it
#[testing]
fun ct_mul_agree(alloc: *A.Allocator, t: *CtTuple, rows: *ct.CtMulForm, row_len: u32) i32 {
    var admitted: [28]bool;
    var gate_ok:  [4]bool;
    var mask:     ct.CtMulMask = ct.mul_mask_none();
    val run:      i32          = ct_mul_run(alloc, t, rows, row_len, ?mask, ?admitted[0], ?gate_ok[0]);
    if (run != 0) { ret run; }
    var ci: usize = 0;
    var op: u32   = 1;
    for (op < ct.CT_MUL_OP_COUNT) {
        var wi: usize = 0;
        for (wi < 4) {
            val decided: bool = ct.mul_mask_has(mask, ct.mul_cell(op::ct.CtMulOp, CT_WIDTHS[wi], false));
            if (admitted[ci] != decided)                                        { ret 20; }
            if (op::ct.CtMulOp == ct.CT_MUL_LOW && gate_ok[wi] != admitted[ci]) { ret 21; }
            ci = ci + 1;
            wi = wi + 1;
        }
        op = op + 1;
    }
    ret 0;
}

# the query answers every cell as the target's one decision does, and the
# lowering gate accepts a secret low-half multiply exactly where the query
# admits it, on one tuple per decision: aarch64 admitted through DIT on linux
# and refused without it freestanding, riscv64 admitted through Zkt and refused
# without it, and an isa with no rows. x86_64 is ct_mul_query__x86_64_answers
test ct_mul_query__agrees_with_the_lowering_gate {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var tuples: [5]CtTuple = [5]CtTuple{
        CtTuple{isa_name: "aarch64", os_name: "linux", abi_name: "aapcs64", of_name: "elf"},
        CtTuple{isa_name: "aarch64", baseline: "armv8-a+fp+simd", os_name: "freestanding", abi_name: "aapcs64", of_name: "elf"},
        CtTuple{isa_name: "riscv64", baseline: "rv64gc_zkt", os_name: "linux", abi_name: "lp64d", of_name: "elf"},
        CtTuple{isa_name: "riscv64", baseline: "rv64gc", os_name: "linux", abi_name: "lp64d", of_name: "elf"},
        CtTuple{isa_name: "spirv", os_name: "vulkan", abi_name: "spirv", of_name: "spirv"}
    };
    var ti: usize = 0;
    for (ti < 5) {
        val code: i32 = ct_mul_agree(?alloc, ?tuples[ti], nil, 0);
        if (code != 0) {
            print.printf("ct_mul: {}-{} disagrees ({})\n", tuples[ti].os_name, tuples[ti].isa_name, code);
            ret 100 + code;
        }
        ti = ti + 1;
    }
    ret 0;
}

# the same agreement on a synthetic x86_64 model that admits two cells, so a
# query reading anything but the target's one decision is caught
test ct_mul_query__agrees_on_a_synthetic_model {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var rows: [3]ct.CtMulForm = [3]ct.CtMulForm{
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 16, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_LOW, width: 32, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0},
        ct.CtMulForm{op: ct.CT_MUL_WIDE_S, width: 64, lanes: 0, cond: ct.CT_MUL_ALWAYS, ext: 0}
    };
    var t:        CtTuple      = CtTuple{isa_name: "x86_64", os_name: "linux", abi_name: "sysv64", of_name: "elf"};
    var admitted: [28]bool;
    var gate_ok:  [4]bool;
    var mask:     ct.CtMulMask = ct.mul_mask_none();
    if (ct_mul_run(?alloc, ?t, ?rows[0], 3, ?mask, ?admitted[0], ?gate_ok[0]) != 0) { ret 2; }
    if (!ct.mul_mask_has(mask, ct.mul_cell(ct.CT_MUL_LOW, 32, false)))              { ret 3; }
    if (!ct.mul_mask_has(mask, ct.mul_cell(ct.CT_MUL_WIDE_S, 64, false)))           { ret 4; }
    if (!gate_ok[1] || !gate_ok[2] || gate_ok[3] || gate_ok[0])                     { ret 5; }
    val code: i32 = ct_mul_agree(?alloc, ?t, ?rows[0], 3);
    if (code != 0) { ret 10 + code; }
    # a packed lane multiply is its own cell, which no row may declare yet
    var found: bool = false;
    var gate:  i32  = 2;
    val lanes: i32  = ct_mul_build(?alloc, ?t, ?rows[0], 3,
        "#[noinline]\n#[oblivious]\npub fun product(a: ^u16x8, b: ^u16x8) ^u16x8 { ret a * b; }\n", "", ?mask, ?found, ?gate);
    if (lanes != 0 || gate != 1) { ret 40; }
    ret 0;
}

# the instruction families the shape check reads from a codegen listing
#[testing]
val CT_X86: u32 = 0;

#[testing]
val CT_ARM: u32 = 1;

#[testing]
val CT_RISCV: u32 = 2;

#[testing]
val CT_X86_MUL: [2]str = [2]str{"imul", "mul"};

#[testing]
val CT_ARM_MUL: [10]str = [10]str{"mul", "madd", "msub", "mneg", "smull", "umull", "smulh", "umulh", "smaddl", "umaddl"};

#[testing]
val CT_RV_MUL: [5]str = [5]str{"mul", "mulw", "mulh", "mulhu", "mulhsu"};

#[testing]
val CT_ARM_CTL: [9]str = [9]str{"b", "bl", "br", "blr", "cbz", "cbnz", "tbz", "tbnz", "svc"};

#[testing]
val CT_X86_CTL: [4]str = [4]str{"call", "syscall", "rep", "repe"};

#[testing]
fun ct_mnemonic_in(m: str, names: *str, len: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        if (str_equals(m, names[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun ct_is_multiply(family: u32, m: str) bool {
    if (family == CT_X86) { ret ct_mnemonic_in(m, ?CT_X86_MUL[0], 2); }
    if (family == CT_ARM) { ret ct_mnemonic_in(m, ?CT_ARM_MUL[0], 10); }
    ret ct_mnemonic_in(m, ?CT_RV_MUL[0], 5);
}

# a call, branch, jump or loop instruction; the closing return is read apart
#[testing]
fun ct_is_control(family: u32, m: str) bool {
    val n: usize = str_len(m);
    if (n == 0) { ret false; }
    if (family == CT_X86) {
        ret m[0] == 'j' || (n >= 4 && str_region_equals(m, 0, 4, "loop")) || str_equals(m, "ret")
            || ct_mnemonic_in(m, ?CT_X86_CTL[0], 4);
    }
    if (family == CT_ARM) {
        ret (n >= 2 && str_region_equals(m, 0, 2, "b.")) || str_equals(m, "ret") || ct_mnemonic_in(m, ?CT_ARM_CTL[0], 9);
    }
    ret m[0] == 'b' || m[0] == 'j' || str_equals(m, "ecall") || str_equals(m, "ebreak");
}

#[testing]
fun ct_is_return(family: u32, line: str) bool {
    if (family == CT_RISCV) { ret str_equals(line, "jalr zero, 0(ra)"); }
    ret str_equals(line, "ret");
}

# 0 when the listing's section for `name` is one block of instructions holding
# exactly one multiply and no call, branch or loop before its closing return
#[testing]
fun ct_mul_shape(alloc: *A.Allocator, text: *u8, len: usize, name: str, family: u32) i32 {
    val hr: res[str, std_format.FormatError] = std_format.sprint(alloc, "# {}:\n", name);
    if (sel hr.err) { ret 30; }
    val header: str   = hr.ok;
    val hl:     usize = str_len(header);
    var at:     usize = 0;
    var found:  bool  = false;
    for (!found && at + hl <= len) {
        if (str_region_equals(text::str, at, hl, header)) { found = true; }
        or                                                { at = at + 1; }
    }
    if (!found) { ret 31; }
    at = at + hl;
    var labels:   u32  = 0;
    var muls:     u32  = 0;
    var control:  u32  = 0;
    var returned: bool = false;
    var after:    u32  = 0;
    var line:     [128]u8;
    var mn:       [32]u8;
    for (at < len && text[at] != '\n') {
        var ll: usize = 0;
        for (at < len && (text[at] == ' ' || text[at] == '\t')) { at = at + 1; }
        for (at < len && text[at] != '\n') {
            if (ll + 1 < 128) {
                line[ll] = text[at];
                ll       = ll + 1;
            }
            at = at + 1;
        }
        at       = at + 1;
        line[ll] = 0;
        val l: str = ?line[0];
        if (ll > 0 && line[0] == '.' && line[ll - 1] == ':') { labels = labels + 1; }
        or (str_region_equals(l, 0, 8, ".balign "))          {}
        or (ll > 0 && returned)                              { after = after + 1; }
        or (ll > 0 && ct_is_return(family, l))               { returned = true; }
        or (ll > 0) {
            var k: usize = 0;
            for (k < ll && k < 31 && line[k] != ' ' && line[k] != '\t') {
                mn[k] = line[k];
                k     = k + 1;
            }
            mn[k] = 0;
            val m: str = ?mn[0];
            if (ct_is_multiply(family, m)) { muls = muls + 1; }
            if (ct_is_control(family, m))  { control = control + 1; }
        }
    }
    if (labels != 1)  { ret 32; }
    if (muls != 1)    { ret 33; }
    if (control != 0) { ret 34; }
    if (!returned)    { ret 35; }
    if (after != 0)   { ret 36; }
    ret 0;
}

# the codegen listing of `program` built at opt 2 for the tuple, with the
# synthetic rows installed: 0 when it built, 1 when a gate refused a secret
# multiply, 2 for any other failure
#[testing]
fun ct_mul_listing(alloc: *A.Allocator, t: *CtTuple, rows: *ct.CtMulForm, row_len: u32, program: str,
    out: *u8, cap: usize, out_len: *usize) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var kept: CtSwap;
    ct_mul_swap(?kept, t.isa_name, rows, row_len);
    fin { ct_mul_restore(?kept); }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{program};
    val root_r: res[str, fail.Fail] = driver.scaffold(alloc, ct_mul_manifest(alloc, t.isa_name, t.baseline, t.os_name, t.abi_name, t.of_name), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    var pick: manifest.Selectors              = manifest.t_selectors("", "t", "release");
    val bp:   res[project.Project, fail.Fail] = driver.build_project(?s, root, ?pick);
    if (sel bp.err) { ret 2; }
    var p: project.Project = bp.ok;
    fin { project.dnit_project(?p); }
    val se: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) { ret 2; }
    val le: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) { ret 2; }
    val mid: session.ModuleId = project.module_named(?p, "ctmul.main");
    if (module.is_nil(mid)) { ret 2; }
    var b:  io_writer.Memory;
    var w:  io_writer.Writer                      = io_writer.memory(?b, out, cap);
    val cg: res[target_of.ObjectImage, fail.Fail] = codegen.codegen_unit(?s, ?p.target, project.module_at(?p, mid::u32).ir_module, mir_unit.ir_set_empty(), ?w, codegen.no_debug(), ?s.diags);
    if (sel cg.err) {
        if (fail.is_reported(cg.err) && ct_is_mul_refusal(?s.diags)) { ret 1; }
        print.printf("ct_mul: codegen {}\n", fail.describe(cg.err));
        ret 2;
    }
    var image: target_of.ObjectImage = cg.ok;
    target_of.object_image_dnit(?image);
    @out_len = b.len;
    ret 0;
}

# the secret multiplies each width is checked through: two secrets, a square,
# and secret constants a strength reduction would turn into shifts and adds
#[testing]
fun ct_mul_program(alloc: *A.Allocator, w: u8) str {
    val r: res[str, std_format.FormatError] = std_format.sprint(alloc,
        "#[noinline]\n#[oblivious]\npub fun product(a: ^u{}, b: ^u{}) ^u{} {{ ret a * b; }}\n#[noinline]\n#[oblivious]\npub fun square(a: ^u{}) ^u{} {{ ret a * a; }}\n#[noinline]\n#[oblivious]\npub fun by8(a: ^u{}) ^u{} {{ val k: ^u{} = 8; ret a * k; }}\n#[noinline]\n#[oblivious]\npub fun by10(a: ^u{}) ^u{} {{ val k: ^u{} = 10; ret k * a; }}\n",
        w, w, w, w, w, w, w, w, w, w, w);
    if (sel r.err) { ret ""; }
    ret r.ok;
}

#[testing]
val CT_SHAPED: [4]str = [4]str{"ctmul.main.product", "ctmul.main.square", "ctmul.main.by8", "ctmul.main.by10"};

# 0 when every probe at every width lowers to one multiply instruction and
# nothing that branches
#[testing]
fun ct_mul_shapes(alloc: *A.Allocator, t: *CtTuple, rows: *ct.CtMulForm, row_len: u32, family: u32) i32 {
    val cap: usize             = 65536;
    val br:  res[*u8, A.Error] = A.allocate[u8](alloc, cap);
    if (sel br.err) { ret 1; }
    val buf: *u8 = br.ok;
    fin { A.deallocate[u8](alloc, buf, cap); }
    var wi: usize = 0;
    for (wi < 4) {
        val w:    u8    = CT_WIDTHS[wi];
        var len:  usize = 0;
        val code: i32   = ct_mul_listing(alloc, t, rows, row_len, ct_mul_program(alloc, w), buf, cap, ?len);
        if (code != 0) {
            print.printf("ct_mul: {} at {} bits did not lower ({})\n", t.isa_name, w, code);
            ret 2;
        }
        var fi: usize = 0;
        for (fi < 4) {
            val shape: i32 = ct_mul_shape(alloc, buf, len, CT_SHAPED[fi], family);
            if (shape != 0) {
                print.printf("ct_mul: {} {} at {} bits has shape {}\n", t.isa_name, CT_SHAPED[fi], w, shape);
                ret 3;
            }
            fi = fi + 1;
        }
        wi = wi + 1;
    }
    ret 0;
}

# a secret multiply decodes to exactly the declared instruction on each ISA: one
# multiply, no call, branch or loop, and no strength reduction of a square or a
# secret constant. riscv64 lowers through its registered Zkt rows, x86_64
# through its registered ALWAYS rows with no os declaration (freestanding), and aarch64 through its registered
# DIT_MODE rows on linux and darwin, the two operating systems that declare
# the mode guaranteed
test ct_mul__lowers_to_one_multiply_on_each_isa {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var rv:     CtTuple = CtTuple{isa_name: "riscv64", baseline: "rv64gc_zkt", os_name: "linux", abi_name: "lp64d", of_name: "elf"};
    var x86:    CtTuple = CtTuple{isa_name: "x86_64", os_name: "freestanding", abi_name: "sysv64", of_name: "elf"};
    var arm:    CtTuple = CtTuple{isa_name: "aarch64", os_name: "linux", abi_name: "aapcs64", of_name: "elf"};
    var arm_dw: CtTuple = CtTuple{isa_name: "aarch64", os_name: "darwin", abi_name: "aapcs64", of_name: "macho"};
    val rc:     i32     = ct_mul_shapes(?alloc, ?rv, nil, 0, CT_RISCV);
    if (rc != 0) { ret 3; }
    val xc: i32 = ct_mul_shapes(?alloc, ?x86, nil, 0, CT_X86);
    if (xc != 0) { ret 4; }
    val ac: i32 = ct_mul_shapes(?alloc, ?arm, nil, 0, CT_ARM);
    if (ac != 0) { ret 5; }
    val dc: i32 = ct_mul_shapes(?alloc, ?arm_dw, nil, 0, CT_ARM);
    if (dc != 0) { ret 6; }
    ret 0;
}

# 0 when a secret 64-bit multiply is refused on the tuple with its registered rows
#[testing]
fun ct_mul_refused(alloc: *A.Allocator, isa_name: str, baseline_name: str, os_name: str, abi_name: str, of_name: str) i32 {
    var t:    CtTuple = CtTuple{isa_name: isa_name, baseline: baseline_name, os_name: os_name, abi_name: abi_name, of_name: of_name};
    var buf:  [16384]u8;
    var len:  usize   = 0;
    val code: i32     = ct_mul_listing(alloc, ?t, nil, 0,
        "#[noinline]\n#[oblivious]\npub fun product(a: ^u64, b: ^u64) ^u64 { ret a * b; }\n", ?buf[0], 16384, ?len);
    if (code != 1) {
        print.printf("ct_mul: {}-{}-{}-{} was not refused ({})\n", os_name, isa_name, abi_name, of_name, code);
        ret 1;
    }
    ret 0;
}

# whether the object codegen emits for `program` on the tuple carries the DIT
# need marker: 1 when it does, 0 when it does not, 2 when the build failed
#[testing]
fun ct_mul_marker(alloc: *A.Allocator, t: *CtTuple, program: str) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{program};
    val root_r: res[str, fail.Fail] = driver.scaffold(alloc, ct_mul_manifest(alloc, t.isa_name, t.baseline, t.os_name, t.abi_name, t.of_name), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    var pick: manifest.Selectors              = manifest.t_selectors("", "t", "release");
    val bp:   res[project.Project, fail.Fail] = driver.build_project(?s, root, ?pick);
    if (sel bp.err) { ret 2; }
    var p: project.Project = bp.ok;
    fin { project.dnit_project(?p); }
    val se: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) { ret 2; }
    val le: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) { ret 2; }
    val mid: session.ModuleId = project.module_named(?p, "ctmul.main");
    if (module.is_nil(mid)) { ret 2; }
    val cg: res[target_of.ObjectImage, fail.Fail] = codegen.codegen_unit(?s, ?p.target, project.module_at(?p, mid::u32).ir_module, mir_unit.ir_set_empty(), nil, codegen.no_debug(), ?s.diags);
    if (sel cg.err) {
        print.printf("ct_mul: codegen {}\n", fail.describe(cg.err));
        ret 2;
    }
    var image: target_of.ObjectImage = cg.ok;
    fin { target_of.object_image_dnit(?image); }
    val marker: res[intern.StrId, A.Error] = intern.add(?s.interner, ct.DIT_NEED_MARKER);
    if (sel marker.err) { ret 2; }
    var found: i32 = 0;
    var si:    u32 = 0;
    for (si < image.symbol_count) {
        val sym: *target_of.Symbol = ?image.symbols[si];
        if (intern.str_same(sym.name, marker.ok)) {
            if (!target_of.section_is_absolute(sym.section) || sym.absolute_value != ct.DIT_NEED_VALUE) { ret 3; }
            if ((sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0)                                       { ret 4; }
            found = 1;
        }
        si = si + 1;
    }
    ret found;
}

# the DIT need is recorded in the object exactly when a secret multiply lowers
# through a DIT_MODE row: on aarch64-linux and aarch64-darwin a secret
# multiply carries the marker, a public multiply and a secret add do not, and
# the x86_64 ALWAYS rows carry nothing for the same secret multiply
test ct_mul__dit_need_is_marked_only_for_a_dit_multiply {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val secret_mul: str     = "#[noinline]\n#[oblivious]\npub fun product(a: ^u64, b: ^u64) ^u64 { ret a * b; }\n";
    val secret_add: str     = "#[noinline]\n#[oblivious]\npub fun sum(a: ^u64, b: ^u64) ^u64 { ret a + b; }\n";
    val public_mul: str     = "#[noinline]\npub fun product(a: u64, b: u64) u64 { ret a * b; }\n";
    val narrow_mul: str     = "#[noinline]\n#[oblivious]\npub fun product(a: ^u8, b: ^u8) ^u8 { ret a * b; }\n";
    var arm:        CtTuple = CtTuple{isa_name: "aarch64", os_name: "linux", abi_name: "aapcs64", of_name: "elf"};
    var arm_dw:     CtTuple = CtTuple{isa_name: "aarch64", os_name: "darwin", abi_name: "aapcs64", of_name: "macho"};
    var x86:        CtTuple = CtTuple{isa_name: "x86_64", os_name: "linux", abi_name: "sysv64", of_name: "elf"};
    var rv:         CtTuple = CtTuple{isa_name: "riscv64", baseline: "rv64gc_zkt", os_name: "linux", abi_name: "lp64d", of_name: "elf"};
    if (ct_mul_marker(?alloc, ?arm, secret_mul) != 1)    { ret 2; }
    if (ct_mul_marker(?alloc, ?arm, narrow_mul) != 1)    { ret 3; }
    if (ct_mul_marker(?alloc, ?arm_dw, secret_mul) != 1) { ret 4; }
    if (ct_mul_marker(?alloc, ?arm, secret_add) != 0)    { ret 5; }
    if (ct_mul_marker(?alloc, ?arm, public_mul) != 0)    { ret 6; }
    if (ct_mul_marker(?alloc, ?x86, secret_mul) != 0)    { ret 7; }
    if (ct_mul_marker(?alloc, ?rv, secret_mul) != 0)     { ret 8; }
    ret 0;
}

# every branch a secret multiply is refused on: an ISA with no rows, a riscv64
# selection without Zkt or without M, and aarch64's DIT_MODE rows on an OS
# that declares no DIT guarantee (freestanding; linux and darwin declare it and
# admit). the control shows the same build lowers where the rows hold
test ct_mul__refuses_every_undeclared_isa_os_and_condition {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var bad: i32 = 0;
    if (ct_mul_refused(?alloc, "riscv32", "rv32imac_zkt", "freestanding", "ilp32", "elf") != 0)      { bad = bad | 1; }
    if (ct_mul_refused(?alloc, "spirv", "", "vulkan", "spirv", "spirv") != 0)                        { bad = bad | 2; }
    if (ct_mul_refused(?alloc, "riscv64", "rv64gc", "linux", "lp64d", "elf") != 0)                   { bad = bad | 4; }
    if (ct_mul_refused(?alloc, "riscv64", "rv64imafd_zicsr_zifencei", "linux", "lp64d", "elf") != 0) { bad = bad | 8; }
    if (ct_mul_refused(?alloc, "riscv64", "rv64i_zkt", "linux", "lp64", "elf") != 0)                 { bad = bad | 16; }
    if (ct_mul_refused(?alloc, "aarch64", "armv8-a+fp+simd", "freestanding", "aapcs64", "elf") != 0) { bad = bad | 128; }
    var control: CtTuple = CtTuple{isa_name: "riscv64", baseline: "rv64gc_zkt", os_name: "linux", abi_name: "lp64d", of_name: "elf"};
    var buf:     [16384]u8;
    var len:     usize   = 0;
    if (ct_mul_listing(?alloc, ?control, nil, 0, "#[noinline]\n#[oblivious]\npub fun product(a: ^u64, b: ^u64) ^u64 { ret a * b; }\n", ?buf[0], 16384, ?len) != 0) { bad = bad | 256; }
    if (bad != 0) {
        print.printf("ct_mul: refusal branches failed: {}\n", bad);
        ret 1;
    }
    ret 0;
}

# `$mach.build.ct_mul(op, width)` answers 1 on x86_64 for the low half, both
# high halves and both widening products at every width, and 0 for the
# signed-by-unsigned high half no row declares; the lowering gate agrees at
# each low-half width
test ct_mul_query__x86_64_answers {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var t:        CtTuple      = CtTuple{isa_name: "x86_64", os_name: "linux", abi_name: "sysv64", of_name: "elf"};
    var admitted: [28]bool;
    var gate_ok:  [4]bool;
    var mask:     ct.CtMulMask = ct.mul_mask_none();
    if (ct_mul_run(?alloc, ?t, nil, 0, ?mask, ?admitted[0], ?gate_ok[0]) != 0) { ret 2; }
    var ci: usize = 0;
    var op: u32   = 1;
    for (op < ct.CT_MUL_OP_COUNT) {
        var wi: usize = 0;
        for (wi < 4) {
            val want: bool = op::ct.CtMulOp != ct.CT_MUL_HIGH_SU;
            if (admitted[ci] != want) {
                print.printf("ct_mul: x86_64 query for {} {} disagrees with the rows\n", ct_op_name(op), CT_WIDTHS[wi]);
                ret 3;
            }
            ci = ci + 1;
            wi = wi + 1;
        }
        op = op + 1;
    }
    if (!gate_ok[0] || !gate_ok[1] || !gate_ok[2] || !gate_ok[3]) { ret 4; }
    ret 0;
}

# the query folds to a u8 like `$mach.build.pie`, coerces to a wider binding,
# lowers as a constant, and refuses a malformed call naming what it accepts
test ct_mul_query__folds_to_u8_and_refuses_malformed_calls {
    if (!sema_clean("val Q: u8 = $mach.build.ct_mul(low, 64);\nval W: u64 = $mach.build.ct_mul(high_su, 8);\n$if ($mach.build.ct_mul(wide_s, 32) == 0) { val OFF: u8 = 0; }\nfun main() i32 { ret ($mach.build.ct_mul(high_u, 16) + Q)::i32 + W::i32; }\n")) { ret 1; }
    if (codegen_target_ok("fun main() i32 { val q: u8 = $mach.build.ct_mul(low, 32); ret q::i32; }\n", "linux") != 0)                                                                                                                                        { ret 2; }
    if (vec_diag("val Q: u8 = $mach.build.ct_mul(mid, 64);\nfun main() i32 { ret 0; }\n",
        "unknown multiply `mid`; expected one of low, high_u, high_s, high_su, wide_u, wide_s") != 0) { ret 3; }
    if (vec_diag("val Q: u8 = $mach.build.ct_mul(low, 24);\nfun main() i32 { ret 0; }\n",
        "the operand width must be 8, 16, 32, 64 or 128") != 0) { ret 4; }
    if (vec_diag("val Q: u8 = $mach.build.ct_mul(low, 256);\nfun main() i32 { ret 0; }\n",
        "the operand width must be 8, 16, 32, 64 or 128") != 0) { ret 8; }
    if (vec_diag("val Q: u8 = $mach.build.ct_mul(low, 18446744073709551744);\nfun main() i32 { ret 0; }\n",
        "the operand width must be 8, 16, 32, 64 or 128") != 0) { ret 9; }
    if (!sema_clean("val Q: u8 = $mach.build.ct_mul(low, 128);\n$if ($mach.build.ct_mul(low, 128) == 0) { val OFF: u8 = 0; }\n$if ($mach.build.ct_mul(low, 128) == 1) { val ON: u8 = 1; }\nfun main() i32 { ret Q::i32; }\n")) { ret 10; }
    if (vec_diag("val Q: u8 = $mach.build.ct_mul(low);\nfun main() i32 { ret 0; }\n",
        "takes a multiply and an operand width") != 0) { ret 5; }
    if (vec_diag("val Q: u8 = $mach.build.ct_mul(1, 64);\nfun main() i32 { ret 0; }\n",
        "the multiply is a bare word, one of low") != 0) { ret 6; }
    if (vec_diag("val Q: u32 = $mach.build.os(1);\nfun main() i32 { ret 0; }\n",
        "this comptime path takes no arguments") != 0) { ret 7; }
    ret 0;
}

# 0 when the build reports an error containing `needle`, or, for an empty
# needle, when it loads and passes sema with no error at all
#[testing]
fun ext_probe(isa_name: str, baseline_name: str, os_name: str, abi_name: str, exts: str, program: str, needle: str) i32 {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{program};
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, ext_manifest_on(?alloc, isa_name, baseline_name, os_name, abi_name, exts), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var pick:   manifest.Selectors              = manifest.t_selectors("", "t", "");
    val bp:     res[project.Project, fail.Fail] = driver.build_project(?s, root, ?pick);
    val expect: bool                            = str_len(needle) != 0;
    if (sel bp.err) {
        if (!expect)                                                                                { ret 3; }
        if (diagnostic.error_says(?s.diags, needle) || str_contains(fail.describe(bp.err), needle)) { ret 0; }
        ret 4;
    }
    var p: project.Project = bp.ok;
    fin { project.dnit_project(?p); }
    val se: err[fail.Fail] = driver.run_sema_pass(?p);
    if (expect) {
        if (diagnostic.error_says(?s.diags, needle)) { ret 0; }
        ret 5;
    }
    if (sel se.err || diagnostic.error_count(?s.diags) != 0) { ret 6; }
    ret 0;
}

# 0 when the program reaches codegen and the encoder reports an error containing
# `needle`, or, for an empty needle, when it encodes with no error at all
#[testing]
fun ext_codegen(isa_name: str, baseline_name: str, os_name: str, abi_name: str, exts: str, program: str, needle: str) i32 {
    ret ext_codegen_at(isa_name, baseline_name, os_name, abi_name, exts, program, needle, 0, 0);
}

# as ext_codegen, and a nonzero `line` also holds the error to main.mach at `line`:`col`
#[testing]
fun ext_codegen_at(isa_name: str, baseline_name: str, os_name: str, abi_name: str, exts: str, program: str, needle: str, line: usize, col: usize) i32 {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{program};
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, ext_manifest_on(?alloc, isa_name, baseline_name, os_name, abi_name, exts), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var pick: manifest.Selectors              = manifest.t_selectors("", "t", "");
    val bp:   res[project.Project, fail.Fail] = driver.build_project(?s, root, ?pick);
    if (sel bp.err) { ret 3; }
    var p: project.Project = bp.ok;
    fin { project.dnit_project(?p); }
    if (str_len(needle) == 0) { ret run_codegen_ok(?p); }
    val code: i32 = run_codegen_err(?p, needle);
    if (code == 0 && line != 0 && !diagnostic.error_located(?s.diags, ?s.sources, needle, "main.mach", line, col)) { ret 5; }
    ret code;
}

# the aes and carry-less multiply rows are a located error where neither the
# target nor the function admits their extension, and encode under either; on
# aarch64 pmull brings aes
test extensions__aes_and_carry_less_rows_need_their_extension {
    val x:   str = "x86_64";
    val l:   str = "linux";
    val v:   str = "sysv64";
    val aes: str = "fun f() {\n    asm x86_64 { aesenc xmm0, xmm1\n aeskeygenassist xmm2, xmm1, 1 }\n}\n";
    val clm: str = "fun f() {\n    asm x86_64 { pclmulqdq xmm0, xmm1, 0x11 }\n}\n";
    if (ext_codegen_at(x, "", l, v, "", aes, "inline-asm instruction 'aesenc' needs the `aes` extension", 2, 5) != 0)                                      { ret 1; }
    if (ext_codegen(x, "", l, v, "[\"aes\"]", aes, "") != 0)                                                                                               { ret 2; }
    if (ext_codegen_at(x, "", l, v, "[\"aes\"]", clm, "inline-asm instruction 'pclmulqdq' needs the `pclmul` extension", 2, 5) != 0)                       { ret 3; }
    if (ext_codegen(x, "", l, v, "[\"pclmul\"]", clm, "") != 0)                                                                                            { ret 4; }
    if (ext_codegen(x, "", l, v, "", "#[extensions(aes, pclmul)]\nfun f() { asm x86_64 { aesdeclast xmm0, xmm1\n pclmulqdq xmm0, xmm1, 0 } }\n", "") != 0) { ret 5; }

    val a:       str = "aarch64";
    val c:       str = "aapcs64";
    val arm_aes: str = "fun f() {\n    asm aarch64 { aese v0.16b, v1.16b\n aesmc v0.16b, v0.16b }\n}\n";
    val arm_clm: str = "fun f() {\n    asm aarch64 { pmull v0.1q, v1.1d, v2.1d\n pmull2 v3.1q, v1.2d, v2.2d }\n}\n";
    if (ext_codegen_at(a, "", l, c, "", arm_aes, "inline-asm instruction 'aese' needs the `FEAT_AES` extension", 2, 5) != 0)                                 { ret 6; }
    if (ext_codegen(a, "", l, c, "[\"aes\"]", arm_aes, "") != 0)                                                                                             { ret 7; }
    if (ext_codegen(a, "", l, c, "[\"pmull\"]", arm_aes, "") != 0)                                                                                           { ret 8; }
    if (ext_codegen_at(a, "", l, c, "[\"FEAT_AES\"]", arm_clm, "inline-asm instruction 'pmull' needs the `FEAT_PMULL` extension", 2, 5) != 0)                { ret 9; }
    if (ext_codegen(a, "", l, c, "[\"pmull\"]", arm_clm, "") != 0)                                                                                           { ret 10; }
    if (ext_codegen(a, "", l, c, "", "#[extensions(aes, pmull)]\nfun f() { asm aarch64 { aesimc v0.16b, v1.16b\n pmull v0.1q, v1.1d, v2.1d } }\n", "") != 0) { ret 11; }
    if (ext_answer(a, "", l, c, "[\"pmull\"]", "aes") != 1)                                                                                                  { ret 12; }
    if (ext_answer(x, "", l, v, "[\"pclmul\"]", "aes") != 0)                                                                                                 { ret 13; }
    ret 0;
}

# the answer `$mach.build.extensions.<name>` gives on a target: 1, 0, or -1 when the build fails otherwise
#[testing]
fun ext_answer(isa_name: str, baseline_name: str, os_name: str, abi_name: str, exts: str, name: str) i32 {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret -1; }
    val program: res[str, std_format.FormatError] = std_format.sprint(?alloc,
        "$if ($mach.build.extensions.{} == 1) {{ $error(\"ext answered one\"); }}\nval W: u64 = $mach.build.extensions.{};\n", name, name);
    if (sel program.err)                                                                                  { ret -1; }
    if (ext_probe(isa_name, baseline_name, os_name, abi_name, exts, program.ok, "ext answered one") == 0) { ret 1; }
    if (ext_probe(isa_name, baseline_name, os_name, abi_name, exts, program.ok, "") == 0)                 { ret 0; }
    ret -1;
}

# `$mach.build.extensions.<name>` is 1 for an extension the target selects and 0
# for one it does not; it reads the selected isa's vocabulary only, so another
# isa's name is refused like an unknown one, never folded; a union of a riscv
# isa string and a manifest list answers for both
test build_extensions__answers_the_selected_isa_only {
    if (ext_answer("x86_64", "", "linux", "sysv64", "[\"sha\"]", "sha") != 1)     { ret 1; }
    if (ext_answer("x86_64", "", "linux", "sysv64", "[\"sha\"]", "sse41") != 0)   { ret 2; }
    if (ext_answer("x86_64", "", "linux", "sysv64", "[\"sha\"]", "sha2") != -1)   { ret 3; }
    if (ext_answer("x86_64", "", "linux", "sysv64", "[\"sha\"]", "m") != -1)      { ret 4; }
    if (ext_answer("x86_64", "", "linux", "sysv64", "", "sha") != 0)              { ret 5; }
    if (ext_answer("aarch64", "", "linux", "aapcs64", "[\"sha2\"]", "sha2") != 1) { ret 6; }
    if (ext_answer("aarch64", "", "linux", "aapcs64", "[\"sha2\"]", "sha") != -1) { ret 7; }
    if (ext_answer("aarch64", "", "linux", "aapcs64", "", "sha2") != 0)           { ret 8; }

    val unknown: str = "$if ($mach.build.extensions.avx9 == 1) { val X: u8 = 1; }\n";
    if (ext_probe("x86_64", "", "linux", "sysv64", "", unknown,
        "`$mach.build.extensions.avx9`: `avx9` is not an extension of isa 'x86_64'; its extensions are: ssse3, sse41, sha, fsgsbase, popcnt, lzcnt, bmi1, sse42, cx16, avx, avx2, bmi2, fma, movbe, f16c, avx512f, avx512bw, avx512cd, avx512dq, avx512vl, aes, pclmul") != 0) { ret 9; }
    if (ext_probe("aarch64", "", "linux", "aapcs64", "", "$if ($mach.build.extensions.sha == 1) { val X: u8 = 1; }\n",
        "`$mach.build.extensions.sha`: `sha` is not an extension of isa 'aarch64'; its extensions are: FEAT_SHA1, FEAT_SB, FEAT_AES, FEAT_PMULL") != 0) { ret 16; }
    if (ext_probe("x86_64", "", "linux", "sysv64", "", "val X: u8 = $mach.build.extensions;\n", "names one extension") != 0) { ret 10; }
    # `&&` does not guard the right-hand side: the path is checked on its own,
    # so another isa's name needs the nested form under an arch guard
    val one_line: str = "$if ($mach.build.arch == $mach.arch.x86_64 && $mach.build.extensions.sha == 1) { $error(\"guarded one\"); }\n";
    if (ext_probe("x86_64", "", "linux", "sysv64", "[\"sha\"]", one_line, "guarded one") != 0)                             { ret 17; }
    if (ext_probe("aarch64", "", "linux", "aapcs64", "[\"sha2\"]", one_line, "is not an extension of isa 'aarch64'") != 0) { ret 18; }
    val nested: str = "$if ($mach.build.arch == $mach.arch.x86_64) {\n    $if ($mach.build.extensions.sha == 1) { $error(\"guarded one\"); }\n}\n";
    if (ext_probe("x86_64", "", "linux", "sysv64", "[\"sha\"]", nested, "guarded one") != 0) { ret 19; }
    if (ext_probe("aarch64", "", "linux", "aapcs64", "[\"sha2\"]", nested, "") != 0)         { ret 20; }

    if (ext_answer("riscv64", "rv64i", "freestanding", "lp64", "[\"m\"]", "m") != 1)  { ret 11; }
    if (ext_answer("riscv64", "rv64i", "freestanding", "lp64", "[\"m\"]", "a") != 0)  { ret 12; }
    if (ext_answer("riscv64", "rv64ia", "freestanding", "lp64", "[\"m\"]", "a") != 1) { ret 13; }
    if (ext_answer("riscv64", "rv64i", "freestanding", "lp64", "", "m") != 0)         { ret 14; }
    if (ext_answer("riscv64", "rv64i", "freestanding", "lp64", "", "sha") != -1)      { ret 15; }
    # zkt is one vocabulary with the isa string: `_zkt` and the list select the same bit
    if (ext_answer("riscv64", "rv64gc_zkt", "freestanding", "lp64d", "", "zkt") != 1)      { ret 21; }
    if (ext_answer("riscv64", "rv64gc", "freestanding", "lp64d", "[\"zkt\"]", "zkt") != 1) { ret 22; }
    if (ext_answer("riscv64", "rv64gc", "freestanding", "lp64d", "", "zkt") != 0)          { ret 23; }
    if (ext_answer("x86_64", "", "linux", "sysv64", "", "zkt") != -1)                      { ret 24; }
    if (ext_answer("riscv64", "rv64gc", "freestanding", "lp64d", "[\"zkt\"]", "m") != 1)   { ret 25; }
    ret 0;
}

# a level is a bundle: selecting sse41 alone selects ssse3 with it, so the
# encoder admits pshufb and the comptime member answers 1, and on riscv d
# brings f brings zicsr. the selection is closed once, at target resolution
test extensions__selection_closes_over_implied {
    val shuffle: str = "fun f() { asm x86_64 { pshufb xmm0, xmm1 } }\n";
    if (ext_codegen("x86_64", "", "linux", "sysv64", "[\"sse41\"]", shuffle, "") != 0)                          { ret 1; }
    if (ext_codegen("x86_64", "", "linux", "sysv64", "", shuffle, "needs the `ssse3` extension") != 0)          { ret 2; }
    if (ext_codegen("x86_64", "", "linux", "sysv64", "[\"sha\"]", shuffle, "needs the `ssse3` extension") != 0) { ret 3; }
    if (ext_answer("x86_64", "", "linux", "sysv64", "[\"sse41\"]", "ssse3") != 1)                               { ret 4; }
    if (ext_answer("x86_64", "", "linux", "sysv64", "[\"ssse3\"]", "sse41") != 0)                               { ret 5; }
    if (ext_answer("riscv64", "rv64i", "freestanding", "lp64", "[\"d\"]", "f") != 1)                            { ret 6; }
    if (ext_answer("riscv64", "rv64i", "freestanding", "lp64", "[\"d\"]", "zicsr") != 1)                        { ret 7; }
    if (ext_answer("riscv64", "rv64i", "freestanding", "lp64", "[\"f\"]", "d") != 0)                            { ret 8; }
    ret 0;
}

# every name in every registered isa's vocabulary is one lexer identifier and
# no keyword: it is spelled in the manifest, as a comptime member, inside
# #[extensions(...)], in asm refusals and as a runtime feature field
test extensions__names_are_identifiers {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val reg:   *lang_target.TargetRegistry = toolchain.t_registry();
    var names: u32                         = 0;
    var i:     u32                         = 0;
    for (i < reg.isa.count) {
        val m: *target_model.Machine = reg.isa.members[i].model;
        var j: u32                   = 0;
        for (m.extension_table != nil && j < m.extension_table.count) {
            val name: str   = extension.row_name(m.extension_table, j);
            val len:  usize = str_len(name);
            if (!lexis.is_identifier(name, len)) { ret 2; }
            if (lexis.is_keyword(name, len))     { ret 3; }
            names = names + 1;
            j     = j + 1;
        }
        i = i + 1;
    }
    # x86_64 three, aarch64 one, and riscv's letters and z-extensions
    if (names < 12) { ret 4; }
    ret 0;
}

# `#[extensions(...)]` takes bare names some isa declares, each once, on a
# function with a body; a name only another isa declares admits nothing and is
# not an error, so one source serves every target
test extensions_decorator__checked_against_every_vocabulary {
    val x: str = "x86_64";
    val l: str = "linux";
    val a: str = "sysv64";
    if (ext_probe(x, "", l, a, "", "#[extensions(sha, sse41)]\nfun f() i32 { ret 0; }\n", "") != 0)                          { ret 1; }
    if (ext_probe(x, "", l, a, "", "#[extensions(sha2, zicsr)]\nfun f() i32 { ret 0; }\n", "") != 0)                         { ret 2; }
    if (ext_probe(x, "", l, a, "", "#[extensions(sha)]\nval V: i32 = 0;\n", "applies only to functions") != 0)               { ret 3; }
    if (ext_probe(x, "", l, a, "", "#[extensions(sha)]\next fun f() i32;\n", "applies only to a function with a body") != 0) { ret 4; }
    if (ext_probe(x, "", l, a, "", "#[extensions()]\nfun f() i32 { ret 0; }\n", "names at least one extension") != 0)        { ret 5; }
    if (ext_probe(x, "", l, a, "", "#[extensions(\"sha\")]\nfun f() i32 { ret 0; }\n", "bare extension names") != 0)         { ret 6; }
    if (ext_probe(x, "", l, a, "", "#[extensions(sha, sha)]\nfun f() i32 { ret 0; }\n", "names this extension twice") != 0)  { ret 7; }
    val unknown: str = "#[extensions(avx9)]\nfun f() i32 { ret 0; }\n";
    if (ext_probe(x, "", l, a, "", unknown,
        "`extensions` decorator: no extension catalog names `avx9` (read from masc's x86 catalog, ") != 0) { ret 8; }
    if (ext_probe(x, "", l, a, "", unknown, "ssse3, sse41, sha, fsgsbase, popcnt, lzcnt, bmi1") != 0)                          { ret 9; }
    if (ext_probe(x, "", l, a, "", unknown, "FEAT_SHA1") != 0)                                                                 { ret 10; }
    if (ext_probe("riscv64", "rv64i", "freestanding", "lp64", "", "#[extensions(m, sha)]\nfun f() i32 { ret 0; }\n", "") != 0) { ret 11; }
    # a row only a target selects is never a function's, on its own isa or another's
    if (ext_probe("riscv64", "rv64i", "freestanding", "lp64", "", "#[extensions(f)]\nfun f() i32 { ret 0; }\n",
        "`extensions` decorator: `f` is not a function's to admit, it selects the float register file and the calling convention's float registers for the whole target; select it with the target's `extensions` or isa string") != 0) { ret 12; }
    if (ext_probe("riscv64", "rv64i", "freestanding", "lp64", "", "#[extensions(d)]\nfun f() i32 { ret 0; }\n", "`d` is not a function's to admit") != 0)                                                           { ret 13; }
    if (ext_probe("riscv64", "rv64i", "freestanding", "lp64", "", "#[extensions(i)]\nfun f() i32 { ret 0; }\n", "it is the baseline every selection holds") != 0)                                                   { ret 14; }
    if (ext_probe("riscv64", "rv64i", "freestanding", "lp64", "", "#[extensions(c)]\nfun f() i32 { ret 0; }\n", "it is a code-size selection of the whole target; mach emits no compressed forms") != 0)            { ret 15; }
    if (ext_probe("riscv64", "rv64i", "freestanding", "lp64", "", "#[extensions(zkt)]\nfun f() i32 { ret 0; }\n", "`zkt` is not a function's to admit, it is a promise about the machine's execution timing") != 0) { ret 18; }
    if (ext_probe(x, "", l, a, "", "#[extensions(f)]\nfun f() i32 { ret 0; }\n", "`f` is not a function's to admit") != 0)                                                                                          { ret 16; }
    if (ext_probe(x, "", l, a, "", "#[extensions(zicsr, a)]\nfun f() i32 { ret 0; }\n", "") != 0)                                                                                                                   { ret 17; }
    ret 0;
}

# `{target.isa}` is the manifest's `isa` value as written, on every isa: the
# `extensions` list is part of the target's identity and of `{target.name}`,
# never of the isa placeholder, so `riscv64` on `rv64i` plus `["m"]` still expands
# to `riscv64`
#[testing]
fun ext_isa_placeholder(isa_name: str, baseline_name: str, os_name: str, abi_name: str, exts: str, want: str) i32 {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [1]str              = [1]str{"main.mach"};
    var texts:  [1]str              = [1]str{"fun f() i32 { ret 0; }\n"};
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, ext_manifest_on(?alloc, isa_name, baseline_name, os_name, abi_name, exts), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    var pick: manifest.Selectors              = manifest.t_selectors("", "t", "");
    val bp:   res[project.Project, fail.Fail] = driver.build_project(?s, root, ?pick);
    if (sel bp.err) { ret 3; }
    var p: project.Project = bp.ok;
    fin { project.dnit_project(?p); }
    val v: template.Values = driver_closure.cell_tmpl_vars(?p);
    if (!str_equals(v.isa, want)) { ret 4; }
    ret 0;
}

test target_isa_placeholder__omits_the_extensions_list {
    if (ext_isa_placeholder("riscv64", "rv64i", "freestanding", "lp64", "[\"m\"]", "riscv64") != 0) { ret 1; }
    if (ext_isa_placeholder("x86_64", "", "linux", "sysv64", "[\"sha\"]", "x86_64") != 0)           { ret 2; }
    ret 0;
}

# the manifest key is an array of identifiers, each listed once, and the
# selected isa refuses a name its vocabulary does not hold, naming the ones it
# does; d alone is fine, it brings f and zicsr
test manifest_extensions__checked_against_the_isa_vocabulary {
    val ok: str = "fun f() i32 { ret 0; }\n";
    if (ext_probe("x86_64", "", "linux", "sysv64", "[\"sha\", \"ssse3\", \"sse41\"]", ok, "") != 0) { ret 1; }
    if (ext_probe("x86_64", "", "linux", "sysv64", "[\"sha2\"]", ok,
        "`sha2` is not an extension or level of isa 'x86_64'; its extensions are: ssse3, sse41, sha, fsgsbase, popcnt, lzcnt, bmi1, sse42, cx16, avx, avx2, bmi2, fma, movbe, f16c, avx512f, avx512bw, avx512cd, avx512dq, avx512vl, aes, pclmul; its levels are: x86-64-v2, x86-64-v3, x86-64-v4") != 0) { ret 2; }
    if (ext_probe("aarch64", "", "linux", "aapcs64", "[\"sha\"]", ok,
        "`sha` is not an extension or level of isa 'aarch64'; its extensions are: FEAT_SHA1, FEAT_SB, FEAT_AES, FEAT_PMULL, FEAT_FP16") != 0) { ret 3; }
    if (ext_probe("x86_64", "", "linux", "sysv64", "[\"sse4.1\"]", ok, "is not an extension name or level") != 0) { ret 4; }
    # a level is a manifest spelling that expands to its members, beside names
    # or alone, and an unknown level names the known ones
    if (ext_probe("x86_64", "", "linux", "sysv64", "[\"x86-64-v2\", \"sha\"]", ok, "") != 0) { ret 8; }
    if (ext_probe("x86_64", "", "linux", "sysv64", "[\"x86-64-v5\"]", ok,
        "`x86-64-v5` is not an extension or level of isa 'x86_64'; its extensions are: ssse3, sse41, sha, fsgsbase, popcnt, lzcnt, bmi1, sse42, cx16, avx, avx2, bmi2, fma, movbe, f16c, avx512f, avx512bw, avx512cd, avx512dq, avx512vl, aes, pclmul; its levels are: x86-64-v2, x86-64-v3, x86-64-v4") != 0) { ret 9; }
    if (ext_probe("aarch64", "", "linux", "aapcs64", "[\"x86-64-v2\"]", ok,
        "`x86-64-v2` is not an extension or level of isa 'aarch64'; its extensions are: FEAT_SHA1, FEAT_SB, FEAT_AES, FEAT_PMULL, FEAT_FP16") != 0) { ret 10; }
    if (ext_answer("x86_64", "", "linux", "sysv64", "[\"x86-64-v3\"]", "avx2") != 1)                              { ret 11; }
    if (ext_answer("x86_64", "", "linux", "sysv64", "[\"x86-64-v3\"]", "sse41") != 1)                             { ret 12; }
    if (ext_answer("x86_64", "", "linux", "sysv64", "[\"x86-64-v2\"]", "avx") != 0)                               { ret 13; }
    if (ext_probe("x86_64", "", "linux", "sysv64", "[\"sha\", \"sha\"]", ok, "lists \"sha\" twice") != 0)         { ret 5; }
    if (ext_probe("x86_64", "", "linux", "sysv64", "\"sha\"", ok, "extensions must be an array of strings") != 0) { ret 6; }
    if (ext_probe("riscv64", "rv64i", "freestanding", "lp64", "[\"d\"]", ok, "") != 0)                            { ret 7; }
    ret 0;
}
