use mach.lang.fail;
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use target_of: mach.lang.target.of;
use mach.lang.target.of.bin;
use of_reloc: mach.lang.target.of.reloc;

pub fun is_local_got_kind(kind: target_of.RelocKind) bool {
    ret kind == target_of.RK_GOT_PCREL_HI20;
}

fun is_pcrel_high(kind: target_of.RelocKind) bool {
    ret kind == target_of.RK_PCREL_HI20 || kind == target_of.RK_GOT_PCREL_HI20;
}

val ROW_COUNT: usize                   = 9;
val ROWS:      [ROW_COUNT]of_reloc.Row = [ROW_COUNT]of_reloc.Row{
    of_reloc.Row{kind: target_of.RK_ABS64, width: 8, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: of_reloc.site_abs64},
    of_reloc.Row{kind: target_of.RK_ABS32, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: of_reloc.site_abs32},
    of_reloc.Row{kind: target_of.RK_PC32, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: of_reloc.site_pcrel32},
    of_reloc.Row{kind: target_of.RK_PLT32, width: 8, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: call_pair},
    of_reloc.Row{kind: target_of.RK_PCREL_HI20, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: pcrel_hi20},
    of_reloc.Row{kind: target_of.RK_GOT_PCREL_HI20, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: pcrel_hi20},
    of_reloc.Row{kind: target_of.RK_PCREL_LO12_I, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: pcrel_lo12_i},
    of_reloc.Row{kind: target_of.RK_PCREL_LO12_S, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: pcrel_lo12_s},
    of_reloc.Row{kind: target_of.RK_JAL20, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: jal20},
};

pub fun reloc_traits(kind: target_of.RelocKind,
    section_kind: target_of.SectionKind,
    codegen_image: bool) res[of_reloc.RelocTraits, of_reloc.RelocError] {
    ret of_reloc.table_traits(?ROWS[0], ROW_COUNT, kind, section_kind, codegen_image);
}

pub fun apply_reloc(kind: target_of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
    target: of_reloc.RelocTarget, addend: i64, patch_va: u64,
    image_base: u64) res[bool, of_reloc.RelocError] {
    ret of_reloc.table_apply(?ROWS[0], ROW_COUNT, kind, dst, patch_off, sec_len, target, addend, patch_va, image_base);
}

# auipc and jalr: a call's 32-bit pc-relative pair
fun call_pair(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 8 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val displaced: res[i64, of_reloc.RelocError] =
        of_reloc.displacement(s.target.vaddr, s.addend, s.patch_va);
    if (sel displaced.err) {
        ret res[bool, of_reloc.RelocError].err{displaced.err};
    }
    val delta: i64 = displaced.ok;
    if (!pcrel32_ok(delta)) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val auipc: u32 = bin.read_u32_le(s.dst, s.patch_off::usize);
    bin.write_u32_le(s.dst, s.patch_off::usize, set_hi20(auipc, delta));
    val jalr: u32 = bin.read_u32_le(s.dst, (s.patch_off + 4)::usize);
    bin.write_u32_le(s.dst, (s.patch_off + 4)::usize, set_lo12_i(jalr, delta));
    ret res[bool, of_reloc.RelocError].ok{true};
}

# auipc: the high 20 bits of a pc-relative address
fun pcrel_hi20(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 4 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val word: u32 = bin.read_u32_le(s.dst, s.patch_off::usize);
    if (s.kind == target_of.RK_GOT_PCREL_HI20 && s.addend != 0) { ret res[bool, of_reloc.RelocError].err{of_reloc.UNSUPPORTED}; }
    val displaced: res[i64, of_reloc.RelocError] =
        of_reloc.displacement(s.target.vaddr, s.addend, s.patch_va);
    if (sel displaced.err) {
        ret res[bool, of_reloc.RelocError].err{displaced.err};
    }
    val delta: i64 = displaced.ok;
    if (!pcrel32_ok(delta)) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    bin.write_u32_le(s.dst, s.patch_off::usize, set_hi20(word, delta));
    ret res[bool, of_reloc.RelocError].ok{true};
}

# an i-type: the low 12 bits of a pc-relative address
fun pcrel_lo12_i(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 4 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val word:      u32                           = bin.read_u32_le(s.dst, s.patch_off::usize);
    val displaced: res[i64, of_reloc.RelocError] =
        of_reloc.displacement(s.target.vaddr, s.addend, s.patch_va);
    if (sel displaced.err) {
        ret res[bool, of_reloc.RelocError].err{displaced.err};
    }
    val delta: i64 = displaced.ok;
    bin.write_u32_le(s.dst, s.patch_off::usize, set_lo12_i(word, delta));
    ret res[bool, of_reloc.RelocError].ok{true};
}

# an s-type: the low 12 bits of a pc-relative address
fun pcrel_lo12_s(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 4 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val word:      u32                           = bin.read_u32_le(s.dst, s.patch_off::usize);
    val displaced: res[i64, of_reloc.RelocError] =
        of_reloc.displacement(s.target.vaddr, s.addend, s.patch_va);
    if (sel displaced.err) {
        ret res[bool, of_reloc.RelocError].err{displaced.err};
    }
    val delta: i64 = displaced.ok;
    bin.write_u32_le(s.dst, s.patch_off::usize, set_lo12_s(word, delta));
    ret res[bool, of_reloc.RelocError].ok{true};
}

# jal: a signed 20-bit pc-relative displacement
fun jal20(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 4 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val word:      u32                           = bin.read_u32_le(s.dst, s.patch_off::usize);
    val displaced: res[i64, of_reloc.RelocError] =
        of_reloc.displacement(s.target.vaddr, s.addend, s.patch_va);
    if (sel displaced.err) {
        ret res[bool, of_reloc.RelocError].err{displaced.err};
    }
    val delta: i64 = displaced.ok;
    if (!jal20_ok(delta)) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    bin.write_u32_le(s.dst, s.patch_off::usize, set_jal20(word, delta));
    ret res[bool, of_reloc.RelocError].ok{true};
}

fun pcrel32_ok(delta: i64) bool {
    ret delta >= -2147485696 && delta <= 2147481599;
}

fun set_hi20(word: u32, delta: i64) u32 {
    val hi20: u32 = (((delta + 0x800) >> 12)::u64 & 0xFFFFF)::u32;
    ret (word & 0xFFF) | (hi20 << 12);
}

fun set_lo12_i(word: u32, delta: i64) u32 {
    val lo12: u32 = (delta::u64 & 0xFFF)::u32;
    ret (word & 0x000FFFFF) | (lo12 << 20);
}

fun set_lo12_s(word: u32, delta: i64) u32 {
    val lo12: u32 = (delta::u64 & 0xFFF)::u32;
    ret (word & 0x01FFF07F) | ((lo12 >> 5) << 25) | ((lo12 & 0x1F) << 7);
}

pub fun jal20_ok(delta: i64) bool {
    ret delta >= -1048576 && delta <= 1048574 && (delta & 1) == 0;
}

# the j-type immediate: imm[20] at 31, imm[10:1] at 30:21, imm[11] at 20, imm[19:12] at 19:12
pub fun set_jal20(word: u32, delta: i64) u32 {
    val imm: u32 = (delta::u64 & 0x1FFFFF)::u32;
    ret (word & 0xFFF) | (((imm >> 20) & 0x1) << 31) | (((imm >> 1) & 0x3FF) << 21)
        | (((imm >> 11) & 0x1) << 20) | (((imm >> 12) & 0xFF) << 12);
}

fun is_pcrel_low(kind: target_of.RelocKind) bool {
    ret kind == target_of.RK_PCREL_LO12_I || kind == target_of.RK_PCREL_LO12_S;
}

fun pcrel_location_key(section: u32, offset: u32) u64 {
    ret (section::u64 << 32) | offset::u64;
}

fun validate_pcrel_pair(img: *target_of.ObjectImage, low_index: u32,
    high_index: u32) err[fail.Fail] {
    if (low_index >= img.reloc_count || high_index >= img.reloc_count) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative relocation pair index is out of range")};
    }
    val low:  *target_of.Relocation = ?img.relocations[low_index];
    val high: *target_of.Relocation = ?img.relocations[high_index];
    if (!is_pcrel_low(low.kind) || !is_pcrel_high(high.kind)) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation does not pair with a high relocation")};
    }
    if (low.sym == target_of.SYMBOL_NONE || low.sym >= img.symbol_count) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation refers to an absent label symbol")};
    }
    if (high.sym == target_of.SYMBOL_NONE || high.sym >= img.symbol_count) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative high relocation refers to an absent target symbol")};
    }
    if (high.kind == target_of.RK_GOT_PCREL_HI20 && high.addend != 0) {
        ret err[fail.Fail].err{fail.message("riscv: GOT high relocation requires a zero addend")};
    }
    val label: *target_of.Symbol = ?img.symbols[low.sym];
    if (label.flags != 0 || low.addend != 0 || !target_of.section_same(label.section, low.section)) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation is not a local zero-addend label reference")};
    }
    if (!target_of.section_same(high.section, label.section) || high.offset != label.offset) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation label does not identify its paired high relocation")};
    }
    val adjusted: res[i64, of_reloc.RelocError] =
        of_reloc.displacement(low.offset::u64, high.addend, high.offset::u64);
    if (sel adjusted.err) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative relocation pair addend is outside the signed 64-bit range")};
    }
    ret err[fail.Fail].ok{};
}

pub fun resolve_pcrel_pairs(alloc: *A.Allocator,
    img: *target_of.ObjectImage) err[fail.Fail] {
    if (img == nil) {
        ret err[fail.Fail].err{fail.message("riscv: cannot normalize a nil object image")};
    }
    var unpaired: u32 = 0;
    var i:        u32 = 0;
    for (i < img.reloc_count) {
        if (img.relocations[i].kind == target_of.RK_GOT_PCREL_HI20 && img.relocations[i].addend != 0) {
            ret err[fail.Fail].err{fail.message("riscv: GOT high relocation requires a zero addend")};
        }
        if (is_pcrel_low(img.relocations[i].kind)) {
            if (img.relocations[i].pair == 0) { unpaired = unpaired + 1; }
            or {
                val vr: err[fail.Fail] =
                    validate_pcrel_pair(img, i, img.relocations[i].pair - 1);
                if (sel vr.err) { ret vr; }
            }
        }
        i = i + 1;
    }
    if (unpaired == 0) { ret err[fail.Fail].ok{}; }
    if (alloc == nil) {
        ret err[fail.Fail].err{fail.message("riscv: pc-relative pair indexing requires an allocator")};
    }

    var highs: map.Map[u64, u32] = map.init[u64, u32](alloc);
    fin { map.dnit[u64, u32](?highs); }

    i = 0;
    for (i < img.reloc_count) {
        if (is_pcrel_high(img.relocations[i].kind)) {
            val key: u64 = pcrel_location_key(target_of.section_index(img.relocations[i].section),
                img.relocations[i].offset);
            val prior: opt[*u32] = map.get[u64, u32](?highs, ?key);
            if (sel prior.some) {
                @prior.some = 0;
            }
            if (sel prior.none) {
                val inserted: res[bool, A.Error] = map.insert[u64, u32](?highs, key, i + 1);
                if (sel inserted.err) {
                    ret err[fail.Fail].err{fail.message("riscv: could not allocate the pc-relative relocation pair index")};
                }
            }
        }
        i = i + 1;
    }

    i = 0;
    for (i < img.reloc_count) {
        val low: *target_of.Relocation = ?img.relocations[i];
        if (!is_pcrel_low(low.kind) || low.pair != 0) {
            i = i + 1;
            cnt;
        }
        if (low.sym == target_of.SYMBOL_NONE || low.sym >= img.symbol_count) {
            ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation refers to an absent label symbol")};
        }
        val label: *target_of.Symbol = ?img.symbols[low.sym];
        if (label.flags != 0 || low.addend != 0 || !target_of.section_same(label.section, low.section)) {
            ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation is not a local zero-addend label reference")};
        }
        val key:   u64       = pcrel_location_key(target_of.section_index(label.section), label.offset);
        val found: opt[*u32] = map.get[u64, u32](?highs, ?key);
        if (sel found.none) {
            ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation has no matching high relocation")};
        }
        val encoded: u32 = @found.some;
        if (encoded == 0) {
            ret err[fail.Fail].err{fail.message("riscv: pc-relative low relocation has ambiguous matching high relocations")};
        }
        val vr: err[fail.Fail] = validate_pcrel_pair(img, i, encoded - 1);
        if (sel vr.err) { ret vr; }
        i = i + 1;
    }

    i = 0;
    for (i < img.reloc_count) {
        val low: *target_of.Relocation = ?img.relocations[i];
        if (is_pcrel_low(low.kind) && low.pair == 0) {
            val label: *target_of.Symbol = ?img.symbols[low.sym];
            val key:   u64               = pcrel_location_key(target_of.section_index(label.section), label.offset);
            val found: opt[*u32]         = map.get[u64, u32](?highs, ?key);
            if (sel found.none) { ret err[fail.Fail].err{fail.message("riscv: a pcrel low relocation names a label without a paired high relocation")}; }
            low.pair = @found.some;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun resolve_reloc_operand(img: *target_of.ObjectImage,
    reloc_index: u32) res[target_of.RelocOperand, fail.Fail] {
    if (img == nil || reloc_index >= img.reloc_count) {
        ret res[target_of.RelocOperand, fail.Fail].err{fail.message("riscv: relocation operand index is out of range")};
    }
    val low:     *target_of.Relocation = ?img.relocations[reloc_index];
    var operand: target_of.RelocOperand;
    if (low.kind == target_of.RK_GOT_PCREL_HI20 && low.addend != 0) {
        ret res[target_of.RelocOperand, fail.Fail].err{fail.message("riscv: GOT high relocation requires a zero addend")};
    }
    operand.target_kind = low.kind;
    operand.sym         = low.sym;
    operand.addend      = low.addend;
    if (!is_pcrel_low(low.kind)) { ret res[target_of.RelocOperand, fail.Fail].ok{operand}; }
    if (low.pair == 0) {
        ret res[target_of.RelocOperand, fail.Fail].err{fail.message("riscv: pc-relative low relocation was not paired before application")};
    }
    val high_index: u32            = low.pair - 1;
    val vr:         err[fail.Fail] = validate_pcrel_pair(img, reloc_index, high_index);
    if (sel vr.err) {
        ret res[target_of.RelocOperand, fail.Fail].err{vr.err};
    }
    val adjusted: res[i64, of_reloc.RelocError] = of_reloc.displacement(
        low.offset::u64, img.relocations[high_index].addend,
        img.relocations[high_index].offset::u64);
    if (sel adjusted.err) {
        ret res[target_of.RelocOperand, fail.Fail].err{fail.message("riscv: a pcrel pair displacement does not fit its addend")};
    }
    operand.target_kind = img.relocations[high_index].kind;
    operand.sym         = img.relocations[high_index].sym;
    operand.addend      = adjusted.ok;
    ret res[target_of.RelocOperand, fail.Fail].ok{operand};
}
