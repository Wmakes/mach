# MIR lowered to riscv instructions, with the frame each function lays out
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.intern;
use lang_mir: mach.lang.mir;
use mach.lang.target.extension;
use extension_riscv: mach.lang.target.extension.riscv;
use mach.lang.target.isa;
use mach.lang.target.isa.common;
use isa_effect:    mach.lang.target.isa.effect;
use isa_encode:    mach.lang.target.isa.encode;
use isa_inst:      mach.lang.target.isa.inst;
use isa_riscv:     mach.lang.target.isa.riscv;
use riscv_effects: mach.lang.target.isa.riscv.effects;
use riscv_emit:    mach.lang.target.isa.riscv.emit;
use riscv_grammar: mach.lang.target.isa.riscv.grammar;
use mach.lang.target.isa.riscv.inst;
use riscv_printer: mach.lang.target.isa.riscv.printer;
use target_of:     mach.lang.target.of;

fun req_gpr(op: *lang_mir.MirOperand) res[i32, fail.Fail] {
    if (op.kind == lang_mir.MIR_OP_PREG) {
        if (isa_inst.regid_class(lang_mir.preg_regid(op.preg)) != isa_inst.REG_CLASS_ID_GP) {
            ret res[i32, fail.Fail].err{fail.message("internal compiler error: a float register reached a general-purpose operand position")};
        }
        ret res[i32, fail.Fail].ok{isa_inst.regid_index(lang_mir.preg_regid(op.preg))};
    }
    if (op.kind == lang_mir.MIR_OP_VREG) {
        ret res[i32, fail.Fail].err{fail.message("encode: virtual register survived register allocation")};
    }
    ret res[i32, fail.Fail].err{fail.message("encode: expected a register operand")};
}

fun imm_sext_for_width(value: i64, width: u8) i64 {
    if (width != 4) { ret value; }
    var x: i64 = value & 0xFFFFFFFF;
    if ((x & 0x80000000) != 0) { x = x - 0x100000000; }
    ret x;
}

fun resolve_source(st: *isa_encode.EncodeState, op: *lang_mir.MirOperand, scratch: u32, width: u8) res[i32, fail.Fail] {
    if (op.kind == lang_mir.MIR_OP_IMM) {
        riscv_emit.li(st, scratch, imm_sext_for_width(op.imm, width));
        ret res[i32, fail.Fail].ok{scratch::i32};
    }
    ret req_gpr(op);
}

fun emit_addi(st: *isa_encode.EncodeState, rd: u32, rs1: u32, off: i64) {
    if (off >= -2048 && off <= 2047) {
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_ADD, rd, rs1, off::u32 & 0xFFF);
        ret;
    }
    riscv_emit.li(st, riscv_emit.SCRATCH, off);
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_ZERO, rd, rs1, riscv_emit.SCRATCH);
}

fun emit_mem_access(st: *isa_encode.EncodeState, rt: u32, base: u32, off: i64, width: u8, is_load: bool) err[fail.Fail] {
    val f3r: res[u32, fail.Fail] = riscv_emit.int_mem_funct3(width, is_load);
    if (sel f3r.err) { ret err[fail.Fail].err{f3r.err}; }
    val f3: u32 = f3r.ok;
    var b:  u32 = base;
    var d:  i64 = off;
    if (off < -2048 || off > 2047) {
        riscv_emit.li(st, riscv_emit.SCRATCH2, off);
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_ZERO, riscv_emit.SCRATCH2, base, riscv_emit.SCRATCH2);
        b = riscv_emit.SCRATCH2;
        d = 0;
    }
    if (is_load) {
        riscv_emit.i_type(st, riscv_emit.OPC_LOAD, f3, rt, b, d::u32 & 0xFFF);
        ret err[fail.Fail].ok{};
    }
    riscv_emit.s_type(st, riscv_emit.OPC_STORE, f3, b, rt, d::u32 & 0xFFF);
    ret err[fail.Fail].ok{};
}

rec Mem {
    base:      u32;
    off:       i64;
    has_index: bool;
    index:     u32;
    scale:     u8;
}

fun resolve_mem(f: *lang_mir.MirFunction, op: *lang_mir.MirOperand) res[Mem, fail.Fail] {
    if (op.kind != lang_mir.MIR_OP_MEM) {
        ret res[Mem, fail.Fail].err{fail.message("encode: expected a memory operand")};
    }
    var m: Mem;
    m.has_index = false;
    m.index     = 0;
    m.scale     = 0;
    if (sel op.index.vreg) {
        ret res[Mem, fail.Fail].err{fail.message("encode: value vreg survived in a memory-operand index")};
    }
    if (sel op.index.preg) {
        m.has_index = true;
        m.index     = isa_inst.regid_index(lang_mir.preg_regid(op.index.preg))::u32;
        m.scale     = op.scale;
    }
    if (!lang_mir.vreg_is_nil(op.vreg)) {
        val slot: opt[i64] = lang_mir.slot_base_offset(?f.frame, op.vreg.n);
        if (!sel slot.some) {
            ret res[Mem, fail.Fail].err{fail.message("encode: value vreg survived in a memory-operand base")};
        }
        m.base = isa_encode.slot_base_reg(f, isa_riscv.SP, isa_riscv.FP)::u32;
        m.off  = slot.some + op.imm;
        ret res[Mem, fail.Fail].ok{m};
    }
    m.base = isa_inst.regid_index(lang_mir.preg_regid(op.preg))::u32;
    m.off  = op.imm;
    ret res[Mem, fail.Fail].ok{m};
}

fun scale_shift(scale: u8) res[u32, fail.Fail] {
    if (scale == 1) { ret res[u32, fail.Fail].ok{0}; }
    if (scale == 2) { ret res[u32, fail.Fail].ok{1}; }
    if (scale == 4) { ret res[u32, fail.Fail].ok{2}; }
    if (scale == 8) { ret res[u32, fail.Fail].ok{3}; }
    ret res[u32, fail.Fail].err{fail.message("encode: a scaled-index address must have a scale of 1, 2, 4, or 8")};
}

fun encode_alu3(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr, funct3: u32, funct7: u32, word_form: bool) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: ALU op missing operands")}; }

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], riscv_emit.SCRATCH2, mi.width);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rs1: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[2], riscv_emit.SCRATCH, mi.width);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rs2: u32 = rmr.ok::u32;

    var opcode: u32 = riscv_emit.OPC_OP;
    if (word_form) { opcode = riscv_emit.alu_opcode(mi.width, riscv_emit.xlen(st)); }
    riscv_emit.r_type(st, opcode, funct3, funct7, rd, rs1, rs2);
    ret err[fail.Fail].ok{};
}

fun encode_addsub(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr, is_sub: bool) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: add/sub missing operands")}; }

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], riscv_emit.SCRATCH2, mi.width);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rs1: u32 = rnr.ok::u32;

    val rhs: *lang_mir.MirOperand = ?mi.operands[2];
    if (rhs.kind == lang_mir.MIR_OP_IMM) {
        var v: i64 = rhs.imm;
        if (is_sub) { v = 0 - v; }
        if (v >= -2048 && v <= 2047) {
            riscv_emit.i_type(st, riscv_emit.alu_imm_opcode(mi.width, riscv_emit.xlen(st)), riscv_emit.F3_ADD, rd, rs1, v::u32 & 0xFFF);
            ret err[fail.Fail].ok{};
        }
    }

    val rmr: res[i32, fail.Fail] = resolve_source(st, rhs, riscv_emit.SCRATCH, mi.width);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rs2: u32 = rmr.ok::u32;

    var f7: u32 = riscv_emit.F7_ZERO;
    if (is_sub) { f7 = riscv_emit.F7_SUB; }
    riscv_emit.r_type(st, riscv_emit.alu_opcode(mi.width, riscv_emit.xlen(st)), riscv_emit.F3_ADD, f7, rd, rs1, rs2);
    ret err[fail.Fail].ok{};
}

fun encode_shift(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr, funct3: u32, is_arith: bool) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: shift missing operands")}; }

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], riscv_emit.SCRATCH2, mi.width);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rs1: u32 = rnr.ok::u32;

    val rhs: *lang_mir.MirOperand = ?mi.operands[2];
    if (rhs.kind == lang_mir.MIR_OP_IMM) {
        var mask: u32 = 0x3F;
        if (mi.width == 4) { mask = 0x1F; }
        var imm: u32 = rhs.imm::u32 & mask;
        if (is_arith) { imm = imm | 0x400; }
        riscv_emit.i_type(st, riscv_emit.alu_imm_opcode(mi.width, riscv_emit.xlen(st)), funct3, rd, rs1, imm);
        ret err[fail.Fail].ok{};
    }

    val rmr: res[i32, fail.Fail] = req_gpr(rhs);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rs2: u32 = rmr.ok::u32;

    var f7: u32 = riscv_emit.F7_ZERO;
    if (is_arith) { f7 = riscv_emit.F7_SUB; }
    riscv_emit.r_type(st, riscv_emit.alu_opcode(mi.width, riscv_emit.xlen(st)), funct3, f7, rd, rs1, rs2);
    ret err[fail.Fail].ok{};
}

fun encode_neg(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: neg missing operands")}; }
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd:  u32                 = rdr.ok::u32;
    val rsr: res[i32, fail.Fail] = req_gpr(?mi.operands[1]);
    if (sel rsr.err) { ret err[fail.Fail].err{rsr.err}; }
    val rs: u32 = rsr.ok::u32;
    riscv_emit.r_type(st, riscv_emit.alu_opcode(mi.width, riscv_emit.xlen(st)), riscv_emit.F3_ADD, riscv_emit.F7_SUB, rd, riscv_emit.RZERO, rs);
    ret err[fail.Fail].ok{};
}

fun encode_not(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: not missing operands")}; }
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd:  u32                 = rdr.ok::u32;
    val rsr: res[i32, fail.Fail] = req_gpr(?mi.operands[1]);
    if (sel rsr.err) { ret err[fail.Fail].err{rsr.err}; }
    val rs: u32 = rsr.ok::u32;
    riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_XOR, rd, rs, 0xFFF);
    ret err[fail.Fail].ok{};
}

fun encode_mov(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: mov missing operands")}; }
    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    val src: *lang_mir.MirOperand = ?mi.operands[1];

    if (dst.kind == lang_mir.MIR_OP_MEM) {
        ret emit_store_mem(st, f, dst, src, mi.width);
    }

    val rdr: res[i32, fail.Fail] = req_gpr(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    if (src.kind == lang_mir.MIR_OP_MEM) {
        val mr: res[Mem, fail.Fail] = resolve_mem(f, src);
        if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
        val m: Mem = mr.ok;
        ret emit_mem_access(st, rd, m.base, m.off, mi.width, true);
    }
    if (src.kind == lang_mir.MIR_OP_IMM) {
        riscv_emit.li(st, rd, imm_sext_for_width(src.imm, mi.width));
        ret err[fail.Fail].ok{};
    }

    val rsr: res[i32, fail.Fail] = req_gpr(src);
    if (sel rsr.err) { ret err[fail.Fail].err{rsr.err}; }
    val rs: u32 = rsr.ok::u32;
    riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_ADD, rd, rs, 0);
    ret err[fail.Fail].ok{};
}

fun emit_store_mem(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, dst_mem: *lang_mir.MirOperand, val_op: *lang_mir.MirOperand, width: u8) err[fail.Fail] {
    if (reg_is_fp(val_op)) {
        if (dst_mem.kind == lang_mir.MIR_OP_SYM) {
            ret err[fail.Fail].err{fail.message("encode: float store to a folded-global symbol is unsupported")};
        }
        val rr: res[i32, fail.Fail] = req_fpr(val_op);
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        ret emit_fp_slot_store(st, f, dst_mem, rr.ok::u32, width);
    }
    if (is_fp_slot(f, val_op)) {
        if (dst_mem.kind == lang_mir.MIR_OP_SYM) {
            ret err[fail.Fail].err{fail.message("encode: float store to a folded-global symbol is unsupported")};
        }
        val ldr: err[fail.Fail] = emit_fp_slot_load(st, f, val_op, riscv_emit.FP_SCRATCH, width);
        if (sel ldr.err) { ret ldr; }
        ret emit_fp_slot_store(st, f, dst_mem, riscv_emit.FP_SCRATCH, width);
    }
    if (dst_mem.kind == lang_mir.MIR_OP_SYM) {
        ret emit_global_store(st, dst_mem, val_op, width);
    }
    val mr: res[Mem, fail.Fail] = resolve_mem(f, dst_mem);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;

    var rt: u32 = riscv_emit.RZERO;
    if (val_op.kind == lang_mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            riscv_emit.li(st, riscv_emit.SCRATCH, val_op.imm);
            rt = riscv_emit.SCRATCH;
        }
    }
    or {
        val rr: res[i32, fail.Fail] = req_gpr(val_op);
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        rt = rr.ok::u32;
    }
    ret emit_mem_access(st, rt, m.base, m.off, width, false);
}

fun emit_global_addr(st: *isa_encode.EncodeState, rd: u32, symop: *lang_mir.MirOperand) err[fail.Fail] {
    if (intern.str_is_nil(symop.sym)) {
        ret err[fail.Fail].err{fail.message("encode: address-of has no resolved symbol name")};
    }
    val hr: err[fail.Fail] = riscv_emit.pcrel_hi(st, rd, symop.sym, symop.sym_off);
    if (sel hr.err) { ret hr; }
    val lo_pos: u32 = st.buf.bytes.len::u32;
    riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_ADD, rd, rd, 0);
    riscv_emit.note_sym_target(st, symop.sym, isa_inst.SYM_MOD_PCREL_LO, 0);
    ret riscv_emit.push_pcrel_lo(st, lo_pos, target_of.RK_PCREL_LO12_I, symop.sym);
}

# an import's address, read from its GOT slot, then the operand's offset added
# through tmp when it does not fit an addi
fun emit_global_addr_got(st: *isa_encode.EncodeState, rd: u32, tmp: u32, symop: *lang_mir.MirOperand) err[fail.Fail] {
    if (intern.str_is_nil(symop.sym)) {
        ret err[fail.Fail].err{fail.message("encode: GOT address-of has no resolved symbol name")};
    }
    val f3r: res[u32, fail.Fail] = riscv_emit.int_mem_funct3(st.model.pointer_width::u8, true);
    if (sel f3r.err) { ret err[fail.Fail].err{f3r.err}; }
    val hr: err[fail.Fail] = riscv_emit.got_hi(st, rd, symop.sym);
    if (sel hr.err) { ret hr; }
    val lo_pos: u32 = st.buf.bytes.len::u32;
    riscv_emit.i_type(st, riscv_emit.OPC_LOAD, f3r.ok, rd, rd, 0);
    riscv_emit.note_sym_target(st, symop.sym, isa_inst.SYM_MOD_PCREL_LO, 0);
    val lr: err[fail.Fail] = riscv_emit.push_pcrel_lo_of(st, lo_pos, target_of.RK_PCREL_LO12_I, target_of.RK_GOT_PCREL_HI20, symop.sym);
    if (sel lr.err)         { ret lr; }
    if (symop.sym_off == 0) { ret err[fail.Fail].ok{}; }
    if (symop.sym_off >= -2048 && symop.sym_off <= 2047) {
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_ADD, rd, rd, symop.sym_off::u32 & 0xFFF);
        ret err[fail.Fail].ok{};
    }
    riscv_emit.li(st, tmp, symop.sym_off);
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_ZERO, rd, rd, tmp);
    ret err[fail.Fail].ok{};
}

fun emit_global_load(st: *isa_encode.EncodeState, rt: u32, symop: *lang_mir.MirOperand, width: u8) err[fail.Fail] {
    if (symop.sym_got) {
        val ar: err[fail.Fail] = emit_global_addr_got(st, riscv_emit.SCRATCH, riscv_emit.SCRATCH2, symop);
        if (sel ar.err) { ret ar; }
        ret emit_mem_access(st, rt, riscv_emit.SCRATCH, 0, width, true);
    }
    if (intern.str_is_nil(symop.sym)) {
        ret err[fail.Fail].err{fail.message("encode: folded-global load has no resolved symbol name")};
    }
    val f3r: res[u32, fail.Fail] = riscv_emit.int_mem_funct3(width, true);
    if (sel f3r.err) { ret err[fail.Fail].err{f3r.err}; }
    val hr: err[fail.Fail] = riscv_emit.pcrel_hi(st, riscv_emit.SCRATCH, symop.sym, symop.sym_off);
    if (sel hr.err) { ret hr; }
    val lo_pos: u32 = st.buf.bytes.len::u32;
    riscv_emit.i_type(st, riscv_emit.OPC_LOAD, f3r.ok, rt, riscv_emit.SCRATCH, 0);
    riscv_emit.note_sym_target(st, symop.sym, isa_inst.SYM_MOD_PCREL_LO, 0);
    ret riscv_emit.push_pcrel_lo(st, lo_pos, target_of.RK_PCREL_LO12_I, symop.sym);
}

fun emit_global_store(st: *isa_encode.EncodeState, symop: *lang_mir.MirOperand, val_op: *lang_mir.MirOperand, width: u8) err[fail.Fail] {
    if (intern.str_is_nil(symop.sym)) {
        ret err[fail.Fail].err{fail.message("encode: folded-global store has no resolved symbol name")};
    }
    val f3r: res[u32, fail.Fail] = riscv_emit.int_mem_funct3(width, false);
    if (sel f3r.err) { ret err[fail.Fail].err{f3r.err}; }
    # the slot's address is read before the value takes SCRATCH2
    if (symop.sym_got) {
        val ar: err[fail.Fail] = emit_global_addr_got(st, riscv_emit.SCRATCH, riscv_emit.SCRATCH2, symop);
        if (sel ar.err) { ret ar; }
    }
    var rt: u32 = riscv_emit.RZERO;
    if (val_op.kind == lang_mir.MIR_OP_IMM) {
        if (val_op.imm != 0) {
            riscv_emit.li(st, riscv_emit.SCRATCH2, val_op.imm);
            rt = riscv_emit.SCRATCH2;
        }
    }
    or {
        val rr: res[i32, fail.Fail] = req_gpr(val_op);
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        rt = rr.ok::u32;
    }
    if (symop.sym_got) {
        riscv_emit.s_type(st, riscv_emit.OPC_STORE, f3r.ok, riscv_emit.SCRATCH, rt, 0);
        ret err[fail.Fail].ok{};
    }
    val hr: err[fail.Fail] = riscv_emit.pcrel_hi(st, riscv_emit.SCRATCH, symop.sym, symop.sym_off);
    if (sel hr.err) { ret hr; }
    val lo_pos: u32 = st.buf.bytes.len::u32;
    riscv_emit.s_type(st, riscv_emit.OPC_STORE, f3r.ok, riscv_emit.SCRATCH, rt, 0);
    riscv_emit.note_sym_target(st, symop.sym, isa_inst.SYM_MOD_PCREL_LO, 0);
    ret riscv_emit.push_pcrel_lo(st, lo_pos, target_of.RK_PCREL_LO12_S, symop.sym);
}

fun encode_load(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: load missing operands")}; }
    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    val src: *lang_mir.MirOperand = ?mi.operands[1];
    if (is_fp_slot(f, dst)) {
        val ldr: err[fail.Fail] = emit_fp_load(st, f, src, riscv_emit.FP_SCRATCH, mi.src_width);
        if (sel ldr.err) { ret ldr; }
        ret emit_fp_slot_store(st, f, dst, riscv_emit.FP_SCRATCH, mi.src_width);
    }
    if (reg_is_fp(dst)) {
        val frd: res[i32, fail.Fail] = req_fpr(dst);
        if (sel frd.err) { ret err[fail.Fail].err{frd.err}; }
        ret emit_fp_load(st, f, src, frd.ok::u32, mi.src_width);
    }
    val rdr: res[i32, fail.Fail] = req_gpr(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;
    if (src.kind == lang_mir.MIR_OP_SYM) { ret emit_global_load(st, rd, src, mi.src_width); }
    val mr: res[Mem, fail.Fail] = resolve_mem(f, src);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;
    ret emit_mem_access(st, rd, m.base, m.off, mi.src_width, true);
}

# a float load into a register, whether the destination's own or the scratch
# a spilled destination is stored from
fun emit_fp_load(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, src: *lang_mir.MirOperand, rt: u32, width: u8) err[fail.Fail] {
    if (src.kind == lang_mir.MIR_OP_SYM) {
        ret err[fail.Fail].err{fail.message("encode: float load from a folded-global symbol is unsupported")};
    }
    val fmr: res[Mem, fail.Fail] = resolve_mem(f, src);
    if (sel fmr.err) { ret err[fail.Fail].err{fmr.err}; }
    val fm: Mem = fmr.ok;
    if (fm.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float load not expected")}; }
    ret emit_fp_mem(st, rt, fm.base, fm.off, width, true);
}

fun encode_store(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: store missing operands")}; }
    ret emit_store_mem(st, f, ?mi.operands[0], ?mi.operands[1], mi.width);
}

fun encode_addr(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: address op missing operands")}; }
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd:    u32                  = rdr.ok::u32;
    val memop: *lang_mir.MirOperand = ?mi.operands[1];
    if (memop.kind == lang_mir.MIR_OP_SYM) {
        if (memop.sym_got) { ret emit_global_addr_got(st, rd, riscv_emit.SCRATCH, memop); }
        ret emit_global_addr(st, rd, memop);
    }
    val mr: res[Mem, fail.Fail] = resolve_mem(f, memop);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;

    if (m.has_index) {
        var idx: u32                 = m.index;
        val shr: res[u32, fail.Fail] = scale_shift(m.scale);
        if (sel shr.err) { ret err[fail.Fail].err{shr.err}; }
        val sh: u32 = shr.ok;
        if (sh != 0) {
            riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SLL, riscv_emit.SCRATCH, m.index, sh);
            idx = riscv_emit.SCRATCH;
        }
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_ZERO, rd, m.base, idx);
        if (m.off != 0) { emit_addi(st, rd, rd, m.off); }
        ret err[fail.Fail].ok{};
    }
    emit_addi(st, rd, m.base, m.off);
    ret err[fail.Fail].ok{};
}

fun narrow_cmp_source(st: *isa_encode.EncodeState, reg: u32, scratch: u32, width: u8, signed: bool) u32 {
    if (width == 0 || width >= 4) { ret reg; }
    val sh: u32 = (riscv_emit.xlen(st)::u32 * 8) - (width::u32 * 8);
    if (signed) {
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SLL, scratch, reg, sh);
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SRL, scratch, scratch, sh | 0x400);
        ret scratch;
    }
    if (width == 1) {
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_AND, scratch, reg, 0xFF);
        ret scratch;
    }
    riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SLL, scratch, reg, sh);
    riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SRL, scratch, scratch, sh);
    ret scratch;
}

fun resolve_cmp_sources(st: *isa_encode.EncodeState, lhs_op: *lang_mir.MirOperand, rhs_op: *lang_mir.MirOperand,
    width: u8, signed: bool, out_lhs: *u32, out_rhs: *u32) err[fail.Fail] {
    val rnr: res[i32, fail.Fail] = resolve_source(st, lhs_op, riscv_emit.SCRATCH2, width);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    var lhs: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_source(st, rhs_op, riscv_emit.SCRATCH, width);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    var rhs: u32 = rmr.ok::u32;

    @out_lhs = narrow_cmp_source(st, lhs, riscv_emit.SCRATCH2, width, signed);
    @out_rhs = narrow_cmp_source(st, rhs, riscv_emit.SCRATCH, width, signed);
    ret err[fail.Fail].ok{};
}

fun encode_compare(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: compare missing operands")}; }

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    var lhs: u32            = 0;
    var rhs: u32            = 0;
    val rs:  err[fail.Fail] = resolve_cmp_sources(st, ?mi.operands[1], ?mi.operands[2], mi.width, lang_mir.is_signed_cmp(mi.opcode), ?lhs, ?rhs);
    if (sel rs.err) { ret rs; }

    emit_compare_bit(st, mi.opcode, rd, lhs, rhs);
    ret err[fail.Fail].ok{};
}

# the 0/1 answer of a selected compare of lhs and rhs into rd; rd may be
# either source, each instruction reading its sources before it writes
fun emit_compare_bit(st: *isa_encode.EncodeState, op: lang_mir.MirOpcode, rd: u32, lhs: u32, rhs: u32) {
    if (op == lang_mir.MIR_SEL_CMP_EQ) {
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_XOR, riscv_emit.F7_ZERO, rd, lhs, rhs);
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SLTU, rd, rd, 1);
        ret;
    }
    if (op == lang_mir.MIR_SEL_CMP_NE) {
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_XOR, riscv_emit.F7_ZERO, rd, lhs, rhs);
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_SLTU, riscv_emit.F7_ZERO, rd, riscv_emit.RZERO, rd);
        ret;
    }
    if (op == lang_mir.MIR_SEL_CMP_LT_S) {
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_SLT, riscv_emit.F7_ZERO, rd, lhs, rhs);
        ret;
    }
    if (op == lang_mir.MIR_SEL_CMP_LT_U) {
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_SLTU, riscv_emit.F7_ZERO, rd, lhs, rhs);
        ret;
    }
    if (op == lang_mir.MIR_SEL_CMP_LE_S) {
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_SLT, riscv_emit.F7_ZERO, rd, rhs, lhs);
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_XOR, rd, rd, 1);
        ret;
    }
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_SLTU, riscv_emit.F7_ZERO, rd, rhs, lhs);
    riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_XOR, rd, rd, 1);
}

# the selected compare a generic integer compare opcode is
fun selected_compare(op: lang_mir.MirOpcode) res[lang_mir.MirOpcode, fail.Fail] {
    if (op == lang_mir.MIR_CMP_EQ)   { ret res[lang_mir.MirOpcode, fail.Fail].ok{lang_mir.MIR_SEL_CMP_EQ}; }
    if (op == lang_mir.MIR_CMP_NE)   { ret res[lang_mir.MirOpcode, fail.Fail].ok{lang_mir.MIR_SEL_CMP_NE}; }
    if (op == lang_mir.MIR_CMP_LT_S) { ret res[lang_mir.MirOpcode, fail.Fail].ok{lang_mir.MIR_SEL_CMP_LT_S}; }
    if (op == lang_mir.MIR_CMP_LT_U) { ret res[lang_mir.MirOpcode, fail.Fail].ok{lang_mir.MIR_SEL_CMP_LT_U}; }
    if (op == lang_mir.MIR_CMP_LE_S) { ret res[lang_mir.MirOpcode, fail.Fail].ok{lang_mir.MIR_SEL_CMP_LE_S}; }
    if (op == lang_mir.MIR_CMP_LE_U) { ret res[lang_mir.MirOpcode, fail.Fail].ok{lang_mir.MIR_SEL_CMP_LE_U}; }
    ret res[lang_mir.MirOpcode, fail.Fail].err{fail.message("encode: a select names no integer compare")};
}

# a select, never a branch, so a secret condition is no taken path.
# the condition is the folded compare's 0/1 answer in SCRATCH, or the
# condition register read as nonzero, as a conditional branch reads it. with
# Zicond each choice is zeroed on the condition that rejects it and the two
# are or'd; without it the condition becomes a mask m and d = b ^ ((a ^ b) & m).
# every instruction reads its sources before it writes, so the destination may
# be any source
fun encode_select(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val fused: bool = mi.opcode == lang_mir.MIR_SEL_SELECT_CMP;
    var need:  u32  = 4;
    var ai:    u32  = 2;
    if (fused) {
        need = 6;
        ai   = 3;
    }
    if (mi.operand_count < need) { ret err[fail.Fail].err{fail.message("encode: select missing operands")}; }
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rar: res[i32, fail.Fail] = req_gpr(?mi.operands[ai]);
    if (sel rar.err) { ret err[fail.Fail].err{rar.err}; }
    val rbr: res[i32, fail.Fail] = req_gpr(?mi.operands[ai + 1]);
    if (sel rbr.err) { ret err[fail.Fail].err{rbr.err}; }
    val rd: u32 = rdr.ok::u32;
    val a:  u32 = rar.ok::u32;
    val b:  u32 = rbr.ok::u32;

    var c:      u32  = riscv_emit.SCRATCH;
    var is_bit: bool = fused;
    if (fused) {
        val sr: res[lang_mir.MirOpcode, fail.Fail] = selected_compare(mi.operands[5].imm::lang_mir.MirOpcode);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        var lhs: u32            = 0;
        var rhs: u32            = 0;
        val rs:  err[fail.Fail] = resolve_cmp_sources(st, ?mi.operands[1], ?mi.operands[2], mi.src_width, lang_mir.is_signed_cmp(sr.ok), ?lhs, ?rhs);
        if (sel rs.err) { ret rs; }
        emit_compare_bit(st, sr.ok, riscv_emit.SCRATCH, lhs, rhs);
    }
    or {
        val rcr: res[i32, fail.Fail] = req_gpr(?mi.operands[1]);
        if (sel rcr.err) { ret err[fail.Fail].err{rcr.err}; }
        c = rcr.ok::u32;
    }

    val admitted: u64 = extension.admitted(st.model.extensions, f.extensions);
    if (extension.admits(admitted, extension_riscv.ZICOND)) {
        riscv_emit.r_type(st, riscv_emit.OPC_OP, inst.F3_CZERO_NEZ, inst.F7_CZERO, riscv_emit.SCRATCH2, b, c);
        riscv_emit.r_type(st, riscv_emit.OPC_OP, inst.F3_CZERO_EQZ, inst.F7_CZERO, rd, a, c);
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_OR, riscv_emit.F7_ZERO, rd, rd, riscv_emit.SCRATCH2);
        ret err[fail.Fail].ok{};
    }
    if (!is_bit) { riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_SLTU, riscv_emit.F7_ZERO, riscv_emit.SCRATCH, riscv_emit.RZERO, c); }
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_SUB, riscv_emit.SCRATCH, riscv_emit.RZERO, riscv_emit.SCRATCH);
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_XOR, riscv_emit.F7_ZERO, riscv_emit.SCRATCH2, a, b);
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_AND, riscv_emit.F7_ZERO, riscv_emit.SCRATCH2, riscv_emit.SCRATCH2, riscv_emit.SCRATCH);
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_XOR, riscv_emit.F7_ZERO, rd, riscv_emit.SCRATCH2, b);
    ret err[fail.Fail].ok{};
}

# `sltu` (or `sltiu` against a small constant) answers 1 exactly when a is
# below b unsigned, and `neg` turns it into all ones or zero
fun encode_compare_mask(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: compare-to-mask missing operands")}; }
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rhs_op: *lang_mir.MirOperand = ?mi.operands[2];
    if (rhs_op.kind == lang_mir.MIR_OP_IMM && rhs_op.imm >= 0 && rhs_op.imm <= 2047) {
        val rnr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], riscv_emit.SCRATCH2, mi.src_width);
        if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
        val lhs: u32 = narrow_cmp_source(st, rnr.ok::u32, riscv_emit.SCRATCH2, mi.src_width, false);
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SLTU, rd, lhs, rhs_op.imm::u32);
    }
    or {
        var lhs: u32            = 0;
        var rhs: u32            = 0;
        val rs:  err[fail.Fail] = resolve_cmp_sources(st, ?mi.operands[1], rhs_op, mi.src_width, false, ?lhs, ?rhs);
        if (sel rs.err) { ret rs; }
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_SLTU, riscv_emit.F7_ZERO, rd, lhs, rhs);
    }
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_SUB, rd, riscv_emit.RZERO, rd);
    ret err[fail.Fail].ok{};
}

fun encode_branch(st: *isa_encode.EncodeState, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 1 || mi.operands[0].kind != lang_mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: branch target is not a block")};
    }
    val target_block: u32 = mi.operands[0].imm::u32;
    if (isa_encode.branch_falls_through(st, target_block)) { ret err[fail.Fail].ok{}; }
    val patch_pos: u32 = st.buf.bytes.len::u32;
    riscv_emit.j_type(st, riscv_emit.OPC_JAL, riscv_emit.RZERO, 0);
    riscv_emit.note_block_target(st, target_block);
    val next_ip: u32            = st.buf.bytes.len::u32;
    val pushed:  err[fail.Fail] = isa_encode.push_fixup(st, patch_pos, next_ip, target_block, fn_base);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun encode_cbr(st: *isa_encode.EncodeState, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: conditional branch missing operands")}; }
    if (mi.operands[1].kind != lang_mir.MIR_OP_BLOCK || mi.operands[2].kind != lang_mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: conditional branch target is not a block")};
    }
    val then_block: u32 = mi.operands[1].imm::u32;
    val else_block: u32 = mi.operands[2].imm::u32;

    val rcr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rcr.err) { ret err[fail.Fail].err{rcr.err}; }
    val cond: u32 = rcr.ok::u32;

    val invert: bool = isa_encode.cbr_inverts(st, then_block, else_block);
    var funct3: u32  = riscv_emit.F3_BNE;
    var taken:  u32  = then_block;
    if (invert) {
        funct3 = riscv_emit.F3_BEQ;
        taken  = else_block;
    }
    val bne_pos: u32 = st.buf.bytes.len::u32;
    riscv_emit.b_type(st, riscv_emit.OPC_BRANCH, funct3, cond, riscv_emit.RZERO, 0);
    riscv_emit.note_block_target(st, taken);
    val bne_next: u32            = st.buf.bytes.len::u32;
    val f1:       err[fail.Fail] = isa_encode.push_fixup(st, bne_pos, bne_next, taken, fn_base);
    if (sel f1.err) { ret err[fail.Fail].err{f1.err}; }

    if (invert || isa_encode.branch_falls_through(st, else_block)) { ret err[fail.Fail].ok{}; }
    val j_pos: u32 = st.buf.bytes.len::u32;
    riscv_emit.j_type(st, riscv_emit.OPC_JAL, riscv_emit.RZERO, 0);
    riscv_emit.note_block_target(st, else_block);
    val j_next: u32            = st.buf.bytes.len::u32;
    val pushed: err[fail.Fail] = isa_encode.push_fixup(st, j_pos, j_next, else_block, fn_base);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun fused_cbr_funct3(op: lang_mir.MirOpcode, swap: *bool) res[u32, fail.Fail] {
    @swap = false;
    if (op == lang_mir.MIR_SEL_CBR_EQ)   { ret res[u32, fail.Fail].ok{riscv_emit.F3_BEQ}; }
    if (op == lang_mir.MIR_SEL_CBR_NE)   { ret res[u32, fail.Fail].ok{riscv_emit.F3_BNE}; }
    if (op == lang_mir.MIR_SEL_CBR_LT_S) { ret res[u32, fail.Fail].ok{riscv_emit.F3_BLT}; }
    if (op == lang_mir.MIR_SEL_CBR_LT_U) { ret res[u32, fail.Fail].ok{riscv_emit.F3_BLTU}; }
    @swap = true;
    if (op == lang_mir.MIR_SEL_CBR_LE_S) { ret res[u32, fail.Fail].ok{riscv_emit.F3_BGE}; }
    if (op == lang_mir.MIR_SEL_CBR_LE_U) { ret res[u32, fail.Fail].ok{riscv_emit.F3_BGEU}; }
    @swap = false;
    ret res[u32, fail.Fail].err{fail.message("encode: riscv64 has no fused compare-and-branch form for this relation")};
}

fun encode_fused_cbr(st: *isa_encode.EncodeState, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 4) {
        ret err[fail.Fail].err{fail.message("encode: fused compare-branch missing operands")};
    }
    if (mi.operands[2].kind != lang_mir.MIR_OP_BLOCK || mi.operands[3].kind != lang_mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: fused compare-branch target is not a block")};
    }
    val then_block:  u32 = mi.operands[2].imm::u32;
    val else_block:  u32 = mi.operands[3].imm::u32;
    val instr_start: u32 = st.buf.bytes.len::u32;

    var lhs: u32            = 0;
    var rhs: u32            = 0;
    val rs:  err[fail.Fail] = resolve_cmp_sources(st, ?mi.operands[0], ?mi.operands[1], mi.width, lang_mir.is_signed_cmp(mi.opcode), ?lhs, ?rhs);
    if (sel rs.err) { ret rs; }

    var swap: bool                = false;
    val f3r:  res[u32, fail.Fail] = fused_cbr_funct3(mi.opcode, ?swap);
    if (sel f3r.err) { ret err[fail.Fail].err{f3r.err}; }
    var funct3: u32 = f3r.ok;
    var rs1:    u32 = lhs;
    var rs2:    u32 = rhs;
    if (swap) {
        rs1 = rhs;
        rs2 = lhs;
    }
    val invert: bool = isa_encode.cbr_inverts(st, then_block, else_block);
    var taken:  u32  = then_block;
    # a riscv branch condition and its inverse differ in the low funct3 bit
    if (invert) {
        funct3 = funct3 ^ 1;
        taken  = else_block;
    }

    val bcc_pos: u32 = st.buf.bytes.len::u32;
    riscv_emit.b_type(st, riscv_emit.OPC_BRANCH, funct3, rs1, rs2, 0);
    riscv_emit.note_block_target(st, taken);
    val bcc_next: u32            = st.buf.bytes.len::u32;
    val f1:       err[fail.Fail] = isa_encode.push_fixup(st, bcc_pos, bcc_next, taken, fn_base);
    if (sel f1.err) { ret err[fail.Fail].err{f1.err}; }

    if (invert || isa_encode.branch_falls_through(st, else_block)) {
        isa_encode.close_cmp_varlocs(st, instr_start, st.buf.bytes.len::u32);
        ret err[fail.Fail].ok{};
    }
    val j_pos: u32 = st.buf.bytes.len::u32;
    riscv_emit.j_type(st, riscv_emit.OPC_JAL, riscv_emit.RZERO, 0);
    riscv_emit.note_block_target(st, else_block);
    val j_next: u32 = st.buf.bytes.len::u32;
    isa_encode.close_cmp_varlocs(st, instr_start, st.buf.bytes.len::u32);
    val pushed: err[fail.Fail] = isa_encode.push_fixup(st, j_pos, j_next, else_block, fn_base);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun encode_call(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 1) { ret err[fail.Fail].err{fail.message("encode: call missing callee operand")}; }
    val callee: *lang_mir.MirOperand = ?mi.operands[0];
    if (callee.kind == lang_mir.MIR_OP_SYM) {
        if (intern.str_is_nil(callee.sym)) {
            ret err[fail.Fail].err{fail.message("encode: direct call has no resolved symbol name")};
        }
        # a tail call is the `tail` pair: t1 carries the target and the jump
        # links nothing
        var link: u32 = riscv_emit.RRA;
        var base: u32 = riscv_emit.RRA;
        if (mi.tail) {
            link = riscv_emit.RZERO;
            base = riscv_emit.SCRATCH2;
        }
        val pos: u32 = st.buf.bytes.len::u32;
        riscv_emit.u_type(st, riscv_emit.OPC_AUIPC, base, 0);
        riscv_emit.note_sym_target(st, callee.sym, isa_inst.SYM_MOD_PCREL_HI, callee.sym_off);
        riscv_emit.i_type(st, riscv_emit.OPC_JALR, riscv_emit.F3_ADD, link, base, 0);
        riscv_emit.note_sym_target(st, callee.sym, isa_inst.SYM_MOD_PCREL_LO, 0);
        val pushed: err[fail.Fail] = isa_encode.push_reloc(st, pos, target_of.RK_PLT32, callee.sym, callee.sym_off);
        if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
        ret err[fail.Fail].ok{};
    }
    val rr: res[i32, fail.Fail] = req_gpr(callee);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    if (mi.tail)    { riscv_emit.i_type(st, riscv_emit.OPC_JALR, riscv_emit.F3_ADD, riscv_emit.RZERO, rr.ok::u32, 0); }
    or              { riscv_emit.i_type(st, riscv_emit.OPC_JALR, riscv_emit.F3_ADD, riscv_emit.RRA, rr.ok::u32, 0); }
    ret err[fail.Fail].ok{};
}

fun divide_funct3(op: lang_mir.MirOpcode) res[u32, fail.Fail] {
    if (op == lang_mir.MIR_SEL_DIV_S) { ret res[u32, fail.Fail].ok{riscv_emit.F3_DIV}; }
    if (op == lang_mir.MIR_SEL_DIV_U) { ret res[u32, fail.Fail].ok{riscv_emit.F3_DIVU}; }
    if (op == lang_mir.MIR_SEL_REM_S) { ret res[u32, fail.Fail].ok{riscv_emit.F3_REM}; }
    if (op == lang_mir.MIR_SEL_REM_U) { ret res[u32, fail.Fail].ok{riscv_emit.F3_REMU}; }
    ret res[u32, fail.Fail].err{fail.message("encode: riscv64 has no M-extension form for this divide / remainder opcode")};
}

fun encode_divide(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: divide missing operands")}; }

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rnr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], riscv_emit.SCRATCH2, mi.width);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rs1: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[2], riscv_emit.SCRATCH, mi.width);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rs2: u32 = rmr.ok::u32;

    val f3r: res[u32, fail.Fail] = divide_funct3(mi.opcode);
    if (sel f3r.err) { ret err[fail.Fail].err{f3r.err}; }

    val signed: bool = mi.opcode == lang_mir.MIR_SEL_DIV_S || mi.opcode == lang_mir.MIR_SEL_REM_S;
    emit_divide_guard(st, mi, rs1, rs2, signed);
    riscv_emit.r_type(st, riscv_emit.alu_opcode(mi.width, riscv_emit.xlen(st)), f3r.ok, riscv_emit.F7_MULDIV, rd, rs1, rs2);
    ret err[fail.Fail].ok{};
}

fun emit_ebreak(st: *isa_encode.EncodeState) {
    riscv_emit.i_type(st, riscv_emit.OPC_SYSTEM, riscv_emit.F3_ADD, riscv_emit.RZERO, riscv_emit.RZERO, 1);
}

fun divide_width_is_word(st: *isa_encode.EncodeState, width: u8) bool {
    ret width <= 4 && riscv_emit.xlen(st) == 8;
}

fun divide_int_min(width: u8) i64 {
    if (width <= 4) { ret -2147483648; }
    ret -9223372036854775807 - 1;
}

fun min_check_length(st: *isa_encode.EncodeState, width: u8) u32 {
    if (divide_width_is_word(st, width) || riscv_emit.xlen(st) == 4) { ret 4; }
    ret 5;
}

fun emit_min_check(st: *isa_encode.EncodeState, rs1: u32, t: u32, width: u8) {
    if (divide_width_is_word(st, width)) {
        riscv_emit.u_type(st, riscv_emit.OPC_LUI, t, 0x80000);
        riscv_emit.r_type(st, riscv_emit.OPC_OP_32, riscv_emit.F3_ADD, riscv_emit.F7_SUB, t, rs1, t);
    }
    or (riscv_emit.xlen(st) == 4) {
        riscv_emit.u_type(st, riscv_emit.OPC_LUI, t, 0x80000);
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_SUB, t, rs1, t);
    }
    or {
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_ADD, t, riscv_emit.RZERO, 1);
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SLL, t, t, 63);
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_SUB, t, rs1, t);
    }
    riscv_emit.b_type(st, riscv_emit.OPC_BRANCH, riscv_emit.F3_BNE, t, riscv_emit.RZERO, 8);
    emit_ebreak(st);
}

fun emit_divide_guard(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr, rs1: u32, rs2: u32, signed: bool) {
    val w:       u8   = mi.width;
    val den_imm: bool = mi.operands[2].kind == lang_mir.MIR_OP_IMM;
    val num_imm: bool = mi.operands[1].kind == lang_mir.MIR_OP_IMM;
    if (den_imm) {
        val d: i64 = imm_sext_for_width(mi.operands[2].imm, w);
        if (d == 0) {
            emit_ebreak(st);
            ret;
        }
        if (!signed || d != -1) { ret; }
        if (num_imm) {
            if (imm_sext_for_width(mi.operands[1].imm, w) == divide_int_min(w)) { emit_ebreak(st); }
            ret;
        }
        emit_min_check(st, rs1, riscv_emit.SCRATCH2, w);
        ret;
    }

    val t: u32 = riscv_emit.SCRATCH;
    if (divide_width_is_word(st, w)) {
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM_32, riscv_emit.F3_ADD, t, rs2, 0);
        riscv_emit.b_type(st, riscv_emit.OPC_BRANCH, riscv_emit.F3_BNE, t, riscv_emit.RZERO, 8);
    }
    or {
        riscv_emit.b_type(st, riscv_emit.OPC_BRANCH, riscv_emit.F3_BNE, rs2, riscv_emit.RZERO, 8);
    }
    emit_ebreak(st);

    if (!signed) { ret; }
    riscv_emit.i_type(st, riscv_emit.alu_imm_opcode(w, riscv_emit.xlen(st)), riscv_emit.F3_ADD, t, rs2, 1);
    riscv_emit.b_type(st, riscv_emit.OPC_BRANCH, riscv_emit.F3_BNE, t, riscv_emit.RZERO, 4 * (min_check_length(st, w) + 1));
    emit_min_check(st, rs1, t, w);
}

fun encode_convert(st: *isa_encode.EncodeState, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: conversion missing operands")}; }
    val dw: u8 = mi.width;
    val sw: u8 = mi.src_width;

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    val rsr: res[i32, fail.Fail] = resolve_source(st, ?mi.operands[1], riscv_emit.SCRATCH, mi.width);
    if (sel rsr.err) { ret err[fail.Fail].err{rsr.err}; }
    val rs: u32 = rsr.ok::u32;

    if (mi.opcode == lang_mir.MIR_TRUNC) {
        riscv_emit.i_type(st, riscv_emit.alu_imm_opcode(4, riscv_emit.xlen(st)), riscv_emit.F3_ADD, rd, rs, 0);
        ret err[fail.Fail].ok{};
    }
    if (mi.opcode == lang_mir.MIR_BITCAST) {
        if (dw >= riscv_emit.xlen(st)) { riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_ADD, rd, rs, 0); }
        or                             { riscv_emit.i_type(st, riscv_emit.alu_imm_opcode(4, riscv_emit.xlen(st)), riscv_emit.F3_ADD, rd, rs, 0); }
        ret err[fail.Fail].ok{};
    }
    if (mi.opcode == lang_mir.MIR_SEXT) {
        if (sw >= riscv_emit.xlen(st)) {
            riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_ADD, rd, rs, 0);
            ret err[fail.Fail].ok{};
        }
        if (sw == 4) {
            riscv_emit.i_type(st, riscv_emit.alu_imm_opcode(4, riscv_emit.xlen(st)), riscv_emit.F3_ADD, rd, rs, 0);
            ret err[fail.Fail].ok{};
        }
        val sh: u32 = (riscv_emit.xlen(st)::u32 * 8) - (sw::u32 * 8);
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SLL, rd, rs, sh);
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SRL, rd, rd, sh | 0x400);
        ret err[fail.Fail].ok{};
    }
    if (sw == 1) {
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_AND, rd, rs, 0xFF);
        ret err[fail.Fail].ok{};
    }
    val sh: u32 = (riscv_emit.xlen(st)::u32 * 8) - (sw::u32 * 8);
    riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SLL, rd, rs, sh);
    riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SRL, rd, rd, sh);
    ret err[fail.Fail].ok{};
}

fun req_fpr(op: *lang_mir.MirOperand) res[i32, fail.Fail] {
    if (op.kind == lang_mir.MIR_OP_PREG) {
        if (isa_inst.regid_class(lang_mir.preg_regid(op.preg)) != isa_inst.REG_CLASS_ID_FP) {
            ret res[i32, fail.Fail].err{fail.message("internal compiler error: a general-purpose register reached a float operand position")};
        }
        ret res[i32, fail.Fail].ok{isa_inst.regid_index(lang_mir.preg_regid(op.preg))};
    }
    if (op.kind == lang_mir.MIR_OP_VREG) {
        ret res[i32, fail.Fail].err{fail.message("encode: virtual register survived register allocation")};
    }
    ret res[i32, fail.Fail].err{fail.message("encode: expected a float register operand")};
}

fun reg_is_fp(op: *lang_mir.MirOperand) bool {
    ret op.kind == lang_mir.MIR_OP_PREG && isa_inst.regid_class(lang_mir.preg_regid(op.preg)) == isa_inst.REG_CLASS_ID_FP;
}

fun fp_mem_funct3(width: u8, is_load: bool) res[u32, fail.Fail] {
    val op: inst.MachOp = inst.fp_access(width, is_load);
    if (op == inst.MOP_NONE) {
        ret res[u32, fail.Fail].err{fail.message("internal compiler error: riscv64 has no float memory access form for this width (expected 4 or 8)")};
    }
    ret res[u32, fail.Fail].ok{inst.row(op).funct3};
}

fun emit_fp_mem(st: *isa_encode.EncodeState, rt: u32, base: u32, off: i64, width: u8, is_load: bool) err[fail.Fail] {
    val f3r: res[u32, fail.Fail] = fp_mem_funct3(width, is_load);
    if (sel f3r.err) { ret err[fail.Fail].err{f3r.err}; }
    val f3: u32 = f3r.ok;
    var b:  u32 = base;
    var d:  i64 = off;
    if (off < -2048 || off > 2047) {
        riscv_emit.li(st, riscv_emit.SCRATCH2, off);
        riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_ZERO, riscv_emit.SCRATCH2, base, riscv_emit.SCRATCH2);
        b = riscv_emit.SCRATCH2;
        d = 0;
    }
    if (is_load) {
        riscv_emit.i_type(st, riscv_emit.OPC_LOAD_FP, f3, rt, b, d::u32 & 0xFFF);
        ret err[fail.Fail].ok{};
    }
    riscv_emit.s_type(st, riscv_emit.OPC_STORE_FP, f3, b, rt, d::u32 & 0xFFF);
    ret err[fail.Fail].ok{};
}

fun emit_fp_slot_store(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, memop: *lang_mir.MirOperand, rt: u32, width: u8) err[fail.Fail] {
    val mr: res[Mem, fail.Fail] = resolve_mem(f, memop);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill destination not expected")}; }
    ret emit_fp_mem(st, rt, m.base, m.off, width, false);
}

fun emit_fp_slot_load(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, memop: *lang_mir.MirOperand, rt: u32, width: u8) err[fail.Fail] {
    val mr: res[Mem, fail.Fail] = resolve_mem(f, memop);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill source not expected")}; }
    ret emit_fp_mem(st, rt, m.base, m.off, width, true);
}

fun is_fp_slot(f: *lang_mir.MirFunction, op: *lang_mir.MirOperand) bool {
    ret op.kind == lang_mir.MIR_OP_MEM && !lang_mir.vreg_is_nil(op.vreg) && lang_mir.vreg_is_fp(f, op.vreg);
}

# the fmt field of a scalar float width: half (Zfh, Zfhmin), single or double
fun fp_fmt(width: u8) u32 {
    if (width == 2) { ret inst.FMT_H_BIT; }
    if (width == 8) { ret riscv_emit.FMT_D; }
    ret riscv_emit.FMT_S;
}

# a scalar float width the encoder takes: an f16 at 2 bytes beside binary32 and binary64
fun scalar_float_width(w: u8) bool {
    ret w == 2 || common.is_float_width(w);
}

fun fmv_i2f_funct7(width: u8) u32 {
    ret riscv_emit.F7_FMV_I2F | fp_fmt(width);
}

fun fmv_f2i_funct7(width: u8) u32 {
    ret riscv_emit.F7_FMV_F2I | fp_fmt(width);
}

fun li_words(value: i64) u32 {
    if (value >= -2048 && value <= 2047) { ret 1; }
    if (value >= -2147483648 && value <= 2147483647) {
        val v: i32 = value::i32;
        if ((v::u32 & 0xFFF) == 0) { ret 1; }
        ret 2;
    }
    val lo12: i64 = riscv_emit.sext12(value);
    var n:    u32 = li_words((value - lo12) >> 12) + 1;
    if (lo12 != 0) { n = n + 1; }
    ret n;
}

# a float immediate: zero and a one-word pattern cross from a general register,
# anything else is loaded from the constant pool. rv32 has no fmv.d.x, so an f64
# there gets +0.0 from fcvt.d.w of x0 and every other pattern from the pool
fun emit_fp_const(st: *isa_encode.EncodeState, vd: u32, bits: i64, width: u8) err[fail.Fail] {
    var pattern: i64 = bits;
    if (width == 4) { pattern = bits & 0xFFFFFFFF; }
    if (width == 2) {
        # an f16 pattern always fits a general register and fmv.h.x boxes it
        riscv_emit.li(st, riscv_emit.SCRATCH, bits & 0xFFFF);
        riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.RM_RNE, fmv_i2f_funct7(2), vd, riscv_emit.SCRATCH, 0);
        ret err[fail.Fail].ok{};
    }

    val crosses: bool = width == 4 || riscv_emit.xlen(st) == 8;
    if (pattern == 0) {
        if (crosses) { riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.RM_RNE, fmv_i2f_funct7(width), vd, riscv_emit.RZERO, 0); }
        or           { riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.RM_RNE, riscv_emit.F7_FCVT_I2F | riscv_emit.FMT_D, vd, riscv_emit.RZERO, riscv_emit.FCVT_W); }
        ret err[fail.Fail].ok{};
    }
    if (crosses && li_words(pattern) <= 1) {
        riscv_emit.li(st, riscv_emit.SCRATCH, pattern);
        riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.RM_RNE, fmv_i2f_funct7(width), vd, riscv_emit.SCRATCH, 0);
        ret err[fail.Fail].ok{};
    }

    val sr: res[intern.StrId, fail.Fail] = isa_encode.intern_float_const(st, pattern::u64, width);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val sym: intern.StrId = sr.ok;

    val f3r: res[u32, fail.Fail] = fp_mem_funct3(width, true);
    if (sel f3r.err) { ret err[fail.Fail].err{f3r.err}; }
    val hr: err[fail.Fail] = riscv_emit.pcrel_hi(st, riscv_emit.SCRATCH, sym, 0);
    if (sel hr.err) { ret hr; }
    val lo_pos: u32 = st.buf.bytes.len::u32;
    riscv_emit.i_type(st, riscv_emit.OPC_LOAD_FP, f3r.ok, vd, riscv_emit.SCRATCH, 0);
    riscv_emit.note_sym_target(st, sym, isa_inst.SYM_MOD_PCREL_LO, 0);
    ret riscv_emit.push_pcrel_lo(st, lo_pos, target_of.RK_PCREL_LO12_I, sym);
}

fun resolve_fp_source(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, op: *lang_mir.MirOperand, scratch: u32, width: u8) res[i32, fail.Fail] {
    if (op.kind == lang_mir.MIR_OP_MEM) {
        val mr: res[Mem, fail.Fail] = resolve_mem(f, op);
        if (sel mr.err) { ret res[i32, fail.Fail].err{mr.err}; }
        val m: Mem = mr.ok;
        if (m.has_index) { ret res[i32, fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
        val lr: err[fail.Fail] = emit_fp_mem(st, scratch, m.base, m.off, width, true);
        if (sel lr.err) { ret res[i32, fail.Fail].err{lr.err}; }
        ret res[i32, fail.Fail].ok{scratch::i32};
    }
    if (op.kind == lang_mir.MIR_OP_IMM) {
        val cr: err[fail.Fail] = emit_fp_const(st, scratch, op.imm, width);
        if (sel cr.err) { ret res[i32, fail.Fail].err{cr.err}; }
        ret res[i32, fail.Fail].ok{scratch::i32};
    }
    ret req_fpr(op);
}

fun fp_arith_funct7(op: lang_mir.MirOpcode, width: u8) res[u32, fail.Fail] {
    var base: u32 = riscv_emit.F7_FADD;
    if (op == lang_mir.MIR_FADD) { base = riscv_emit.F7_FADD; }
    or (op == lang_mir.MIR_FSUB) { base = riscv_emit.F7_FSUB; }
    or (op == lang_mir.MIR_FMUL) { base = riscv_emit.F7_FMUL; }
    or (op == lang_mir.MIR_FDIV) { base = riscv_emit.F7_FDIV; }
    or {
        ret res[u32, fail.Fail].err{fail.message("encode: riscv64 has no float arithmetic form for this opcode")};
    }
    ret res[u32, fail.Fail].ok{base | fp_fmt(width)};
}

fun encode_fp_arith(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: float arithmetic missing operands")}; }
    val w: u8 = mi.width;
    if (!scalar_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float arithmetic has a non-float operand width (expected 2, 4 or 8)")};
    }

    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], riscv_emit.FP_SCRATCH, w);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[2], riscv_emit.FP_SCRATCH2, w);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    val f7r: res[u32, fail.Fail] = fp_arith_funct7(mi.opcode, w);
    if (sel f7r.err) { ret err[fail.Fail].err{f7r.err}; }
    val f7:  u32                  = f7r.ok;
    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    if (dst.kind == lang_mir.MIR_OP_MEM) {
        riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.RM_DYN, f7, riscv_emit.FP_SCRATCH, rn, rm);
        ret emit_fp_slot_store(st, f, dst, riscv_emit.FP_SCRATCH, w);
    }
    val rdr: res[i32, fail.Fail] = req_fpr(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.RM_DYN, f7, rdr.ok::u32, rn, rm);
    ret err[fail.Fail].ok{};
}

fun encode_fp_neg(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: float negate missing operands")}; }
    val w: u8 = mi.width;
    if (!scalar_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float negate has a non-float operand width (expected 2, 4 or 8)")};
    }
    val f7: u32 = riscv_emit.F7_FSGNJ | fp_fmt(w);

    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], riscv_emit.FP_SCRATCH, w);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    if (dst.kind == lang_mir.MIR_OP_MEM) {
        riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.F3_FLT, f7, riscv_emit.FP_SCRATCH, rn, rn);
        ret emit_fp_slot_store(st, f, dst, riscv_emit.FP_SCRATCH, w);
    }
    val rdr: res[i32, fail.Fail] = req_fpr(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.F3_FLT, f7, rdr.ok::u32, rn, rn);
    ret err[fail.Fail].ok{};
}

fun fp_cmp_relation(cc: u8, out_funct3: *u32, out_swap: *bool, out_invert: *bool) err[fail.Fail] {
    @out_swap   = false;
    @out_invert = false;
    @out_funct3 = riscv_emit.F3_FEQ;
    if (cc == lang_mir.FCC_EQ) {
        @out_funct3 = riscv_emit.F3_FEQ;
        ret err[fail.Fail].ok{};
    }
    if (cc == lang_mir.FCC_NE) {
        @out_funct3 = riscv_emit.F3_FEQ;
        @out_invert = true;
        ret err[fail.Fail].ok{};
    }
    if (cc == lang_mir.FCC_LT) {
        @out_funct3 = riscv_emit.F3_FLT;
        ret err[fail.Fail].ok{};
    }
    if (cc == lang_mir.FCC_LE) {
        @out_funct3 = riscv_emit.F3_FLE;
        ret err[fail.Fail].ok{};
    }
    if (cc == lang_mir.FCC_GT) {
        @out_funct3 = riscv_emit.F3_FLT;
        @out_swap   = true;
        ret err[fail.Fail].ok{};
    }
    if (cc == lang_mir.FCC_GE) {
        @out_funct3 = riscv_emit.F3_FLE;
        @out_swap   = true;
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("encode: riscv64 has no float comparison form for this condition code")};
}

fun encode_fp_cmp(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: float comparison missing operands")}; }
    val w: u8 = mi.width;
    if (!scalar_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float comparison has a non-float operand width (expected 2, 4 or 8)")};
    }
    val f7: u32 = riscv_emit.F7_FCMP | fp_fmt(w);

    val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], riscv_emit.FP_SCRATCH, w);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn: u32 = rnr.ok::u32;

    val rmr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[2], riscv_emit.FP_SCRATCH2, w);
    if (sel rmr.err) { ret err[fail.Fail].err{rmr.err}; }
    val rm: u32 = rmr.ok::u32;

    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;

    var funct3: u32            = riscv_emit.F3_FEQ;
    var swap:   bool           = false;
    var invert: bool           = false;
    val rel:    err[fail.Fail] = fp_cmp_relation(mi.src_width, ?funct3, ?swap, ?invert);
    if (sel rel.err) { ret rel; }

    var a: u32 = rn;
    var b: u32 = rm;
    if (swap) {
        a = rm;
        b = rn;
    }
    riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, funct3, f7, rd, a, b);
    if (invert) { riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_XOR, rd, rd, 1); }
    ret err[fail.Fail].ok{};
}

fun int_to_fp_rm(dbl: bool, src_is_word: bool) u32 {
    if (dbl && src_is_word) { ret riscv_emit.RM_RNE; }
    ret riscv_emit.RM_DYN;
}

fun encode_fp_conv(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: float conversion missing operands")}; }
    val op: lang_mir.MirOpcode = mi.opcode;
    val dw: u8                 = mi.width;
    val sw: u8                 = mi.src_width;

    if (op == lang_mir.MIR_FP_TRUNC || op == lang_mir.MIR_FP_EXT) {
        if (!scalar_float_width(dw) || !scalar_float_width(sw) || dw == sw) {
            ret err[fail.Fail].err{fail.message("internal compiler error: float conversion has a non-float width on a float side (expected 2, 4 or 8)")};
        }
        val rnr: res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], riscv_emit.FP_SCRATCH, sw);
        if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
        val rn:  u32 = rnr.ok::u32;
        val f7:  u32 = riscv_emit.F7_FCVT_F2F | fp_fmt(dw);
        val rs2: u32 = fp_fmt(sw);
        # a widening is exact, so it names a fixed mode; a narrowing rounds
        var rm: u32 = riscv_emit.RM_DYN;
        if (op == lang_mir.MIR_FP_EXT) { rm = riscv_emit.RM_RNE; }
        val dst: *lang_mir.MirOperand = ?mi.operands[0];
        if (dst.kind == lang_mir.MIR_OP_MEM) {
            riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, rm, f7, riscv_emit.FP_SCRATCH, rn, rs2);
            ret emit_fp_slot_store(st, f, dst, riscv_emit.FP_SCRATCH, dw);
        }
        val rdr: res[i32, fail.Fail] = req_fpr(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, rm, f7, rdr.ok::u32, rn, rs2);
        ret err[fail.Fail].ok{};
    }

    if (op == lang_mir.MIR_SI_TO_FP || op == lang_mir.MIR_UI_TO_FP) {
        if (!scalar_float_width(dw)) {
            ret err[fail.Fail].err{fail.message("internal compiler error: integer-to-float conversion has a non-float result width (expected 2, 4 or 8)")};
        }
        val signed: bool                = op == lang_mir.MIR_SI_TO_FP;
        val gpr:    res[i32, fail.Fail] = req_gpr(?mi.operands[1]);
        if (sel gpr.err) { ret err[fail.Fail].err{gpr.err}; }
        var gp:       u32  = gpr.ok::u32;
        var src_word: bool = sw <= 4;
        if (sw < 4) {
            val shamt: u32 = (riscv_emit.xlen(st)::u32 * 8) - (sw::u32 * 8);
            if (signed) {
                riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SLL, riscv_emit.SCRATCH, gp, shamt);
                riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SRL, riscv_emit.SCRATCH, riscv_emit.SCRATCH, shamt | 0x400);
            }
            or (sw == 1) {
                riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_AND, riscv_emit.SCRATCH, gp, 0xFF);
            }
            or {
                riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SLL, riscv_emit.SCRATCH, gp, shamt);
                riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_SRL, riscv_emit.SCRATCH, riscv_emit.SCRATCH, shamt);
            }
            gp       = riscv_emit.SCRATCH;
            src_word = true;
        }
        if (!src_word && riscv_emit.xlen(st) == 4) {
            ret err[fail.Fail].err{fail.message("internal compiler error: a 64-bit integer reached the rv32 int-to-float encoder unlegalized (fcvt.s.l / fcvt.d.l are RV64-only)")};
        }
        val dbl: bool = dw == 8;
        val f7:  u32  = riscv_emit.F7_FCVT_I2F | fp_fmt(dw);
        var rs2: u32  = riscv_emit.FCVT_L;
        if (src_word && signed)   { rs2 = riscv_emit.FCVT_W; }
        or (src_word && !signed)  { rs2 = riscv_emit.FCVT_WU; }
        or (!src_word && !signed) { rs2 = riscv_emit.FCVT_LU; }
        val rm:  u32                  = int_to_fp_rm(dbl, src_word);
        val dst: *lang_mir.MirOperand = ?mi.operands[0];
        if (dst.kind == lang_mir.MIR_OP_MEM) {
            riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, rm, f7, riscv_emit.FP_SCRATCH, gp, rs2);
            ret emit_fp_slot_store(st, f, dst, riscv_emit.FP_SCRATCH, dw);
        }
        val rdr: res[i32, fail.Fail] = req_fpr(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, rm, f7, rdr.ok::u32, gp, rs2);
        ret err[fail.Fail].ok{};
    }

    if (!scalar_float_width(sw)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float-to-integer conversion has a non-float source width (expected 2, 4 or 8)")};
    }
    val signed: bool                = op == lang_mir.MIR_FP_TO_SI;
    val rnr:    res[i32, fail.Fail] = resolve_fp_source(st, f, ?mi.operands[1], riscv_emit.FP_SCRATCH, sw);
    if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
    val rn:  u32                 = rnr.ok::u32;
    val rdr: res[i32, fail.Fail] = req_gpr(?mi.operands[0]);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val rd: u32 = rdr.ok::u32;
    if (dw > 4 && riscv_emit.xlen(st) == 4) {
        ret err[fail.Fail].err{fail.message("internal compiler error: a 64-bit integer destination reached the rv32 float-to-int encoder unlegalized (fcvt.l.s / fcvt.l.d are RV64-only)")};
    }
    val f7:  u32 = riscv_emit.F7_FCVT_F2I | fp_fmt(sw);
    var rs2: u32 = riscv_emit.FCVT_L;
    if (dw <= 4 && signed)  { rs2 = riscv_emit.FCVT_W; }
    or (dw <= 4 && !signed) { rs2 = riscv_emit.FCVT_WU; }
    or (dw > 4 && !signed)  { rs2 = riscv_emit.FCVT_LU; }
    riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.RM_RTZ, f7, rd, rn, rs2);
    ret err[fail.Fail].ok{};
}

fun encode_fmov(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: fmov missing operands")}; }
    val w: u8 = mi.width;
    if (!scalar_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float move has a non-float operand width (expected 2, 4 or 8)")};
    }
    val dbl: bool                 = w == 8;
    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    val src: *lang_mir.MirOperand = ?mi.operands[1];

    if (src.kind == lang_mir.MIR_OP_IMM) {
        if (dst.kind == lang_mir.MIR_OP_MEM) {
            val cr: err[fail.Fail] = emit_fp_const(st, riscv_emit.FP_SCRATCH, src.imm, w);
            if (sel cr.err) { ret cr; }
            ret emit_fp_slot_store(st, f, dst, riscv_emit.FP_SCRATCH, w);
        }
        val rdr: res[i32, fail.Fail] = req_fpr(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        ret emit_fp_const(st, rdr.ok::u32, src.imm, w);
    }

    if (dst.kind != lang_mir.MIR_OP_MEM && src.kind != lang_mir.MIR_OP_MEM) {
        val dfp: bool = reg_is_fp(dst);
        val sfp: bool = reg_is_fp(src);
        if (dfp && sfp) {
            val rdr: res[i32, fail.Fail] = req_fpr(dst);
            if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
            val rnr: res[i32, fail.Fail] = req_fpr(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            # an f16 sits NaN-boxed in the register, which fsgnj.s copies
            # exactly without Zfh: the box is the upper bits of a single's own box
            var f7: u32 = riscv_emit.F7_FSGNJ;
            if (dbl) { f7 = riscv_emit.F7_FSGNJ | 1; }
            val rn: u32 = rnr.ok::u32;
            riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.F3_FLE, f7, rdr.ok::u32, rn, rn);
            ret err[fail.Fail].ok{};
        }
        if ((dfp || sfp) && w == 8 && riscv_emit.xlen(st) == 4) {
            ret err[fail.Fail].err{fail.message("encode: rv32 has no cross-bank move for a 64-bit value (fmv.d.x / fmv.x.d are RV64-only)")};
        }
        if (dfp) {
            val rdr: res[i32, fail.Fail] = req_fpr(dst);
            if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
            val rnr: res[i32, fail.Fail] = req_gpr(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.RM_RNE, fmv_i2f_funct7(w), rdr.ok::u32, rnr.ok::u32, 0);
            ret err[fail.Fail].ok{};
        }
        if (sfp) {
            val rdr: res[i32, fail.Fail] = req_gpr(dst);
            if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
            val rnr: res[i32, fail.Fail] = req_fpr(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            riscv_emit.r_type(st, riscv_emit.OPC_OP_FP, riscv_emit.RM_RNE, fmv_f2i_funct7(w), rdr.ok::u32, rnr.ok::u32, 0);
            ret err[fail.Fail].ok{};
        }
        ret err[fail.Fail].err{fail.message("encode: fmov names two general-purpose registers")};
    }

    if (dst.kind == lang_mir.MIR_OP_MEM) {
        if (src.kind == lang_mir.MIR_OP_MEM) {
            val mr: res[Mem, fail.Fail] = resolve_mem(f, src);
            if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
            val m: Mem = mr.ok;
            if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
            val lr: err[fail.Fail] = emit_fp_mem(st, riscv_emit.FP_SCRATCH, m.base, m.off, w, true);
            if (sel lr.err) { ret lr; }
            ret emit_fp_slot_store(st, f, dst, riscv_emit.FP_SCRATCH, w);
        }
        if (reg_is_fp(src)) {
            val rnr: res[i32, fail.Fail] = req_fpr(src);
            if (sel rnr.err) { ret err[fail.Fail].err{rnr.err}; }
            ret emit_fp_slot_store(st, f, dst, rnr.ok::u32, w);
        }
        ret emit_store_mem(st, f, dst, src, w);
    }

    if (reg_is_fp(dst)) {
        val rdr: res[i32, fail.Fail] = req_fpr(dst);
        if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
        val mr: res[Mem, fail.Fail] = resolve_mem(f, src);
        if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
        val m: Mem = mr.ok;
        if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
        ret emit_fp_mem(st, rdr.ok::u32, m.base, m.off, w, true);
    }
    val rdr: res[i32, fail.Fail] = req_gpr(dst);
    if (sel rdr.err) { ret err[fail.Fail].err{rdr.err}; }
    val mr: res[Mem, fail.Fail] = resolve_mem(f, src);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val m: Mem = mr.ok;
    if (m.has_index) { ret err[fail.Fail].err{fail.message("encode: indexed float spill operand not expected")}; }
    ret emit_mem_access(st, rdr.ok::u32, m.base, m.off, w, true);
}

fun emit_sp_adjust(st: *isa_encode.EncodeState, delta: u32, subtract: bool) {
    var signed: i64 = delta::i64;
    if (subtract) { signed = 0 - signed; }
    if (signed >= -2048 && signed <= 2047) {
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_ADD, riscv_emit.RSP, riscv_emit.RSP, signed::u32 & 0xFFF);
        ret;
    }
    riscv_emit.li(st, riscv_emit.SCRATCH, delta::i64);
    if (subtract) { riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_SUB, riscv_emit.RSP, riscv_emit.RSP, riscv_emit.SCRATCH); }
    or            { riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_ZERO, riscv_emit.RSP, riscv_emit.RSP, riscv_emit.SCRATCH); }
}

# drops sp by a frame's total, touching each probe interval of it in order
# where the target probes, so a frame larger than the stack's guard faults at
# the guard instead of stepping over it. t0 counts what is left and t1 holds
# the interval: no argument rides in either and the prologue has nothing live there
fun emit_frame_sub(st: *isa_encode.EncodeState, total: u32) err[fail.Fail] {
    val step: u32 = isa_encode.STACK_PROBE_INTERVAL::u32;
    if (!st.stack_probe || total <= step) {
        emit_sp_adjust(st, total, true);
        ret err[fail.Fail].ok{};
    }
    riscv_emit.li(st, riscv_emit.SCRATCH, total::i64);
    riscv_emit.li(st, riscv_emit.SCRATCH2, step::i64);
    val loop_top: usize = st.buf.bytes.len;
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_SUB, riscv_emit.RSP, riscv_emit.RSP, riscv_emit.SCRATCH2);
    val touch: err[fail.Fail] = emit_mem_access(st, riscv_emit.RZERO, riscv_emit.RSP, 0, riscv_emit.xlen(st), false);
    if (sel touch.err) { ret touch; }
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_SUB, riscv_emit.SCRATCH, riscv_emit.SCRATCH, riscv_emit.SCRATCH2);
    val back: i64 = loop_top::i64 - st.buf.bytes.len::i64;
    riscv_emit.b_type(st, riscv_emit.OPC_BRANCH, riscv_emit.F3_BLTU, riscv_emit.SCRATCH2, riscv_emit.SCRATCH, back::u32 & 0x1FFF);
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_ADD, riscv_emit.F7_SUB, riscv_emit.RSP, riscv_emit.RSP, riscv_emit.SCRATCH);
    ret err[fail.Fail].ok{};
}

# the bytes the frame record (ra and fp) takes at the frame's top; a frame
# the stack pointer addresses keeps no record
fun record_bytes(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction) i64 {
    if (f.frame.sp_frame) { ret 0; }
    ret 2 * riscv_emit.xlen(st)::i64;
}

fun save_callee_gp(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, total: u32, store: bool) {
    val w:   u8  = riscv_emit.xlen(st);
    val rec: i64 = record_bytes(st, f);
    var n:   u32 = 0;
    var r:   u32 = 0;
    for (r < 32) {
        if ((f.callee_mask & (1::u32 << r)) != 0) {
            val off: i64 = (total::i64) - rec - w::i64 - (w::i64 * n::i64);
            emit_mem_access(st, r, riscv_emit.RSP, off, w, !store);
            n = n + 1;
        }
        r = r + 1;
    }
}

fun save_callee_fp(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, total: u32, store: bool) {
    val xw:       u8  = riscv_emit.xlen(st);
    val fw:       u8  = riscv_emit.flen(st);
    val rec:      i64 = record_bytes(st, f);
    val gp_bytes: i64 = (common.popcount32(f.callee_mask)::i64 * xw::i64);
    var n:        u32 = 0;
    var r:        u32 = 0;
    for (r < 32) {
        if ((f.callee_mask_fp & (1::u32 << r)) != 0) {
            val off: i64 = (total::i64) - rec - gp_bytes - fw::i64 - (fw::i64 * n::i64);
            emit_fp_mem(st, r, riscv_emit.RSP, off, fw, !store);
            n = n + 1;
        }
        r = r + 1;
    }
}

fun emit_prologue(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, total: u32, fn_base: u32) err[fail.Fail] {
    val rf: err[fail.Fail] = isa_encode.push_frame(st, fn_base);
    if (sel rf.err) { ret rf; }
    val w: i64 = riscv_emit.xlen(st)::i64;

    if (f.frame.sp_frame) {
        val fsub: err[fail.Fail] = emit_frame_sub(st, total);
        if (sel fsub.err) { ret fsub; }
        val ra: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_ALLOC, 0, st.buf.bytes.len::u32 - fn_base, total::u64);
        if (sel ra.err) { ret ra; }
        save_callee_gp(st, f, total, true);
        save_callee_fp(st, f, total, true);
        ret record_callee_saves(st, f, total, st.buf.bytes.len::u32 - fn_base);
    }

    # a realigned frame stores the link below the incoming stack pointer and
    # names it before the realignment; any other drops the stack pointer first
    var link: i64 = total::i64;
    if (f.frame.realign == 0) {
        val fsub: err[fail.Fail] = emit_frame_sub(st, total);
        if (sel fsub.err) { ret fsub; }
        val ra: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_ALLOC, 0, st.buf.bytes.len::u32 - fn_base, total::u64);
        if (sel ra.err) { ret ra; }
    }
    or { link = 0; }

    val sr: err[fail.Fail] = emit_mem_access(st, riscv_emit.RRA, riscv_emit.RSP, link - w, riscv_emit.xlen(st), false);
    if (sel sr.err) { ret sr; }
    val rra: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SAVE, riscv_emit.RRA::u8, st.buf.bytes.len::u32 - fn_base, (link - w)::u64);
    if (sel rra.err) { ret rra; }
    val sf: err[fail.Fail] = emit_mem_access(st, riscv_emit.RFP, riscv_emit.RSP, link - 2 * w, riscv_emit.xlen(st), false);
    if (sel sf.err) { ret sf; }
    val rfp: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SAVE, riscv_emit.RFP::u8, st.buf.bytes.len::u32 - fn_base, (link - 2 * w)::u64);
    if (sel rfp.err) { ret rfp; }
    emit_addi(st, riscv_emit.RFP, riscv_emit.RSP, link);
    val rs: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SET_FP, riscv_emit.RFP::u8, st.buf.bytes.len::u32 - fn_base, link::u64);
    if (sel rs.err) { ret rs; }

    if (f.frame.realign != 0) {
        emit_sp_realign(st, f.frame.realign);
        val rr: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_REALIGN, 0, st.buf.bytes.len::u32 - fn_base, f.frame.realign::u64);
        if (sel rr.err) { ret rr; }
        val fsub: err[fail.Fail] = emit_frame_sub(st, total);
        if (sel fsub.err) { ret fsub; }
        val ra: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_ALLOC, 0, st.buf.bytes.len::u32 - fn_base, total::u64);
        if (sel ra.err) { ret ra; }
    }
    save_callee_gp(st, f, total, true);
    save_callee_fp(st, f, total, true);
    ret record_callee_saves(st, f, total, st.buf.bytes.len::u32 - fn_base);
}

# the callee-saved registers the prologue stored at their offsets from the
# stack pointer the body runs with, as save_callee_gp and save_callee_fp lay
# them out; none is changed before the prologue ends, so each holds from there
fun record_callee_saves(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, total: u32, end_off: u32) err[fail.Fail] {
    val xw:  i64 = riscv_emit.xlen(st)::i64;
    val fw:  i64 = riscv_emit.flen(st)::i64;
    val rec: i64 = record_bytes(st, f);
    var n:   i64 = 0;
    var r:   u32 = 0;
    for (r < 32) {
        if ((f.callee_mask & (1::u32 << r)) != 0) {
            val off: i64            = total::i64 - rec - xw - xw * n;
            val sr:  err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SAVE, r::u8, end_off, off::u64);
            if (sel sr.err) { ret sr; }
            n = n + 1;
        }
        r = r + 1;
    }
    val gp_bytes: i64 = n * xw;
    n = 0;
    r = 0;
    for (r < 32) {
        if ((f.callee_mask_fp & (1::u32 << r)) != 0) {
            val off: i64            = total::i64 - rec - gp_bytes - fw - fw * n;
            val sr:  err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SAVE_VEC, r::u8, end_off, off::u64);
            if (sel sr.err) { ret sr; }
            n = n + 1;
        }
        r = r + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_sp_realign(st: *isa_encode.EncodeState, realign: u32) {
    if (realign == 0) { ret; }
    val m: i64 = 0 - realign::i64;
    if (m >= -2048) {
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_AND, riscv_emit.RSP, riscv_emit.RSP, m::u32 & 0xFFF);
        ret;
    }
    riscv_emit.li(st, riscv_emit.SCRATCH, m);
    riscv_emit.r_type(st, riscv_emit.OPC_OP, riscv_emit.F3_AND, riscv_emit.F7_ZERO, riscv_emit.RSP, riscv_emit.RSP, riscv_emit.SCRATCH);
}

fun emit_epilogue(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, total: u32) {
    save_callee_gp(st, f, total, false);
    save_callee_fp(st, f, total, false);
    if (f.frame.sp_frame) {
        emit_sp_adjust(st, total, false);
        ret;
    }
    if (f.frame.realign != 0) {
        emit_addi(st, riscv_emit.RSP, riscv_emit.RFP, 0);
        emit_mem_access(st, riscv_emit.RRA, riscv_emit.RSP, 0 - riscv_emit.xlen(st)::i64, riscv_emit.xlen(st), true);
        emit_mem_access(st, riscv_emit.RFP, riscv_emit.RSP, 0 - (2 * riscv_emit.xlen(st)::i64), riscv_emit.xlen(st), true);
        ret;
    }
    emit_mem_access(st, riscv_emit.RRA, riscv_emit.RSP, (total::i64) - riscv_emit.xlen(st)::i64, riscv_emit.xlen(st), true);
    emit_mem_access(st, riscv_emit.RFP, riscv_emit.RSP, (total::i64) - (2 * riscv_emit.xlen(st)::i64), riscv_emit.xlen(st), true);
    emit_sp_adjust(st, total, false);
}

fun encode_mir_instr(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val op: u32 = mi.opcode;

    if (common.is_mir_compare(mi.opcode))                                                 { ret encode_compare(st, mi); }
    if (mi.opcode == lang_mir.MIR_SEL_MASK_LT_U)                                          { ret encode_compare_mask(st, mi); }
    if (mi.opcode == lang_mir.MIR_SEL_SELECT || mi.opcode == lang_mir.MIR_SEL_SELECT_CMP) { ret encode_select(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_SEL_CBR)                                                { ret encode_cbr(st, fn_base, mi); }

    if (lang_mir.is_fused_cbr(mi.opcode)) { ret encode_fused_cbr(st, fn_base, mi); }

    if (common.is_mir_divide(mi.opcode)) { ret encode_divide(st, mi); }

    if (mi.opcode == lang_mir.MIR_MOV) {
        if (reg_is_fp(?mi.operands[0]) || reg_is_fp(?mi.operands[1])) { ret encode_fmov(st, f, mi); }
        ret encode_mov(st, f, mi);
    }

    if (mi.opcode == lang_mir.MIR_ALLOCA || mi.opcode == lang_mir.MIR_GEP) { ret encode_addr(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_LOAD)                                    { ret encode_load(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_STORE)                                   { ret encode_store(st, f, mi); }

    if (mi.opcode == lang_mir.MIR_TRUNC || mi.opcode == lang_mir.MIR_SEXT ||
        mi.opcode == lang_mir.MIR_ZEXT || mi.opcode == lang_mir.MIR_BITCAST) {
        ret encode_convert(st, mi);
    }

    if (common.is_mir_float_arith(mi.opcode)) { ret encode_fp_arith(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_FNEG)       { ret encode_fp_neg(st, f, mi); }
    if (mi.opcode == lang_mir.MIR_FCMP)       { ret encode_fp_cmp(st, f, mi); }

    if (common.is_mir_float_conv(mi.opcode)) { ret encode_fp_conv(st, f, mi); }

    if (mi.opcode == lang_mir.MIR_CALL) { ret encode_call(st, mi); }

    if (mi.opcode == lang_mir.MIR_ASM) { ret riscv_grammar.encode_asm_block(st, f, fn_base, mi); }

    if (op == isa_riscv.ADD::u32)   { ret encode_addsub(st, mi, false); }
    if (op == isa_riscv.SUB::u32)   { ret encode_addsub(st, mi, true); }
    if (op == isa_riscv.MUL::u32)   { ret encode_alu3(st, mi, riscv_emit.F3_ADD, riscv_emit.F7_MULDIV, true); }
    if (op == isa_riscv.MULHU::u32) { ret encode_alu3(st, mi, riscv_emit.F3_SLTU, riscv_emit.F7_MULDIV, false); }
    if (op == isa_riscv.MULH::u32)  { ret encode_alu3(st, mi, riscv_emit.F3_SLL, riscv_emit.F7_MULDIV, false); }
    if (op == isa_riscv.AND::u32)   { ret encode_alu3(st, mi, riscv_emit.F3_AND, riscv_emit.F7_ZERO, false); }
    if (op == isa_riscv.OR::u32)    { ret encode_alu3(st, mi, riscv_emit.F3_OR, riscv_emit.F7_ZERO, false); }
    if (op == isa_riscv.XOR::u32)   { ret encode_alu3(st, mi, riscv_emit.F3_XOR, riscv_emit.F7_ZERO, false); }
    if (op == isa_riscv.SLL::u32)   { ret encode_shift(st, mi, riscv_emit.F3_SLL, false); }
    if (op == isa_riscv.SRL::u32)   { ret encode_shift(st, mi, riscv_emit.F3_SRL, false); }
    if (op == isa_riscv.SRA::u32)   { ret encode_shift(st, mi, riscv_emit.F3_SRL, true); }
    if (op == isa_riscv.NEG::u32)   { ret encode_neg(st, mi); }
    if (op == isa_riscv.NOT::u32)   { ret encode_not(st, mi); }
    if (op == isa_riscv.MOV::u32)   { ret encode_mov(st, f, mi); }
    if (op == isa_riscv.FMV::u32)   { ret encode_fmov(st, f, mi); }
    if (op == isa_riscv.JMP::u32)   { ret encode_branch(st, fn_base, mi); }
    if (op == isa_riscv.RET::u32) {
        riscv_emit.i_type(st, riscv_emit.OPC_JALR, riscv_emit.F3_ADD, riscv_emit.RZERO, riscv_emit.RRA, 0);
        ret err[fail.Fail].ok{};
    }
    if (op == isa_riscv.NOP::u32) {
        riscv_emit.i_type(st, riscv_emit.OPC_OP_IMM, riscv_emit.F3_ADD, riscv_emit.RZERO, riscv_emit.RZERO, 0);
        ret err[fail.Fail].ok{};
    }
    if (op == isa_riscv.EBREAK::u32) {
        riscv_emit.i_type(st, riscv_emit.OPC_SYSTEM, riscv_emit.F3_ADD, riscv_emit.RZERO, riscv_emit.RZERO, 1);
        ret err[fail.Fail].ok{};
    }

    val failure: err[fail.Fail] = isa_encode.opcode_failure(st, f, "riscv", mi.opcode);
    if (sel failure.err) { ret err[fail.Fail].err{failure.err}; }
    ret err[fail.Fail].ok{};
}

fun set_branch_disp(buf: *isa_encode.ByteBuf, pos: usize, disp: u32) {
    val word: u32 = isa_encode.word_read(buf, pos);
    isa_encode.word_write(buf, pos, (word & 0x01FFF07F) | riscv_emit.b_imm(disp));
}

fun write_inverted_guard(buf: *isa_encode.ByteBuf, pos: usize, bne_word: u32, disp: u32) {
    val funct3: u32 = ((bne_word >> 12) & 0x7) ^ 0x1;
    val rs1:    u32 = (bne_word >> 15) & 0x1F;
    val rs2:    u32 = (bne_word >> 20) & 0x1F;
    isa_encode.word_write(buf, pos, riscv_emit.pack_b(riscv_emit.OPC_BRANCH, funct3, rs1, rs2, disp));
}

# the branch with the opposite sense; absent for an opcode that is not a
# conditional branch
fun invert_branch(op: inst.MachOp) opt[inst.MachOp] {
    if (op == inst.BEQ)  { ret opt[inst.MachOp].some{inst.BNE}; }
    if (op == inst.BNE)  { ret opt[inst.MachOp].some{inst.BEQ}; }
    if (op == inst.BLT)  { ret opt[inst.MachOp].some{inst.BGE}; }
    if (op == inst.BGE)  { ret opt[inst.MachOp].some{inst.BLT}; }
    if (op == inst.BLTU) { ret opt[inst.MachOp].some{inst.BGEU}; }
    if (op == inst.BGEU) { ret opt[inst.MachOp].some{inst.BLTU}; }
    ret opt[inst.MachOp].none{};
}

fun renote_relaxed_branch(st: *isa_encode.EncodeState, guard_pos: u32, jal_pos: u32, target_block: u32) err[fail.Fail] {
    if (!isa_encode.sink_active(?st.buf)) { ret err[fail.Fail].ok{}; }
    val idx: i32 = isa_encode.note_index_at(?st.buf, guard_pos);
    if (idx < 0) {
        ret err[fail.Fail].err{fail.message("encode: riscv64 branch relaxation found no notification for the branch it widened")};
    }
    val guard:      *isa_encode.AsmNote = isa_encode.note_at(?st.buf, idx::u32);
    val inverted_o: opt[inst.MachOp]    = invert_branch(guard.inst.opcode::inst.MachOp);
    if (sel inverted_o.none) {
        ret err[fail.Fail].err{fail.message("encode: riscv64 branch relaxation widened an instruction that is not a conditional branch")};
    }
    val inverted: inst.MachOp = inverted_o.some;

    var jump: isa_encode.AsmNote = isa_encode.note_blank();
    jump.loc         = guard.loc;
    jump.inline_site = guard.inline_site;
    jump.mi          = guard.mi;
    jump.off         = jal_pos;
    jump.inst        = riscv_emit.build_inst(inst.JAL, riscv_emit.RZERO, 0, 0, 0);
    jump.inst.src1   = isa_inst.make_block_label(target_block);

    guard.inst.opcode   = inverted::u16;
    guard.inst.src2     = isa_inst.make_block_label(0);
    guard.inst.src2.imm = 8;
    guard.inst.flags    = guard.inst.flags | inst.FLAG_LABEL_SKIP;

    val noted: err[fail.Fail] = isa_encode.note_insert_after(?st.buf, idx::u32, ?jump, riscv_emit.WORD_SIZE);
    if (sel noted.err) { ret err[fail.Fail].err{noted.err}; }
    ret err[fail.Fail].ok{};
}

fun renote_trampoline(st: *isa_encode.EncodeState, auipc_pos: u32, jalr_pos: u32, target_block: u32) err[fail.Fail] {
    if (!isa_encode.sink_active(?st.buf)) { ret err[fail.Fail].ok{}; }
    val idx: i32 = isa_encode.note_index_at(?st.buf, auipc_pos);
    if (idx < 0) {
        ret err[fail.Fail].err{fail.message("encode: riscv64 branch relaxation found no notification for the jump it widened")};
    }
    val hi: *isa_encode.AsmNote = isa_encode.note_at(?st.buf, idx::u32);
    hi.inst              = riscv_emit.build_inst(inst.AUIPC, riscv_emit.SCRATCH, 0, 0, 0);
    hi.inst.src1         = isa_inst.make_block_label(target_block);
    hi.inst.src1.sym_mod = isa_inst.SYM_MOD_PCREL_HI;

    var lo: isa_encode.AsmNote = isa_encode.note_blank();
    lo.loc               = hi.loc;
    lo.inline_site       = hi.inline_site;
    lo.mi                = hi.mi;
    lo.off               = jalr_pos;
    lo.inst              = riscv_emit.build_inst(inst.JALR, riscv_emit.RZERO, riscv_emit.SCRATCH, 0, 0);
    lo.inst.src1.sym_mod = isa_inst.SYM_MOD_PCREL_LO;
    lo.inst.src1.imm     = target_block::i64;
    lo.inst.flags        = inst.FLAG_TARGET_BLOCK;

    val noted: err[fail.Fail] = isa_encode.note_insert_after(?st.buf, idx::u32, ?lo, riscv_emit.WORD_SIZE);
    if (sel noted.err) { ret err[fail.Fail].err{noted.err}; }
    ret err[fail.Fail].ok{};
}

fun renote_guard_skip(st: *isa_encode.EncodeState, guard_pos: u32, disp: i64) err[fail.Fail] {
    if (!isa_encode.sink_active(?st.buf)) { ret err[fail.Fail].ok{}; }
    val idx: i32 = isa_encode.note_index_at(?st.buf, guard_pos);
    if (idx < 0) {
        ret err[fail.Fail].err{fail.message("encode: riscv64 branch relaxation found no notification for the guard it widened")};
    }
    val guard: *isa_encode.AsmNote = isa_encode.note_at(?st.buf, idx::u32);
    guard.inst.src2.imm = disp;
    ret err[fail.Fail].ok{};
}

fun relax_function(st: *isa_encode.EncodeState, fn_base: u32, fixup_start: u32) err[fail.Fail] {
    ret relax_function_bounded(st, fn_base, fixup_start,
        relax_round_bound(st.fixup_count - fixup_start));
}

fun relax_round_bound(count: u32) u64 {
    ret 2 * count::u64 + 1;
}

fun relax_function_bounded(st: *isa_encode.EncodeState, fn_base: u32, fixup_start: u32,
    max_rounds: u64) err[fail.Fail] {
    val count: u32 = st.fixup_count - fixup_start;
    if (count == 0) { ret err[fail.Fail].ok{}; }

    val res_marks: res[*u8, A.Error] = A.allocate[u8](st.alloc, count::usize);
    if (sel res_marks.err) { ret err[fail.Fail].err{fail.refused(res_marks.err)}; }
    val relaxed: *u8 = res_marks.ok;
    fin { A.deallocate[u8](st.alloc, relaxed, count::usize); }
    var z: u32 = 0;
    for (z < count) {
        relaxed[z] = 0;
        z          = z + 1;
    }

    var rounds:  u64  = 0;
    var changed: bool = true;
    for (changed) {
        if (rounds >= max_rounds) {
            ret err[fail.Fail].err{fail.formatted(st.alloc,
                "encode: riscv branch relaxation did not settle within its {}-round bound; each branch widens at most twice, so exceeding the bound means a widening made no progress",
                max_rounds)};
        }
        rounds  = rounds + 1;
        changed = false;
        var i: u32 = fixup_start;
        for (i < st.fixup_count) {
            val fx:      *isa_encode.BranchFixup = ?st.fixups[i];
            val res_off: res[u32, fail.Fail]     = isa_encode.block_offset(st, fn_base, fx.target_block);
            if (sel res_off.err) { ret err[fail.Fail].err{res_off.err}; }
            val target_off: u32 = res_off.ok;
            val word:       u32 = isa_encode.word_read(?st.buf, fx.patch_pos::usize);
            val opcode:     u32 = word & 0x7F;
            val sdisp:      i64 = (target_off::i64) - (fx.patch_pos::i64);

            if (opcode == riscv_emit.OPC_BRANCH && (sdisp < riscv_emit.B_DISP_MIN || sdisp > riscv_emit.B_DISP_MAX)) {
                val guard_pos: u32            = fx.patch_pos;
                val jal_pos:   u32            = fx.patch_pos + 4;
                val ins:       err[fail.Fail] = isa_encode.insert_text(st, jal_pos, 4);
                if (sel ins.err) { ret err[fail.Fail].err{ins.err}; }
                write_inverted_guard(?st.buf, guard_pos::usize, word, 8);
                isa_encode.word_write(?st.buf, jal_pos::usize, riscv_emit.pack_j(riscv_emit.OPC_JAL, riscv_emit.RZERO, 0));
                val rn: err[fail.Fail] = renote_relaxed_branch(st, guard_pos, jal_pos, fx.target_block);
                if (sel rn.err) { ret rn; }
                fx.patch_pos             = jal_pos;
                fx.next_ip               = jal_pos + 4;
                relaxed[i - fixup_start] = 1;
                changed                  = true;
                brk;
            }
            if (opcode == riscv_emit.OPC_JAL && (sdisp < riscv_emit.J_DISP_MIN || sdisp > riscv_emit.J_DISP_MAX)) {
                val auipc_pos: u32            = fx.patch_pos;
                val jalr_pos:  u32            = fx.patch_pos + 4;
                val ins:       err[fail.Fail] = isa_encode.insert_text(st, jalr_pos, 4);
                if (sel ins.err) { ret err[fail.Fail].err{ins.err}; }
                isa_encode.word_write(?st.buf, auipc_pos::usize, riscv_emit.pack_u(riscv_emit.OPC_AUIPC, riscv_emit.SCRATCH, 0));
                isa_encode.word_write(?st.buf, jalr_pos::usize, riscv_emit.pack_i(riscv_emit.OPC_JALR, riscv_emit.F3_ADD, riscv_emit.RZERO, riscv_emit.SCRATCH, 0));
                val rn: err[fail.Fail] = renote_trampoline(st, auipc_pos, jalr_pos, fx.target_block);
                if (sel rn.err) { ret rn; }
                fx.next_ip = auipc_pos + 8;
                if (relaxed[i - fixup_start] != 0) {
                    val guard_pos: u32 = auipc_pos - 4;
                    set_branch_disp(?st.buf, guard_pos::usize, fx.next_ip - guard_pos);
                    val rg: err[fail.Fail] = renote_guard_skip(st, guard_pos, (fx.next_ip - guard_pos)::i64);
                    if (sel rg.err) { ret rg; }
                }
                changed = true;
                brk;
            }
            i = i + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

fun encode_function(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction) err[fail.Fail] {
    if (f.block_count == 0)               { ret err[fail.Fail].ok{}; }
    if (!isa_encode.sink_active(?st.buf)) { ret encode_function_body(st, f); }

    var head: isa_encode.AsmNote = isa_encode.note_blank();
    head.kind = isa_encode.ASM_NOTE_FUNC;
    head.off  = st.buf.bytes.len::u32;
    head.name = f.name;
    val rh: err[fail.Fail] = isa_encode.note_push(?st.buf, ?head);
    if (sel rh.err) { ret err[fail.Fail].err{rh.err}; }

    val res_: err[fail.Fail] = encode_function_body(st, f);
    if (sel res_.err) { ret res_; }
    # the notes stay until the driver has consumed them; rendering needs a writer
    if (!isa_encode.sink_renders(?st.buf)) { ret err[fail.Fail].ok{}; }
    ret riscv_printer.render_notes(?st.buf);
}

# re-decodes every emitted word through the table so the admission check does
# not trust the emitter's own opcode bookkeeping
fun check_generated_admission(st: *isa_encode.EncodeState, start: usize) err[fail.Fail] {
    if (start > st.buf.bytes.len || (st.buf.bytes.len - start) % 4 != 0) {
        ret err[fail.Fail].err{fail.message("internal compiler error: generated RISC-V instructions are not word aligned")};
    }
    var at: usize = start;
    for (at < st.buf.bytes.len) {
        val r: err[fail.Fail] = riscv_emit.admission(st.model.extensions, riscv_emit.xlen(st),
            inst.classify(isa_encode.word_read(?st.buf, at)));
        if (sel r.err) { ret r; }
        at = at + 4;
    }
    ret err[fail.Fail].ok{};
}

fun encode_function_body(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction) err[fail.Fail] {
    val fn_base:     u32 = st.buf.bytes.len::u32;
    val fixup_start: u32 = st.fixup_count;

    val ms: err[fail.Fail] = isa_encode.push_symbol(st, f.name, fn_base, target_of.SYM_OBJ_FLAG_FUNCTION);
    if (sel ms.err) { ret err[fail.Fail].err{ms.err}; }

    val naked: bool = f.frame.omit;
    val total: u32  = f.frame.base_dist + f.frame.fp_dist;
    if (!naked) {
        val rpl: err[fail.Fail] = emit_prologue(st, f, total, fn_base);
        if (sel rpl.err) { ret rpl; }
    }
    or (!f.naked && !f.frame.opaque) {
        # a leaf without a frame keeps the frame its call left, which a record with no steps says
        val rf: err[fail.Fail] = isa_encode.push_frame(st, fn_base);
        if (sel rf.err) { ret rf; }
    }
    val admitted: err[fail.Fail] = check_generated_admission(st, fn_base::usize);
    if (sel admitted.err) { ret admitted; }
    val rp: err[fail.Fail] = isa_encode.sink_check(st, HOOKS.isa, isa_encode.REGION_PROLOGUE);
    if (sel rp.err) { ret rp; }

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *lang_mir.MirBlock = ?f.blocks[bi];
        val rb:  err[fail.Fail]     = isa_encode.push_block(st, fn_base, blk.id, st.buf.bytes.len::u32);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        isa_encode.set_fallthrough(st, f, bi);

        if (isa_encode.sink_active(?st.buf)) {
            var label: isa_encode.AsmNote = isa_encode.note_blank();
            label.kind = isa_encode.ASM_NOTE_BLOCK;
            label.off  = st.buf.bytes.len::u32;
            label.id   = blk.id;
            val rl: err[fail.Fail] = isa_encode.note_push(?st.buf, ?label);
            if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
        }

        var jumped: bool = false;
        var ii:     u32  = 0;
        for (ii < blk.instr_count) {
            val mi: *lang_mir.MirInstr = ?blk.instrs[ii];
            # the return a tail jump replaced is never reached
            if (!lang_mir.emits_instr(f, mi) || (jumped && mi.opcode::u16 == isa_riscv.RET::u16)) {
                ii = ii + 1;
                cnt;
            }
            val rr: err[fail.Fail] = isa_encode.push_row(st, st.buf.bytes.len::u32, mi.loc);
            if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
            val rip: err[fail.Fail] = isa_encode.push_inline_pc(st, st.buf.bytes.len::u32, mi.inline_site);
            if (sel rip.err) { ret err[fail.Fail].err{rip.err}; }
            val generated_start: usize = st.buf.bytes.len;
            val tail:            bool  = mi.opcode == lang_mir.MIR_CALL && mi.tail;
            if (tail) { jumped = true; }
            if ((mi.opcode::u16 == isa_riscv.RET::u16 || tail) && !naked) {
                emit_epilogue(st, f, total);
            }
            val ei: err[fail.Fail] = isa_encode.instr_encode(st, f, fn_base, mi, ?HOOKS);
            if (sel ei.err) { ret ei; }
            if (mi.opcode != lang_mir.MIR_ASM) {
                val ar: err[fail.Fail] = check_generated_admission(st, generated_start);
                if (sel ar.err) { ret ar; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    val rx: err[fail.Fail] = relax_function(st, fn_base, fixup_start);
    if (sel rx.err) { ret rx; }
    ret isa_encode.sink_check(st, HOOKS.isa, isa_encode.REGION_RELAX);
}

# the hooks the shared encode driver runs this encoder through
pub val HOOKS: isa_encode.EncodeHooks = isa_encode.EncodeHooks{
    isa:             "riscv64",
    encode_function: encode_function,
    encode_instr:    encode_mir_instr,
    patch_branch:    riscv_emit.patch_branch,
    stream:          true,
    effects:         isa_effect.Hooks{
        describe:   riscv_effects.describe,
        mnemonic:   riscv_grammar.mnemonic,
        reg_name:   riscv_grammar.reg_name,
        const_regs: 1::u64 << isa_riscv.ZERO::u64,
    },
};
