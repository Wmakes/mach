use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.size.usize;

use A: std.allocator;

use lang_mir: mach.lang.mir;
use mach.lang.target.isa;
use isa_riscv: mach.lang.target.isa.riscv;
use isa_rules: mach.lang.target.isa.rules;

val RULE_COUNT: usize = 68;

val COPY_OPCODE_COUNT: usize = 3;

val FUSED_CC_COUNT: usize = 6;

val RULES: [RULE_COUNT]isa_rules.Rule = [RULE_COUNT]isa_rules.Rule{
    isa_rules.Rule{op: lang_mir.MIR_ADD, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.ADD::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SUB, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.SUB::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_MUL, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.MUL::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_MUL_HI_U, gate: isa_rules.GATE_SCALAR, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.MULHU::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_MUL_HI_S, gate: isa_rules.GATE_SCALAR, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.MULH::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_AND, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.AND::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_OR, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.OR::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_XOR, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.XOR::u32, expand: nil, expansion_length: 0},

    isa_rules.Rule{op: lang_mir.MIR_SHL, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.SLL::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SHR_U, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.SRL::u32, expand: nil, expansion_length: 0},
