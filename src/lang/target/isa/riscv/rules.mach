    isa_rules.Rule{op: lang_mir.MIR_ARG, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_CALL_RES, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_PHI, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    isa_rules.Rule{op: lang_mir.MIR_FADD, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_FSUB, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_FMUL, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_FDIV, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_FCMP, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_FNEG, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    isa_rules.Rule{op: lang_mir.MIR_BITCAST, gate: isa_rules.GATE_ANY, guard: isa_rules.guard_fp_bank_move, kind: isa_rules.RULE_RETAG, to: isa_riscv.FMV::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_BITCAST, gate: isa_rules.GATE_ANY, guard: guard_identity_copy, kind: isa_rules.RULE_RETAG, to: isa_riscv.MOV::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_BITCAST, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    isa_rules.Rule{op: lang_mir.MIR_TRUNC, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SEXT, gate: isa_rules.GATE_ANY, guard: guard_identity_copy, kind: isa_rules.RULE_RETAG, to: isa_riscv.MOV::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SEXT, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_ZEXT, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_FP_TRUNC, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_FP_EXT, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_FP_TO_SI, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_FP_TO_UI, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SI_TO_FP, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_UI_TO_FP, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    isa_rules.Rule{op: lang_mir.MIR_ASM, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
