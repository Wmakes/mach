val COPY_OPCODES: [COPY_OPCODE_COUNT]u32 = [COPY_OPCODE_COUNT]u32{
    isa_riscv.MOV::u32,
    isa_riscv.FMV::u32,
    lang_mir.MIR_MOV,
};

val FUSED_CCS: [FUSED_CC_COUNT]u32 = [FUSED_CC_COUNT]u32{
    lang_mir.MIR_CMP_EQ,
    lang_mir.MIR_CMP_NE,
    lang_mir.MIR_CMP_LT_S,
    lang_mir.MIR_CMP_LT_U,
    lang_mir.MIR_CMP_LE_S,
    lang_mir.MIR_CMP_LE_U,
};

val PACK: isa_rules.RulePack = isa_rules.RulePack{
    name:               "riscv64",
    rules:              ?RULES[0],
    rule_count:         RULE_COUNT::u32,
    copy_opcodes:       ?COPY_OPCODES[0],
    copy_opcode_count:  COPY_OPCODE_COUNT::u32,
    fused_cbr_ccs:      ?FUSED_CCS[0],
    fused_cbr_cc_count: FUSED_CC_COUNT::u32,
};

pub fun select(a: *A.Allocator, tgt: *isa.BackendTarget, f: *lang_mir.MirFunction) err[fail.Fail] {
    ret isa_rules.select_function(?PACK, a, tgt, f);
}

pub fun is_reg_move(opcode: u32) bool {
    ret isa_rules.is_reg_move(?PACK, opcode);
}

# one addi builds a 12-bit signed value and one lui a 32-bit one whose low 12
# bits are zero; any other takes lui and addi or more, the rule the middle end
# hoists a loop's constants by. the value is read sign-extended from
# its width, as the materialization reads it
pub fun int_imm_fits(value: u64, bits: u32) bool {
    var v: i64 = value:~i64;
    if (bits < 64) {
        val sh: u64 = (64 - bits)::u64;
        v = (v << sh) >> sh;
    }
    if (v >= -2048 && v <= 2047) { ret true; }
    ret (v & 0xFFF) == 0 && v >= -2147483648 && v <= 2147483647;
}

pub fun is_trap_terminator(opcode: u32) bool {
    ret opcode == isa_riscv.EBREAK::u32;
}

fun guard_identity_copy(tgt: *isa.BackendTarget, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) bool {
    if (mi.operand_count != 2)             { ret false; }
    if (mi.opcode == lang_mir.MIR_BITCAST) { ret mi.width >= tgt.model.gpr_width; }
    ret mi.src_width >= tgt.model.gpr_width;
}
