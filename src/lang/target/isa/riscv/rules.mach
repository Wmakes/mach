    isa_rules.Rule{op: lang_mir.MIR_SEL_CBR_NE, gate: isa_rules.GATE_SCALAR, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SEL_CBR_LT_S, gate: isa_rules.GATE_SCALAR, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SEL_CBR_LT_U, gate: isa_rules.GATE_SCALAR, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SEL_CBR_LE_S, gate: isa_rules.GATE_SCALAR, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SEL_CBR_LE_U, gate: isa_rules.GATE_SCALAR, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    isa_rules.Rule{op: lang_mir.MIR_ALLOCA, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_LOAD, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_STORE, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
