    isa_rules.Rule{op: lang_mir.MIR_NOT, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.NOT::u32, expand: nil, expansion_length: 0},

    isa_rules.Rule{op: lang_mir.MIR_MOV, gate: isa_rules.GATE_ANY, guard: isa_rules.guard_fp_bank_move, kind: isa_rules.RULE_RETAG, to: isa_riscv.FMV::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_MOV, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.MOV::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_DECLASSIFY, gate: isa_rules.GATE_ANY, guard: isa_rules.guard_fp_bank_move, kind: isa_rules.RULE_RETAG, to: isa_riscv.FMV::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_DECLASSIFY, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: isa_riscv.MOV::u32, expand: nil, expansion_length: 0},

