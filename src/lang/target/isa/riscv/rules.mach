    isa_rules.Rule{op: lang_mir.MIR_CMP_LT_S, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_CMP_LT_S, expand: nil, expansion_length: 0},
