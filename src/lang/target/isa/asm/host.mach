# windows has no syscall ABI, so neither a body that ends control through one
# nor a raw console write exists there
$if ($mach.build.os != $mach.os.windows) {}

$if ($mach.build.arch == $mach.arch.x86_64 || $mach.build.arch == $mach.arch.aarch64) {}

$if ($mach.build.os == $mach.os.linux && $mach.build.arch == $mach.arch.x86_64) {}
