use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

use target_of: mach.lang.target.of;
use mach.lang.target.of.bin;
use of_reloc: mach.lang.target.of.reloc;

val ROW_COUNT: usize                   = 12;
val ROWS:      [ROW_COUNT]of_reloc.Row = [ROW_COUNT]of_reloc.Row{
    of_reloc.Row{kind: target_of.RK_ABS64, width: 8, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: of_reloc.site_abs64},
    of_reloc.Row{kind: target_of.RK_ABS32, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: of_reloc.site_abs32},
    of_reloc.Row{kind: target_of.RK_PC32, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: true, apply: of_reloc.site_pcrel32},
    of_reloc.Row{kind: target_of.RK_PC64, width: 8, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: of_reloc.site_pcrel64},
    of_reloc.Row{kind: target_of.RK_PLT32, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: true, apply: of_reloc.site_pcrel32},
    of_reloc.Row{kind: target_of.RK_GOTPCREL, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: true, apply: of_reloc.site_pcrel32},
    of_reloc.Row{kind: target_of.RK_GOTPCREL_NORELAX, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: true, apply: of_reloc.site_pcrel32},
    of_reloc.Row{kind: target_of.RK_GOTPCREL64_NORELAX, width: 8, mode: of_reloc.ADDEND_SYMBOL, text_bias: true, apply: of_reloc.site_pcrel64},
    of_reloc.Row{kind: target_of.RK_ADDR32NB, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: addr32nb},
    of_reloc.Row{kind: target_of.RK_SECREL32, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: secrel32},
    of_reloc.Row{kind: target_of.RK_SECTION, width: 2, mode: of_reloc.ADDEND_IGNORED, text_bias: false, apply: section_index},
    of_reloc.Row{kind: target_of.RK_ABS32S, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: abs32s},
};

pub fun is_local_got_kind(kind: target_of.RelocKind) bool {
    ret kind == target_of.RK_GOTPCREL || kind == target_of.RK_GOTPCREL_NORELAX
        || kind == target_of.RK_GOTPCREL64_NORELAX;
}

pub fun reloc_traits(kind: target_of.RelocKind,
    section_kind: target_of.SectionKind,
    codegen_image: bool) res[of_reloc.RelocTraits, of_reloc.RelocError] {
    ret of_reloc.table_traits(?ROWS[0], ROW_COUNT, kind, section_kind, codegen_image);
}

pub fun apply_reloc(kind: target_of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
    target: of_reloc.RelocTarget, addend: i64, patch_va: u64,
    image_base: u64) res[bool, of_reloc.RelocError] {
    ret of_reloc.table_apply(?ROWS[0], ROW_COUNT, kind, dst, patch_off, sec_len, target, addend, patch_va, image_base);
}

# the image-relative 32-bit address windows' unwind and data directories name
fun addr32nb(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 4 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val adjusted: res[u64, of_reloc.RelocError] = of_reloc.add_signed_to_u64(s.target.vaddr, s.addend);
    if (sel adjusted.err) {
        ret res[bool, of_reloc.RelocError].err{adjusted.err};
    }
    val value: u64 = adjusted.ok;
    if (value < s.image_base || value - s.image_base > 0xFFFFFFFF) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    bin.write_u32_le(s.dst, s.patch_off::usize, (value - s.image_base)::u32);
    ret res[bool, of_reloc.RelocError].ok{true};
}

# the 32-bit offset from the target's own section
fun secrel32(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 4 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val adjusted: res[u64, of_reloc.RelocError] = of_reloc.add_signed_to_u64(s.target.vaddr, s.addend);
    if (sel adjusted.err) {
        ret res[bool, of_reloc.RelocError].err{adjusted.err};
    }
    val value: u64 = adjusted.ok;
    if (value < s.target.section_vaddr || value - s.target.section_vaddr > 0xFFFFFFFF) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    bin.write_u32_le(s.dst, s.patch_off::usize, (value - s.target.section_vaddr)::u32);
    ret res[bool, of_reloc.RelocError].ok{true};
}

# the 16-bit index of the target's section
fun section_index(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 2 > s.sec_len::u64
        || s.target.section_index == 0 || s.target.section_index > 0xFFFF) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    bin.write_u16_le(s.dst, s.patch_off::usize, s.target.section_index::u16);
    ret res[bool, of_reloc.RelocError].ok{true};
}

# the sign-extended 32-bit absolute address
fun abs32s(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 4 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val adjusted: res[i64, of_reloc.RelocError] = of_reloc.add_u64_to_i64(s.target.vaddr, s.addend);
    if (sel adjusted.err) {
        ret res[bool, of_reloc.RelocError].err{adjusted.err};
    }
    val v: i64 = adjusted.ok;
    if (v > 2147483647 || v < -2147483648) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    bin.write_u32_le(s.dst, s.patch_off::usize, ((v::u64) & 0xFFFFFFFF)::u32);
    ret res[bool, of_reloc.RelocError].ok{true};
}
