# the inline assembly grammar: x64 statements parsed, checked and encoded
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.char.char_is_digit;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use lang_mir:   mach.lang.mir;
use isa_asm:    mach.lang.target.isa.asm;
use isa_encode: mach.lang.target.isa.encode;
use isa_inst:   mach.lang.target.isa.inst;
use mach.lang.target.isa.x64;
use x64_effects:  mach.lang.target.isa.x64.effects;
use x64_emit:     mach.lang.target.isa.x64.emit;
use x64_inst:     mach.lang.target.isa.x64.inst;
use x64_mnemonic: mach.lang.target.isa.x64.mnemonic;
use x64_printer:  mach.lang.target.isa.x64.printer;
use target_model: mach.lang.target.model;
use target_of:    mach.lang.target.of;

# a repeat prefix and the string row it leads, which also reads and writes
# rcx, its count
fun decode(body: str, lo: usize, hi: usize, m: *isa_asm.Mnemonic, mlen: *usize) bool {
    var p: usize = 0;
    for (p < x64_mnemonic.PREFIX_COUNT) {
        val pre:  *x64_mnemonic.Prefix = ?x64_mnemonic.PREFIXES[p];
        val plen: usize                = str_len(pre.name);
        p = p + 1;
        if (lo + plen >= hi || !str_region_equals(body, lo, plen, pre.name) || !isa_asm.is_space(body[lo + plen])) { cnt; }
        var a: usize = lo + plen;
        for (a < hi && isa_asm.is_space(body[a])) { a = a + 1; }
        var i: usize = 0;
        for (i < x64_mnemonic.ROW_COUNT) {
            val row: *isa_asm.Mnemonic = ?x64_mnemonic.ROWS[i];
            i = i + 1;
            if (x64_mnemonic.pattern(row.flags) != x64_mnemonic.PATTERN_STRING || !str_region_equals(body, a, hi - a, row.name)) { cnt; }
            @m         = @row;
            m.flags    = m.flags | pre.flags;
            m.implicit = m.implicit | x64_mnemonic.STRING_RCX;
            m.reads_gp = m.reads_gp | x64_mnemonic.STRING_RCX;
            @mlen      = hi - lo;
            ret true;
        }
    }
    ret false;
}

fun reg_region(body: str, lo: usize, hi: usize, op: *isa_asm.Operand) bool {
    var i: u32 = 0;
    for (i < x64.REG_NAME_COUNT) {
        val row: *x64.RegName = ?x64.REG_NAMES[i];
        if (str_region_equals(body, lo, hi - lo, row.name)) {
            @op = isa_asm.op_reg(row.id, row.width);
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun reg(name: str, op: *isa_asm.Operand) bool {
    ret reg_region(name, 0, str_len(name), op);
}

fun xmm_region(body: str, lo: usize, hi: usize, op: *isa_asm.Operand) bool {
    var i: i32 = 0;
    for (i < x64.FP_COUNT) {
        if (str_region_equals(body, lo, hi - lo, x64.fp_reg_name(i))) {
            @op = isa_asm.op_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, i), 16);
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun ctlreg(name: str, num: *i64) bool {
    if (str_equals(name, "cr0")) {
        @num = 0;
        ret true;
    }
    if (str_equals(name, "cr2")) {
        @num = 2;
        ret true;
    }
    if (str_equals(name, "cr3")) {
        @num = 3;
        ret true;
    }
    if (str_equals(name, "cr4")) {
        @num = 4;
        ret true;
    }
    if (str_equals(name, "cr8")) {
        @num = 8;
        ret true;
    }
    ret false;
}

fun segreg(name: str, num: *i64) bool {
    if (str_equals(name, "es")) {
        @num = 0;
        ret true;
    }
    if (str_equals(name, "cs")) {
        @num = 1;
        ret true;
    }
    if (str_equals(name, "ss")) {
        @num = 2;
        ret true;
    }
    if (str_equals(name, "ds")) {
        @num = 3;
        ret true;
    }
    if (str_equals(name, "fs")) {
        @num = 4;
        ret true;
    }
    if (str_equals(name, "gs")) {
        @num = 5;
        ret true;
    }
    ret false;
}

fun size_keyword(body: str, lo: usize, hi: usize, rest: *usize) u8 {
    var width: u8    = 0;
    var len:   usize = 0;
    if (lo + 4 < hi && str_region_equals(body, lo, 4, "byte")) {
        width = 1;
        len   = 4;
    }
    or (lo + 4 < hi && str_region_equals(body, lo, 4, "word")) {
        width = 2;
        len   = 4;
    }
    or (lo + 5 < hi && str_region_equals(body, lo, 5, "dword")) {
        width = 4;
        len   = 5;
    }
    or (lo + 5 < hi && str_region_equals(body, lo, 5, "qword")) {
        width = 8;
        len   = 5;
    }
    or (lo + 7 < hi && str_region_equals(body, lo, 7, "xmmword")) {
        width = 16;
        len   = 7;
    }
    or                                     { ret 0; }
    if (!isa_asm.is_space(body[lo + len])) { ret 0; }
    var i: usize = lo + len;
    for (i < hi && isa_asm.is_space(body[i])) { i = i + 1; }
    # GNU as spells the size `qword ptr`, and the listing writes it that way
    if (i + 3 < hi && str_region_equals(body, i, 3, "ptr")
        && (isa_asm.is_space(body[i + 3]) || body[i + 3] == '['::char)) {
        i = i + 3;
        for (i < hi && isa_asm.is_space(body[i])) { i = i + 1; }
    }
    @rest = i;
    ret width;
}

fun bracketed(c: *isa_asm.Cursor, lo: usize, hi: usize) bool {
    ret hi > lo && hi - lo >= 3 && c.body[lo] == '['::char && c.body[hi - 1] == ']'::char;
}

# a leading `fs:` or `gs:` segment override, stepping rest past it; seg stays
# SEG_NONE when the operand names none
fun segment(c: *isa_asm.Cursor, lo: usize, hi: usize, seg: *u8, rest: *usize) err[fail.Fail] {
    @seg  = x64_inst.SEG_NONE;
    @rest = lo;
    if (lo + 3 > hi || c.body[lo + 2] != ':'::char) { ret err[fail.Fail].ok{}; }
    var name: [3]u8;
    name[0] = c.body[lo]::u8;
    name[1] = c.body[lo + 1]::u8;
    name[2] = 0;
    var num: i64 = 0;
    if (!segreg((?name[0])::str, ?num)) { ret err[fail.Fail].ok{}; }

    var row: *x64_inst.SegmentRow = nil;
    var i:   usize                = 0;
    for (i < x64_inst.SEGMENT_COUNT) {
        if (str_region_equals(c.body, lo, 2, x64_inst.SEGMENTS[i].name)) { row = ?x64_inst.SEGMENTS[i]; }
        i = i + 1;
    }
    if (row == nil) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, isa_asm.span_message(c,
            "inline-asm segment override '", lo, lo + 3,
            "' relocates nothing in long mode; only `fs:` and `gs:` do"))};
    }
    var j: usize = lo + 3;
    for (j < hi && isa_asm.is_space(c.body[j])) { j = j + 1; }
    if (!bracketed(c, j, hi)) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, isa_asm.span_message(c,
            "inline-asm segment override on '", lo, hi,
            "' may only precede a bracketed memory operand"))};
    }
    @seg  = row.seg;
    @rest = j;
    ret err[fail.Fail].ok{};
}

# a bracketed memory operand after its segment override, which cannot name a
# symbol: the symbol form is rip-relative, and fs or gs would move it off the symbol
fun seg_mem(c: *isa_asm.Cursor, lo: usize, hi: usize, seg: u8, role: str, op: *isa_asm.Operand) err[fail.Fail] {
    val mr: err[fail.Fail] = mem_operand(c, lo, hi, role, op);
    if (sel mr.err) { ret mr; }
    op.seg = seg;
    if (seg != x64_inst.SEG_NONE && (op.flags & isa_asm.AOF_MEM_SYM) != 0) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, isa_asm.span_message(c,
            "inline-asm segment-relative operand '", lo, hi,
            "' names a symbol; a symbol operand is rip-relative, so address the segment by register or absolute offset"))};
    }
    ret err[fail.Fail].ok{};
}

fun operand(c: *isa_asm.Cursor, lo: usize, hi: usize, role: str, op: *isa_asm.Operand) err[fail.Fail] {
    @op = isa_asm.op_none();
    if (hi <= lo) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm operand")}; }

    var rest:  usize          = lo;
    val width: u8             = size_keyword(c.body, lo, hi, ?rest);
    var seg:   u8             = x64_inst.SEG_NONE;
    val sr:    err[fail.Fail] = segment(c, rest, hi, ?seg, ?rest);
    if (sel sr.err) { ret sr; }
    if (width != 0 || seg != x64_inst.SEG_NONE) {
        if (!bracketed(c, rest, hi)) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, isa_asm.span_message(c,
                "inline-asm operand-size prefix on '", lo, hi,
                "' may only precede a memory operand"))};
        }
        val mr: err[fail.Fail] = seg_mem(c, rest, hi, seg, role, op);
        if (sel mr.err) { ret mr; }
        op.size = width;
        ret err[fail.Fail].ok{};
    }

    if (c.body[lo] == '{'::char) {
        var off:     i64                  = 0;
        val bound_r: res[bool, fail.Fail] = isa_asm.bind_offset(c, lo, hi, ?off);
        if (sel bound_r.err) { ret err[fail.Fail].err{bound_r.err}; }
        if (bound_r.ok) {
            @op = isa_asm.op_mem(isa_encode.slot_base_reg(c.f, x64.RSP, x64.RBP), off, isa_inst.REG_NONE, 0, 0);
            ret err[fail.Fail].ok{};
        }
        op.kind     = isa_asm.AOP_BIND;
        op.name_off = lo + 1;
        op.name_len = hi - lo - 2;
        ret err[fail.Fail].ok{};
    }

    if (reg_region(c.body, lo, hi, op)) { ret err[fail.Fail].ok{}; }
    if (xmm_region(c.body, lo, hi, op)) { ret err[fail.Fail].ok{}; }

    if (hi - lo >= 3 && c.body[lo] == '['::char && c.body[hi - 1] == ']'::char) {
        ret mem_operand(c, lo, hi, role, op);
    }

    val iv: opt[i64] = isa_asm.region_i64(c.body, lo, hi);
    if (sel iv.some) {
        @op = isa_asm.op_imm(iv.some, 8);
        ret err[fail.Fail].ok{};
    }

    if (isa_asm.is_sym_region(c.body, lo, hi)) {
        @op = isa_asm.op_sym(lo, hi - lo, isa_inst.SYM_MOD_NONE, 8);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm operand")};
}

fun mem_operand(c: *isa_asm.Cursor, lo: usize, hi: usize, role: str, op: *isa_asm.Operand) err[fail.Fail] {
    @op     = isa_asm.op_none();
    op.kind = isa_asm.AOP_MEM;

    val inner_lo: usize = lo + 1;
    val inner_hi: usize = hi - 1;

    var q: usize = inner_lo;
    for (q < inner_hi) {
        if (c.body[q] == '{'::char) { ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_LOCAL, bind_base_message(c, role))}; }
        q = q + 1;
    }

    var star:     usize = 0;
    var has_star: bool  = false;
    var s:        usize = inner_lo;
    for (s < inner_hi) {
        if (c.body[s] == '*'::char) {
            star     = s;
            has_star = true;
        }
        s = s + 1;
    }

    var sep:         usize = inner_hi;
    var has_sep:     bool  = false;
    var neg:         bool  = false;
    var search_from: usize = inner_lo + 1;
    if (has_star) { search_from = star + 1; }
    var r: usize = inner_hi;
    for (r > search_from && !has_sep) {
        r = r - 1;
        if (c.body[r] == '+'::char) {
            sep     = r;
            has_sep = true;
            neg     = false;
        }
        or (c.body[r] == '-'::char) {
            sep     = r;
            has_sep = true;
            neg     = true;
        }
    }

    var bi_hi: usize = inner_hi;
    if (has_sep) { bi_hi = sep; }

    var buf: [32]u8;
    if (has_star) {
        var bplus:       usize = star;
        var found_bplus: bool  = false;
        var k:           usize = star;
        for (k > inner_lo && !found_bplus) {
            k = k - 1;
            if (c.body[k] == '+'::char) {
                bplus       = k;
                found_bplus = true;
            }
        }
        if (!found_bplus) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }

        if (!isa_asm.copy_region(c.body, inner_lo, bplus, ?buf[0], 32)) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
        var base_op: isa_asm.Operand = isa_asm.op_none();
        if (!reg((?buf[0])::str, ?base_op)) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
        op.reg = base_op.reg;

        if (!isa_asm.copy_region(c.body, bplus + 1, star, ?buf[0], 32)) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
        var idx_op: isa_asm.Operand = isa_asm.op_none();
        if (!reg((?buf[0])::str, ?idx_op)) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
        if (idx_op.reg == x64.RSP) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "rsp cannot be used as an inline-asm memory index register")};
        }
        op.index = idx_op.reg;

        val sv: opt[i64] = isa_asm.region_i64(c.body, star + 1, bi_hi);
        if (!sel sv.some) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
        val scale_val: i64 = sv.some;
        if (scale_val != 1 && scale_val != 2 && scale_val != 4 && scale_val != 8) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm memory index scale must be 1, 2, 4 or 8")};
        }
        op.scale = scale_val::u8;
    }
    or {
        var a: usize = inner_lo;
        var b: usize = bi_hi;
        for (a < b && isa_asm.is_space(c.body[a])) { a = a + 1; }
        for (b > a && isa_asm.is_space(c.body[b - 1])) { b = b - 1; }

        var base_op: isa_asm.Operand = isa_asm.op_none();
        if (reg_region(c.body, a, b, ?base_op)) {
            op.reg = base_op.reg;
        }
        or {
            val av: opt[i64] = isa_asm.region_i64(c.body, a, b);
            if (sel av.some) {
                if (has_sep) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm absolute memory address takes no displacement term")}; }
                val addr: i64 = av.some;
                if (addr < -2147483648 || addr > 2147483647) {
                    ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm absolute memory address does not fit a signed 32-bit displacement")};
                }
                op.flags = isa_asm.AOF_MEM_ABS;
                op.reg   = isa_inst.REG_NONE;
                op.imm   = addr;
                ret err[fail.Fail].ok{};
            }

            var vreg: isa_asm.Operand = isa_asm.op_none();
            if (xmm_region(c.body, a, b, ?vreg)) {
                ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm memory operand names a vector register, which cannot address memory")};
            }
            if (has_sep)                              { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
            if (!isa_asm.is_sym_region(c.body, a, b)) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
            op.flags    = isa_asm.AOF_MEM_SYM;
            op.reg      = isa_inst.REG_NONE;
            op.name_off = a;
            op.name_len = b - a;
        }
    }

    if (has_sep) {
        val dv: opt[i64] = isa_asm.region_i64(c.body, sep + 1, inner_hi);
        if (!sel dv.some) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "malformed inline-asm memory operand")}; }
        var disp: i64 = dv.some;
        if (neg) { disp = -disp; }
        if (disp < -2147483648 || disp > 2147483647) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_IMMEDIATE_RANGE, "inline-asm memory displacement does not fit a signed 32-bit displacement")};
        }
        op.imm   = disp;
        op.flags = op.flags | isa_asm.AOF_HAS_DISP;
    }
    ret err[fail.Fail].ok{};
}

fun bind_base_message(c: *isa_asm.Cursor, role: str) res[str, fail.Fail] {
    ret isa_asm.named_message(c.alloc, c.interner,
        "inline-asm ", role,
        "operand uses a stack-slot binding inside a memory operand ([{name}]); load it into a register first");
}

fun parse(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val pat: u16 = x64_mnemonic.pattern(s.m.flags);
    val n:   u32 = s.nargs;

    if (pat == x64_mnemonic.PATTERN_NONE) {
        if (n != 0) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm instruction takes no operands")}; }
        ret err[fail.Fail].ok{};
    }
    if (pat == x64_mnemonic.PATTERN_STRING) { ret check_rep(c, s); }
    if (pat == x64_mnemonic.PATTERN_BRANCH) {
        if (n != 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm branch expects one target")}; }
        ret branch_target(c, s, item);
    }
    if (pat == x64_mnemonic.PATTERN_XFER) {
        if (n != 1) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm '", "' expects one target"))};
        }
        ret xfer_target(c, s, item);
    }
    if (pat == x64_mnemonic.PATTERN_VEC || pat == x64_mnemonic.PATTERN_VECI) { ret parse_vec(c, s, item); }
    if (pat == x64_mnemonic.PATTERN_VECG)                                    { ret parse_vec_gp(c, s, item); }
    if (pat == x64_mnemonic.PATTERN_VEC3)                                    { ret parse_vec3(c, s, item); }
    if (pat == x64_mnemonic.PATTERN_MOVQ)                                    { ret parse_movq(c, s, item); }
    if (pat == x64_mnemonic.PATTERN_VSHIFT)                                  { ret parse_vshift(c, s, item); }
    if (pat == x64_mnemonic.PATTERN_WIDEREG)                                 { ret parse_widereg(c, s, item); }

    if (s.m.code == x64.MOV::u32 && n == 2) {
        val matched_r: res[bool, fail.Fail] = mov_sysreg(c, s, item);
        if (sel matched_r.err) { ret err[fail.Fail].err{matched_r.err}; }
        if (matched_r.ok)      { ret err[fail.Fail].ok{}; }
    }

    var i: u32 = 0;
    for (i < n) {
        var role: str = "";
        if (pat == x64_mnemonic.PATTERN_TWO && i == 0) { role = "destination "; }
        or (pat == x64_mnemonic.PATTERN_TWO)           { role = "source "; }
        val r: err[fail.Fail] = operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], role, ?item.ops[i::usize]);
        if (sel r.err) { ret r; }
        if (isa_asm.is_vreg(?item.ops[i::usize])) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
                "' takes general-purpose registers, not a vector register"))};
        }
        if (item.ops[i::usize].seg != x64_inst.SEG_NONE && (x64_inst.describe(s.m.code::u16).mem & x64_inst.MEM_ADDR) != 0) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
                "' takes an address it never accesses, so a segment override relocates nothing"))};
        }
        if (item.ops[i::usize].kind == isa_asm.AOP_MEM && item.ops[i::usize].size == 16) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
                "' names an xmmword operand, which only a vector instruction takes"))};
        }
        i = i + 1;
    }

    if (pat == x64_mnemonic.PATTERN_ONE) {
        if (n != 1) { ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm instruction expects one operand")}; }
        val op: *isa_asm.Operand = ?item.ops[0];
        if (op.kind == isa_asm.AOP_SYM || (op.kind == isa_asm.AOP_MEM && (op.flags & isa_asm.AOF_MEM_SYM) != 0)) {
            ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm one-operand symbol form unsupported")};
        }
        ret check_widths(c, s, item);
    }

    if (pat == x64_mnemonic.PATTERN_TRIPLE) { ret check_triple(c, s, item); }

    if (n != 2) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_SYNTAX, isa_asm.span_message(c,
            "malformed inline-asm two-operand instruction '", s.lo, s.hi, "'"))};
    }
    if (item.ops[0].kind == isa_asm.AOP_SYM || item.ops[1].kind == isa_asm.AOP_SYM) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm bare-symbol operand unsupported (use [symbol])")};
    }
    if (x64_inst.describe(s.m.code::u16).form == x64_inst.FORM_BITSCAN) {
        val dst: *isa_asm.Operand = ?item.ops[0];
        val src: *isa_asm.Operand = ?item.ops[1];
        if (dst.kind != isa_asm.AOP_REG || dst.size == 1 || src.kind == isa_asm.AOP_IMM || (src.kind == isa_asm.AOP_REG && src.size == 1)) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
                "' takes a 16-, 32- or 64-bit register destination and a register or memory source of the same width"))};
        }
    }
    if ((item.ops[0].flags & isa_asm.AOF_MEM_SYM) != 0) {
        item.ref     = isa_asm.AR_SYM;
        item.ref_off = item.ops[0].name_off;
        item.ref_len = item.ops[0].name_len;
    }
    or ((item.ops[1].flags & isa_asm.AOF_MEM_SYM) != 0) {
        item.ref     = isa_asm.AR_SYM;
        item.ref_off = item.ops[1].name_off;
        item.ref_len = item.ops[1].name_len;
    }
    ret check_widths(c, s, item);
}

# a compare repeats under a condition, and a move, store or load under plain rep
fun check_rep(c: *isa_asm.Cursor, s: *isa_asm.Stmt) err[fail.Fail] {
    if ((s.m.flags & (x64_mnemonic.FLAG_REP | x64_mnemonic.FLAG_REPNE)) == 0) { ret err[fail.Fail].ok{}; }
    val compares: bool = x64_inst.describe(s.m.code::u16).cls.writes_flags;
    val cond:     bool = (s.m.flags & x64_mnemonic.FLAG_REPCND) != 0;
    if (compares && !cond) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, isa_asm.span_message(c, "inline-asm '", s.lo, s.hi,
            "' repeats a compare with rep; spell the condition it stops on, repe or repne"))};
    }
    if (!compares && cond) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, isa_asm.span_message(c, "inline-asm '", s.lo, s.hi,
            "' conditions a string instruction that compares nothing; repeat it with rep"))};
    }
    ret err[fail.Fail].ok{};
}

# a memory operand naming a symbol becomes the item's reference, as on the two-operand forms
fun note_sym_ref(item: *isa_asm.Item, n: u32) {
    var i: u32 = 0;
    for (i < n) {
        if ((item.ops[i::usize].flags & isa_asm.AOF_MEM_SYM) != 0 && item.ref != isa_asm.AR_SYM) {
            item.ref     = isa_asm.AR_SYM;
            item.ref_off = item.ops[i::usize].name_off;
            item.ref_len = item.ops[i::usize].name_len;
        }
        i = i + 1;
    }
}

fun is_cl(op: *isa_asm.Operand) bool {
    ret op.kind == isa_asm.AOP_REG && !isa_asm.is_vreg(op) && op.reg == x64.RCX && op.size == 1;
}

# imul: a register from an r/m, with an optional immediate multiplier; shld
# and shrd: an r/m, the register feeding bits, and a count of imm8 or cl
fun check_triple(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val n:       u32  = s.nargs;
    val is_imul: bool = s.m.code == x64.IMUL::u32;
    var ok:      bool = n == 3 || (is_imul && n == 2);
    if (ok) {
        val dst: *isa_asm.Operand = ?item.ops[0];
        val src: *isa_asm.Operand = ?item.ops[1];
        if (dst.kind != isa_asm.AOP_REG && (is_imul || dst.kind != isa_asm.AOP_MEM))            { ok = false; }
        if (src.kind != isa_asm.AOP_REG && (!is_imul || src.kind != isa_asm.AOP_MEM))           { ok = false; }
        if (dst.kind == isa_asm.AOP_REG && dst.size == 1)                                       { ok = false; }
        if (src.kind == isa_asm.AOP_REG && src.size == 1)                                       { ok = false; }
        if (dst.kind == isa_asm.AOP_REG && src.kind == isa_asm.AOP_REG && dst.size != src.size) { ok = false; }
        if (n == 3) {
            val cnt: *isa_asm.Operand = ?item.ops[2];
            if (cnt.kind == isa_asm.AOP_IMM) {
                if (!is_imul && (cnt.imm < 0 || cnt.imm > 255)) { ok = false; }
            }
            or (is_imul || !is_cl(cnt)) { ok = false; }
        }
    }
    if (!ok) {
        if (is_imul) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
                "' takes a 16-, 32- or 64-bit register and a source of the same width, with an optional immediate multiplier"))};
        }
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
            "' takes a 16-, 32- or 64-bit register or memory, a register of the same width feeding bits, and a count of 0 to 255 or `cl`"))};
    }
    note_sym_ref(item, n);
    ret check_widths(c, s, item);
}

fun parse_widereg(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    if (s.nargs == 1) {
        val r: err[fail.Fail] = operand(c, s.arg_lo[0], s.arg_hi[0], "", ?item.ops[0]);
        if (sel r.err) { ret r; }
        val op: *isa_asm.Operand = ?item.ops[0];
        if (op.kind == isa_asm.AOP_REG && !isa_asm.is_vreg(op) && (op.size == 4 || op.size == 8)) { ret err[fail.Fail].ok{}; }
    }
    ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
        "' takes one 32- or 64-bit general-purpose register"))};
}

# the operand positions of pinsrd (vector first) and pextrd (vector second)
fun lane_positions(code: u32, v: *usize, g: *usize) {
    @v = 0;
    @g = 1;
    if (code == x64.PEXTRD::u32) {
        @v = 1;
        @g = 0;
    }
}

fun lane_refused(c: *isa_asm.Cursor, s: *isa_asm.Stmt) err[fail.Fail] {
    ret vec_refused(c, s, "' takes a vector register, a 32-bit register or memory, and an immediate from 0 to 255");
}

# pinsrd xmm, r/m32, imm8 and pextrd r/m32, xmm, imm8
fun parse_vec_gp(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    if (s.nargs != 3) { ret lane_refused(c, s); }
    var i: u32 = 0;
    for (i < 3) {
        var role: str = "source ";
        if (i == 0) { role = "destination "; }
        val r: err[fail.Fail] = operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], role, ?item.ops[i::usize]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    var vi: usize = 0;
    var gi: usize = 0;
    lane_positions(s.m.code, ?vi, ?gi);
    val v:      *isa_asm.Operand = ?item.ops[vi];
    val g:      *isa_asm.Operand = ?item.ops[gi];
    val imm:    *isa_asm.Operand = ?item.ops[2];
    val gp_reg: bool             = g.kind == isa_asm.AOP_REG && !isa_asm.is_vreg(g) && g.size == 4;
    val gp_mem: bool             = vec_mem(g) && (g.kind != isa_asm.AOP_MEM || g.size == 0 || g.size == 4);
    if (!isa_asm.is_vreg(v) || !(gp_reg || gp_mem))                  { ret lane_refused(c, s); }
    if (imm.kind != isa_asm.AOP_IMM || imm.imm < 0 || imm.imm > 255) { ret lane_refused(c, s); }
    if (g.kind == isa_asm.AOP_MEM && (g.flags & isa_asm.AOF_MEM_SYM) != 0) {
        item.ref     = isa_asm.AR_SYM;
        item.ref_off = g.name_off;
        item.ref_len = g.name_len;
    }
    ret err[fail.Fail].ok{};
}

fun emit_vec_gp(st: *isa_encode.EncodeState, item: *isa_asm.Item, sym: intern.StrId) err[fail.Fail] {
    var vi: usize = 0;
    var gi: usize = 0;
    lane_positions(item.code, ?vi, ?gi);
    val op:     u16              = item.code::u16;
    val v:      isa_inst.Operand = vec_operand(?item.ops[vi], sym);
    val g:      isa_inst.Operand = to_isa(?item.ops[gi], 4, sym);
    val imm:    u8               = item.ops[2].imm::u8;
    var prefix: u8               = 0;
    var map:    u8               = 0;
    var byte:   u8               = 0;
    if (!x64_emit.mapped_opbytes(op, ?prefix, ?map, ?byte)) { ret err[fail.Fail].err{fail.message(x64_emit.PACKED_OPCODE_UNKNOWN)}; }
    val start: usize = st.buf.bytes.len;
    x64_emit.sse_map_rm(prefix, map, byte, v.reg, g, ?st.buf);
    isa_encode.emit_byte(?st.buf, imm);
    if (vi == 0)                    { x64_emit.note_packed_imm(?st.buf, start, op, v, g, imm); }
    or                              { x64_emit.note_packed_imm(?st.buf, start, op, g, v, imm); }
    if (item.ref != isa_asm.AR_SYM) { ret err[fail.Fail].ok{}; }
    val n: i32 = (st.buf.bytes.len - start)::i32;
    ret push_pc32(st, sym, start, n - 5, n);
}

fun vec3_refused(c: *isa_asm.Cursor, s: *isa_asm.Stmt) err[fail.Fail] {
    ret vec_refused(c, s, "' takes a vector register destination, a vector register source and a vector register or 128-bit memory source");
}

# the vex or evex three-operand form: xmm, xmm, xmm/m128
fun parse_vec3(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    if (s.nargs != 3) { ret vec3_refused(c, s); }
    var i: u32 = 0;
    for (i < 3) {
        var role: str = "source ";
        if (i == 0) { role = "destination "; }
        val r: err[fail.Fail] = operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], role, ?item.ops[i::usize]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    val src2: *isa_asm.Operand = ?item.ops[2];
    if (!isa_asm.is_vreg(?item.ops[0]) || !isa_asm.is_vreg(?item.ops[1]))  { ret vec3_refused(c, s); }
    if (!isa_asm.is_vreg(src2) && !vec_mem(src2))                          { ret vec3_refused(c, s); }
    if (src2.kind == isa_asm.AOP_MEM && src2.size != 0 && src2.size != 16) { ret vec3_refused(c, s); }
    if ((src2.flags & isa_asm.AOF_MEM_SYM) != 0) {
        item.ref     = isa_asm.AR_SYM;
        item.ref_off = src2.name_off;
        item.ref_len = src2.name_len;
    }
    ret err[fail.Fail].ok{};
}

fun emit_vec3(st: *isa_encode.EncodeState, item: *isa_asm.Item, sym: intern.StrId) err[fail.Fail] {
    val dst:   isa_inst.Operand = vec_operand(?item.ops[0], sym);
    val src1:  isa_inst.Operand = vec_operand(?item.ops[1], sym);
    val src2:  isa_inst.Operand = vec_operand(?item.ops[2], sym);
    val start: usize            = st.buf.bytes.len;
    val r:     err[fail.Fail]   = x64_emit.vec3(item.code::u16, x64_emit.VB_XMM, dst.reg, src1.reg, src2, ?st.buf);
    if (sel r.err)                  { ret r; }
    if (item.ref != isa_asm.AR_SYM) { ret err[fail.Fail].ok{}; }
    val n: i32 = (st.buf.bytes.len - start)::i32;
    ret push_pc32(st, sym, start, n - 4, n);
}

fun movq_refused(c: *isa_asm.Cursor, s: *isa_asm.Stmt) err[fail.Fail] {
    ret vec_refused(c, s, "' moves between a vector register and a 64-bit general register, such as movq xmm0, rax");
}

# movq xmm, r64 zeroes the upper quadword; movq r64, xmm reads the lower one
fun parse_movq(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    if (s.nargs != 2) { ret movq_refused(c, s); }
    var i: u32 = 0;
    for (i < 2) {
        var role: str = "source ";
        if (i == 0) { role = "destination "; }
        val r: err[fail.Fail] = operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], role, ?item.ops[i::usize]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    val a:    *isa_asm.Operand = ?item.ops[0];
    val b:    *isa_asm.Operand = ?item.ops[1];
    val a_gp: bool             = a.kind == isa_asm.AOP_REG && !isa_asm.is_vreg(a) && a.size == 8;
    val b_gp: bool             = b.kind == isa_asm.AOP_REG && !isa_asm.is_vreg(b) && b.size == 8;
    if ((isa_asm.is_vreg(a) && b_gp) || (a_gp && isa_asm.is_vreg(b))) { ret err[fail.Fail].ok{}; }
    ret movq_refused(c, s);
}

fun emit_movq(st: *isa_encode.EncodeState, item: *isa_asm.Item) err[fail.Fail] {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = x64.MOVQ;
    mi.size   = 8;
    mi.flags  = x64_inst.FLAG_REX_W::u16;
    mi.dst    = movq_operand(?item.ops[0]);
    mi.src1   = movq_operand(?item.ops[1]);
    if (x64_emit.encode_inst(?mi, ?st.buf) <= 0) { ret err[fail.Fail].err{fail.message("encode: inline-asm movq encoded to no bytes")}; }
    ret err[fail.Fail].ok{};
}

fun movq_operand(op: *isa_asm.Operand) isa_inst.Operand {
    if (isa_asm.is_vreg(op)) { ret x64_emit.vec_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, op.reg), x64_emit.VB_XMM); }
    ret isa_inst.make_reg(op.reg, 8);
}

# whether a packed shift also takes its count from a vector register or memory
fun vshift_counts(code: u32) bool {
    val op: u16 = code::u16;
    ret op == x64.PSLLQ || op == x64.PSRLQ;
}

fun vshift_refused(c: *isa_asm.Cursor, s: *isa_asm.Stmt) err[fail.Fail] {
    if (vshift_counts(s.m.code)) {
        ret vec_refused(c, s, "' shifts a vector register by an immediate from 0 to 255, or by the low quadword of a vector register or 128-bit memory");
    }
    ret vec_refused(c, s, "' shifts a vector register by an immediate from 0 to 255");
}

fun parse_vshift(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    if (s.nargs != 2) { ret vshift_refused(c, s); }
    var i: u32 = 0;
    for (i < 2) {
        var role: str = "source ";
        if (i == 0) { role = "destination "; }
        val r: err[fail.Fail] = operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], role, ?item.ops[i::usize]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    val dst: *isa_asm.Operand = ?item.ops[0];
    val cnt: *isa_asm.Operand = ?item.ops[1];
    if (!isa_asm.is_vreg(dst)) { ret vshift_refused(c, s); }
    if (cnt.kind == isa_asm.AOP_IMM) {
        if (cnt.imm < 0 || cnt.imm > 255) { ret vshift_refused(c, s); }
        ret err[fail.Fail].ok{};
    }
    if (!vshift_counts(s.m.code) || !(isa_asm.is_vreg(cnt) || vec_mem(cnt))) { ret vshift_refused(c, s); }
    if (cnt.kind == isa_asm.AOP_MEM && cnt.size != 0 && cnt.size != 16)      { ret vshift_refused(c, s); }
    if ((cnt.flags & isa_asm.AOF_MEM_SYM) != 0) {
        item.ref     = isa_asm.AR_SYM;
        item.ref_off = cnt.name_off;
        item.ref_len = cnt.name_len;
    }
    ret err[fail.Fail].ok{};
}

fun emit_vshift(st: *isa_encode.EncodeState, item: *isa_asm.Item, sym: intern.StrId) err[fail.Fail] {
    val op:  u16              = item.code::u16;
    val dst: isa_inst.Operand = vec_operand(?item.ops[0], sym);
    val cnt: *isa_asm.Operand = ?item.ops[1];
    if (cnt.kind == isa_asm.AOP_IMM) { ret x64_emit.packed_shift_imm(op, x64_emit.VB_XMM, dst.reg, cnt.imm::u8, ?st.buf); }
    val by:     isa_inst.Operand = vec_operand(cnt, sym);
    val opbyte: opt[u8]          = x64_emit.packed_shift_count_opbyte(op);
    if (sel opbyte.none) { ret err[fail.Fail].err{fail.message(x64_emit.PACKED_OPCODE_UNKNOWN)}; }
    val start: usize = st.buf.bytes.len;
    x64_emit.sse_rm(0x66, opbyte.some, dst.reg, by, ?st.buf);
    x64_emit.note_packed(?st.buf, start, op, dst, by);
    if (item.ref != isa_asm.AR_SYM) { ret err[fail.Fail].ok{}; }
    val n: i32 = (st.buf.bytes.len - start)::i32;
    ret push_pc32(st, sym, start, n - 4, n);
}

fun vec_mem(op: *isa_asm.Operand) bool {
    ret op.kind == isa_asm.AOP_MEM || op.kind == isa_asm.AOP_BIND;
}

fun vec_refused(c: *isa_asm.Cursor, s: *isa_asm.Stmt, suffix: str) err[fail.Fail] {
    ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '", suffix))};
}

# a vector register (or, for a storing move, memory) written from a vector register or memory
fun parse_vec(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val with_imm: bool = x64_mnemonic.pattern(s.m.flags) == x64_mnemonic.PATTERN_VECI;
    val store:    bool = (s.m.flags & x64_mnemonic.FLAG_VSTORE) != 0;
    var want:     u32  = 2;
    if (with_imm) { want = 3; }
    if (s.nargs != want) {
        if (with_imm) {
            ret vec_refused(c, s, "' expects a vector register, a vector register or memory source, and an 8-bit immediate");
        }
        ret vec_refused(c, s, "' expects two operands");
    }

    var i: u32 = 0;
    for (i < want) {
        var role: str = "source ";
        if (i == 0) { role = "destination "; }
        val r: err[fail.Fail] = operand(c, s.arg_lo[i::usize], s.arg_hi[i::usize], role, ?item.ops[i::usize]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }

    val dst: *isa_asm.Operand = ?item.ops[0];
    val src: *isa_asm.Operand = ?item.ops[1];
    if (!isa_asm.is_vreg(dst) && !(store && vec_mem(dst))) {
        if (store) {
            ret vec_refused(c, s, "' writes a vector register or memory destination");
        }
        ret vec_refused(c, s, "' writes a vector register destination");
    }
    if (!isa_asm.is_vreg(src) && !vec_mem(src)) {
        ret vec_refused(c, s, "' takes a vector register or memory source");
    }
    if (vec_mem(dst) && !isa_asm.is_vreg(src)) {
        ret vec_refused(c, s, "' stores into memory only from a vector register");
    }
    if ((dst.kind == isa_asm.AOP_MEM && dst.size != 0 && dst.size != 16) || (src.kind == isa_asm.AOP_MEM && src.size != 0 && src.size != 16)) {
        ret vec_refused(c, s, "' takes a whole 128-bit memory operand, written bare or as `xmmword [...]`");
    }
    if (with_imm) {
        val imm: *isa_asm.Operand = ?item.ops[2];
        if (imm.kind != isa_asm.AOP_IMM || imm.imm < 0 || imm.imm > 255) {
            ret vec_refused(c, s, "' takes an immediate from 0 to 255 as its third operand");
        }
    }

    if ((dst.flags & isa_asm.AOF_MEM_SYM) != 0) {
        item.ref     = isa_asm.AR_SYM;
        item.ref_off = dst.name_off;
        item.ref_len = dst.name_len;
    }
    or ((src.flags & isa_asm.AOF_MEM_SYM) != 0) {
        item.ref     = isa_asm.AR_SYM;
        item.ref_off = src.name_off;
        item.ref_len = src.name_len;
    }
    ret err[fail.Fail].ok{};
}

fun check_widths(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val cls: u16 = x64_mnemonic.width_class(s.m.flags);

    if (cls == x64_mnemonic.WIDTH_UNSIZED) {
        if (sized_operand(item) != 0) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
                "' takes no operand-size prefix: its memory operand names no scalar width"))};
        }
        ret err[fail.Fail].ok{};
    }

    if (cls == x64_mnemonic.WIDTH_FIXED64) {
        val w: u8 = sized_operand(item);
        if (w != 0 && w != 8) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
                "' has a fixed 64-bit operand size in long mode, so a narrower operand-size prefix names no instruction"))};
        }
        ret err[fail.Fail].ok{};
    }

    if (cls == x64_mnemonic.WIDTH_NARROW) { ret check_narrow(c, s, item); }

    val rw: u8 = register_width(item);
    if (rw == 0) { ret err[fail.Fail].ok{}; }
    val form:  x64_inst.Form = x64_inst.describe(s.m.code::u16).form;
    var count: u32           = item.nops;
    if (form == x64_inst.FORM_SHIFT)  { count = 1; }
    if (form == x64_inst.FORM_DSHIFT) { count = 2; }
    var i: u32 = 0;
    for (i < item.nops) {
        val op: *isa_asm.Operand = ?item.ops[i::usize];
        val w:  u8               = op.size;
        if (op.kind == isa_asm.AOP_MEM && w != 0 && w != rw) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
                "' names an operand-size prefix that contradicts the width its register operand states"))};
        }
        # a uniform row takes one width across its general-purpose registers; the count of a shift is the exception
        if (op.kind == isa_asm.AOP_REG && !isa_asm.is_vreg(op) && w != rw && i != count) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
                "' names register operands of two widths, which no form of it takes"))};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_narrow(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val dst: *isa_asm.Operand = ?item.ops[0];
    val src: *isa_asm.Operand = ?item.ops[1];
    if (dst.kind != isa_asm.AOP_REG) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
            "' must extend into a register destination"))};
    }
    if (src.kind == isa_asm.AOP_MEM && src.size == 0) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
            "' does not state the width of its memory source; write it as `byte [...]`, `word [...]` or `dword [...]`"))};
    }
    val sw: u8 = src.size;
    if (sw == 0) { ret err[fail.Fail].ok{}; }
    if (sw >= dst.size) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
            "' names a source at least as wide as its destination, which extends nothing"))};
    }
    if (s.m.code == x64.MOVZX::u32 && sw != 1 && sw != 2) {
        ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm instruction '",
            "' has no 32-bit source form; a 32-bit move already zero-extends, so write `mov` instead"))};
    }
    ret err[fail.Fail].ok{};
}

fun sized_operand(item: *isa_asm.Item) u8 {
    var i: u32 = 0;
    for (i < item.nops) {
        val op: *isa_asm.Operand = ?item.ops[i::usize];
        if (op.kind == isa_asm.AOP_MEM && op.size != 0) { ret op.size; }
        i = i + 1;
    }
    ret 0;
}

fun register_width(item: *isa_asm.Item) u8 {
    var i: u32 = 0;
    for (i < item.nops) {
        if (item.ops[i::usize].kind == isa_asm.AOP_REG) { ret item.ops[i::usize].size; }
        i = i + 1;
    }
    ret 0;
}

fun named_message(c: *isa_asm.Cursor, s: *isa_asm.Stmt, prefix: str, suffix: str) res[str, fail.Fail] {
    ret isa_asm.named_message(c.alloc, c.interner, prefix, s.m.name, suffix);
}

fun mov_sysreg(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) res[bool, fail.Fail] {
    var dbuf: [32]u8;
    var sbuf: [32]u8;
    if (!isa_asm.copy_region(c.body, s.arg_lo[0], s.arg_hi[0], ?dbuf[0], 32)) { ret res[bool, fail.Fail].ok{false}; }
    if (!isa_asm.copy_region(c.body, s.arg_lo[1], s.arg_hi[1], ?sbuf[0], 32)) { ret res[bool, fail.Fail].ok{false}; }
    val dtok: str = (?dbuf[0])::str;
    val stok: str = (?sbuf[0])::str;

    var dnum:    i64  = 0;
    var snum:    i64  = 0;
    val dst_cr:  bool = ctlreg(dtok, ?dnum);
    val src_cr:  bool = ctlreg(stok, ?snum);
    val dst_seg: bool = segreg(dtok, ?dnum);
    val src_seg: bool = segreg(stok, ?snum);
    if (!dst_cr && !src_cr && !dst_seg && !src_seg) { ret res[bool, fail.Fail].ok{false}; }
    if ((dst_cr || dst_seg) && (src_cr || src_seg)) {
        ret res[bool, fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm `mov` cannot move between two system registers; go through a general-purpose register")};
    }

    if (dst_seg) {
        ret res[bool, fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_UNSUPPORTED, "inline-asm `mov` into a segment register is unsupported; only reading one (`mov eax, cs`) is")};
    }

    var gp:     isa_asm.Operand = isa_asm.op_none();
    var gp_lo:  usize           = s.arg_lo[0];
    var gp_hi:  usize           = s.arg_hi[0];
    var gp_tok: str             = dtok;
    if (dst_cr) {
        gp_lo  = s.arg_lo[1];
        gp_hi  = s.arg_hi[1];
        gp_tok = stok;
    }
    if (!reg(gp_tok, ?gp)) {
        ret res[bool, fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, isa_asm.span_message(c,
            "inline-asm system-register move names '", gp_lo, gp_hi,
            "' where a general-purpose register is required"))};
    }

    if (src_cr || dst_cr) {
        if (gp.size != 8) {
            ret res[bool, fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm control-register move requires a 64-bit general-purpose register")};
        }
        item.code = x64.MOV_CR::u32;
    }
    or { item.code = x64.MOV_SEG::u32; }

    if (dst_cr) {
        item.ops[0] = isa_asm.op_imm(dnum, 8);
        item.ops[1] = gp;
    }
    or {
        item.ops[0] = gp;
        item.ops[1] = isa_asm.op_imm(snum, 8);
    }
    ret res[bool, fail.Fail].ok{true};
}

fun xfer_target(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val lo: usize = s.arg_lo[0];
    val hi: usize = s.arg_hi[0];

    var seg: u8             = x64_inst.SEG_NONE;
    var at:  usize          = lo;
    val sr:  err[fail.Fail] = segment(c, lo, hi, ?seg, ?at);
    if (sel sr.err) { ret sr; }
    if (bracketed(c, at, hi)) {
        val r: err[fail.Fail] = seg_mem(c, at, hi, seg, "", ?item.ops[0]);
        if (sel r.err) { ret r; }
        if ((item.ops[0].flags & isa_asm.AOF_MEM_SYM) != 0) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_UNSUPPORTED, named_message(c, s, "inline-asm indirect '",
                "' through a symbol's address is unsupported; name the symbol directly for a direct transfer, or load the address into a register"))};
        }
        item.flags = item.flags | x64_mnemonic.FLAG_INDIRECT;
        ret err[fail.Fail].ok{};
    }

    var buf:    [32]u8;
    var reg_op: isa_asm.Operand = isa_asm.op_none();
    if (isa_asm.copy_region(c.body, lo, hi, ?buf[0], 32) && reg((?buf[0])::str, ?reg_op)) {
        if (reg_op.size != 8) {
            ret err[fail.Fail].err{isa_asm.reject_made(c, diagnostic_kind.ASM_OPERAND, named_message(c, s, "inline-asm indirect '",
                "' requires a 64-bit register"))};
        }
        item.ops[0] = reg_op;
        item.flags  = item.flags | x64_mnemonic.FLAG_INDIRECT;
        ret err[fail.Fail].ok{};
    }

    ret branch_target(c, s, item);
}

fun branch_target(c: *isa_asm.Cursor, s: *isa_asm.Stmt, item: *isa_asm.Item) err[fail.Fail] {
    val lo: usize                = s.arg_lo[0];
    val hi: usize                = s.arg_hi[0];
    val lr: res[bool, fail.Fail] = isa_asm.local_ref(c, lo, hi, item);
    if (sel lr.err) { ret err[fail.Fail].err{lr.err}; }
    if (lr.ok)      { ret err[fail.Fail].ok{}; }
    if (char_is_digit(c.body[lo])) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_SYNTAX, "inline-asm numeric local-label reference must be '<digits>f' or '<digits>b'")};
    }
    if (!isa_asm.is_sym_region(c.body, lo, hi)) {
        ret err[fail.Fail].err{isa_asm.reject(c, diagnostic_kind.ASM_OPERAND, "inline-asm branch target is not a symbol")};
    }
    item.ref     = isa_asm.AR_SYM;
    item.ref_off = lo;
    item.ref_len = hi - lo;
    ret err[fail.Fail].ok{};
}

fun to_isa(op: *isa_asm.Operand, size: u8, sym: intern.StrId) isa_inst.Operand {
    if (op.kind == isa_asm.AOP_REG) { ret isa_inst.make_reg(op.reg, size); }
    if (op.kind == isa_asm.AOP_IMM) { ret isa_inst.make_imm(op.imm, size); }
    if (op.kind == isa_asm.AOP_MEM) {
        if ((op.flags & isa_asm.AOF_MEM_SYM) != 0) {
            var m: isa_inst.Operand = isa_inst.make_mem(isa_inst.REG_NONE, 0, isa_inst.REG_NONE, 0, size);
            m.sym_id = sym::u32;
            ret m;
        }
        var m: isa_inst.Operand = isa_inst.make_mem(op.reg, op.imm::i32, op.index, op.scale, size);
        if ((op.flags & isa_asm.AOF_MEM_ABS) != 0) { m = isa_inst.make_mem(x64_inst.MEM_BASE_ABS, op.imm::i32, isa_inst.REG_NONE, 0, size); }
        m.seg = op.seg;
        ret m;
    }
    ret isa_inst.make_none();
}

fun build(item: *isa_asm.Item, sym: intern.StrId) isa_inst.Inst {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = item.code::u16;
    var enc_flags: u16 = 0;
    if ((item.flags & x64_mnemonic.FLAG_LOCK) != 0) { enc_flags = x64_inst.FLAG_LOCK::u16; }

    val pat: u16 = x64_mnemonic.pattern(item.flags);
    if (pat == x64_mnemonic.PATTERN_NONE) {
        mi.flags = enc_flags;
        ret mi;
    }
    if (pat == x64_mnemonic.PATTERN_BRANCH) {
        mi.flags = enc_flags;
        mi.dst   = direct_target(item, sym);
        ret mi;
    }
    if (pat == x64_mnemonic.PATTERN_STRING) {
        if ((item.flags & x64_mnemonic.FLAG_REP) != 0)   { enc_flags = enc_flags | x64_inst.FLAG_REP::u16; }
        if ((item.flags & x64_mnemonic.FLAG_REPNE) != 0) { enc_flags = enc_flags | x64_inst.FLAG_REPNE::u16; }
        mi.flags = enc_flags;
        mi.size  = x64_emit.string_row(mi.opcode).width;
        ret mi;
    }
    if (pat == x64_mnemonic.PATTERN_XFER) {
        if ((item.flags & x64_mnemonic.FLAG_INDIRECT) == 0) {
            mi.flags = enc_flags;
            mi.dst   = direct_target(item, sym);
            ret mi;
        }
        mi.size  = 8;
        mi.flags = enc_flags | x64_inst.FLAG_INDIRECT::u16;
        mi.dst   = to_isa(?item.ops[0], 8, sym);
        ret mi;
    }

    if (pat == x64_mnemonic.PATTERN_PORTIO) {
        mi.flags = enc_flags;
        mi.dst   = to_isa(?item.ops[0], item.ops[0].size, sym);
        mi.src1  = to_isa(?item.ops[1], item.ops[1].size, sym);
        ret mi;
    }

    if (item.code == x64.MOV_CR::u32) {
        mi.size  = 8;
        mi.flags = enc_flags;
        mi.dst   = to_isa(?item.ops[0], 8, sym);
        mi.src1  = to_isa(?item.ops[1], 8, sym);
        ret mi;
    }

    val size: u8 = encoded_size(item);
    mi.size  = size;
    mi.flags = width_flags_for(size) | enc_flags;
    mi.dst   = to_isa(?item.ops[0], operand_size(?item.ops[0], size), sym);
    if (pat == x64_mnemonic.PATTERN_TWO) { mi.src1 = to_isa(?item.ops[1], operand_size(?item.ops[1], size), sym); }
    if (pat == x64_mnemonic.PATTERN_TRIPLE) {
        mi.src1 = to_isa(?item.ops[1], operand_size(?item.ops[1], size), sym);
        if (item.nops == 3) {
            val cnt: *isa_asm.Operand = ?item.ops[2];
            if (cnt.kind == isa_asm.AOP_REG) { mi.src2 = isa_inst.make_reg(cnt.reg, cnt.size); }
            or                               { mi.src2 = isa_inst.make_imm(cnt.imm, size); }
        }
    }
    ret mi;
}

# a direct transfer's target: the symbol, or the numbered label with the
# direction it is looked up in, which the effects and the listing both read
fun direct_target(item: *isa_asm.Item, sym: intern.StrId) isa_inst.Operand {
    if (item.ref == isa_asm.AR_SYM)   { ret isa_inst.make_sym(sym::u32, 8); }
    if (item.ref == isa_asm.AR_LOCAL) { ret isa_inst.make_numbered_local_label(item.ref_fwd, item.ref_num); }
    ret isa_inst.make_none();
}

fun encoded_size(item: *isa_asm.Item) u8 {
    var i: u32 = 0;
    for (i < item.nops) {
        if (item.ops[i::usize].kind == isa_asm.AOP_REG) { ret item.ops[i::usize].size; }
        i = i + 1;
    }
    i = 0;
    for (i < item.nops) {
        val op: *isa_asm.Operand = ?item.ops[i::usize];
        if (op.kind == isa_asm.AOP_MEM && op.size != 0) { ret op.size; }
        i = i + 1;
    }
    ret 8;
}

fun operand_size(op: *isa_asm.Operand, inst_size: u8) u8 {
    if (op.kind == isa_asm.AOP_MEM && op.size != 0) { ret op.size; }
    ret inst_size;
}

fun emit(st: *isa_encode.EncodeState, c: *isa_asm.Cursor, l: *isa_asm.Labels, item: *isa_asm.Item) err[fail.Fail] {
    var sym: intern.StrId = intern.STR_NIL;
    if (item.ref == isa_asm.AR_SYM) {
        val name: str                        = (c.body::usize + item.ref_off)::str;
        val symr: res[intern.StrId, A.Error] = intern.bytes_add(st.interner, name, item.ref_len);
        if (sel symr.err) { ret err[fail.Fail].err{fail.refused(symr.err)}; }
        sym = symr.ok;
    }

    val pat: u16 = x64_mnemonic.pattern(item.flags);
    if (pat == x64_mnemonic.PATTERN_VEC || pat == x64_mnemonic.PATTERN_VECI) { ret emit_vec(st, item, sym); }
    if (pat == x64_mnemonic.PATTERN_VECG)                                    { ret emit_vec_gp(st, item, sym); }
    if (pat == x64_mnemonic.PATTERN_VEC3)                                    { ret emit_vec3(st, item, sym); }
    if (pat == x64_mnemonic.PATTERN_MOVQ)                                    { ret emit_movq(st, item); }
    if (pat == x64_mnemonic.PATTERN_VSHIFT)                                  { ret emit_vshift(st, item, sym); }

    var mi: isa_inst.Inst = build(item, sym);

    val inst_start: usize = st.buf.bytes.len;
    val n:          i32   = x64_emit.encode_inst(?mi, ?st.buf);
    if (n <= 0) { ret err[fail.Fail].err{fail.message("encode: inline-asm instruction encoded to no bytes")}; }

    if (item.ref == isa_asm.AR_LOCAL) {
        ret isa_asm.resolve_local(st, c, l, (inst_start + (n - 4)::usize)::u32, item.ref_num, item.ref_fwd);
    }
    if (item.ref == isa_asm.AR_SYM) { ret emit_sym_ref(st, ?mi, sym, inst_start, n); }
    ret err[fail.Fail].ok{};
}

fun emit_sym_ref(st: *isa_encode.EncodeState, mi: *isa_inst.Inst, sym: intern.StrId,
    inst_start: usize, n: i32) err[fail.Fail] {
    val patch: i32 = x64_emit.reloc_offset(nil, mi, n);
    if (patch < 0) {
        ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm symbol reference has no relocation field")};
    }

    ret push_pc32(st, sym, inst_start, patch, n);
}

# a pc-relative field at patch within an n-byte instruction, relative to the instruction's end
fun push_pc32(st: *isa_encode.EncodeState, sym: intern.StrId, inst_start: usize, patch: i32, n: i32) err[fail.Fail] {
    val pushed: err[fail.Fail] = isa_encode.push_inst_reloc(st, (inst_start + patch::usize)::u32, target_of.RK_PC32, sym,
        -(n - patch)::i64, (n - patch)::u8);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun vec_operand(op: *isa_asm.Operand, sym: intern.StrId) isa_inst.Operand {
    if (isa_asm.is_vreg(op)) { ret x64_emit.vec_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, op.reg), x64_emit.VB_XMM); }
    ret to_isa(op, 16, sym);
}

fun emit_vec(st: *isa_encode.EncodeState, item: *isa_asm.Item, sym: intern.StrId) err[fail.Fail] {
    val op:    u16              = item.code::u16;
    val dst:   isa_inst.Operand = vec_operand(?item.ops[0], sym);
    val src:   isa_inst.Operand = vec_operand(?item.ops[1], sym);
    val start: usize            = st.buf.bytes.len;
    val with:  bool             = x64_mnemonic.pattern(item.flags) == x64_mnemonic.PATTERN_VECI;
    val r:     err[fail.Fail]   = emit_vec_body(item, op, dst, src, ?st.buf);
    if (sel r.err)                  { ret r; }
    if (item.ref != isa_asm.AR_SYM) { ret err[fail.Fail].ok{}; }
    var tail: i32 = 0;
    if (with) { tail = 1; }
    val n: i32 = (st.buf.bytes.len - start)::i32;
    ret push_pc32(st, sym, start, n - tail - 4, n);
}

fun emit_vec_body(item: *isa_asm.Item, op: u16, dst: isa_inst.Operand, src: isa_inst.Operand, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (x64_mnemonic.pattern(item.flags) == x64_mnemonic.PATTERN_VECI) { ret x64_emit.packed_imm(op, x64_emit.VB_XMM, dst.reg, src, item.ops[2].imm::u8, buf); }
    if ((item.flags & x64_mnemonic.FLAG_VSTORE) != 0)                  { ret x64_emit.vec_move(op, dst, src, buf); }
    ret x64_emit.packed_op(op, x64_emit.VB_XMM, dst.reg, src, buf);
}

fun patch_site(st: *isa_encode.EncodeState, patch_pos: u32, target_off: u32) err[fail.Fail] {
    x64_emit.patch_rel32(?st.buf, patch_pos::usize, target_off::i32 - (patch_pos + 4)::i32);
    ret err[fail.Fail].ok{};
}

# whether an asm body returns, for the middle end, which reads no grammar
pub fun returns(body: str) bool {
    ret isa_asm.returns(grammar, body);
}

pub fun grammar() isa_asm.Grammar {
    var g: isa_asm.Grammar;
    g.isa        = "x86_64";
    g.unknown    = "unknown x86_64 inline-asm instruction '";
    g.rows       = ?x64_mnemonic.ROWS[0];
    g.row_count  = x64_mnemonic.ROW_COUNT;
    g.data       = ?isa_asm.DIRECTIVES_WORD16[0];
    g.data_count = isa_asm.DIRECTIVE_COUNT;
    g.decode     = decode;
    g.parse      = parse;
    g.emit       = emit;
    g.patch      = patch_site;
    g.slot_sp    = false;
    g.writes_sp  = writes_sp;
    g.all_gp     = x64_mnemonic.ALL_GP;
    g.all_fp     = x64_mnemonic.ALL_FP;
    g.word       = 0;
    g.endian     = target_model.ENDIAN_LITTLE;
    g.ct_class   = x64_effects.asm_ct_class;
    g.note_bytes = isa_encode.render_bytes_directive;
    g.note_label = asm_note_label;
    g.decl_reg   = decl_reg;
    g.no_fall    = no_fall;
    ret g;
}

fun no_fall(item: *isa_asm.Item) bool {
    if (item.kind != isa_asm.AI_INST) { ret false; }
    ret item.code == x64.HLT::u32;
}

fun writes_sp(item: *isa_asm.Item) bool {
    if (item.kind == isa_asm.AI_LABEL) { ret false; }
    if (item.kind == isa_asm.AI_BYTES) {
        if (item.declared) { ret (item.decl_gp & (1::u32 << isa_inst.regid_index(x64.RSP)::u32)) != 0; }
        ret true;
    }
    if ((item.implicit & (1::u32 << isa_inst.regid_index(x64.RSP)::u32)) != 0)          { ret true; }
    if ((item.writes & isa_asm.AW_OP0) != 0 && item.nops > 0 && op_is_sp(?item.ops[0])) { ret true; }
    if ((item.writes & isa_asm.AW_OP1) != 0 && item.nops > 1 && op_is_sp(?item.ops[1])) { ret true; }
    ret false;
}

fun op_is_sp(op: *isa_asm.Operand) bool {
    ret op.kind == isa_asm.AOP_REG && op.bank == isa_asm.ABANK_GP && op.reg == x64.RSP;
}

fun decl_reg(name: str, bank: *u8, idx: *u32) bool {
    var op: isa_asm.Operand = isa_asm.op_none();
    if (reg(name, ?op) && op.size == 8) {
        @bank = isa_asm.ABANK_GP;
        @idx  = isa_inst.regid_index(op.reg)::u32;
        ret true;
    }
    var n: i32 = 0;
    if (xmm_index(name, ?n)) {
        @bank = isa_asm.ABANK_FP;
        @idx  = n::u32;
        ret true;
    }
    ret false;
}

fun xmm_index(name: str, out: *i32) bool {
    var i: i32 = 0;
    for (i < x64.FP_COUNT) {
        if (str_equals(name, x64.fp_reg_name(i))) {
            @out = i;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

# an inline-asm block encodes the instructions it spells, legacy sse included
pub fun encode_asm_block(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    var g:       isa_asm.Grammar = grammar();
    val variant: u8              = st.buf.variant;
    st.buf.variant = 0;
    fin { st.buf.variant = variant; }
    ret isa_asm.encode_block(st, ?g, f, mi);
}

fun width_flags_for(size: u8) u16 {
    if (size == 8) { ret x64_inst.FLAG_REX_W::u16; }
    if (size == 2) { ret x64_inst.FLAG_16BIT::u16; }
    ret 0;
}

# a numbered label, spelled as the block spells it: GNU as looks `1f` up in
# the next `1:` and `1b` in the last one, as the block does, and nothing but
# the block's own instructions lies between a reference and its definition
fun asm_note_label(st: *isa_encode.EncodeState, number: u32) err[fail.Fail] {
    x64_printer.note_local_label(?st.buf, number);
    ret err[fail.Fail].ok{};
}
