use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use lang_mir: mach.lang.mir;
use mach.lang.mir.expansion;
use mach.lang.target.isa;
use isa_rules: mach.lang.target.isa.rules;
use mach.lang.target.isa.x64;

val RULE_COUNT: usize = 84;

val COPY_OPCODE_COUNT: usize = 2;

val FUSED_CC_COUNT: usize = 6;

pub fun select(a: *A.Allocator, tgt: *isa.BackendTarget, f: *lang_mir.MirFunction) err[fail.Fail] {
    ret isa_rules.select_function(?PACK, a, tgt, f);
}

pub fun is_reg_move(opcode: u32) bool {
    ret isa_rules.is_reg_move(?PACK, opcode);
}

# one instruction takes an integer whose sign extension from 32 bits is
# itself as its immediate; any other is a movabs of its own first, the rule
# the middle end hoists a loop's constants by
pub fun int_imm_fits(value: u64, bits: u32) bool {
    if (bits <= 32) { ret true; }
    val v: i64 = value:~i64;
    ret v >= -2147483648 && v <= 2147483647;
}

pub fun is_trap_terminator(opcode: u32) bool {
    ret opcode == x64.UD2::u32;
}

fun load_widens(tgt: *isa.BackendTarget, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) bool {
    ret mi.width > mi.src_width;
}

# the high multiply is the one-operand mul or imul on the rdx:rax pair: the
# accumulator is loaded, the pair multiply reads the other operand, and the
# high half is read back from rdx. the multiply takes a register or memory, so
# an immediate rides the accumulator, and when both operands are immediates
# the multiplier is staged in rdx, which the multiply overwrites anyway. the
# 8-bit form leaves its high half in ah, so only 16 bits and wider select here
fun mul_hi_width_ok(mi: *lang_mir.MirInstr) bool {
    ret mi.width == 2 || mi.width == 4 || mi.width == 8;
}

fun mul_hi_reads_register(tgt: *isa.BackendTarget, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) bool {
    if (!mul_hi_width_ok(mi) || mi.operand_count != 3) { ret false; }
    ret mi.operands[1].kind != lang_mir.MIR_OP_IMM || mi.operands[2].kind != lang_mir.MIR_OP_IMM;
}

fun mul_hi_both_immediate(tgt: *isa.BackendTarget, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) bool {
    if (!mul_hi_width_ok(mi) || mi.operand_count != 3) { ret false; }
    ret mi.operands[1].kind == lang_mir.MIR_OP_IMM && mi.operands[2].kind == lang_mir.MIR_OP_IMM;
}

fun pair_reg(r: i32) lang_mir.MirOperand {
    var o: lang_mir.MirOperand = lang_mir.op_preg(lang_mir.preg_id(r));
    o.required_bank = lang_mir.BANK_GP;
    ret o;
}

fun emit_move(builder: *expansion.ExpansionBuilder, dst: lang_mir.MirOperand, src: lang_mir.MirOperand) err[fail.Fail] {
    var ops: [2]lang_mir.MirOperand;
    ops[0] = dst;
    ops[1] = src;
    val r: res[*lang_mir.MirInstr, fail.Fail] = isa_rules.emit_instr(builder, x64.MOV::u32, ?ops[0], 2);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_mul_hi(builder: *expansion.ExpansionBuilder, stage: bool) err[fail.Fail] {
    val mi:  *lang_mir.MirInstr  = builder.source;
    val acc: lang_mir.MirOperand = pair_reg(x64.RAX);
    val hi:  lang_mir.MirOperand = pair_reg(x64.RDX);
    var x:   lang_mir.MirOperand = mi.operands[1];
    var y:   lang_mir.MirOperand = mi.operands[2];
    if (y.kind == lang_mir.MIR_OP_IMM && x.kind != lang_mir.MIR_OP_IMM) {
        x = mi.operands[2];
        y = mi.operands[1];
    }
    val r0: err[fail.Fail] = emit_move(builder, acc, x);
    if (sel r0.err) { ret r0; }
    if (stage) {
        val rs: err[fail.Fail] = emit_move(builder, hi, y);
        if (sel rs.err) { ret rs; }
        y = hi;
    }
    var op: u32 = lang_mir.MIR_SEL_MUL_PAIR_U;
    if (mi.opcode == lang_mir.MIR_MUL_HI_S) { op = lang_mir.MIR_SEL_MUL_PAIR_S; }
    var ops: [2]lang_mir.MirOperand;
    ops[0] = acc;
    ops[1] = y;
    val r1: res[*lang_mir.MirInstr, fail.Fail] = isa_rules.emit_instr(builder, op, ?ops[0], 2);
    if (sel r1.err) { ret err[fail.Fail].err{r1.err}; }
    ret emit_move(builder, mi.operands[0], hi);
}

fun expand_mul_hi(builder: *expansion.ExpansionBuilder) err[fail.Fail] {
    ret emit_mul_hi(builder, false);
}

fun expand_mul_hi_staged(builder: *expansion.ExpansionBuilder) err[fail.Fail] {
    ret emit_mul_hi(builder, true);
}

val RULES: [RULE_COUNT]isa_rules.Rule = [RULE_COUNT]isa_rules.Rule{
    isa_rules.Rule{op: lang_mir.MIR_ADD, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_ADD, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SUB, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_SUB, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_MUL, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_MUL, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_AND, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_AND, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_OR, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_OR, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_XOR, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_XOR, expand: nil, expansion_length: 0},

    isa_rules.Rule{op: lang_mir.MIR_SHL, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_SHL, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SHR_U, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_SHR_U, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SHR_S, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_SHR_S, expand: nil, expansion_length: 0},

    isa_rules.Rule{op: lang_mir.MIR_DIV_S, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_DIV_S, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_DIV_U, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_DIV_U, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_REM_S, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_REM_S, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_REM_U, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_REM_U, expand: nil, expansion_length: 0},

    isa_rules.Rule{op: lang_mir.MIR_MUL_PAIR_U, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_MUL_PAIR_U, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_MUL_PAIR_S, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_MUL_PAIR_S, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_MUL_HI_U, gate: isa_rules.GATE_SCALAR, guard: mul_hi_reads_register, kind: isa_rules.RULE_EXPAND, to: 0, expand: expand_mul_hi, expansion_length: 3},
    isa_rules.Rule{op: lang_mir.MIR_MUL_HI_S, gate: isa_rules.GATE_SCALAR, guard: mul_hi_reads_register, kind: isa_rules.RULE_EXPAND, to: 0, expand: expand_mul_hi, expansion_length: 3},
    isa_rules.Rule{op: lang_mir.MIR_MUL_HI_U, gate: isa_rules.GATE_SCALAR, guard: mul_hi_both_immediate, kind: isa_rules.RULE_EXPAND, to: 0, expand: expand_mul_hi_staged, expansion_length: 4},
    isa_rules.Rule{op: lang_mir.MIR_MUL_HI_S, gate: isa_rules.GATE_SCALAR, guard: mul_hi_both_immediate, kind: isa_rules.RULE_EXPAND, to: 0, expand: expand_mul_hi_staged, expansion_length: 4},

    isa_rules.Rule{op: lang_mir.MIR_NEG, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_RETAG, to: lang_mir.MIR_SEL_NEG, expand: nil, expansion_length: 0},

