# MIR lowered to x64 instructions, with the frame each function lays out
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mach.lang.ct;
use mach.lang.intern;
use lang_mir:      mach.lang.mir;
use extension_x64: mach.lang.target.extension.x64;
use mach.lang.target.isa;
use mach.lang.target.isa.common;
use mach.lang.target.isa.convplan;
use isa_effect: mach.lang.target.isa.effect;
use isa_encode: mach.lang.target.isa.encode;
use isa_inst:   mach.lang.target.isa.inst;
use mach.lang.target.isa.x64;
use x64_effects:  mach.lang.target.isa.x64.effects;
use x64_emit:     mach.lang.target.isa.x64.emit;
use x64_grammar:  mach.lang.target.isa.x64.grammar;
use x64_inst:     mach.lang.target.isa.x64.inst;
use x64_printer:  mach.lang.target.isa.x64.printer;
use target_model: mach.lang.target.model;
use target_of:    mach.lang.target.of;

fun count_callee_saved(file: target_model.RegFile, mask: u32) i32 {
    var list: [16]i32;
    val ln:   i32 = x64.callee_saved_gp_list_from(file, ?list[0]);
    var n:    i32 = 0;
    var i:    i32 = 0;
    for (i < ln) {
        if ((mask & (1::u32 << isa_inst.regid_index(list[i])::u32)) != 0) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# how far below rbp the callee-saved area starts: under the slots when rbp
# addresses them, and right under rbp in a realigned frame, which saves before
# it realigns so that every save sits at a known distance from the frame
fun save_top(f: *lang_mir.MirFunction) u32 {
    if (f.frame.realign != 0) { ret 0; }
    ret f.frame.size;
}

# the bytes a realigned frame drops rsp by to hold its saves before realigning
fun realign_save_size(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction) usize {
    ret fp_save_base(st.callee_saved, 0, f.callee_mask) + common.popcount32(f.callee_mask_fp)::usize * 16;
}

fun fp_save_base(file: target_model.RegFile, frame_size: u32, callee_mask: u32) usize {
    val gp_space: usize = count_callee_saved(file, callee_mask)::usize * 8;
    var base:     usize = frame_size::usize + gp_space;
    if ((base & 15) != 0) { base = (base + 15) & ~15::usize; }
    ret base;
}

fun emit_inst(st: *isa_encode.EncodeState, mi: *isa_inst.Inst) {
    x64_emit.encode_inst(mi, ?st.buf);
}

fun emit_frame_store(st: *isa_encode.EncodeState, reg: i32, base: i32, disp: i32) {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = x64.MOV;
    mi.dst    = isa_inst.make_mem(base, disp, isa_inst.REG_NONE, 0, 8);
    mi.src1   = isa_inst.make_reg(reg, 8);
    mi.size   = 8;
    mi.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?mi);
}

fun emit_frame_load(st: *isa_encode.EncodeState, reg: i32, base: i32, disp: i32) {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = x64.MOV;
    mi.dst    = isa_inst.make_reg(reg, 8);
    mi.src1   = isa_inst.make_mem(base, disp, isa_inst.REG_NONE, 0, 8);
    mi.size   = 8;
    mi.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?mi);
}

fun emit_xmm_store(st: *isa_encode.EncodeState, idx: i32, base: i32, disp: i32) {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = x64.MOVAPS;
    mi.dst    = isa_inst.make_mem(base, disp, isa_inst.REG_NONE, 0, 16);
    mi.src1   = isa_inst.make_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, idx), 16);
    mi.size   = 16;
    emit_inst(st, ?mi);
}

fun emit_xmm_load(st: *isa_encode.EncodeState, idx: i32, base: i32, disp: i32) {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = x64.MOVAPS;
    mi.dst    = isa_inst.make_reg(isa_inst.regid_make(isa_inst.REG_CLASS_ID_FP, idx), 16);
    mi.src1   = isa_inst.make_mem(base, disp, isa_inst.REG_NONE, 0, 16);
    mi.size   = 16;
    emit_inst(st, ?mi);
}

fun needs_stack_probe(stack_probe: bool, page_size: u64, total: usize) bool {
    ret stack_probe && total > page_size::usize;
}

fun emit_stack_probe(st: *isa_encode.EncodeState, total: usize, page_bytes: usize) err[fail.Fail] {
    # the prologue has no operands, and no argument register is r10 or r11
    val scratch: i32 = x64_emit.pick_stage_scratch(nil, nil);
    if (scratch == isa_inst.REG_NONE) {
        ret err[fail.Fail].err{fail.message("encode: no x86-64 scratch register is free to count a stack probe")};
    }
    var mov_cnt: isa_inst.Inst = isa_inst.inst_blank();
    mov_cnt.opcode = x64.MOV;
    mov_cnt.dst    = isa_inst.make_reg(scratch, 8);
    mov_cnt.src1   = isa_inst.make_imm(total::i64, 8);
    mov_cnt.size   = 8;
    mov_cnt.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?mov_cnt);

    val loop_top: usize = st.buf.bytes.len;
    x64_printer.note_local_label(?st.buf, 1);

    var sub_sp: isa_inst.Inst = isa_inst.inst_blank();
    sub_sp.opcode = x64.SUB;
    sub_sp.dst    = isa_inst.make_reg(x64.RSP, 8);
    sub_sp.src1   = isa_inst.make_imm(page_bytes::i64, 8);
    sub_sp.size   = 8;
    sub_sp.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?sub_sp);

    var touch: isa_inst.Inst = isa_inst.inst_blank();
    touch.opcode = x64.MOV;
    touch.dst    = isa_inst.make_mem(x64.RSP, 0, isa_inst.REG_NONE, 0, 8);
    touch.src1   = isa_inst.make_reg(scratch, 8);
    touch.size   = 8;
    touch.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?touch);

    var sub_cnt: isa_inst.Inst = isa_inst.inst_blank();
    sub_cnt.opcode = x64.SUB;
    sub_cnt.dst    = isa_inst.make_reg(scratch, 8);
    sub_cnt.src1   = isa_inst.make_imm(page_bytes::i64, 8);
    sub_cnt.size   = 8;
    sub_cnt.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?sub_cnt);

    var cmp_cnt: isa_inst.Inst = isa_inst.inst_blank();
    cmp_cnt.opcode = x64.CMP;
    cmp_cnt.dst    = isa_inst.make_reg(scratch, 8);
    cmp_cnt.src1   = isa_inst.make_imm(page_bytes::i64, 8);
    cmp_cnt.size   = 8;
    cmp_cnt.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?cmp_cnt);

    var ja: isa_inst.Inst = isa_inst.inst_blank();
    ja.opcode = x64.JA;
    ja.dst    = isa_inst.make_numbered_local_label(false, 1);
    ja.size   = DEFAULT_OPERAND_SIZE;
    val fp: err[fail.Fail] = flags_pair(cmp_cnt.opcode, ja.opcode);
    if (sel fp.err) { ret fp; }
    emit_inst(st, ?ja);
    val ja_patch: usize = st.buf.bytes.len - 4;
    x64_emit.patch_rel32(?st.buf, ja_patch, (loop_top::i64 - st.buf.bytes.len::i64)::i32);

    var sub_rem: isa_inst.Inst = isa_inst.inst_blank();
    sub_rem.opcode = x64.SUB;
    sub_rem.dst    = isa_inst.make_reg(x64.RSP, 8);
    sub_rem.src1   = isa_inst.make_reg(scratch, 8);
    sub_rem.size   = 8;
    sub_rem.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?sub_rem);
    ret err[fail.Fail].ok{};
}

# drops rsp by the frame's `total` bytes, probing each page where the target
# asks; the drop is a frame step only where rsp keeps a known distance
fun emit_frame_alloc(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, total: usize) err[fail.Fail] {
    if (total == 0) { ret err[fail.Fail].ok{}; }
    if (needs_stack_probe(st.stack_probe, isa_encode.STACK_PROBE_INTERVAL, total)) {
        val pr: err[fail.Fail] = emit_stack_probe(st, total, isa_encode.STACK_PROBE_INTERVAL::usize);
        if (sel pr.err) { ret pr; }
    }
    or {
        var sub_rsp: isa_inst.Inst = isa_inst.inst_blank();
        sub_rsp.opcode = x64.SUB;
        sub_rsp.dst    = isa_inst.make_reg(x64.RSP, 8);
        sub_rsp.src1   = isa_inst.make_imm(total::i64, 8);
        sub_rsp.size   = 8;
        sub_rsp.flags  = x64_inst.FLAG_REX_W;
        emit_inst(st, ?sub_rsp);
    }
    if (f.frame.realign != 0) { ret err[fail.Fail].ok{}; }
    ret isa_encode.push_frame_step(st, target_of.FRAME_STEP_ALLOC, 0, st.buf.bytes.len::u32 - fn_base, total::u64);
}

fun emit_prologue(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32) err[fail.Fail] {
    val rf: err[fail.Fail] = isa_encode.push_frame(st, fn_base);
    if (sel rf.err) { ret err[fail.Fail].err{rf.err}; }

    var push_rbp: isa_inst.Inst = isa_inst.inst_blank();
    push_rbp.opcode = x64.PUSH;
    push_rbp.dst    = isa_inst.make_reg(x64.RBP, 8);
    push_rbp.size   = 8;
    push_rbp.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?push_rbp);
    val rs_push: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_PUSH, isa_inst.regid_index(x64.RBP)::u8,
        st.buf.bytes.len::u32 - fn_base, 0);
    if (sel rs_push.err) { ret err[fail.Fail].err{rs_push.err}; }

    var mov_rbp: isa_inst.Inst = isa_inst.inst_blank();
    mov_rbp.opcode = x64.MOV;
    mov_rbp.dst    = isa_inst.make_reg(x64.RBP, 8);
    mov_rbp.src1   = isa_inst.make_reg(x64.RSP, 8);
    mov_rbp.size   = 8;
    mov_rbp.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?mov_rbp);

    # a realigned frame saves before it realigns, since windows unwind info
    # cannot address a save below a realigned rsp: rsp drops by the save area
    # and rbp is recorded as that rsp plus the area
    val realigned: bool  = f.frame.realign != 0;
    var sp_below:  usize = 0;
    if (realigned) {
        sp_below = realign_save_size(st, f);
        if (sp_below > 0) {
            var sub_save: isa_inst.Inst = isa_inst.inst_blank();
            sub_save.opcode = x64.SUB;
            sub_save.dst    = isa_inst.make_reg(x64.RSP, 8);
            sub_save.src1   = isa_inst.make_imm(sp_below::i64, 8);
            sub_save.size   = 8;
            sub_save.flags  = x64_inst.FLAG_REX_W;
            emit_inst(st, ?sub_save);
            val rs_save_alloc: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_ALLOC, 0,
                st.buf.bytes.len::u32 - fn_base, sp_below::u64);
            if (sel rs_save_alloc.err) { ret err[fail.Fail].err{rs_save_alloc.err}; }
        }
    }
    val rs_fp: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SET_FP, isa_inst.regid_index(x64.RBP)::u8,
        st.buf.bytes.len::u32 - fn_base, sp_below::u64);
    if (sel rs_fp.err) { ret err[fail.Fail].err{rs_fp.err}; }

    val total: usize = f.frame.base_dist::usize;
    if (!realigned) {
        val ra: err[fail.Fail] = emit_frame_alloc(st, f, fn_base, total);
        if (sel ra.err) { ret ra; }
        sp_below = total;
    }

    val rsv: err[fail.Fail] = save_callee(st, f, fn_base, x64.RBP, 0, sp_below);
    if (sel rsv.err) { ret rsv; }

    if (realigned) {
        var and_rsp: isa_inst.Inst = isa_inst.inst_blank();
        and_rsp.opcode = x64.AND;
        and_rsp.dst    = isa_inst.make_reg(x64.RSP, 8);
        and_rsp.src1   = isa_inst.make_imm(0 - f.frame.realign::i64, 8);
        and_rsp.size   = 8;
        and_rsp.flags  = x64_inst.FLAG_REX_W;
        emit_inst(st, ?and_rsp);
        val rs_align: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_REALIGN, 0,
            st.buf.bytes.len::u32 - fn_base, f.frame.realign::u64);
        if (sel rs_align.err) { ret err[fail.Fail].err{rs_align.err}; }
        ret emit_frame_alloc(st, f, fn_base, total);
    }
    ret err[fail.Fail].ok{};
}

# stores the callee-saved registers below the frame's top, which sits `bias`
# bytes above `base`, and records each save at its distance above an rsp that
# sits `sp_below` bytes under that top
fun save_callee(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, base: i32, bias: i32,
    sp_below: usize) err[fail.Fail] {
    var list: [16]i32;
    val ln:   i32 = x64.callee_saved_gp_list_from(st.callee_saved, ?list[0]);
    val top:  u32 = save_top(f);
    var coff: i32 = top::i32 + 8;
    var i:    i32 = 0;
    for (i < ln) {
        if ((f.callee_mask & (1::u32 << isa_inst.regid_index(list[i])::u32)) != 0) {
            emit_frame_store(st, list[i], base, bias - coff);
            val rs_save: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SAVE, isa_inst.regid_index(list[i])::u8,
                st.buf.bytes.len::u32 - fn_base,
                (sp_below::i64 - coff::i64)::u64);
            if (sel rs_save.err) { ret err[fail.Fail].err{rs_save.err}; }
            coff = coff + 8;
        }
        i = i + 1;
    }

    val xbase: i32 = fp_save_base(st.callee_saved, top, f.callee_mask)::i32;
    var xoff:  i32 = xbase + 16;
    var x:     i32 = 0;
    for (x < 16) {
        if ((f.callee_mask_fp & (1::u32 << x::u32)) != 0) {
            emit_xmm_store(st, x, base, bias - xoff);
            val rs_xsave: err[fail.Fail] = isa_encode.push_frame_step(st, target_of.FRAME_STEP_SAVE_VEC, x::u8,
                st.buf.bytes.len::u32 - fn_base,
                (sp_below::i64 - xoff::i64)::u64);
            if (sel rs_xsave.err) { ret err[fail.Fail].err{rs_xsave.err}; }
            xoff = xoff + 16;
        }
        x = x + 1;
    }
    ret err[fail.Fail].ok{};
}

fun restore_callee(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, base: i32, bias: i32) {
    val top: u32 = save_top(f);

    val xbase: i32 = fp_save_base(st.callee_saved, top, f.callee_mask)::i32;
    var xoff:  i32 = xbase + 16;
    var x:     i32 = 0;
    for (x < 16) {
        if ((f.callee_mask_fp & (1::u32 << x::u32)) != 0) {
            emit_xmm_load(st, x, base, bias - xoff);
            xoff = xoff + 16;
        }
        x = x + 1;
    }

    var list: [16]i32;
    val ln:   i32 = x64.callee_saved_gp_list_from(st.callee_saved, ?list[0]);
    var coff: i32 = top::i32 + 8;
    var i:    i32 = 0;
    for (i < ln) {
        if ((f.callee_mask & (1::u32 << isa_inst.regid_index(list[i])::u32)) != 0) {
            emit_frame_load(st, list[i], base, bias - coff);
            coff = coff + 8;
        }
        i = i + 1;
    }
}

# a frame the stack pointer addresses: rsp drops past an eight-byte pad to
# where rbp would sit and on by base_dist, so the frame keeps the layout and
# alignment a pushed rbp gives it
fun sp_frame_size(f: *lang_mir.MirFunction) usize {
    ret f.frame.base_dist::usize + 8;
}

fun emit_sp_prologue(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32) err[fail.Fail] {
    val rf: err[fail.Fail] = isa_encode.push_frame(st, fn_base);
    if (sel rf.err) { ret err[fail.Fail].err{rf.err}; }
    val ra: err[fail.Fail] = emit_frame_alloc(st, f, fn_base, sp_frame_size(f));
    if (sel ra.err) { ret ra; }
    ret save_callee(st, f, fn_base, x64.RSP, f.frame.base_dist::i32, f.frame.base_dist::usize);
}

fun emit_sp_epilogue(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction) {
    restore_callee(st, f, x64.RSP, f.frame.base_dist::i32);
    var add_rsp: isa_inst.Inst = isa_inst.inst_blank();
    add_rsp.opcode = x64.ADD;
    add_rsp.dst    = isa_inst.make_reg(x64.RSP, 8);
    add_rsp.src1   = isa_inst.make_imm(sp_frame_size(f)::i64, 8);
    add_rsp.size   = 8;
    add_rsp.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?add_rsp);
}

fun emit_epilogue(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction) {
    restore_callee(st, f, x64.RBP, 0);

    var mov_rsp: isa_inst.Inst = isa_inst.inst_blank();
    mov_rsp.opcode = x64.MOV;
    mov_rsp.dst    = isa_inst.make_reg(x64.RSP, 8);
    mov_rsp.src1   = isa_inst.make_reg(x64.RBP, 8);
    mov_rsp.size   = 8;
    mov_rsp.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?mov_rsp);

    var pop_rbp: isa_inst.Inst = isa_inst.inst_blank();
    pop_rbp.opcode = x64.POP;
    pop_rbp.dst    = isa_inst.make_reg(x64.RBP, 8);
    pop_rbp.size   = 8;
    pop_rbp.flags  = x64_inst.FLAG_REX_W;
    emit_inst(st, ?pop_rbp);
}

val DEFAULT_OPERAND_SIZE: u8 = 8;

# the hooks the shared encode driver runs this encoder through
pub val HOOKS: isa_encode.EncodeHooks = isa_encode.EncodeHooks{
    isa:             "x86-64",
    encode_function: encode_function,
    encode_instr:    encode_mir_instr,
    patch_branch:    patch_branch,
    stream:          true,
    effects:         isa_effect.Hooks{
        describe:   x64_effects.describe,
        mnemonic:   x64_printer.mnemonic,
        reg_name:   x64_printer.reg_name,
        const_regs: 0,
    },
};

fun patch_branch(st: *isa_encode.EncodeState, fx: *isa_encode.BranchFixup, target_off: u32) err[fail.Fail] {
    val disp: i32 = target_off::i32 - fx.next_ip::i32;
    if (fx.patch_pos::usize + 4 > st.buf.bytes.len) {
        ret err[fail.Fail].err{fail.message("encode: branch fixup site is outside the text buffer")};
    }
    x64_emit.patch_rel32(?st.buf, fx.patch_pos::usize, disp);
    ret err[fail.Fail].ok{};
}

fun encode_function(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction) err[fail.Fail] {
    val fn_base: u32 = st.buf.bytes.len::u32;
    st.buf.variant = vex_variant(st.model);

    if (f.block_count == 0) { ret err[fail.Fail].ok{}; }

    val ms: err[fail.Fail] = isa_encode.push_symbol(st, f.name, fn_base, target_of.SYM_OBJ_FLAG_FUNCTION);
    if (sel ms.err) { ret err[fail.Fail].err{ms.err}; }

    val naked:          bool = f.frame.omit;
    val frame_size:     u32  = f.frame.size;
    val callee_mask:    u32  = f.callee_mask;
    val callee_mask_fp: u32  = f.callee_mask_fp;
    val outgoing_size:  u32  = f.frame.outgoing_size;

    if (isa_encode.sink_active(?st.buf)) {
        val rh: err[fail.Fail] = x64_printer.note_function(?st.buf, st.interner, f);
        if (sel rh.err) { ret rh; }
    }

    if (f.frame.sp_frame) {
        val rpl: err[fail.Fail] = emit_sp_prologue(st, f, fn_base);
        if (sel rpl.err) { ret rpl; }
    }
    or (!naked) {
        val rpl: err[fail.Fail] = emit_prologue(st, f, fn_base);
        if (sel rpl.err) { ret rpl; }
    }
    or (!f.naked && !f.frame.opaque) {
        # a leaf without a frame keeps the frame its call left, which a record with no steps says
        val rf: err[fail.Fail] = isa_encode.push_frame(st, fn_base);
        if (sel rf.err) { ret rf; }
    }
    val rp: err[fail.Fail] = isa_encode.sink_check(st, HOOKS.isa, isa_encode.REGION_PROLOGUE);
    if (sel rp.err) { ret rp; }
    val upper: bool = dirties_upper(st, f);

    var bi: u32 = 0;
    for (bi < f.block_count) {
        val blk: *lang_mir.MirBlock = ?f.blocks[bi];
        val rb:  err[fail.Fail]     = isa_encode.push_block(st, fn_base, blk.id, st.buf.bytes.len::u32);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        isa_encode.set_fallthrough(st, f, bi);

        if (isa_encode.sink_active(?st.buf)) {
            val rl: err[fail.Fail] = x64_printer.note_block(?st.buf, blk.id);
            if (sel rl.err) { ret rl; }
        }

        var jumped: bool = false;
        var ii:     u32  = 0;
        for (ii < blk.instr_count) {
            val mi: *lang_mir.MirInstr = ?blk.instrs[ii];
            # the return a tail jump replaced is never reached
            if (!lang_mir.emits_instr(f, mi) || (jumped && mi.opcode == x64.RET::u32)) {
                ii = ii + 1;
                cnt;
            }
            val rr: err[fail.Fail] = isa_encode.push_row(st, st.buf.bytes.len::u32, mi.loc);
            if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
            val rip: err[fail.Fail] = isa_encode.push_inline_pc(st, st.buf.bytes.len::u32, mi.inline_site);
            if (sel rip.err) { ret err[fail.Fail].err{rip.err}; }
            val leaves: bool = mi.opcode == x64.RET::u32 || (mi.opcode == lang_mir.MIR_CALL && mi.tail);
            # the upper state a wide value left is cleared before code outside
            # the function runs, unless the call or return passes a value in it
            if (upper && (leaves || mi.opcode == lang_mir.MIR_CALL) && !mi.keeps_upper) {
                var vz: isa_inst.Inst = isa_inst.inst_blank();
                vz.opcode = x64.VZEROUPPER;
                emit_inst(st, ?vz);
            }
            if (leaves && f.frame.sp_frame) {
                emit_sp_epilogue(st, f);
            }
            or (leaves && !naked) {
                emit_epilogue(st, f);
            }
            if (mi.opcode == lang_mir.MIR_CALL && mi.tail) { jumped = true; }
            val ei: err[fail.Fail] = isa_encode.instr_encode(st, f, fn_base, mi, ?HOOKS);
            if (sel ei.err) { ret ei; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    ret err[fail.Fail].ok{};
}

fun vex_variant(m: *target_model.Machine) u8 {
    if (target_model.vector_register_bytes(m) > m.vector_bits / 8) { ret x64_emit.VARIANT_VEX; }
    ret 0;
}

# a function holds a value in the upper bytes of a vector register, which the
# model's register-width row asks cleared before a call or a return
fun dirties_upper(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction) bool {
    var v: u32 = 0;
    for (v < f.vreg_count) {
        val vb: u8 = f.vregs[v].vec_bytes;
        if (vb != 0 && target_model.vector_upper_clear(st.model, vb::u32)) { ret true; }
        v = v + 1;
    }
    ret false;
}

fun encode_mir_instr(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.opcode > 0xFFFF) {
        val failure: err[fail.Fail] = isa_encode.opcode_failure(st, f, "x64", mi.opcode);
        if (sel failure.err) { ret err[fail.Fail].err{failure.err}; }
        ret err[fail.Fail].ok{};
    }
    if (reads_got_memory(mi)) {
        ret encode_through_got(st, f, fn_base, mi);
    }
    ret encode_selected(st, f, fn_base, mi);
}

fun encode_selected(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val opcode: u16 = mi.opcode::u16;

    if (mi.opcode == lang_mir.MIR_MUL_WIDE_S || mi.opcode == lang_mir.MIR_MUL_WIDE_U) {
        ret encode_vector_widen_mul(f, mi, ?st.buf);
    }
    if (mi.opcode == lang_mir.MIR_VEC_WIDEN_S || mi.opcode == lang_mir.MIR_VEC_WIDEN_U) {
        ret encode_vector_widen_half(st, f, mi);
    }
    if (mi.opcode == lang_mir.MIR_VEC_RANGE) {
        ret encode_vector_range(st, f, mi);
    }
    if (mi.opcode == lang_mir.MIR_VEC_WIDEN_SUM_U) {
        ret encode_vector_widen_sum(f, mi, ?st.buf);
    }
    if (mi.opcode == lang_mir.MIR_VEC_SIGN_MASK) {
        ret encode_vector_sign_mask(f, mi, ?st.buf);
    }
    if (mi.opcode == lang_mir.MIR_VEC_CONCAT) {
        ret encode_vector_concat(f, mi, ?st.buf);
    }
    if (mi.opcode == lang_mir.MIR_VEC_INTERLEAVE) {
        ret encode_vector_interleave(f, mi, ?st.buf);
    }
    if (lang_mir.vec_lane_is_vector(mi.vec_lane) && (mi.opcode == lang_mir.MIR_MUL_HI_S || mi.opcode == lang_mir.MIR_MUL_HI_U)) {
        ret encode_vector_arith(st, f, mi);
    }
    if (lang_mir.vec_lane_is_vector(mi.vec_lane) && is_selected_vector_alu(mi.opcode)) {
        ret encode_vector_op(st, f, mi);
    }
    if (lang_mir.vec_lane_is_convert(mi.vec_lane)) {
        ret encode_vector_convert(st, f, mi);
    }

    if (common.is_mir_compare(mi.opcode)) {
        ret encode_compare(f, mi, ?st.buf);
    }
    if (mi.opcode == lang_mir.MIR_SEL_MASK_LT_U) {
        ret encode_compare_mask(f, mi, ?st.buf);
    }
    if (mi.opcode == lang_mir.MIR_SEL_SELECT || mi.opcode == lang_mir.MIR_SEL_SELECT_CMP) {
        ret encode_select(f, mi, ?st.buf);
    }

    if (common.is_mir_float_arith(mi.opcode)) {
        ret encode_float_arith(st, f, mi);
    }
    if (mi.opcode == lang_mir.MIR_FCMP) {
        ret encode_float_cmp(st, f, mi);
    }
    if (mi.opcode == lang_mir.MIR_FNEG) {
        ret encode_float_neg(st, f, mi);
    }

    if (common.is_mir_float_conv(mi.opcode)) {
        ret encode_float_conv(st, f, mi);
    }

    if (is_float_const_move(f, mi)) {
        ret encode_float_const_mov(st, f, mi);
    }

    if (common.is_mir_divide(mi.opcode)) {
        ret encode_divide(f, mi, ?st.buf);
    }

    if (is_mir_mul_pair(mi.opcode)) {
        ret encode_mul_pair(f, mi, ?st.buf);
    }

    if (is_mir_binary(mi.opcode)) {
        ret encode_binary(f, mi, ?st.buf);
    }

    if (is_mir_shift(mi.opcode)) {
        ret encode_shift_mir(f, mi, ?st.buf);
    }

    if (is_mir_unary(mi.opcode)) {
        ret encode_unary_mir(f, mi, ?st.buf);
    }

    if (mi.opcode == lang_mir.MIR_SEL_CBR) {
        ret encode_cbr(st, f, fn_base, mi);
    }

    if (lang_mir.is_fused_cbr(mi.opcode)) {
        ret encode_fused_cbr(st, f, fn_base, mi);
    }

    if (opcode == x64.JMP::u16) {
        var jt:      u32          = 0;
        var jhas:    bool         = false;
        var jsym:    intern.StrId = intern.STR_NIL;
        var jhsym:   bool         = false;
        var jaddend: i64          = 0;
        isa_encode.classify_refs(mi, ?jt, ?jhas, ?jsym, ?jhsym, ?jaddend);
        if (jhas && isa_encode.branch_falls_through(st, jt)) { ret err[fail.Fail].ok{}; }
    }

    if (opcode == x64.ASM_BLOCK::u16) {
        ret x64_grammar.encode_asm_block(st, f, fn_base, mi);
    }

    if (is_got_addr(mi)) {
        ret encode_got_addr(st, f, mi);
    }

    var inst: isa_inst.Inst  = isa_inst.inst_blank();
    val ti:   err[fail.Fail] = mir_to_inst(f, mi, ?inst);
    if (sel ti.err) { ret ti; }

    var target_block: u32          = 0;
    var has_block:    bool         = false;
    var sym:          intern.StrId = intern.STR_NIL;
    var has_sym:      bool         = false;
    var sym_addend:   i64          = 0;
    isa_encode.classify_refs(mi, ?target_block, ?has_block, ?sym, ?has_sym, ?sym_addend);

    # a symbol source staged ahead of a memory destination carries its patch
    # site in the staging load, so that load is placed as its own instruction
    if (has_sym && x64_emit.is_rip_mem(?inst.src1) && x64_emit.staged_source(?inst)) {
        val staged: opt[isa_inst.Inst] = x64_emit.staging_load(?inst);
        if (sel staged.some) {
            var ld:     isa_inst.Inst  = staged.some;
            val placed: err[fail.Fail] = place_sym_inst(st, f, mi, ?ld, sym, sym_addend);
            if (sel placed.err) { ret placed; }
            inst.src1 = ld.dst;
            has_sym   = false;
        }
    }

    val inst_start: usize = st.buf.bytes.len;
    val inst_size:  i32   = x64_emit.encode_inst(?inst, ?st.buf);
    if (inst_size <= 0) {
        val failure: err[fail.Fail] = isa_encode.opcode_failure(st, f, "x64", mi.opcode);
        if (sel failure.err) { ret err[fail.Fail].err{failure.err}; }
        ret err[fail.Fail].ok{};
    }

    if (has_block) {
        val reloc_off: i32 = x64_emit.reloc_offset(nil, ?inst, inst_size);
        if (reloc_off < 0) {
            ret err[fail.Fail].err{fail.message("encode: block-referencing instruction has no relocation patch site")};
        }
        val patch_pos: u32            = (inst_start + reloc_off::usize)::u32;
        val next_ip:   u32            = (inst_start + inst_size::usize)::u32;
        val pushed:    err[fail.Fail] = isa_encode.push_fixup(st, patch_pos, next_ip, target_block, fn_base);
        if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
        ret err[fail.Fail].ok{};
    }

    if (has_sym) {
        ret sym_reloc(st, ?inst, inst_start, inst_size, sym, sym_addend);
    }

    ret err[fail.Fail].ok{};
}

# one machine instruction naming a symbol, encoded with its relocation
fun place_sym_inst(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, inst: *isa_inst.Inst,
    sym: intern.StrId, sym_addend: i64) err[fail.Fail] {
    val inst_start: usize = st.buf.bytes.len;
    val inst_size:  i32   = x64_emit.encode_inst(inst, ?st.buf);
    if (inst_size <= 0) { ret isa_encode.opcode_failure(st, f, "x64", mi.opcode); }
    ret sym_reloc(st, inst, inst_start, inst_size, sym, sym_addend);
}

fun sym_reloc(st: *isa_encode.EncodeState, inst: *isa_inst.Inst, inst_start: usize, inst_size: i32,
    sym: intern.StrId, sym_addend: i64) err[fail.Fail] {
    if (intern.str_is_nil(sym)) {
        ret err[fail.Fail].err{fail.message("encode: symbol-referencing instruction has no resolved symbol name")};
    }
    val reloc_off: i32 = x64_emit.reloc_offset(nil, inst, inst_size);
    if (reloc_off < 0) {
        ret err[fail.Fail].err{fail.message("encode: symbol-referencing instruction has no relocation patch site")};
    }
    val patch_pos: u32                 = (inst_start + reloc_off::usize)::u32;
    var kind:      target_of.RelocKind = target_of.RK_PC32;
    var addend:    i64                 = sym_addend - (inst_size - reloc_off)::i64;
    if (inst.opcode == x64.MOVABS::u16) {
        kind   = target_of.RK_ABS64;
        addend = sym_addend;
    }
    ret isa_encode.push_inst_reloc(st, patch_pos, kind, sym, addend, (inst_size - reloc_off)::u8);
}

fun is_got_addr(mi: *lang_mir.MirInstr) bool {
    ret mi.opcode == x64.LEA::u32 && mi.operand_count >= 2
        && mi.operands[1].kind == lang_mir.MIR_OP_SYM && mi.operands[1].sym_got;
}

# a marked symbol operand that names memory rather than an address: a call or
# jump target is the symbol's address, and so is an address-of, which
# encode_got_addr reads from the slot itself
fun reads_got_memory(mi: *lang_mir.MirInstr) bool {
    if (mi.opcode == lang_mir.MIR_CALL || mi.opcode == x64.CALL::u32 || mi.opcode == x64.JMP::u32
        || mi.opcode == x64.ASM_BLOCK::u32 || is_got_addr(mi)) {
        ret false;
    }
    var k: u32 = 0;
    for (k < mi.operand_count) {
        if (mi.operands[k].kind == lang_mir.MIR_OP_SYM && mi.operands[k].sym_got) { ret true; }
        k = k + 1;
    }
    ret false;
}

# an import's slot address in reg: mov r64, [rip + sym@GOTPCREL]
fun emit_got_load(st: *isa_encode.EncodeState, reg: isa_inst.Operand, sym: intern.StrId) err[fail.Fail] {
    if (intern.str_is_nil(sym)) {
        ret err[fail.Fail].err{fail.message("encode: GOT slot load has no resolved symbol name")};
    }
    var load: isa_inst.Inst = isa_inst.inst_blank();
    load.opcode       = x64.MOV;
    load.dst          = reg;
    load.src1         = isa_inst.make_mem(isa_inst.REG_NONE, 0, isa_inst.REG_NONE, 0, 8);
    load.src1.sym_id  = intern.str_index(sym);
    load.src1.sym_mod = isa_inst.SYM_MOD_GOT;
    load.size         = 8;
    val start: usize = st.buf.bytes.len;
    val n:     i32   = x64_emit.encode_inst(?load, ?st.buf);
    if (n <= 0) { ret err[fail.Fail].err{fail.message("encode: a GOT slot load produced no bytes")}; }
    val patch: i32 = x64_emit.reloc_offset(nil, ?load, n);
    if (patch < 0) {
        ret err[fail.Fail].err{fail.message("encode: a GOT slot load has no relocation patch site")};
    }
    ret isa_encode.push_inst_reloc(st, (start + patch::usize)::u32, target_of.RK_GOTPCREL, sym,
        -(n - patch)::i64, (n - patch)::u8);
}

# an instruction whose memory operand is an import, accessed through its GOT
# slot: each slot's address is loaded into a scratch no operand names, and the
# instruction encodes against [scratch + offset]
fun encode_through_got(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count > GOT_OPERAND_MAX) {
        ret err[fail.Fail].err{fail.message("encode: an x86-64 instruction reading an import through its GOT slot has too many operands")};
    }
    var ops:  [GOT_OPERAND_MAX]lang_mir.MirOperand;
    var used: [2]i32 = [2]i32{isa_inst.REG_NONE, isa_inst.REG_NONE};
    var k:    u32    = 0;
    for (k < mi.operand_count) {
        ops[k] = mi.operands[k];
        k      = k + 1;
    }
    k = 0;
    for (k < mi.operand_count) {
        if (ops[k].kind == lang_mir.MIR_OP_SYM && ops[k].sym_got) {
            val sr: res[i32, fail.Fail] = got_scratch(f, mi, ?used[0]);
            if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
            val ld: err[fail.Fail] = emit_got_load(st, isa_inst.make_reg(sr.ok, 8), ops[k].sym);
            if (sel ld.err) { ret ld; }
            ops[k] = lang_mir.op_mem_preg(lang_mir.preg_id(sr.ok), ops[k].sym_off);
        }
        k = k + 1;
    }
    var via: lang_mir.MirInstr = @mi;
    via.operands = ?ops[0];
    ret encode_selected(st, f, fn_base, ?via);
}

val GOT_OPERAND_MAX: u32 = 4;

# r11, else r10: a scratch the instruction names in no operand and no earlier
# slot load of it took
fun got_scratch(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, used: *i32) res[i32, fail.Fail] {
    val cands: [2]i32 = [2]i32{x64.SCRATCH_REG, x64.SCRATCH_REG2};
    var c:     u32    = 0;
    for (c < 2) {
        val reg:  i32  = cands[c];
        var free: bool = used[0] != reg && used[1] != reg;
        var k:    u32  = 0;
        for (free && k < mi.operand_count) {
            val o: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[k], 8);
            if (sel o.err)                                { ret res[i32, fail.Fail].err{o.err}; }
            if (x64_emit.operand_touches_reg(?o.ok, reg)) { free = false; }
            k = k + 1;
        }
        if (free) {
            if (used[0] == isa_inst.REG_NONE) { used[0] = reg; }
            or                                { used[1] = reg; }
            ret res[i32, fail.Fail].ok{reg};
        }
        c = c + 1;
    }
    ret res[i32, fail.Fail].err{fail.message("encode: no x86-64 scratch register is free to read an import through its GOT slot")};
}

# an import's address, read from its GOT slot: mov r64, [rip + sym@GOTPCREL],
# then the operand's offset added
fun encode_got_addr(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val symop: *lang_mir.MirOperand             = ?mi.operands[1];
    val dr:    res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 8);
    if (sel dr.err) { ret err[fail.Fail].err{dr.err}; }
    val ld: err[fail.Fail] = emit_got_load(st, dr.ok, symop.sym);
    if (sel ld.err)         { ret ld; }
    if (symop.sym_off == 0) { ret err[fail.Fail].ok{}; }
    if (!target_model.offset_fits(32, symop.sym_off)) {
        ret err[fail.Fail].err{fail.message("encode: x86-64 GOT address offset does not fit a signed 32-bit immediate")};
    }
    var add: isa_inst.Inst = isa_inst.inst_blank();
    add.opcode = x64.ADD;
    add.dst    = dr.ok;
    add.src1   = isa_inst.make_imm(symop.sym_off, 4);
    add.size   = 8;
    if (x64_emit.encode_inst(?add, ?st.buf) <= 0) {
        ret err[fail.Fail].err{fail.message("encode: a GOT address offset produced no bytes")};
    }
    ret err[fail.Fail].ok{};
}

fun mir_setcc_opcode(op: lang_mir.MirOpcode) u16 {
    if (op == lang_mir.MIR_SEL_CMP_EQ)   { ret x64.SETE; }
    if (op == lang_mir.MIR_SEL_CMP_NE)   { ret x64.SETNE; }
    if (op == lang_mir.MIR_SEL_CMP_LT_S) { ret x64.SETL; }
    if (op == lang_mir.MIR_SEL_CMP_LT_U) { ret x64.SETB; }
    if (op == lang_mir.MIR_SEL_CMP_LE_S) { ret x64.SETLE; }
    ret x64.SETBE;
}

# a flags consumer emitted directly after its producer: both rows are read
# from the table, so the pairing is a stated fact and not an assumption
# about adjacency
fun flags_pair(producer: u16, consumer: u16) err[fail.Fail] {
    val p: ct.AsmClass = x64_inst.describe(producer).cls;
    val c: ct.AsmClass = x64_inst.describe(consumer).cls;
    if (!p.known || !p.defines_flags) {
        ret err[fail.Fail].err{fail.message("internal compiler error: x86-64 flags producer does not define the flags its consumer reads")};
    }
    if (!c.known || !(c.reads_flags || c.cond_flags)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: x86-64 flags consumer does not read the flags its producer defines")};
    }
    ret err[fail.Fail].ok{};
}

# an instruction emitted between a flags producer and its consumer must
# leave the flags alone, by its row
fun flags_kept(op: u16) err[fail.Fail] {
    val c: ct.AsmClass = x64_inst.describe(op).cls;
    if (!c.known || !c.flags_stated || c.writes_flags) {
        ret err[fail.Fail].err{fail.message("internal compiler error: x86-64 instruction between a flags producer and its consumer writes the flags")};
    }
    ret err[fail.Fail].ok{};
}

# emits the compare and answers the opcode that defined the flags
fun emit_flag_cmp(f: *lang_mir.MirFunction, lhs_op: *lang_mir.MirOperand, rhs_op: *lang_mir.MirOperand,
    width: u8, buf: *isa_encode.ByteBuf) res[u16, fail.Fail] {
    val cwidth: u8                               = effective_width(width);
    val rl:     res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, lhs_op, cwidth);
    if (sel rl.err) { ret res[u16, fail.Fail].err{rl.err}; }
    val lhs: isa_inst.Operand                 = rl.ok;
    val rr:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, rhs_op, cwidth);
    if (sel rr.err) { ret res[u16, fail.Fail].err{rr.err}; }
    val rhs: isa_inst.Operand = rr.ok;

    var cmp_lhs: isa_inst.Operand = lhs;
    if (cmp_lhs.kind == isa_inst.OPK_IMM) {
        # the right side may address memory through a scratch, a GOT slot's
        val scratch: i32 = x64_emit.pick_stage_scratch(?rhs, nil);
        if (scratch == isa_inst.REG_NONE) {
            ret res[u16, fail.Fail].err{fail.message("encode: no x86-64 scratch register is free to stage a compare's immediate")};
        }
        var ld: isa_inst.Inst = isa_inst.inst_blank();
        ld.opcode = x64.MOV;
        ld.dst    = isa_inst.make_reg(scratch, cwidth);
        ld.src1   = lhs;
        ld.size   = cwidth;
        ld.flags  = width_flags(width);
        x64_emit.encode_inst(?ld, buf);
        cmp_lhs = isa_inst.make_reg(scratch, cwidth);
    }

    var cmp: isa_inst.Inst = isa_inst.inst_blank();
    cmp.opcode = x64.CMP;
    cmp.dst    = cmp_lhs;
    cmp.src1   = rhs;
    cmp.size   = cwidth;
    cmp.flags  = width_flags(width);
    x64_emit.encode_inst(?cmp, buf);
    ret res[u16, fail.Fail].ok{cmp.opcode};
}

fun encode_compare(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: comparison missing operands")};
    }
    val cwidth: u8                               = effective_width(mi.width);
    val rd:     res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], cwidth);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa_inst.Operand = rd.ok;

    val rc: res[u16, fail.Fail] = emit_flag_cmp(f, ?mi.operands[1], ?mi.operands[2], mi.width, buf);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    var setcc: isa_inst.Inst = isa_inst.inst_blank();
    setcc.opcode = mir_setcc_opcode(mi.opcode);
    val fp: err[fail.Fail] = flags_pair(rc.ok, setcc.opcode);
    if (sel fp.err) { ret fp; }
    setcc.dst      = dst;
    setcc.dst.size = 1;
    setcc.size     = 1;
    x64_emit.encode_inst(?setcc, buf);

    var movzx: isa_inst.Inst = isa_inst.inst_blank();
    movzx.opcode    = x64.MOVZX;
    movzx.dst       = dst;
    movzx.dst.size  = DEFAULT_OPERAND_SIZE;
    movzx.src1      = dst;
    movzx.src1.size = 1;
    movzx.size      = DEFAULT_OPERAND_SIZE;
    movzx.flags     = x64_inst.FLAG_REX_W;
    x64_emit.encode_inst(?movzx, buf);

    ret err[fail.Fail].ok{};
}

# `cmp a, b` leaves the carry set exactly when a is below b unsigned, and
# `sbb d, d` spreads it into all ones or zero
fun encode_compare_mask(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: compare-to-mask missing operands")};
    }
    var size: u8 = 4;
    if (effective_width(mi.width) >= 8) { size = 8; }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], size);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa_inst.Operand = rd.ok;
    if (dst.kind != isa_inst.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: compare-to-mask destination is not a register")};
    }

    val rc: res[u16, fail.Fail] = emit_flag_cmp(f, ?mi.operands[1], ?mi.operands[2], mi.src_width, buf);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val fp: err[fail.Fail] = flags_pair(rc.ok, x64.SBB);
    if (sel fp.err) { ret fp; }

    var sbb: isa_inst.Inst = isa_inst.inst_blank();
    sbb.opcode = x64.SBB;
    sbb.dst    = dst;
    sbb.src1   = dst;
    sbb.size   = size;
    sbb.flags  = width_flags(size);
    x64_emit.encode_inst(?sbb, buf);
    ret err[fail.Fail].ok{};
}

# the cmov that moves when an integer compare holds
fun cmov_of_compare(op: lang_mir.MirOpcode) res[u16, fail.Fail] {
    if (op == lang_mir.MIR_CMP_EQ)   { ret res[u16, fail.Fail].ok{x64.CMOVE}; }
    if (op == lang_mir.MIR_CMP_NE)   { ret res[u16, fail.Fail].ok{x64.CMOVNE}; }
    if (op == lang_mir.MIR_CMP_LT_S) { ret res[u16, fail.Fail].ok{x64.CMOVL}; }
    if (op == lang_mir.MIR_CMP_LT_U) { ret res[u16, fail.Fail].ok{x64.CMOVB}; }
    if (op == lang_mir.MIR_CMP_LE_S) { ret res[u16, fail.Fail].ok{x64.CMOVLE}; }
    if (op == lang_mir.MIR_CMP_LE_U) { ret res[u16, fail.Fail].ok{x64.CMOVBE}; }
    ret res[u16, fail.Fail].err{fail.message("encode: a select names no integer compare")};
}

# the cmov on the opposite condition
fun cmov_inverse(op: u16) u16 {
    if (op == x64.CMOVE)  { ret x64.CMOVNE; }
    if (op == x64.CMOVNE) { ret x64.CMOVE; }
    if (op == x64.CMOVL)  { ret x64.CMOVGE; }
    if (op == x64.CMOVGE) { ret x64.CMOVL; }
    if (op == x64.CMOVLE) { ret x64.CMOVG; }
    if (op == x64.CMOVG)  { ret x64.CMOVLE; }
    if (op == x64.CMOVB)  { ret x64.CMOVAE; }
    if (op == x64.CMOVAE) { ret x64.CMOVB; }
    if (op == x64.CMOVBE) { ret x64.CMOVA; }
    ret x64.CMOVBE;
}

# a select: the flags come from the folded compare, or from a test of
# the condition, and a cmov moves the chosen value into the destination with
# no branch, so a secret condition is never a taken path. the destination
# first takes the other choice, unless it already holds one choice, in which
# case it keeps it and moves the other on the condition that picks it, so no
# choice is overwritten before it is read
fun encode_select(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val fused: bool = mi.opcode == lang_mir.MIR_SEL_SELECT_CMP;
    var need:  u32  = 4;
    if (fused) { need = 6; }
    if (mi.operand_count < need) {
        ret err[fail.Fail].err{fail.message("encode: select missing operands")};
    }
    var size: u8 = 4;
    if (effective_width(mi.width) >= 8) { size = 8; }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], size);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa_inst.Operand = rd.ok;
    if (dst.kind != isa_inst.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: select destination is not a register")};
    }
    var ai: u32 = 2;
    if (fused) { ai = 3; }
    val ra: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[ai], size);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val rb: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[ai + 1], size);
    if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
    val a: isa_inst.Operand = ra.ok;
    val b: isa_inst.Operand = rb.ok;
    if ((a.kind != isa_inst.OPK_REG && a.kind != isa_inst.OPK_MEM) || (b.kind != isa_inst.OPK_REG && b.kind != isa_inst.OPK_MEM)) {
        ret err[fail.Fail].err{fail.message("encode: a select choice is neither a register nor a frame slot")};
    }

    var producer: u16 = x64.TEST;
    var take_a:   u16 = x64.CMOVNE;
    if (fused) {
        val rc: res[u16, fail.Fail] = emit_flag_cmp(f, ?mi.operands[1], ?mi.operands[2], mi.src_width, buf);
        if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
        producer = rc.ok;
        val cm: res[u16, fail.Fail] = cmov_of_compare(mi.operands[5].imm::lang_mir.MirOpcode);
        if (sel cm.err) { ret err[fail.Fail].err{cm.err}; }
        take_a = cm.ok;
    }
    or {
        val cwidth: u8                               = effective_width(mi.src_width);
        val rc:     res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], cwidth);
        if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
        if (rc.ok.kind != isa_inst.OPK_REG) {
            ret err[fail.Fail].err{fail.message("encode: select condition is not a register")};
        }
        var t: isa_inst.Inst = isa_inst.inst_blank();
        t.opcode = x64.TEST;
        t.dst    = rc.ok;
        t.src1   = rc.ok;
        t.size   = cwidth;
        t.flags  = width_flags(mi.src_width);
        x64_emit.encode_inst(?t, buf);
    }

    var move:  isa_inst.Operand = a;
    var cmove: u16              = take_a;
    if (b.kind == isa_inst.OPK_REG && b.reg == dst.reg) {}
    or (a.kind == isa_inst.OPK_REG && a.reg == dst.reg) {
        move  = b;
        cmove = cmov_inverse(take_a);
    }
    or {
        val fk: err[fail.Fail] = flags_kept(x64.MOV);
        if (sel fk.err) { ret fk; }
        var mv: isa_inst.Inst = isa_inst.inst_blank();
        mv.opcode = x64.MOV;
        mv.dst    = dst;
        mv.src1   = b;
        mv.size   = size;
        mv.flags  = width_flags(size);
        x64_emit.encode_inst(?mv, buf);
    }
    val fp: err[fail.Fail] = flags_pair(producer, cmove);
    if (sel fp.err) { ret fp; }
    var cm: isa_inst.Inst = isa_inst.inst_blank();
    cm.opcode = cmove;
    cm.dst    = dst;
    cm.src1   = move;
    cm.size   = size;
    cm.flags  = width_flags(size);
    if (x64_emit.encode_inst(?cm, buf) <= 0) {
        ret err[fail.Fail].err{fail.message("encode: select cmov failed to encode")};
    }
    ret err[fail.Fail].ok{};
}

fun float_scratch1() i32 {
    ret x64.XMM15;
}

fun float_alu_opcode(op: lang_mir.MirOpcode, w: u8) u16 {
    if (op == lang_mir.MIR_FADD) {
        if (w == 4) { ret x64.ADDSS; }
        ret x64.ADDSD;
    }
    if (op == lang_mir.MIR_FSUB) {
        if (w == 4) { ret x64.SUBSS; }
        ret x64.SUBSD;
    }
    if (op == lang_mir.MIR_FMUL) {
        if (w == 4) { ret x64.MULSS; }
        ret x64.MULSD;
    }
    if (w == 4) { ret x64.DIVSS; }
    ret x64.DIVSD;
}

fun emit_float_load(st: *isa_encode.EncodeState, op: isa_inst.Operand, xmm: i32, w: u8) err[fail.Fail] {
    if (w == 2 && op.kind == isa_inst.OPK_IMM) {
        # an f16 constant is the low word of a binary32 pool entry
        ret emit_float_load(st, isa_inst.make_imm((op.imm::u64 & 0xFFFF)::i64, 4), xmm, 4);
    }
    if (w == 2) { ret x64_emit.half_move(isa_inst.make_reg(xmm, 16), op, ?st.buf); }
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float load has a non-float access width (expected 4 or 8)")};
    }
    if (op.kind != isa_inst.OPK_IMM) { ret x64_emit.float_reg_or_slot_load(op, xmm, w, ?st.buf); }

    val cr: res[isa_inst.Operand, fail.Fail] = float_const_operand(st, op.imm::u64, xmm, w);
    if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
    val src: isa_inst.Operand = cr.ok;
    if (src.kind == isa_inst.OPK_NONE) { ret err[fail.Fail].ok{}; }

    var mov_op: u16 = x64.MOVSD;
    if (w == 4) { mov_op = x64.MOVSS; }
    var ld: isa_inst.Inst = isa_inst.inst_blank();
    ld.opcode = mov_op;
    ld.dst    = isa_inst.make_reg(xmm, 16);
    ld.src1   = src;
    ld.size   = w;
    ret encode_inst_sym(st, ?ld);
}

fun float_const_operand(st: *isa_encode.EncodeState, bits: u64, zero_reg: i32, w: u8) res[isa_inst.Operand, fail.Fail] {
    if (!common.is_float_width(w)) {
        ret res[isa_inst.Operand, fail.Fail].err{fail.message("internal compiler error: float constant has a non-float width (expected 4 or 8)")};
    }
    var pattern: u64 = bits;
    if (w == 4) { pattern = bits & 0xFFFFFFFF; }

    if (pattern == 0) {
        var zero: isa_inst.Inst = isa_inst.inst_blank();
        zero.opcode = x64.XORPS;
        zero.dst    = isa_inst.make_reg(zero_reg, 16);
        zero.src1   = isa_inst.make_reg(zero_reg, 16);
        zero.size   = 16;
        x64_emit.encode_inst(?zero, ?st.buf);
        ret res[isa_inst.Operand, fail.Fail].ok{isa_inst.make_none()};
    }

    val sr: res[intern.StrId, fail.Fail] = isa_encode.intern_float_const(st, pattern, w);
    if (sel sr.err) { ret res[isa_inst.Operand, fail.Fail].err{sr.err}; }

    var mem: isa_inst.Operand = isa_inst.make_mem(isa_inst.REG_NONE, 0, isa_inst.REG_NONE, 0, w);
    mem.sym_id = intern.str_index(sr.ok);
    ret res[isa_inst.Operand, fail.Fail].ok{mem};
}

fun const_ref_sym(op: *isa_inst.Operand) intern.StrId {
    if (x64_emit.is_rip_mem(op)) { ret intern.str_id(op.sym_id); }
    ret intern.STR_NIL;
}

fun encode_inst_sym(st: *isa_encode.EncodeState, mi: *isa_inst.Inst) err[fail.Fail] {
    val start: usize = st.buf.bytes.len;
    val n:     i32   = x64_emit.encode_inst(mi, ?st.buf);
    if (n <= 0) {
        ret err[fail.Fail].err{fail.message("encode: a constant-pool reference produced no bytes")};
    }

    var sym: intern.StrId = const_ref_sym(?mi.dst);
    if (intern.str_is_nil(sym)) { sym = const_ref_sym(?mi.src1); }
    if (intern.str_is_nil(sym)) { ret err[fail.Fail].ok{}; }

    val reloc_off: i32 = x64_emit.reloc_offset(nil, mi, n);
    if (reloc_off < 0) {
        ret err[fail.Fail].err{fail.message("encode: a symbol-naming instruction has no relocation patch site")};
    }
    val reloc: err[fail.Fail] = isa_encode.push_inst_reloc(st, (start + reloc_off::usize)::u32, target_of.RK_PC32, sym,
        -(n - reloc_off)::i64, (n - reloc_off)::u8);
    if (sel reloc.err) { ret err[fail.Fail].err{reloc.err}; }
    ret err[fail.Fail].ok{};
}

fun is_float_const_move(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) bool {
    if (mi.opcode::u16 != x64.MOV::u16) { ret false; }
    if (mi.operand_count < 2)           { ret false; }
    val dst: *lang_mir.MirOperand = ?mi.operands[0];
    val src: *lang_mir.MirOperand = ?mi.operands[1];
    if (src.kind != lang_mir.MIR_OP_IMM)  { ret false; }
    if (dst.kind != lang_mir.MIR_OP_PREG) { ret false; }
    ret isa_inst.regid_class(lang_mir.preg_regid(dst.preg)) == isa_inst.REG_CLASS_ID_FP;
}

fun encode_float_const_mov(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val w: u8 = mi.width;
    # the zero vector a const materializes is a cleared register
    if (w == x64_emit.VB_XMM || w == x64_emit.VB_YMM) {
        if (mi.operands[1].imm != 0) {
            ret err[fail.Fail].err{fail.message("encode: a vector constant move takes no immediate but zero")};
        }
        ret x64_emit.vec_zero(lang_mir.preg_regid(mi.operands[0].preg), w, ?st.buf);
    }
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float constant move has a non-float operand width (expected 4 or 8)")};
    }
    ret emit_float_load(st, isa_inst.make_imm(mi.operands[1].imm, w),
        lang_mir.preg_regid(mi.operands[0].preg), w);
}

fun float_work_reg(dst: isa_inst.Operand) i32 {
    if (dst.kind == isa_inst.OPK_REG) { ret dst.reg; }
    ret x64_emit.float_scratch0();
}

fun emit_float_seed(st: *isa_encode.EncodeState, op: isa_inst.Operand, xmm: i32, w: u8) err[fail.Fail] {
    if (op.kind == isa_inst.OPK_REG && op.reg == xmm) { ret err[fail.Fail].ok{}; }
    ret emit_float_load(st, op, xmm, w);
}

fun float_src_operand(st: *isa_encode.EncodeState, op: isa_inst.Operand, scratch: i32, w: u8) res[isa_inst.Operand, fail.Fail] {
    if (op.kind == isa_inst.OPK_REG || op.kind == isa_inst.OPK_MEM) { ret res[isa_inst.Operand, fail.Fail].ok{op}; }
    if (op.kind == isa_inst.OPK_IMM) {
        val cr: res[isa_inst.Operand, fail.Fail] = float_const_operand(st, op.imm::u64, scratch, w);
        if (sel cr.err) { ret cr; }
        val c: isa_inst.Operand = cr.ok;
        if (c.kind == isa_inst.OPK_NONE) { ret res[isa_inst.Operand, fail.Fail].ok{isa_inst.make_reg(scratch, 16)}; }
        ret res[isa_inst.Operand, fail.Fail].ok{c};
    }

    val ld: err[fail.Fail] = emit_float_load(st, op, scratch, w);
    if (sel ld.err) { ret res[isa_inst.Operand, fail.Fail].err{ld.err}; }
    ret res[isa_inst.Operand, fail.Fail].ok{isa_inst.make_reg(scratch, 16)};
}

# the scalar float arithmetic and compare read their second source, a
# constant there included, as the r/m operand: a constant is one pool
# reference inside the instruction. a compare's second source is its
# right operand, or its left where the condition swaps them
pub fun reads_const_operand(mi: *lang_mir.MirInstr, index: u32) bool {
    if (mi.operand_count != 3 || lang_mir.vec_lane_is_vector(mi.vec_lane) || !common.is_float_width(mi.width)) { ret false; }
    if (common.is_mir_float_arith(mi.opcode))                                                                  { ret index == 2; }
    if (mi.opcode != lang_mir.MIR_FCMP)                                                                        { ret false; }
    if (float_cmp_swap(mi.src_width))                                                                          { ret index == 1; }
    ret index == 2;
}

fun float_rhs_operand(st: *isa_encode.EncodeState, rhs: isa_inst.Operand, work: i32, w: u8) res[isa_inst.Operand, fail.Fail] {
    if (rhs.kind == isa_inst.OPK_REG && rhs.reg == work) {
        val ld: err[fail.Fail] = emit_float_load(st, rhs, float_scratch1(), w);
        if (sel ld.err) { ret res[isa_inst.Operand, fail.Fail].err{ld.err}; }
        ret res[isa_inst.Operand, fail.Fail].ok{isa_inst.make_reg(float_scratch1(), 16)};
    }
    ret float_src_operand(st, rhs, float_scratch1(), w);
}

fun float_reg_operand(st: *isa_encode.EncodeState, op: isa_inst.Operand, scratch: i32, w: u8) res[i32, fail.Fail] {
    if (op.kind == isa_inst.OPK_REG) { ret res[i32, fail.Fail].ok{op.reg}; }

    val ld: err[fail.Fail] = emit_float_load(st, op, scratch, w);
    if (sel ld.err) { ret res[i32, fail.Fail].err{ld.err}; }
    ret res[i32, fail.Fail].ok{scratch};
}

# the f16c conversions: vcvtph2ps widens the f16 in the source's low half to
# binary32, and vcvtps2ph rounds binary32 to f16 to nearest even (immediate
# 0) into the destination's low half. `vb` is the binary32 side's width: four
# lanes at 16 bytes and eight at 32, the f16 side then the xmm register. a
# scalar f16 is lane 0 of each
fun emit_f16c(widen: bool, dst_xmm: i32, src_xmm: i32, vb: u8, buf: *isa_encode.ByteBuf) {
    val start: usize = buf.bytes.len;
    if (widen) {
        x64_emit.vex_rm(x64_emit.OpMap{prefix: 0x66, map: 0x38, opbyte: 0x13, w: 0}, x64_emit.vex_l(vb), dst_xmm, isa_inst.REG_NONE, x64_emit.vec_reg(src_xmm, x64_emit.VB_XMM), buf);
        x64_emit.note_vec(buf, start, x64.VCVTPH2PS, 0, x64_emit.vec_reg(dst_xmm, vb), x64_emit.vec_reg(src_xmm, x64_emit.VB_XMM), isa_inst.make_none(), isa_inst.make_none(), vb);
        ret;
    }
    x64_emit.vex_rm(x64_emit.OpMap{prefix: 0x66, map: 0x3A, opbyte: 0x1D, w: 0}, x64_emit.vex_l(vb), src_xmm, isa_inst.REG_NONE, x64_emit.vec_reg(dst_xmm, x64_emit.VB_XMM), buf);
    isa_encode.emit_byte(buf, 0);
    x64_emit.note_vec(buf, start, x64.VCVTPS2PH, 0, x64_emit.vec_reg(dst_xmm, x64_emit.VB_XMM), x64_emit.vec_reg(src_xmm, vb), isa_inst.make_imm(0, 1), isa_inst.make_none(), vb);
}

fun encode_float_arith(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: float arithmetic missing operands")};
    }
    val w: u8 = mi.width;
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float arithmetic has a non-float operand width (expected 4 or 8)")};
    }

    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa_inst.Operand                 = rd.ok;
    val rl:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val lhs: isa_inst.Operand                 = rl.ok;
    val rr:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], w);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    val rhs: isa_inst.Operand = rr.ok;

    val work: i32                 = float_work_reg(dst);
    val buf:  *isa_encode.ByteBuf = ?st.buf;

    val rs: res[isa_inst.Operand, fail.Fail] = float_rhs_operand(st, rhs, work, w);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val src: isa_inst.Operand = rs.ok;

    val sd: err[fail.Fail] = emit_float_seed(st, lhs, work, w);
    if (sel sd.err) { ret sd; }

    var alu: isa_inst.Inst = isa_inst.inst_blank();
    alu.opcode = float_alu_opcode(mi.opcode, w);
    alu.dst    = isa_inst.make_reg(work, 16);
    alu.src1   = src;
    alu.size   = w;
    val ae: err[fail.Fail] = encode_inst_sym(st, ?alu);
    if (sel ae.err) { ret ae; }

    if (dst.kind == isa_inst.OPK_REG) { ret err[fail.Fail].ok{}; }
    ret x64_emit.float_store(dst, work, w, buf);
}

fun float_sign_mask(w: u8) i64 {
    if (w == 4) { ret 0x80000000::i64; }
    ret 0x8000000000000000::i64;
}

fun float_sign_mask_image(w: u8, out: *u8) {
    val m: u64 = float_sign_mask(w)::u64;
    var i: u32 = 0;
    for (i < 16) {
        out[i] = 0;
        i      = i + 1;
    }
    i = 0;
    for (i < 8) {
        out[i] = (m >> (i::u64 * 8::u64))::u8;
        i      = i + 1;
    }
}

fun encode_float_neg(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("encode: float negate missing operands")};
    }
    val w: u8 = mi.width;
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float negate has a non-float operand width (expected 4 or 8)")};
    }

    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa_inst.Operand                 = rd.ok;
    val rs:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val src: isa_inst.Operand = rs.ok;

    val work: i32                 = float_work_reg(dst);
    val buf:  *isa_encode.ByteBuf = ?st.buf;
    val ld:   err[fail.Fail]      = emit_float_seed(st, src, work, w);
    if (sel ld.err) { ret ld; }

    var img: [16]u8;
    float_sign_mask_image(w, ?img[0]);
    val sr: res[intern.StrId, fail.Fail] = isa_encode.intern_const(st, ?img[0], 16, isa_encode.CONST_VEC);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }

    var mem: isa_inst.Operand = isa_inst.make_mem(isa_inst.REG_NONE, 0, isa_inst.REG_NONE, 0, 16);
    mem.sym_id = intern.str_index(sr.ok);

    var xorp: isa_inst.Inst = isa_inst.inst_blank();
    xorp.opcode = x64.XORPS;
    xorp.dst    = isa_inst.make_reg(work, 16);
    xorp.src1   = mem;
    xorp.size   = 16;
    val xr: err[fail.Fail] = encode_inst_sym(st, ?xorp);
    if (sel xr.err) { ret xr; }

    if (dst.kind == isa_inst.OPK_REG) { ret err[fail.Fail].ok{}; }
    ret x64_emit.float_store(dst, work, w, buf);
}

fun emit_gp_store(dst: isa_inst.Operand, gp: i32, w: u8, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (dst.kind == isa_inst.OPK_REG || dst.kind == isa_inst.OPK_MEM) {
        var st: isa_inst.Inst = isa_inst.inst_blank();
        st.opcode = x64.MOV;
        st.dst    = dst;
        st.src1   = isa_inst.make_reg(gp, w);
        st.size   = w;
        st.flags  = width_flags(w);
        x64_emit.encode_inst(?st, buf);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("encode: conversion integer destination is not a register or frame slot")};
}

fun emit_cvt_reg(cvt_op: u16, dst_reg: i32, src_reg: i32, int_w: u8, buf: *isa_encode.ByteBuf) {
    var dst_sz: u8 = 16;
    var src_sz: u8 = 16;
    if (cvt_op == x64.CVTSI2SS || cvt_op == x64.CVTSI2SD)   { src_sz = int_w; }
    if (cvt_op == x64.CVTTSS2SI || cvt_op == x64.CVTTSD2SI) { dst_sz = int_w; }

    var cvt: isa_inst.Inst = isa_inst.inst_blank();
    cvt.opcode = cvt_op;
    cvt.dst    = isa_inst.make_reg(dst_reg, dst_sz);
    cvt.src1   = isa_inst.make_reg(src_reg, src_sz);
    cvt.size   = int_w;
    cvt.flags  = width_flags(int_w);
    x64_emit.encode_inst(?cvt, buf);
}

fun emit_gp_rr8(opcode: u16, dst_reg: i32, src_reg: i32, buf: *isa_encode.ByteBuf) {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = opcode;
    mi.dst    = isa_inst.make_reg(dst_reg, 8);
    mi.src1   = isa_inst.make_reg(src_reg, 8);
    mi.size   = 8;
    mi.flags  = width_flags(8);
    x64_emit.encode_inst(?mi, buf);
}

fun emit_gp_ri8(opcode: u16, dst_reg: i32, imm: i64, buf: *isa_encode.ByteBuf) {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = opcode;
    mi.dst    = isa_inst.make_reg(dst_reg, 8);
    mi.src1   = isa_inst.make_imm(imm, 8);
    mi.size   = 8;
    mi.flags  = width_flags(8);
    x64_emit.encode_inst(?mi, buf);
}

fun emit_fp_rr(opcode: u16, dst_reg: i32, src_reg: i32, w: u8, buf: *isa_encode.ByteBuf) {
    var mi: isa_inst.Inst = isa_inst.inst_blank();
    mi.opcode = opcode;
    mi.dst    = isa_inst.make_reg(dst_reg, 16);
    mi.src1   = isa_inst.make_reg(src_reg, 16);
    mi.size   = w;
    x64_emit.encode_inst(?mi, buf);
}

fun normalize_int_imm(imm: i64, width: u8, signed: bool) i64 {
    if (width >= 8) { ret imm; }
    val bits: u64 = width::u64 * 8;
    val mask: u64 = (1::u64 << bits) - 1;
    var v:    u64 = imm::u64 & mask;
    if (signed) {
        val sign: u64 = 1::u64 << (bits - 1);
        if ((v & sign) != 0) { v = v | ~mask; }
    }
    ret v::i64;
}

fun emit_gp_load_ext(op: isa_inst.Operand, gp: i32, src_w: u8, signed: bool, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (op.kind == isa_inst.OPK_IMM) {
        emit_gp_ri8(x64.MOV, gp, normalize_int_imm(op.imm, src_w, signed), buf);
        ret err[fail.Fail].ok{};
    }
    if (op.kind != isa_inst.OPK_REG && op.kind != isa_inst.OPK_MEM) {
        ret err[fail.Fail].err{fail.message("encode: conversion integer operand is not a register, frame slot, or immediate")};
    }

    var ld: isa_inst.Inst = isa_inst.inst_blank();
    ld.dst       = isa_inst.make_reg(gp, 8);
    ld.src1      = op;
    ld.src1.size = src_w;
    ld.size      = 8;
    ld.flags     = width_flags(8);
    if (src_w >= 8) {
        ld.opcode = x64.MOV;
    }
    or (signed && src_w >= 4) {
        ld.opcode = x64.MOVSXD;
    }
    or (signed) {
        ld.opcode = x64.MOVSX;
    }
    or {
        ld.opcode = x64.MOVZX;
    }
    x64_emit.encode_inst(?ld, buf);
    ret err[fail.Fail].ok{};
}

# the u64 already in `lo` into `work`: halved into `lo` through `hi` when its
# top bit is set, converted, and doubled
fun emit_u64_to_fp(dst: isa_inst.Operand, work: i32, dst_w: u8, cvt_op: u16, lo: i32, hi: i32, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    var test_inst: isa_inst.Inst = isa_inst.inst_blank();
    test_inst.opcode = x64.TEST;
    test_inst.dst    = isa_inst.make_reg(lo, 8);
    test_inst.src1   = isa_inst.make_reg(lo, 8);
    test_inst.size   = 8;
    test_inst.flags  = width_flags(8);
    x64_emit.encode_inst(?test_inst, buf);

    var jl: isa_inst.Inst = isa_inst.inst_blank();
    jl.opcode = x64.JL;
    jl.dst    = isa_inst.make_numbered_local_label(true, 1);
    jl.size   = DEFAULT_OPERAND_SIZE;
    val fp: err[fail.Fail] = flags_pair(test_inst.opcode, jl.opcode);
    if (sel fp.err) { ret fp; }
    x64_emit.encode_inst(?jl, buf);
    val jl_patch: usize = buf.bytes.len - 4;
    val after_jl: usize = buf.bytes.len;

    emit_cvt_reg(cvt_op, work, lo, 8, buf);

    var jmp: isa_inst.Inst = isa_inst.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa_inst.make_numbered_local_label(true, 2);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    x64_emit.encode_inst(?jmp, buf);
    val jmp_patch: usize = buf.bytes.len - 4;
    val after_jmp: usize = buf.bytes.len;

    x64_emit.patch_rel32(buf, jl_patch, (buf.bytes.len - after_jl)::i32);
    x64_printer.note_local_label(buf, 1);
    emit_gp_rr8(x64.MOV, hi, lo, buf);
    emit_gp_ri8(x64.SHR, hi, 1, buf);
    emit_gp_ri8(x64.AND, lo, 1, buf);
    emit_gp_rr8(x64.OR, lo, hi, buf);
    emit_cvt_reg(cvt_op, work, lo, 8, buf);
    var add_op: u16 = x64.ADDSD;
    if (dst_w == 4) { add_op = x64.ADDSS; }
    emit_fp_rr(add_op, work, work, dst_w, buf);

    x64_emit.patch_rel32(buf, jmp_patch, (buf.bytes.len - after_jmp)::i32);
    x64_printer.note_local_label(buf, 2);
    if (dst.kind == isa_inst.OPK_REG) { ret err[fail.Fail].ok{}; }
    ret x64_emit.float_store(dst, work, dst_w, buf);
}

# the float in `src_reg` into the u64 in `lo`, a value past the signed range
# biased back through `hi`
fun emit_fp_to_u64(st: *isa_encode.EncodeState, src_reg: i32, src_w: u8, cvt_op: u16, lo: i32, hi: i32) err[fail.Fail] {
    val buf:        *isa_encode.ByteBuf = ?st.buf;
    var bound_bits: u64                 = 0x43E0000000000000;
    if (src_w == 4) { bound_bits = 0x5F000000; }
    val br: res[isa_inst.Operand, fail.Fail] = float_const_operand(st, bound_bits, float_scratch1(), src_w);
    if (sel br.err) { ret err[fail.Fail].err{br.err}; }
    val bound: isa_inst.Operand = br.ok;

    var ucom: isa_inst.Inst = isa_inst.inst_blank();
    ucom.opcode = x64.UCOMISD;
    if (src_w == 4) { ucom.opcode = x64.UCOMISS; }
    ucom.dst  = isa_inst.make_reg(src_reg, 16);
    ucom.src1 = bound;
    ucom.size = src_w;
    val ue: err[fail.Fail] = encode_inst_sym(st, ?ucom);
    if (sel ue.err) { ret ue; }

    var jb: isa_inst.Inst = isa_inst.inst_blank();
    jb.opcode = x64.JB;
    jb.dst    = isa_inst.make_numbered_local_label(true, 1);
    jb.size   = DEFAULT_OPERAND_SIZE;
    val fp: err[fail.Fail] = flags_pair(ucom.opcode, jb.opcode);
    if (sel fp.err) { ret fp; }
    x64_emit.encode_inst(?jb, buf);
    val jb_patch: usize = buf.bytes.len - 4;
    val after_jb: usize = buf.bytes.len;

    x64_emit.movaps_rr(x64_emit.float_scratch0(), src_reg, x64_emit.VB_XMM, buf);
    var sub: isa_inst.Inst = isa_inst.inst_blank();
    sub.opcode = x64.SUBSD;
    if (src_w == 4) { sub.opcode = x64.SUBSS; }
    sub.dst  = isa_inst.make_reg(x64_emit.float_scratch0(), 16);
    sub.src1 = bound;
    sub.size = src_w;
    val se: err[fail.Fail] = encode_inst_sym(st, ?sub);
    if (sel se.err) { ret se; }
    emit_cvt_reg(cvt_op, lo, x64_emit.float_scratch0(), 8, buf);
    emit_gp_ri8(x64.MOV, hi, (1::u64 << 63)::i64, buf);
    emit_gp_rr8(x64.ADD, lo, hi, buf);

    var jmp: isa_inst.Inst = isa_inst.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa_inst.make_numbered_local_label(true, 2);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    x64_emit.encode_inst(?jmp, buf);
    val jmp_patch: usize = buf.bytes.len - 4;
    val after_jmp: usize = buf.bytes.len;

    x64_emit.patch_rel32(buf, jb_patch, (buf.bytes.len - after_jb)::i32);
    x64_printer.note_local_label(buf, 1);
    emit_cvt_reg(cvt_op, lo, src_reg, 8, buf);

    x64_emit.patch_rel32(buf, jmp_patch, (buf.bytes.len - after_jmp)::i32);
    x64_printer.note_local_label(buf, 2);
    ret err[fail.Fail].ok{};
}

# an f16 widened to binary32 or binary32 rounded to f16, the two cells the
# f16c half rows declare
fun encode_half_conv(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val widen: bool = mi.opcode == lang_mir.MIR_FP_EXT;
    if ((widen && mi.width != 4) || (!widen && mi.src_width != 4)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: an f16 conversion names a width other than binary32, which no x86-64 half row declares")};
    }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa_inst.Operand                 = rd.ok;
    val rs:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], mi.src_width);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val sr: res[i32, fail.Fail] = float_reg_operand(st, rs.ok, float_scratch1(), mi.src_width);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val work: i32 = float_work_reg(dst);
    emit_f16c(widen, work, sr.ok, x64_emit.VB_XMM, ?st.buf);
    if (dst.kind == isa_inst.OPK_REG) { ret err[fail.Fail].ok{}; }
    ret x64_emit.float_store(dst, work, mi.width, ?st.buf);
}

fun encode_float_conv(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("encode: float conversion missing operands")};
    }
    val buf:   *isa_encode.ByteBuf = ?st.buf;
    val op:    lang_mir.MirOpcode  = mi.opcode;
    val dst_w: u8                  = mi.width;
    val src_w: u8                  = mi.src_width;

    if ((op == lang_mir.MIR_FP_EXT && src_w == 2) || (op == lang_mir.MIR_FP_TRUNC && dst_w == 2)) {
        ret encode_half_conv(st, f, mi);
    }
    if (op == lang_mir.MIR_FP_TRUNC || op == lang_mir.MIR_FP_EXT) {
        if (!common.is_float_width(dst_w) || !common.is_float_width(src_w)) {
            ret err[fail.Fail].err{fail.message("internal compiler error: float conversion has a non-float width on a float side (expected 4 or 8)")};
        }
        val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
        if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
        val dst: isa_inst.Operand                 = rd.ok;
        val rs:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], src_w);
        if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
        val src: isa_inst.Operand = rs.ok;

        val sr: res[i32, fail.Fail] = float_reg_operand(st, src, float_scratch1(), src_w);
        if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
        val src_reg: i32 = sr.ok;
        val work:    i32 = float_work_reg(dst);
        var cvt_op:  u16 = x64.CVTSD2SS;
        if (op == lang_mir.MIR_FP_EXT) { cvt_op = x64.CVTSS2SD; }
        emit_cvt_reg(cvt_op, work, src_reg, 0, buf);
        if (dst.kind == isa_inst.OPK_REG) { ret err[fail.Fail].ok{}; }
        ret x64_emit.float_store(dst, work, dst_w, buf);
    }

    if (op == lang_mir.MIR_SI_TO_FP || op == lang_mir.MIR_UI_TO_FP) {
        if (!common.is_float_width(dst_w)) {
            ret err[fail.Fail].err{fail.message("internal compiler error: integer-to-float conversion has a non-float result width (expected 4 or 8)")};
        }
        val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], 16);
        if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
        val dst: isa_inst.Operand                 = rd.ok;
        val rs:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], src_w);
        if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
        val src: isa_inst.Operand = rs.ok;

        # the source is read before the scratch is written, the destination after
        val lo: i32 = x64_emit.pick_stage_scratch(x64_emit.store_target(?dst), nil);
        if (lo == isa_inst.REG_NONE) { ret err[fail.Fail].err{fail.message(CONV_NO_SCRATCH)}; }
        val signed: bool           = op == lang_mir.MIR_SI_TO_FP;
        val ld:     err[fail.Fail] = emit_gp_load_ext(src, lo, src_w, signed, buf);
        if (sel ld.err) { ret ld; }
        val work:   i32 = float_work_reg(dst);
        var cvt_op: u16 = x64.CVTSI2SD;
        if (dst_w == 4) { cvt_op = x64.CVTSI2SS; }
        if (!signed && src_w >= 8) {
            val hi: i32 = x64_emit.pick_stage_scratch_besides(x64_emit.store_target(?dst), nil, lo);
            if (hi == isa_inst.REG_NONE) { ret err[fail.Fail].err{fail.message(CONV_NO_SCRATCH)}; }
            ret emit_u64_to_fp(dst, work, dst_w, cvt_op, lo, hi, buf);
        }
        emit_cvt_reg(cvt_op, work, lo, 8, buf);
        if (dst.kind == isa_inst.OPK_REG) { ret err[fail.Fail].ok{}; }
        ret x64_emit.float_store(dst, work, dst_w, buf);
    }

    if (!common.is_float_width(src_w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float-to-integer conversion has a non-float source width (expected 4 or 8)")};
    }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], dst_w);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa_inst.Operand                 = rd.ok;
    val rs:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], 16);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val src: isa_inst.Operand = rs.ok;

    val sr: res[i32, fail.Fail] = float_reg_operand(st, src, x64_emit.float_scratch0(), src_w);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val src_reg: i32 = sr.ok;
    var cvt_op:  u16 = x64.CVTTSD2SI;
    if (src_w == 4) { cvt_op = x64.CVTTSS2SI; }
    val lo: i32 = x64_emit.pick_stage_scratch(x64_emit.store_target(?dst), nil);
    if (lo == isa_inst.REG_NONE) { ret err[fail.Fail].err{fail.message(CONV_NO_SCRATCH)}; }

    if (op == lang_mir.MIR_FP_TO_UI) {
        if (dst_w >= 8) {
            val hi: i32 = x64_emit.pick_stage_scratch_besides(x64_emit.store_target(?dst), nil, lo);
            if (hi == isa_inst.REG_NONE) { ret err[fail.Fail].err{fail.message(CONV_NO_SCRATCH)}; }
            val fx: err[fail.Fail] = emit_fp_to_u64(st, src_reg, src_w, cvt_op, lo, hi);
            if (sel fx.err) { ret fx; }
        }
        or {
            emit_cvt_reg(cvt_op, lo, src_reg, 8, buf);
        }
        ret emit_gp_store(dst, lo, dst_w, buf);
    }

    emit_cvt_reg(cvt_op, lo, src_reg, dst_w, buf);
    ret emit_gp_store(dst, lo, dst_w, buf);
}

val CONV_NO_SCRATCH: str = "encode: no x86-64 scratch register is free to stage a float conversion";

fun float_cmp_swap(cc: u8) bool {
    ret cc == lang_mir.FCC_LT || cc == lang_mir.FCC_LE;
}

fun float_setcc_opcode(cc: u8) u16 {
    if (cc == lang_mir.FCC_EQ) { ret x64.SETE; }
    if (cc == lang_mir.FCC_NE) { ret x64.SETNE; }
    if (cc == lang_mir.FCC_LT) { ret x64.SETA; }
    if (cc == lang_mir.FCC_LE) { ret x64.SETAE; }
    if (cc == lang_mir.FCC_GT) { ret x64.SETA; }
    ret x64.SETAE;
}

fun encode_float_cmp(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: float comparison missing operands")};
    }
    val buf: *isa_encode.ByteBuf = ?st.buf;
    val w:   u8                  = mi.width;
    if (!common.is_float_width(w)) {
        ret err[fail.Fail].err{fail.message("internal compiler error: float comparison has a non-float operand width (expected 4 or 8)")};
    }
    val cc: u8 = mi.src_width;

    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], DEFAULT_OPERAND_SIZE);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa_inst.Operand = rd.ok;
    if (dst.kind != isa_inst.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: float comparison destination is not a register")};
    }
    val rl: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val lhs: isa_inst.Operand                 = rl.ok;
    val rr:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], w);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    val rhs: isa_inst.Operand = rr.ok;

    var first:  isa_inst.Operand = lhs;
    var second: isa_inst.Operand = rhs;
    if (float_cmp_swap(cc)) {
        first  = rhs;
        second = lhs;
    }

    val fr: res[i32, fail.Fail] = float_reg_operand(st, first, x64_emit.float_scratch0(), w);
    if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
    val first_reg: i32                              = fr.ok;
    val sr:        res[isa_inst.Operand, fail.Fail] = float_src_operand(st, second, float_scratch1(), w);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    val second_op: isa_inst.Operand = sr.ok;

    var ucom: isa_inst.Inst = isa_inst.inst_blank();
    ucom.opcode = x64.UCOMISD;
    if (w == 4) { ucom.opcode = x64.UCOMISS; }
    ucom.dst  = isa_inst.make_reg(first_reg, 16);
    ucom.src1 = second_op;
    ucom.size = w;
    val ue: err[fail.Fail] = encode_inst_sym(st, ?ucom);
    if (sel ue.err) { ret ue; }

    var setcc: isa_inst.Inst = isa_inst.inst_blank();
    setcc.opcode   = float_setcc_opcode(cc);
    setcc.dst      = dst;
    setcc.dst.size = 1;
    setcc.size     = 1;
    val fp: err[fail.Fail] = flags_pair(ucom.opcode, setcc.opcode);
    if (sel fp.err) { ret fp; }
    x64_emit.encode_inst(?setcc, buf);

    if (cc == lang_mir.FCC_EQ || cc == lang_mir.FCC_NE) {
        # the destination holds the first setcc until the parity joins it
        val scratch: i32 = x64_emit.pick_stage_scratch(?dst, nil);
        if (scratch == isa_inst.REG_NONE) {
            ret err[fail.Fail].err{fail.message("encode: no x86-64 scratch register is free to stage a float comparison's parity")};
        }
        var par: isa_inst.Inst = isa_inst.inst_blank();
        par.opcode = x64.SETNP;
        if (cc == lang_mir.FCC_NE) { par.opcode = x64.SETP; }
        par.dst      = isa_inst.make_reg(scratch, 1);
        par.dst.size = 1;
        par.size     = 1;
        # the parity read follows the first setcc, which keeps the flags
        val fk: err[fail.Fail] = flags_kept(setcc.opcode);
        if (sel fk.err) { ret fk; }
        val fp2: err[fail.Fail] = flags_pair(ucom.opcode, par.opcode);
        if (sel fp2.err) { ret fp2; }
        x64_emit.encode_inst(?par, buf);

        var comb: isa_inst.Inst = isa_inst.inst_blank();
        comb.opcode = x64.AND;
        if (cc == lang_mir.FCC_NE) { comb.opcode = x64.OR; }
        comb.dst      = dst;
        comb.dst.size = 1;
        comb.src1     = isa_inst.make_reg(scratch, 1);
        comb.size     = 1;
        x64_emit.encode_inst(?comb, buf);
    }

    var movzx: isa_inst.Inst = isa_inst.inst_blank();
    movzx.opcode    = x64.MOVZX;
    movzx.dst       = dst;
    movzx.dst.size  = DEFAULT_OPERAND_SIZE;
    movzx.src1      = dst;
    movzx.src1.size = 1;
    movzx.size      = DEFAULT_OPERAND_SIZE;
    movzx.flags     = x64_inst.FLAG_REX_W;
    x64_emit.encode_inst(?movzx, buf);

    ret err[fail.Fail].ok{};
}

# the selection opcodes the vector encoder packs; false for every other
# opcode (a partition, enumerated by its test)
fun is_selected_vector_alu(o: lang_mir.MirOpcode) bool {
    if (o == lang_mir.MIR_NOT)                                                               { ret true; }
    if (o == lang_mir.MIR_SEL_ADD || o == lang_mir.MIR_SEL_SUB || o == lang_mir.MIR_SEL_MUL) { ret true; }
    if (o == lang_mir.MIR_SEL_DIV_S || o == lang_mir.MIR_SEL_DIV_U ||
        o == lang_mir.MIR_SEL_REM_S || o == lang_mir.MIR_SEL_REM_U) { ret true; }
    if (o == lang_mir.MIR_SEL_AND || o == lang_mir.MIR_SEL_OR || o == lang_mir.MIR_SEL_XOR)      { ret true; }
    if (o == lang_mir.MIR_SEL_SHL || o == lang_mir.MIR_SEL_SHR_S || o == lang_mir.MIR_SEL_SHR_U) { ret true; }
    if (o == lang_mir.MIR_SEL_CMP_EQ || o == lang_mir.MIR_SEL_CMP_NE ||
        o == lang_mir.MIR_SEL_CMP_LT_S || o == lang_mir.MIR_SEL_CMP_LT_U ||
        o == lang_mir.MIR_SEL_CMP_LE_S || o == lang_mir.MIR_SEL_CMP_LE_U) { ret true; }
    ret false;
}

fun punpckl_op(w: u8) u16 {
    if (w == 1) { ret x64.PUNPCKLBW; }
    if (w == 2) { ret x64.PUNPCKLWD; }
    ret x64.PUNPCKLDQ;
}

# the register width that holds `bytes` of vector lanes
fun vec_width_for(bytes: u32) u8 {
    if (bytes > x64_emit.VB_XMM::u32) { ret x64_emit.VB_YMM; }
    ret x64_emit.VB_XMM;
}

# the work register holds the operand's lanes from here on; a sequence that has not read it yet copies it in
fun xconv_load(p: *convplan.Plan, loaded: *bool, vb: u8) {
    if (@loaded) { ret; }
    convplan.push_at(p, x64.MOVAPS::u32, convplan.PLACE_WORK, convplan.PLACE_OPERAND, 0, vb::u32);
    @loaded = true;
}

# one packed conversion instruction over the lanes, reading the operand itself when nothing has copied it yet
fun xconv_cvt(p: *convplan.Plan, loaded: *bool, op: u16, vb: u8) {
    var src: convplan.Place = convplan.PLACE_WORK;
    if (!@loaded) { src = convplan.PLACE_OPERAND; }
    convplan.push_at(p, op::u32, convplan.PLACE_WORK, src, 0, vb::u32);
    @loaded = true;
}

# an f16c conversion in the work register, the vex forms reading and writing
# registers here: `vb` is the binary32 side's width and `from` the operand's
fun xconv_half(p: *convplan.Plan, loaded: *bool, op: u16, vb: u8, from: u8) {
    xconv_load(p, loaded, from);
    convplan.push_at(p, op::u32, convplan.PLACE_WORK, convplan.PLACE_WORK, 0, vb::u32);
}

# widen the lanes from `from` to `to` bytes into a register of `vb`: one
# pmovsx or pmovzx where the model extends directly (sse41), else doubling
# each step at 16 bytes, the high half the sign mask of a signed lane and
# zero otherwise. a 32-byte result is avx2, which holds sse41
fun xconv_widen(p: *convplan.Plan, loaded: *bool, from: u8, to: u8, signed: bool, direct: bool, vb: u8) bool {
    if (direct) {
        xconv_cvt(p, loaded, pmov_op(signed, from, to), vb);
        ret true;
    }
    if (vb != x64_emit.VB_XMM) { ret false; }
    xconv_load(p, loaded, vb);
    var w: u8 = from;
    for (w < to) {
        convplan.push(p, x64.PXOR::u32, convplan.PLACE_TEMP, convplan.PLACE_TEMP, 0);
        if (signed) { convplan.push(p, pcmpgt_op(w)::u32, convplan.PLACE_TEMP, convplan.PLACE_WORK, 0); }
        convplan.push(p, punpckl_op(w)::u32, convplan.PLACE_WORK, convplan.PLACE_TEMP, 0);
        w = w * 2;
    }
    ret true;
}

# one halving of every lane of `w` bytes at 16 bytes, in `at` against `with`:
# a quadword keeps its low doubleword by shuffle, and a narrower lane is
# sign-folded from its low half so the saturating pack keeps those bits exactly
fun xconv_halve(p: *convplan.Plan, w: u8, at: convplan.Place, with: convplan.Place) {
    if (w == 8) {
        convplan.push(p, x64.PSHUFD::u32, at, at, 0x08);
        if (with == at) { ret; }
        convplan.push(p, x64.PSHUFD::u32, with, with, 0x08);
        convplan.push(p, x64.PUNPCKLQDQ::u32, at, with, 0);
        ret;
    }
    var left:  u16 = x64.PSLLD;
    var right: u16 = x64.PSRAD;
    var pack:  u16 = x64.PACKSSDW;
    var bits:  u32 = 16;
    if (w == 2) {
        left  = x64.PSLLW;
        right = x64.PSRAW;
        pack  = x64.PACKSSWB;
        bits  = 8;
    }
    convplan.push(p, left::u32, at, at, bits);
    convplan.push(p, right::u32, at, at, bits);
    if (with != at) {
        convplan.push(p, left::u32, with, with, bits);
        convplan.push(p, right::u32, with, with, bits);
    }
    convplan.push(p, pack::u32, at, with, 0);
}

# truncate the lanes from `from` to `to` bytes, halving each step. lanes in
# a 32-byte register halve first as its two 16-byte halves, the high half
# taken out into the temporary and the two joined by the halving itself, so
# no step past the first crosses a 128-bit lane or needs avx2
fun xconv_narrow(p: *convplan.Plan, loaded: *bool, from: u8, to: u8, vb: u8) {
    xconv_load(p, loaded, vb);
    var w: u8 = from;
    if (vb == x64_emit.VB_YMM && w > to) {
        convplan.push_at(p, x64.VEXTRACTF128::u32, convplan.PLACE_TEMP, convplan.PLACE_WORK, 1, vb::u32);
        xconv_halve(p, w, convplan.PLACE_WORK, convplan.PLACE_TEMP);
        w = w / 2;
    }
    for (w > to) {
        xconv_halve(p, w, convplan.PLACE_WORK, convplan.PLACE_WORK);
        w = w / 2;
    }
}

# an integer to binary32 conversion of eight lanes narrower than 32 bits
# where the model holds no 32-byte integer register (avx without avx2): each
# 16-byte half widens and converts on its own, the high half's lanes shifted
# down to the bottom of the temporary first, and the two join in the work
# register's ymm
fun xconv_float_halves(p: *convplan.Plan, loaded: *bool, from: u8, signed: bool) {
    xconv_cvt(p, loaded, pmov_op(signed, from, 4), x64_emit.VB_XMM);
    convplan.push(p, x64.CVTDQ2PS::u32, convplan.PLACE_WORK, convplan.PLACE_WORK, 0);
    convplan.push(p, x64.MOVAPS::u32, convplan.PLACE_TEMP, convplan.PLACE_OPERAND, 0);
    convplan.push(p, x64.PSRLDQ::u32, convplan.PLACE_TEMP, convplan.PLACE_TEMP, (from::u32) * 4);
    convplan.push(p, pmov_op(signed, from, 4)::u32, convplan.PLACE_TEMP, convplan.PLACE_TEMP, 0);
    convplan.push(p, x64.CVTDQ2PS::u32, convplan.PLACE_TEMP, convplan.PLACE_TEMP, 0);
    convplan.push_at(p, x64.VINSERTF128::u32, convplan.PLACE_WORK, convplan.PLACE_TEMP, 1, x64_emit.VB_YMM::u32);
}

# the packed conversion sequence, for the cells the x86_64 packed table
# declares; each one agrees bit for bit with the scalar conversion of a lane.
# `dw` and `sw` are the result's and the operand's register widths, and
# `int_ymm` whether the model holds 32-byte integer lanes (avx2)
fun xconv_plan(op: lang_mir.MirOpcode, to_float: bool, to: u8, from_float: bool, from: u8, direct: bool,
    dw: u8, sw: u8, int_ymm: bool) opt[convplan.Plan] {
    var p:      convplan.Plan = convplan.plan();
    var loaded: bool          = false;
    var ok:     bool          = true;
    if (op == lang_mir.MIR_SEXT || op == lang_mir.MIR_ZEXT)  { ok = xconv_widen(?p, ?loaded, from, to, op == lang_mir.MIR_SEXT, direct, dw); }
    or (op == lang_mir.MIR_TRUNC)                            { xconv_narrow(?p, ?loaded, from, to, sw); }
    or (op == lang_mir.MIR_FP_EXT && from == 4 && to == 8)   { xconv_cvt(?p, ?loaded, x64.CVTPS2PD, dw); }
    or (op == lang_mir.MIR_FP_TRUNC && from == 8 && to == 4) { xconv_cvt(?p, ?loaded, x64.CVTPD2PS, sw); }
    or (op == lang_mir.MIR_FP_EXT && from == 2 && to == 4)   { xconv_half(?p, ?loaded, x64.VCVTPH2PS, dw, sw); }
    or (op == lang_mir.MIR_FP_TRUNC && from == 4 && to == 2) { xconv_half(?p, ?loaded, x64.VCVTPS2PH, sw, sw); }
    or ((op == lang_mir.MIR_SI_TO_FP || (op == lang_mir.MIR_UI_TO_FP && from < 4)) && from <= 4 && !from_float && to_float) {
        if (from < 4 && to == 4 && dw == x64_emit.VB_YMM && !int_ymm) {
            xconv_float_halves(?p, ?loaded, from, op == lang_mir.MIR_SI_TO_FP);
        }
        or {
            # the doubleword lanes sit at the result's width for binary32 and at
            # half of it for binary64
            var iw: u8 = dw;
            if (to == 8)  { iw = x64_emit.VB_XMM; }
            if (from < 4) { ok = xconv_widen(?p, ?loaded, from, 4, op == lang_mir.MIR_SI_TO_FP, direct, iw); }
            var cvt: u16 = x64.CVTDQ2PS;
            if (to == 8) { cvt = x64.CVTDQ2PD; }
            xconv_cvt(?p, ?loaded, cvt, dw);
        }
    }
    or (op == lang_mir.MIR_FP_TO_SI && from_float && !to_float && to <= 4) {
        # binary32 converts at its own width, binary64 into the half its
        # doublewords fill
        var cvt: u16 = x64.CVTTPS2DQ;
        var iw:  u8  = sw;
        if (from == 8) {
            cvt = x64.CVTTPD2DQ;
            iw  = x64_emit.VB_XMM;
        }
        xconv_cvt(?p, ?loaded, cvt, sw);
        xconv_narrow(?p, ?loaded, 4, to, iw);
    }
    or                     { ret opt[convplan.Plan].none{}; }
    if (!ok || p.overflow) { ret opt[convplan.Plan].none{}; }
    ret opt[convplan.Plan].some{p};
}

fun xconv_place(place: convplan.Place, operand: isa_inst.Operand, work: i32) isa_inst.Operand {
    if (place == convplan.PLACE_OPERAND) { ret operand; }
    if (place == convplan.PLACE_WORK)    { ret x64_emit.vec_reg(work, x64_emit.VB_XMM); }
    ret x64_emit.vec_reg(float_scratch1(), x64_emit.VB_XMM);
}

# the widths a conversion step writes and reads at a step width `vb`: a
# widening conversion or extension reads the half its lanes fill, and a
# narrowing conversion writes the half
fun conv_step_sizes(op: u16, vb: u8, dst: *u8, src: *u8) {
    @dst = vb;
    @src = vb;
    if (vb == x64_emit.VB_XMM)                                            { ret; }
    if (op == x64.CVTPD2PS || op == x64.CVTTPD2DQ || op == x64.VCVTPS2PH) { @dst = x64_emit.VB_XMM; }
    if (op == x64.CVTDQ2PD || op == x64.CVTPS2PD || op == x64.VCVTPH2PS)  { @src = x64_emit.VB_XMM; }
    if (op == x64.PMOVSXBW || op == x64.PMOVSXWD || op == x64.PMOVSXDQ || op == x64.PMOVSXBD
        || op == x64.PMOVSXBQ || op == x64.PMOVSXWQ || op == x64.PMOVZXBW || op == x64.PMOVZXWD
        || op == x64.PMOVZXDQ || op == x64.PMOVZXBD || op == x64.PMOVZXBQ || op == x64.PMOVZXWQ) { @src = x64_emit.VB_XMM; }
}

# emit a plan with the result forming in `work`, which the caller chose from the plan's alias property
fun emit_xconv(p: *convplan.Plan, operand: isa_inst.Operand, work: i32, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.len) {
        val step: convplan.Step = p.steps[i];
        val op:   u16           = step.op::u16;
        var vb:   u8            = x64_emit.VB_XMM;
        if (step.width != 0) { vb = step.width::u8; }
        var db: u8 = vb;
        var sb: u8 = vb;
        conv_step_sizes(op, vb, ?db, ?sb);
        val dst:  isa_inst.Operand = x64_emit.vec_sized(xconv_place(step.dst, operand, work), db);
        val src:  isa_inst.Operand = x64_emit.vec_sized(xconv_place(step.src, operand, work), sb);
        var done: err[fail.Fail]   = err[fail.Fail].ok{};
        if (dst.kind != isa_inst.OPK_REG) { ret err[fail.Fail].err{fail.message("encode: packed conversion step writes its operand")}; }
        if (op == x64.MOVAPS) {
            if (src.kind != isa_inst.OPK_REG || src.reg != dst.reg) { done = x64_emit.vec_load(src, dst.reg, vb, buf); }
        }
        or (op == x64.PSHUFD) {
            if (src.kind != isa_inst.OPK_REG) { ret err[fail.Fail].err{fail.message("encode: packed conversion shuffle reads memory")}; }
            done = x64_emit.packed_rri(op, vb, dst.reg, src.reg, step.arg::u8, buf);
        }
        or (op == x64.PSLLW || op == x64.PSLLD || op == x64.PSRAW || op == x64.PSRAD || op == x64.PSRLDQ) {
            done = x64_emit.packed_shift_imm(op, vb, dst.reg, step.arg::u8, buf);
        }
        or (op == x64.VCVTPH2PS || op == x64.VCVTPS2PH) {
            if (src.kind != isa_inst.OPK_REG) { ret err[fail.Fail].err{fail.message("encode: packed f16 conversion reads memory")}; }
            emit_f16c(op == x64.VCVTPH2PS, dst.reg, src.reg, vb, buf);
        }
        or (op == x64.VEXTRACTF128) {
            if (src.kind != isa_inst.OPK_REG) { ret err[fail.Fail].err{fail.message("encode: packed conversion half reads memory")}; }
            x64_emit.vextract128(dst.reg, src.reg, step.arg::u8, buf);
        }
        or (op == x64.VINSERTF128) { x64_emit.vinsert128(dst.reg, dst.reg, src, step.arg::u8, buf); }
        or                         { done = x64_emit.packed_as(op, vb, dst, src, buf); }
        if (sel done.err)          { ret done; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun encode_vector_convert(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: packed vector conversion missing operands")}; }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], mi.width);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rs: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], mi.src_width);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val int_ymm: bool               = target_model.vector_width(st.model, false, 32) >= 256;
    val planned: opt[convplan.Plan] = xconv_plan(mi.opcode,
        lang_mir.vec_lane_kind(mi.vec_lane) == lang_mir.VEC_LANE_FLOAT, lang_mir.vec_lane_elem_bytes(mi.vec_lane),
        lang_mir.vec_lane_from_kind(mi.vec_lane) == lang_mir.VEC_LANE_FLOAT, lang_mir.vec_lane_from_bytes(mi.vec_lane),
        target_model.extends_directly(st.model), mi.width, mi.src_width, int_ymm);
    if (sel planned.none) { ret err[fail.Fail].err{fail.message("encode: vector conversion outside the x86_64 packed table")}; }
    var p: convplan.Plan = planned.some;
    ret emit_xconv_to(?p, rd.ok, rs.ok, mi.width, ?st.buf);
}

# the result forms in the destination unless the destination is a frame slot or the scratch temporary,
# or aliases an operand the plan reads after writing; then it forms in scratch0 and is copied out
fun emit_xconv_to(p: *convplan.Plan, dst: isa_inst.Operand, operand: isa_inst.Operand, dw: u8, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val dst_is_reg: bool = dst.kind == isa_inst.OPK_REG;
    val aliases:    bool = dst_is_reg && operand.kind == isa_inst.OPK_REG && operand.reg == dst.reg;
    val is_temp:    bool = dst_is_reg && dst.reg == float_scratch1();
    var work:       i32  = x64_emit.float_scratch0();
    if (convplan.in_destination(p, dst_is_reg, aliases, is_temp)) { work = dst.reg; }
    val body: err[fail.Fail] = emit_xconv(p, operand, work, buf);
    if (sel body.err)                  { ret body; }
    if (dst_is_reg && dst.reg == work) { ret err[fail.Fail].ok{}; }
    ret x64_emit.vec_store(dst, work, dw, buf);
}

# the widening multiplies the x86_64 packed table declares, from the operand
# lane width, into scratch0: pmullw beside pmulhw or pmulhuw interleaved into
# doubled lanes, and pmuludq over 32-bit lanes spread onto the dwords it
# reads. `dw` is the result's width and `sw` the operands'; `half` names the
# half of two operands of twice the lanes (-1 for the whole of operands of
# the result's lanes). a 32-byte result is avx2: the interleave then acts
# within each 128-bit lane, so the products' quadwords are first placed where
# each lane's unpack reads them, and the doubleword spread is pmovzxdq
fun emit_vec_widen_mul_body(signed: bool, half: i32, from: u8, dw: u8, sw: u8, lhs: isa_inst.Operand, rhs: isa_inst.Operand, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val s0: i32 = x64_emit.float_scratch0();
    val s1: i32 = float_scratch1();
    if (from == 2) {
        var high: u16 = x64.PMULHUW;
        if (signed) { high = x64.PMULHW; }
        val l0: err[fail.Fail] = x64_emit.vec_load(lhs, s0, sw, buf);
        if (sel l0.err) { ret l0; }
        val l1: err[fail.Fail] = x64_emit.vec_load(lhs, s1, sw, buf);
        if (sel l1.err) { ret l1; }
        val lo: err[fail.Fail] = x64_emit.packed_op(x64.PMULLW, sw, s0, rhs, buf);
        if (sel lo.err) { ret lo; }
        val hi: err[fail.Fail] = x64_emit.packed_op(high, sw, s1, rhs, buf);
        if (sel hi.err) { ret hi; }
        var unpack: u16 = x64.PUNPCKLWD;
        if (half > 0) { unpack = x64.PUNPCKHWD; }
        if (dw == x64_emit.VB_YMM) {
            # the low two quadwords of each 16-byte product feed the result's
            # two lanes: [q0 q1] to quadwords 0 and 2 of a half's 16 bytes, and
            # [q0 q2 q1 q3] of a 32-byte product
            var order: u8 = 0x50;
            if (sw == x64_emit.VB_YMM) { order = 0xD8; }
            x64_emit.vpermq(s0, x64_emit.vec_reg(s0, x64_emit.VB_YMM), order, buf);
            x64_emit.vpermq(s1, x64_emit.vec_reg(s1, x64_emit.VB_YMM), order, buf);
        }
        ret x64_emit.packed_op(unpack, dw, s0, x64_emit.vec_reg(s1, dw), buf);
    }
    if (from == 4 && !signed) {
        if (dw == x64_emit.VB_YMM) {
            # each doubleword lane of the half onto the low doubleword of its quadword
            var la: isa_inst.Operand = lhs;
            var ra: isa_inst.Operand = rhs;
            if (half > 0) {
                val lh: err[fail.Fail] = vec_high_half(lhs, s0, buf);
                if (sel lh.err) { ret lh; }
                val rh: err[fail.Fail] = vec_high_half(rhs, s1, buf);
                if (sel rh.err) { ret rh; }
                la = x64_emit.vec_reg(s0, x64_emit.VB_XMM);
                ra = x64_emit.vec_reg(s1, x64_emit.VB_XMM);
            }
            val z0: err[fail.Fail] = x64_emit.packed_as(x64.PMOVZXDQ, x64_emit.VB_YMM, x64_emit.vec_reg(s0, x64_emit.VB_YMM), x64_emit.vec_sized(la, x64_emit.VB_XMM), buf);
            if (sel z0.err) { ret z0; }
            val z1: err[fail.Fail] = x64_emit.packed_as(x64.PMOVZXDQ, x64_emit.VB_YMM, x64_emit.vec_reg(s1, x64_emit.VB_YMM), x64_emit.vec_sized(ra, x64_emit.VB_XMM), buf);
            if (sel z1.err) { ret z1; }
            ret x64_emit.packed_op(x64.PMULUDQ, x64_emit.VB_YMM, s0, x64_emit.vec_reg(s1, x64_emit.VB_YMM), buf);
        }
        # pmuludq reads doublewords 0 and 2: spread the half's two lanes onto them
        var spread: u8 = 0x50;
        if (half > 0) { spread = 0xFA; }
        val l0: err[fail.Fail] = x64_emit.vec_load(lhs, s0, x64_emit.VB_XMM, buf);
        if (sel l0.err) { ret l0; }
        val p0: err[fail.Fail] = x64_emit.packed_rri(x64.PSHUFD, x64_emit.VB_XMM, s0, s0, spread, buf);
        if (sel p0.err) { ret p0; }
        val l1: err[fail.Fail] = x64_emit.vec_load(rhs, s1, x64_emit.VB_XMM, buf);
        if (sel l1.err) { ret l1; }
        val p1: err[fail.Fail] = x64_emit.packed_rri(x64.PSHUFD, x64_emit.VB_XMM, s1, s1, spread, buf);
        if (sel p1.err) { ret p1; }
        ret x64_emit.packed_op(x64.PMULUDQ, x64_emit.VB_XMM, s0, x64_emit.vec_reg(s1, x64_emit.VB_XMM), buf);
    }
    ret err[fail.Fail].err{fail.message("encode: widening multiply outside the x86_64 packed table")};
}

# the high 16 bytes of a 32-byte register or frame slot into the xmm register `xmm`
fun vec_high_half(src: isa_inst.Operand, xmm: i32, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (src.kind == isa_inst.OPK_REG) {
        x64_emit.vextract128(xmm, src.reg, 1, buf);
        ret err[fail.Fail].ok{};
    }
    if (src.kind == isa_inst.OPK_MEM) {
        var hi: isa_inst.Operand = x64_emit.vec_sized(src, x64_emit.VB_XMM);
        hi.disp = hi.disp + 16;
        ret x64_emit.vec_load(hi, xmm, x64_emit.VB_XMM, buf);
    }
    ret err[fail.Fail].err{fail.message("encode: vector operand is not a register or aligned frame slot")};
}

fun encode_vector_widen_mul(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: packed widening multiply missing operands")}; }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], mi.width);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rl: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], mi.src_width);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val rr: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], mi.src_width);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    if (lang_mir.vec_lane_kind(mi.vec_lane) != lang_mir.VEC_LANE_INT || lang_mir.vec_lane_from_kind(mi.vec_lane) != lang_mir.VEC_LANE_INT
        || lang_mir.vec_lane_elem_bytes(mi.vec_lane) != lang_mir.vec_lane_from_bytes(mi.vec_lane) * 2) {
        ret err[fail.Fail].err{fail.message("encode: widening multiply lanes are not integer lanes doubling in width")};
    }
    # a fourth operand selects the high half of two operands of twice the lanes
    var half: i32 = -1;
    if (mi.operand_count >= 4) {
        if (mi.operands[3].kind != lang_mir.MIR_OP_IMM) {
            ret err[fail.Fail].err{fail.message("encode: widening multiply half is not an immediate")};
        }
        half = 0;
        if (mi.operands[3].imm != 0) { half = 1; }
    }
    val body: err[fail.Fail] = emit_vec_widen_mul_body(mi.opcode == lang_mir.MIR_MUL_WIDE_S, half,
        lang_mir.vec_lane_from_bytes(mi.vec_lane), mi.width, mi.src_width, rl.ok, rr.ok, buf);
    if (sel body.err) { ret body; }
    ret x64_emit.vec_store(rd.ok, x64_emit.float_scratch0(), mi.width, buf);
}

fun punpckh_op(w: u8) u16 {
    if (w == 1) { ret x64.PUNPCKHBW; }
    if (w == 2) { ret x64.PUNPCKHWD; }
    ret x64.PUNPCKHDQ;
}

fun pmovsx_op(w: u8) u16 {
    if (w == 1) { ret x64.PMOVSXBW; }
    if (w == 2) { ret x64.PMOVSXWD; }
    ret x64.PMOVSXDQ;
}

fun pmovzx_op(w: u8) u16 {
    if (w == 1) { ret x64.PMOVZXBW; }
    if (w == 2) { ret x64.PMOVZXWD; }
    ret x64.PMOVZXDQ;
}

# the one sse41 extension from `from`-byte to `to`-byte lanes
fun pmov_op(signed: bool, from: u8, to: u8) u16 {
    if (to == from * 2) {
        if (signed) { ret pmovsx_op(from); }
        ret pmovzx_op(from);
    }
    if (signed) {
        if (from == 2) { ret x64.PMOVSXWQ; }
        if (to == 4)   { ret x64.PMOVSXBD; }
        ret x64.PMOVSXBQ;
    }
    if (from == 2) { ret x64.PMOVZXWQ; }
    if (to == 4)   { ret x64.PMOVZXBD; }
    ret x64.PMOVZXBQ;
}

# the lane-halving extension the x86_64 packed table declares at every integer
# width: on the SSE2 baseline the half is unpacked against zero or
# against its own sign mask, low half through punpckl*, high half through
# punpckh*; under sse41 the high half is shifted down and either half is one
# pmovsx*/pmovzx*. at 32 bytes (avx2, which holds sse41) the half is the
# source's low xmm or its high one taken out, extended into the whole ymm.
# the source is loaded into scratch0 and the result leaves it
fun emit_vec_widen_half_body(signed: bool, high: bool, from: u8, sse41: bool, vb: u8, src: isa_inst.Operand, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val s0:  i32 = x64_emit.float_scratch0();
    val s1:  i32 = float_scratch1();
    var ext: u16 = pmovzx_op(from);
    if (signed) { ext = pmovsx_op(from); }
    if (vb == x64_emit.VB_YMM) {
        if (!sse41) { ret err[fail.Fail].err{fail.message("encode: a 32-byte lane-halving extension on a model without sse41")}; }
        var half: isa_inst.Operand = x64_emit.vec_sized(src, x64_emit.VB_XMM);
        if (high) {
            val hh: err[fail.Fail] = vec_high_half(src, s0, buf);
            if (sel hh.err) { ret hh; }
            half = x64_emit.vec_reg(s0, x64_emit.VB_XMM);
        }
        ret x64_emit.packed_as(ext, x64_emit.VB_YMM, x64_emit.vec_reg(s0, x64_emit.VB_YMM), half, buf);
    }
    val l0: err[fail.Fail] = x64_emit.vec_load(src, s0, vb, buf);
    if (sel l0.err) { ret l0; }
    if (sse41) {
        if (high) {
            val sh: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSRLDQ, vb, s0, 8, buf);
            if (sel sh.err) { ret sh; }
        }
        ret x64_emit.packed_op(ext, vb, s0, x64_emit.vec_reg(s0, vb), buf);
    }
    val z: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, s1, x64_emit.vec_reg(s1, vb), buf);
    if (sel z.err) { ret z; }
    if (signed) {
        val m: err[fail.Fail] = x64_emit.packed_op(pcmpgt_op(from), vb, s1, x64_emit.vec_reg(s0, vb), buf);
        if (sel m.err) { ret m; }
    }
    var unpack: u16 = punpckl_op(from);
    if (high) { unpack = punpckh_op(from); }
    ret x64_emit.packed_op(unpack, vb, s0, x64_emit.vec_reg(s1, vb), buf);
}

fun encode_vector_widen_half(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: lane-halving extension missing operands")}; }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], mi.width);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rs: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], mi.src_width);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    if (mi.operands[2].kind != lang_mir.MIR_OP_IMM) {
        ret err[fail.Fail].err{fail.message("encode: lane-halving extension base is not an immediate")};
    }
    val from:  u8  = lang_mir.vec_lane_from_bytes(mi.vec_lane);
    val lanes: u32 = lang_mir.vec_lane_count(mi.vec_lane);
    if (lang_mir.vec_lane_kind(mi.vec_lane) != lang_mir.VEC_LANE_INT || lang_mir.vec_lane_from_kind(mi.vec_lane) != lang_mir.VEC_LANE_INT
        || lang_mir.vec_lane_elem_bytes(mi.vec_lane) != from * 2 || from > 4) {
        ret err[fail.Fail].err{fail.message("encode: lane-halving extension lanes are not integer lanes doubling in width")};
    }
    val base: i64 = mi.operands[2].imm;
    if (base != 0 && base != lanes::i64) {
        ret err[fail.Fail].err{fail.message("encode: lane-halving extension base names neither half")};
    }
    # pmovsx and pmovzx are the packed table's sse41 rows of the extension
    var op: target_model.VecOp = target_model.VEC_OP_WIDEN_U;
    if (mi.opcode == lang_mir.MIR_VEC_WIDEN_S) { op = target_model.VEC_OP_WIDEN_S; }
    val sse41: bool           = target_model.packed_row_selected_by(st.model, op, false, from::u32 * 16, from::u32 * 8, extension_x64.SSE41);
    val body:  err[fail.Fail] = emit_vec_widen_half_body(mi.opcode == lang_mir.MIR_VEC_WIDEN_S, base != 0, from, sse41, mi.width, rs.ok, ?st.buf);
    if (sel body.err) { ret body; }
    ret x64_emit.vec_store(rd.ok, x64_emit.float_scratch0(), mi.width, ?st.buf);
}

# the widening group sum the x86_64 packed table declares, bytes into
# quadwords: psadbw against zero sums each quadword's eight bytes into it
fun encode_vector_widen_sum(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: widening lane sum missing operands")}; }
    if (lang_mir.vec_lane_kind(mi.vec_lane) != lang_mir.VEC_LANE_INT || lang_mir.vec_lane_from_kind(mi.vec_lane) != lang_mir.VEC_LANE_INT
        || lang_mir.vec_lane_elem_bytes(mi.vec_lane) != 8 || lang_mir.vec_lane_from_bytes(mi.vec_lane) != 1) {
        ret err[fail.Fail].err{fail.message("encode: widening lane sum outside the x86_64 packed table")};
    }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], mi.width);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rs: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], mi.src_width);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val body: err[fail.Fail] = emit_vec_widen_sum_body(rs.ok, mi.width, buf);
    if (sel body.err) { ret body; }
    ret x64_emit.vec_store(rd.ok, x64_emit.float_scratch0(), mi.width, buf);
}

# each lane's sign mask as the cleared register compared greater than the
# lanes: pcmpgt* of zero against them, in the destination itself unless it is
# the source
fun encode_vector_sign_mask(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: lane sign mask missing operands")}; }
    val w: u8 = lang_mir.vec_lane_elem_bytes(mi.vec_lane);
    if (lang_mir.vec_lane_kind(mi.vec_lane) != lang_mir.VEC_LANE_INT || (w != 1 && w != 2 && w != 4)) {
        ret err[fail.Fail].err{fail.message("encode: lane sign mask outside the x86_64 packed table")};
    }
    val vb: u8                               = mi.width;
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], vb);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rs: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], vb);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    var work: i32 = x64_emit.float_scratch0();
    if (rd.ok.kind == isa_inst.OPK_REG && !(rs.ok.kind == isa_inst.OPK_REG && rs.ok.reg == rd.ok.reg)) { work = rd.ok.reg; }
    val z: err[fail.Fail] = x64_emit.vec_zero(work, vb, buf);
    if (sel z.err) { ret z; }
    val m: err[fail.Fail] = x64_emit.packed_op(pcmpgt_op(w), vb, work, rs.ok, buf);
    if (sel m.err)                         { ret m; }
    if (work == x64_emit.float_scratch0()) { ret x64_emit.vec_store(rd.ok, work, vb, buf); }
    ret err[fail.Fail].ok{};
}

fun emit_vec_widen_sum_body(src: isa_inst.Operand, vb: u8, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val s0: i32            = x64_emit.float_scratch0();
    val s1: i32            = float_scratch1();
    val l0: err[fail.Fail] = x64_emit.vec_load(src, s0, vb, buf);
    if (sel l0.err) { ret l0; }
    val z: err[fail.Fail] = x64_emit.vec_zero(s1, vb, buf);
    if (sel z.err) { ret z; }
    ret x64_emit.packed_op(x64.PSADBW, vb, s0, x64_emit.vec_reg(s1, vb), buf);
}

# the pshufd selector that moves doubleword `first` and those above it to the
# bottom, repeating the top doubleword past the end
fun range_pshufd_imm(first: u32) u8 {
    var imm: u32 = 0;
    var k:   u32 = 0;
    for (k < 4) {
        var from: u32 = first + k;
        if (from > 3) { from = 3; }
        imm = imm | (from << (k * 2));
        k   = k + 1;
    }
    ret imm::u8;
}

# the lanes of a 16-byte vector from a byte offset on moved to the bottom of
# scratch0; the lanes above the range's count are left unspecified, as in any
# narrow vector in an xmm register. no offset is a move, a doubleword-aligned
# one is one pshufd from the source, and any other is psrldq after the move on
# the SSE2 baseline and one palignr from the source under ssse3
fun emit_vec_range_body(off: u32, ssse3: bool, src: isa_inst.Operand, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val s0: i32 = x64_emit.float_scratch0();
    if (off == 0)     { ret x64_emit.vec_load(src, s0, x64_emit.VB_XMM, buf); }
    if (off % 4 == 0) { ret x64_emit.packed_imm(x64.PSHUFD, x64_emit.VB_XMM, s0, src, range_pshufd_imm(off / 4), buf); }
    if (ssse3)        { ret x64_emit.packed_imm(x64.PALIGNR, x64_emit.VB_XMM, s0, src, off::u8, buf); }
    val l0: err[fail.Fail] = x64_emit.vec_load(src, s0, x64_emit.VB_XMM, buf);
    if (sel l0.err) { ret l0; }
    ret x64_emit.packed_shift_imm(x64.PSRLDQ, x64_emit.VB_XMM, s0, off::u8, buf);
}

# the lanes of a 32-byte vector from a byte offset on, `r` bytes of them,
# into scratch0. a range inside the low half is the 16-byte range of
# it, and one at or past the middle the 16-byte range of the high half. one
# that crosses the middle is the two halves joined by palignr, the high half
# in front, and a result wider than 16 bytes places the high half shifted
# down by the offset over it. the avx only moves the halves, so a float
# vector under avx without avx2 ranges the same way; the ssse3 palignr
# comes with avx
fun emit_vec_range_wide_body(off: u32, r: u32, src: isa_inst.Operand, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val s0: i32 = x64_emit.float_scratch0();
    val s1: i32 = float_scratch1();
    if (off == 0 && r > x64_emit.VB_XMM::u32) { ret x64_emit.vec_load(src, s0, x64_emit.VB_YMM, buf); }
    if (off + r <= x64_emit.VB_XMM::u32)      { ret emit_vec_range_body(off, true, x64_emit.vec_sized(src, x64_emit.VB_XMM), buf); }
    if (off >= x64_emit.VB_XMM::u32) {
        val hh: err[fail.Fail] = vec_high_half(src, s0, buf);
        if (sel hh.err)                  { ret hh; }
        if (off == x64_emit.VB_XMM::u32) { ret err[fail.Fail].ok{}; }
        ret emit_vec_range_body(off - x64_emit.VB_XMM::u32, true, x64_emit.vec_reg(s0, x64_emit.VB_XMM), buf);
    }
    val hh: err[fail.Fail] = vec_high_half(src, s1, buf);
    if (sel hh.err) { ret hh; }
    x64_emit.movaps_rr(s0, s1, x64_emit.VB_XMM, buf);
    val al: err[fail.Fail] = x64_emit.packed_imm(x64.PALIGNR, x64_emit.VB_XMM, s0, x64_emit.vec_sized(src, x64_emit.VB_XMM), off::u8, buf);
    if (sel al.err)                { ret al; }
    if (r <= x64_emit.VB_XMM::u32) { ret err[fail.Fail].ok{}; }
    val sh: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSRLDQ, x64_emit.VB_XMM, s1, off::u8, buf);
    if (sel sh.err) { ret sh; }
    x64_emit.vinsert128(s0, s0, x64_emit.vec_reg(s1, x64_emit.VB_XMM), 1, buf);
    ret err[fail.Fail].ok{};
}

fun encode_vector_range(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: lane range missing operands")}; }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], mi.width);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rs: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], mi.src_width);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    if (mi.operands[2].kind != lang_mir.MIR_OP_IMM) {
        ret err[fail.Fail].err{fail.message("encode: lane range first lane is not an immediate")};
    }
    val eb:    u32 = lang_mir.vec_lane_elem_bytes(mi.vec_lane)::u32;
    val first: i64 = mi.operands[2].imm;
    if (!lang_mir.vec_lane_is_vector(mi.vec_lane) || eb == 0 || first < 0 || first * eb::i64 >= mi.src_width::i64) {
        ret err[fail.Fail].err{fail.message("encode: lane range starts outside the source register")};
    }
    var body: err[fail.Fail] = err[fail.Fail].ok{};
    if (mi.src_width == x64_emit.VB_YMM) {
        body = emit_vec_range_wide_body(first::u32 * eb, lang_mir.vec_lane_count(mi.vec_lane) * eb, rs.ok, ?st.buf);
    }
    or {
        # palignr is the packed table's ssse3 row of the lane range
        val is_float: bool = lang_mir.vec_lane_kind(mi.vec_lane) == lang_mir.VEC_LANE_FLOAT;
        val ssse3:    bool = target_model.packed_row_selected_by(st.model, target_model.VEC_OP_RANGE, is_float, eb * 8, eb * 8, extension_x64.SSSE3);
        body = emit_vec_range_body(first::u32 * eb, ssse3, rs.ok, ?st.buf);
    }
    if (sel body.err) { ret body; }
    ret x64_emit.vec_store(rd.ok, x64_emit.float_scratch0(), mi.width, ?st.buf);
}

# `lo` cleared above its low `k` bytes and `hi` shifted up by k bytes to meet
# it, in the xmm scratch0 at 16 bytes (scratch1 the shifted part): one
# punpcklqdq when lo fills a quadword; otherwise lo cleared by a shift up and
# back down, and hi shifted up to meet it with por. the lanes past both parts
# are left unspecified, as in any narrow vector
fun emit_vec_concat_body(k: u32, lo: isa_inst.Operand, hi: isa_inst.Operand, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val s0: i32            = x64_emit.float_scratch0();
    val s1: i32            = float_scratch1();
    val l0: err[fail.Fail] = x64_emit.vec_load(lo, s0, x64_emit.VB_XMM, buf);
    if (sel l0.err) { ret l0; }
    if (k == 8)     { ret x64_emit.packed_op(x64.PUNPCKLQDQ, x64_emit.VB_XMM, s0, hi, buf); }
    val up: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSLLDQ, x64_emit.VB_XMM, s0, (16 - k)::u8, buf);
    if (sel up.err) { ret up; }
    val down: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSRLDQ, x64_emit.VB_XMM, s0, (16 - k)::u8, buf);
    if (sel down.err) { ret down; }
    val l1: err[fail.Fail] = x64_emit.vec_load(hi, s1, x64_emit.VB_XMM, buf);
    if (sel l1.err) { ret l1; }
    val sh: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSLLDQ, x64_emit.VB_XMM, s1, k::u8, buf);
    if (sel sh.err) { ret sh; }
    ret x64_emit.packed_op(x64.POR, x64_emit.VB_XMM, s0, x64_emit.vec_reg(s1, x64_emit.VB_XMM), buf);
}

# the lanes of lo then hi in the ymm scratch0, lo holding `k` bytes and hi `h`,
# together more than 16. lo of 16 bytes is hi inserted as the high
# half; a shorter lo leaves the low half the 16-byte join and the high half
# hi's bytes from 16 - k on; a longer lo keeps its low half and joins its high
# half with hi. the halves move with the avx lane crossings, so a float
# vector under avx without avx2 joins the same way
fun emit_vec_concat_wide_body(k: u32, h: u32, lo: isa_inst.Operand, hi: isa_inst.Operand, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val s0: i32 = x64_emit.float_scratch0();
    val s1: i32 = float_scratch1();
    if (k == x64_emit.VB_XMM::u32) {
        val l0: err[fail.Fail] = x64_emit.vec_load(x64_emit.vec_sized(lo, x64_emit.VB_XMM), s0, x64_emit.VB_XMM, buf);
        if (sel l0.err) { ret l0; }
        x64_emit.vinsert128(s0, s0, x64_emit.vec_sized(hi, x64_emit.VB_XMM), 1, buf);
        ret err[fail.Fail].ok{};
    }
    if (k < x64_emit.VB_XMM::u32) {
        val low: err[fail.Fail] = emit_vec_concat_body(k, x64_emit.vec_sized(lo, x64_emit.VB_XMM), x64_emit.vec_sized(hi, x64_emit.VB_XMM), buf);
        if (sel low.err) { ret low; }
        if (h <= x64_emit.VB_XMM::u32) {
            val l1: err[fail.Fail] = x64_emit.vec_load(x64_emit.vec_sized(hi, x64_emit.VB_XMM), s1, x64_emit.VB_XMM, buf);
            if (sel l1.err) { ret l1; }
            val sh: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSRLDQ, x64_emit.VB_XMM, s1, (16 - k)::u8, buf);
            if (sel sh.err) { ret sh; }
        }
        or {
            val hh: err[fail.Fail] = vec_high_half(hi, s1, buf);
            if (sel hh.err) { ret hh; }
            val al: err[fail.Fail] = x64_emit.packed_imm(x64.PALIGNR, x64_emit.VB_XMM, s1, x64_emit.vec_sized(hi, x64_emit.VB_XMM), (16 - k)::u8, buf);
            if (sel al.err) { ret al; }
        }
        x64_emit.vinsert128(s0, s0, x64_emit.vec_reg(s1, x64_emit.VB_XMM), 1, buf);
        ret err[fail.Fail].ok{};
    }
    # the high half of lo, cleared above its k - 16 bytes, with hi shifted up to meet it
    val hh: err[fail.Fail] = vec_high_half(lo, s0, buf);
    if (sel hh.err) { ret hh; }
    val top: err[fail.Fail] = emit_vec_concat_body(k - x64_emit.VB_XMM::u32, x64_emit.vec_reg(s0, x64_emit.VB_XMM), x64_emit.vec_sized(hi, x64_emit.VB_XMM), buf);
    if (sel top.err) { ret top; }
    x64_emit.movaps_rr(s1, s0, x64_emit.VB_XMM, buf);
    val l0: err[fail.Fail] = x64_emit.vec_load(x64_emit.vec_sized(lo, x64_emit.VB_XMM), s0, x64_emit.VB_XMM, buf);
    if (sel l0.err) { ret l0; }
    x64_emit.vinsert128(s0, s0, x64_emit.vec_reg(s1, x64_emit.VB_XMM), 1, buf);
    ret err[fail.Fail].ok{};
}

fun encode_vector_concat(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 4 || mi.operands[3].kind != lang_mir.MIR_OP_IMM) {
        ret err[fail.Fail].err{fail.message("encode: lane join missing operands")};
    }
    val eb:  i64 = lang_mir.vec_lane_elem_bytes(mi.vec_lane)::i64;
    val k:   i64 = mi.operands[3].imm * eb;
    val all: i64 = lang_mir.vec_lane_count(mi.vec_lane)::i64 * eb;
    if (k <= 0 || k >= all || all > mi.width::i64) {
        ret err[fail.Fail].err{fail.message("encode: lane join low part does not leave room in the register")};
    }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], mi.width);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rl: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], vec_width_for(k::u32));
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val rh: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], vec_width_for((all - k)::u32));
    if (sel rh.err) { ret err[fail.Fail].err{rh.err}; }
    var body: err[fail.Fail] = err[fail.Fail].ok{};
    if (all > x64_emit.VB_XMM::i64) { body = emit_vec_concat_wide_body(k::u32, (all - k)::u32, rl.ok, rh.ok, buf); }
    or                              { body = emit_vec_concat_body(k::u32, rl.ok, rh.ok, buf); }
    if (sel body.err)               { ret body; }
    ret x64_emit.vec_store(rd.ok, x64_emit.float_scratch0(), mi.width, buf);
}

fun encode_vector_op(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val o:   lang_mir.MirOpcode  = mi.opcode;
    val buf: *isa_encode.ByteBuf = ?st.buf;
    if (o == lang_mir.MIR_NOT) { ret encode_vector_not(f, mi, buf); }
    if (o == lang_mir.MIR_SEL_CMP_EQ || o == lang_mir.MIR_SEL_CMP_NE ||
        o == lang_mir.MIR_SEL_CMP_LT_S || o == lang_mir.MIR_SEL_CMP_LT_U ||
        o == lang_mir.MIR_SEL_CMP_LE_S || o == lang_mir.MIR_SEL_CMP_LE_U) { ret encode_vector_compare(st, f, mi); }
    if (o == lang_mir.MIR_SEL_ADD || o == lang_mir.MIR_SEL_SUB || o == lang_mir.MIR_SEL_MUL ||
        o == lang_mir.MIR_SEL_DIV_S || o == lang_mir.MIR_SEL_DIV_U ||
        o == lang_mir.MIR_SEL_AND || o == lang_mir.MIR_SEL_OR || o == lang_mir.MIR_SEL_XOR) { ret encode_vector_arith(st, f, mi); }
    if (o == lang_mir.MIR_SEL_SHL || o == lang_mir.MIR_SEL_SHR_U || o == lang_mir.MIR_SEL_SHR_S) { ret encode_vector_shift(st, f, mi); }
    ret err[fail.Fail].err{fail.message("encode: unsupported vector operation on x86_64 (no packed SSE2 selection)")};
}

# the SSE2 shift of a lane width by one count for every lane; 0xFFFF where the
# baseline has none (8-bit lanes, and the 64-bit arithmetic shift)
fun packed_shift_opcode(op: lang_mir.MirOpcode, eb: u8) u16 {
    if (op == lang_mir.MIR_SEL_SHL) {
        if (eb == 2) { ret x64.PSLLW; }
        if (eb == 4) { ret x64.PSLLD; }
        if (eb == 8) { ret x64.PSLLQ; }
    }
    if (op == lang_mir.MIR_SEL_SHR_U) {
        if (eb == 2) { ret x64.PSRLW; }
        if (eb == 4) { ret x64.PSRLD; }
        if (eb == 8) { ret x64.PSRLQ; }
    }
    if (op == lang_mir.MIR_SEL_SHR_S) {
        if (eb == 2) { ret x64.PSRAW; }
        if (eb == 4) { ret x64.PSRAD; }
    }
    ret 0xFFFF;
}

# the avx2 shift of a lane width by a count per lane; 0xFFFF where avx2 has
# none (8- and 16-bit lanes, and the 64-bit arithmetic shift)
fun packed_var_shift_opcode(op: lang_mir.MirOpcode, eb: u8) u16 {
    if (op == lang_mir.MIR_SEL_SHL) {
        if (eb == 4) { ret x64.VPSLLVD; }
        if (eb == 8) { ret x64.VPSLLVQ; }
    }
    if (op == lang_mir.MIR_SEL_SHR_U) {
        if (eb == 4) { ret x64.VPSRLVD; }
        if (eb == 8) { ret x64.VPSRLVQ; }
    }
    if (op == lang_mir.MIR_SEL_SHR_S && eb == 4) { ret x64.VPSRAVD; }
    ret 0xFFFF;
}

# a shift count that is a vector of lane counts, in a vector register or the
# frame slot of a spilled vector value; a uniform count is a general scalar
fun shift_count_is_vector(f: *lang_mir.MirFunction, op: *lang_mir.MirOperand) bool {
    if (op.kind == lang_mir.MIR_OP_PREG)                                                              { ret isa_inst.regid_class(lang_mir.preg_regid(op.preg)) == isa_inst.REG_CLASS_ID_FP; }
    if (op.kind != lang_mir.MIR_OP_MEM || lang_mir.vreg_is_nil(op.vreg) || op.vreg.n >= f.vreg_count) { ret false; }
    ret f.vregs[op.vreg.n].vec_bytes != 0;
}

# a count by register is the low quadword of an xmm register, so the count is
# zero-extended from its lane width into scratch1 first; a count at or above
# the lane width then empties the lane, or fills it with the sign, as the
# scalar shift does. an immediate count saturates the same way from
# 16 up, so any constant outside the lane width is spelled 255. a count per
# lane is the avx2 variable shift, which saturates each lane on its own
fun encode_vector_shift(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val buf: *isa_encode.ByteBuf = ?st.buf;
    val vb:  u8                  = mi.width;
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: packed vector shift missing operands")}; }
    val eb: u8 = lang_mir.vec_lane_elem_bytes(mi.vec_lane);
    if (lang_mir.vec_lane_kind(mi.vec_lane) != lang_mir.VEC_LANE_INT) {
        ret err[fail.Fail].err{fail.message("encode: vector shift lane outside the x86_64 packed table")};
    }
    if (shift_count_is_vector(f, ?mi.operands[2])) { ret encode_vector_var_shift(st, f, mi, eb); }
    val opc: u16 = packed_shift_opcode(mi.opcode, eb);
    if (opc == 0xFFFF) {
        ret err[fail.Fail].err{fail.message("encode: vector shift lane outside the x86_64 packed table")};
    }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], vb);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rl: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], vb);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val rc: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], eb);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val dst:   isa_inst.Operand = rd.ok;
    val lhs:   isa_inst.Operand = rl.ok;
    val count: isa_inst.Operand = rc.ok;
    if (count.kind != isa_inst.OPK_IMM) {
        # the count is read before the scratch is written, the vectors after
        val scratch: i32 = x64_emit.pick_stage_scratch(?dst, ?lhs);
        if (scratch == isa_inst.REG_NONE) {
            ret err[fail.Fail].err{fail.message("encode: no x86-64 scratch register is free to stage a vector shift count")};
        }
        val lc: err[fail.Fail] = emit_shift_count(count, eb, scratch, float_scratch1(), buf);
        if (sel lc.err) { ret lc; }
    }
    var work: i32 = x64_emit.float_scratch0();
    if (dst.kind == isa_inst.OPK_REG) { work = dst.reg; }
    if (!(lhs.kind == isa_inst.OPK_REG && lhs.reg == work)) {
        val ll: err[fail.Fail] = x64_emit.vec_load(lhs, work, vb, buf);
        if (sel ll.err) { ret ll; }
    }
    var sh: err[fail.Fail] = err[fail.Fail].ok{};
    if (count.kind == isa_inst.OPK_IMM) {
        var imm: i64 = count.imm;
        if (imm < 0 || imm >= eb::i64 * 8) { imm = 255; }
        sh = x64_emit.packed_shift_imm(opc, vb, work, imm::u8, buf);
    }
    or                                                   { sh = emit_packed_shift_by(opc, vb, work, float_scratch1(), buf); }
    if (sel sh.err)                                      { ret sh; }
    if (dst.kind == isa_inst.OPK_REG && dst.reg == work) { ret err[fail.Fail].ok{}; }
    ret x64_emit.vec_store(dst, work, vb, buf);
}

# vpsllv*, vpsrlv* or vpsrav* under the avx2 rows the catalog selects them by:
# the shifted vector is the first source, which vex names in vvvv and so must
# be a register, and the counts are the second, a register or frame slot. the
# result forms in the destination register, or in scratch0 for a frame slot
fun encode_vector_var_shift(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, eb: u8) err[fail.Fail] {
    val opc: u16 = packed_var_shift_opcode(mi.opcode, eb);
    if (opc == 0xFFFF) {
        ret err[fail.Fail].err{fail.message("encode: a per-lane vector shift of this lane has no x86_64 packed form")};
    }
    val vop: target_model.VecOp = var_shift_vec_op(mi.opcode);
    if (!target_model.packed_row_selected_by(st.model, vop, false, eb::u32 * 8, eb::u32 * 8, extension_x64.AVX2)) {
        ret err[fail.Fail].err{fail.message("encode: a per-lane vector shift reached the encoder on a target that does not select avx2")};
    }
    val buf: *isa_encode.ByteBuf              = ?st.buf;
    val vb:  u8                               = mi.width;
    val rd:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], vb);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rl: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], vb);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val rc: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], vb);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    ret x64_emit.vec3_ops(opc, vb, rd.ok, rl.ok, rc.ok, buf);
}

fun var_shift_vec_op(op: lang_mir.MirOpcode) target_model.VecOp {
    if (op == lang_mir.MIR_SEL_SHL)   { ret target_model.VEC_OP_SHL_V; }
    if (op == lang_mir.MIR_SEL_SHR_U) { ret target_model.VEC_OP_SHR_U_V; }
    ret target_model.VEC_OP_SHR_S_V;
}

# the count of `eb` bytes in a general register or frame slot, zero-extended
# into the whole of `xmm`: movd or movq straight from a 32- or 64-bit
# register, and through `gp` from anything narrower or in memory
fun emit_shift_count(count: isa_inst.Operand, eb: u8, gp: i32, xmm: i32, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    var mw: u8 = 4;
    if (eb == 8) { mw = 8; }
    if (count.kind == isa_inst.OPK_REG && eb >= 4) {
        x64_emit.movd_movq_reg(count.reg, xmm, mw, true, buf);
        ret err[fail.Fail].ok{};
    }
    val ld: err[fail.Fail] = emit_gp_load_ext(count, gp, eb, false, buf);
    if (sel ld.err) { ret ld; }
    x64_emit.movd_movq_reg(gp, xmm, mw, true, buf);
    ret err[fail.Fail].ok{};
}

# a packed shift of `xmm` by the count in the low quadword of `count_xmm`,
# which the vex.256 form reads from the xmm register still
fun emit_packed_shift_by(op: u16, vb: u8, xmm: i32, count_xmm: i32, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val opbyte: opt[u8] = x64_emit.packed_shift_count_opbyte(op);
    if (sel opbyte.none) { ret err[fail.Fail].err{fail.message(x64_emit.PACKED_OPCODE_UNKNOWN)}; }
    val start: usize = buf.bytes.len;
    if (vb == x64_emit.VB_XMM && !x64_emit.vex_encoding(buf)) {
        x64_emit.sse_rm(0x66, opbyte.some, xmm, x64_emit.vec_reg(count_xmm, x64_emit.VB_XMM), buf);
        x64_emit.note_packed(buf, start, op, x64_emit.vec_reg(xmm, x64_emit.VB_XMM), x64_emit.vec_reg(count_xmm, x64_emit.VB_XMM));
        ret err[fail.Fail].ok{};
    }
    if (vb != x64_emit.VB_XMM && vb != x64_emit.VB_YMM) { ret err[fail.Fail].err{fail.message(x64_emit.PACKED_WIDTH_UNKNOWN)}; }
    x64_emit.vex_rm(x64_emit.OpMap{prefix: 0x66, map: 0, opbyte: opbyte.some, w: 0}, x64_emit.vex_l(vb), xmm, xmm, x64_emit.vec_reg(count_xmm, x64_emit.VB_XMM), buf);
    x64_emit.note_vec(buf, start, op, x64_inst.FLAG_VEX, x64_emit.vec_reg(xmm, vb), x64_emit.vec_reg(xmm, vb), x64_emit.vec_reg(count_xmm, x64_emit.VB_XMM), isa_inst.make_none(), vb);
    ret err[fail.Fail].ok{};
}

fun packed_arith_opcode(op: lang_mir.MirOpcode, vec_lane: u32) u16 {
    val is_float: bool = lang_mir.vec_lane_kind(vec_lane) == lang_mir.VEC_LANE_FLOAT;
    val eb:       u8   = lang_mir.vec_lane_elem_bytes(vec_lane);
    if (op == lang_mir.MIR_SEL_AND) { ret x64.PAND; }
    if (op == lang_mir.MIR_SEL_OR)  { ret x64.POR; }
    if (op == lang_mir.MIR_SEL_XOR) { ret x64.PXOR; }
    if (op == lang_mir.MIR_SEL_ADD) {
        if (is_float) {
            if (eb == 4) { ret x64.ADDPS; }
            ret x64.ADDPD;
        }
        if (eb == 1) { ret x64.PADDB; }
        if (eb == 2) { ret x64.PADDW; }
        if (eb == 4) { ret x64.PADDD; }
        ret x64.PADDQ;
    }
    if (op == lang_mir.MIR_SEL_SUB) {
        if (is_float) {
            if (eb == 4) { ret x64.SUBPS; }
            ret x64.SUBPD;
        }
        if (eb == 1) { ret x64.PSUBB; }
        if (eb == 2) { ret x64.PSUBW; }
        if (eb == 4) { ret x64.PSUBD; }
        ret x64.PSUBQ;
    }
    if (op == lang_mir.MIR_SEL_MUL) {
        if (is_float) {
            if (eb == 4) { ret x64.MULPS; }
            ret x64.MULPD;
        }
        if (eb == 2) { ret x64.PMULLW; }
    }
    if (op == lang_mir.MIR_MUL_HI_S && !is_float && eb == 2) { ret x64.PMULHW; }
    if (op == lang_mir.MIR_MUL_HI_U && !is_float && eb == 2) { ret x64.PMULHUW; }
    if (op == lang_mir.MIR_SEL_DIV_U || op == lang_mir.MIR_SEL_DIV_S) {
        if (is_float) {
            if (eb == 4) { ret x64.DIVPS; }
            ret x64.DIVPD;
        }
    }
    ret 0xFFFF;
}

# the low multiply of 32-bit lanes on the SSE2 baseline: pmuludq multiplies
# the low dword of each qword, so the even lanes multiply in place and the odd
# lanes after a shuffle into the low dwords, and the two qword products are
# narrowed back and interleaved. both scratch registers, the operands re-read
# as sources, the destination written last
fun emit_vec_mul_i32_body(vb: u8, lhs: isa_inst.Operand, rhs: isa_inst.Operand, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val s0: i32            = x64_emit.float_scratch0();
    val s1: i32            = float_scratch1();
    val o0: err[fail.Fail] = x64_emit.packed_imm(x64.PSHUFD, vb, s1, lhs, 0xF5, buf);
    if (sel o0.err) { ret o0; }
    val o1: err[fail.Fail] = x64_emit.packed_imm(x64.PSHUFD, vb, s0, rhs, 0xF5, buf);
    if (sel o1.err) { ret o1; }
    val o2: err[fail.Fail] = x64_emit.packed_op(x64.PMULUDQ, vb, s1, x64_emit.vec_reg(s0, vb), buf);
    if (sel o2.err) { ret o2; }
    val e0: err[fail.Fail] = x64_emit.vec_load(lhs, s0, vb, buf);
    if (sel e0.err) { ret e0; }
    val e1: err[fail.Fail] = x64_emit.packed_op(x64.PMULUDQ, vb, s0, rhs, buf);
    if (sel e1.err) { ret e1; }
    val n0: err[fail.Fail] = x64_emit.packed_rri(x64.PSHUFD, vb, s0, s0, 0x08, buf);
    if (sel n0.err) { ret n0; }
    val n1: err[fail.Fail] = x64_emit.packed_rri(x64.PSHUFD, vb, s1, s1, 0x08, buf);
    if (sel n1.err) { ret n1; }
    ret x64_emit.packed_op(x64.PUNPCKLDQ, vb, s0, x64_emit.vec_reg(s1, vb), buf);
}

# the low multiply of 64-bit lanes on the SSE2 baseline: the two cross terms
# hi(a)*lo(b) and lo(a)*hi(b) summed and shifted up by 32, plus lo(a)*lo(b),
# three pmuludq in all
fun emit_vec_mul_i64_body(vb: u8, lhs: isa_inst.Operand, rhs: isa_inst.Operand, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val s0: i32            = x64_emit.float_scratch0();
    val s1: i32            = float_scratch1();
    val h0: err[fail.Fail] = x64_emit.vec_load(lhs, s0, vb, buf);
    if (sel h0.err) { ret h0; }
    val h1: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSRLQ, vb, s0, 32, buf);
    if (sel h1.err) { ret h1; }
    val h2: err[fail.Fail] = x64_emit.packed_op(x64.PMULUDQ, vb, s0, rhs, buf);
    if (sel h2.err) { ret h2; }
    val g0: err[fail.Fail] = x64_emit.vec_load(rhs, s1, vb, buf);
    if (sel g0.err) { ret g0; }
    val g1: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSRLQ, vb, s1, 32, buf);
    if (sel g1.err) { ret g1; }
    val g2: err[fail.Fail] = x64_emit.packed_op(x64.PMULUDQ, vb, s1, lhs, buf);
    if (sel g2.err) { ret g2; }
    val a0: err[fail.Fail] = x64_emit.packed_op(x64.PADDQ, vb, s0, x64_emit.vec_reg(s1, vb), buf);
    if (sel a0.err) { ret a0; }
    val a1: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSLLQ, vb, s0, 32, buf);
    if (sel a1.err) { ret a1; }
    val l0: err[fail.Fail] = x64_emit.vec_load(lhs, s1, vb, buf);
    if (sel l0.err) { ret l0; }
    val l1: err[fail.Fail] = x64_emit.packed_op(x64.PMULUDQ, vb, s1, rhs, buf);
    if (sel l1.err) { ret l1; }
    ret x64_emit.packed_op(x64.PADDQ, vb, s0, x64_emit.vec_reg(s1, vb), buf);
}

# the integer multiplies the packed table declares without a single baseline
# instruction: 32-bit lanes are pmulld when the declared set holds sse41 and
# the pmuludq pair otherwise, 64-bit lanes vpmullq when it holds
# avx512dq and avx512vl and the three-pmuludq sequence otherwise
fun emit_vec_mul_sequence(sse41: bool, avx512dq: bool, eb: u8, vb: u8, dst: isa_inst.Operand, lhs: isa_inst.Operand, rhs: isa_inst.Operand, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (eb == 8 && avx512dq) { ret x64_emit.vec3_ops(x64.VPMULLQ, vb, dst, lhs, rhs, buf); }
    if (eb == 4 && sse41) {
        val ll: err[fail.Fail] = x64_emit.vec_load(lhs, x64_emit.float_scratch0(), vb, buf);
        if (sel ll.err) { ret ll; }
        val ro: err[fail.Fail] = x64_emit.packed_op(x64.PMULLD, vb, x64_emit.float_scratch0(), rhs, buf);
        if (sel ro.err) { ret ro; }
    }
    or (eb == 4) {
        val body: err[fail.Fail] = emit_vec_mul_i32_body(vb, lhs, rhs, buf);
        if (sel body.err) { ret body; }
    }
    or (eb == 8) {
        val body: err[fail.Fail] = emit_vec_mul_i64_body(vb, lhs, rhs, buf);
        if (sel body.err) { ret body; }
    }
    or { ret err[fail.Fail].err{fail.message("encode: unsupported packed vector op / lane combination")}; }
    ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
}

fun encode_vector_arith(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val buf: *isa_encode.ByteBuf = ?st.buf;
    val vb:  u8                  = mi.width;
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: packed vector op missing operands")}; }
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], vb);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rl: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], vb);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val rr: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], vb);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    val dst: isa_inst.Operand = rd.ok;
    val lhs: isa_inst.Operand = rl.ok;
    val rhs: isa_inst.Operand = rr.ok;

    if (mi.opcode == lang_mir.MIR_SEL_MUL && lang_mir.vec_lane_kind(mi.vec_lane) == lang_mir.VEC_LANE_INT && lang_mir.vec_lane_elem_bytes(mi.vec_lane) >= 4) {
        # pmulld is the packed table's sse41 row of the 32-bit lane multiply,
        # vpmullq its avx512dq and avx512vl row of the 64-bit one
        val sse41:    bool = target_model.packed_row_selected_by(st.model, target_model.VEC_OP_MUL, false, 32, 32, extension_x64.SSE41);
        val avx512dq: bool = target_model.packed_row_selected_by(st.model, target_model.VEC_OP_MUL, false, 64, 64, extension_x64.AVX512DQ | extension_x64.AVX512VL);
        ret emit_vec_mul_sequence(sse41, avx512dq, lang_mir.vec_lane_elem_bytes(mi.vec_lane), vb, dst, lhs, rhs, buf);
    }
    val opc: u16 = packed_arith_opcode(mi.opcode, mi.vec_lane);
    if (opc == 0xFFFF) { ret err[fail.Fail].err{fail.message("encode: unsupported packed vector op / lane combination")}; }
    ret emit_packed_binary(opc, vb, dst, lhs, rhs, buf);
}

# the lanes of lo and hi from the half's first lane on, interleaved into lanes
# twice as wide: punpckl* for the low half, punpckh* for the high. at
# 32 bytes the unpack acts within each 128-bit lane, so both operands' middle
# quadwords trade places first (vpermq 0xD8): each lane's unpack then reads
# the half's quadwords in order
fun encode_vector_interleave(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: lane interleave missing operands")}; }
    val vb: u8                               = mi.width;
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], vb);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rl: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], vb);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val rh: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], vb);
    if (sel rh.err) { ret err[fail.Fail].err{rh.err}; }
    val from: u8 = lang_mir.vec_lane_from_bytes(mi.vec_lane);
    if (lang_mir.vec_lane_kind(mi.vec_lane) != lang_mir.VEC_LANE_INT || lang_mir.vec_lane_from_kind(mi.vec_lane) != lang_mir.VEC_LANE_INT
        || lang_mir.vec_lane_elem_bytes(mi.vec_lane) != from * 2 || from > 4) {
        ret err[fail.Fail].err{fail.message("encode: lane interleave lanes are not integer lanes doubling in width")};
    }
    var high: bool = false;
    if (mi.operand_count >= 4) {
        if (mi.operands[3].kind != lang_mir.MIR_OP_IMM) {
            ret err[fail.Fail].err{fail.message("encode: lane interleave half is not an immediate")};
        }
        val base: i64 = mi.operands[3].imm;
        if (base != 0 && base != lang_mir.vec_lane_count(mi.vec_lane)::i64) {
            ret err[fail.Fail].err{fail.message("encode: lane interleave base names neither half")};
        }
        high = base != 0;
    }
    var opc: u16 = punpckl_op(from);
    if (high)                  { opc = punpckh_op(from); }
    if (vb == x64_emit.VB_XMM) { ret emit_packed_binary(opc, vb, rd.ok, rl.ok, rh.ok, buf); }
    x64_emit.vpermq(x64_emit.float_scratch0(), rl.ok, 0xD8, buf);
    x64_emit.vpermq(float_scratch1(), rh.ok, 0xD8, buf);
    val r: err[fail.Fail] = x64_emit.packed_op(opc, vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
    if (sel r.err) { ret r; }
    ret x64_emit.vec_store(rd.ok, x64_emit.float_scratch0(), vb, buf);
}

# dst = lhs op rhs for a two-operand packed instruction that writes its first
# operand
fun emit_packed_binary(opc: u16, vb: u8, dst: isa_inst.Operand, lhs: isa_inst.Operand, rhs: isa_inst.Operand, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (x64_emit.vex_three(buf, vb, dst, lhs)) { ret x64_emit.packed_three(opc, vb, dst.reg, lhs.reg, rhs, isa_inst.make_none(), buf); }
    # a register destination is the work register: the op runs in place when
    # the allocator tied it to the left operand, and otherwise after one copy
    # of the left operand, unless the right operand is the destination itself
    if (dst.kind == isa_inst.OPK_REG && !(rhs.kind == isa_inst.OPK_REG && rhs.reg == dst.reg && !(lhs.kind == isa_inst.OPK_REG && lhs.reg == dst.reg))) {
        if (!(lhs.kind == isa_inst.OPK_REG && lhs.reg == dst.reg)) {
            val lc: err[fail.Fail] = x64_emit.vec_load(lhs, dst.reg, vb, buf);
            if (sel lc.err) { ret lc; }
        }
        ret x64_emit.packed_op(opc, vb, dst.reg, rhs, buf);
    }

    val ll: err[fail.Fail] = x64_emit.vec_load(lhs, x64_emit.float_scratch0(), vb, buf);
    if (sel ll.err) { ret ll; }
    val ro: err[fail.Fail] = x64_emit.packed_op(opc, vb, x64_emit.float_scratch0(), rhs, buf);
    if (sel ro.err) { ret ro; }
    ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
}

fun encode_vector_not(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 2) { ret err[fail.Fail].err{fail.message("encode: packed vector not missing operands")}; }
    val vb: u8                               = mi.width;
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], vb);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rs: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], vb);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val dst: isa_inst.Operand = rd.ok;
    val src: isa_inst.Operand = rs.ok;

    val ll: err[fail.Fail] = x64_emit.vec_load(src, x64_emit.float_scratch0(), vb, buf);
    if (sel ll.err) { ret ll; }
    val ra: err[fail.Fail] = x64_emit.vec_all_ones(float_scratch1(), vb, buf);
    if (sel ra.err) { ret ra; }
    val ro: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
    if (sel ro.err) { ret ro; }
    ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
}

fun pcmpeq_op(w: u8) u16 {
    if (w == 1) { ret x64.PCMPEQB; }
    if (w == 2) { ret x64.PCMPEQW; }
    if (w == 8) { ret x64.PCMPEQQ; }
    ret x64.PCMPEQD;
}

fun pcmpgt_op(w: u8) u16 {
    if (w == 1) { ret x64.PCMPGTB; }
    if (w == 2) { ret x64.PCMPGTW; }
    ret x64.PCMPGTD;
}

# lhs == rhs per lane as an all-ones mask in scratch0: without pcmpeqq
# (eqq) a 64-bit lane is equal where both of its dwords are
fun emit_vcmp_eq_s0(vb: u8, eqq: bool, lhs: isa_inst.Operand, rhs: isa_inst.Operand, w: u8, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val ll: err[fail.Fail] = x64_emit.vec_load(lhs, x64_emit.float_scratch0(), vb, buf);
    if (sel ll.err) { ret ll; }
    if (w == 8 && !eqq) {
        val re: err[fail.Fail] = x64_emit.packed_op(x64.PCMPEQD, vb, x64_emit.float_scratch0(), rhs, buf);
        if (sel re.err) { ret re; }
        val packed_0: err[fail.Fail] = x64_emit.packed_rri(x64.PSHUFD, vb, float_scratch1(), x64_emit.float_scratch0(), 0xB1, buf);
        if (sel packed_0.err) { ret packed_0; }
        ret x64_emit.packed_op(x64.PAND, vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
    }
    ret x64_emit.packed_op(pcmpeq_op(w), vb, x64_emit.float_scratch0(), rhs, buf);
}

fun emit_vcmp_gt64_s0(vb: u8, x: isa_inst.Operand, y: isa_inst.Operand, signed: bool, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    # x > y per 64-bit lane as an all-ones mask in scratch0, from dword compares only:
    # the high dwords decide unless they tie, and a tie is broken by the low dwords read
    # as unsigned. an unsigned dword gt is the signed one xored with "the signs differ",
    # which keeps the sequence inside the two scratch registers with no constant to hold;
    # pshufd 0xF5 spreads a lane's high dword over both dwords and 0xA0 its low dword.
    # sse42 replaces it with pcmpgtq (emit_vcmp_gtq_s0).
    val s0: i32 = x64_emit.float_scratch0();
    val s1: i32 = float_scratch1();

    val ld0: err[fail.Fail] = x64_emit.vec_load(x, s1, vb, buf);
    if (sel ld0.err) { ret ld0; }
    val rx: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, s1, y, buf);
    if (sel rx.err) { ret rx; }
    val rz: err[fail.Fail] = x64_emit.vec_zero(s0, vb, buf);
    if (sel rz.err) { ret rz; }
    val rs: err[fail.Fail] = x64_emit.packed_op(x64.PCMPGTD, vb, s0, x64_emit.vec_reg(s1, vb), buf);
    if (sel rs.err) { ret rs; }

    val ld1: err[fail.Fail] = x64_emit.vec_load(x, s1, vb, buf);
    if (sel ld1.err) { ret ld1; }
    val rg: err[fail.Fail] = x64_emit.packed_op(x64.PCMPGTD, vb, s1, y, buf);
    if (sel rg.err) { ret rg; }
    val ru: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, s0, x64_emit.vec_reg(s1, vb), buf);
    if (sel ru.err) { ret ru; }

    val ld2: err[fail.Fail] = x64_emit.vec_load(x, s1, vb, buf);
    if (sel ld2.err) { ret ld2; }
    val re: err[fail.Fail] = x64_emit.packed_op(x64.PCMPEQD, vb, s1, y, buf);
    if (sel re.err) { ret re; }
    val packed_1: err[fail.Fail] = x64_emit.packed_rri(x64.PSHUFD, vb, s1, s1, 0xF5, buf);
    if (sel packed_1.err) { ret packed_1; }
    val ra: err[fail.Fail] = x64_emit.packed_op(x64.PAND, vb, s1, x64_emit.vec_reg(s0, vb), buf);
    if (sel ra.err) { ret ra; }
    val packed_2: err[fail.Fail] = x64_emit.packed_rri(x64.PSHUFD, vb, s1, s1, 0xA0, buf);
    if (sel packed_2.err) { ret packed_2; }

    if (signed) {
        val ld3: err[fail.Fail] = x64_emit.vec_load(x, s0, vb, buf);
        if (sel ld3.err) { ret ld3; }
        val rh: err[fail.Fail] = x64_emit.packed_op(x64.PCMPGTD, vb, s0, y, buf);
        if (sel rh.err) { ret rh; }
    }
    val packed_3: err[fail.Fail] = x64_emit.packed_rri(x64.PSHUFD, vb, s0, s0, 0xF5, buf);
    if (sel packed_3.err) { ret packed_3; }
    ret x64_emit.packed_op(x64.POR, vb, s0, x64_emit.vec_reg(s1, vb), buf);
}

# x > y per 64-bit lane as an all-ones mask in scratch0 by pcmpgtq, the
# packed table's sse42 row of the 64-bit ordering: an unsigned
# ordering is the signed one of the operands with their sign bits flipped
fun emit_vcmp_gtq_s0(vb: u8, x: isa_inst.Operand, y: isa_inst.Operand, signed: bool, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val s0: i32            = x64_emit.float_scratch0();
    val s1: i32            = float_scratch1();
    val lx: err[fail.Fail] = x64_emit.vec_load(x, s0, vb, buf);
    if (sel lx.err) { ret lx; }
    if (signed)     { ret x64_emit.packed_op(x64.PCMPGTQ, vb, s0, y, buf); }
    val ra: err[fail.Fail] = x64_emit.vec_all_ones(s1, vb, buf);
    if (sel ra.err) { ret ra; }
    val rs: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSLLQ, vb, s1, 63, buf);
    if (sel rs.err) { ret rs; }
    val bx: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, s0, x64_emit.vec_reg(s1, vb), buf);
    if (sel bx.err) { ret bx; }
    val by: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, s1, y, buf);
    if (sel by.err) { ret by; }
    ret x64_emit.packed_op(x64.PCMPGTQ, vb, s0, x64_emit.vec_reg(s1, vb), buf);
}

fun emit_vcmp_greater64_s0(vb: u8, gtq: bool, x: isa_inst.Operand, y: isa_inst.Operand, signed: bool, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (gtq) { ret emit_vcmp_gtq_s0(vb, x, y, signed, buf); }
    ret emit_vcmp_gt64_s0(vb, x, y, signed, buf);
}

fun encode_vcmp_i64_ordering(vb: u8, gtq: bool, dst: isa_inst.Operand, lhs: isa_inst.Operand, rhs: isa_inst.Operand, op: lang_mir.MirOpcode, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    val signed: bool = op == lang_mir.MIR_SEL_CMP_LT_S || op == lang_mir.MIR_SEL_CMP_LE_S;
    if (op == lang_mir.MIR_SEL_CMP_LT_S || op == lang_mir.MIR_SEL_CMP_LT_U) {
        val rg: err[fail.Fail] = emit_vcmp_greater64_s0(vb, gtq, rhs, lhs, signed, buf);
        if (sel rg.err) { ret rg; }
        ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
    }
    val rg: err[fail.Fail] = emit_vcmp_greater64_s0(vb, gtq, lhs, rhs, signed, buf);
    if (sel rg.err) { ret rg; }
    val ra: err[fail.Fail] = x64_emit.vec_all_ones(float_scratch1(), vb, buf);
    if (sel ra.err) { ret ra; }
    val rx: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
    if (sel rx.err) { ret rx; }
    ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
}

fun encode_vector_compare(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) err[fail.Fail] {
    val buf: *isa_encode.ByteBuf = ?st.buf;
    if (mi.operand_count < 3) { ret err[fail.Fail].err{fail.message("encode: packed compare missing operands")}; }
    val vb: u8                               = mi.width;
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], vb);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val rl: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], vb);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val rr: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], vb);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    val dst: isa_inst.Operand   = rd.ok;
    val lhs: isa_inst.Operand   = rl.ok;
    val rhs: isa_inst.Operand   = rr.ok;
    val op:  lang_mir.MirOpcode = mi.opcode;
    val w:   u8                 = lang_mir.vec_lane_elem_bytes(mi.vec_lane);

    if (lang_mir.vec_lane_kind(mi.vec_lane) == lang_mir.VEC_LANE_FLOAT) {
        var cmpop: u16 = x64.CMPPD;
        if (w == 4) { cmpop = x64.CMPPS; }
        var imm: u8 = 0;
        if (op == lang_mir.MIR_SEL_CMP_NE)                                      { imm = 4; }
        or (op == lang_mir.MIR_SEL_CMP_LT_S || op == lang_mir.MIR_SEL_CMP_LT_U) { imm = 1; }
        or (op == lang_mir.MIR_SEL_CMP_LE_S || op == lang_mir.MIR_SEL_CMP_LE_U) { imm = 2; }
        if (x64_emit.vex_three(buf, vb, dst, lhs))                              { ret x64_emit.packed_three(cmpop, vb, dst.reg, lhs.reg, rhs, isa_inst.make_imm(imm::i64, 1), buf); }
        val fl: err[fail.Fail] = x64_emit.vec_load(lhs, x64_emit.float_scratch0(), vb, buf);
        if (sel fl.err) { ret fl; }
        val fr: err[fail.Fail] = x64_emit.vec_load(rhs, float_scratch1(), vb, buf);
        if (sel fr.err) { ret fr; }
        val packed_4: err[fail.Fail] = x64_emit.packed_rri(cmpop, vb, x64_emit.float_scratch0(), float_scratch1(), imm, buf);
        if (sel packed_4.err) { ret packed_4; }
        ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
    }

    val eqq: bool = w == 8 && target_model.packed_row_selected_by(st.model, target_model.VEC_OP_CMP, false, 64, 64, extension_x64.SSE41);
    if (op == lang_mir.MIR_SEL_CMP_EQ) {
        if ((w != 8 || eqq) && x64_emit.vex_three(buf, vb, dst, lhs)) { ret x64_emit.packed_three(pcmpeq_op(w), vb, dst.reg, lhs.reg, rhs, isa_inst.make_none(), buf); }
        val re: err[fail.Fail] = emit_vcmp_eq_s0(vb, eqq, lhs, rhs, w, buf);
        if (sel re.err) { ret re; }
        ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
    }
    if (op == lang_mir.MIR_SEL_CMP_NE) {
        val re: err[fail.Fail] = emit_vcmp_eq_s0(vb, eqq, lhs, rhs, w, buf);
        if (sel re.err) { ret re; }
        val ra: err[fail.Fail] = x64_emit.vec_all_ones(float_scratch1(), vb, buf);
        if (sel ra.err) { ret ra; }
        val ro: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
        if (sel ro.err) { ret ro; }
        ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
    }

    if (w == 8) {
        val gtq: bool = target_model.packed_row_selected_by(st.model, target_model.VEC_OP_CMP, false, 64, 64, extension_x64.SSE42);
        ret encode_vcmp_i64_ordering(vb, gtq, dst, lhs, rhs, op, buf);
    }

    if (op == lang_mir.MIR_SEL_CMP_LT_S) {
        if (x64_emit.vex_three(buf, vb, dst, rhs)) { ret x64_emit.packed_three(pcmpgt_op(w), vb, dst.reg, rhs.reg, lhs, isa_inst.make_none(), buf); }
        val ld: err[fail.Fail] = x64_emit.vec_load(rhs, x64_emit.float_scratch0(), vb, buf);
        if (sel ld.err) { ret ld; }
        val ro: err[fail.Fail] = x64_emit.packed_op(pcmpgt_op(w), vb, x64_emit.float_scratch0(), lhs, buf);
        if (sel ro.err) { ret ro; }
        ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
    }
    if (op == lang_mir.MIR_SEL_CMP_LE_S) {
        val ld: err[fail.Fail] = x64_emit.vec_load(lhs, x64_emit.float_scratch0(), vb, buf);
        if (sel ld.err) { ret ld; }
        val ro: err[fail.Fail] = x64_emit.packed_op(pcmpgt_op(w), vb, x64_emit.float_scratch0(), rhs, buf);
        if (sel ro.err) { ret ro; }
        val ra: err[fail.Fail] = x64_emit.vec_all_ones(float_scratch1(), vb, buf);
        if (sel ra.err) { ret ra; }
        val rx: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
        if (sel rx.err) { ret rx; }
        ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
    }
    if (op == lang_mir.MIR_SEL_CMP_LT_U) {
        if (w == 4) {
            val ra: err[fail.Fail] = x64_emit.vec_all_ones(float_scratch1(), vb, buf);
            if (sel ra.err) { ret ra; }
            val packed_5: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSLLD, vb, float_scratch1(), 31, buf);
            if (sel packed_5.err) { ret packed_5; }
            val ld: err[fail.Fail] = x64_emit.vec_load(lhs, x64_emit.float_scratch0(), vb, buf);
            if (sel ld.err) { ret ld; }
            val rx0: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
            if (sel rx0.err) { ret rx0; }
            val rx1: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, float_scratch1(), rhs, buf);
            if (sel rx1.err) { ret rx1; }
            val rg: err[fail.Fail] = x64_emit.packed_op(x64.PCMPGTD, vb, float_scratch1(), x64_emit.vec_reg(x64_emit.float_scratch0(), vb), buf);
            if (sel rg.err) { ret rg; }
            ret x64_emit.vec_store(dst, float_scratch1(), vb, buf);
        }
        val ld: err[fail.Fail] = x64_emit.vec_load(rhs, x64_emit.float_scratch0(), vb, buf);
        if (sel ld.err) { ret ld; }
        var subus: u16 = x64.PSUBUSW;
        if (w == 1) { subus = x64.PSUBUSB; }
        val rs: err[fail.Fail] = x64_emit.packed_op(subus, vb, x64_emit.float_scratch0(), lhs, buf);
        if (sel rs.err) { ret rs; }
        val rz: err[fail.Fail] = x64_emit.vec_zero(float_scratch1(), vb, buf);
        if (sel rz.err) { ret rz; }
        val re: err[fail.Fail] = x64_emit.packed_op(pcmpeq_op(w), vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
        if (sel re.err) { ret re; }
        val ra: err[fail.Fail] = x64_emit.vec_all_ones(float_scratch1(), vb, buf);
        if (sel ra.err) { ret ra; }
        val rx: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
        if (sel rx.err) { ret rx; }
        ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
    }
    if (w == 4) {
        val ra: err[fail.Fail] = x64_emit.vec_all_ones(float_scratch1(), vb, buf);
        if (sel ra.err) { ret ra; }
        val packed_6: err[fail.Fail] = x64_emit.packed_shift_imm(x64.PSLLD, vb, float_scratch1(), 31, buf);
        if (sel packed_6.err) { ret packed_6; }
        val ld: err[fail.Fail] = x64_emit.vec_load(lhs, x64_emit.float_scratch0(), vb, buf);
        if (sel ld.err) { ret ld; }
        val rx0: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
        if (sel rx0.err) { ret rx0; }
        val rx1: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, float_scratch1(), rhs, buf);
        if (sel rx1.err) { ret rx1; }
        val rg: err[fail.Fail] = x64_emit.packed_op(x64.PCMPGTD, vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
        if (sel rg.err) { ret rg; }
        val ra2: err[fail.Fail] = x64_emit.vec_all_ones(float_scratch1(), vb, buf);
        if (sel ra2.err) { ret ra2; }
        val rx2: err[fail.Fail] = x64_emit.packed_op(x64.PXOR, vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
        if (sel rx2.err) { ret rx2; }
        ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
    }
    val ld: err[fail.Fail] = x64_emit.vec_load(lhs, x64_emit.float_scratch0(), vb, buf);
    if (sel ld.err) { ret ld; }
    var subus2: u16 = x64.PSUBUSW;
    if (w == 1) { subus2 = x64.PSUBUSB; }
    val rs2: err[fail.Fail] = x64_emit.packed_op(subus2, vb, x64_emit.float_scratch0(), rhs, buf);
    if (sel rs2.err) { ret rs2; }
    val rz2: err[fail.Fail] = x64_emit.vec_zero(float_scratch1(), vb, buf);
    if (sel rz2.err) { ret rz2; }
    val re2: err[fail.Fail] = x64_emit.packed_op(pcmpeq_op(w), vb, x64_emit.float_scratch0(), x64_emit.vec_reg(float_scratch1(), vb), buf);
    if (sel re2.err) { ret re2; }
    ret x64_emit.vec_store(dst, x64_emit.float_scratch0(), vb, buf);
}

fun encode_divide(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("encode: division missing divisor operand")};
    }
    val w:      u8   = effective_width(mi.width);
    val signed: bool = mi.opcode == lang_mir.MIR_SEL_DIV_S || mi.opcode == lang_mir.MIR_SEL_REM_S;

    val rdv: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rdv.err) { ret err[fail.Fail].err{rdv.err}; }
    val divisor: isa_inst.Operand = rdv.ok;

    if (signed) {
        var sext_inst: isa_inst.Inst = isa_inst.inst_blank();
        sext_inst.opcode = x64.CDQ;
        if (w == 2) { sext_inst.opcode = x64.CWD; }
        or (w >= 8) { sext_inst.opcode = x64.CQO; }
        sext_inst.size = w;
        x64_emit.encode_inst(?sext_inst, buf);
    }
    or {
        var xr: isa_inst.Inst = isa_inst.inst_blank();
        xr.opcode = x64.XOR;
        xr.dst    = isa_inst.make_reg(x64.RDX, 4);
        xr.src1   = isa_inst.make_reg(x64.RDX, 4);
        xr.size   = 4;
        x64_emit.encode_inst(?xr, buf);
    }

    var dv: isa_inst.Inst = isa_inst.inst_blank();
    dv.opcode = x64.DIV;
    if (signed) { dv.opcode = x64.IDIV; }
    dv.src1  = divisor;
    dv.size  = w;
    dv.flags = width_flags(mi.width);
    x64_emit.encode_inst(?dv, buf);

    ret err[fail.Fail].ok{};
}

fun is_mir_mul_pair(op: lang_mir.MirOpcode) bool {
    ret op == lang_mir.MIR_SEL_MUL_PAIR_U || op == lang_mir.MIR_SEL_MUL_PAIR_S;
}

# the widening multiply of rax by operand 1 into rdx:rax; the accumulator
# load and the result moves are separate instructions
fun encode_mul_pair(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("encode: pair multiply missing multiplier operand")};
    }
    val w: u8 = effective_width(mi.width);

    val rm: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rm.err) { ret err[fail.Fail].err{rm.err}; }

    var ml: isa_inst.Inst = isa_inst.inst_blank();
    ml.opcode = x64.MUL;
    if (mi.opcode == lang_mir.MIR_SEL_MUL_PAIR_S) { ml.opcode = x64.IMUL; }
    ml.src1  = rm.ok;
    ml.size  = w;
    ml.flags = width_flags(mi.width);
    if (x64_emit.encode_inst(?ml, buf) == 0) {
        ret err[fail.Fail].err{fail.message("encode: pair multiply operand is not a register or memory")};
    }

    ret err[fail.Fail].ok{};
}

fun is_mir_binary(op: lang_mir.MirOpcode) bool {
    ret op == lang_mir.MIR_SEL_ADD || op == lang_mir.MIR_SEL_SUB || op == lang_mir.MIR_SEL_MUL ||
        op == lang_mir.MIR_SEL_AND || op == lang_mir.MIR_SEL_OR || op == lang_mir.MIR_SEL_XOR;
}

fun mir_binary_opcode(op: lang_mir.MirOpcode) u16 {
    if (op == lang_mir.MIR_SEL_ADD) { ret x64.ADD; }
    if (op == lang_mir.MIR_SEL_SUB) { ret x64.SUB; }
    if (op == lang_mir.MIR_SEL_MUL) { ret x64.IMUL; }
    if (op == lang_mir.MIR_SEL_AND) { ret x64.AND; }
    if (op == lang_mir.MIR_SEL_OR)  { ret x64.OR; }
    ret x64.XOR;
}

fun encode_binary(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: binary ALU op missing operands")};
    }
    val w:  u8                               = effective_width(mi.width);
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], w);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa_inst.Operand                 = rd.ok;
    val rl:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    val lhs: isa_inst.Operand                 = rl.ok;
    val rr:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], w);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    val rhs: isa_inst.Operand = rr.ok;

    if (dst.kind != isa_inst.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: binary ALU destination is not a register")};
    }

    # the op runs as `d = l; d op= r`, so a right operand that lives in d's
    # register would be read after the copy overwrote it; the allocator keeps
    # such a pairing from ever being chosen
    val skip_mov: bool = lhs.kind == isa_inst.OPK_REG && lhs.reg == dst.reg;
    if (!skip_mov && operand_reads_register(?rhs, dst.reg)) {
        ret err[fail.Fail].err{fail.message("encode: binary ALU right operand lives in the destination register the left operand is copied into (internal compiler error)")};
    }
    if (!skip_mov) {
        var mov: isa_inst.Inst = isa_inst.inst_blank();
        mov.opcode = x64.MOV;
        mov.dst    = dst;
        mov.src1   = lhs;
        mov.size   = w;
        mov.flags  = width_flags(mi.width);
        x64_emit.encode_inst(?mov, buf);
    }

    var op: isa_inst.Inst = isa_inst.inst_blank();
    op.opcode = mir_binary_opcode(mi.opcode);
    op.dst    = dst;
    op.src1   = rhs;
    op.size   = w;
    op.flags  = width_flags(mi.width);
    x64_emit.encode_inst(?op, buf);
    ret err[fail.Fail].ok{};
}

fun operand_reads_register(op: *isa_inst.Operand, reg: i32) bool {
    if (op.kind == isa_inst.OPK_REG) { ret op.reg == reg; }
    if (op.kind == isa_inst.OPK_MEM) { ret op.base == reg || op.index == reg; }
    ret false;
}

fun is_mir_unary(op: lang_mir.MirOpcode) bool {
    ret op == lang_mir.MIR_SEL_NEG || op == lang_mir.MIR_SEL_NOT;
}

fun encode_unary_mir(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 2) {
        ret err[fail.Fail].err{fail.message("encode: unary op missing operands")};
    }
    val w:  u8                               = effective_width(mi.width);
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], w);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa_inst.Operand                 = rd.ok;
    val rs:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    val src: isa_inst.Operand = rs.ok;

    if (dst.kind != isa_inst.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: unary destination is not a register")};
    }

    if (!(src.kind == isa_inst.OPK_REG && src.reg == dst.reg)) {
        var mov: isa_inst.Inst = isa_inst.inst_blank();
        mov.opcode = x64.MOV;
        mov.dst    = dst;
        mov.src1   = src;
        mov.size   = w;
        mov.flags  = width_flags(mi.width);
        x64_emit.encode_inst(?mov, buf);
    }

    var op: isa_inst.Inst = isa_inst.inst_blank();
    op.dst   = dst;
    op.size  = w;
    op.flags = width_flags(mi.width);
    if (mi.opcode == lang_mir.MIR_SEL_NEG) {
        op.opcode = x64.NEG;
    }
    or {
        op.opcode = x64.XOR;
        op.src1   = isa_inst.make_imm(-1, w);
    }
    x64_emit.encode_inst(?op, buf);
    ret err[fail.Fail].ok{};
}

fun is_mir_shift(op: lang_mir.MirOpcode) bool {
    ret op == lang_mir.MIR_SEL_SHL || op == lang_mir.MIR_SEL_SHR_U || op == lang_mir.MIR_SEL_SHR_S;
}

fun mir_shift_opcode(op: lang_mir.MirOpcode) u16 {
    if (op == lang_mir.MIR_SEL_SHL)   { ret x64.SHL; }
    if (op == lang_mir.MIR_SEL_SHR_U) { ret x64.SHR; }
    ret x64.SAR;
}

fun encode_shift_mir(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, buf: *isa_encode.ByteBuf) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: shift missing value or count operand")};
    }
    val w:  u8                               = effective_width(mi.width);
    val rd: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], w);
    if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
    val dst: isa_inst.Operand                 = rd.ok;
    val rv:  res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], w);
    if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
    val value: isa_inst.Operand                 = rv.ok;
    val rc:    res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], w);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val count: isa_inst.Operand = rc.ok;

    if (dst.kind != isa_inst.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: shift destination is not a register")};
    }
    if (count.kind == isa_inst.OPK_REG && count.reg != x64.RCX::i32) {
        ret err[fail.Fail].err{fail.message("encode: shift count register is not CL")};
    }

    val skip_mov: bool = value.kind == isa_inst.OPK_REG && value.reg == dst.reg;
    if (!skip_mov) {
        var mov: isa_inst.Inst = isa_inst.inst_blank();
        mov.opcode = x64.MOV;
        mov.dst    = dst;
        mov.src1   = value;
        mov.size   = w;
        mov.flags  = width_flags(mi.width);
        x64_emit.encode_inst(?mov, buf);
    }

    var sh: isa_inst.Inst = isa_inst.inst_blank();
    sh.opcode = mir_shift_opcode(mi.opcode);
    sh.dst    = dst;
    sh.src1   = count;
    sh.size   = w;
    sh.flags  = width_flags(mi.width);
    x64_emit.encode_inst(?sh, buf);
    ret err[fail.Fail].ok{};
}

fun encode_cbr(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 3) {
        ret err[fail.Fail].err{fail.message("encode: conditional branch missing operands")};
    }
    if (mi.operands[1].kind != lang_mir.MIR_OP_BLOCK || mi.operands[2].kind != lang_mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: conditional branch target is not a block")};
    }
    val then_block: u32 = mi.operands[1].imm::u32;
    val else_block: u32 = mi.operands[2].imm::u32;

    val cwidth: u8                               = effective_width(mi.width);
    val rc:     res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], cwidth);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    val cond: isa_inst.Operand = rc.ok;

    if (cond.kind != isa_inst.OPK_REG) {
        ret err[fail.Fail].err{fail.message("encode: conditional branch condition is not a register")};
    }

    var test_inst: isa_inst.Inst = isa_inst.inst_blank();
    test_inst.opcode = x64.TEST;
    test_inst.dst    = cond;
    test_inst.src1   = cond;
    test_inst.size   = cwidth;
    test_inst.flags  = width_flags(mi.width);
    x64_emit.encode_inst(?test_inst, ?st.buf);

    val invert:    bool          = isa_encode.cbr_inverts(st, then_block, else_block);
    var taken:     u32           = then_block;
    val jne_start: usize         = st.buf.bytes.len;
    var jne:       isa_inst.Inst = isa_inst.inst_blank();
    jne.opcode = x64.JNE;
    if (invert) {
        jne.opcode = x64.JE;
        taken      = else_block;
    }
    val fp: err[fail.Fail] = flags_pair(test_inst.opcode, jne.opcode);
    if (sel fp.err) { ret fp; }
    jne.dst  = isa_inst.make_block_label(taken);
    jne.size = DEFAULT_OPERAND_SIZE;
    val jne_size: i32 = x64_emit.encode_inst(?jne, ?st.buf);
    if (jne_size <= 0) { ret err[fail.Fail].err{fail.message("encode: conditional branch failed to encode")}; }
    val jne_patch: u32            = (jne_start + (jne_size - 4)::usize)::u32;
    val jne_next:  u32            = (jne_start + jne_size::usize)::u32;
    val fj:        err[fail.Fail] = isa_encode.push_fixup(st, jne_patch, jne_next, taken, fn_base);
    if (sel fj.err) { ret err[fail.Fail].err{fj.err}; }

    if (invert || isa_encode.branch_falls_through(st, else_block)) { ret err[fail.Fail].ok{}; }
    val jmp_start: usize         = st.buf.bytes.len;
    var jmp:       isa_inst.Inst = isa_inst.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa_inst.make_block_label(else_block);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    val jmp_size: i32 = x64_emit.encode_inst(?jmp, ?st.buf);
    if (jmp_size <= 0) { ret err[fail.Fail].err{fail.message("encode: conditional branch failed to encode")}; }
    val jmp_patch: u32            = (jmp_start + (jmp_size - 4)::usize)::u32;
    val jmp_next:  u32            = (jmp_start + jmp_size::usize)::u32;
    val pushed:    err[fail.Fail] = isa_encode.push_fixup(st, jmp_patch, jmp_next, else_block, fn_base);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun fused_jcc_opcode(op: lang_mir.MirOpcode) u16 {
    if (op == lang_mir.MIR_SEL_CBR_EQ)   { ret x64.JE; }
    if (op == lang_mir.MIR_SEL_CBR_NE)   { ret x64.JNE; }
    if (op == lang_mir.MIR_SEL_CBR_LT_S) { ret x64.JL; }
    if (op == lang_mir.MIR_SEL_CBR_LT_U) { ret x64.JB; }
    if (op == lang_mir.MIR_SEL_CBR_LE_S) { ret x64.JLE; }
    ret x64.JBE;
}

fun inverse_jcc(op: u16) u16 {
    if (op == x64.JE)  { ret x64.JNE; }
    if (op == x64.JNE) { ret x64.JE; }
    if (op == x64.JL)  { ret x64.JGE; }
    if (op == x64.JGE) { ret x64.JL; }
    if (op == x64.JLE) { ret x64.JG; }
    if (op == x64.JG)  { ret x64.JLE; }
    if (op == x64.JB)  { ret x64.JAE; }
    if (op == x64.JAE) { ret x64.JB; }
    if (op == x64.JBE) { ret x64.JA; }
    ret x64.JBE;
}

fun encode_fused_cbr(st: *isa_encode.EncodeState, f: *lang_mir.MirFunction, fn_base: u32, mi: *lang_mir.MirInstr) err[fail.Fail] {
    if (mi.operand_count < 4) {
        ret err[fail.Fail].err{fail.message("encode: fused compare-branch missing operands")};
    }
    if (mi.operands[2].kind != lang_mir.MIR_OP_BLOCK || mi.operands[3].kind != lang_mir.MIR_OP_BLOCK) {
        ret err[fail.Fail].err{fail.message("encode: fused compare-branch target is not a block")};
    }
    val then_block:  u32 = mi.operands[2].imm::u32;
    val else_block:  u32 = mi.operands[3].imm::u32;
    val instr_start: u32 = st.buf.bytes.len::u32;

    val rc: res[u16, fail.Fail] = emit_flag_cmp(f, ?mi.operands[0], ?mi.operands[1], mi.width, ?st.buf);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }

    val invert:    bool          = isa_encode.cbr_inverts(st, then_block, else_block);
    var taken:     u32           = then_block;
    val jcc_start: usize         = st.buf.bytes.len;
    var jcc:       isa_inst.Inst = isa_inst.inst_blank();
    jcc.opcode = fused_jcc_opcode(mi.opcode);
    if (invert) {
        jcc.opcode = inverse_jcc(jcc.opcode);
        taken      = else_block;
    }
    val fp: err[fail.Fail] = flags_pair(rc.ok, jcc.opcode);
    if (sel fp.err) { ret fp; }
    jcc.dst  = isa_inst.make_block_label(taken);
    jcc.size = DEFAULT_OPERAND_SIZE;
    val jcc_size: i32 = x64_emit.encode_inst(?jcc, ?st.buf);
    if (jcc_size <= 0) { ret err[fail.Fail].err{fail.message("encode: fused compare-branch failed to encode")}; }
    val jcc_patch: u32            = (jcc_start + (jcc_size - 4)::usize)::u32;
    val jcc_next:  u32            = (jcc_start + jcc_size::usize)::u32;
    val fj:        err[fail.Fail] = isa_encode.push_fixup(st, jcc_patch, jcc_next, taken, fn_base);
    if (sel fj.err) { ret err[fail.Fail].err{fj.err}; }

    if (invert || isa_encode.branch_falls_through(st, else_block)) {
        isa_encode.close_cmp_varlocs(st, instr_start, st.buf.bytes.len::u32);
        ret err[fail.Fail].ok{};
    }
    val jmp_start: usize         = st.buf.bytes.len;
    var jmp:       isa_inst.Inst = isa_inst.inst_blank();
    jmp.opcode = x64.JMP;
    jmp.dst    = isa_inst.make_block_label(else_block);
    jmp.size   = DEFAULT_OPERAND_SIZE;
    val jmp_size: i32 = x64_emit.encode_inst(?jmp, ?st.buf);
    if (jmp_size <= 0) { ret err[fail.Fail].err{fail.message("encode: fused compare-branch failed to encode")}; }
    val jmp_patch: u32 = (jmp_start + (jmp_size - 4)::usize)::u32;
    val jmp_next:  u32 = (jmp_start + jmp_size::usize)::u32;
    isa_encode.close_cmp_varlocs(st, instr_start, st.buf.bytes.len::u32);
    val pushed: err[fail.Fail] = isa_encode.push_fixup(st, jmp_patch, jmp_next, else_block, fn_base);
    if (sel pushed.err) { ret err[fail.Fail].err{pushed.err}; }
    ret err[fail.Fail].ok{};
}

fun concrete_opcode(op: lang_mir.MirOpcode) u16 {
    if (op == lang_mir.MIR_MOV)  { ret x64.MOV; }
    if (op == lang_mir.MIR_CALL) { ret x64.CALL; }
    ret op::u16;
}

fun effective_width(width: u8) u8 {
    if (width == 0) { ret DEFAULT_OPERAND_SIZE; }
    ret width;
}

fun width_flags(width: u8) u16 {
    val w: u8 = effective_width(width);
    if (w >= 8) { ret x64_inst.FLAG_REX_W; }
    if (w == 2) { ret x64_inst.FLAG_16BIT; }
    ret 0;
}

fun mir_to_inst(f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr, inst: *isa_inst.Inst) err[fail.Fail] {
    val dwidth: u8 = effective_width(mi.width);
    val swidth: u8 = effective_width(mi.src_width);
    @inst       = isa_inst.inst_blank();
    inst.opcode = concrete_opcode(mi.opcode);
    # a tail call jumps where the call would have called
    if (mi.opcode == lang_mir.MIR_CALL && mi.tail) { inst.opcode = x64.JMP; }
    inst.size  = dwidth;
    inst.flags = width_flags(mi.width);

    if (mi.operand_count >= 1) {
        val r: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[0], dwidth);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        inst.dst = r.ok;
    }
    if (mi.operand_count >= 2) {
        val r: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[1], swidth);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        inst.src1 = r.ok;
    }
    if (mi.operand_count >= 3) {
        val r: res[isa_inst.Operand, fail.Fail] = mir_to_operand(f, ?mi.operands[2], swidth);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        inst.src2 = r.ok;
    }

    if (mi.operand_count >= 1 &&
        (inst.opcode == x64.CALL::u16 || inst.opcode == x64.JMP::u16) &&
        mi.operands[0].kind != lang_mir.MIR_OP_SYM &&
        mi.operands[0].kind != lang_mir.MIR_OP_BLOCK) {
        inst.flags = inst.flags | x64_inst.FLAG_INDIRECT::u16;
    }
    ret err[fail.Fail].ok{};
}

fun mir_to_operand(f: *lang_mir.MirFunction, op: *lang_mir.MirOperand, width: u8) res[isa_inst.Operand, fail.Fail] {
    if (op.kind == lang_mir.MIR_OP_PREG) {
        ret res[isa_inst.Operand, fail.Fail].ok{isa_inst.make_reg(lang_mir.preg_regid(op.preg), width)};
    }
    if (op.kind == lang_mir.MIR_OP_VREG) {
        ret res[isa_inst.Operand, fail.Fail].err{fail.message("encode: virtual register survived register allocation")};
    }
    if (op.kind == lang_mir.MIR_OP_IMM) {
        ret res[isa_inst.Operand, fail.Fail].ok{isa_inst.make_imm(op.imm, width)};
    }
    if (op.kind == lang_mir.MIR_OP_MEM) {
        var index: i32 = isa_inst.REG_NONE;
        var scale: u8  = 0;
        if (sel op.index.vreg) {
            ret res[isa_inst.Operand, fail.Fail].err{fail.message("encode: value vreg survived in a memory-operand index")};
        }
        if (sel op.index.preg) {
            index = lang_mir.preg_regid(op.index.preg);
            scale = op.scale;
        }
        var base: i32 = lang_mir.preg_regid(op.preg);
        var disp: i64 = op.imm;
        if (!lang_mir.vreg_is_nil(op.vreg)) {
            val slot: opt[i64] = lang_mir.slot_base_offset(?f.frame, op.vreg.n);
            if (!sel slot.some) {
                ret res[isa_inst.Operand, fail.Fail].err{fail.message("encode: value vreg survived in a memory-operand base")};
            }
            base = isa_encode.slot_base_reg(f, x64.RSP, x64.RBP);
            disp = slot.some + op.imm;
        }
        if (!target_model.offset_fits(32, disp)) {
            ret res[isa_inst.Operand, fail.Fail].err{fail.message("encode: x86-64 memory displacement does not fit the signed 32-bit disp32 field")};
        }
        ret res[isa_inst.Operand, fail.Fail].ok{isa_inst.make_mem(base, disp::i32, index, scale, width)};
    }
    if (op.kind == lang_mir.MIR_OP_SYM) {
        var sym: isa_inst.Operand = isa_inst.make_mem(isa_inst.REG_NONE, 0, isa_inst.REG_NONE, 0, width);
        sym.sym_id     = intern.str_index(op.sym);
        sym.sym_addend = op.sym_off;
        ret res[isa_inst.Operand, fail.Fail].ok{sym};
    }
    if (op.kind == lang_mir.MIR_OP_BLOCK) {
        ret res[isa_inst.Operand, fail.Fail].ok{isa_inst.make_block_label(op.imm::u32)};
    }
    ret res[isa_inst.Operand, fail.Fail].ok{isa_inst.make_none()};
}
