use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use lang_mir: mach.lang.mir;
use mach.lang.mir.expansion;
use mach.lang.target.isa;
use mach.lang.target.isa.arm64;
use isa_rules: mach.lang.target.isa.rules;

val RULE_COUNT: usize = 100;

val COPY_OPCODE_COUNT: usize = 3;

val FUSED_CC_COUNT: usize = 6;

pub fun select(a: *A.Allocator, tgt: *isa.BackendTarget, f: *lang_mir.MirFunction) err[fail.Fail] {
    ret isa_rules.select_function(?PACK, a, tgt, f);
}

pub fun is_reg_move(opcode: u32) bool {
    ret isa_rules.is_reg_move(?PACK, opcode);
}

pub fun is_trap_terminator(opcode: u32) bool {
    ret opcode == arm64.BRK::u32;
}

fun emit_swapped_cmp(builder: *expansion.ExpansionBuilder, opcode: u32) err[fail.Fail] {
    var ops: [3]lang_mir.MirOperand;
    ops[0] = builder.source.operands[0];
    ops[1] = builder.source.operands[2];
    ops[2] = builder.source.operands[1];
    val res_: res[*lang_mir.MirInstr, fail.Fail] = isa_rules.emit_instr(builder, opcode, ?ops[0], 3);
    if (sel res_.err) {
        ret err[fail.Fail].err{res_.err};
    }
    ret err[fail.Fail].ok{};
}

fun expand_vec_cmp_lt_s(builder: *expansion.ExpansionBuilder) err[fail.Fail] {
    ret emit_swapped_cmp(builder, arm64.VEC_CMGT::u32);
}

fun expand_vec_cmp_le_s(builder: *expansion.ExpansionBuilder) err[fail.Fail] {
    ret emit_swapped_cmp(builder, arm64.VEC_CMGE::u32);
}

fun expand_vec_cmp_lt_u(builder: *expansion.ExpansionBuilder) err[fail.Fail] {
    var opcode: u32 = arm64.VEC_CMHI::u32;
    if (lang_mir.vec_lane_kind(builder.source.vec_lane) == lang_mir.VEC_LANE_FLOAT) {
        opcode = arm64.VEC_CMGT::u32;
    }
    ret emit_swapped_cmp(builder, opcode);
}

fun expand_vec_cmp_le_u(builder: *expansion.ExpansionBuilder) err[fail.Fail] {
    var opcode: u32 = arm64.VEC_CMHS::u32;
    if (lang_mir.vec_lane_kind(builder.source.vec_lane) == lang_mir.VEC_LANE_FLOAT) {
        opcode = arm64.VEC_CMGE::u32;
    }
    ret emit_swapped_cmp(builder, opcode);
}

fun expand_vec_unsupported(builder: *expansion.ExpansionBuilder) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message("rules: unsupported vector operation on aarch64")};
}

fun guard_int_vec_lane(tgt: *isa.BackendTarget, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) bool {
    ret lang_mir.vec_lane_kind(mi.vec_lane) == lang_mir.VEC_LANE_INT;
}

