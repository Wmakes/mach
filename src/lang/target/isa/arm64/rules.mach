    isa_rules.Rule{op: lang_mir.MIR_ADD, gate: isa_rules.GATE_VECTOR, guard: nil, kind: isa_rules.RULE_RETAG, to: arm64.VEC_ADD::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_SUB, gate: isa_rules.GATE_VECTOR, guard: nil, kind: isa_rules.RULE_RETAG, to: arm64.VEC_SUB::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_MUL, gate: isa_rules.GATE_VECTOR, guard: nil, kind: isa_rules.RULE_RETAG, to: arm64.VEC_MUL::u32, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_DIV_U, gate: isa_rules.GATE_VECTOR, guard: guard_int_vec_lane, kind: isa_rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1},
    isa_rules.Rule{op: lang_mir.MIR_DIV_S, gate: isa_rules.GATE_VECTOR, guard: guard_int_vec_lane, kind: isa_rules.RULE_EXPAND, to: 0, expand: expand_vec_unsupported, expansion_length: 1},
