    isa_rules.Rule{op: lang_mir.MIR_SI_TO_FP, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
    isa_rules.Rule{op: lang_mir.MIR_UI_TO_FP, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},

    isa_rules.Rule{op: lang_mir.MIR_ASM, gate: isa_rules.GATE_ANY, guard: nil, kind: isa_rules.RULE_PASS, to: 0, expand: nil, expansion_length: 0},
};

val COPY_OPCODES: [COPY_OPCODE_COUNT]u32 = [COPY_OPCODE_COUNT]u32{
    arm64.MOV::u32,
    arm64.FMOV::u32,
    lang_mir.MIR_MOV,
};

val FUSED_CCS: [FUSED_CC_COUNT]u32 = [FUSED_CC_COUNT]u32{
    lang_mir.MIR_CMP_EQ,
    lang_mir.MIR_CMP_NE,
    lang_mir.MIR_CMP_LT_S,
    lang_mir.MIR_CMP_LT_U,
    lang_mir.MIR_CMP_LE_S,
    lang_mir.MIR_CMP_LE_U,
};

val PACK: isa_rules.RulePack = isa_rules.RulePack{
    name:               "aarch64",
    rules:              ?RULES[0],
    rule_count:         RULE_COUNT::u32,
    copy_opcodes:       ?COPY_OPCODES[0],
    copy_opcode_count:  COPY_OPCODE_COUNT::u32,
    fused_cbr_ccs:      ?FUSED_CCS[0],
    fused_cbr_cc_count: FUSED_CC_COUNT::u32,
};

fun guard_identity_copy(tgt: *isa.BackendTarget, f: *lang_mir.MirFunction, mi: *lang_mir.MirInstr) bool {
    if (mi.operand_count != 2)                           { ret false; }
    if (mi.width != 0 && mi.width < tgt.model.gpr_width) { ret false; }
    if (mi.opcode == lang_mir.MIR_BITCAST)               { ret true; }
    ret mi.src_width >= tgt.model.gpr_width;
}
