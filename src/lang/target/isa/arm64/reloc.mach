use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use target_of: mach.lang.target.of;
use mach.lang.target.of.bin;
use of_reloc: mach.lang.target.of.reloc;

pub fun is_local_got_kind(kind: target_of.RelocKind) bool {
    ret kind == target_of.RK_GOT_PAGE21 || kind == target_of.RK_GOT_LO12;
}

# b and bl encode a signed 26-bit word displacement, +-128 MiB
pub fun branch_reach(kind: target_of.RelocKind) opt[target_of.BranchReach] {
    if (kind != target_of.RK_PLT32 && kind != target_of.RK_JUMP26) { ret opt[target_of.BranchReach].none{}; }
    ret opt[target_of.BranchReach].some{target_of.BranchReach{min: -134217728, max: 134217724, align: 4}};
}

# adrp x16 / add x16, x16, lo12 / br x16: ip0 is the register aapcs64 gives a
# veneer to clobber, and adrp reaches +-4 GiB, the whole of the code
pub fun branch_thunk() target_of.BranchThunk {
    var t: target_of.BranchThunk;
    bin.write_u32_le(?t.bytes[0], 0, 0x90000010);
    bin.write_u32_le(?t.bytes[0], 4, 0x91000210);
    bin.write_u32_le(?t.bytes[0], 8, 0xD61F0200);
    t.size             = 12;
    t.align            = 4;
    t.fields[0].offset = 0;
    t.fields[0].kind   = target_of.RK_PAGE21;
    t.fields[1].offset = 4;
    t.fields[1].kind   = target_of.RK_ADD_LO12;
    t.field_count      = 2;
    ret t;
}

val ROW_COUNT: usize                   = 15;
val ROWS:      [ROW_COUNT]of_reloc.Row = [ROW_COUNT]of_reloc.Row{
    of_reloc.Row{kind: target_of.RK_ABS64, width: 8, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: of_reloc.site_abs64},
    of_reloc.Row{kind: target_of.RK_ABS32, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: of_reloc.site_abs32},
    of_reloc.Row{kind: target_of.RK_PC32, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: of_reloc.site_pcrel32},
    of_reloc.Row{kind: target_of.RK_PC64, width: 8, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: of_reloc.site_pcrel64},
    of_reloc.Row{kind: target_of.RK_PLT32, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: branch26},
    of_reloc.Row{kind: target_of.RK_JUMP26, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: branch26},
    of_reloc.Row{kind: target_of.RK_PAGE21, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: page21},
    of_reloc.Row{kind: target_of.RK_GOT_PAGE21, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: page21},
    of_reloc.Row{kind: target_of.RK_ADD_LO12, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: add_lo12},
    of_reloc.Row{kind: target_of.RK_LDST8_LO12, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: ldst_lo12},
    of_reloc.Row{kind: target_of.RK_LDST16_LO12, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: ldst_lo12},
    of_reloc.Row{kind: target_of.RK_LDST32_LO12, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: ldst_lo12},
    of_reloc.Row{kind: target_of.RK_LDST64_LO12, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: ldst_lo12},
    of_reloc.Row{kind: target_of.RK_LDST128_LO12, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: ldst_lo12},
    of_reloc.Row{kind: target_of.RK_GOT_LO12, width: 4, mode: of_reloc.ADDEND_SYMBOL, text_bias: false, apply: ldst_lo12},
};

pub fun reloc_traits(kind: target_of.RelocKind,
    section_kind: target_of.SectionKind,
    codegen_image: bool) res[of_reloc.RelocTraits, of_reloc.RelocError] {
    ret of_reloc.table_traits(?ROWS[0], ROW_COUNT, kind, section_kind, codegen_image);
}

pub fun apply_reloc(kind: target_of.RelocKind, dst: *u8, patch_off: u32, sec_len: u32,
    target: of_reloc.RelocTarget, addend: i64, patch_va: u64,
    image_base: u64) res[bool, of_reloc.RelocError] {
    ret of_reloc.table_apply(?ROWS[0], ROW_COUNT, kind, dst, patch_off, sec_len, target, addend, patch_va, image_base);
}

# b and bl: a signed 26-bit word displacement
fun branch26(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 4 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val word: u32 = bin.read_u32_le(s.dst, s.patch_off::usize);

    if ((s.kind == target_of.RK_PLT32 && (word & 0xFC000000) != 0x94000000)
        || (s.kind == target_of.RK_JUMP26 && (word & 0xFC000000) != 0x14000000)) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.INVALID_INSTRUCTION};
    }
    val displaced: res[i64, of_reloc.RelocError] =
        of_reloc.displacement(s.target.vaddr, s.addend, s.patch_va);
    if (sel displaced.err) {
        ret res[bool, of_reloc.RelocError].err{displaced.err};
    }
    val disp: i64 = displaced.ok;
    val lim:  i64 = 134217728;
    if (disp < -lim || disp >= lim || (disp & 3) != 0) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val imm26: u32 = (((disp::u64) & 0x0FFFFFFC) >> 2)::u32;
    bin.write_u32_le(s.dst, s.patch_off::usize, (word & 0xFC000000) | imm26);
    ret res[bool, of_reloc.RelocError].ok{true};
}

# adrp: the 4 KiB page of the target, pc-relative
fun page21(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 4 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val word: u32 = bin.read_u32_le(s.dst, s.patch_off::usize);

    if ((word & 0x9F000000) != 0x90000000) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.INVALID_INSTRUCTION};
    }
    val adjusted: res[u64, of_reloc.RelocError] =
        of_reloc.add_signed_to_u64(s.target.vaddr, s.addend);
    if (sel adjusted.err) {
        ret res[bool, of_reloc.RelocError].err{adjusted.err};
    }
    val tgt_page:  u64                           = adjusted.ok & ~0xFFF::u64;
    val pc_page:   u64                           = s.patch_va & ~0xFFF::u64;
    val displaced: res[i64, of_reloc.RelocError] =
        of_reloc.displacement(tgt_page, 0, pc_page);
    if (sel displaced.err) {
        ret res[bool, of_reloc.RelocError].err{displaced.err};
    }
    val delta: i64 = displaced.ok;
    val lim:   i64 = 4294967296;
    if (delta < -lim || delta >= lim) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val imm21: u32 = (((delta::u64) >> 12) & 0x1FFFFF)::u32;
    val immlo: u32 = imm21 & 0x3;
    val immhi: u32 = (imm21 >> 2) & 0x7FFFF;
    bin.write_u32_le(s.dst, s.patch_off::usize, (word & 0x9F00001F) | (immlo << 29) | (immhi << 5));
    ret res[bool, of_reloc.RelocError].ok{true};
}

# add: the low 12 bits of the target
fun add_lo12(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 4 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val word: u32 = bin.read_u32_le(s.dst, s.patch_off::usize);

    if ((word & 0x7FC00000) != 0x11000000) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.INVALID_INSTRUCTION};
    }
    val adjusted: res[u64, of_reloc.RelocError] =
        of_reloc.add_signed_to_u64(s.target.vaddr, s.addend);
    if (sel adjusted.err) {
        ret res[bool, of_reloc.RelocError].err{adjusted.err};
    }
    val abs_addr: u64 = adjusted.ok;
    val imm12:    u32 = ((abs_addr & 0xFFF)::u32);
    bin.write_u32_le(s.dst, s.patch_off::usize, (word & 0xFFC003FF) | (imm12 << 10));
    ret res[bool, of_reloc.RelocError].ok{true};
}

# a load or store: the low 12 bits of the target, scaled by the access size
fun ldst_lo12(s: *of_reloc.Site) res[bool, of_reloc.RelocError] {
    if (s.patch_off::u64 + 4 > s.sec_len::u64) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val word:  u32 = bin.read_u32_le(s.dst, s.patch_off::usize);
    val scale: i32 = ldst_lo12_scale(s.kind);
    if ((s.kind == target_of.RK_GOT_LO12 && (word & 0xFFC00000) != 0xF9400000)
        || (s.kind != target_of.RK_GOT_LO12 && ldst_instruction_scale(word) != scale)) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.INVALID_INSTRUCTION};
    }
    val adjusted: res[u64, of_reloc.RelocError] =
        of_reloc.add_signed_to_u64(s.target.vaddr, s.addend);
    if (sel adjusted.err) {
        ret res[bool, of_reloc.RelocError].err{adjusted.err};
    }
    val abs_addr:       u64 = adjusted.ok;
    val alignment_mask: u64 = (1::u64 << scale::u64) - 1;
    if ((abs_addr & alignment_mask) != 0) {
        ret res[bool, of_reloc.RelocError].err{of_reloc.OVERFLOW};
    }
    val imm12: u32 = (((abs_addr & 0xFFF) >> (scale::u64))::u32);
    bin.write_u32_le(s.dst, s.patch_off::usize, (word & 0xFFC003FF) | (imm12 << 10));
    ret res[bool, of_reloc.RelocError].ok{true};
}

fun ldst_lo12_scale(kind: target_of.RelocKind) i32 {
    if (kind == target_of.RK_LDST8_LO12)   { ret 0; }
    if (kind == target_of.RK_LDST16_LO12)  { ret 1; }
    if (kind == target_of.RK_LDST32_LO12)  { ret 2; }
    if (kind == target_of.RK_LDST64_LO12)  { ret 3; }
    if (kind == target_of.RK_LDST128_LO12) { ret 4; }
    if (kind == target_of.RK_GOT_LO12)     { ret 3; }
    ret -1;
}

fun ldst_instruction_scale(word: u32) i32 {
    if ((word & 0x3B000000) != 0x39000000) { ret -1; }
    val vector: u32 = (word >> 26) & 0x1;
    val size:   u32 = (word >> 30) & 0x3;
    val opcode: u32 = (word >> 22) & 0x3;
    if (vector == 1 && size == 0 && opcode == 3) { ret 4; }
    ret size::i32;
}
