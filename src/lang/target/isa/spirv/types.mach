use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use model_spirv: mach.lang.target.model.spirv;

use lang_source: mach.lang.source;
use isa_spirv:   mach.lang.target.isa.spirv;

rec ScalarKey {
    tag: u8;
    a:   u32;
    b:   u32;
    id:  u32;
}

rec ConstKey {
    type_id: u32;
    lo:      u32;
    hi:      u32;
    id:      u32;
}

rec FnKey {
    ret_id:      u32;
    params:      *u32;
    param_count: u32;
    id:          u32;
}

val TAG_INT:           u8 = 0;
val TAG_FLOAT:         u8 = 1;
val TAG_BOOL:          u8 = 2;
val TAG_VOID:          u8 = 3;
val TAG_PTR:           u8 = 4;
val TAG_VEC:           u8 = 5;
val TAG_ARRAY:         u8 = 6;
val TAG_NULL:          u8 = 7;
val TAG_IMAGE:         u8 = 8;
val TAG_SAMPLED_IMAGE: u8 = 9;
val TAG_SAMPLER:       u8 = 10;

pub val MAX_STRUCT_MEMBERS: u32 = 16;

rec CompositeKey {
    type_id:    u32;
    parts:      *u32;
    part_count: u32;
    id:         u32;
}

rec ShapeKey {
    id:       u32;
    members:  *u32;
    count:    u32;
    laid_out: bool;
    elems:    u32;
    is_tag:   bool;
}

# `storage_only` is set while a type is built for host-shared memory, where an 8- or
# 16-bit scalar is declared under its storage access capability: a request then raises
# no Int8, Int16 or Float16, which every other request of the width does.
# `use_loc` is the source use the emitter is building types for, and `need_loc` the
# first located use of each Builder.caps_needed bit, by bit position, which a refusal
# of the capability points at
pub rec TypeTable {
    b:            *isa_spirv.Builder;
    scalars:      Vector[ScalarKey];
    consts:       Vector[ConstKey];
    fns:          Vector[FnKey];
    comps:        Vector[CompositeKey];
    shapes:       Vector[ShapeKey];
    storage_only: bool;
    use_loc:      lang_source.Location;
    need_loc:     [64]lang_source.Location;
}

pub fun init(b: *isa_spirv.Builder) TypeTable {
    var tt: TypeTable;
    tt.b            = b;
    tt.scalars      = collections_vector.init[ScalarKey](b.alloc);
    tt.consts       = collections_vector.init[ConstKey](b.alloc);
    tt.fns          = collections_vector.init[FnKey](b.alloc);
    tt.comps        = collections_vector.init[CompositeKey](b.alloc);
    tt.shapes       = collections_vector.init[ShapeKey](b.alloc);
    tt.storage_only = false;
    tt.use_loc      = lang_source.location_nil();
    var i: u32 = 0;
    for (i < 64) {
        tt.need_loc[i] = lang_source.location_nil();
        i              = i + 1;
    }
    ret tt;
}

# raises `need` for the use types are being built for
fun raise(tt: *TypeTable, need: u64) {
    raise_at(tt, need, tt.use_loc);
}

# raises `need` for the use at `loc`, which locates each bit no earlier use located
pub fun raise_at(tt: *TypeTable, need: u64, loc: lang_source.Location) {
    tt.b.caps_needed = tt.b.caps_needed | need;
    if (!lang_source.location_is_valid(loc)) { ret; }
    var bit: u64 = 1;
    var i:   u32 = 0;
    for (i < 64) {
        if ((need & bit) != 0 && !lang_source.location_is_valid(tt.need_loc[i])) { tt.need_loc[i] = loc; }
        bit = bit << 1;
        i   = i + 1;
    }
}

# the first located use of the lowest bit of `need`, nil where no use was located
pub fun need_loc(tt: *TypeTable, need: u64) lang_source.Location {
    var bit: u64 = 1;
    var i:   u32 = 0;
    for (i < 64) {
        if ((need & bit) != 0) { ret tt.need_loc[i]; }
        bit = bit << 1;
        i   = i + 1;
    }
    ret lang_source.location_nil();
}

pub fun dnit(tt: *TypeTable) {
    var i: usize = 0;
    for (i < tt.fns.len) {
        val fk: *FnKey = ?tt.fns.data[i];
        if (fk.params != nil && fk.param_count > 0) {
            A.deallocate[u32](tt.b.alloc, fk.params, fk.param_count::usize);
        }
        i = i + 1;
    }
    var ci: usize = 0;
    for (ci < tt.comps.len) {
        val ck: *CompositeKey = ?tt.comps.data[ci];
        if (ck.parts != nil && ck.part_count > 0) {
            A.deallocate[u32](tt.b.alloc, ck.parts, ck.part_count::usize);
        }
        ci = ci + 1;
    }
    collections_vector.dnit[ScalarKey](?tt.scalars);
    collections_vector.dnit[ConstKey](?tt.consts);
    collections_vector.dnit[FnKey](?tt.fns);
    var si: usize = 0;
    for (si < tt.shapes.len) {
        val sk: *ShapeKey = ?tt.shapes.data[si];
        if (sk.members != nil) {
            var n: u32 = sk.count;
            if (n == 0) { n = 1; }
            A.deallocate[u32](tt.b.alloc, sk.members, n::usize);
        }
        si = si + 1;
    }
    collections_vector.dnit[CompositeKey](?tt.comps);
    collections_vector.dnit[ShapeKey](?tt.shapes);
}

fun shape_put(tt: *TypeTable, id: u32, members: *u32, count: u32, laid_out: bool, elems: u32) {
    shape_put_kind(tt, id, members, count, laid_out, elems, false);
}

fun shape_put_kind(tt: *TypeTable, id: u32, members: *u32, count: u32, laid_out: bool, elems: u32, tag: bool) {
    if (tt.b.err) { ret; }
    var n: u32 = count;
    if (n == 0) { n = 1; }
    val r: res[*u32, A.Error] = A.allocate[u32](tt.b.alloc, n::usize);
    if (sel r.err) {
        tt.b.err = true;
        ret;
    }
    val copy: *u32 = r.ok;
    var i:    u32  = 0;
    for (i < n) {
        copy[i] = members[i];
        i       = i + 1;
    }
    var k: ShapeKey;
    k.id       = id;
    k.members  = copy;
    k.count    = count;
    k.laid_out = laid_out;
    k.elems    = elems;
    k.is_tag   = tag;
    val push_r: res[usize, A.Error] = collections_vector.push[ShapeKey](?tt.shapes, k);
    if (sel push_r.err) {
        A.deallocate[u32](tt.b.alloc, copy, n::usize);
        tt.b.err = true;
    }
}

pub fun composite_member(tt: *TypeTable, id: u32, index: u32) u32 {
    var lanes:   u32 = 0;
    val lane_ty: u32 = vector_shape(tt, id, ?lanes);
    if (lane_ty != 0) {
        if (index >= lanes) { ret 0; }
        ret lane_ty;
    }
    var i: usize = 0;
    for (i < tt.shapes.len) {
        val k: *ShapeKey = ?tt.shapes.data[i];
        if (k.id == id) {
            if (k.count == 0)     { ret k.members[0]; }
            if (index >= k.count) { ret 0; }
            ret k.members[index];
        }
        i = i + 1;
    }
    ret 0;
}

# how many members, elements or lanes the composite `id` has, 0 when it is none or a runtime array
pub fun composite_count(tt: *TypeTable, id: u32) u32 {
    var lanes: u32 = 0;
    if (vector_shape(tt, id, ?lanes) != 0) { ret lanes; }
    val k: *ShapeKey = shape_of(tt, id);
    if (k == nil)     { ret 0; }
    if (k.count == 0) { ret k.elems; }
    ret k.count;
}

# whether a value of the type holds a pointer of storage class `storage`, which has no
# null constant
pub fun holds_pointer(tt: *TypeTable, id: u32, storage: u32) bool {
    var sc: u32 = 0;
    if (pointer_shape(tt, id, ?sc) != 0) { ret sc == storage; }
    val k: *ShapeKey = shape_of(tt, id);
    if (k == nil) { ret false; }
    var n: u32 = k.count;
    if (n == 0) { n = 1; }
    var i: u32 = 0;
    for (i < n) {
        if (holds_pointer(tt, k.members[i], storage)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun shape_of(tt: *TypeTable, id: u32) *ShapeKey {
    var i: usize = 0;
    for (i < tt.shapes.len) {
        val k: *ShapeKey = ?tt.shapes.data[i];
        if (k.id == id) { ret k; }
        i = i + 1;
    }
    ret nil;
}

# the element type of the sized array `id`, laid out or plain, with its length in
# `out_count`. 0 when it is no sized array
pub fun array_shape(tt: *TypeTable, id: u32, out_count: *u32) u32 {
    @out_count = 0;
    val k: *ShapeKey = shape_of(tt, id);
    if (k == nil || k.count != 0 || k.is_tag || k.elems == 0) { ret 0; }
    @out_count = k.elems;
    ret k.members[0];
}

pub fun logically_match(tt: *TypeTable, a: u32, b: u32) bool {
    if (a == 0 || b == 0) { ret false; }
    if (a == b)           { ret true; }
    val ka: *ShapeKey = shape_of(tt, a);
    val kb: *ShapeKey = shape_of(tt, b);
    if (ka == nil || kb == nil)                                                 { ret false; }
    if (ka.count != kb.count || ka.elems != kb.elems || ka.is_tag != kb.is_tag) { ret false; }
    var n: u32 = ka.count;
    if (n == 0) { n = 1; }
    var i: u32 = 0;
    for (i < n) {
        if (!logically_match(tt, ka.members[i], kb.members[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun scalar_find(tt: *TypeTable, tag: u8, a: u32, b: u32) u32 {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.tag == tag && k.a == a && k.b == b) { ret k.id; }
        i = i + 1;
    }
    ret 0;
}

fun scalar_put(tt: *TypeTable, tag: u8, a: u32, b: u32, id: u32) {
    if (tt.b.err) { ret; }
    var k: ScalarKey;
    k.tag = tag;
    k.a   = a;
    k.b   = b;
    k.id  = id;
    val push_r: res[usize, A.Error] = collections_vector.push[ScalarKey](?tt.scalars, k);
    if (sel push_r.err) { tt.b.err = true; }
}

pub fun type_int(tt: *TypeTable, bits: u32) u32 {
    ret int_of(tt, bits, 0);
}

# an integer whose Signedness is 1. every integer the module computes on is unsigned, and
# only the sampled type of an image of a signed format, and the values its instructions
# read and write, are signed (VUID-StandaloneSpirv-Image-04965)
pub fun type_int_signed(tt: *TypeTable, bits: u32) u32 {
    ret int_of(tt, bits, 1);
}

fun int_of(tt: *TypeTable, bits: u32, signedness: u32) u32 {
    if (tt.b.err)                                            { ret 0; }
    if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret 0; }
    if (bits == 8 && !tt.storage_only)                       { raise(tt, isa_spirv.NEED_INT8); }
    if (bits == 16 && !tt.storage_only)                      { raise(tt, isa_spirv.NEED_INT16); }
    if (bits == 64)                                          { raise(tt, isa_spirv.NEED_INT64); }
    val hit: u32 = scalar_find(tt, TAG_INT, bits, signedness);
    if (hit != 0) { ret hit; }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [3]u32;
    ops[0] = id;
    ops[1] = bits;
    ops[2] = signedness;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_INT, ?ops[0], 3);
    if (tt.b.err) { ret 0; }
    scalar_put(tt, TAG_INT, bits, signedness, id);
    if (tt.b.err) { ret 0; }
    ret id;
}

# the integer scalar `id` is, its width and signedness, false when it is none
fun int_shape(tt: *TypeTable, id: u32, out_bits: *u32, out_signed: *bool) bool {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && k.tag == TAG_INT) {
            @out_bits   = k.a;
            @out_signed = k.b != 0;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

# `id`, an integer scalar or vector, with its components signed, 0 when it is no integer
pub fun signed_twin(tt: *TypeTable, id: u32) u32 {
    var lanes: u32 = 0;
    val lane:  u32 = vector_shape(tt, id, ?lanes);
    if (lane != 0) {
        val s: u32 = signed_twin(tt, lane);
        if (s == 0) { ret 0; }
        ret type_vector(tt, s, lanes);
    }
    var bits:   u32  = 0;
    var signed: bool = false;
    if (!int_shape(tt, id, ?bits, ?signed)) { ret 0; }
    if (signed)                             { ret id; }
    ret type_int_signed(tt, bits);
}

# whether `a` is a signed integer scalar or vector that `b` is the unsigned form of, the
# same width and component count. it declares no type
pub fun signed_twins(tt: *TypeTable, a: u32, b: u32) bool {
    var la: u32 = 0;
    var lb: u32 = 0;
    val ea: u32 = vector_shape(tt, a, ?la);
    val eb: u32 = vector_shape(tt, b, ?lb);
    if (ea != 0 || eb != 0) { ret ea != 0 && eb != 0 && la == lb && signed_twins(tt, ea, eb); }
    var ba: u32  = 0;
    var bb: u32  = 0;
    var sa: bool = false;
    var sb: bool = false;
    ret int_shape(tt, a, ?ba, ?sa) && int_shape(tt, b, ?bb, ?sb) && sa && !sb && ba == bb;
}

# whether `id` is a signed integer scalar or vector
pub fun type_is_signed(tt: *TypeTable, id: u32) bool {
    var lanes: u32 = 0;
    val lane:  u32 = vector_shape(tt, id, ?lanes);
    if (lane != 0) { ret type_is_signed(tt, lane); }
    var bits:   u32  = 0;
    var signed: bool = false;
    ret int_shape(tt, id, ?bits, ?signed) && signed;
}

pub fun type_float(tt: *TypeTable, bits: u32) u32 {
    if (tt.b.err)                               { ret 0; }
    if (bits != 16 && bits != 32 && bits != 64) { ret 0; }
    if (bits == 16 && !tt.storage_only)         { raise(tt, isa_spirv.NEED_FLOAT16); }
    if (bits == 64)                             { raise(tt, isa_spirv.NEED_FLOAT64); }
    val hit: u32 = scalar_find(tt, TAG_FLOAT, bits, 0);
    if (hit != 0) { ret hit; }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [2]u32;
    ops[0] = id;
    ops[1] = bits;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_FLOAT, ?ops[0], 2);
    if (tt.b.err) { ret 0; }
    scalar_put(tt, TAG_FLOAT, bits, 0, id);
    if (tt.b.err) { ret 0; }
    ret id;
}

pub fun type_bool(tt: *TypeTable) u32 {
    if (tt.b.err) { ret 0; }
    val hit: u32 = scalar_find(tt, TAG_BOOL, 0, 0);
    if (hit != 0) { ret hit; }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [1]u32;
    ops[0] = id;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_BOOL, ?ops[0], 1);
    if (tt.b.err) { ret 0; }
    scalar_put(tt, TAG_BOOL, 0, 0, id);
    if (tt.b.err) { ret 0; }
    ret id;
}

pub fun type_void(tt: *TypeTable) u32 {
    if (tt.b.err) { ret 0; }
    val hit: u32 = scalar_find(tt, TAG_VOID, 0, 0);
    if (hit != 0) { ret hit; }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [1]u32;
    ops[0] = id;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_VOID, ?ops[0], 1);
    if (tt.b.err) { ret 0; }
    scalar_put(tt, TAG_VOID, 0, 0, id);
    if (tt.b.err) { ret 0; }
    ret id;
}

pub fun type_vector(tt: *TypeTable, elem: u32, count: u32) u32 {
    if (tt.b.err)                                               { ret 0; }
    if (count < 2 || count > model_spirv.MAX_VECTOR_COMPONENTS) { ret 0; }
    val hit: u32 = scalar_find(tt, TAG_VEC, elem, count);
    if (hit != 0) { ret hit; }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [3]u32;
    ops[0] = id;
    ops[1] = elem;
    ops[2] = count;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_VECTOR, ?ops[0], 3);
    if (tt.b.err) { ret 0; }
    scalar_put(tt, TAG_VEC, elem, count, id);
    if (tt.b.err) { ret 0; }
    ret id;
}

pub fun vector_shape(tt: *TypeTable, id: u32, out_count: *u32) u32 {
    @out_count = 0;
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && k.tag == TAG_VEC) {
            @out_count = k.b;
            ret k.a;
        }
        i = i + 1;
    }
    ret 0;
}

pub fun type_vector_value(tt: *TypeTable, elem: u32, count: u32) u32 {
    if (count < 2)                                  { ret 0; }
    if (count <= model_spirv.MAX_VECTOR_COMPONENTS) { ret type_vector(tt, elem, count); }
    ret type_array(tt, elem, count, false);
}

pub fun vector_value_shape(tt: *TypeTable, id: u32, out_count: *u32) u32 {
    val packed: u32 = vector_shape(tt, id, out_count);
    if (packed != 0) { ret packed; }
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && k.tag == TAG_ARRAY) {
            @out_count = k.b;
            ret k.a;
        }
        i = i + 1;
    }
    @out_count = 0;
    ret 0;
}

pub fun type_array(tt: *TypeTable, elem: u32, count: u32, explicit_layout: bool) u32 {
    if (tt.b.err)   { ret 0; }
    if (count == 0) { ret 0; }
    if (!explicit_layout) {
        val hit: u32 = scalar_find(tt, TAG_ARRAY, elem, count);
        if (hit != 0) { ret hit; }
    }
    val len_id: u32 = const_int(tt, 32, count::i64);
    if (tt.b.err || len_id == 0) { ret 0; }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [3]u32;
    ops[0] = id;
    ops[1] = elem;
    ops[2] = len_id;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_ARRAY, ?ops[0], 3);
    if (tt.b.err) { ret 0; }
    if (!explicit_layout) {
        scalar_put(tt, TAG_ARRAY, elem, count, id);
        if (tt.b.err) { ret 0; }
    }
    var el: [1]u32;
    el[0] = elem;
    shape_put(tt, id, ?el[0], 0, explicit_layout, count);
    if (tt.b.err) {
        if (!explicit_layout) { collections_vector.truncate[ScalarKey](?tt.scalars, tt.scalars.len - 1); }
        ret 0;
    }
    ret id;
}

pub fun type_struct(tt: *TypeTable, members: *u32, n: u32, explicit_layout: bool) u32 {
    if (tt.b.err)                         { ret 0; }
    if (n == 0 || n > MAX_STRUCT_MEMBERS) { ret 0; }
    if (!explicit_layout) {
        var si: usize = 0;
        for (si < tt.shapes.len) {
            val k: *ShapeKey = ?tt.shapes.data[si];
            if (!k.laid_out && !k.is_tag && k.count == n && params_equal(k.members, members, n)) { ret k.id; }
            si = si + 1;
        }
    }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [17]u32;
    ops[0] = id;
    var i: u32 = 0;
    for (i < n) {
        ops[1 + i] = members[i];
        i          = i + 1;
    }
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_STRUCT, ?ops[0], n + 1);
    if (tt.b.err) { ret 0; }
    shape_put(tt, id, members, n, explicit_layout, 0);
    if (tt.b.err) { ret 0; }
    ret id;
}

# a tag's composite: member 0 is the declared discriminator and member 1 + c is case c's payload
# (the unit composite when the case has none). it is interned apart from a record with the
# same member list so the emitter can map a case index to its ordinal from the type alone.
pub fun type_tag_struct(tt: *TypeTable, members: *u32, n: u32) u32 {
    if (tt.b.err)                        { ret 0; }
    if (n < 2 || n > MAX_STRUCT_MEMBERS) { ret 0; }
    var si: usize = 0;
    for (si < tt.shapes.len) {
        val k: *ShapeKey = ?tt.shapes.data[si];
        if (k.is_tag && k.count == n && params_equal(k.members, members, n)) { ret k.id; }
        si = si + 1;
    }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [17]u32;
    ops[0] = id;
    var i: u32 = 0;
    for (i < n) {
        ops[1 + i] = members[i];
        i          = i + 1;
    }
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_STRUCT, ?ops[0], n + 1);
    if (tt.b.err) { ret 0; }
    shape_put_kind(tt, id, members, n, false, 0, true);
    if (tt.b.err) { ret 0; }
    ret id;
}

# the empty composite a payloadless case holds
pub fun type_unit(tt: *TypeTable) u32 {
    if (tt.b.err) { ret 0; }
    var si: usize = 0;
    for (si < tt.shapes.len) {
        val k: *ShapeKey = ?tt.shapes.data[si];
        if (!k.laid_out && !k.is_tag && k.count == 0 && k.elems == 0) { ret k.id; }
        si = si + 1;
    }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [1]u32;
    ops[0] = id;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_STRUCT, ?ops[0], 1);
    if (tt.b.err) { ret 0; }
    var none: [1]u32;
    none[0] = 0;
    shape_put(tt, id, ?none[0], 0, false, 0);
    if (tt.b.err) { ret 0; }
    ret id;
}

# a struct or array: something an access chain descends into
pub fun is_composite(tt: *TypeTable, id: u32) bool {
    ret shape_of(tt, id) != nil;
}

pub fun type_image(tt: *TypeTable, sampled: u32, dim: u32, depth: u32, arrayed: u32,
    ms: u32, sampled_op: u32, format: u32) u32 {
    if (tt.b.err) { ret 0; }
    val key: u32 = dim | (depth << 4) | (arrayed << 8) | (ms << 12) | (sampled_op << 16) | (format << 20);
    val hit: u32 = scalar_find(tt, TAG_IMAGE, key, sampled);
    if (hit != 0) { ret hit; }
    # a storage image's dimensionality capability is the Image form, which implies the Sampled one
    val storage: bool = sampled_op == isa_spirv.IMAGE_SAMPLED_STORAGE;
    if (dim == isa_spirv.DIM_1D) {
        if (storage) { raise(tt, isa_spirv.NEED_IMAGE_1D); }
        or           { raise(tt, isa_spirv.NEED_SAMPLED_1D); }
    }
    if (dim == isa_spirv.DIM_CUBE && arrayed != 0) {
        if (storage) { raise(tt, isa_spirv.NEED_IMAGE_CUBE_ARRAY); }
        or           { raise(tt, isa_spirv.NEED_SAMPLED_CUBE_ARRAY); }
    }
    if (dim == isa_spirv.DIM_BUFFER) {
        if (storage) { raise(tt, isa_spirv.NEED_IMAGE_BUFFER); }
        or           { raise(tt, isa_spirv.NEED_SAMPLED_BUFFER); }
    }
    # R64ui and R64i are declared under Int64ImageEXT, which their image's global requires
    if (format != isa_spirv.IMAGE_FORMAT_UNKNOWN && format <= isa_spirv.IMAGE_FORMAT_LAST_UINT && !isa_spirv.image_format_is_base(format)) {
        raise(tt, isa_spirv.NEED_STORAGE_EXTENDED_FORMATS);
    }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [8]u32;
    ops[0] = id;
    ops[1] = sampled;
    ops[2] = dim;
    ops[3] = depth;
    ops[4] = arrayed;
    ops[5] = ms;
    ops[6] = sampled_op;
    ops[7] = format;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_IMAGE, ?ops[0], 8);
    if (tt.b.err) { ret 0; }
    scalar_put(tt, TAG_IMAGE, key, sampled, id);
    if (tt.b.err) { ret 0; }
    ret id;
}

pub fun type_sampled_image(tt: *TypeTable, image: u32) u32 {
    if (tt.b.err) { ret 0; }
    val hit: u32 = scalar_find(tt, TAG_SAMPLED_IMAGE, image, 0);
    if (hit != 0) { ret hit; }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [2]u32;
    ops[0] = id;
    ops[1] = image;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_SAMPLED_IMAGE, ?ops[0], 2);
    if (tt.b.err) { ret 0; }
    scalar_put(tt, TAG_SAMPLED_IMAGE, image, 0, id);
    if (tt.b.err) { ret 0; }
    ret id;
}

pub fun type_sampler(tt: *TypeTable) u32 {
    if (tt.b.err) { ret 0; }
    val hit: u32 = scalar_find(tt, TAG_SAMPLER, 0, 0);
    if (hit != 0) { ret hit; }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [1]u32;
    ops[0] = id;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_SAMPLER, ?ops[0], 1);
    if (tt.b.err) { ret 0; }
    scalar_put(tt, TAG_SAMPLER, 0, 0, id);
    if (tt.b.err) { ret 0; }
    ret id;
}

pub fun type_is_opaque(tt: *TypeTable, id: u32) bool {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && (k.tag == TAG_IMAGE || k.tag == TAG_SAMPLED_IMAGE || k.tag == TAG_SAMPLER)) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

pub fun type_ptr(tt: *TypeTable, storage: u32, pointee: u32) u32 {
    if (tt.b.err) { ret 0; }
    val hit: u32 = scalar_find(tt, TAG_PTR, storage, pointee);
    if (hit != 0) { ret hit; }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [3]u32;
    ops[0] = id;
    ops[1] = storage;
    ops[2] = pointee;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_POINTER, ?ops[0], 3);
    if (tt.b.err) { ret 0; }
    scalar_put(tt, TAG_PTR, storage, pointee, id);
    if (tt.b.err) { ret 0; }
    ret id;
}

# declares the pointer `id` reserved for a record a cycle of pointers reaches, once the
# record is declared, so a later request for the same pointer finds it
pub fun type_ptr_at(tt: *TypeTable, id: u32, storage: u32, pointee: u32) u32 {
    if (tt.b.err) { ret 0; }
    var ops: [3]u32;
    ops[0] = id;
    ops[1] = storage;
    ops[2] = pointee;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_POINTER, ?ops[0], 3);
    if (tt.b.err) { ret 0; }
    scalar_put(tt, TAG_PTR, storage, pointee, id);
    if (tt.b.err) { ret 0; }
    ret id;
}

# names the pointer `id` before its record is declared, for a member of that record's cycle
pub fun type_forward_pointer(tt: *TypeTable, id: u32, storage: u32) {
    var ops: [2]u32;
    ops[0] = id;
    ops[1] = storage;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_FORWARD_POINTER, ?ops[0], 2);
}

pub fun pointer_shape(tt: *TypeTable, id: u32, storage: *u32) u32 {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && k.tag == TAG_PTR) {
            @storage = k.a;
            ret k.b;
        }
        i = i + 1;
    }
    ret 0;
}

pub fun instruction_operands_fit(fixed: u32, variable: u32) bool {
    ret fixed <= 65534 && variable <= 65534 - fixed;
}

pub fun type_fn(tt: *TypeTable, ret_id: u32, params: *u32, n: u32) u32 {
    if (tt.b.err)                        { ret 0; }
    if (!instruction_operands_fit(2, n)) { ret 0; }

    var i: usize = 0;
    for (i < tt.fns.len) {
        val k: *FnKey = ?tt.fns.data[i];
        if (k.ret_id == ret_id && k.param_count == n && params_equal(k.params, params, n)) {
            ret k.id;
        }
        i = i + 1;
    }

    val id: u32                = isa_spirv.alloc_id(tt.b);
    val ar: res[*u32, A.Error] = A.allocate[u32](tt.b.alloc, (n + 2)::usize);
    if (sel ar.err) {
        tt.b.err = true;
        ret 0;
    }
    val ops: *u32 = ar.ok;
    fin { A.deallocate[u32](tt.b.alloc, ops, (n + 2)::usize); }
    ops[0] = id;
    ops[1] = ret_id;
    var pi: u32 = 0;
    for (pi < n) {
        ops[2 + pi] = params[pi];
        pi          = pi + 1;
    }
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_TYPE_FUNCTION, ?ops[0], n + 2);
    if (tt.b.err) { ret 0; }

    var copy: *u32 = nil;
    if (n > 0) {
        val rc: res[*u32, A.Error] = A.allocate[u32](tt.b.alloc, n::usize);
        if (sel rc.err) {
            tt.b.err = true;
            ret 0;
        }
        copy = rc.ok;
        var ci: u32 = 0;
        for (ci < n) {
            copy[ci] = params[ci];
            ci       = ci + 1;
        }
    }
    var fk: FnKey;
    fk.ret_id      = ret_id;
    fk.params      = copy;
    fk.param_count = n;
    fk.id          = id;
    val push_r: res[usize, A.Error] = collections_vector.push[FnKey](?tt.fns, fk);
    if (sel push_r.err) {
        if (copy != nil && n > 0) { A.deallocate[u32](tt.b.alloc, copy, n::usize); }
        tt.b.err = true;
    }
    if (tt.b.err) { ret 0; }
    ret id;
}

fun params_equal(a: *u32, b: *u32, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun type_bits(tt: *TypeTable, id: u32) u32 {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && (k.tag == TAG_INT || k.tag == TAG_FLOAT)) { ret k.a; }
        i = i + 1;
    }
    ret 0;
}

pub fun type_is_float(tt: *TypeTable, id: u32) bool {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && k.tag == TAG_FLOAT) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun const_scalar(tt: *TypeTable, type_id: u32, lo: u32, hi: u32) u32 {
    if (tt.b.err)     { ret 0; }
    if (type_id == 0) { ret 0; }
    constant_needs(tt, type_id);
    val bits: u32  = type_bits(tt, type_id);
    val wide: bool = bits > 32;
    var high: u32  = 0;
    if (wide) { high = hi; }
    # a narrower scalar's literal word carries its bits zero-extended: every
    # integer type is unsigned, and a sign-extended pattern is invalid
    var word: u32 = lo;
    if (bits > 0 && bits < 32) { word = lo & ((1::u32 << bits) - 1); }

    var i: usize = 0;
    for (i < tt.consts.len) {
        val k: *ConstKey = ?tt.consts.data[i];
        if (k.type_id == type_id && k.lo == word && k.hi == high) { ret k.id; }
        i = i + 1;
    }

    val id: u32 = isa_spirv.alloc_id(tt.b);
    if (wide) {
        var ops: [4]u32;
        ops[0] = type_id;
        ops[1] = id;
        ops[2] = word;
        ops[3] = high;
        isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_CONSTANT, ?ops[0], 4);
    }
    or {
        var ops: [3]u32;
        ops[0] = type_id;
        ops[1] = id;
        ops[2] = word;
        isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_CONSTANT, ?ops[0], 3);
    }
    if (tt.b.err) { ret 0; }

    var k: ConstKey;
    k.type_id = type_id;
    k.lo      = word;
    k.hi      = high;
    k.id      = id;
    val push_r: res[usize, A.Error] = collections_vector.push[ConstKey](?tt.consts, k);
    if (sel push_r.err) { tt.b.err = true; }
    if (tt.b.err)       { ret 0; }
    ret id;
}

pub fun const_composite(tt: *TypeTable, type_id: u32, parts: *u32, n: u32) u32 {
    if (tt.b.err) { ret 0; }
    if (n == 0)   { ret 0; }

    var i: usize = 0;
    for (i < tt.comps.len) {
        val k: *CompositeKey = ?tt.comps.data[i];
        if (k.type_id == type_id && k.part_count == n && params_equal(k.parts, parts, n)) {
            ret k.id;
        }
        i = i + 1;
    }

    val id: u32                = isa_spirv.alloc_id(tt.b);
    val ro: res[*u32, A.Error] = A.allocate[u32](tt.b.alloc, (n + 2)::usize);
    if (sel ro.err) {
        tt.b.err = true;
        ret 0;
    }
    val ops: *u32 = ro.ok;
    ops[0] = type_id;
    ops[1] = id;
    var pi: u32 = 0;
    for (pi < n) {
        ops[2 + pi] = parts[pi];
        pi          = pi + 1;
    }
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_CONSTANT_COMPOSITE, ops, n + 2);
    A.deallocate[u32](tt.b.alloc, ops, (n + 2)::usize);
    if (tt.b.err) { ret 0; }

    var copy: *u32               = nil;
    val rc:   res[*u32, A.Error] = A.allocate[u32](tt.b.alloc, n::usize);
    if (sel rc.err) {
        tt.b.err = true;
        ret 0;
    }
    copy = rc.ok;
    var ci: u32 = 0;
    for (ci < n) {
        copy[ci] = parts[ci];
        ci       = ci + 1;
    }

    var k: CompositeKey;
    k.type_id    = type_id;
    k.parts      = copy;
    k.part_count = n;
    k.id         = id;
    val push_r: res[usize, A.Error] = collections_vector.push[CompositeKey](?tt.comps, k);
    if (sel push_r.err) {
        A.deallocate[u32](tt.b.alloc, copy, n::usize);
        tt.b.err = true;
    }
    if (tt.b.err) { ret 0; }
    ret id;
}

pub fun type_is_bool(tt: *TypeTable, id: u32) bool {
    var i: usize = 0;
    for (i < tt.scalars.len) {
        val k: *ScalarKey = ?tt.scalars.data[i];
        if (k.id == id && k.tag == TAG_BOOL) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun const_bool(tt: *TypeTable, value: bool) u32 {
    if (tt.b.err) { ret 0; }
    val type_id: u32 = type_bool(tt);
    if (tt.b.err || type_id == 0) { ret 0; }
    var lo: u32 = 0;
    if (value) { lo = 1; }

    var i: usize = 0;
    for (i < tt.consts.len) {
        val k: *ConstKey = ?tt.consts.data[i];
        if (k.type_id == type_id && k.lo == lo && k.hi == 0) { ret k.id; }
        i = i + 1;
    }

    val id:     u32 = isa_spirv.alloc_id(tt.b);
    var opcode: u32 = isa_spirv.OP_CONSTANT_FALSE;
    if (value) { opcode = isa_spirv.OP_CONSTANT_TRUE; }
    var ops: [2]u32;
    ops[0] = type_id;
    ops[1] = id;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, opcode, ?ops[0], 2);
    if (tt.b.err) { ret 0; }

    var k: ConstKey;
    k.type_id = type_id;
    k.lo      = lo;
    k.hi      = 0;
    k.id      = id;
    val push_r: res[usize, A.Error] = collections_vector.push[ConstKey](?tt.consts, k);
    if (sel push_r.err) { tt.b.err = true; }
    if (tt.b.err)       { ret 0; }
    ret id;
}

# a constant of an 8- or 16-bit type, or of a composite holding one, needs the arithmetic
# capability of its width, which a storage access capability does not bring
fun constant_needs(tt: *TypeTable, type_id: u32) {
    var lanes: u32 = 0;
    val lane:  u32 = vector_shape(tt, type_id, ?lanes);
    if (lane != 0) {
        constant_needs(tt, lane);
        ret;
    }
    val k: *ShapeKey = shape_of(tt, type_id);
    if (k != nil) {
        var n: u32 = k.count;
        if (n == 0 && k.elems > 0) { n = 1; }
        var i: u32 = 0;
        for (i < n) {
            constant_needs(tt, k.members[i]);
            i = i + 1;
        }
        ret;
    }
    val bits: u32 = type_bits(tt, type_id);
    if (bits != 8 && bits != 16)    { ret; }
    if (type_is_float(tt, type_id)) { raise(tt, isa_spirv.NEED_FLOAT16); }
    or (bits == 8)                  { raise(tt, isa_spirv.NEED_INT8); }
    or                              { raise(tt, isa_spirv.NEED_INT16); }
}

pub fun const_null(tt: *TypeTable, type_id: u32) u32 {
    if (tt.b.err) { ret 0; }
    constant_needs(tt, type_id);
    val hit: u32 = scalar_find(tt, TAG_NULL, type_id, 0);
    if (hit != 0) { ret hit; }
    val id:  u32 = isa_spirv.alloc_id(tt.b);
    var ops: [2]u32;
    ops[0] = type_id;
    ops[1] = id;
    isa_spirv.inst(tt.b, ?tt.b.types_consts, isa_spirv.OP_CONSTANT_NULL, ?ops[0], 2);
    if (tt.b.err) { ret 0; }
    scalar_put(tt, TAG_NULL, type_id, 0, id);
    if (tt.b.err) { ret 0; }
    ret id;
}

pub fun const_int(tt: *TypeTable, bits: u32, value: i64) u32 {
    val type_id: u32 = type_int(tt, bits);
    if (tt.b.err || type_id == 0) { ret 0; }
    ret const_scalar(tt, type_id, pattern_lo(value::u64), pattern_hi(value::u64));
}

fun pattern_lo(v: u64) u32 {
    ret (v & 0xFFFFFFFF)::u32;
}

fun pattern_hi(v: u64) u32 {
    ret ((v >> 32) & 0xFFFFFFFF)::u32;
}
