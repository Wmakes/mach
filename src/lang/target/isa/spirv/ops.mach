use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use lang_mir:  mach.lang.mir;
use isa_spirv: mach.lang.target.isa.spirv;

# the core value instructions the emitter forms from a MIR opcode: one row
# per SPIR-V opcode with the id operands it takes after `<result type>
# <result id>`. every row carries a result type and a result id, so an
# instruction's word count is a table read and never a literal beside a
# call. the structural instructions (loads, stores, composites, control
# flow) take variable or context-shaped operands and are formed where their
# shape is decided
pub rec CoreOp {
    opcode: u32;
    name:   str;
    arity:  u8;
}

val CORE_COUNT: usize = 41;

val CORE: [CORE_COUNT]CoreOp = [CORE_COUNT]CoreOp{
    CoreOp{opcode: isa_spirv.OP_I_ADD, name: "OpIAdd", arity: 2},
    CoreOp{opcode: isa_spirv.OP_F_ADD, name: "OpFAdd", arity: 2},
    CoreOp{opcode: isa_spirv.OP_I_SUB, name: "OpISub", arity: 2},
    CoreOp{opcode: isa_spirv.OP_F_SUB, name: "OpFSub", arity: 2},
    CoreOp{opcode: isa_spirv.OP_I_MUL, name: "OpIMul", arity: 2},
    CoreOp{opcode: isa_spirv.OP_F_MUL, name: "OpFMul", arity: 2},
    CoreOp{opcode: isa_spirv.OP_U_DIV, name: "OpUDiv", arity: 2},
    CoreOp{opcode: isa_spirv.OP_S_DIV, name: "OpSDiv", arity: 2},
    CoreOp{opcode: isa_spirv.OP_F_DIV, name: "OpFDiv", arity: 2},
    CoreOp{opcode: isa_spirv.OP_U_MOD, name: "OpUMod", arity: 2},
    CoreOp{opcode: isa_spirv.OP_S_REM, name: "OpSRem", arity: 2},
    CoreOp{opcode: isa_spirv.OP_F_REM, name: "OpFRem", arity: 2},
    CoreOp{opcode: isa_spirv.OP_BITWISE_AND, name: "OpBitwiseAnd", arity: 2},
    CoreOp{opcode: isa_spirv.OP_BITWISE_OR, name: "OpBitwiseOr", arity: 2},
    CoreOp{opcode: isa_spirv.OP_BITWISE_XOR, name: "OpBitwiseXor", arity: 2},
    CoreOp{opcode: isa_spirv.OP_SHIFT_LEFT_LOGICAL, name: "OpShiftLeftLogical", arity: 2},
    CoreOp{opcode: isa_spirv.OP_SHIFT_RIGHT_LOGICAL, name: "OpShiftRightLogical", arity: 2},
    CoreOp{opcode: isa_spirv.OP_SHIFT_RIGHT_ARITHMETIC, name: "OpShiftRightArithmetic", arity: 2},
    CoreOp{opcode: isa_spirv.OP_S_NEGATE, name: "OpSNegate", arity: 1},
    CoreOp{opcode: isa_spirv.OP_F_NEGATE, name: "OpFNegate", arity: 1},
    CoreOp{opcode: isa_spirv.OP_NOT, name: "OpNot", arity: 1},
    CoreOp{opcode: isa_spirv.OP_I_EQUAL, name: "OpIEqual", arity: 2},
    CoreOp{opcode: isa_spirv.OP_I_NOT_EQUAL, name: "OpINotEqual", arity: 2},
    CoreOp{opcode: isa_spirv.OP_U_LESS_THAN, name: "OpULessThan", arity: 2},
    CoreOp{opcode: isa_spirv.OP_S_LESS_THAN, name: "OpSLessThan", arity: 2},
    CoreOp{opcode: isa_spirv.OP_U_LESS_THAN_EQUAL, name: "OpULessThanEqual", arity: 2},
    CoreOp{opcode: isa_spirv.OP_S_LESS_THAN_EQUAL, name: "OpSLessThanEqual", arity: 2},
    CoreOp{opcode: isa_spirv.OP_F_ORD_EQUAL, name: "OpFOrdEqual", arity: 2},
    CoreOp{opcode: isa_spirv.OP_F_UNORD_NOT_EQUAL, name: "OpFUnordNotEqual", arity: 2},
    CoreOp{opcode: isa_spirv.OP_F_ORD_LESS_THAN, name: "OpFOrdLessThan", arity: 2},
    CoreOp{opcode: isa_spirv.OP_F_ORD_GREATER_THAN, name: "OpFOrdGreaterThan", arity: 2},
    CoreOp{opcode: isa_spirv.OP_F_ORD_LESS_THAN_EQUAL, name: "OpFOrdLessThanEqual", arity: 2},
    CoreOp{opcode: isa_spirv.OP_F_ORD_GREATER_THAN_EQUAL, name: "OpFOrdGreaterThanEqual", arity: 2},
    CoreOp{opcode: isa_spirv.OP_U_CONVERT, name: "OpUConvert", arity: 1},
    CoreOp{opcode: isa_spirv.OP_S_CONVERT, name: "OpSConvert", arity: 1},
    CoreOp{opcode: isa_spirv.OP_F_CONVERT, name: "OpFConvert", arity: 1},
    CoreOp{opcode: isa_spirv.OP_CONVERT_F_TO_S, name: "OpConvertFToS", arity: 1},
    CoreOp{opcode: isa_spirv.OP_CONVERT_F_TO_U, name: "OpConvertFToU", arity: 1},
    CoreOp{opcode: isa_spirv.OP_CONVERT_S_TO_F, name: "OpConvertSToF", arity: 1},
    CoreOp{opcode: isa_spirv.OP_CONVERT_U_TO_F, name: "OpConvertUToF", arity: 1},
    CoreOp{opcode: isa_spirv.OP_BITCAST, name: "OpBitcast", arity: 1},
};

val CORE_NONE: CoreOp = CoreOp{opcode: 0, name: nil, arity: 0};

# the row of a core value opcode; the blank row for an opcode outside the
# table, whose arity of 0 no emitter shape accepts
pub fun core(opcode: u32) *CoreOp {
    var i: usize = 0;
    for (i < CORE_COUNT) {
        if (CORE[i].opcode == opcode) { ret ?CORE[i]; }
        i = i + 1;
    }
    ret ?CORE_NONE;
}

# the operand words of a core value instruction: result type, result id and
# the row's operands. the encoded word count is one more
pub fun operand_words(row: *CoreOp) u32 {
    ret 2 + row.arity::u32;
}

# how a MIR opcode reaches SPIR-V: the emitter shape that forms the
# instruction and the opcode for each lane class. an opcode with no float
# pairing names the same opcode in both columns
pub def Shape: u8;

# <type> <result> a b, result typed as the destination
pub val SH_BINARY: Shape = 1;
# <type> <result> a, result typed as the destination
pub val SH_UNARY: Shape = 2;
# <bool> <result> a b, operands at the comparison width
pub val SH_COMPARE: Shape = 3;
# <type> <result> a, the source typed from `src_float` when its operand
# carries no type of its own
val SH_CONVERT: Shape = 4;
# <type> <result> base shift, result and base typed as the destination while
# the shift keeps its own integer type: SPIR-V lets the shift's bit width
# differ from the base's, and mach types a count by its own operand
pub val SH_SHIFT: Shape = 5;

pub rec MirMap {
    mir:       lang_mir.MirOpcode;
    shape:     Shape;
    int_op:    u32;
    float_op:  u32;
    src_float: bool;
}

val MAP_COUNT: usize = 36;

val MAP: [MAP_COUNT]MirMap = [MAP_COUNT]MirMap{
    MirMap{mir: lang_mir.MIR_ADD, shape: SH_BINARY, int_op: isa_spirv.OP_I_ADD, float_op: isa_spirv.OP_F_ADD, src_float: false},
    MirMap{mir: lang_mir.MIR_SUB, shape: SH_BINARY, int_op: isa_spirv.OP_I_SUB, float_op: isa_spirv.OP_F_SUB, src_float: false},
    MirMap{mir: lang_mir.MIR_MUL, shape: SH_BINARY, int_op: isa_spirv.OP_I_MUL, float_op: isa_spirv.OP_F_MUL, src_float: false},
    MirMap{mir: lang_mir.MIR_DIV_S, shape: SH_BINARY, int_op: isa_spirv.OP_S_DIV, float_op: isa_spirv.OP_F_DIV, src_float: false},
    MirMap{mir: lang_mir.MIR_DIV_U, shape: SH_BINARY, int_op: isa_spirv.OP_U_DIV, float_op: isa_spirv.OP_F_DIV, src_float: false},
    MirMap{mir: lang_mir.MIR_REM_S, shape: SH_BINARY, int_op: isa_spirv.OP_S_REM, float_op: isa_spirv.OP_F_REM, src_float: false},
    MirMap{mir: lang_mir.MIR_REM_U, shape: SH_BINARY, int_op: isa_spirv.OP_U_MOD, float_op: isa_spirv.OP_F_REM, src_float: false},
    MirMap{mir: lang_mir.MIR_AND, shape: SH_BINARY, int_op: isa_spirv.OP_BITWISE_AND, float_op: isa_spirv.OP_BITWISE_AND, src_float: false},
    MirMap{mir: lang_mir.MIR_OR, shape: SH_BINARY, int_op: isa_spirv.OP_BITWISE_OR, float_op: isa_spirv.OP_BITWISE_OR, src_float: false},
    MirMap{mir: lang_mir.MIR_XOR, shape: SH_BINARY, int_op: isa_spirv.OP_BITWISE_XOR, float_op: isa_spirv.OP_BITWISE_XOR, src_float: false},
    MirMap{mir: lang_mir.MIR_SHL, shape: SH_SHIFT, int_op: isa_spirv.OP_SHIFT_LEFT_LOGICAL, float_op: isa_spirv.OP_SHIFT_LEFT_LOGICAL, src_float: false},
    MirMap{mir: lang_mir.MIR_SHR_U, shape: SH_SHIFT, int_op: isa_spirv.OP_SHIFT_RIGHT_LOGICAL, float_op: isa_spirv.OP_SHIFT_RIGHT_LOGICAL, src_float: false},
    MirMap{mir: lang_mir.MIR_SHR_S, shape: SH_SHIFT, int_op: isa_spirv.OP_SHIFT_RIGHT_ARITHMETIC, float_op: isa_spirv.OP_SHIFT_RIGHT_ARITHMETIC, src_float: false},

    MirMap{mir: lang_mir.MIR_FADD, shape: SH_BINARY, int_op: isa_spirv.OP_F_ADD, float_op: isa_spirv.OP_F_ADD, src_float: false},
    MirMap{mir: lang_mir.MIR_FSUB, shape: SH_BINARY, int_op: isa_spirv.OP_F_SUB, float_op: isa_spirv.OP_F_SUB, src_float: false},
    MirMap{mir: lang_mir.MIR_FMUL, shape: SH_BINARY, int_op: isa_spirv.OP_F_MUL, float_op: isa_spirv.OP_F_MUL, src_float: false},
    MirMap{mir: lang_mir.MIR_FDIV, shape: SH_BINARY, int_op: isa_spirv.OP_F_DIV, float_op: isa_spirv.OP_F_DIV, src_float: false},

    MirMap{mir: lang_mir.MIR_NEG, shape: SH_UNARY, int_op: isa_spirv.OP_S_NEGATE, float_op: isa_spirv.OP_F_NEGATE, src_float: false},
    MirMap{mir: lang_mir.MIR_NOT, shape: SH_UNARY, int_op: isa_spirv.OP_NOT, float_op: isa_spirv.OP_NOT, src_float: false},
    MirMap{mir: lang_mir.MIR_FNEG, shape: SH_UNARY, int_op: isa_spirv.OP_F_NEGATE, float_op: isa_spirv.OP_F_NEGATE, src_float: false},

    MirMap{mir: lang_mir.MIR_CMP_EQ, shape: SH_COMPARE, int_op: isa_spirv.OP_I_EQUAL, float_op: isa_spirv.OP_F_ORD_EQUAL, src_float: false},
    MirMap{mir: lang_mir.MIR_CMP_NE, shape: SH_COMPARE, int_op: isa_spirv.OP_I_NOT_EQUAL, float_op: isa_spirv.OP_F_UNORD_NOT_EQUAL, src_float: false},
    MirMap{mir: lang_mir.MIR_CMP_LT_S, shape: SH_COMPARE, int_op: isa_spirv.OP_S_LESS_THAN, float_op: isa_spirv.OP_F_ORD_LESS_THAN, src_float: false},
    MirMap{mir: lang_mir.MIR_CMP_LT_U, shape: SH_COMPARE, int_op: isa_spirv.OP_U_LESS_THAN, float_op: isa_spirv.OP_F_ORD_LESS_THAN, src_float: false},
    MirMap{mir: lang_mir.MIR_CMP_LE_S, shape: SH_COMPARE, int_op: isa_spirv.OP_S_LESS_THAN_EQUAL, float_op: isa_spirv.OP_F_ORD_LESS_THAN_EQUAL, src_float: false},
    MirMap{mir: lang_mir.MIR_CMP_LE_U, shape: SH_COMPARE, int_op: isa_spirv.OP_U_LESS_THAN_EQUAL, float_op: isa_spirv.OP_F_ORD_LESS_THAN_EQUAL, src_float: false},

    MirMap{mir: lang_mir.MIR_TRUNC, shape: SH_CONVERT, int_op: isa_spirv.OP_U_CONVERT, float_op: isa_spirv.OP_U_CONVERT, src_float: false},
    MirMap{mir: lang_mir.MIR_ZEXT, shape: SH_CONVERT, int_op: isa_spirv.OP_U_CONVERT, float_op: isa_spirv.OP_U_CONVERT, src_float: false},
    MirMap{mir: lang_mir.MIR_SEXT, shape: SH_CONVERT, int_op: isa_spirv.OP_S_CONVERT, float_op: isa_spirv.OP_S_CONVERT, src_float: false},
    MirMap{mir: lang_mir.MIR_FP_TRUNC, shape: SH_CONVERT, int_op: isa_spirv.OP_F_CONVERT, float_op: isa_spirv.OP_F_CONVERT, src_float: true},
    MirMap{mir: lang_mir.MIR_FP_EXT, shape: SH_CONVERT, int_op: isa_spirv.OP_F_CONVERT, float_op: isa_spirv.OP_F_CONVERT, src_float: true},
    MirMap{mir: lang_mir.MIR_FP_TO_SI, shape: SH_CONVERT, int_op: isa_spirv.OP_CONVERT_F_TO_S, float_op: isa_spirv.OP_CONVERT_F_TO_S, src_float: true},
    MirMap{mir: lang_mir.MIR_FP_TO_UI, shape: SH_CONVERT, int_op: isa_spirv.OP_CONVERT_F_TO_U, float_op: isa_spirv.OP_CONVERT_F_TO_U, src_float: true},
    MirMap{mir: lang_mir.MIR_SI_TO_FP, shape: SH_CONVERT, int_op: isa_spirv.OP_CONVERT_S_TO_F, float_op: isa_spirv.OP_CONVERT_S_TO_F, src_float: false},
    MirMap{mir: lang_mir.MIR_UI_TO_FP, shape: SH_CONVERT, int_op: isa_spirv.OP_CONVERT_U_TO_F, float_op: isa_spirv.OP_CONVERT_U_TO_F, src_float: false},
    MirMap{mir: lang_mir.MIR_BITCAST, shape: SH_CONVERT, int_op: isa_spirv.OP_BITCAST, float_op: isa_spirv.OP_BITCAST, src_float: false},
};

# the mapping row of a MIR opcode, nil when the value emitter has none (the
# structural instructions are formed by their own emitters)
pub fun map_of(op: lang_mir.MirOpcode) *MirMap {
    var i: usize = 0;
    for (i < MAP_COUNT) {
        if (MAP[i].mir == op) { ret ?MAP[i]; }
        i = i + 1;
    }
    ret nil;
}

# the opcode of a mapped MIR instruction for its lane class
pub fun select(row: *MirMap, lane_float: bool) u32 {
    if (lane_float) { ret row.float_op; }
    ret row.int_op;
}

# the ordered float comparisons the FCMP condition codes name
pub fun float_compare(cc: u8) u32 {
    if (cc == lang_mir.FCC_EQ) { ret isa_spirv.OP_F_ORD_EQUAL; }
    if (cc == lang_mir.FCC_NE) { ret isa_spirv.OP_F_UNORD_NOT_EQUAL; }
    if (cc == lang_mir.FCC_LT) { ret isa_spirv.OP_F_ORD_LESS_THAN; }
    if (cc == lang_mir.FCC_LE) { ret isa_spirv.OP_F_ORD_LESS_THAN_EQUAL; }
    if (cc == lang_mir.FCC_GT) { ret isa_spirv.OP_F_ORD_GREATER_THAN; }
    if (cc == lang_mir.FCC_GE) { ret isa_spirv.OP_F_ORD_GREATER_THAN_EQUAL; }
    ret 0;
}
