# the instruction set catalog: the architectures of mink's catalog mach has a
# target for, each with its id and its fingerprint tag. it is an explicit projection: a row names mink's architecture
# row and is spelled by it, and an architecture of mink's no row names (x86,
# arm64e, wasm32, ...) is no instruction set here and no `$mach.arch` tag
use mink_arch:    mink.catalog.arch;
use arch_aarch64: mink.catalog.arch.aarch64;
use arch_riscv:   mink.catalog.arch.riscv;
use arch_spirv:   mink.catalog.arch.spirv;
use arch_x86:     mink.catalog.arch.x86;

use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub val UNKNOWN: u32 = 0;
pub val X86_64:  u32 = 1;
pub val AARCH64: u32 = 2;
pub val RISCV64: u32 = 3;
# 4 was the withdrawn MOS 6502 target; no catalog row carries it
pub val SPIRV:   u32 = 5;
pub val RISCV32: u32 = 6;

pub def DwarfRegFn: fun(i32) i32;

pub def CvRegFn: fun(i32) i32;

rec Row {
    arch:            u32;
    owner:           *mink_arch.Arch;
    fingerprint_tag: u8;
}

# version 2: catalog id 4 is reserved with no row and the tags after it moved up
pub val VERSION: u8 = 2;

val ROW_COUNT: usize          = 5;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{arch: X86_64, owner: ?arch_x86.X86_64, fingerprint_tag: 1},
    Row{arch: AARCH64, owner: ?arch_aarch64.AARCH64, fingerprint_tag: 2},
    Row{arch: RISCV64, owner: ?arch_riscv.RISCV64, fingerprint_tag: 3},
    Row{arch: SPIRV, owner: ?arch_spirv.SPIRV, fingerprint_tag: 4},
    Row{arch: RISCV32, owner: ?arch_riscv.RISCV32, fingerprint_tag: 5},
};

# the spelling of a row: mink's name for its architecture
fun spelling(r: *Row) str {
    ret r.owner.name;
}

fun row_of(id: u32) *Row {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].arch == id) { ret ?ROWS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun id_for(name: str) u32 {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(spelling(?ROWS[i]), name)) { ret ROWS[i].arch; }
        i = i + 1;
    }
    ret UNKNOWN;
}

# the instruction set the compiler itself was built for, UNKNOWN when the
# catalog has no row for it
pub fun host_id() u32 {
    $if ($mach.build.arch == $mach.arch.x86_64)  { ret X86_64; }
    $or ($mach.build.arch == $mach.arch.aarch64) { ret AARCH64; }
    $or ($mach.build.arch == $mach.arch.riscv64) { ret RISCV64; }
    $or                                          { ret UNKNOWN; }
}

# mink's architecture row the instruction set `id` means, nil for an unknown id
pub fun owner_of(id: u32) *mink_arch.Arch {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret nil; }
    ret spec.owner;
}

pub fun name_for(id: u32) str {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret "unknown"; }
    ret spelling(spec);
}

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun name_at(index: usize) str {
    if (index >= ROW_COUNT) { ret "unknown"; }
    ret spelling(?ROWS[index]);
}

pub fun fingerprint_tag(id: u32) u8 {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}
