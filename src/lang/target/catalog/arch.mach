# the instruction set catalog: the architectures of mink's catalog mach has a
# target for, each with its id, its fingerprint tag and the baseline a target of it
# stands on when it names none. it is an explicit projection: a row names mink's architecture
# row and is spelled by it, and an architecture of mink's no row names (x86,
# arm64e, wasm32, ...) is no instruction set here and no `$mach.arch` tag
use mink_arch:    mink.catalog.arch;
use arch_aarch64: mink.catalog.arch.aarch64;
use arch_list:    mink.catalog.arch.list;
use arch_riscv:   mink.catalog.arch.riscv;
use arch_spirv:   mink.catalog.arch.spirv;
use arch_x86:     mink.catalog.arch.x86;

use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub val UNKNOWN: u32 = 0;
pub val X86_64:  u32 = 1;
pub val AARCH64: u32 = 2;
pub val RISCV64: u32 = 3;
# 4 was the withdrawn MOS 6502 target; no catalog row carries it
pub val SPIRV:   u32 = 5;
pub val RISCV32: u32 = 6;

pub def DwarfRegFn: fun(i32) i32;

pub def CvRegFn: fun(i32) i32;

rec Row {
    arch:            u32;
    owner:           *mink_arch.Arch;
    fingerprint_tag: u8;
    # the baseline a hosted target naming no `baseline` stands on, spelled as masc's
    # catalog spells a selection; nil for an instruction set whose catalog spells
    # none. mach's until mink's os rows state each system's floor (mink#400)
    default_baseline: str;
}

# version 2: catalog id 4 is reserved with no row and the tags after it moved up
pub val VERSION: u8 = 2;

val ROW_COUNT: usize          = 5;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{arch: X86_64, owner: ?arch_x86.X86_64, fingerprint_tag: 1},
    Row{arch: AARCH64, owner: ?arch_aarch64.AARCH64, fingerprint_tag: 2},
    Row{arch: RISCV64, owner: ?arch_riscv.RISCV64, fingerprint_tag: 3, default_baseline: "rv64gc"},
    Row{arch: SPIRV, owner: ?arch_spirv.SPIRV, fingerprint_tag: 4},
    Row{arch: RISCV32, owner: ?arch_riscv.RISCV32, fingerprint_tag: 5, default_baseline: "rv32imac"},
};

# the spelling of a row: mink's name for its architecture
fun spelling(r: *Row) str {
    ret r.owner.name;
}

fun row_of(id: u32) *Row {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].arch == id) { ret ?ROWS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun id_for(name: str) u32 {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(spelling(?ROWS[i]), name)) { ret ROWS[i].arch; }
        i = i + 1;
    }
    ret UNKNOWN;
}

# the baseline a hosted target of the instruction set `id` stands on when it names
# none, in masc's spelling; nil when its catalog spells no selection, so it takes no baseline
pub fun default_baseline(id: u32) str {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret nil; }
    ret spec.default_baseline;
}

# the instruction set the compiler itself was built for, UNKNOWN when the
# catalog has no row for it
pub fun host_id() u32 {
    $if ($mach.build.arch == $mach.arch.x86_64)  { ret X86_64; }
    $or ($mach.build.arch == $mach.arch.aarch64) { ret AARCH64; }
    $or ($mach.build.arch == $mach.arch.riscv64) { ret RISCV64; }
    $or                                          { ret UNKNOWN; }
}

# mink's architecture row the instruction set `id` means, nil for an unknown id
pub fun owner_of(id: u32) *mink_arch.Arch {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret nil; }
    ret spec.owner;
}

pub fun name_for(id: u32) str {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret "unknown"; }
    ret spelling(spec);
}

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun name_at(index: usize) str {
    if (index >= ROW_COUNT) { ret "unknown"; }
    ret spelling(?ROWS[index]);
}

pub fun fingerprint_tag(id: u32) u8 {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

test id_for__name_roundtrip {
    if (id_for("x86_64") != X86_64)                                  { ret 1; }
    if (id_for("aarch64") != AARCH64)                                { ret 1; }
    if (id_for("riscv64") != RISCV64)                                { ret 1; }
    if (id_for("riscv32") != RISCV32)                                { ret 1; }
    if (id_for("mos6502") != UNKNOWN)                                { ret 1; }
    if (id_for("spirv") != SPIRV)                                    { ret 1; }
    if (id_for("riscv") != UNKNOWN)                                  { ret 1; }
    if (RISCV32 == RISCV64)                                          { ret 1; }
    if (id_for("rv32imc") != UNKNOWN || id_for("rv64gc") != UNKNOWN) { ret 2; }

    if (!str_equals(name_for(X86_64), "x86_64"))   { ret 1; }
    if (!str_equals(name_for(AARCH64), "aarch64")) { ret 1; }
    if (!str_equals(name_for(RISCV64), "riscv64")) { ret 1; }
    if (!str_equals(name_for(RISCV32), "riscv32")) { ret 1; }
    if (!str_equals(name_for(SPIRV), "spirv"))     { ret 1; }
    if (!str_equals(name_for(UNKNOWN), "unknown")) { ret 1; }
    ret 0;
}

# the projection is explicit: every row names a row of mink's catalog and is spelled
# by it, and an architecture of mink's no row names is no instruction set here
test rows__project_mink_s_catalog_explicitly {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!arch_list.member(ROWS[i].owner)) { ret 1; }
        i = i + 1;
    }
    var projected: usize = 0;
    i = 0;
    for (i < arch_list.count()) {
        val a:  *mink_arch.Arch = arch_list.at(i);
        val id: u32             = id_for(a.name);
        if (id != UNKNOWN) {
            if (row_of(id).owner != a) { ret 2; }
            projected = projected + 1;
        }
        i = i + 1;
    }
    if (projected != ROW_COUNT)                                       { ret 3; }
    if (id_for("x86") != UNKNOWN || id_for("wasm32") != UNKNOWN)      { ret 4; }
    if (id_for("arm64e") != UNKNOWN || id_for("riscv64e") != UNKNOWN) { ret 5; }
    ret 0;
}

test rows__complete_unique_ordered_roundtrip {
    if (ROWS[0].arch != X86_64)  { ret 1; }
    if (ROWS[1].arch != AARCH64) { ret 1; }
    if (ROWS[2].arch != RISCV64) { ret 1; }
    if (ROWS[3].arch != SPIRV)   { ret 1; }
    if (ROWS[4].arch != RISCV32) { ret 1; }

    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].fingerprint_tag != (i + 1)::u8)                  { ret 1; }
        if (id_for(spelling(?ROWS[i])) != ROWS[i].arch)              { ret 1; }
        if (!str_equals(name_for(ROWS[i].arch), spelling(?ROWS[i]))) { ret 1; }

        var j: usize = 0;
        for (j < ROW_COUNT) {
            if (i != j) {
                if (ROWS[i].arch == ROWS[j].arch)                       { ret 1; }
                if (str_equals(spelling(?ROWS[i]), spelling(?ROWS[j]))) { ret 1; }
                if (ROWS[i].fingerprint_tag == ROWS[j].fingerprint_tag) { ret 1; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}
