# the artifact kind catalog: every kind of output a build produces, how a
# manifest spells it, how a build plan labels it, and what producing it asks of
# the linker. a kind says what an output is for, not how its object format
# writes it: a spir-v module, a wasm module and a raw image are executables of
# formats that finish each module or image themselves
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub def Kind: u8;

pub val EXECUTABLE: Kind = 0;
pub val OBJECTS:    Kind = 1;
pub val SHARED:     Kind = 2;
pub val STATIC:     Kind = 3;

# spelling:          the manifest's `kind` value, empty for a kind a manifest
#                    cannot declare
# label:             how a build plan names an artifact of the kind
# output:            how a build plan names what a build of the kind finishes with
# library:           consumers link against it rather than run it
# linked:            the linker produces it; an archive is collected, not linked
# allocates_commons: a link of it allocates storage for common symbols, which a
#                    relocatable link leaves for the final link
# loaded:            a loader maps it on its own account
rec Row {
    kind:              Kind;
    spelling:          str;
    label:             str;
    output:            str;
    library:           bool;
    linked:            bool;
    allocates_commons: bool;
    loaded:            bool;
}

val ROW_COUNT: usize          = 4;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{kind: EXECUTABLE, spelling: "bin", label: "bin", output: "executable", library: false, linked: true, allocates_commons: true, loaded: false},
    Row{kind: OBJECTS, spelling: "", label: "objects", output: "objects", library: false, linked: true, allocates_commons: false, loaded: false},
    Row{kind: SHARED, spelling: "shared", label: "lib shared", output: "shared", library: true, linked: true, allocates_commons: true, loaded: true},
    Row{kind: STATIC, spelling: "static", label: "lib static", output: "static", library: true, linked: false, allocates_commons: false, loaded: false},
};

fun row_of(k: Kind) *Row {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].kind == k) { ret ?ROWS[i]; }
        i = i + 1;
    }
    ret nil;
}

# the kind a manifest's `kind` value names; absent for a value no kind declares
pub fun from_name(name: str) opt[Kind] {
    if (str_equals(name, "")) { ret opt[Kind].none{}; }
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].spelling, name)) { ret opt[Kind].some{ROWS[i].kind}; }
        i = i + 1;
    }
    ret opt[Kind].none{};
}

# the manifest spelling of a kind; empty for one a manifest cannot declare
pub fun name_for(k: Kind) str {
    val spec: *Row = row_of(k);
    if (spec == nil) { ret ""; }
    ret spec.spelling;
}

# how many kinds a manifest can declare
pub fun declarable_count() usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!str_equals(ROWS[i].spelling, "")) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the manifest spelling of the declarable kind at `index`, in catalog order;
# empty past the last
pub fun declarable_at(index: usize) str {
    var n: usize = 0;
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (!str_equals(ROWS[i].spelling, "")) {
            if (n == index) { ret ROWS[i].spelling; }
            n = n + 1;
        }
        i = i + 1;
    }
    ret "";
}

pub fun label_for(k: Kind) str {
    val spec: *Row = row_of(k);
    if (spec == nil) { ret "unknown"; }
    ret spec.label;
}

pub fun output_for(k: Kind) str {
    val spec: *Row = row_of(k);
    if (spec == nil) { ret "unknown"; }
    ret spec.output;
}

# whether the kind is a library; false for a kind outside the catalog
pub fun is_library(k: Kind) bool {
    val spec: *Row = row_of(k);
    ret spec != nil && spec.library;
}

# whether the linker produces the kind; false for a kind outside the catalog
pub fun is_linked(k: Kind) bool {
    val spec: *Row = row_of(k);
    ret spec != nil && spec.linked;
}

# whether a link of the kind allocates common storage; absent for a kind the
# linker does not produce
pub fun allocates_commons(k: Kind) opt[bool] {
    val spec: *Row = row_of(k);
    if (spec == nil || !spec.linked) { ret opt[bool].none{}; }
    ret opt[bool].some{spec.allocates_commons};
}

# whether a loader maps the kind on its own account; absent for a kind the
# linker does not produce
pub fun is_loaded(k: Kind) opt[bool] {
    val spec: *Row = row_of(k);
    if (spec == nil || !spec.linked) { ret opt[bool].none{}; }
    ret opt[bool].some{spec.loaded};
}
