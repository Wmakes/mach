# the windows subsystem catalog: every subsystem, its spelling and its
# fingerprint tag
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub def Subsystem: u8;

pub val CONSOLE: Subsystem = 0;
pub val GUI:     Subsystem = 1;

rec Row {
    subsystem:       Subsystem;
    spelling:        str;
    fingerprint_tag: u8;
}

pub val VERSION: u8 = 1;

val ROW_COUNT: usize          = 2;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{subsystem: CONSOLE, spelling: "console", fingerprint_tag: 1},
    Row{subsystem: GUI, spelling: "gui", fingerprint_tag: 2},
};

fun row_of(s: Subsystem) *Row {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].subsystem == s) { ret ?ROWS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun from_name(name: str) opt[Subsystem] {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].spelling, name)) { ret opt[Subsystem].some{ROWS[i].subsystem}; }
        i = i + 1;
    }
    ret opt[Subsystem].none{};
}

pub fun name_for(s: Subsystem) str {
    val spec: *Row = row_of(s);
    if (spec == nil) { ret "unknown"; }
    ret spec.spelling;
}

pub fun fingerprint_tag(s: Subsystem) u8 {
    val spec: *Row = row_of(s);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}
