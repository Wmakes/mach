# the calling convention catalog: every abi id, its spelling and its
# fingerprint tag, and how a convention passes a value
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub val UNKNOWN: u32 = 0;
pub val SYSV:    u32 = 1;
pub val WIN64:   u32 = 2;
pub val AAPCS64: u32 = 3;
pub val LP64:    u32 = 4;
pub val LP64F:   u32 = 5;
pub val LP64D:   u32 = 6;

pub val ILP32:  u32 = 7;
pub val ILP32F: u32 = 8;
pub val ILP32D: u32 = 9;
pub val SPIRV:  u32 = 10;

rec Row {
    abi:             u32;
    spelling:        str;
    fingerprint_tag: u8;
}

pub val VERSION: u8 = 1;

val ROW_COUNT: usize          = 10;
val ROWS:      [ROW_COUNT]Row = [ROW_COUNT]Row{
    Row{abi: SYSV, spelling: "sysv64", fingerprint_tag: 1},
    Row{abi: WIN64, spelling: "win64", fingerprint_tag: 2},
    Row{abi: AAPCS64, spelling: "aapcs64", fingerprint_tag: 3},
    Row{abi: LP64, spelling: "lp64", fingerprint_tag: 4},
    Row{abi: LP64F, spelling: "lp64f", fingerprint_tag: 5},
    Row{abi: LP64D, spelling: "lp64d", fingerprint_tag: 6},
    Row{abi: ILP32, spelling: "ilp32", fingerprint_tag: 7},
    Row{abi: ILP32F, spelling: "ilp32f", fingerprint_tag: 8},
    Row{abi: ILP32D, spelling: "ilp32d", fingerprint_tag: 9},
    Row{abi: SPIRV, spelling: "spirv", fingerprint_tag: 10},
};

fun row_of(id: u32) *Row {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (ROWS[i].abi == id) { ret ?ROWS[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun id_for(name: str) u32 {
    var i: usize = 0;
    for (i < ROW_COUNT) {
        if (str_equals(ROWS[i].spelling, name)) { ret ROWS[i].abi; }
        i = i + 1;
    }
    ret UNKNOWN;
}

pub fun name_for(id: u32) str {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret "unknown"; }
    ret spec.spelling;
}

pub fun count() usize {
    ret ROW_COUNT;
}

pub fun name_at(index: usize) str {
    if (index >= ROW_COUNT) { ret "unknown"; }
    ret ROWS[index].spelling;
}

pub fun fingerprint_tag(id: u32) u8 {
    val spec: *Row = row_of(id);
    if (spec == nil) { ret 0; }
    ret spec.fingerprint_tag;
}

pub def Passing: u8;
pub val PASSING_CARRIERS: Passing = 0;
pub val PASSING_VALUES:   Passing = 1;
