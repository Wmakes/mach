use chrono_duration: std.chrono.duration;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# the accepted forms of a duration, for error messages
pub val FORMS: str = "<n>ms, <n>s, <n>m or <n>h, with n a positive integer";

# parse a duration: a positive decimal integer followed by one of the
# units ms, s, m or h
# ---
# s:   the argument
# ret: the duration; none when s is malformed, zero, or overflows
pub fun parse(s: *u8) opt[chrono_duration.Duration] {
    if (s == nil) { ret opt[chrono_duration.Duration].none{}; }
    val max: i64   = 9223372036854775807;
    var v:   i64   = 0;
    var i:   usize = 0;
    for (s[i] >= '0' && s[i] <= '9') {
        val d: i64 = (s[i] - '0')::i64;
        if (v > (max - d) / 10) { ret opt[chrono_duration.Duration].none{}; }
        v = v * 10 + d;
        i = i + 1;
    }
    if (i == 0 || v == 0) { ret opt[chrono_duration.Duration].none{}; }
    val unit: str                      = (?s[i])::str;
    var per:  chrono_duration.Duration = 0;
    if (str_equals(unit, "ms")) { per = chrono_duration.MILLISECOND; }
    or (str_equals(unit, "s"))  { per = chrono_duration.SECOND; }
    or (str_equals(unit, "m"))  { per = chrono_duration.MINUTE; }
    or (str_equals(unit, "h"))  { per = chrono_duration.HOUR; }
    or                          { ret opt[chrono_duration.Duration].none{}; }
    if (v > max / per)          { ret opt[chrono_duration.Duration].none{}; }
    ret opt[chrono_duration.Duration].some{per * v};
}

# a duration in the largest unit of parse's that divides it exactly
# n:    the count
# unit: "h", "m", "s" or "ms"; "ns" when d is not a whole number of milliseconds
pub rec Text {
    n:    i64;
    unit: str;
}

# render d in the form parse reads back
# ---
# d:   the duration
# ret: the count and its unit
pub fun text(d: chrono_duration.Duration) Text {
    if (d != 0 && d % chrono_duration.HOUR == 0)        { ret Text{n: (d / chrono_duration.HOUR)::i64, unit: "h"}; }
    if (d != 0 && d % chrono_duration.MINUTE == 0)      { ret Text{n: (d / chrono_duration.MINUTE)::i64, unit: "m"}; }
    if (d != 0 && d % chrono_duration.SECOND == 0)      { ret Text{n: (d / chrono_duration.SECOND)::i64, unit: "s"}; }
    if (d != 0 && d % chrono_duration.MILLISECOND == 0) { ret Text{n: (d / chrono_duration.MILLISECOND)::i64, unit: "ms"}; }
    ret Text{n: d::i64, unit: "ns"};
}
