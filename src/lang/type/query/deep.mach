# whether a type reaches a property anywhere, through pointers included, answered over
# the declarations so a generic that grows through a pointer still has a finite answer
use std.allocator.page;
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.fail;
#[testing]
use mach.lang.intern;
#[testing]
use mach.lang.module;
use mach.lang.session;
#[testing]
use lang_source: mach.lang.source;
use mach.lang.type;
use type_query: mach.lang.type.query;
use mach.lang.type.query.placement;

# the kinds that carry no secret of their own; false for every other kind, which a
# walk descends (a partition, enumerated by its test)
pub fun public_leaf(k: type.TypeKind) bool {
    val pc: type.PrimClass = type.prim_desc(k).class;
    if (pc == type.PRIM_CLASS_INT || pc == type.PRIM_CLASS_FLOAT || pc == type.PRIM_CLASS_PTR) { ret true; }
    if (k == type.TYPE_VECTOR)                                                                 { ret true; }
    if (k == type.TYPE_HANDLE)                                                                 { ret true; }
    if (k == type.TYPE_ABI)                                                                    { ret true; }
    if (k == type.TYPE_GENERIC_PARAM)                                                          { ret true; }
    ret false;
}

# whether `tid` reaches a secret
pub fun secret(q: *type_query.Query, tid: type.TypeId) bool {
    ret query_run(q, DEEP_SECRET, tid);
}

# whether `tid` reaches a floating-point value, a lane of a vector included
pub fun float(q: *type_query.Query, tid: type.TypeId) bool {
    ret query_run(q, DEEP_FLOAT, tid);
}

pub fun contains_secret(s: *session.Session, tid: type.TypeId) res[bool, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var q:      type_query.Query = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    ret type_query.answer[bool](?q, secret(?q, tid));
}

pub fun contains_float(s: *session.Session, tid: type.TypeId) res[bool, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var q:      type_query.Query = type_query.Query{types: ?s.types, facts: ?s.type_facts, status: ?status};
    ret type_query.answer[bool](?q, float(?q, tid));
}

# what a deep query looks for anywhere a type reaches, through pointers included
def DeepProp: u8;

val DEEP_SECRET: DeepProp = 0;
val DEEP_FLOAT:  DeepProp = 1;

# one walk over the declaration graph, never the instance graph: a generic reached through
# a pointer can mint a fresh instance at every level (`rec L[T] { next: *L[*T]; }`), so the
# instances are unbounded but the declarations are not. a nominal's own fields are walked
# once with its parameters reaching nothing, and an instance adds the arguments of the
# parameters its generic reaches anywhere, which the placement fixpoint settles. a nominal
# or instance met again adds nothing, so the walk is a plain reachability search
rec DeepQuery {
    q:      *type_query.Query;
    prop:   DeepProp;
    seen:   map.Map[type.TypeId, bool];
    places: placement.Places;
}

fun query_run(q: *type_query.Query, prop: DeepProp, tid: type.TypeId) bool {
    var dq: DeepQuery;
    dq.q      = q;
    dq.prop   = prop;
    dq.seen   = map.init[type.TypeId, bool](q.types.a);
    dq.places = placement.init(q);
    val found: bool = deep_eval(?dq, tid);
    map.dnit[type.TypeId, bool](?dq.seen);
    placement.dnit(?dq.places);
    ret found;
}

# whether the walk meets `tid` for the first time; a mark that cannot be recorded is a
# failure, recorded, and reads as already met
fun first_sight(dq: *DeepQuery, tid: type.TypeId) bool {
    if (map.contains[type.TypeId, bool](?dq.seen, ?tid)) { ret false; }
    val marked: res[bool, A.Error] = map.insert[type.TypeId, bool](?dq.seen, tid, true);
    if (sel marked.err) {
        type_query.refused(dq.q, marked.err);
        ret false;
    }
    ret true;
}

# whether the fields of `nominal` reach the property, its own parameters reaching nothing; a
# nominal with no field table cannot be shown clear
fun fields_reach(dq: *DeepQuery, nominal: type.TypeId) bool {
    val table: opt[*type.FieldTable] = type.field_table_for(dq.q.types, nominal);
    if (!sel table.some) { ret true; }
    val fields_len: u32 = table.some.fields_len;
    var f:          u32 = 0;
    for (f < fields_len) {
        val entry: opt[*type.FieldEntry] = type.field_at(dq.q.types, nominal, f);
        if (!sel entry.some) {
            fail.internal(dq.q.status, "deep query: a field table runs past its fields");
            ret true;
        }
        if (deep_eval(dq, entry.some.ty)) { ret true; }
        f = f + 1;
    }
    ret false;
}

# whether `tid` reaches the property; a type parameter reaches nothing on its own, its
# argument being walked where an instance supplies it. once the query has failed every
# answer is true, so no walk goes on past the failure
fun deep_eval(dq: *DeepQuery, tid: type.TypeId) bool {
    if (type.is_nil(tid) || type.is_error(tid)) { ret false; }
    if (sel dq.q.status.kind.internal)          { ret true; }
    if (!type_query.descend(dq.q))              { ret true; }

    val opt_type: opt[*type.Type] = type.get(dq.q.types, tid);
    if (!sel opt_type.some) {
        fail.internal(dq.q.status, "deep query: the store holds no such type id");
        ret true;
    }
    val t: *type.Type = opt_type.some;

    if (dq.prop == DEEP_SECRET) {
        if (t.kind == type.TYPE_SECRET) { ret true; }
    }
    or {
        if (type.prim_desc(t.kind).class == type.PRIM_CLASS_FLOAT) { ret true; }
        if (t.kind == type.TYPE_SECRET)                            { ret deep_eval(dq, t.data.secret.base); }
        if (t.kind == type.TYPE_VECTOR)                            { ret type.prim_desc(t.data.vector.element).class == type.PRIM_CLASS_FLOAT; }
    }
    if (t.kind == type.TYPE_POINTER) { ret deep_eval(dq, t.data.pointer.base); }
    if (t.kind == type.TYPE_ARRAY)   { ret deep_eval(dq, t.data.array.base); }

    if (t.kind == type.TYPE_FUN) {
        if (deep_eval(dq, t.data.fn.ret_type)) { ret true; }
        var pi: u32 = 0;
        for (pi < t.data.fn.params_len) {
            val pp: opt[type.TypeId] = type.get_param(dq.q.types, t.data.fn.params_start + pi);
            if (sel pp.some && deep_eval(dq, pp.some)) { ret true; }
            pi = pi + 1;
        }
        ret false;
    }

    if (t.kind == type.TYPE_GENERIC_PARAM) { ret false; }

    if (t.kind == type.TYPE_INSTANCE) {
        if (!first_sight(dq, tid)) { ret sel dq.q.status.kind.internal; }
        val generic: type.TypeId = t.data.instance.nominal;
        if (first_sight(dq, generic) && fields_reach(dq, generic)) { ret true; }
        if (sel dq.q.status.kind.internal)                         { ret true; }
        # a generic whose places cannot be settled reaches a nominal with no field table,
        # which cannot be shown clear
        if (!placement.settle(?dq.places, generic)) { ret true; }
        val args_start: u32 = t.data.instance.args_start;
        val args_len:   u32 = t.data.instance.args_len;
        var j:          u32 = 0;
        for (j < args_len) {
            if (placement.reached(?dq.places, generic, j)) {
                val arg: opt[type.TypeId] = type.get_param(dq.q.types, args_start + j);
                if (!sel arg.some) {
                    fail.internal(dq.q.status, "deep query: an argument list runs past the store");
                    ret true;
                }
                if (deep_eval(dq, arg.some)) { ret true; }
            }
            j = j + 1;
        }
        ret false;
    }

    # a bare nominal, named or an anonymous aggregate inside a generic, whose parameters
    # are the enclosing declaration's and reach nothing here
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
        if (!first_sight(dq, tid)) { ret sel dq.q.status.kind.internal; }
        ret fields_reach(dq, tid);
    }

    if (public_leaf(t.kind)) { ret false; }
    ret true;
}

# a type id the store does not hold is an internal failure, never an answer
test query__unresolvable_type_fails {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val bogus:    type.TypeId          = type.id(500000);
    val secret_r: res[bool, fail.Fail] = contains_secret(?s, bogus);
    if (sel secret_r.ok) { ret 2; }
    val float_r: res[bool, fail.Fail] = contains_float(?s, bogus);
    if (sel float_r.ok) { ret 3; }
    ret 0;
}

test public_leaf__partition_typekind {
    val leaves: [15]type.TypeKind = [15]type.TypeKind{type.TYPE_U8, type.TYPE_U16, type.TYPE_U32, type.TYPE_U64,
        type.TYPE_I8, type.TYPE_I16, type.TYPE_I32, type.TYPE_I64, type.TYPE_F32, type.TYPE_F64, type.TYPE_PTR,
        type.TYPE_VECTOR, type.TYPE_HANDLE, type.TYPE_ABI, type.TYPE_GENERIC_PARAM};
    val descended: [10]type.TypeKind = [10]type.TypeKind{type.TYPE_POINTER, type.TYPE_ARRAY, type.TYPE_FUN,
        type.TYPE_REC, type.TYPE_UNI, type.TYPE_INSTANCE, type.TYPE_PACK, type.TYPE_SECRET, type.TYPE_TAG,
        type.TYPE_CASE_SELECTOR};
    var i: usize = 0;
    for (i < 15) {
        if (!public_leaf(leaves[i])) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < 10) {
        if (public_leaf(descended[i])) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

# whether an array of four `kind` elements contains a float, -1 when it cannot be asked
#[testing]
fun t_array_holds_float(s: *session.Session, kind: type.TypeKind) i32 {
    val elem: opt[type.TypeId] = type.prim(?s.types, kind);
    if (sel elem.none) { ret -1; }
    if (sel elem.some) {
        val arr: res[type.TypeId, fail.Fail] = type.intern_array(?s.types, elem.some, 4);
        if (sel arr.ok) {
            val found: res[bool, fail.Fail] = contains_float(s, arr.ok);
            if (sel found.ok) {
                if (found.ok) { ret 1; }
                ret 0;
            }
        }
    }
    ret -1;
}

# an array of floats contains a float, and one of integers does not
test contains_float__finds_a_float_through_an_array {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    if (t_array_holds_float(?s, type.TYPE_F32) != 1) { ret 2; }
    if (t_array_holds_float(?s, type.TYPE_U32) != 0) { ret 3; }
    ret 0;
}

# a record `name` owned by `at` with the single field `field`
#[testing]
fun t_record(types: *type.TypeInterner, at: type.TypeOwner, name: u32, field: type.TypeId) res[type.TypeId, fail.Fail] {
    val made: res[type.TypeId, fail.Fail] = type.intern_nominal(types, intern.str_id(name), at, type.TYPE_REC);
    if (sel made.err) { ret made; }
    val staged: res[u32, fail.Fail] = type.field_table_stage(types, 1);
    if (sel staged.err) { ret res[type.TypeId, fail.Fail].err{staged.err}; }
    val pushed: err[fail.Fail] = type.field_table_stage_push(types, intern.str_id(name + 1), field);
    if (sel pushed.err) { ret res[type.TypeId, fail.Fail].err{pushed.err}; }
    val published: err[fail.Fail] = type.field_table_publish(types, made.ok, staged.ok, 1);
    if (sel published.err) { ret res[type.TypeId, fail.Fail].err{published.err}; }
    ret made;
}

# 1 when `[0]` of a record holding `leaf`, and the instance of `rec G[T] { a: [0]T; }` over
# that record, both answer `prop`; 0 when neither does; -1 when they disagree or fail
#[testing]
fun t_empty_array_reaches(s: *session.Session, leaf: type.TypeId, prop: DeepProp, base: u32) i32 {
    val at:     type.TypeOwner              = type.TypeOwner{module: module.stable_id(3), file: lang_source.file_id(1)};
    val holder: res[type.TypeId, fail.Fail] = t_record(?s.types, at, base, leaf);
    if (sel holder.err) { ret -1; }
    val empty: res[type.TypeId, fail.Fail] = type.intern_array(?s.types, holder.ok, 0);
    if (sel empty.err) { ret -1; }
    val concrete: res[type.TypeId, fail.Fail] = t_record(?s.types, at, base + 2, empty.ok);
    if (sel concrete.err) { ret -1; }

    val param: res[type.TypeId, fail.Fail] = type.intern_generic_param(?s.types, intern.str_id(base + 5), at, intern.str_id(base + 4), type.TYPE_REC, 0);
    if (sel param.err) { ret -1; }
    val of_param: res[type.TypeId, fail.Fail] = type.intern_array(?s.types, param.ok, 0);
    if (sel of_param.err) { ret -1; }
    val generic: res[type.TypeId, fail.Fail] = t_record(?s.types, at, base + 4, of_param.ok);
    if (sel generic.err) { ret -1; }
    var arg: [1]type.TypeId;
    arg[0] = holder.ok;
    val inst: res[type.TypeId, fail.Fail] = type.intern_instance(?s.types, generic.ok, ?arg[0], 1);
    if (sel inst.err) { ret -1; }

    var c: res[bool, fail.Fail] = contains_secret(s, concrete.ok);
    var g: res[bool, fail.Fail] = contains_secret(s, inst.ok);
    if (prop == DEEP_FLOAT) {
        c = contains_float(s, concrete.ok);
        g = contains_float(s, inst.ok);
    }
    if (!sel c.ok)    { ret -1; }
    if (!sel g.ok)    { ret -1; }
    if (c.ok != g.ok) { ret -1; }
    if (c.ok)         { ret 1; }
    ret 0;
}

# an empty array's element is reached whatever the length, in a concrete record and through a
# generic's parameter alike, for a secret and a float
test deep__an_empty_array_reaches_its_element {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val u: opt[type.TypeId] = type.prim(?s.types, type.TYPE_U32);
    val f: opt[type.TypeId] = type.prim(?s.types, type.TYPE_F32);
    if (!sel u.some) { ret 2; }
    if (!sel f.some) { ret 2; }
    val secret: res[type.TypeId, fail.Fail] = type.intern_secret(?s.types, u.some);
    if (sel secret.err)                                              { ret 2; }
    if (t_empty_array_reaches(?s, secret.ok, DEEP_SECRET, 100) != 1) { ret 3; }
    if (t_empty_array_reaches(?s, f.some, DEEP_FLOAT, 200) != 1)     { ret 4; }
    if (t_empty_array_reaches(?s, u.some, DEEP_SECRET, 300) != 0)    { ret 5; }
    if (t_empty_array_reaches(?s, u.some, DEEP_FLOAT, 400) != 0)     { ret 6; }
    ret 0;
}
