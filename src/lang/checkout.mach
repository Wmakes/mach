# the compiler's own checkout, which the tests that read the repository locate: the
# nearest directory at or above the working directory holding the compiler's entry
use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A:        std.allocator;
use fs:       std.filesystem;
use io_error: std.io.error;
use std.print;
use types_path: std.types.path;

# the file that marks the checkout's root
#[testing]
val MARKER: str = "src/bin/main.mach";

# how many directories above the working directory are searched
#[testing]
val DEPTH: usize = 8;

# the checkout's root as a path relative to the working directory, owned by `alloc`; none,
# with the reason printed, outside a checkout
#[testing]
pub fun root(alloc: *A.Allocator) opt[str] {
    var prefix: str   = ".";
    var depth:  usize = 0;
    for (depth < DEPTH) {
        val probe: res[str, A.Error] = types_path.join(alloc, prefix, MARKER);
        if (sel probe.err) { brk; }
        val is: res[bool, io_error.Error] = fs.is_file(probe.ok);
        if (sel is.ok) {
            if (is.ok) { ret opt[str].some{prefix}; }
        }
        val up: res[str, A.Error] = types_path.join(alloc, prefix, "..");
        if (sel up.err) { brk; }
        prefix = up.ok;
        depth  = depth + 1;
    }
    print.eprintln("checkout: no compiler checkout at or above the working directory; run the tests from it");
    ret opt[str].none{};
}

# `rel` under the checkout's root, owned by `alloc`; none, with the reason printed, outside a
# checkout
#[testing]
pub fun path(alloc: *A.Allocator, rel: str) opt[str] {
    val at: opt[str] = root(alloc);
    if (sel at.none) { ret opt[str].none{}; }
    val joined: res[str, A.Error] = types_path.join(alloc, at.some, rel);
    if (sel joined.err) { ret opt[str].none{}; }
    ret opt[str].some{joined.ok};
}
