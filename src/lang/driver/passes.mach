# a module's source with what lowering omits cut away, keyed by its stable id
pub val LOWERED_SURFACE: query.Kind = query.Kind{
    name: "lowered surface", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_LOWER, compute: lowered_surface_compute
};
# the bodies a module offers its importers to inline, keyed by its back-half key
pub val INLINE_BODIES: query.Kind = query.Kind{
    name:     "inline bodies", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_LOWER, compute: inline_bodies_compute,
    finalize: lower_finalize, equal: lower_output_equal
};
# a module's optimized ir, keyed by its back-half key
pub val LOWER: query.Kind = query.Kind{
    name:  "lower", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_LOWER, compute: lower_compute, finalize: lower_finalize,
    equal: lower_output_equal
};
# a module's object image, keyed by its back-half key
pub val CODEGEN: query.Kind = query.Kind{
    name:     "codegen", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_CODEGEN, compute: codegen_compute,
    finalize: codegen_finalize
};
# the link's inputs as revisions, so a link reruns only when one moved
pub val LINK: query.Kind = query.Kind{name: "link", role: query.DERIVED, owner: query.KEY_UNOWNED, origin: diagnostic.ORIGIN_LINK, compute: link_compute};
# what the link is configured with beyond the build context, set by the build
pub val LINK_CONFIG: query.Kind = query.Kind{name: "link config", role: query.INPUT, owner: query.KEY_UNOWNED};

# a rejected module is one module's answer, so the pass folds it and carries
# on over the rest; an internal failure ends the pass where it met it
pub fun run_resolve_pass(p: *project.Project) err[fail.Fail] {
    var rejected: bool = false;
    var i:        u32  = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        if (project.module_at(p, mid::u32).frontend_skipped) {
            i = i + 1;
            cnt;
        }
        val r: err[fail.Fail] = run_resolve_one(p, mid);
        if (sel r.err) {
            if (!fail.is_reported(r.err)) { ret r; }
            rejected = true;
        }
        i = i + 1;
    }
    if (rejected) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

fun run_resolve_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val t_item: readout.Instant = readout.item_begin(p.progress);

    val resolved: res[*resolve.ResolveResult, fail.Fail] = frontend.resolution(p, m);
    if (sel resolved.err) { ret err[fail.Fail].err{resolved.err}; }

    val ex_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?frontend.EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel ex_r.err) { ret err[fail.Fail].err{ex_r.err}; }

    readout.item(p.progress, readout.RESOLVE, intern.text(?p.s.interner, m.fqn), t_item);
    ret err[fail.Fail].ok{};
}

# a rejected module is one module's answer, so the pass folds it and carries
# on over the rest; an internal failure ends the pass where it met it
pub fun run_sema_pass(p: *project.Project) err[fail.Fail] {
    readout.phase_begin(p.progress, readout.SEMA);
    var rejected: bool = false;
    var i:        u32  = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        if (project.module_at(p, mid::u32).frontend_skipped) {
            i = i + 1;
            cnt;
        }

        val r: err[fail.Fail] = run_sema_one(p, mid);
        if (sel r.err) {
            if (!fail.is_reported(r.err)) { ret err[fail.Fail].err{r.err}; }
            rejected = true;
        }
        i = i + 1;
    }
    readout.phase_end(p.progress, readout.SEMA, cache.frontend_count(p), "module", "modules");
    if (rejected) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

fun run_sema_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val t_item: readout.Instant = readout.item_begin(p.progress);

    val acquired: res[fe_sema.Definition, fail.Fail] = frontend.read_definition(p::ptr, mid, fe_sema.DEFINITION_TYPED);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }

    val tx_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?frontend.TYPED_EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel tx_r.err) { ret err[fail.Fail].err{tx_r.err}; }

    readout.item(p.progress, readout.SEMA, intern.text(?p.s.interner, m.fqn), t_item);
    ret err[fail.Fail].ok{};
}

# every module the load reached, gated out or not, is held under the session's active retainer: the
# project borrows each one's parse. a load closes its retainer's round unless a caller keeps the round
# open across builds, and then whatever no retainer holds is retired
pub fun retain_modules(p: *project.Project, rejected: bool) err[fail.Fail] {
    val t:  *retention.Retention = ?p.s.retention;
    val id: retention.RetainerId = t.active;
    if (rejected) { retention.reject(t, id); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (!module.stable_is_nil(m.stable_id)) {
            val recorded: err[fail.Fail] = retention.record(t, id, m.stable_id, m.file_id, rejected);
            if (sel recorded.err) { ret recorded; }
        }
        i = i + 1;
    }
    val ended: err[fail.Fail] = retention.end_round(t, id, true);
    if (sel ended.err) { ret ended; }
    ret retention.retire(t, ?p.s.queries);
}

# a module's lowering and codegen products are keyed by its stable id, and by the
# test bit for its test object
pub fun back_half_key(stable: session.StableModuleId, test_object: bool) u64 {
    var k: u64 = module.stable_index(stable)::u64;
    if (test_object) { k = k | cache.TEST_KEY_BIT; }
    ret k;
}

pub fun back_half_key_is_test(key: u64) bool {
    ret (key & cache.TEST_KEY_BIT) != 0;
}

# the normal object's key, the same in every build that compiles the module
pub fun back_half_key_for(p: *project.Project, m: *project.ModuleEntry) u64 {
    ret back_half_key(m.stable_id, false);
}

pub fun test_key_for(m: *project.ModuleEntry) u64 {
    ret cache.test_input_key(m);
}

# the module gets a test object in this build: a test build, and a module whose
# source declares a test or a `#[testing]` declaration
pub fun has_test_object(p: *project.Project, m: *project.ModuleEntry) bool {
    ret cache.has_test_object(p, m);
}

# the load restored the module's test object and nothing needs its lowered ir
fun test_skips_lowering(p: *project.Project, m: *project.ModuleEntry) bool {
    ret cache.test_restored(p, m) && cache.early_restore_enabled(p);
}

pub fun codegen_reusable(p: *project.Project, mid: session.ModuleId) res[bool, fail.Fail] {
    val m:        *project.ModuleEntry = project.module_at(p, mid::u32);
    val reusable: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, ?CODEGEN, back_half_key_for(p, m));
    if (sel reusable.err) { ret reusable; }
    if (reusable.ok)      { ret reusable; }
    ret res[bool, fail.Fail].ok{cache.restored(p, m)};
}

pub fun test_build(p: *project.Project) bool {
    ret request.test_goal(p.req.goal);
}

# the artifact this build links is a shared library. a test build compiles the
# library's own objects, so it lowers them the way the library's build does
fun shared_artifact_build(p: *project.Project) bool {
    if (p.req.goal != request.GOAL_ARTIFACT && !test_build(p)) { ret false; }
    if (p.target_entry == nil)                                 { ret false; }
    ret p.target_entry.kind == catalog_artifact.SHARED;
}

pub fun debug_info_of(p: *project.Project) res[codegen.DebugInfo, fail.Fail] {
    var d: codegen.DebugInfo = codegen.no_debug();
    if (!p.req.debug) { ret res[codegen.DebugInfo, fail.Fail].ok{d}; }
    if (p.target.debug == nil) {
        ret res[codegen.DebugInfo, fail.Fail].err{fail.message("debug info was requested, but this target registers no debug model; build without -g or select a target with one")};
    }

    val rp: res[intern.StrId, fail.Fail] = intern_producer(?p.s.interner, p.s.alloc, p.compiler_name, p.compiler_ver);
    if (sel rp.err) { ret res[codegen.DebugInfo, fail.Fail].err{rp.err}; }
    d.emit     = true;
    d.producer = rp.ok;
    d.comp_dir = p.config.project_root;
    ret res[codegen.DebugInfo, fail.Fail].ok{d};
}

fun intern_producer(itn: *intern.Interner, alloc: *A.Allocator, name_id: intern.StrId, ver_id: intern.StrId) res[intern.StrId, fail.Fail] {
    val no: opt[str] = intern.get(itn, name_id);
    val vo: opt[str] = intern.get(itn, ver_id);
    if (sel no.none) {
        ret res[intern.StrId, fail.Fail].err{fail.message("debug: compiler identity not interned")};
    }
    if (sel vo.none) {
        ret res[intern.StrId, fail.Fail].err{fail.message("debug: compiler identity not interned")};
    }
    val jr: res[str, types_string.StrError] = str_join(alloc, no.some, " ", vo.some);
    if (sel jr.err) { ret res[intern.StrId, fail.Fail].err{fail.str_refused(jr.err)}; }
    val joined: str                        = jr.ok;
    val ri:     res[intern.StrId, A.Error] = intern.add(itn, joined);
    A.deallocate[u8](alloc, joined::*u8, str_len(joined) + 1);
    if (sel ri.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(ri.err)}; }
    ret res[intern.StrId, fail.Fail].ok{ri.ok};
}

test intern_producer__name_version {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);

    val rn: res[intern.StrId, A.Error] = intern.add(?itn, "mach");
    val rv: res[intern.StrId, A.Error] = intern.add(?itn, "2.14.0");
    if (sel rn.err) { ret 1; }
    if (sel rv.err) { ret 1; }

    val rp: res[intern.StrId, fail.Fail] = intern_producer(?itn, ?alloc,
        rn.ok, rv.ok);
    if (sel rp.err) { ret 1; }
    val got: opt[str] = intern.get(?itn, rp.ok);
    if (sel got.none)                         { ret 1; }
    if (!str_equals(got.some, "mach 2.14.0")) { ret 1; }
    ret 0;
}

pub fun run_lower_pass(p: *project.Project) err[fail.Fail] {
    val prepared: err[fail.Fail] = acquire_lower_inputs(p);
    if (sel prepared.err) { ret prepared; }

    if (lower_parallel_enabled(p)) {
        val rp: err[fail.Fail] = run_lower_parallel(p);
        if (sel rp.err) {
            ret err[fail.Fail].err{rp.err};
        }
    }

    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        if (cache.skips_lowering(p, project.module_at(p, mid::u32))) {
            i = i + 1;
            cnt;
        }

        val r: err[fail.Fail] = run_lower_one(p, mid);
        if (sel r.err) {
            ret err[fail.Fail].err{r.err};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun prepare_lower_pass(p: *project.Project) err[fail.Fail] {
    val imports: err[fail.Fail] = union.register_import_libraries(p);
    if (sel imports.err) { ret err[fail.Fail].err{fail.as_user(diagnostic_kind.LINK_IMPORT_LIBRARY, imports.err)}; }

    ret err[fail.Fail].ok{};
}

fun acquire_frontend_inputs(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.topo_len) {
        if (project.module_at(p, p.topo[i]::u32).frontend_skipped) {
            i = i + 1;
            cnt;
        }
        val acquired: res[fe_sema.Definition, fail.Fail] = frontend.read_definition(p::ptr, p.topo[i], fe_sema.DEFINITION_TYPED);
        # reading the typed definition makes the module's lowering scope, before any worker reads one
        if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun acquire_lower_inputs(p: *project.Project) err[fail.Fail] {
    val frontend: err[fail.Fail] = acquire_frontend_inputs(p);
    if (sel frontend.err) { ret frontend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.frontend_skipped) {
            i = i + 1;
            cnt;
        }
        val sf_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?LOWERED_SURFACE, module.stable_index(m.stable_id)::u64);
        if (sel sf_r.err) {
            ret err[fail.Fail].err{sf_r.err};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_reusable(p: *project.Project, mid: session.ModuleId) res[bool, fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    ret query.reusable[project.Project](?p.queries, p, ?LOWER, back_half_key_for(p, m));
}

test internal_failure_is_not_hidden_by_a_user_error {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var span: lang_source.Span;
    span.offset = 0;
    span.len    = 1;
    val emitted: err[fail.Fail] = diagnostic.report(?s.diags, diagnostic_kind.SECRET_NOT_OBLIVIOUS, lang_source.file_id(0), span, "invalid user expression");
    if (sel emitted.err) { ret 3; }
    val f: fail.Fail = fail.message("internal allocation failure after rejection");
    if (!sel f.message)                                                               { ret 4; }
    if (!str_equals(fail.describe(f), "internal allocation failure after rejection")) { ret 5; }
    ret 0;
}

test message_only_internal_failure_stays_internal {
    val f: fail.Fail = fail.message("internal failure without a diagnostic");
    if (!sel f.message)                                                         { ret 1; }
    if (!str_equals(fail.describe(f), "internal failure without a diagnostic")) { ret 2; }
    if (!fail.is_reported(fail.reported()))                                     { ret 3; }
    ret 0;
}

fun run_lower_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?LOWER, back_half_key_for(p, m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val irm: *me_ir.Module = ir_handle_decode(e_r.ok);
    if (irm == nil) { ret err[fail.Fail].err{fail.message("the lower query produced no result handle")}; }

    m.ir_module = irm;
    ret err[fail.Fail].ok{};
}

fun lowered_surface_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:  *project.Project = raw::*project.Project;
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("lowered surface: stable id not loaded this build")}; }
    val m:          *project.ModuleEntry               = project.module_at(p, mid::u32);
    val definition: res[fe_sema.Definition, fail.Fail] = frontend.read_definition(p::ptr, mid, fe_sema.DEFINITION_RESOLVED);
    if (sel definition.err) { ret res[query.QueryOutput, fail.Fail].err{definition.err}; }
    val a: *ast.Ast = definition.ok.parsed.a;

    val sf_o: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, a.file_id);
    if (sel sf_o.none) { ret res[query.QueryOutput, fail.Fail].err{fail.message("lowered surface: module source not loaded")}; }
    val text: str = sf_o.some.text;

    var spans: collections_vector.Vector[lang_source.Span] = collections_vector.init[lang_source.Span](p.s.alloc);
    fin { collections_vector.dnit[lang_source.Span](?spans); }
    val omitted: err[fail.Fail] = surface.omitted(a, text, ?spans);
    if (sel omitted.err) { ret res[query.QueryOutput, fail.Fail].err{fail.placed(p.s.alloc, omitted.err, sf_o.some.path, text)}; }
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    surface.write(?fb, text, ?spans);
    ret driver_query.output(?fb);
}

# the inputs a module's lowering reads: its typed definition and the target. every
# product built from a raw lowering records these on itself, whether it lowers or
# takes the raw module another product captured, so no edit to the source can be
# hidden behind an equal sibling product
fun lower_inputs(p: *project.Project, key: u64) res[session.ModuleId, fail.Fail] {
    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(p.s, stable);
    if (module.is_nil(mid)) { ret res[session.ModuleId, fail.Fail].err{fail.message("lower: stable id not loaded this build")}; }
    val definition: res[fe_sema.Definition, fail.Fail] = frontend.read_definition(p::ptr, mid, fe_sema.DEFINITION_TYPED);
    if (sel definition.err) { ret res[session.ModuleId, fail.Fail].err{definition.err}; }
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[session.ModuleId, fail.Fail].err{rt.err}; }
    ret res[session.ModuleId, fail.Fail].ok{mid};
}

fun lower_raw_candidate_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val inputs: res[session.ModuleId, fail.Fail] = lower_inputs(p, key);
    if (sel inputs.err) { ret res[query.QueryOutput, fail.Fail].err{inputs.err}; }
    val mid: session.ModuleId     = inputs.ok;
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);

    # a test object declares what its normal object defines, so it lowers against that object
    var normal:      me_lower.NormalObject;
    var normal_from: *me_lower.NormalObject = nil;
    val test_object: bool                   = back_half_key_is_test(key);
    if (test_object) {
        val defined: res[me_lower.NormalObject, fail.Fail] = normal_object_of(p, m);
        if (sel defined.err) { ret res[query.QueryOutput, fail.Fail].err{defined.err}; }
        normal      = defined.ok;
        normal_from = ?normal;
    }
    fin {
        if (normal_from != nil) { map.dnit[intern.StrId, bool](?normal.defined); }
    }

    val hr: res[*me_ir.ModuleHome, fail.Fail] = ir_home_new(alloc, p.s.backing);
    if (sel hr.err) { ret res[query.QueryOutput, fail.Fail].err{hr.err}; }
    val home: *me_ir.ModuleHome = hr.ok;

    var phase: readout.Phase = readout.LOWER;
    if (test_object) { phase = readout.TEST_LOWER; }
    val t_low:  readout.Instant               = readout.item_begin(p.progress);
    val rr_raw: res[*me_ir.Module, fail.Fail] = lower_raw(p, mid, home, normal_from, diags);
    if (sel rr_raw.err) {
        val stable: fail.Fail = lower_stable_fail(p, rr_raw.err);
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{stable};
    }
    readout.item(p.progress, phase, intern.text(?p.s.interner, m.fqn), t_low);
    val irmod: *me_ir.Module = rr_raw.ok;

    ret ir_handle_encode(alloc, irmod, home);
}

# every global symbol the module's normal object defines, read from its codegen
# product, which this lowering then depends on
fun normal_object_of(p: *project.Project, m: *project.ModuleEntry) res[me_lower.NormalObject, fail.Fail] {
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?CODEGEN, back_half_key_for(p, m));
    if (sel got.err) { ret res[me_lower.NormalObject, fail.Fail].err{got.err}; }
    val image: *target_of.ObjectImage = image_handle_decode(got.ok);
    if (image == nil) { ret res[me_lower.NormalObject, fail.Fail].err{fail.message("a test object requires its normal object's image")}; }
    var normal: me_lower.NormalObject = me_lower.NormalObject{defined: map.init[intern.StrId, bool](p.s.alloc)};
    var i:      u32                   = 0;
    for (i < image.symbol_count) {
        val sym: *target_of.Symbol = ?image.symbols[i];
        if ((sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0 && !target_of.section_is_external(sym.section)) {
            val added: res[bool, A.Error] = map.insert[intern.StrId, bool](?normal.defined, sym.name, true);
            if (sel added.err) {
                map.dnit[intern.StrId, bool](?normal.defined);
                ret res[me_lower.NormalObject, fail.Fail].err{fail.refused(added.err)};
            }
        }
        i = i + 1;
    }
    ret res[me_lower.NormalObject, fail.Fail].ok{normal};
}

fun inline_bodies_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:       *project.Project                  = raw::*project.Project;
    val lowered: res[query.QueryOutput, fail.Fail] = lower_raw_candidate_compute(p, key, alloc, diags);
    if (sel lowered.err) { ret lowered; }
    val output:      query.QueryOutput = lowered.ok;
    var transferred: bool              = false;
    fin {
        if (!transferred) { release_lower_output(alloc, output); }
    }
    val src:        *me_ir.Module        = ir_handle_decode(query.QueryView{value: output.bytes, value_len: output.len});
    val normalized: res[bool, fail.Fail] = me_opt.mem2reg.run(src);
    if (sel normalized.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, normalized.err)}; }
    val created: res[*me_ir.ModuleHome, fail.Fail] = ir_home_new(alloc, p.s.backing);
    if (sel created.err) { ret res[query.QueryOutput, fail.Fail].err{created.err}; }
    val home:  *me_ir.ModuleHome = created.ok;
    var homed: bool              = false;
    fin {
        if (!homed) { ir_release(alloc, home); }
    }
    val boxed: res[*me_ir.Module, A.Error] = A.allocate[me_ir.Module](?home.alloc, 1::usize);
    if (sel boxed.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(boxed.err)}; }
    val dst:         *me_ir.Module                = boxed.ok;
    val initialized: res[me_ir.Module, fail.Fail] = me_ir.init(?home.alloc, src.name);
    if (sel initialized.err) { ret res[query.QueryOutput, fail.Fail].err{initialized.err}; }
    @dst        = initialized.ok;
    dst.backing = home.backing;
    val flags: res[*bool, A.Error] = A.allocate[bool](p.s.alloc, src.function_len::usize);
    if (sel flags.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(flags.err)}; }
    val recursive: *bool = flags.ok;
    fin {
        if (recursive != nil) { A.deallocate[bool](p.s.alloc, recursive, src.function_len::usize); }
    }
    val marked: err[fail.Fail] = me_opt.inline.mark_recursive(src, recursive, p.s.alloc);
    if (sel marked.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, marked.err)}; }
    val extracted: err[fail.Fail] = body.extract(dst, src, ?p.target.target, p.s.alloc, recursive, ?me_opt.inline.OFFER);
    if (sel extracted.err) {
        ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, extracted.err)};
    }
    homed = true;
    val encoded: res[query.QueryOutput, fail.Fail] = ir_handle_encode(alloc, dst, home);
    if (sel encoded.err) { ret encoded; }
    if (p.raw_lower_capture != nil && p.raw_lower_capture.key == key && p.raw_lower_capture.output.bytes == nil) {
        p.raw_lower_capture.output = output;
        transferred                = true;
    }
    ret encoded;
}

fun release_lower_output(alloc: *A.Allocator, output: query.QueryOutput) {
    if (output.bytes == nil) { ret; }
    lower_finalize(output.bytes, output.len, alloc);
    A.deallocate[u8](alloc, output.bytes, output.len::usize);
}

fun lower_candidate_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    # a test object offers no bodies to inline: its tests are reached only by the dispatcher
    if (p.req.opt != pipeline.OPT_RELEASE || back_half_key_is_test(key)) { ret lower_raw_candidate_compute(p, key, alloc, diags); }
    val inputs: res[session.ModuleId, fail.Fail] = lower_inputs(p, key);
    if (sel inputs.err) { ret res[query.QueryOutput, fail.Fail].err{inputs.err}; }
    var local: project.RawLowerCapture;
    local.key = key;
    val saved: *project.RawLowerCapture = p.raw_lower_capture;
    if (saved == nil) { p.raw_lower_capture = ?local; }
    fin {
        p.raw_lower_capture = saved;
        release_lower_output(alloc, local.output);
    }
    val available: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?INLINE_BODIES, key);
    if (sel available.err) { ret res[query.QueryOutput, fail.Fail].err{available.err}; }
    if (p.raw_lower_capture.key == key && p.raw_lower_capture.output.bytes != nil) {
        val out: query.QueryOutput = p.raw_lower_capture.output;
        p.raw_lower_capture.output = query.QueryOutput{};
        ret res[query.QueryOutput, fail.Fail].ok{out};
    }
    ret lower_raw_candidate_compute(p, key, alloc, diags);
}

# the bodies m may inline come from each defining module's normal lowering. a test
# object also takes its own module's, whose definitions its normal object holds
fun acquire_inline_bodies(p: *project.Project, m: *me_ir.Module, available: *body.Available, test_object: bool) err[fail.Fail] {
    if (p.req.opt != pipeline.OPT_RELEASE) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < m.function_len) {
        val origin: intern.StrId = m.functions[i].body_module;
        if ((m.functions[i].flags & me_ir.FN_FLAG_EXTERN) == 0 || intern.str_is_nil(origin) || (intern.str_same(origin, m.name) && !test_object)) {
            i = i + 1;
            cnt;
        }
        val stable: session.StableModuleId = session.stable_module_id_lookup(p.s, origin);
        if (module.stable_is_nil(stable)) { ret err[fail.Fail].err{fail.message("inline body: defining module has no stable query identity")}; }
        val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?INLINE_BODIES, back_half_key(stable, false));
        if (sel got.err) { ret err[fail.Fail].err{got.err}; }
        val provider: *me_ir.Module = ir_handle_decode(got.ok);
        if (provider == nil) { ret err[fail.Fail].err{fail.message("inline body: provider has no owned product")}; }
        val imported: err[fail.Fail] = body.acquire(available, m, provider, m.functions[i].name, ?p.target.target, p.s.alloc);
        if (sel imported.err) { ret err[fail.Fail].err{imported.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a module's lowering, optimized. a lowering the caller prepared with its capture deferred stops
# before optimization: the caller's workers optimize it and complete the prepared product
fun lower_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:       *project.Project                  = raw::*project.Project;
    val lowered: res[query.QueryOutput, fail.Fail] = lower_candidate_compute(p, key, alloc, diags);
    if (sel lowered.err) { ret lowered; }
    val output:      query.QueryOutput = lowered.ok;
    var transferred: bool              = false;
    fin {
        if (!transferred) { release_lower_output(alloc, output); }
    }
    val irmod:     *me_ir.Module            = ir_handle_decode(query.QueryView{value: output.bytes, value_len: output.len});
    val capture:   *project.RawLowerCapture = p.raw_lower_capture;
    val deferred:  bool                     = capture != nil && capture.deferred && capture.key == key;
    var storage:   body.Available;
    var available: *body.Available          = nil;
    var opened:    bool                     = false;
    fin {
        if (opened) { body.available_dnit(available, irmod); }
    }
    if (p.req.opt == pipeline.OPT_RELEASE) {
        if (deferred) {
            if (capture.available == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("deferred lowering requires its scoped body owner")}; }
            available = capture.available;
        }
        or {
            val made: err[fail.Fail] = body.available_init(?storage, irmod.name, p.s.backing, me_opt.inline.OFFER);
            if (sel made.err) { ret res[query.QueryOutput, fail.Fail].err{made.err}; }
            available = ?storage;
            opened    = true;
        }
        val imported: err[fail.Fail] = acquire_inline_bodies(p, irmod, available, back_half_key_is_test(key));
        if (sel imported.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, imported.err)}; }
    }
    if (deferred) {
        transferred = true;
        ret lowered;
    }
    val t_opt:     readout.Instant = readout.span_begin(p.progress);
    val optimized: err[fail.Fail]  = lower_optimize(p, irmod, available, diags);
    # a test object's optimization is part of the test phase's own row
    if (!back_half_key_is_test(key)) {
        readout.item(p.progress, readout.OPTIMIZE, intern.text(?p.s.interner, irmod.name), t_opt);
        readout.span_end(p.progress, readout.OPTIMIZE, readout.LOWER, t_opt);
    }
    if (sel optimized.err) { ret res[query.QueryOutput, fail.Fail].err{lower_stable_fail(p, optimized.err)}; }
    transferred = true;
    ret lowered;
}

fun lower_raw(p: *project.Project, mid: session.ModuleId, home: *me_ir.ModuleHome, normal: *me_lower.NormalObject, diags: *diagnostic.DiagnosticStore) res[*me_ir.Module, fail.Fail] {
    val s: *session.Session     = p.s;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val definition: res[fe_sema.Definition, fail.Fail] = frontend.read_definition(p::ptr, mid, fe_sema.DEFINITION_TYPED);
    if (sel definition.err) { ret res[*me_ir.Module, fail.Fail].err{definition.err}; }
    val d:     fe_sema.Definition                    = definition.ok;
    val req_r: res[me_lower.LowerRequest, fail.Fail] = me_lower.request(s, ?p.target.target, ?home.alloc, d.parsed.a, m.fqn, mid,
        d.sr, d.rr, d.ctx, normal, shared_artifact_build(p), p.req.debug, p.req.opt != pipeline.OPT_RELEASE, diags,
        fe_sema.interface.Reader{ctx: p::ptr, read: read_interface});
    if (sel req_r.err) { ret res[*me_ir.Module, fail.Fail].err{req_r.err}; }
    var req: me_lower.LowerRequest = req_r.ok;

    val res_lower: res[me_ir.Module, fail.Fail] = me_lower.lower_module(?req);
    if (sel res_lower.err) { ret res[*me_ir.Module, fail.Fail].err{res_lower.err}; }

    val br: res[*me_ir.Module, A.Error] = A.allocate[me_ir.Module](?home.alloc, 1::usize);
    if (sel br.err) { ret res[*me_ir.Module, fail.Fail].err{fail.refused(br.err)}; }
    val box: *me_ir.Module = br.ok;
    box[0]      = res_lower.ok;
    box.backing = home.backing;

    var scope:   me_check.scope.Scope = me_check.scope.init(box, ?p.target.target, ?s.interner, diags, s.alloc);
    val checked: err[fail.Fail]       = me_check.oblivious.run(?scope);
    if (sel checked.err) { ret res[*me_ir.Module, fail.Fail].err{checked.err}; }
    ret res[*me_ir.Module, fail.Fail].ok{box};
}

# the interface the module `mid` published, which is all an importer's lowering reads of it
fun read_interface(raw: ptr, mid: session.ModuleId) res[*fe_sema.interface.Interface, fail.Fail] {
    val p:        *project.Project                    = raw::*project.Project;
    val acquired: res[*fe_sema.SemaResult, fail.Fail] = frontend.acquire_sema(p, mid);
    if (sel acquired.err)                      { ret res[*fe_sema.interface.Interface, fail.Fail].err{acquired.err}; }
    if (!sel acquired.ok.status.kind.accepted) { ret res[*fe_sema.interface.Interface, fail.Fail].err{fail.phase_failure(acquired.ok.status)}; }
    ret res[*fe_sema.interface.Interface, fail.Fail].ok{?acquired.ok.interface};
}

fun lower_optimize(p: *project.Project, irmod: *me_ir.Module, available: *body.Available, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    var preq: pipeline.PipelineRequest;
    preq.module       = irmod;
    preq.available    = available;
    preq.target       = ?p.target.target;
    preq.level        = p.req.opt;
    preq.passes       = p.req.passes;
    preq.skips        = p.req.skips;
    preq.simd_require = pipeline.SimdRequireOption{v: p.req.simd == manifest.SIMD_REQUIRE};
    preq.relax        = p.req.relax;
    preq.interner     = ?p.s.interner;
    preq.source_map   = ?p.s.sources;
    preq.diags        = diags;
    val res_opt: res[bool, fail.Fail] = pipeline.run(?preq);
    if (sel res_opt.err) { ret err[fail.Fail].err{res_opt.err}; }
    ret err[fail.Fail].ok{};
}

fun ir_home_new(alloc: *A.Allocator, backing: *A.Allocator) res[*me_ir.ModuleHome, fail.Fail] {
    val hr: res[*me_ir.ModuleHome, A.Error] = A.allocate[me_ir.ModuleHome](alloc, 1::usize);
    if (sel hr.err) { ret res[*me_ir.ModuleHome, fail.Fail].err{fail.refused(hr.err)}; }
    val home: *me_ir.ModuleHome = hr.ok;
    val io:   err[fail.Fail]    = me_ir.home_init(home, backing);
    if (sel io.err) {
        A.deallocate[me_ir.ModuleHome](alloc, home, 1::usize);
        ret res[*me_ir.ModuleHome, fail.Fail].err{io.err};
    }
    ret res[*me_ir.ModuleHome, fail.Fail].ok{home};
}

fun lower_stable_fail(p: *project.Project, f: fail.Fail) fail.Fail {
    if (sel f.reported) { ret f; }
    ret fail.with_text(f, lower_stable_err(p, fail.describe(f)));
}

fun lower_stable_err(p: *project.Project, msg: str) str {
    val kept: res[str, fail.Fail] = fail.text_retain(?p.s.interner, msg);
    if (sel kept.ok) { ret kept.ok; }
    ret "lowering failed, and re-homing its diagnostic off the module arena failed in turn (allocation failure)";
}

fun ir_release(alloc: *A.Allocator, home: *me_ir.ModuleHome) {
    if (home == nil) { ret; }
    me_ir.home_dnit(home);
    A.deallocate[me_ir.ModuleHome](alloc, home, 1::usize);
}

fun lower_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len < ir_handle_len()) { ret; }
    val slot: *ptr = value::ptr::*ptr;
    ir_release(alloc, slot[1]::*me_ir.ModuleHome);
}

fun ir_handle_len() u32 {
    ret ($size_of(ptr) * 2)::u32;
}

fun ir_handle_encode(alloc: *A.Allocator, r: *me_ir.Module, home: *me_ir.ModuleHome) res[query.QueryOutput, fail.Fail] {
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, ir_handle_len()::usize);
    if (sel rb.err) {
        ir_release(alloc, home);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8  = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    slot[1] = home::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = ir_handle_len();
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun ir_handle_decode(e: query.QueryView) *me_ir.Module {
    if (e.value == nil || e.value_len < ir_handle_len()) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*me_ir.Module;
}

fun lower_parallel_enabled(p: *project.Project) bool {
    ret p.req.jobs >= 1 && p.emit_len > 0;
}

rec PlwSlot {
    prepared:       query.PreparedQuery;
    capture:        project.RawLowerCapture;
    available:      body.Available;
    available_live: bool;
    live:           bool;
    mid:            session.ModuleId;
    m:              *me_ir.Module;
    diags:          *diagnostic.DiagnosticStore;
    failed:         bool;
    fail:           fail.Fail;
}

rec ParallelLower {
    p:        *project.Project;
    next:     i64;
    stop:     i64;
    slots:    *PlwSlot;
    slot_len: u32;
}

fun plw_worker_main(arg: *u8) {
    val pl: *ParallelLower = arg::*ParallelLower;
    if (pl == nil) { ret; }

    for (true) {
        if (atomic.load(?pl.stop) != 0) { ret; }
        val idx_raw: i64 = atomic.fetch_add(?pl.next, 1::i64);
        if (idx_raw >= pl.slot_len::i64) { ret; }

        val slot: *PlwSlot        = ?pl.slots[idx_raw::usize];
        val t0:   readout.Instant = readout.item_begin(pl.p.progress);
        val r:    err[fail.Fail]  = lower_optimize(pl.p, slot.m, slot.capture.available, slot.diags);
        val name: str             = intern.text(?pl.p.s.interner, project.module_at(pl.p, slot.mid::u32).fqn);
        readout.item_post(pl.p.progress, readout.OPTIMIZE, name, readout.elapsed(t0));
        if (sel r.err) {
            slot.fail   = r.err;
            slot.failed = true;
            atomic.store(?pl.stop, 1::i64);
            ret;
        }
    }
}

fun run_lower_parallel(p: *project.Project) err[fail.Fail] {
    val count: u32 = p.emit_len;
    if (count == 0) { ret err[fail.Fail].ok{}; }
    val allocated: res[*PlwSlot, A.Error] = A.allocate[PlwSlot](p.alloc, count::usize);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    val slots: *PlwSlot = allocated.ok;
    fin { A.deallocate[PlwSlot](p.alloc, slots, count::usize); }
    var i: u32 = 0;
    for (i < count) {
        slots[i] = PlwSlot{};
        i        = i + 1;
    }
    var result: err[fail.Fail] = run_lower_batch(p, slots, count);
    i = 0;
    for (i < count) {
        if (slots[i].available_live) {
            body.available_dnit(?slots[i].available, slots[i].m);
            slots[i].available_live = false;
        }
        release_lower_output(p.s.queries.a, slots[i].capture.output);
        slots[i].capture.output = query.QueryOutput{};
        if (slots[i].live) {
            val cancelled: err[fail.Fail] = query.cancel_prepared(?p.s.queries, slots[i].prepared);
            if (sel cancelled.err) {
                if (!(sel result.err && !(fail.is_reported(result.err)))) {
                    result = err[fail.Fail].err{cancelled.err};
                }
            }
        }
        i = i + 1;
    }
    ret result;
}

fun prime_inline_bodies(p: *project.Project, capture: *project.RawLowerCapture) err[fail.Fail] {
    val saved: *project.RawLowerCapture = p.raw_lower_capture;
    p.raw_lower_capture = capture;
    fin { p.raw_lower_capture = saved; }
    val got: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?INLINE_BODIES, capture.key);
    if (sel got.err) { ret err[fail.Fail].err{got.err}; }
    ret err[fail.Fail].ok{};
}

fun prepare_lower_slot(p: *project.Project, capture: *project.RawLowerCapture) res[query.PreparedQuery, fail.Fail] {
    val saved: *project.RawLowerCapture = p.raw_lower_capture;
    p.raw_lower_capture = capture;
    fin { p.raw_lower_capture = saved; }
    ret query.prepare[project.Project](?p.queries, p, ?LOWER, capture.key);
}

fun run_lower_batch(p: *project.Project, slots: *PlwSlot, emit_len: u32) err[fail.Fail] {
    var slot_len: u32 = 0;
    var ti:       u32 = 0;
    for (ti < emit_len) {
        val mid:      session.ModuleId     = p.topo[ti];
        val reusable: res[bool, fail.Fail] = lower_reusable(p, mid);
        if (sel reusable.err) {
            ret err[fail.Fail].err{reusable.err};
        }
        if (!reusable.ok && !cache.skips_lowering(p, project.module_at(p, mid::u32))) {
            slots[slot_len].mid    = mid;
            slots[slot_len].m      = nil;
            slots[slot_len].failed = false;
            slot_len               = slot_len + 1;
        }
        ti = ti + 1;
    }
    if (slot_len <= 1) {
        ret err[fail.Fail].ok{};
    }
    var prime: u32 = 0;
    for (prime < slot_len) {
        val m: *project.ModuleEntry = project.module_at(p, slots[prime].mid::u32);
        slots[prime].capture.key      = back_half_key_for(p, m);
        slots[prime].capture.deferred = true;
        if (p.req.opt == pipeline.OPT_RELEASE) {
            val initialized: err[fail.Fail] = body.available_init(?slots[prime].available, m.fqn, p.s.backing, me_opt.inline.OFFER);
            if (sel initialized.err) { ret err[fail.Fail].err{initialized.err}; }
            slots[prime].available_live    = true;
            slots[prime].capture.available = ?slots[prime].available;
            val primed: err[fail.Fail] = prime_inline_bodies(p, ?slots[prime].capture);
            if (sel primed.err) { ret primed; }
        }
        prime = prime + 1;
    }

    var si: u32 = 0;
    for (si < slot_len) {
        val mid: session.ModuleId     = slots[si].mid;
        val m:   *project.ModuleEntry = project.module_at(p, mid::u32);

        val prepared: res[query.PreparedQuery, fail.Fail] = prepare_lower_slot(p, ?slots[si].capture);
        if (sel prepared.err) { ret err[fail.Fail].err{prepared.err}; }
        slots[si].prepared = prepared.ok;
        slots[si].live     = true;
        val view: res[query.QueryView, fail.Fail] = query.prepared_view(?p.s.queries, slots[si].prepared);
        if (sel view.err) { ret err[fail.Fail].err{view.err}; }
        slots[si].m = ir_handle_decode(view.ok);
        if (slots[si].m == nil) { ret err[fail.Fail].err{fail.message("prepared lowering has no IR owner")}; }
        val store: res[*diagnostic.DiagnosticStore, fail.Fail] = query.prepared_diags(?p.s.queries, slots[si].prepared);
        if (sel store.err) { ret err[fail.Fail].err{store.err}; }
        slots[si].diags = store.ok;
        si              = si + 1;
    }

    if (p.raw_lower_capture != nil) { ret err[fail.Fail].err{fail.message("lower: synchronous raw capture escaped into worker execution")}; }
    var nworkers: u32 = p.req.jobs;
    if (nworkers == 0)       { nworkers = 1; }
    if (nworkers > slot_len) { nworkers = slot_len; }

    var pl: ParallelLower;
    pl.p        = p;
    pl.next     = 0;
    pl.stop     = 0;
    pl.slots    = slots;
    pl.slot_len = slot_len;

    val queued: err[fail.Fail] = readout.workers_begin(p.progress, p.alloc, slot_len::usize);
    if (sel queued.err) { ret queued; }
    val t_opt:   readout.Instant     = readout.span_begin(p.progress);
    var threads: *sync_thread.Thread = nil;
    val extra:   u32                 = nworkers - 1;
    p.lowering_workers = true;
    fin { p.lowering_workers = false; }
    if (extra > 0) {
        val rt: res[*sync_thread.Thread, A.Error] = A.allocate[sync_thread.Thread](p.alloc, extra::usize);
        if (sel rt.err) {
            readout.workers_end(p.progress, p.alloc, readout.OPTIMIZE, 1);
            ret err[fail.Fail].err{fail.refused(rt.err)};
        }
        threads = rt.ok;
        var k: u32 = 0;
        for (k < extra) {
            sync_thread.spawn_with(plw_worker_main, (?pl)::*u8, ?threads[k]);
            k = k + 1;
        }
    }

    plw_worker_main((?pl)::*u8);

    if (extra > 0) {
        var k: u32 = 0;
        for (k < extra) {
            if (threads[k].tid >= 0) { sync_thread.join(?threads[k]); }
            k = k + 1;
        }
        A.deallocate[sync_thread.Thread](p.alloc, threads, extra::usize);
    }
    readout.span_end(p.progress, readout.OPTIMIZE, readout.LOWER, t_opt);

    readout.workers_end(p.progress, p.alloc, readout.OPTIMIZE, nworkers);

    var ei: u32 = 0;
    for (ei < slot_len) {
        if (slots[ei].failed) {
            val result: err[fail.Fail] = query.complete_prepared(?p.s.queries, slots[ei].prepared,
                err[fail.Fail].err{slots[ei].fail});
            slots[ei].live = false;
            ret result;
        }
        ei = ei + 1;
    }
    ei = 0;
    for (ei < slot_len) {
        val result: err[fail.Fail] = query.complete_prepared(?p.s.queries, slots[ei].prepared, err[fail.Fail].ok{});
        slots[ei].live = false;
        if (sel result.err) { ret result; }
        ei = ei + 1;
    }
    ret err[fail.Fail].ok{};
}

# the modules that still lower here are those without a product restored under
# this operation's snapshot; a module restored in the lower operation keeps its
# staged product when the snapshot is unchanged and lowers now if it changed
pub fun acquire_codegen_inputs(p: *project.Project) err[fail.Fail] {
    var clear: u32 = 0;
    for (clear < project.module_count(p)) {
        project.module_at(p, clear).ir_module = nil;
        clear                                 = clear + 1;
    }
    val frontend: err[fail.Fail] = acquire_frontend_inputs(p);
    if (sel frontend.err) { ret frontend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        if (cache.skips_lowering(p, project.module_at(p, mid::u32))) {
            i = i + 1;
            cnt;
        }
        val acquired: err[fail.Fail] = run_lower_one(p, mid);
        if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the test operation's inputs: the typed definitions and each test object's
# lowered ir, unless the load restored its object from `obj/`
pub fun acquire_test_inputs(p: *project.Project) err[fail.Fail] {
    var clear: u32 = 0;
    for (clear < project.module_count(p)) {
        project.module_at(p, clear).test.ir_module = nil;
        clear                                      = clear + 1;
    }
    val frontend: err[fail.Fail] = acquire_frontend_inputs(p);
    if (sel frontend.err) { ret frontend; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId     = p.topo[i];
        val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
        if (has_test_object(p, m) && !test_skips_lowering(p, m)) {
            val lowered: err[fail.Fail] = run_test_lower_one(p, mid);
            if (sel lowered.err) { ret err[fail.Fail].err{lowered.err}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
pub fun run_test_pass(p: *project.Project) err[fail.Fail] {
    val inputs: err[fail.Fail] = acquire_test_inputs(p);
    if (sel inputs.err) { ret inputs; }
    ret run_test_object_pass(p);
}

pub fun run_test_object_pass(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];
        if (has_test_object(p, project.module_at(p, mid::u32))) {
            val r: err[fail.Fail] = run_test_object_one(p, mid);
            if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun run_codegen_pass(p: *project.Project) err[fail.Fail] {
    val inputs: err[fail.Fail] = acquire_codegen_inputs(p);
    if (sel inputs.err) { ret inputs; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val mid: session.ModuleId = p.topo[i];

        val r: err[fail.Fail] = run_codegen_one(p, mid);
        if (sel r.err) {
            ret err[fail.Fail].err{r.err};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the other modules' lowered ir a whole-module backend reads to generate `seed`, module mid's ir
pub fun code_sources(p: *project.Project, mid: session.ModuleId, seed: *me_ir.Module, a: *A.Allocator) res[CodeSources, fail.Fail] {
    if (!isa.emits_whole_module(p.target.isa)) { ret res[CodeSources, fail.Fail].ok{sources_empty()}; }
    val n: u32 = project.module_count(p);
    if (n == 0) { ret res[CodeSources, fail.Fail].ok{sources_empty()}; }

    val rm: res[*bool, A.Error] = A.allocate[bool](a, n::usize);
    if (sel rm.err) { ret res[CodeSources, fail.Fail].err{fail.refused(rm.err)}; }
    val mark: *bool = rm.ok;
    fin { A.deallocate[bool](a, mark, n::usize); }
    var i: u32 = 0;
    for (i < n) {
        mark[i] = false;
        i       = i + 1;
    }
    mark[mid::u32] = true;

    var changed: bool = true;
    for (changed) {
        changed = false;
        i       = 0;
        for (i < n) {
            if (!mark[i]) {
                i = i + 1;
                cnt;
            }
            var im: *me_ir.Module = project.module_at(p, i).ir_module;
            if (i == mid::u32) { im = seed; }
            if (im == nil) {
                i = i + 1;
                cnt;
            }
            var fi: u32 = 0;
            for (fi < im.function_len) {
                val fn: *me_ir.Function = ?im.functions[fi];
                if ((fn.flags & me_ir.FN_FLAG_EXTERN) == 0 || fn.is_import) {
                    fi = fi + 1;
                    cnt;
                }
                val def: u32 = definer_of(p, fn.name);
                if (def != n && !mark[def]) {
                    mark[def] = true;
                    changed   = true;
                }
                fi = fi + 1;
            }
            var gi: u32 = 0;
            for (gi < im.global_len) {
                val g: *me_ir.Global = ?im.globals[gi];
                if (!g.is_extern || g.is_import) {
                    gi = gi + 1;
                    cnt;
                }
                val gdef: u32 = global_definer_of(p, g.name);
                if (gdef != n && !mark[gdef]) {
                    mark[gdef] = true;
                    changed    = true;
                }
                gi = gi + 1;
            }
            i = i + 1;
        }
    }

    var count: u32 = 0;
    i = 0;
    for (i < n) {
        if (mark[i] && source_of(p, i, mid, seed) != nil) { count = count + 1; }
        i = i + 1;
    }
    if (count == 0) { ret res[CodeSources, fail.Fail].ok{sources_empty()}; }

    var cs: CodeSources                  = sources_empty();
    val rs: res[**me_ir.Module, A.Error] = A.allocate[*me_ir.Module](a, count::usize);
    if (sel rs.err) { ret res[CodeSources, fail.Fail].err{fail.refused(rs.err)}; }
    cs.set.mods = rs.ok;
    var handed: bool = false;
    fin {
        if (!handed) { A.deallocate[*me_ir.Module](a, cs.set.mods, count::usize); }
    }
    val ri: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](a, count::usize);
    if (sel ri.err) { ret res[CodeSources, fail.Fail].err{fail.refused(ri.err)}; }
    cs.ids = ri.ok;
    cs.cap = count;

    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val tid: u32 = p.topo[ti]::u32;
        if (mark[tid] && source_of(p, tid, mid, seed) != nil && cs.set.len < count) {
            cs.set.mods[cs.set.len] = project.module_at(p, tid).ir_module;
            cs.ids[cs.set.len]      = p.topo[ti];
            cs.set.len              = cs.set.len + 1;
        }
        ti = ti + 1;
    }
    handed = true;
    ret res[CodeSources, fail.Fail].ok{cs};
}

# module i's ir as a code source for generating `seed`: another module's lowered ir,
# or the module's own normal ir when `seed` is its test object
fun source_of(p: *project.Project, i: u32, mid: session.ModuleId, seed: *me_ir.Module) *me_ir.Module {
    val im: *me_ir.Module = project.module_at(p, i).ir_module;
    if (i == mid::u32 && im == seed) { ret nil; }
    ret im;
}

pub rec CodeSources {
    set: mir_unit.IrSet;
    ids: *session.ModuleId;
    cap: u32;
}

fun sources_empty() CodeSources {
    var cs: CodeSources;
    cs.set = mir_unit.ir_set_empty();
    cs.ids = nil;
    cs.cap = 0;
    ret cs;
}

pub fun sources_dnit(a: *A.Allocator, cs: *CodeSources) {
    if (cs.cap > 0) {
        if (cs.set.mods != nil) { A.deallocate[*me_ir.Module](a, cs.set.mods, cs.cap::usize); }
        if (cs.ids != nil)      { A.deallocate[session.ModuleId](a, cs.ids, cs.cap::usize); }
    }
    cs.set.mods = nil;
    cs.set.len  = 0;
    cs.ids      = nil;
    cs.cap      = 0;
}

fun definer_of(p: *project.Project, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val im: *me_ir.Module = project.module_at(p, i).ir_module;
        if (im != nil && mir_unit.defined_index(im, name) != mir_unit.UNIT_NONE) { ret i; }
        i = i + 1;
    }
    ret project.module_count(p);
}

fun global_definer_of(p: *project.Project, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val im: *me_ir.Module = project.module_at(p, i).ir_module;
        if (im != nil && mir_unit.defined_global_index(im, name) != mir_unit.UNIT_NONE) { ret i; }
        i = i + 1;
    }
    ret project.module_count(p);
}

fun run_codegen_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?CODEGEN, back_half_key_for(p, m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val img: *target_of.ObjectImage = image_handle_decode(e_r.ok);
    if (img == nil) { ret err[fail.Fail].err{fail.message("the codegen query produced no result handle")}; }

    m.object_image = img;
    # a generated object, or one this session held, carries the key of the
    # current snapshot into `obj/`
    var back: [3]*query.Kind = back_half_kinds();
    ret cache.publish(p, m, img, cache.BackHalf{kinds: ?back[0], count: 3, key: back_half_key_for(p, m)});
}

# the kinds of an object's back half, whose warnings its cache record carries
fun back_half_kinds() [3]*query.Kind {
    ret [3]*query.Kind{?INLINE_BODIES, ?LOWER, ?CODEGEN};
}

# the module's test object, lowered against its normal object and generated
fun run_test_object_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?CODEGEN, test_key_for(m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val img: *target_of.ObjectImage = image_handle_decode(e_r.ok);
    if (img == nil) { ret err[fail.Fail].err{fail.message("the codegen query produced no test object handle")}; }

    m.test.object_image = img;
    var back: [3]*query.Kind = back_half_kinds();
    ret cache.publish_test(p, m, img, cache.BackHalf{kinds: ?back[0], count: 3, key: test_key_for(m)});
}

# the module's test ir, which test codegen workers read before the query publishes the object
fun run_test_lower_one(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m:   *project.ModuleEntry            = project.module_at(p, mid::u32);
    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?LOWER, test_key_for(m));
    if (sel e_r.err) { ret err[fail.Fail].err{e_r.err}; }
    val irm: *me_ir.Module = ir_handle_decode(e_r.ok);
    if (irm == nil) { ret err[fail.Fail].err{fail.message("the lower query produced no test object handle")}; }
    m.test.ir_module = irm;
    ret err[fail.Fail].ok{};
}

# the test object's codegen product is current or cached, so no worker generates it
pub fun test_codegen_reusable(p: *project.Project, mid: session.ModuleId) res[bool, fail.Fail] {
    val m:        *project.ModuleEntry = project.module_at(p, mid::u32);
    val reusable: res[bool, fail.Fail] = query.reusable[project.Project](?p.queries, p, ?CODEGEN, test_key_for(m));
    if (sel reusable.err) { ret reusable; }
    if (reusable.ok)      { ret reusable; }
    ret res[bool, fail.Fail].ok{cache.test_restored(p, m)};
}

fun codegen_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:  *project.Project = raw::*project.Project;
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    val stable: session.StableModuleId = key::u32::session.StableModuleId;
    val mid:    session.ModuleId       = session.module_id_for_stable(s, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("codegen: stable id not loaded this build")}; }
    val m:           *project.ModuleEntry = project.module_at(p, mid::u32);
    val test_object: bool                 = back_half_key_is_test(key);
    if (!test_object && cache.staged_restored(p, m))     { ret q_codegen_restored(p, mid, false, alloc); }
    if (test_object && cache.test_staged_restored(p, m)) { ret q_codegen_restored(p, mid, true, alloc); }
    val lower_owner: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?LOWER, key);
    if (sel lower_owner.err) { ret res[query.QueryOutput, fail.Fail].err{lower_owner.err}; }
    val irmod: *me_ir.Module = ir_handle_decode(lower_owner.ok);
    if (irmod == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("codegen: module has no lowered IR")}; }
    if (test_object)  { m.test.ir_module = irmod; }
    or                { m.ir_module = irmod; }
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }

    val srcs_r: res[CodeSources, fail.Fail] = code_sources(p, mid, irmod, s.alloc);
    if (sel srcs_r.err) { ret res[query.QueryOutput, fail.Fail].err{srcs_r.err}; }
    var srcs: CodeSources = srcs_r.ok;
    fin { sources_dnit(s.alloc, ?srcs); }
    var di: u32 = 0;
    for (di < srcs.set.len) {
        val dm: *project.ModuleEntry = project.module_at(p, srcs.ids[di]::u32);
        val rd: err[fail.Fail]       = query.depend[project.Project](?p.queries, p, ?LOWER, back_half_key_for(p, dm));
        if (sel rd.err) { ret res[query.QueryOutput, fail.Fail].err{rd.err}; }
        di = di + 1;
    }

    # a parallel codegen worker staged this object's fresh image
    var staged: *target_of.ObjectImage = nil;
    if (test_object)   { staged = cache.take_staged_test(p, m); }
    or                 { staged = cache.take_staged(p, m); }
    if (staged != nil) { ret image_handle_encode(alloc, staged); }

    val dbg_r: res[codegen.DebugInfo, fail.Fail] = debug_info_of(p);
    if (sel dbg_r.err) { ret res[query.QueryOutput, fail.Fail].err{dbg_r.err}; }

    var phase: readout.Phase = readout.CODEGEN;
    if (test_object) { phase = readout.TEST_CODEGEN; }
    val t_cg:   readout.Instant                       = readout.item_begin(p.progress);
    val res_cg: res[target_of.ObjectImage, fail.Fail] = codegen.codegen_unit(s, ?p.target, irmod, srcs.set, nil, dbg_r.ok, diags);
    if (sel res_cg.err) { ret res[query.QueryOutput, fail.Fail].err{res_cg.err}; }
    readout.item(p.progress, phase, intern.text(?p.s.interner, m.fqn), t_cg);
    var img: target_of.ObjectImage = res_cg.ok;

    val br: res[*target_of.ObjectImage, A.Error] = A.allocate[target_of.ObjectImage](alloc, 1::usize);
    if (sel br.err) {
        target_of.object_image_dnit(?img);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(br.err)};
    }
    val box: *target_of.ObjectImage = br.ok;
    box[0] = img;
    ret image_handle_encode(alloc, box);
}

# a product restored from `obj/` becomes the module's codegen product with the
# target and the codegen flags as its edges, plus the module's object key,
# which is the persistent key's in-process image: any input the key covers
# advances it. a test object's key derives from the same one. it reads no
# typed definition, so a module nothing compiled imports is never typed
fun q_codegen_restored(p: *project.Project, mid: session.ModuleId, test_object: bool, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    val m:  *project.ModuleEntry = project.module_at(p, mid::u32);
    val rt: err[fail.Fail]       = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    var input: u64 = module.stable_index(m.stable_id)::u64;
    if (test_object) { input = cache.test_input_key(m); }
    val keyed: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?cache.OBJECT_KEY, input);
    if (sel keyed.err) { ret res[query.QueryOutput, fail.Fail].err{keyed.err}; }
    var staged: *target_of.ObjectImage = nil;
    if (test_object)   { staged = cache.take_staged_test(p, m); }
    or                 { staged = cache.take_staged(p, m); }
    if (staged == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("codegen: restored product left the module")}; }
    ret image_handle_encode(alloc, staged);
}

fun codegen_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ptr)) { ret; }
    val slot: *ptr                   = value::ptr::*ptr;
    val r:    *target_of.ObjectImage = slot[0]::*target_of.ObjectImage;
    if (r == nil) { ret; }
    target_of.object_image_dnit(r);
    A.deallocate[target_of.ObjectImage](alloc, r, 1::usize);
}

fun image_handle_encode(alloc: *A.Allocator, r: *target_of.ObjectImage) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ptr)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        target_of.object_image_dnit(r);
        A.deallocate[target_of.ObjectImage](alloc, r, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8  = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun image_handle_decode(e: query.QueryView) *target_of.ObjectImage {
    if (e.value == nil || e.value_len::usize < $size_of(ptr)) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*target_of.ObjectImage;
}

pub fun run_link_pass(p: *project.Project) res[bool, fail.Fail] {
    val images: err[fail.Fail] = run_codegen_pass(p);
    if (sel images.err) { ret res[bool, fail.Fail].err{images.err}; }
    val prior: query.Revision                  = query.peek_revision(?p.s.queries, ?LINK, 0);
    val e_r:   res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?LINK, 0);
    if (sel e_r.err) { ret res[bool, fail.Fail].err{e_r.err}; }
    val now: query.Revision = e_r.ok.last_changed;
    ret res[bool, fail.Fail].ok{now != prior};
}

fun link_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:  *project.Project = raw::*project.Project;
    val db: *query.QueryDb   = ?p.s.queries;
    val s:  *session.Session = p.s;

    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }

    val rt: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    wire.put_u64(?fb, rt.ok);

    val rc: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p, ?LINK_CONFIG, 0);
    if (sel rc.err) { ret res[query.QueryOutput, fail.Fail].err{rc.err}; }
    wire.put_u64(?fb, rc.ok);

    wire.put_u32(?fb, p.emit_len);
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m:  *project.ModuleEntry           = project.module_at(p, (p.topo[i])::u32);
        val rd: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p, ?CODEGEN, back_half_key_for(p, m));
        if (sel rd.err) { ret res[query.QueryOutput, fail.Fail].err{rd.err}; }
        wire.put_u64(?fb, rd.ok);
        # a test build links each test object too
        if (has_test_object(p, m)) {
            val rtest: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p, ?CODEGEN, test_key_for(m));
            if (sel rtest.err) { ret res[query.QueryOutput, fail.Fail].err{rtest.err}; }
            wire.put_u64(?fb, rtest.ok);
        }
        i = i + 1;
    }

    ret driver_query.output(?fb);
}

# key the loaded modules and read `obj/` under their keys (driver/cache),
# reported as the cache phase carved out of resolve, which it precedes
pub fun prepare_object_cache(p: *project.Project) err[fail.Fail] {
    if (!p.req.object_cache) {
        cache.forget(p);
        ret err[fail.Fail].ok{};
    }
    readout.phase_begin(p.progress, readout.CACHE);
    val t_cache:  readout.Instant                   = readout.span_begin(p.progress);
    val captured: res[query.QueryOutput, fail.Fail] = context.capture_configuration_identity(p, p.s.backing);
    if (sel captured.err) { ret err[fail.Fail].err{captured.err}; }
    val config: query.QueryOutput = captured.ok;
    fin {
        if (config.bytes != nil) { A.deallocate[u8](p.s.backing, config.bytes, config.len::usize); }
    }
    val prepared: err[fail.Fail] = cache.prepare(p, config.bytes, config.len::usize, readout.CACHE);
    readout.span_end(p.progress, readout.CACHE, readout.RESOLVE, t_cache);
    readout.phase_end(p.progress, readout.CACHE, p.emit_len - cache.generated_count(p), "module", "modules");
    ret prepared;
}

pub fun module_in_current_project(p: *project.Project, fqn: intern.StrId) bool {
    val fqn_text:     str = intern.text(?p.s.interner, fqn);
    val proj_id_text: str = intern.text(?p.s.interner, p.config.id);

    val fqn_len:  usize = str_len(fqn_text);
    var head_end: usize = 0;
    for (head_end < fqn_len && fqn_text[head_end] != '.') { head_end = head_end + 1; }
    ret view_eq_str(view(fqn_text::*char, head_end), proj_id_text);
}

fun lower_output_equal(a: *u8, a_len: u32, b: *u8, b_len: u32) bool {
    val left:  *me_ir.Module = ir_handle_decode(query.QueryView{value: a, value_len: a_len});
    val right: *me_ir.Module = ir_handle_decode(query.QueryView{value: b, value_len: b_len});
    if (left == nil || right == nil) { ret false; }
    ret equal.content_equal(left, right);
}
