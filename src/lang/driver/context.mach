# the frozen build context: everything the computations of one build read of its cell, its
# request and its target, captured into the TARGET input so a product that reads it depends on
# it, and fingerprinted so a change after the freeze is refused rather than read
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use std.process.exec;
use std.runtime.native.view.Unit;

use mach.lang.driver.request;
use mach.lang.driver.toolchain;
use mach.lang.fail;
use lang_fingerprint: mach.lang.fingerprint;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.manifest.template;
use mach.lang.query;
use mach.lang.session;
use lang_target:        mach.lang.target;
use target_fingerprint: mach.lang.target.fingerprint;
use mach.lang.wire;

use mach.lang.driver.codec;
use driver_environment: mach.lang.driver.environment;
use mach.lang.driver.project;

# the build context of the last frozen build, keyed 0
pub val TARGET: query.Kind = query.Kind{name: "build context", role: query.INPUT, owner: query.KEY_UNOWNED};

pub fun capture_build_config(p: *project.Project, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    val written: err[fail.Fail] = write_build_config(?fb, p, alloc);
    if (sel written.err) { ret res[query.QueryOutput, fail.Fail].err{written.err}; }
    ret codec.output(?fb);
}

# the configuration without the planner environment: what a persistent product
# may key on. steps that ran are keyed by their own fingerprint chain, and the
# inherited environment reaches an object only through them.
#[testing]
fun capture_build_identity(p: *project.Project, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    val written: err[fail.Fail] = write_build_identity(?fb, p, alloc);
    if (sel written.err) { ret res[query.QueryOutput, fail.Fail].err{written.err}; }
    ret codec.output(?fb);
}

# the build identity without the request: the persistent key hashes the request
# itself, with the project root in canonical form, so the spelled root stays out
pub fun capture_configuration_identity(p: *project.Project, alloc: *A.Allocator) res[query.QueryOutput, fail.Fail] {
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    write_configuration_identity(?fb, p);
    ret codec.output(?fb);
}

# freeze the build context: what every computation reads of the cell, the request and the
# target is captured once, set as the TARGET input every product that reads it depends on, and
# fingerprinted from the same bytes, so a later change to it is refused rather than read
pub fun freeze(p: *project.Project) err[fail.Fail] {
    val captured: res[query.QueryOutput, fail.Fail] = capture_build_config(p, p.s.alloc);
    if (sel captured.err) { ret err[fail.Fail].err{captured.err}; }
    val bytes: query.QueryOutput = captured.ok;
    fin {
        if (bytes.bytes != nil) { A.deallocate[u8](p.s.alloc, bytes.bytes, bytes.len::usize); }
    }
    val set: err[fail.Fail] = query.set_input(?p.s.queries, ?TARGET, 0, bytes.bytes, bytes.len);
    if (sel set.err) { ret set; }
    digest_of(bytes, ?p.context_digest);
    p.context_frozen = true;
    ret err[fail.Fail].ok{};
}

# refused when the context a frozen build reads no longer captures to the bytes it was frozen at
pub fun unchanged(p: *project.Project) err[fail.Fail] {
    if (!p.context_frozen) { ret err[fail.Fail].ok{}; }
    val captured: res[query.QueryOutput, fail.Fail] = capture_build_config(p, p.s.alloc);
    if (sel captured.err) { ret err[fail.Fail].err{captured.err}; }
    val bytes: query.QueryOutput = captured.ok;
    fin {
        if (bytes.bytes != nil) { A.deallocate[u8](p.s.alloc, bytes.bytes, bytes.len::usize); }
    }
    var digest: [32]u8;
    digest_of(bytes, ?digest);
    var i: usize = 0;
    for (i < 32) {
        if (digest[i] != p.context_digest[i]) { ret err[fail.Fail].err{fail.message("the build context changed after it was frozen")}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun digest_of(bytes: query.QueryOutput, out: *[32]u8) {
    var fb: wire.Sink = wire.digest();
    if (bytes.len != 0) { wire.put_bytes(?fb, bytes.bytes, bytes.len::usize); }
    wire.digest_final(?fb, out);
}

fun write_build_config(fb: *wire.Sink, p: *project.Project, a: *A.Allocator) err[fail.Fail] {
    val identity: err[fail.Fail] = write_build_identity(fb, p, a);
    if (sel identity.err) { ret identity; }
    ret write_step_environment(fb, p, a);
}

fun write_build_identity(fb: *wire.Sink, p: *project.Project, a: *A.Allocator) err[fail.Fail] {
    var digest: [32]u8;
    val hr:     err[fail.Fail] = request.semantic_hash(a, ?p.req, ?digest[0]);
    if (sel hr.err) { ret err[fail.Fail].err{hr.err}; }
    wire.put_bytes(fb, ?digest[0], request.HASH_SIZE);
    write_configuration_identity(fb, p);
    ret err[fail.Fail].ok{};
}

fun write_configuration_identity(fb: *wire.Sink, p: *project.Project) {
    write_target_fingerprint(fb, p);
    lang_fingerprint.put_name(fb, ?p.s.interner, p.target_entry.os_name);
    lang_fingerprint.put_name(fb, ?p.s.interner, p.target_entry.isa_name);
    lang_fingerprint.put_name(fb, ?p.s.interner, p.target_entry.abi_name);
    lang_fingerprint.put_name(fb, ?p.s.interner, p.target_entry.platform_name);
    lang_fingerprint.put_name(fb, ?p.s.interner, p.config.id);
    lang_fingerprint.put_name(fb, ?p.s.interner, p.config.version);
    lang_fingerprint.put_name(fb, ?p.s.interner, p.config.bin_name);
    write_dependency_identities(fb, p);
    # the root set decides which entries load and how gates are walked
    wire.put_u8(fb, p.roots::u8);
    write_requirement_scopes(fb, p);
    write_step_declarations(fb, p);
}

# the identity each dependency's modules read as `$mach.project.*`
fun write_dependency_identities(fb: *wire.Sink, p: *project.Project) {
    wire.put_u32(fb, p.config.dep_count);
    var i: u32 = 0;
    for (i < p.config.dep_count) {
        lang_fingerprint.put_name(fb, ?p.s.interner, p.config.deps[i].project_id);
        lang_fingerprint.put_name(fb, ?p.s.interner, p.config.deps[i].manifest.version);
        i = i + 1;
    }
}

# the `{artifact.<id>.out}` vocabulary each project's modules resolve an embed
# in: sema reads it, so a cell that resolves other requirements is another
# configuration and a module's products are not reused across the two
fun write_requirement_scopes(fb: *wire.Sink, p: *project.Project) {
    wire.put_u32(fb, p.config.req_scope_count);
    var si: u32 = 0;
    for (si < p.config.req_scope_count) {
        val sc: *template.Requirements = ?p.config.req_scopes[si];
        lang_fingerprint.put_name(fb, ?p.s.interner, sc.owner);
        var dependency: u8 = 0;
        if (sc.dependency) { dependency = 1; }
        wire.put_u8(fb, dependency);
        wire.put_u32(fb, sc.req_count);
        var ri: u32 = 0;
        for (ri < sc.req_count) {
            lang_fingerprint.put_text(fb, sc.reqs[ri].name);
            lang_fingerprint.put_text(fb, sc.reqs[ri].out);
            ri = ri + 1;
        }
        si = si + 1;
    }
}

# the target's fingerprint behind its u32 length, measured first
fun write_target_fingerprint(fb: *wire.Sink, p: *project.Project) {
    var measured: wire.Sink = wire.measure();
    target_fingerprint.put(?p.target, ?measured);
    val failed: opt[fail.Fail] = wire.failure(?measured);
    if (sel failed.some) {
        wire.refuse(fb, failed.some);
        ret;
    }
    if (measured.len > 0xFFFFFFFF::usize) {
        wire.refuse(fb, fail.message("target fingerprint exceeds 32-bit length"));
        ret;
    }
    wire.put_u32(fb, measured.len::u32);
    target_fingerprint.put(?p.target, fb);
}

fun write_step_declarations(fb: *wire.Sink, p: *project.Project) {
    wire.put_u32(fb, p.config.step_count);
    var si: u32 = 0;
    for (si < p.config.step_count) {
        val st: *manifest.StepDef = ?p.config.steps[si];
        lang_fingerprint.put_name(fb, ?p.s.interner, st.name);
        wire.put_u32(fb, st.env_count);
        var ei: u32 = 0;
        for (ei < st.env_count) {
            lang_fingerprint.put_name(fb, ?p.s.interner, st.env_keys[ei]);
            lang_fingerprint.put_name(fb, ?p.s.interner, st.env_values[ei]);
            ei = ei + 1;
        }
        si = si + 1;
    }
}

fun write_step_environment(fb: *wire.Sink, p: *project.Project, a: *A.Allocator) err[fail.Fail] {
    if (p.config.step_count == 0 && p.config.dep_count == 0) {
        wire.put_u32(fb, 0);
        ret err[fail.Fail].ok{};
    }
    val captured: res[driver_environment.Environment, fail.Fail] = driver_environment.capture(a, exec.Environment.inherit{});
    if (sel captured.err) { ret err[fail.Fail].err{captured.err}; }
    var environment: driver_environment.Environment = captured.ok;
    fin { driver_environment.dnit(?environment); }
    ret write_planner_environment(fb, a, ?environment);
}

# planner inputs cover child inheritance and executable lookup for root and
# dependency steps. each entry is put by its native units, so a variable with
# no UTF-8 spelling keys the plan too
fun write_planner_environment(fb: *wire.Sink, a: *A.Allocator, environment: *driver_environment.Environment) err[fail.Fail] {
    val exported: res[driver_environment.Strings, fail.Fail] = driver_environment.to_strings(environment);
    if (sel exported.err) { ret err[fail.Fail].err{exported.err}; }
    var strings: driver_environment.Strings = exported.ok;
    fin { driver_environment.strings_free(a, ?strings); }
    wire.put_u32(fb, strings.count);
    var i: u32 = 0;
    for (i < strings.count) {
        val units: usize = driver_environment.units_length(strings.items[i]);
        wire.put_sized(fb, strings.items[i]::*u8, units * $size_of(Unit));
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_build_config_digest(alloc: *A.Allocator, p: *project.Project, out: *u8) bool {
    var fb:      wire.Sink      = wire.digest();
    val written: err[fail.Fail] = write_build_config(?fb, p, alloc);
    if (sel written.err || fb.failed) { ret false; }
    wire.digest_final(?fb, out::*[32]u8);
    ret true;
}

#[testing]
fun ut_digest_differs(a: *u8, b: *u8) bool {
    var i: usize = 0;
    for (i < 32) {
        if (a[i] != b[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun t_capture_bytes(p: *project.Project, a: *A.Allocator, identity: bool) res[query.QueryOutput, fail.Fail] {
    if (identity) { ret capture_build_identity(p, a); }
    ret capture_build_config(p, a);
}

#[testing]
fun t_capture_equal(a: *A.Allocator, left: *project.Project, right: *project.Project, identity: bool) i32 {
    val l: res[query.QueryOutput, fail.Fail] = t_capture_bytes(left, a, identity);
    val r: res[query.QueryOutput, fail.Fail] = t_capture_bytes(right, a, identity);
    if (sel l.err) { ret -1; }
    if (sel r.err) { ret -1; }
    val lb: query.QueryOutput = l.ok;
    val rb: query.QueryOutput = r.ok;
    fin {
        if (lb.bytes != nil) { A.deallocate[u8](a, lb.bytes, lb.len::usize); }
        if (rb.bytes != nil) { A.deallocate[u8](a, rb.bytes, rb.len::usize); }
    }
    if (lb.len != rb.len) { ret 0; }
    var i: u32 = 0;
    for (i < lb.len) {
        if (lb.bytes[i] != rb.bytes[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

# 1 when the configuration is the identity followed by more: what it samples beyond it
#[testing]
fun t_config_extends_identity(a: *A.Allocator, p: *project.Project) i32 {
    val c: res[query.QueryOutput, fail.Fail] = t_capture_bytes(p, a, false);
    val d: res[query.QueryOutput, fail.Fail] = t_capture_bytes(p, a, true);
    if (sel c.err) { ret -1; }
    if (sel d.err) { ret -1; }
    val cb: query.QueryOutput = c.ok;
    val db: query.QueryOutput = d.ok;
    fin {
        if (cb.bytes != nil) { A.deallocate[u8](a, cb.bytes, cb.len::usize); }
        if (db.bytes != nil) { A.deallocate[u8](a, db.bytes, db.len::usize); }
    }
    if (cb.len <= db.len) { ret 0; }
    var i: u32 = 0;
    for (i < db.len) {
        if (cb.bytes[i] != db.bytes[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

#[testing]
fun t_planner_environment_digest(a: *A.Allocator, inherited: **u8, native: *Unit, digest: *u8) bool {
    val captured: res[driver_environment.Environment, fail.Fail] = driver_environment.capture(a, exec.Environment.given{inherited});
    if (sel captured.err) { ret false; }
    var environment: driver_environment.Environment = captured.ok;
    fin { driver_environment.dnit(?environment); }
    if (native != nil) {
        val entry: res[driver_environment.Entry, fail.Fail] = driver_environment.entry_native(a, native);
        if (sel entry.err) { ret false; }
        val added: err[fail.Fail] = driver_environment.put_owned(?environment, entry.ok, true);
        if (sel added.err) { ret false; }
    }
    var fb:      wire.Sink      = wire.digest();
    val written: err[fail.Fail] = write_planner_environment(?fb, a, ?environment);
    if (sel written.err || fb.failed) { ret false; }
    wire.digest_final(?fb, digest::*[32]u8);
    ret true;
}

test write_build_config__distinguishes_target_identity {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tx: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    val ta: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "linux", "aapcs64");
    if (sel tx.err) { ret 1; }
    if (sel ta.err) { ret 1; }

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;

    var px: project.Project;
    px.s            = ?s;
    px.req          = request.defaults();
    px.target       = tx.ok;
    px.target_entry = ?te;
    px.config       = cfg;

    var pa: project.Project;
    pa.s            = ?s;
    pa.req          = request.defaults();
    pa.target       = ta.ok;
    pa.target_entry = ?te;
    pa.config       = cfg;

    var dx: [32]u8;
    var da: [32]u8;
    if (!t_build_config_digest(?alloc, ?px, ?dx[0])) { ret 1; }
    if (!t_build_config_digest(?alloc, ?pa, ?da[0])) { ret 1; }
    if (!ut_digest_differs(?dx[0], ?da[0]))          { ret 1; }
    ret 0;
}

# the root set and the requirement scopes are configuration: a union cell and an
# artifact cell of one target are different builds, as are two cells whose modules
# resolve `{artifact.<id>.out}` over different requirements
test write_build_config__root_set_and_requirement_scopes_move_the_fingerprint {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tx: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel tx.err) { ret 1; }

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;

    var base: project.Project;
    base.s            = ?s;
    base.req          = request.defaults();
    base.target       = tx.ok;
    base.target_entry = ?te;
    base.config       = cfg;
    base.roots        = project.ROOT_ARTIFACT;
    var d_base: [32]u8;
    if (!t_build_config_digest(?alloc, ?base, ?d_base[0])) { ret 1; }

    var union_cell: project.Project = base;
    union_cell.roots = project.ROOT_UNION;
    var d_union: [32]u8;
    if (!t_build_config_digest(?alloc, ?union_cell, ?d_union[0])) { ret 1; }
    if (!ut_digest_differs(?d_base[0], ?d_union[0]))              { ret 2; }

    var req:   template.Requirement  = template.Requirement{name: "shader-vert", out: "out/spv/vert.spv"};
    var scope: template.Requirements = template.Requirements{owner: intern.STR_NIL, dependency: false,
        reqs: ?req, req_count: 1};
    var scoped: project.Project = base;
    scoped.config.req_scopes      = ?scope;
    scoped.config.req_scope_count = 1;
    var d_scoped: [32]u8;
    if (!t_build_config_digest(?alloc, ?scoped, ?d_scoped[0])) { ret 1; }
    if (!ut_digest_differs(?d_base[0], ?d_scoped[0]))          { ret 3; }

    # the same requirement resolving to another output is another scope
    req.out = "out/spv/vert.bin";
    var d_moved: [32]u8;
    if (!t_build_config_digest(?alloc, ?scoped, ?d_moved[0])) { ret 1; }
    if (!ut_digest_differs(?d_scoped[0], ?d_moved[0]))        { ret 4; }
    ret 0;
}

test write_build_config__every_tuple_field_moves_the_fingerprint {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tx_r: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    val ta_r: res[lang_target.Binding, fail.Fail] = lang_target.t_select("aarch64", "linux", "aapcs64");
    val tw_r: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "windows", "win64");
    if (sel tx_r.err) { ret 1; }
    if (sel ta_r.err) { ret 1; }
    if (sel tw_r.err) { ret 1; }
    val tx: lang_target.Binding = tx_r.ok;
    val ta: lang_target.Binding = ta_r.ok;
    val tw: lang_target.Binding = tw_r.ok;

    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;

    var base: project.Project;
    base.s            = ?s;
    base.req          = request.defaults();
    base.req.profile  = "debug";
    base.target       = tx;
    base.target_entry = ?te;
    base.config       = cfg;

    val N:       usize = 10;
    var digests: [10][32]u8;
    if (!t_build_config_digest(?alloc, ?base, ?digests[0][0])) { ret 1; }

    var v: project.Project = base;
    v.target.target.arch_id = ta.target.arch_id;
    if (!t_build_config_digest(?alloc, ?v, ?digests[1][0])) { ret 1; }

    v                      = base;
    v.target.target.abi_id = ta.target.abi_id;
    if (!t_build_config_digest(?alloc, ?v, ?digests[2][0])) { ret 1; }

    v                     = base;
    v.target.target.os_id = tw.target.os_id;
    if (!t_build_config_digest(?alloc, ?v, ?digests[3][0])) { ret 1; }

    v           = base;
    v.target.of = tw.of;
    if (!t_build_config_digest(?alloc, ?v, ?digests[4][0])) { ret 1; }

    v                        = base;
    v.target.target.debug_id = base.target.target.debug_id + 1;
    if (!t_build_config_digest(?alloc, ?v, ?digests[5][0])) { ret 1; }

    v                             = base;
    v.target.target.stack_reserve = base.target.target.stack_reserve + 0x1000;
    if (!t_build_config_digest(?alloc, ?v, ?digests[6][0])) { ret 1; }

    v                            = base;
    v.target.target.stack_commit = base.target.target.stack_commit + 0x1000;
    if (!t_build_config_digest(?alloc, ?v, ?digests[7][0])) { ret 1; }

    v             = base;
    v.req.profile = "release";
    if (!t_build_config_digest(?alloc, ?v, ?digests[8][0])) { ret 1; }

    var env_keys:   [1]intern.StrId;
    var env_values: [1]intern.StrId;
    val intern_r2:  res[intern.StrId, A.Error] = intern.add(?s.interner, "MODE");
    if (sel intern_r2.err) { ret 99; }
    env_keys[0] = intern_r2.ok;
    val intern_r3: res[intern.StrId, A.Error] = intern.add(?s.interner, "audit");
    if (sel intern_r3.err) { ret 99; }
    env_values[0] = intern_r3.ok;
    var steps:     [1]manifest.StepDef;
    val intern_r4: res[intern.StrId, A.Error] = intern.add(?s.interner, "generate");
    if (sel intern_r4.err) { ret 99; }
    steps[0].name       = intern_r4.ok;
    steps[0].env_keys   = ?env_keys[0];
    steps[0].env_values = ?env_values[0];
    steps[0].env_count  = 1;
    v                   = base;
    v.config.steps      = ?steps[0];
    v.config.step_count = 1;
    if (!t_build_config_digest(?alloc, ?v, ?digests[9][0])) { ret 1; }

    var i: usize = 0;
    for (i < N) {
        var j: usize = i + 1;
        for (j < N) {
            if (!ut_digest_differs(?digests[i][0], ?digests[j][0])) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

test capture_build_identity__excludes_the_planner_environment {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val tx: res[lang_target.Binding, fail.Fail] = lang_target.t_select("x86_64", "linux", "sysv64");
    if (sel tx.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var te: project.TargetEntry;
    te.os_name       = intern.STR_NIL;
    te.isa_name      = intern.STR_NIL;
    te.abi_name      = intern.STR_NIL;
    te.platform_name = intern.STR_NIL;
    var cfg: project.ProjectConfig;
    cfg.id       = intern.STR_NIL;
    cfg.version  = intern.STR_NIL;
    cfg.bin_name = intern.STR_NIL;
    var alone: project.Project;
    alone.s            = ?s;
    alone.req          = request.defaults();
    alone.target       = tx.ok;
    alone.target_entry = ?te;
    alone.config       = cfg;
    var dep: project.DepEntry;
    dep.project_id       = intern.STR_NIL;
    dep.manifest.version = intern.STR_NIL;
    var hosted: project.Project = alone;
    hosted.config.dep_count = 1;
    hosted.config.deps      = ?dep;
    # a dependency makes the configuration sample the inherited environment; the identity never does
    if (t_capture_equal(?alloc, ?alone, ?hosted, false) != 0) { ret 2; }
    if (t_config_extends_identity(?alloc, ?hosted) != 1)      { ret 3; }
    var released: project.Project = hosted;
    released.req.profile = "release";
    if (t_capture_equal(?alloc, ?hosted, ?released, true) != 0) { ret 4; }
    ret 0;
}

test planner_environment__cache_input_tracks_values_and_ignores_entry_order {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var entries: [4]*u8 = [4]*u8{"MACH_3146_B=two", "MACH_3146_A=one", "MACH_3146_A=ignored duplicate", nil};
    var initial: [32]u8;
    if (!t_planner_environment_digest(?a, ?entries[0], nil, ?initial[0])) { ret 2; }
    entries[0] = "MACH_3146_A=one";
    entries[1] = "MACH_3146_B=two";
    entries[2] = nil;
    var reordered: [32]u8;
    if (!t_planner_environment_digest(?a, ?entries[0], nil, ?reordered[0])) { ret 3; }
    if (ut_digest_differs(?initial[0], ?reordered[0]))                      { ret 4; }
    entries[1] = "MACH_3146_B=changed inherited value";
    var changed: [32]u8;
    if (!t_planner_environment_digest(?a, ?entries[0], nil, ?changed[0])) { ret 5; }
    if (!ut_digest_differs(?initial[0], ?changed[0]))                     { ret 6; }

    # a value with no UTF-8 spelling keys the plan by its units
    var odd: [6]Unit = [6]Unit{'M'::Unit, '='::Unit, 'a'::Unit, 0, 'b'::Unit, 0};
    $if ($mach.build.os == $mach.os.windows) { odd[3] = 0xd800; }
    $or                                      { odd[3] = 0xff; }
    var unspellable: [32]u8;
    if (!t_planner_environment_digest(?a, ?entries[0], ?odd[0], ?unspellable[0])) { ret 7; }
    odd[4] = 'c'::Unit;
    var edited: [32]u8;
    if (!t_planner_environment_digest(?a, ?entries[0], ?odd[0], ?edited[0])) { ret 8; }
    if (!ut_digest_differs(?unspellable[0], ?edited[0]))                     { ret 9; }
    ret 0;
}
