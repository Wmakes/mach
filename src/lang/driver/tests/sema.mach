# a grouped literal and a grouped assignment target keep their values in a built program
test grouped_expr__values_survive_to_run_time {
    # the values a grouped literal and a grouped assignment target carry at run time
    $if ($mach.build.os != $mach.os.linux || $mach.build.arch != $mach.arch.x86_64) { ret 0; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 4; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 4; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = ut_cc3(?alloc,
        "val N: i32 = (4);\n",
        "test grouped {\n    var x: i32 = (N);\n    (x) = ('a')::i32 + (1);\n    val s: *u8 = (\"hi\");\n    val p: *u8 = (nil);\n    val f: f64 = (2.5);\n    if (p != nil) { ret 11; }\n    if (f != 2.5) { ret 12; }\n    if (s[0] != 104 || s[1] != 105 || s[2] != 0) { ret 13; }\n    ret (x) - 98;\n}\n",
        ut_dispatcher_start_stub());
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 4; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }

    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 4; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.goal         = request.GOAL_TESTS;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(?alloc, ?s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) { ret 4; }
    var bp:        build_plan.BuildPlan     = pr.ok;
    var published: publication.Publications = publication.init(?alloc);
    fin { publication.dnit(?published); }
    val r: res[outcome.BuildOutcome, fail.Fail] = engine.execute_warm(?bp, 0, ?s, ?published, ?alloc, nil);
    if (sel r.err) {
        print.eprintln(fail.describe(r.err));
        ret 4;
    }
    var bo: outcome.BuildOutcome = r.ok;
    if (bo.severity != outcome.BUILD_OK) { ret 5; }
    if (bo.tests.len != 1)               { ret 6; }
    val art: *outcome.TestArtifact = ?bo.tests.data[0];
    val got: i32                   = ut_dispatch_status(art.exe::str, art.idx);
    if (got != 0) {
        print.eprintlnf("grouped: exit {}", got::i64);
        ret 7;
    }
    ret 0;
}

# 0 when a project whose mid module forwards leaf.original_name under two names links
#[testing]
fun ut_fwd_renamed_links(main_text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [3]str              = [3]str{"main.mach", "mid.mach", "leaf.mach"};
    var texts:  [3]str              = [3]str{main_text, "fwd renamed_alias: uniontest.leaf.original_name;\nfwd uniontest.leaf.original_name;\n", "pub fun original_name() i32 { ret 42; }\n"};
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val pr: res[project.Project, fail.Fail] = ut_back_half(?s, root);
    if (sel pr.err) { ret 1; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val set_link_config_input_r: err[fail.Fail] = engine.set_link_config_input(?p, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r.err) { ret 1; }
    val rl: res[bool, fail.Fail] = driver.run_link_pass(?p);
    if (sel rl.err) { ret 2; }
    ret 0;
}

# a renamed re-export links across the module boundary whichever order its names are imported in
test fwd__renamed_reexport_links {
    val qualified: i32 = ut_fwd_renamed_links("use uniontest.mid;\nfun main() i32 { ret mid.renamed_alias() - mid.original_name(); }\n");
    if (qualified != 0) { ret 10 + qualified; }
    val leaves: i32 = ut_fwd_renamed_links("use uniontest.mid.renamed_alias;\nuse uniontest.mid.original_name;\nfun main() i32 { ret renamed_alias() - original_name(); }\n");
    if (leaves != 0) { ret 20 + leaves; }
    ret 0;
}

test linkage_name__test_declaration {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun probe() i32 { ret 0; }\ntest probe { ret probe(); }\nfun main() i32 { ret probe(); }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                             = 0;
    val pr:  res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    if (sel pr.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    var p:   project.Project      = pr.ok;
    var req: request.BuildRequest = p.req;
    req.goal = request.GOAL_TESTS;
    val reconfigured:       err[fail.Fail] = driver.reconfigure(?p, req);
    val run_sema_pass_r:    err[fail.Fail] = driver.run_sema_pass(?p);
    val run_lower_pass_r:   err[fail.Fail] = driver.run_lower_pass(?p);
    val run_codegen_pass_r: err[fail.Fail] = driver.run_codegen_pass(?p);
    val run_test_pass_r:    err[fail.Fail] = driver.run_test_pass(?p);
    if (sel reconfigured.err)       { bad = 1; }
    or (sel run_sema_pass_r.err)    { bad = 1; }
    or (sel run_lower_pass_r.err)   { bad = 2; }
    or (sel run_codegen_pass_r.err) { bad = 3; }
    or (sel run_test_pass_r.err)    { bad = 4; }
    or {
        # the test is its qualified name in the test object; the function of the same
        # name is the normal object's
        val m:      *me_ir.Module    = ut_ir_of(?p, ?s, "uniontest.main");
        val mid:    session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        val tested: *me_ir.Module    = project.module_at(?p, mid::u32).test.ir_module;
        if (tested == nil)                                                { bad = 5; }
        or (ut_defined_fn_exact(?s, tested, "uniontest.main#probe") != 1) { bad = 6; }
        or (ut_defined_fn_exact(?s, tested, "uniontest.main.probe") != 0) { bad = 7; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main.probe") != 1)      { bad = 8; }
        if (ut_defined_fn_exact(?s, m, "uniontest.main#probe") != 0)      { bad = 9; }
    }

    project.dnit_project(?p);
    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}
