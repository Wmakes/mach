use mach.lang.fail;
use std.allocator.page;
use fs: std.filesystem;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.driver.request;
use mach.lang.manifest;
use mach.lang.me.pipeline;
use mach.lang.session;

use mach.lang.driver;
use mach.lang.driver.project;

use mach.lang.driver.tests.testing.ut_cc3;
use mach.lang.driver.tests.testing.ut_count_errors;
use mach.lang.driver.tests.testing.ut_git_repo;
use mach.lang.driver.tests.testing.ut_scaffold_m;
use mach.lang.driver.tests.testing.ut_sema_clean;
use mach.lang.driver.tests.testing.ut_sema_rejects_with;
use mach.lang.driver.tests.testing.ut_str_contains;
use mach.lang.driver.tests.testing.ut_target_sel;
use mach.lang.driver.tests.testing.ut_write_gitmodules;
use mach.lang.driver.tests.testing.ut_write_node;
use mach.lang.driver.toolchain;
use mach.lang.manifest.target.on_host;
use lang_target: mach.lang.target;

# a manifest is refused for an unknown key, for the root and for a dependency
# alike, each diagnostic naming the key and the table, and a dependency missing a
# required key is refused under its name
test manifest__the_root_and_each_dependency_are_held_to_one_rule_per_key {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val origin: str = "https://example.invalid/old.git";
    var names:  [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun main() i32 { ret 0; }\n";
    val clean_head:    str                 = on_host("[project]\nmach = \">=5\"\nid = \"app\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[profile.debug]\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n");
    val root_tail:     str                 = "\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[dep.old]\ngit = \"https://example.invalid/old.git\"\nref = \"branch/main\"\n";
    val root_manifest: str                 = ut_cc3(?alloc, clean_head, "emit_ir = true\n", root_tail);
    val root_r:        res[str, fail.Fail] = ut_scaffold_m(?alloc, root_manifest, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root:            str            = root_r.ok;
    val dep_root:        str            = ut_cc3(?alloc, root, "/", "dep/old");
    val dep_manifest:    str            = "[project]\nmach = \">=5\"\nid = \"old\"\ndescription = \"an old library\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"{project.work}/lib/l\"\ntargets = [\"*\"]\nlink = []\nneed = []\ndefault = true\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
    val ut_write_node_r: err[fail.Fail] = ut_write_node(?alloc, dep_root, dep_manifest, "lib.mach", "pub fun v() i32 { ret 1; }\n");
    if (sel ut_write_node_r.err) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, dep_root, origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_write_gitmodules(?alloc, root, "old", origin)) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }
    if (!ut_git_repo(?alloc, root, "https://example.invalid/app.git")) {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
        ret 1;
    }

    var bad: i32                             = 0;
    val pr:  res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        bad = 2;
    }
    if (sel pr.err) {
        if (!ut_str_contains(fail.describe(pr.err), "mach.toml: unknown key 'emit_ir' in [profile.debug]")) { bad = 3; }
    }

    # with the root clean, the dependency's unknown key is refused under its name
    if (bad == 0) {
        val fixed: str             = ut_cc3(?alloc, clean_head, "", root_tail);
        val mpath: str             = ut_cc3(?alloc, root, "/", "mach.toml");
        val wr:    err[fs.FsError] = fs.write_bytes(mpath, fixed, str_len(fixed), 420);
        if (sel wr.err) { bad = 4; }
        or {
            val pr2: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
            if (sel pr2.ok) {
                var p2: project.Project = pr2.ok;
                project.dnit_project(?p2);
                bad = 5;
            }
            if (sel pr2.err) {
                if (!ut_str_contains(fail.describe(pr2.err), "dependency 'old': mach.toml: unknown key 'description' in [project]")) { bad = 6; }
            }
        }
    }

    # a dependency is held to the rules of the project being built: one missing a
    # required key fails the consumer's build under its name
    if (bad == 0) {
        val bare:  str             = "[project]\nmach = \">=5\"\nid = \"old\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[artifact.lib]\nkind = \"static\"\nentry = \"lib.mach\"\nout = \"{project.work}/lib/l\"\ntargets = [\"*\"]\ndefault = true\n";
        val dpath: str             = ut_cc3(?alloc, dep_root, "/", "mach.toml");
        val wr:    err[fs.FsError] = fs.write_bytes(dpath, bare, str_len(bare), 420);
        if (sel wr.err) { bad = 7; }
        or {
            val pr3: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
            if (sel pr3.ok) {
                var p3: project.Project = pr3.ok;
                project.dnit_project(?p3);
                bad = 8;
            }
            if (sel pr3.err) {
                if (!ut_str_contains(fail.describe(pr3.err), "dependency 'old': mach.toml: missing [profile] table")) { bad = 9; }
            }
        }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}
