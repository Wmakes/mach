use mach.lang.intern;
use lang_source: mach.lang.source;
use A:           std.allocator;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# paths are parser accepted identifier and dot sequences with original trivia intact
pub fun next(source: str, path: lang_source.Span, cursor: *usize) lang_source.Span {
    val end: usize = path.offset + path.len;
    var pos: usize = @cursor;
    for (pos < end) {
        val c: u8 = source[pos];
        if (c == '#') {
            for (pos < end && source[pos] != '\n' && source[pos] != '\r') { pos = pos + 1; }
        }
        or (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '.') { pos = pos + 1; }
        or                                                               { brk; }
    }
    val start: usize = pos;
    for (pos < end) {
        val c: u8 = source[pos];
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '.' || c == '#') { brk; }
        pos = pos + 1;
    }
    @cursor = pos;
    ret lang_source.Span{offset: start, len: pos - start};
}

pub fun leaf(source: str, path: lang_source.Span) lang_source.Span {
    var cursor: usize            = path.offset;
    var found:  lang_source.Span = lang_source.Span{offset: path.offset, len: 0};
    for (cursor < path.offset + path.len) {
        val segment: lang_source.Span = next(source, path, ?cursor);
        if (segment.len == 0) { brk; }
        found = segment;
    }
    ret found;
}

pub fun prefix(source: str, path: lang_source.Span) lang_source.Span {
    var cursor:   usize            = path.offset;
    var previous: lang_source.Span = lang_source.Span{offset: path.offset, len: 0};
    var found:    lang_source.Span = previous;
    for (cursor < path.offset + path.len) {
        val segment: lang_source.Span = next(source, path, ?cursor);
        if (segment.len == 0) { brk; }
        found.len = previous.offset + previous.len - path.offset;
        previous  = segment;
    }
    ret found;
}

pub fun intern_path(itn: *intern.Interner, source: str, path: lang_source.Span) res[intern.StrId, A.Error] {
    var cursor: usize = path.offset;
    var length: usize = 0;
    for (cursor < path.offset + path.len) {
        val segment: lang_source.Span = next(source, path, ?cursor);
        if (segment.len == 0) { brk; }
        if (length != 0)      { length = length + 1; }
        length = length + segment.len;
    }
    if (length == 0 || length == path.len) { ret intern.range_add(itn, source, path.offset, path.len); }
    val allocated: res[*u8, A.Error] = A.allocate[u8](itn.a, length);
    if (sel allocated.err) { ret res[intern.StrId, A.Error].err{allocated.err}; }
    val bytes: *u8 = allocated.ok;
    fin { A.deallocate[u8](itn.a, bytes, length); }
    cursor = path.offset;
    var written: usize = 0;
    for (cursor < path.offset + path.len) {
        val segment: lang_source.Span = next(source, path, ?cursor);
        if (segment.len == 0) { brk; }
        if (written != 0) {
            bytes[written] = '.';
            written        = written + 1;
        }
        var b: usize = 0;
        for (b < segment.len) {
            bytes[written] = source[segment.offset + b];
            written        = written + 1;
            b              = b + 1;
        }
    }
    ret intern.bytes_add(itn, bytes, length);
}
