use mach.lang.fail;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mach.lang.fe.ast;
use ast_expr:    mach.lang.fe.ast.expr;
use ast_id:      mach.lang.fe.ast.id;
use ast_type:    mach.lang.fe.ast.type;
use fe_path:     mach.lang.fe.path;
use lang_source: mach.lang.source;

pub def Choice: u8;
pub val PARSED:      Choice = 0;
pub val GENERIC:     Choice = 1;
pub val INDEX_CALL:  Choice = 2;
pub val INDEX_VALUE: Choice = 3;
pub val REJECTED:    Choice = 4;
# a positional literal whose head names a tag case: a case construction carrying its elements
# as the payload, not a vector's lanes
pub val CASE_LITERAL: Choice = 5;

# how name resolution read a literal head's path: as written, or as a type and the tag case its
# last segment selects
pub def Head: u8;
pub val HEAD_PARSED: Head = 0;
pub val HEAD_CASE:   Head = 1;

pub fun get(a: *ast.Ast, choices: *Choice, count: usize, eid: ast_id.ExprId) res[ast_expr.Expr, fail.Fail] {
    if (a == nil || count != a.exprs.len || (choices == nil && count != 0)) {
        ret res[ast_expr.Expr, fail.Fail].err{fail.message("resolved expression view does not match its parsed owner")};
    }
    val found: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (!sel found.some) { ret res[ast_expr.Expr, fail.Fail].err{fail.message("resolved expression identity is out of range")}; }
    var node:   ast_expr.Expr = @found.some;
    val choice: Choice        = choices[ast_id.expr_index(eid)];
    if (choice == PARSED) { ret res[ast_expr.Expr, fail.Fail].ok{node}; }
    if (choice == CASE_LITERAL) {
        if (node.kind != ast_expr.EXPR_KIND_VECTOR_LIT) {
            ret res[ast_expr.Expr, fail.Fail].err{fail.message("case literal interpretation does not belong to a positional literal")};
        }
        val vl: ast_expr.ExprVectorLit = node.data.vector_lit;
        node.kind            = ast_expr.EXPR_KIND_STRUCT_LIT;
        node.data.struct_lit = ast_expr.ExprStructLit{elems_start: vl.elems_start, elems_len: vl.elems_len, ty: vl.ty, fields_start: 0, fields_len: 0};
        ret res[ast_expr.Expr, fail.Fail].ok{node};
    }
    if (node.kind != ast_expr.EXPR_KIND_CALL && node.kind != ast_expr.EXPR_KIND_GENERIC_INSTANCE) {
        ret res[ast_expr.Expr, fail.Fail].err{fail.message("bracket interpretation does not belong to a bracket expression")};
    }
    if (choice == GENERIC) {
        node.data.call.index_callee = ast_id.EXPR_NIL;
        ret res[ast_expr.Expr, fail.Fail].ok{node};
    }
    if (choice == REJECTED) {
        node.kind = ast_expr.EXPR_KIND_ERROR;
        ret res[ast_expr.Expr, fail.Fail].ok{node};
    }
    val indexed: opt[*ast_expr.Expr] = ast.get_expr(a, node.data.call.index_callee);
    if (!sel indexed.some) {
        ret res[ast_expr.Expr, fail.Fail].err{fail.message("bracket interpretation has no parsed index alternative")};
    }
    if (indexed.some.kind != ast_expr.EXPR_KIND_INDEX) {
        ret res[ast_expr.Expr, fail.Fail].err{fail.message("bracket interpretation has no parsed index alternative")};
    }
    if (choice == INDEX_CALL && node.kind == ast_expr.EXPR_KIND_CALL) {
        node.data.call.callee          = node.data.call.index_callee;
        node.data.call.index_callee    = ast_id.EXPR_NIL;
        node.data.call.type_args_start = 0;
        node.data.call.type_args_len   = 0;
        ret res[ast_expr.Expr, fail.Fail].ok{node};
    }
    if (choice == INDEX_VALUE && node.kind == ast_expr.EXPR_KIND_GENERIC_INSTANCE) {
        node.kind       = ast_expr.EXPR_KIND_INDEX;
        node.data.index = indexed.some.data.index;
        ret res[ast_expr.Expr, fail.Fail].ok{node};
    }
    ret res[ast_expr.Expr, fail.Fail].err{fail.message("invalid bracket interpretation choice")};
}

# the type node `tid` as name resolution read it: a split head names the type by its path's
# prefix and the case by its last segment
pub fun type_node(a: *ast.Ast, source: str, heads: *Head, count: usize, tid: ast_id.TypeId) res[ast_type.Type, fail.Fail] {
    if (a == nil || count != a.types.len || (heads == nil && count != 0)) {
        ret res[ast_type.Type, fail.Fail].err{fail.message("resolved type view does not match its parsed owner")};
    }
    val found: opt[*ast_type.Type] = ast.get_type(a, tid);
    if (!sel found.some) { ret res[ast_type.Type, fail.Fail].err{fail.message("resolved type identity is out of range")}; }
    var node: ast_type.Type = @found.some;
    val head: Head          = heads[ast_id.type_index(tid)];
    if (head == HEAD_PARSED) { ret res[ast_type.Type, fail.Fail].ok{node}; }
    if (head != HEAD_CASE)   { ret res[ast_type.Type, fail.Fail].err{fail.message("invalid literal head interpretation")}; }
    ret split(node, source);
}

# a named head read as type and case: the path's prefix names the type, its last segment the case
pub fun split(node: ast_type.Type, source: str) res[ast_type.Type, fail.Fail] {
    var out: ast_type.Type = node;
    if (out.kind != ast_type.TYPE_KIND_NAMED || out.data.named.case_name.len != 0 || !ast_id.expr_is_nil(out.data.named.case_desc)) {
        ret res[ast_type.Type, fail.Fail].err{fail.message("head interpretation does not belong to a bare named head")};
    }
    val path: lang_source.Span = out.data.named.name;
    val pre:  lang_source.Span = fe_path.prefix(source, path);
    val leaf: lang_source.Span = fe_path.leaf(source, path);
    if (pre.len == 0 || pre.len >= path.len || leaf.len == 0) {
        ret res[ast_type.Type, fail.Fail].err{fail.message("head interpretation names a path with no case segment")};
    }
    out.data.named.name      = pre;
    out.data.named.case_name = leaf;
    ret res[ast_type.Type, fail.Fail].ok{out};
}
