# sema: types a module, and what it publishes for the phases after it
use sema_context: mach.lang.fe.sema.context;
use sema_module:  mach.lang.fe.sema.module;
use sema_product: mach.lang.fe.sema.product;
#[testing]
use mach.lang.type;
#[testing]
use A: std.allocator;
#[testing]
use T: std.allocator.testing;
#[testing]
use std.types.bool.bool;
#[testing]
use std.types.bool.false;
#[testing]
use std.types.bool.true;
#[testing]
use std.types.size.usize;
#[testing]
use std.types.string.str;
#[testing]
use std.types.string.str_len;

fwd sema_module.sema;
fwd sema_product.SemaResult;
fwd sema_product.result_dnit;
fwd sema_product.TypeExport;
fwd sema_product.ModuleSema;
