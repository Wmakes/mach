# a tag fixture: its declarations, read beneath the std tag prelude, and the verdict it
# expects, accepted, rejected, or rejected with an error that says `needle` when there is one
#[testing]
pub rec TagFixture {
    text:   str;
    needle: str;
    accept: bool;
    code:   i32;
}

# the std failure tags exactly as std declares them: the compiler knows nothing about these
# names, so a fixture that uses them declares them beneath this prelude
#[testing]
pub val TAG_STD_PRELUDE: str = "tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\n";

# case recipes a tag declaration refuses
#[testing]
pub val TAG_CASE_RECIPES: [5]TagFixture = [5]TagFixture{
    TagFixture{text: "tag Reply: u8 {}", needle: "at least one case", accept: false, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; empty: u64; }", needle: "duplicate tag case", accept: false, code: 2},
    TagFixture{text: "tag Reply: u8 { value: Reply; }", needle: "recursive type", accept: false, code: 3},
    TagFixture{text: "tag Reply[T]: u8 { value: T; } var reply: Reply;", needle: "type argument", accept: false, code: 4},
    TagFixture{text: "tag Reply[T]: u8 { value: T; } var reply: Reply[u32, u64];", needle: "type argument", accept: false, code: 5}
};

# constructions that name the type and the case, and those that do not
#[testing]
pub val TAG_CONSTRUCTION_NAMES: [11]TagFixture = [11]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: u64; } val a: Reply = Reply.empty{}; val b: Reply = Reply.value{42u64};", needle: "", accept: true, code: 1},
    TagFixture{text: "tag Reply[T]: u8 { empty; value: T; } val a: Reply[u64] = Reply[u64].value{42u64};", needle: "", accept: true, code: 2},
    TagFixture{text: "tag Reply: u8 { empty; value: u64; } val v: u64 = 7u64; val b: Reply = Reply.value{v};", needle: "", accept: true, code: 3},
    TagFixture{text: "tag Reply: u8 { empty; value: u64; } fun f(r: Reply) Reply { ret Reply.value{1u64}; }", needle: "", accept: true, code: 4},
    TagFixture{text: "tag Reply: u8 { empty; } val a: Reply = Reply.empty{1u64};", needle: "takes no payload", accept: false, code: 5},
    TagFixture{text: "tag Reply: u8 { value: u64; } val a: Reply = Reply.value{};", needle: "requires a payload", accept: false, code: 6},
    TagFixture{text: "tag Reply: u8 { empty; } val a: Reply = Reply.other{};", needle: "unknown tag case", accept: false, code: 7},
    TagFixture{text: "tag Reply: u8 { value: u64; } val a: Reply = Reply.value{1u32};", needle: "type mismatch", accept: false, code: 8},
    TagFixture{text: "rec Reply { value: u64; } val a: Reply = Reply.value{};", needle: "is not a tag", accept: false, code: 9},
    TagFixture{text: "tag Reply: u8 { empty; value: u64; } val a: Reply = Reply.value{1u64, 2u64};", needle: "exactly one payload", accept: false, code: 10},
    TagFixture{text: "tag Reply: u8 { empty; value: u64; } val a: Reply = Reply.value{value: 1u64};", needle: "positional", accept: false, code: 11}
};

# the record literal form a tag refuses
#[testing]
pub val TAG_RECORD_LITERAL_FORMS: [6]TagFixture = [6]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: u64; } val a: Reply = Reply{value: 1u64};", needle: "constructed as `Type.case{payload}`", accept: false, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; value: u64; } val a: Reply = Reply{empty};", needle: "constructed as `Type.case{payload}`", accept: false, code: 2},
    TagFixture{text: "tag Reply: u8 { empty; } val a: Reply = Reply{};", needle: "constructed as `Type.case{payload}`", accept: false, code: 3},
    TagFixture{text: "tag Reply: u8 { empty; value: u64; } val a: Reply = Reply{empty, value: 1u64};", needle: "constructed as `Type.case{payload}`", accept: false, code: 4},
    TagFixture{text: "val a: opt[i64] = opt[i64]{some: 1};", needle: "constructed as `Type.case{payload}`", accept: false, code: 5},
    TagFixture{text: "tag Reply: u8 { empty; value: u64; } val a: Reply = Reply.value;", needle: "a case selector is not a value", accept: false, code: 6}
};

# casts that would forge a tag representation
#[testing]
pub val TAG_FORGED_CASTS: [7]TagFixture = [7]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; } fun f(x: u8) Reply { ret x::Reply; }", needle: "representation of a tag", accept: false, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; } fun f(x: Reply) u8 { ret x:~u8; }", needle: "representation of a tag", accept: false, code: 2},
    TagFixture{text: "tag Reply: u8 { empty; } rec Box { reply: Reply; } fun f(x: u8) Box { ret x::Box; }", needle: "representation of a tag", accept: false, code: 3},
    TagFixture{text: "tag Reply: u8 { empty; } fun f(x: [1]Reply) u8 { ret x:~u8; }", needle: "representation of a tag", accept: false, code: 4},
    TagFixture{text: "tag Reply: u8 { empty; } uni Box { reply: Reply; byte: u8; } fun f(x: u8) Box { ret x::Box; }", needle: "representation of a tag", accept: false, code: 5},
    TagFixture{text: "tag Reply: u8 { empty; } fun f(x: Reply) Reply { ret x::Reply; } fun g(x: Reply) Reply { ret x:~Reply; }", needle: "", accept: true, code: 6},
    TagFixture{text: "tag Reply: u8 { empty; } fun f(x: *u8) *Reply { ret x::*Reply; }", needle: "", accept: true, code: 7}
};

# `$is_tag` over nominal shapes
#[testing]
pub val TAG_IS_TAG_QUERIES: [3]TagFixture = [3]TagFixture{
    TagFixture{text: "tag Reply[T]: u8 { empty; value: T; } $if ($is_tag(Reply[u64])) {} $or { $error(\"expected tag\"); }", needle: "", accept: true, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; } $if ($is_tag(^Reply)) { $error(\"secret shape\"); }", needle: "", accept: true, code: 2},
    TagFixture{text: "rec Reply { value: u64; } $if ($is_tag(Reply)) { $error(\"record shape\"); }", needle: "", accept: true, code: 3}
};

# valid constructions of the std failure tags
#[testing]
pub val CANONICAL_CONSTRUCTION: [9]TagFixture = [9]TagFixture{
    TagFixture{text: "val a: res[i64, u32] = res[i64, u32].ok{42};", needle: "", accept: true, code: 1},
    TagFixture{text: "val b: res[i64, u32] = res[i64, u32].err{1u32};", needle: "", accept: true, code: 2},
    TagFixture{text: "val c: opt[i64] = opt[i64].some{42};", needle: "", accept: true, code: 3},
    TagFixture{text: "val d: opt[i64] = opt[i64].none{};", needle: "", accept: true, code: 4},
    TagFixture{text: "val e: err[u32] = err[u32].ok{};", needle: "", accept: true, code: 5},
    TagFixture{text: "val f: err[u32] = err[u32].err{7u32};", needle: "", accept: true, code: 6},
    TagFixture{text: "fun make_opt[T](v: T) opt[T] { ret opt[T].some{v}; }", needle: "", accept: true, code: 7},
    TagFixture{text: "fun make_res[T, E](v: T) res[T, E] { ret res[T, E].ok{v}; }", needle: "", accept: true, code: 8},
    TagFixture{text: "fun make_err[E](e: E) err[E] { ret err[E].err{e}; }", needle: "", accept: true, code: 9}
};

# the std failure tags given the wrong number of type arguments
#[testing]
pub val CANONICAL_ARITY: [7]TagFixture = [7]TagFixture{
    TagFixture{text: "val a: res = res[i64, u32].ok{1};", needle: "named without type arguments", accept: false, code: 1},
    TagFixture{text: "val b: res[i64] = res[i64, u32].ok{1};", needle: "wrong number of type arguments", accept: false, code: 2},
    TagFixture{text: "val c: res[i64, u32, u64] = res[i64, u32].ok{1};", needle: "wrong number of type arguments", accept: false, code: 3},
    TagFixture{text: "val d: opt = opt[i64].none{};", needle: "named without type arguments", accept: false, code: 4},
    TagFixture{text: "val e: opt[i64, u32] = opt[i64].none{};", needle: "wrong number of type arguments", accept: false, code: 5},
    TagFixture{text: "val f: err = err[u32].ok{};", needle: "named without type arguments", accept: false, code: 6},
    TagFixture{text: "val g: err[u32, i32] = err[u32].ok{};", needle: "wrong number of type arguments", accept: false, code: 7}
};

# payloads the std failure tags check
#[testing]
pub val CANONICAL_PAYLOADS: [7]TagFixture = [7]TagFixture{
    TagFixture{text: "val a: opt[i64] = opt[i64].none{1};", needle: "this tag case takes no payload", accept: false, code: 1},
    TagFixture{text: "val b: opt[i64] = opt[i64].some{};", needle: "this tag case requires a payload", accept: false, code: 2},
    TagFixture{text: "val c: err[u32] = err[u32].ok{1};", needle: "this tag case takes no payload", accept: false, code: 3},
    TagFixture{text: "val d: err[u32] = err[u32].err{};", needle: "this tag case requires a payload", accept: false, code: 4},
    TagFixture{text: "val e: res[i64, u32] = res[i64, u32].ok{};", needle: "this tag case requires a payload", accept: false, code: 5},
    TagFixture{text: "val f: res[i64, u32] = res[i64, u32].other{1};", needle: "unknown tag case", accept: false, code: 6},
    TagFixture{text: "val g: res[i64, u32] = res[i64, u32].ok{1u32};", needle: "type mismatch", accept: false, code: 7}
};

# the std failure tags kept distinct, and queried
#[testing]
pub val CANONICAL_DISTINCTNESS: [9]TagFixture = [9]TagFixture{
    TagFixture{text: "val o: opt[u64] = opt[u64].none{}; val e: err[u64] = o;", needle: "type mismatch", accept: false, code: 1},
    TagFixture{text: "$if ($is_tag(res[i64, u32])) {} $or { $error(\"expected tag\"); }", needle: "", accept: true, code: 2},
    TagFixture{text: "$if ($is_tag(^res[i64, u32])) { $error(\"secret shape\"); }", needle: "", accept: true, code: 3},
    TagFixture{text: "$if ($is_tag(opt[i64])) {} $or { $error(\"expected tag\"); }", needle: "", accept: true, code: 4},
    TagFixture{text: "$if ($is_tag(^opt[i64])) { $error(\"secret shape\"); }", needle: "", accept: true, code: 5},
    TagFixture{text: "$if ($is_tag(err[u32])) {} $or { $error(\"expected tag\"); }", needle: "", accept: true, code: 6},
    TagFixture{text: "$if ($is_tag(^err[u32])) { $error(\"secret shape\"); }", needle: "", accept: true, code: 7},
    TagFixture{text: "$if ($size_of(opt[u64]) == 16) {} $or { $error(\"unexpected size\"); }", needle: "", accept: true, code: 8},
    TagFixture{text: "$if ($align_of(opt[u64]) == 8) {} $or { $error(\"unexpected align\"); }", needle: "", accept: true, code: 9}
};

# casts of the std failure tags and names their context gives them
#[testing]
pub val CANONICAL_CASTS: [7]TagFixture = [7]TagFixture{
    TagFixture{text: "fun f() res[i64, u32] { val err: i64 = 10; ret res[i64, u32].ok{err}; }", needle: "", accept: true, code: 1},
    TagFixture{text: "val ok: u32 = 5; val r: res[i64, u32] = res[i64, u32].err{ok};", needle: "", accept: true, code: 2},
    TagFixture{text: "val none: i64 = 7; val o: opt[i64] = opt[i64].some{none};", needle: "", accept: true, code: 3},
    TagFixture{text: "val some: i32 = 0; val o: opt[i64] = opt[i64].none{};", needle: "", accept: true, code: 4},
    TagFixture{text: "val r: res[i64, u32] = res[i64, u32].ok{42}; val u: u64 = r::u64;", needle: "a cast cannot change the representation of a tag", accept: false, code: 5},
    TagFixture{text: "val r: res[i64, u32] = res[i64, u32].ok{42}; val r2: res[i64, u32] = r::res[i64, u32];", needle: "", accept: true, code: 6},
    TagFixture{text: "fun f(s: ^res[i64, u32]) res[i64, u32] { ret s:>res[i64, u32]; }", needle: "", accept: true, code: 7}
};

# payload reads that need a `sel` guard
#[testing]
pub val SEL_PAYLOAD_GUARDS: [7]TagFixture = [7]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) i64 { ret r.value; }", needle: "a tag payload requires a `sel` guard for its case", accept: false, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f() i64 { val r: Reply = Reply.value{42}; ret r.value; }", needle: "a tag payload requires a `sel` guard for its case", accept: false, code: 2},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) { val p: *i64 = ?r.value; }", needle: "a tag payload requires a `sel` guard for its case", accept: false, code: 3},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply, v: i64) { r.value = v; }", needle: "a tag payload requires a `sel` guard for its case", accept: false, code: 4},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f() { val r: Reply = Reply.empty{}; val x: i64 = r.empty; }", needle: "this tag case takes no payload", accept: false, code: 5},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) i64 { ret r.missing; }", needle: "no such field", accept: false, code: 6},
    TagFixture{text: "fun f() i64 { val r: res[i64, u32] = res[i64, u32].ok{100}; ret r.ok; }", needle: "a tag payload requires a `sel` guard for its case", accept: false, code: 7}
};

# where a case selector may appear
#[testing]
pub val SEL_SELECTOR_USAGE: [9]TagFixture = [9]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f() { val s: Reply = Reply.value; }", needle: "a case selector is not a value", accept: false, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f() { var r: Reply = Reply.empty{}; r = Reply.value; }", needle: "a case selector is not a value", accept: false, code: 2},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f() { val x: u64 = Reply.value::u64; }", needle: "cannot be cast", accept: false, code: 3},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) { val b: u8 = r < Reply.value; }", needle: "test a case with `sel place.case`", accept: false, code: 4},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) { val b: Reply = r + Reply.value; }", needle: "test a case with `sel place.case`", accept: false, code: 5},
    TagFixture{text: "tag A: u8 { c; } tag B: u8 { c; } fun f(a: A) u8 { ret a == B.c; }", needle: "test a case with `sel place.case`", accept: false, code: 6},
    TagFixture{text: "fun f(r: res[i64, u32]) u8 { ret r == res[i64, i32].ok; }", needle: "test a case with `sel place.case`", accept: false, code: 7},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) u8 { ret r == Reply.value; }", needle: "test a case with `sel place.case`", accept: false, code: 8},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) u8 { ret r != Reply.value; }", needle: "test a case with `sel place.case`", accept: false, code: 9}
};

# `sel` testing one case of a place
#[testing]
pub val SEL_ONE_CASE: [10]TagFixture = [10]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) u8 { ret sel r.value; }", needle: "", accept: true, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) { val b: u8 = sel r.empty; }", needle: "", accept: true, code: 2},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) { if (!sel r.empty) { } }", needle: "", accept: true, code: 3},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(a: Reply, b: Reply) { if (sel a.empty && sel b.value) { } }", needle: "", accept: true, code: 4},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(a: Reply, b: Reply) { if (sel a.empty || sel b.value) { } }", needle: "", accept: true, code: 5},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } rec Box { r: Reply; } fun f(b: Box) u8 { ret sel b.r.value; }", needle: "", accept: true, code: 6},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(a: [2]Reply) u8 { ret sel a[0].value; }", needle: "", accept: true, code: 7},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(p: *Reply) u8 { ret sel (@p).value; }", needle: "", accept: true, code: 8},
    TagFixture{text: "fun f(r: res[i64, u32]) u8 { ret sel r.ok; }", needle: "", accept: true, code: 9},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } def A: Reply; fun f(r: A) u8 { ret sel r.value; }", needle: "", accept: true, code: 10}
};

# `sel` over what is not a place, or a case the tag lacks
#[testing]
pub val SEL_NON_PLACES: [11]TagFixture = [11]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun make() Reply { ret Reply.empty{}; } fun f() u8 { ret sel make().empty; }", needle: "`sel` tests a place", accept: false, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) u8 { ret sel r.missing; }", needle: "unknown tag case", accept: false, code: 2},
    TagFixture{text: "rec Point { x: i64; } fun f(p: Point) u8 { ret sel p.x; }", needle: "`sel` expects a tag", accept: false, code: 3},
    TagFixture{text: "fun f(v: i64) u8 { ret sel v.x; }", needle: "`sel` expects a tag", accept: false, code: 4},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: ^Reply) u8 { ret sel r.empty; }", needle: "outer `^` secrecy protects the selected case", accept: false, code: 5},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) u8 { ret sel r; }", needle: "`sel` tests one case of a place", accept: false, code: 6},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) u8 { ret sel r.empty.value; }", needle: "this tag case takes no payload", accept: false, code: 7},
    TagFixture{text: "tag Inner: u8 { a; b: i64; } tag Outer: u8 { x; y: Inner; } fun f(o: Outer) u8 { ret sel o.y.b; }", needle: "a tag payload requires a `sel` guard", accept: false, code: 8},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(a: [2]Reply, i: i64) u8 { ret sel a[i + 1].value; }", needle: "so `i + 1` cannot appear in it", accept: false, code: 9},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } rec Box { r: Reply; } fun make() Box { ret Box{r: Reply.empty{}}; } fun f() u8 { ret sel make().r.value; }", needle: "so `make()` cannot appear in it", accept: false, code: 10},
    TagFixture{text: "fun f() u8 { ret sel $mach.build.arch.x86_64; }", needle: "", accept: false, code: 11}
};

# selectors used as values
#[testing]
pub val SEL_ESCAPES: [2]TagFixture = [2]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f() { Reply.value; }", needle: "a case selector is not a value", accept: false, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } val value: Reply = Reply.value;", needle: "a case selector is not a value", accept: false, code: 2}
};

# arms a `sel` guards
#[testing]
pub val SEL_ARMS: [10]TagFixture = [10]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } tag ParseError: u8 { invalid; overflow; } tag Three: u8 { a; b: i64; c: u8; } fun parse(s: i64) res[i64, ParseError] { ret res[i64, ParseError].ok{s}; } fun log(e: ParseError) { } fun consume(v: i64) { } fun f(r: Reply) i64 { if (sel r.value) { ret r.value; } ret 0; }", needle: "", accept: true, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } tag ParseError: u8 { invalid; overflow; } tag Three: u8 { a; b: i64; c: u8; } fun parse(s: i64) res[i64, ParseError] { ret res[i64, ParseError].ok{s}; } fun log(e: ParseError) { } fun consume(v: i64) { } fun f(r: Reply) { if (sel r.value) { val p: *i64 = ?r.value; @p = 5; r.value = 6; } }", needle: "", accept: true, code: 2},
