    if (!sema_checked.sema_clean("rec Box[T] { v: T; w: T; }\nfun count[T](b: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box[Box[u32]]; count[Box[Box[u32]]](b); ret 0; }\n")) { bad = 1; }

