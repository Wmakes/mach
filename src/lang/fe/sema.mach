# whole-value assignments to a guarded place
#[testing]
pub val SEL_WHOLE_ASSIGNMENT: [5]TagFixture = [5]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } tag ParseError: u8 { invalid; overflow; } tag Three: u8 { a; b: i64; c: u8; } fun parse(s: i64) res[i64, ParseError] { ret res[i64, ParseError].ok{s}; } fun log(e: ParseError) { } fun consume(v: i64) { } fun f() { var r: res[i64, ParseError] = parse(1); if (sel r.ok) { r = res[i64, ParseError].err{ParseError.invalid{}}; } }", needle: "rebind the new value to a new name", accept: false, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } tag ParseError: u8 { invalid; overflow; } tag Three: u8 { a; b: i64; c: u8; } fun parse(s: i64) res[i64, ParseError] { ret res[i64, ParseError].ok{s}; } fun log(e: ParseError) { } fun consume(v: i64) { } rec Box { r: Reply; } fun f(b: Box) { if (sel b.r.value) { b = Box{r: Reply.empty{}}; } }", needle: "rebind the new value to a new name", accept: false, code: 2},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } tag ParseError: u8 { invalid; overflow; } tag Three: u8 { a; b: i64; c: u8; } fun parse(s: i64) res[i64, ParseError] { ret res[i64, ParseError].ok{s}; } fun log(e: ParseError) { } fun consume(v: i64) { } fun f(r: Reply) { if (sel r.empty) { ret; } r = Reply.empty{}; }", needle: "rebind the new value to a new name", accept: false, code: 3},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } tag ParseError: u8 { invalid; overflow; } tag Three: u8 { a; b: i64; c: u8; } fun parse(s: i64) res[i64, ParseError] { ret res[i64, ParseError].ok{s}; } fun log(e: ParseError) { } fun consume(v: i64) { } fun f(r: Reply, q: Reply) { if (sel r.value) { q = Reply.empty{}; r.value = 1; } r = Reply.empty{}; }", needle: "", accept: true, code: 4},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } tag ParseError: u8 { invalid; overflow; } tag Three: u8 { a; b: i64; c: u8; } fun parse(s: i64) res[i64, ParseError] { ret res[i64, ParseError].ok{s}; } fun log(e: ParseError) { } fun consume(v: i64) { } fun f(p: *Reply, q: *Reply) { if (sel (@p).value) { p = q; } }", needle: "", accept: true, code: 5}
};

# returns from `fin` through a guard
#[testing]
pub val SEL_FIN_RETURNS: [2]TagFixture = [2]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } tag ParseError: u8 { invalid; overflow; } tag Three: u8 { a; b: i64; c: u8; } fun parse(s: i64) res[i64, ParseError] { ret res[i64, ParseError].ok{s}; } fun log(e: ParseError) { } fun consume(v: i64) { } fun flush() err[ParseError] { var w: err[ParseError] = err[ParseError].ok{}; fin { if (sel w.err) { ret err[ParseError].err{w.err}; } } ret err[ParseError].ok{}; }", needle: "`ret` cannot appear inside a `fin` body", accept: false, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } tag ParseError: u8 { invalid; overflow; } tag Three: u8 { a; b: i64; c: u8; } fun parse(s: i64) res[i64, ParseError] { ret res[i64, ParseError].ok{s}; } fun log(e: ParseError) { } fun consume(v: i64) { } fun flush(w: err[ParseError]) { fin { if (sel w.err) { log(w.err); } } }", needle: "", accept: true, code: 2}
};

# `sel` through a pointer place
#[testing]
pub val SEL_AUTO_DEREF: [10]TagFixture = [10]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(p: *Reply) i64 { if (sel p.value) { p.value = p.value + 1; val q: *i64 = ?p.value; ret @q; } ret 0; }", needle: "", accept: true, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(p: *Reply) i64 { if (!sel p.value) { ret 0; } ret p.value; }", needle: "", accept: true, code: 2},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(p: *Reply) u8 { if (sel p.value && p.value > 3) { ret 1; } ret 0; }", needle: "", accept: true, code: 3},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } rec Box { r: Reply; } fun f(b: *Box) i64 { if (sel b.r.value) { ret b.r.value; } ret 0; }", needle: "", accept: true, code: 4},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(p: *Reply, q: *Reply) { if (sel p.value) { p = q; } }", needle: "", accept: true, code: 5},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } rec Box { r: Reply; } fun f(b: *Box, c: *Box) { if (sel b.r.value) { b = c; } }", needle: "", accept: true, code: 6},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } rec Box { r: Reply; } fun f(b: *Box) { if (sel b.r.value) { b.r = Reply.empty{}; } }", needle: "rebind the new value to a new name", accept: false, code: 7},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(p: *^Reply) u8 { ret sel p.empty; }", needle: "outer `^` secrecy protects the selected case", accept: false, code: 8},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(p: **Reply) u8 { ret sel p.empty; }", needle: "`sel` expects a tag", accept: false, code: 9},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(p: *Reply, q: *Reply) i64 { if (sel p.value) { ret q.value; } ret 0; }", needle: "a tag payload requires a `sel` guard for its case", accept: false, code: 10}
};

# comptime `sel` over constant tags
#[testing]
pub val SEL_COMPTIME: [13]TagFixture = [13]TagFixture{
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } val C: Reply = Reply.value{42}; fun f() i64 { $if (sel C.value) { ret 1; } ret 0; }", needle: "", accept: true, code: 1},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } val C: Reply = Reply.value{42}; fun f() i64 { $if (sel C.value && C.value == 42) { ret 1; } ret 0; }", needle: "", accept: true, code: 2},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } val C: Reply = Reply.value{42}; fun f() i64 { $if (sel C.value) { ret C.value; } ret 0; }", needle: "", accept: true, code: 3},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } val TAGS: [2]Reply = [2]Reply{Reply.value{1}, Reply.empty{}}; fun f() i64 { var s: i64 = 0; $each t in TAGS { $if (sel t.value) { s = s + t.value; } } ret s; }", needle: "", accept: true, code: 4},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } val C: Reply = Reply.value{42}; fun f() i64 { $each c in $cases(Reply) { $if (sel C.[c]) { ret c.code::i64; } } ret -1; }", needle: "", accept: true, code: 5},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } tag Outer: u8 { none; inner: Reply; } val O: Outer = Outer.inner{Reply.value{7}}; fun f() i64 { $if (sel O.inner && (sel O.inner.value && O.inner.value == 7)) { ret 1; } ret 0; }", needle: "", accept: true, code: 6},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f() i64 { $if (sel LATE.value) { ret 1; } ret 0; } val LATE: Reply = Reply.value{42};", needle: "", accept: true, code: 7},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } val C: Reply = Reply.value{42}; $if (sel C.value) { fun pick() i64 { ret 0; } } $or { fun pick() i64 { ret 1; } }", needle: "", accept: true, code: 8},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f(r: Reply) i64 { $if (sel r.value) { ret 1; } ret 0; }", needle: "`sel` at compile time tests a constant tag", accept: false, code: 9},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } fun f() i64 { var r: Reply = Reply.value{1}; $if (sel r.value) { ret 1; } ret 0; }", needle: "`sel` at compile time tests a constant tag", accept: false, code: 10},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } val E: Reply = Reply.empty{}; fun f() i64 { if (!sel E.value) { ret 0; } $if (E.value == 3) { ret 1; } ret 2; }", needle: "never selected", accept: false, code: 11},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } val C: Reply = Reply.value{42}; val D: Reply = Reply.value{1}; fun f() i64 { $if (sel C.value) { ret D.value; } ret 0; }", needle: "a tag payload requires a `sel` guard for its case", accept: false, code: 12},
    TagFixture{text: "tag Reply: u8 { empty; value: i64; } val C: Reply = Reply.value{42}; fun f() i64 { $if (C.value == 42) { ret 1; } ret 0; }", needle: "a tag payload requires a `sel` guard for its case", accept: false, code: 13}
};

#[testing]
fun nested_array_src(alloc: *A.Allocator, n: u32) str {
    val head:  str   = "rec K { f: ";
    val tail:  str   = "u8; }\nfun main() i64 { ret 0; }\n";
    val hl:    usize = str_len(head);
    val tl:    usize = str_len(tail);
    val total: usize = hl + (n::usize * 3) + tl + 1;

    val r: res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel r.err) { ret ""; }
    val buf: *u8 = r.ok;

    var k: usize = 0;
    var j: usize = 0;
    for (j < hl) {
        buf[k] = head[j];
        k      = k + 1;
        j      = j + 1;
    }
    var i: u32 = 0;
    for (i < n) {
        buf[k] = '[';
        k      = k + 1;
        buf[k] = '1';
        k      = k + 1;
        buf[k] = ']';
        k      = k + 1;
        i      = i + 1;
    }
    j = 0;
    for (j < tl) {
        buf[k] = tail[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[k] = 0;
    ret buf::str;
}

# sema gives every gate its verdict, so a gate no constant decides is refused at check
# rather than left for lowering
test gate__sema_refuses_what_no_constant_decides {
    var bad: i32 = 0;
    if (!sema_checked.sema_says("var G: u32 = 3;\nfun f() u32 { $if (G == 3) { ret 1; } ret 0; }\n", "constant"))                          { bad = 1; }
    if (!sema_checked.sema_says("rec R { a: u32; }\nvar C: R = R{a: 3};\nfun f() u32 { $if (C.a == 3) { ret 1; } ret 0; }\n", "constant")) { bad = 2; }
    if (sema_checked.sema_says("val G: u32 = 3;\nfun f() u32 { $if (G == 3) { ret 1; } ret 0; }\n", "constant"))                           { bad = 3; }
    ret bad;
}

# resolve binds an asm block's `{name}`s to locals and refuses the rest where the block is
# written, comments aside
test asm__names_bind_where_the_block_is_resolved {
    var bad: i32 = 0;
    if (!sema_checked.sema_says("fun f() u64 { var x: u64 = 1; asm x86_64 { mov rax, {nope} } ret x; }\n", "unknown local 'nope'"))          { bad = 1; }
    if (!sema_checked.sema_says("fun g($n: u64) u64 { asm x86_64 { mov rax, {n} } ret n; }\n", "'n' is not stack-allocated"))                { bad = 2; }
    if (!sema_checked.sema_says("fun f() u64 { var x: u64 = 1; asm x86_64 { mov rax, {} } ret x; }\n", "empty '{}'"))                        { bad = 3; }
    if (sema_checked.sema_says("fun f(p: u64) u64 { var x: u64 = 1; asm x86_64 { mov rax, {x} # {nope}\n add rax, {p} } ret x; }\n", "asm")) { bad = 4; }
    ret bad;
}

# sema decides a function's and a global's `align` as it does a type's, and refuses two
# tests of one name, rules lowering once checked alone
test sema__decides_declaration_align_and_test_names {
    var bad: i32 = 0;
    if (!sema_checked.sema_says("#[align(3)]\nvar g: u32 = 0;\n", "non-zero power of two"))               { bad = 1; }
    if (!sema_checked.sema_says("#[align(6)]\nfun f() u32 { ret 0; }\n", "non-zero power of two"))        { bad = 2; }
    if (sema_checked.sema_says("#[align(8)]\nvar g: u32 = 0;\n", "align"))                                { bad = 3; }
    if (!sema_checked.sema_says("test same { ret 0; }\ntest same { ret 0; }\n", "duplicate test `same`")) { bad = 4; }
    if (sema_checked.sema_says("test one { ret 0; }\ntest two { ret 0; }\n", "duplicate test"))           { bad = 5; }
    ret bad;
}

# a type a logical-addressing target cannot declare is refused by sema where the code
# needs it; a pointer member that names its record closes a cycle such a target declares
test logical__sema_refuses_what_a_logical_target_cannot_declare {
    var bad:   i32 = 0;
    val stage: str = "#[stage(\"compute\")]\n#[workgroup(1, 1, 1)]\nfun main() {}\n";
    if (!spirv_says(sema_checked.joined("tag List: u8 { cons: *List; none; }\nfun f(l: *List) u32 { ret 0; }\n", stage), "recursive reference types"))    { bad = 1; }
    if (!spirv_says(sema_checked.joined("rec Box[T] { p: *Box[*T]; v: u32; }\nfun f(b: *Box[u32]) u32 { ret b.v; }\n", stage), "unboundedly many types")) { bad = 2; }
    if (spirv_says(sema_checked.joined("rec Node { next: *Node; v: u32; }\nfun f(l: *Node) u32 { ret l.v; }\n", stage), "Logical Shader"))                { bad = 3; }
    if (sema_checked.sema_says("tag List: u8 { cons: *List; none; }\nfun f(l: *List) u32 { ret 0; }\n", "Logical Shader"))                                { bad = 4; }
    ret bad;
}

# an instance that names no tag for `$cases`, or measures more than its destination holds,
# is refused by sema in the instance's frame, which lowering no longer checks again
test comptime__instance_rechecks_are_sema_s {
    var bad: i32 = 0;
    if (!sema_checked.sema_says("fun c[T]() u32 { var n: u32 = 0; $each k in $cases(T) { n = n + 1; } ret n; }\nfun g() u32 { ret c[u32](); }\n", "requires a tag type")) { bad = 1; }
    if (!sema_checked.sema_says("fun s[T]() u8 { val x: u8 = $size_of(T); ret x; }\nfun g() u8 { ret s[[300]u8](); }\n", "out of range"))                                 { bad = 2; }
    ret bad;
}

#[testing]
rec WalkRun {
    short: bool;
    code:  i32;
}

#[testing]
fun walk_bound_worker(arg: *u8) {
    val r:      *WalkRun     = arg::*WalkRun;
    var alloc:  A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret; }

    val nested:  str = nested_array_src(?alloc, 1100);
    val shallow: str = nested_array_src(?alloc, 1000);
    if (str_len(nested) == 0 || str_len(shallow) == 0) { ret; }

    r.code = 0;
    if (r.short) {
        # the parse fits, and name resolution runs short before the walk is reached
        if (!sema_checked.sema_rejects_with(nested, "name resolution descends")) { r.code = 3; }
        ret;
    }
    if (!sema_checked.sema_says(nested, "recursive-type checker")) { r.code = 1; }
    if (sema_checked.sema_says(shallow, "nests deeper than"))      { r.code = 2; }
}

# the walk runs on the stack the compiler sizes for itself, as in the compiler, so
# its fixed bound is what refuses the nesting. on a stack too short for the
# nesting a margin check refuses it instead of a reader running off the stack
test recursive_type__walk_is_depth_bounded {
    var r: WalkRun = WalkRun{short: false, code: 99};
    stack.run(walk_bound_worker, (?r)::*u8);
    if (r.code != 0) { ret r.code; }
    $if (capability.HAS_THREADS) {
        var short: WalkRun = WalkRun{short: true, code: 99};
        stack.run_reserved(walk_bound_worker, (?short)::*u8, 4194304);
        if (short.code != 0) { ret short.code; }
    }
    ret 0;
}

test constant__a_measured_constant_is_a_compile_time_constant {
    val head: str = "rec P { a: u64; b: u64; }\nval S: u64 = $size_of(P);\n";
    # an array length, in a field and in a body, before and after the declaration
    if (!sema_checked.sema_clean(sema_checked.joined(head, "rec H { buf: [S]u8; }\nfun main() i64 {\n    var b: [S]u8;\n    ret 0;\n}\n")))       { ret 1; }
    if (!sema_checked.sema_clean("rec H { buf: [S]u8; }\nval S: u64 = $size_of(P) * 2;\nrec P { a: u64; b: u64; }\nfun main() i64 { ret 0; }\n")) { ret 2; }
    # a gate in a body takes the arm the measurement selects, so only that arm is typed
    if (!sema_checked.sema_rejects_with(sema_checked.joined(head, "fun main() i64 {\n    $if (S == 16) { val bad: u8 = \"text\"; }\n    ret 0;\n}\n"), "type mismatch")) { ret 3; }
    if (!sema_checked.sema_clean(sema_checked.joined(head, "fun main() i64 {\n    $if (S == 17) { val bad: u8 = \"text\"; }\n    ret 0;\n}\n")))                         { ret 4; }
    ret 0;
}

test constant__an_imported_measured_constant_is_a_compile_time_constant {
    val lib: str = "pub rec P { a: u64; b: u64; }\npub val S: u64 = $size_of(P);\n";
    if (!sema_checked.sema_clean2("use t.lib;\nfun main() i32 {\n    var b: [lib.S]u8;\n    $if (lib.S != 16) { $error(\"wrong\"); }\n    ret 0;\n}\n", lib)) { ret 1; }
    if (!sema_checked.sema_clean2("use t.lib.S;\nfun main() i32 {\n    var b: [S]u8;\n    $if (S != 16) { $error(\"wrong\"); }\n    ret 0;\n}\n", lib))       { ret 2; }
    ret 0;
}

# `n` records each holding the one before by value, `Da` the innermost and its name
# growing one `a` per level, followed by `tail`
#[testing]
fun deep_record_src(alloc: *A.Allocator, n: u32, tail: str) str {
    val tl:    usize             = str_len(tail);
    val total: usize             = 64 + (n::usize * (24 + n::usize * 2)) + tl;
    val r:     res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel r.err) { ret ""; }
    var w: SourceWriter = SourceWriter{buf: r.ok, len: 0};
    put(?w, "rec Da { x: u8; }\n");
    var i: u32 = 1;
    for (i < n) {
        put(?w, "rec D");
        put_as(?w, i + 1);
        put(?w, " { x: D");
        put_as(?w, i);
        put(?w, "; }\n");
        i = i + 1;
    }
    put(?w, tail);
    w.buf[w.len] = 0;
    ret w.buf::str;
}

#[testing]
rec SourceWriter {
    buf: *u8;
    len: usize;
}

#[testing]
fun put(w: *SourceWriter, text: str) {
    val n: usize = str_len(text);
    var j: usize = 0;
    for (j < n) {
        w.buf[w.len] = text[j];
        w.len        = w.len + 1;
        j            = j + 1;
    }
}

#[testing]
fun put_as(w: *SourceWriter, count: u32) {
    var j: u32 = 0;
    for (j < count) {
        w.buf[w.len] = 'a';
        w.len        = w.len + 1;
        j            = j + 1;
    }
}

test layout__a_deep_record_is_measured_in_an_array_length {
    var alloc:  A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    val src: str = deep_record_src(?alloc, 71, "fun main() i64 {\n    var b: [$size_of(Daaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)]u8;\n    ret 0;\n}\n");
    if (str_len(src) == 0)             { ret 1; }
    if (!sema_checked.sema_clean(src)) { ret 2; }
    ret 0;
}

test layout__a_type_holding_itself_by_value_is_refused_when_measured {
    if (!sema_checked.sema_says("rec N { self: N; }\nfun main() i64 {\n    var b: [$size_of(N)]u8;\n    ret 0;\n}\n", "contains itself by value")) { ret 1; }
    ret 0;
}

test recursive_type__uni_secrecy_walk_memoizes_mutual_cycles {
    val src: str = "rec A { b: B; }\nrec B { a: A; }\nuni U { x: A; y: u32; }\nfun main() i64 { ret 0; }\n";
    if (sema_checked.sema_says(src, "nests deeper than"))                 { ret 1; }
    if (!sema_checked.sema_says(src, "recursive type has infinite size")) { ret 2; }
    ret 0;
}

test literal_range__secret_target_is_checked {
    if (!sema_checked.sema_says("pub val x: ^u8 = 300;\n", "out of range")) { ret 1; }
    if (sema_checked.sema_says("pub val y: ^u8 = 200;\n", "out of range"))  { ret 2; }
    ret 0;
}

test address_of__refuses_each_rvalue_kind_by_name {
    var bad:  i32 = 0;
    val head: str = "rec P { x: i64; }\nfun f() i64 { ret 1; }\nfun g() P { var p: P; p.x = 1; ret p; }\nfun h() [2]i64 { var a: [2]i64; ret a; }\n";
    if (!sema_checked.sema_says(sema_checked.joined(head, "fun main() i64 { val p: *i64 = ?f(); ret 0; }\n"), "cannot take the address of a call result"))                          { bad = 1; }
    if (!sema_checked.sema_says(sema_checked.joined(head, "fun main() i64 { val p: *i64 = ?1; ret 0; }\n"), "cannot take the address of a literal"))                                { bad = 2; }
    if (!sema_checked.sema_says(sema_checked.joined(head, "fun main() i64 { val x: i32 = 1; val p: *i64 = ?(x::i64); ret 0; }\n"), "cannot take the address of a cast result"))     { bad = 4; }
    if (!sema_checked.sema_says(sema_checked.joined(head, "fun main() i64 { val x: i64 = 1; val p: *i64 = ?(x + 1); ret 0; }\n"), "cannot take the address of an operator result")) { bad = 5; }
    if (!sema_checked.sema_says(sema_checked.joined(head, "fun main() i64 { val p: *[2]i64 = ?[2]i64{1, 2}; ret 0; }\n"), "cannot take the address of an array literal"))           { bad = 6; }
    if (!sema_checked.sema_says(sema_checked.joined(head, "fun main() i64 { val p: *P = ?P{ x: 1 }; ret 0; }\n"), "cannot take the address of a record literal"))                   { bad = 7; }
    if (!sema_checked.sema_says(sema_checked.joined(head, "fun main() i64 { val p: *i64 = ?g().x; ret 0; }\n"), "cannot take the address of a field of a call result"))             { bad = 8; }
    if (!sema_checked.sema_says(sema_checked.joined(head, "fun main() i64 { val p: *i64 = ?h()[0]; ret 0; }\n"), "cannot take the address of an element of a call result"))         { bad = 9; }
    if (!sema_checked.sema_says(sema_checked.joined(head, "fun main() i64 { val p: *i64 = ?f(); ret 0; }\n"), "`?` applies to a place"))                                            { bad = 10; }
    ret bad;
}

test address_of__accepts_every_place_kind {
    var bad:  i32 = 0;
    val head: str = "rec P { x: i64; }\nfun pp(q: *P) *P { ret q; }\n";
    if (!sema_checked.sema_clean(sema_checked.joined(head, "fun main() i64 { var x: i64 = 1; val p: *i64 = ?x; ret @p; }\n")))             { bad = 1; }
    if (!sema_checked.sema_clean(sema_checked.joined(head, "fun main() i64 { var r: P; val p: *i64 = ?r.x; ret @p; }\n")))                 { bad = 2; }
    if (!sema_checked.sema_clean(sema_checked.joined(head, "fun main() i64 { var a: [2]i64; val p: *i64 = ?a[0]; ret @p; }\n")))           { bad = 3; }
    if (!sema_checked.sema_clean(sema_checked.joined(head, "fun main() i64 { var r: P; val q: *P = ?r; val p: *i64 = ?q.x; ret @p; }\n"))) { bad = 4; }
    if (!sema_checked.sema_clean(sema_checked.joined(head, "fun main() i64 { var r: P; val q: *P = ?r; val p: *P = ?@q; ret 0; }\n")))     { bad = 5; }
    if (!sema_checked.sema_clean(sema_checked.joined(head, "fun main() i64 { var r: P; val p: *i64 = ?pp(?r).x; ret @p; }\n")))            { bad = 6; }
    ret bad;
}

# a literal no context types takes the i64 default and is range-checked there,
# once; one its context types is refused at that type alone
test literal_range__i64_default_is_checked {
    if (!sema_checked.sema_says("pub val a: f64 = 10000000000000000000::f64;\n",
        "literal 10000000000000000000 is out of range for i64 (-9223372036854775808..9223372036854775807)")) { ret 1; }
    if (!sema_checked.sema_says("fun f() u8 { if (10000000000000000000 == 0) { ret 1; } ret 0; }\n",
        "literal 10000000000000000000 is out of range for i64")) { ret 2; }
    if (!sema_checked.sema_clean("pub val b: f64 = 9223372036854775807::f64;\npub val c: i64 = -9223372036854775808;\n")) { ret 3; }
    if (sema_checked.sema_says("pub val d: u8 = 10000000000000000000;\n", "out of range for i64"))                        { ret 4; }
    ret 0;
}

# an untyped literal coerces to u128/i128 when it fits and is refused, quoting
# all of its digits and the 128-bit bounds, when it does not
test literal_range__128_bit_bounds {
    if (!sema_checked.sema_clean("pub val a: u128 = 340282366920938463463374607431768211455;\n"))   { ret 1; }
    if (!sema_checked.sema_clean("pub val b: i128 = 170141183460469231731687303715884105727;\n"))   { ret 2; }
    if (!sema_checked.sema_clean("pub val c: i128 = -170141183460469231731687303715884105728;\n"))  { ret 3; }
    if (!sema_checked.sema_clean("pub val d: u128 = 0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF;\n")) { ret 4; }
    if (!sema_checked.sema_says("pub val f: i128 = 170141183460469231731687303715884105728;\n",
        "literal 170141183460469231731687303715884105728 is out of range for i128 (-170141183460469231731687303715884105728..170141183460469231731687303715884105727)")) { ret 6; }
    if (!sema_checked.sema_says("pub val g: i128 = -170141183460469231731687303715884105729;\n",
        "literal -170141183460469231731687303715884105729 is out of range for i128")) { ret 7; }
    if (!sema_checked.sema_says("pub val i: u128 = -1;\n", "out of range for u128 (0..340282366920938463463374607431768211455)"))           { ret 9; }
    if (!sema_checked.sema_says("pub val j: u8 = 18446744073709551616;\n", "literal 18446744073709551616 is out of range for u8 (0..255)")) { ret 10; }
    # under `::` the exact value is refused only when no integer type holds it
    if (!sema_checked.sema_clean("pub val k: u8 = 18446744073709551616::u8;\n")) { ret 11; }
    if (!sema_checked.sema_says("pub val l: i128 = (-170141183460469231731687303715884105729)::i128;\n",
        "literal -170141183460469231731687303715884105729 is out of range for i128")) { ret 12; }
    ret 0;
}

# a constant shift count at or above the operand's width is refused with the
# count and the width, at every width, through a literal, a `val` and an
# expression of them; one below the width and a runtime count are accepted
test shift_count__constant_at_or_above_the_width_is_refused {
    if (!sema_checked.sema_says("fun f(x: u8) u8 { ret x << 8; }\n", "shift count 8 is at least the width of `u8` (8 bits)"))                   { ret 1; }
    if (!sema_checked.sema_says("fun f(x: u32) u32 { ret x >> 40; }\n", "shift count 40 is at least the width of `u32` (32 bits)"))             { ret 4; }
    if (!sema_checked.sema_says("fun f(x: u128) u128 { ret x << 128; }\n", "shift count 128 is at least the width of `u128` (128 bits)"))       { ret 6; }
    if (!sema_checked.sema_says("val N: u8 = 32;\nfun f(x: u32) u32 { ret x << N; }\n", "shift count 32 is at least the width of `u32`"))       { ret 8; }
    if (!sema_checked.sema_says("val N: u8 = 30;\nfun f(x: u32) u32 { ret x << (N + 2); }\n", "shift count 32 is at least the width of `u32`")) { ret 9; }
    if (!sema_checked.sema_says("val N: i8 = -1;\nfun f(x: u32) u32 { ret x << N; }\n", "shift count -1 is negative"))                          { ret 10; }
    if (!sema_checked.sema_clean("fun f(x: u8) u8 { ret x << 7; }\n"))                                                                          { ret 11; }
    if (!sema_checked.sema_clean("val N: u8 = 31;\nfun f(x: u32) u32 { ret x << N; }\n"))                                                       { ret 16; }
    if (!sema_checked.sema_clean("fun f(x: u32, n: u8) u32 { ret x << n; }\n"))                                                                 { ret 17; }
    # a literal's shift is checked at the type its context gives it, not the i64 default
    if (!sema_checked.sema_clean("pub val a: u128 = 1 << 100;\npub val b: u128 = (1 << 100)::u128;\n"))                            { ret 18; }
    if (!sema_checked.sema_says("pub val c: u64 = (1 << 70) >> 10;\n", "shift count 70 is at least the width of `u64` (64 bits)")) { ret 19; }
    if (!sema_checked.sema_says("pub val d: u8 = 1 << 8;\n", "shift count 8 is at least the width of `u8` (8 bits)"))              { ret 20; }
    ret 0;
}

# a `u8`-discriminated tag with `count` cases, to probe the width check
#[testing]
fun tag_with_cases(alloc: *A.Allocator, count: u32) str {
    val header: str               = "tag Wide: u8 { ";
    val bytes:  usize             = str_len(header) + (count::usize * 8::usize) + 3::usize;
    val r:      res[*u8, A.Error] = A.allocate[u8](alloc, bytes);
    if (sel r.err) { ret header; }
    val buf: *u8   = r.ok;
    var w:   usize = 0;
    var h:   usize = 0;
    for (h < str_len(header)) {
        buf[w] = header[h];
        w      = w + 1;
        h      = h + 1;
    }
    var i: u32 = 0;
    for (i < count) {
        buf[w] = 'c';
        w      = w + 1;
        var digits: u32 = i;
        var scale:  u32 = 100;
        for (scale > 0) {
            buf[w] = (48 + ((digits / scale) % 10))::u8;
            w      = w + 1;
            scale  = scale / 10;
        }
        buf[w] = ';';
        w      = w + 1;
        i      = i + 1;
    }
    buf[w] = '}';
    w      = w + 1;
    buf[w] = 0;
    ret buf::str;
}

test layout_intrinsic__adopts_the_binding_width {
    var bad: i32 = 0;
    val pre: str = "rec P { x: i64; y: i64; }\n";

    if (!sema_checked.sema_clean(sema_checked.joined(pre, "val A: u8  = $size_of(P);\nfun main() i32 { ret 0; }\n"))) { bad = 1; }
    if (!sema_checked.sema_clean(sema_checked.joined(pre, "val A: i32 = $size_of(P);\nfun main() i32 { ret 0; }\n"))) { bad = 5; }

    if (!sema_checked.sema_clean(sema_checked.joined(pre, "val A: u8  = $align_of(P);\nfun main() i32 { ret 0; }\n"))) { bad = 7; }
    if (!sema_checked.sema_clean("val A: u16 = $length_of([4]i32);\nfun main() i32 { ret 0; }\n"))                     { bad = 8; }

    if (!sema_checked.sema_clean(sema_checked.joined(pre, "val N: u32 = 3;\nval A: u32 = N * $size_of(P);\nfun main() i32 { ret 0; }\n"))) { bad = 9; }

    if (!sema_checked.sema_clean(sema_checked.joined(pre, "fun sz[T]() u32 { var n: u32 = $size_of(T); ret n; }\nfun use_it() u32 { ret sz[P](); }\nfun main() i32 { ret 0; }\n"))) { bad = 10; }
    ret bad;
}

test layout_intrinsic__refuses_a_binding_it_does_not_fit {
    var bad: i32 = 0;
    if (sema_checked.sema_diag("rec Huge { a: [300]u8; }\nval A: u8 = $size_of(Huge);\nfun main() i32 { ret 0; }\n",
        "value 300 is out of range for u8") != 0) { bad = 1; }
    if (sema_checked.sema_diag("rec Big { a: [200]u8; }\nval A: i8 = $size_of(Big);\nfun main() i32 { ret 0; }\n",
        "is out of range for i8") != 0) { bad = 2; }
    if (sema_checked.sema_diag("rec P { x: i64; }\nval A: f64 = $size_of(P);\nfun main() i32 { ret 0; }\n",
        "type mismatch") != 0) { bad = 3; }
    # the offset folds during type checking from the checked layout, so the width check is the same one `$size_of` meets
    if (!sema_checked.sema_rejects_with("rec Wide { pad: [300]u8; tail: i32; }\nval A: u8 = $offset_of(Wide, tail);\nfun main() i32 { ret 0; }\n",
        "value 300 is out of range for u8")) { bad = 4; }
    if (!sema_checked.sema_clean("rec Wide { pad: [300]u8; tail: i32; }\nval A: u32 = $offset_of(Wide, tail);\nfun main() i32 { ret 0; }\n")) { bad = 5; }
    ret bad;
}

test literal_range__operand_order_does_not_matter {
    var bad: i32 = 0;
    if (sema_checked.sema_diag("fun f(x: u8) u8 { ret x + 300; }\nfun main() i32 { ret 0; }\n",
        "literal 300 is out of range for u8") != 0) { bad = 1; }
    if (sema_checked.sema_diag("fun f(x: u8) u8 { ret 300 + x; }\nfun main() i32 { ret 0; }\n",
        "literal 300 is out of range for u8") != 0) { bad = 2; }
    if (!sema_checked.sema_clean("fun f(x: u8) u8 { ret x + 5; }\nfun g(x: u8) u8 { ret 5 + x; }\nfun main() i32 { ret 0; }\n")) { bad = 3; }
    # the refusal points at the literal operand, not the whole expression
    if (!sema_checked.sema_rejects_at("fun f(x: u8) u8 { ret x + 300; }\nfun main() i32 { ret 0; }\n", "out of range for u8", 26, 3))                   { bad = 4; }
    if (!sema_checked.sema_rejects_at("fun f(x: u8) u8 { ret 300 + x; }\nfun main() i32 { ret 0; }\n", "out of range for u8", 22, 3))                   { bad = 5; }
    if (!sema_checked.sema_rejects_at("fun f(x: u8) u8 { if (x == -1) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n", "out of range for u8", 27, 2)) { bad = 6; }
    ret bad;
}

test pack__refused_on_a_body_less_fun {
    var bad: i32 = 0;

    if (sema_checked.sema_diag("#[library(\"raylib\")]\next fun TextFormat(text: *u8, va: ...) *u8;\nfun main() i32 { ret 0; }\n",
        "cannot appear on a body-less `fun`") != 0) { bad = 1; }

    if (sema_checked.sema_note("#[library(\"raylib\")]\next fun TextFormat(text: *u8, va: ...) *u8;\nfun main() i32 { ret 0; }\n",
        "ext fun f(a: T, ...)") != 0) { bad = 2; }

    if (!sema_checked.sema_clean("ext fun printf(fmt: *u8, ...) i32;\nfun main() i32 { ret 0; }\n"))       { bad = 4; }
    if (!sema_checked.sema_clean("fun fold(h: u64, va: ...) u64 { ret h; }\nfun main() i32 { ret 0; }\n")) { bad = 5; }
    ret bad;
}

test pack__forwards_into_a_c_variadic_tail {
    val decls: str = "ext fun printf(fmt: *u8, ...) i32;\npub fun logf(fmt: *u8, va: ...) i32 { ret printf(fmt, va...); }\n";
    var bad:   i32 = 0;

    if (!sema_checked.sema_clean(sema_checked.joined(decls, "fun use_it() i32 { ret logf(\"%d %f\\n\", 1::i32, 2.5); }\nfun main() i32 { ret 0; }\n"))) { bad = 1; }
    if (!sema_checked.sema_clean(sema_checked.joined(decls, "fun use_it() i32 { ret logf(\"hi\\n\"); }\nfun main() i32 { ret 0; }\n")))                 { bad = 2; }

    if (sema_checked.sema_diag(sema_checked.joined(decls, "fun use_it() i32 { var c: u8 = 65; ret logf(\"%d\\n\", c); }\nfun main() i32 { ret 0; }\n"),
        "is promoted to a 32-bit integer in a C-variadic argument") != 0) { bad = 3; }
    if (sema_checked.sema_diag(sema_checked.joined(decls, "fun use_it() i32 { ret logf(\"%f\\n\", 1.5::f32); }\nfun main() i32 { ret 0; }\n"),
        "is promoted to `f64` in a C-variadic argument") != 0) { bad = 4; }

    if (!sema_checked.sema_clean("fun plain(h: u64, va: ...) u64 { ret h; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var c: u8 = 65; plain(1, c); ret 0; }\n")) { bad = 6; }

    if (sema_checked.sema_diag("fun fixed(a: i32) i32 { ret a; }\nfun fwd(va: ...) i32 { ret fixed(va...); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { fwd(1::i32); ret 0; }\n",
        "cannot spread `...` into fixed parameters") != 0) { bad = 7; }

    if (sema_checked.sema_diag(sema_checked.joined(decls, "fun use_it() i32 { var s: ^i32 = 1; ret logf(\"%d\\n\", s); }\nfun main() i32 { ret 0; }\n"),
        "secret value cannot be passed to a") != 0) { bad = 8; }
    ret bad;
}

# a case literal carries its payload only in positional elements, which the reach scan visits
test pack__forwards_into_a_c_variadic_tail_through_a_case_literal {
    val decls: str = "ext fun printf(fmt: *u8, ...) i32;\ntag Reply: u8 { empty; value: i32; }\npub fun logf(fmt: *u8, va: ...) Reply { ret Reply.value{printf(fmt, va...)}; }\n";
    if (sema_checked.sema_diag(sema_checked.joined(decls, "fun use_it() Reply { var c: u8 = 65; ret logf(\"%d\\n\", c); }\nfun main() i32 { ret 0; }\n"),
        "is promoted to a 32-bit integer in a C-variadic argument") != 0) { ret 1; }
    ret 0;
}

test tag__payload_layouts {
    if (extent_is("tag Reply: u8 { empty; value: u64; }", "Reply", 16, 8) != 0)                             { ret 1; }
    if (extent_is("tag Reply: u8 { empty; }", "Reply", 1, 1) != 0)                                          { ret 2; }
    if (extent_is("#[packed] tag Reply: u8 { empty; value: u64; }", "Reply", 9, 1) != 0)                    { ret 3; }
    if (extent_is("#[packed] #[align(16)] tag Reply: u8 { empty; value: u64; }", "Reply", 16, 16) != 0)     { ret 4; }
    if (extent_is("tag Reply[T]: u8 { empty; value: T; } var reply: Reply[u64];", "Reply", 16, 8) != 0)     { ret 5; }
    if (!sema_checked.sema_clean("tag Reply[T]: u8 { next: *Reply[T]; value: T; } var reply: Reply[u64];")) { ret 6; }
    if (!sema_checked.sema_clean("tag Reply: u8 { secret: ^u64; public: u64; }"))                           { ret 7; }
    ret 0;
}

test tag_discriminator__declared_and_checked {
    if (extent_is("tag Reply: u32 { empty; }", "Reply", 4, 4) != 0)                                                                                                                         { ret 2; }
    if (extent_is("tag Reply: u64 { empty; value: u16; }", "Reply", 16, 8) != 0)                                                                                                            { ret 3; }
    if (extent_is("#[packed] tag Reply: u32 { empty; value: u64; }", "Reply", 12, 1) != 0)                                                                                                  { ret 4; }
    if (!sema_checked.sema_clean("tag Reply: u32 { empty; value: i64; } fun f() $discriminant_of(Reply) { ret 1u32; }"))                                                                    { ret 6; }
    if (!sema_checked.sema_clean("tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\nfun f() $discriminant_of(opt[i64]) { ret 1u8; }")) { ret 7; }
    if (!sema_checked.sema_rejects_with("tag Reply: u32 { empty; } fun f() u8 { ret 1u8::$discriminant_of(Reply); }", "type mismatch"))                                                     { ret 8; }
    ret 0;
}

test tag_discriminator__rejected_when_unusable {
    if (!sema_checked.sema_rejects_with("tag Reply { empty; value: i64; }", "requires a discriminator type"))                     { ret 1; }
    if (!sema_checked.sema_rejects_with("tag Reply: i8 { empty; }", "must be `u8`, `u16`, `u32` or `u64`"))                       { ret 2; }
    if (!sema_checked.sema_rejects_with("rec Word { a: u8; } tag Reply: Word { empty; }", "must be `u8`, `u16`, `u32` or `u64`")) { ret 10; }
    if (!sema_checked.sema_rejects_with("tag Reply: ^u8 { empty; }", "must be `u8`, `u16`, `u32` or `u64`"))                      { ret 4; }
    if (!sema_checked.sema_rejects_with("tag Reply: *u8 { empty; }", "must be `u8`, `u16`, `u32` or `u64`"))                      { ret 5; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 11; }
    val wide:   str  = tag_with_cases(?alloc, 257);
    val narrow: bool = sema_checked.sema_rejects_with(wide, "too narrow for the case count");
    val exact:  str  = tag_with_cases(?alloc, 256);
    val fits:   bool = sema_checked.sema_clean(exact);
    if (!narrow)                                                                                                                                       { ret 6; }
    if (!fits)                                                                                                                                         { ret 9; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; } fun f() $discriminant_of(i64) { ret 1u8; }", "`$discriminant_of` expects a tag"))    { ret 7; }
    if (!sema_checked.sema_rejects_with("rec Reply { value: u64; } fun f() $discriminant_of(Reply) { ret 1u8; }", "`$discriminant_of` expects a tag")) { ret 8; }
    ret 0;
}

test tag__rejects_invalid_case_recipes {
    ret tag_rows(?TAG_CASE_RECIPES[0], $length_of(TAG_CASE_RECIPES));
}

test tag_construction__names_the_type_and_the_case {
    ret tag_rows(?TAG_CONSTRUCTION_NAMES[0], $length_of(TAG_CONSTRUCTION_NAMES));
}

test tag_construction__qualified_and_aliased_heads {
    if (!sema_checked.sema_clean2("use t.lib; fun f() lib.Reply { ret lib.Reply.value{42}; }",
        "pub tag Reply: u8 { empty; value: i64; }")) { ret 1; }
    if (!sema_checked.sema_clean2("use t.lib; fun f() lib.Reply { ret lib.Reply.empty{}; }",
        "pub tag Reply: u8 { empty; value: i64; }")) { ret 2; }
    if (!sema_checked.sema_clean2("use t.lib; fun f() lib.Point { ret lib.Point{x: 1, y: 2}; }",
        "pub rec Point { x: i64; y: i64; }")) { ret 3; }
    if (!sema_checked.sema_clean2("use t.lib.Reply; fun f() Reply { ret Reply.value{42}; }",
        "pub tag Reply: u8 { empty; value: i64; }")) { ret 4; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; } def A: Reply; fun f(v: i64) A { ret A.value{v}; }"))                                                                                                                    { ret 5; }
    if (!sema_checked.sema_clean("tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\nfun f[E](e: E) res[i64, E] { ret res[i64, E].err{e}; } fun g() res[i64, u32] { ret f[u32](1u32); }")) { ret 6; }
    if (!sema_checked.sema_rejects_with("rec Point { x: i64; } fun f() Point { ret Point.x{1}; }", "is not a tag"))                                                                                                                            { ret 7; }
    ret 0;
}

test tag_construction__record_literal_form_is_refused {
    ret tag_rows(?TAG_RECORD_LITERAL_FORMS[0], $length_of(TAG_RECORD_LITERAL_FORMS));
}

test tag__representation_cannot_be_forged_through_casts {
    ret tag_rows(?TAG_FORGED_CASTS[0], $length_of(TAG_FORGED_CASTS));
}

test tag_construction__distinct_from_vector_literals {
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; } def Alias: Reply; val r: Alias = Alias.empty{};"))                                          { ret 1; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; } fun make[T]() T { ret T.empty{}; } fun f() Reply { ret make[Reply](); }"))                  { ret 2; }
    if (!sema_checked.sema_clean("def V: u32x4; fun f(x: u32) V { ret V{x, 2u32, x, 4u32}; }"))                                                        { ret 3; }
    if (!sema_checked.sema_rejects_with("def V: u32x4; fun f() V { ret V{missing, 2u32, 3u32, 4u32}; }", "unresolved identifier"))                     { ret 4; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; } fun f(a: Reply, b: Reply) u8 { ret a == b; }", "aggregate"))                         { ret 5; }
    if (sema_checked.sema_ok("def V: u32x4; fun f(x: u32) V { ret V{x, 2u32, x, 4u32}; } fun main() i32 { val v: V = f(1u32); ret v[0]::i32; }") != 0) { ret 6; }
    ret 0;
}

test tag__is_tag_queries_nominal_shapes {
    ret tag_rows(?TAG_IS_TAG_QUERIES[0], $length_of(TAG_IS_TAG_QUERIES));
}

test case_descriptor__enumeration {
    # `$cases(T)` walks declaration order; a descriptor answers name, has_payload, type, offset and code, and refuses storage questions about a payloadless case
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) u64 { $each c in $cases(Reply) { if (sel v.[c]) { ret c.code; } } ret 99; }"))                                                                                                                            { ret 1; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { var n: u64 = 0; $each c in $cases(Reply) { $if (c.has_payload) { n = n + c.offset; } $or { n = n + 1; } } ret n; }"))                                                                                       { ret 2; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { $each c in $cases(Reply) { $if (c.has_payload) { $if (c.type == i64) {} $or { $error(\"type\"); } } } ret 0; }"))                                                                                           { ret 4; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { $each c in $cases(Reply) { $if (c.has_payload) { $if (c.code == 1) {} $or { $error(\"code\"); } } $or { $if (c.code == 0) {} $or { $error(\"code0\"); } } } ret 0; }"))                                     { ret 5; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { $each c in $cases(Box[Reply]) { $if (c.has_payload) { $if (c.type == Reply) {} $or { $error(\"specialized\"); } $if (c.offset == 8) {} $or { $error(\"offset\"); } } } ret 0; }"))                          { ret 7; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\ndef R: Box[u32];\nfun f() u64 { $each c in $cases(R) { $if (c.has_payload) { $if (c.type == u32) {} $or { $error(\"alias\"); } } } ret 0; }"))                                                                            { ret 8; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(p: *u8) u64 { var n: u64 = 0; $each c in $cases(Reply) { val s: *u8 = c.name; if (s[0] != 0) { n = n + 1; } } ret n; }"))                                                                                           { ret 9; }
    if (!sema_checked.sema_clean("tag Secretive: u8 { failed: i32; value: ^u64; }\nfun f() u64 { var n: u64 = 0; $each c in $cases(Secretive) { $if (c.has_payload) { $if ($is_secret(c.type)) { n = n + 1; } $or (c.type == i32) { n = n + 1; } $or { $error(\"qualifier\"); } } } ret n; }"))                                                                            { ret 10; }
    if (!sema_checked.sema_clean("tag Secretive: u8 { failed: i32; value: ^u64; }\nfun f() u64 { var n: u64 = 0; $each c in $cases(Secretive) { $if (c.has_payload) { $if (c.type == u64) { $error(\"stripped\"); } $or { n = n + 1; } } } ret n; }"))                                                                                                                     { ret 17; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\nfun take[T](v: T) u64 { ret 1; }\nfun f(v: Reply) u64 { $each c in $cases(Reply) { if (sel v.[c]) { ret take[c.type](0); } } ret 0; }", "this case has no payload, so it has no `.type` or `.offset`"))                                                                                     { ret 18; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun count[T]() u64 { var n: u64 = 0; $each c in $cases(T) { n = n + 1; } ret n; }\nfun g() u64 { ret count[Reply]() + count[Box[u8]](); }"))                                                                              { ret 11; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec Holder { r: Reply; n: u8; }\nfun f(h: Holder) i64 { $each f in $fields(Holder) { $if ($is_tag(f.type)) { $each c in $cases(f.type) { $if (c.has_payload) { if (sel h.[f].[c]) { ret h.[f].[c]; } } } } } ret -1; }")) { ret 12; }
    if (!sema_checked.sema_clean("tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\nfun f() u64 { $each c in $cases(res[i64, u32]) { $if (c.has_payload) { $if (c.type == i64) { $if (c.code == 1) {} $or { $error(\"ok code\"); } } } } ret 0; }"))                                                                  { ret 13; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n$if ($is_tag(Reply)) {} $or { $error(\"tag\"); }\n$if ($is_tag(^Reply)) { $error(\"secret shape\"); }"))                                                                                                                  { ret 16; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { var n: u64 = 0; $each c in $cases(^Reply) { n = n + 1; } ret n; }", "`$cases` refuses `^Reply`"))                                                                                                    { ret 17; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec P { a: u8; }\nfun f() u64 { var n: u64 = 0; $each c in $cases(P) { n = n + 1; } ret n; }", "`$cases` requires a tag type"))                                                                                    { ret 18; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { var n: u64 = 0; $each c in $fields(Reply) { n = n + 1; } ret n; }", "$fields requires a record type"))                                                                                               { ret 19; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { $each c in $cases(Reply) { ret c.offset; } ret 0; }", "this case has no payload, so it has no `.type` or `.offset`"))                                                                                { ret 21; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { $each c in $cases(Reply) { ret c.size; } ret 0; }", "a case descriptor has only `.name`, `.has_payload`, `.type`, `.offset`, and `.code`"))                                                          { ret 23; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u8 { $each c in $cases(Reply) { ret c.has_payload; } ret 0; }", "`case.has_payload` is a comptime predicate"))                                                                                             { ret 24; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec P { a: u8; }\nfun f() u64 { $each f in $fields(P) { ret f.code; } ret 0; }", "a field descriptor has only `.name`, `.type`, and `.offset`"))                                                                   { ret 25; }
    ret 0;
}

test case_descriptor__projection_obeys_guard_rules {
    # `sel v.[c]` opens the same guard as `sel v.c`, and `v.[c]` is the same payload place
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.[c]) { ret v.[c]; } } } ret -1; }"))                                                                                                                      { ret 1; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.[c] && v.[c] > 3) { ret 1; } } } ret -1; }"))                                                                                                             { ret 2; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (!sel v.[c]) { ret -1; } ret v.[c]; } } ret -2; }"))                                                                                                             { ret 3; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { if (sel v.[c]) { $if (c.has_payload) { ret v.[c]; } } } ret -1; }"))                                                                                                                      { ret 4; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: *Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel (@v).[c]) { (@v).[c] = 2; val q: *i64 = ?(@v).[c]; ret @q; } } } ret -1; }"))                                                                              { ret 5; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\ntag Outer: u8 { none; inner: Reply; }\nfun f(o: Outer) i64 { $each c in $cases(Outer) { $if (c.has_payload) { if (sel o.[c]) { if (sel o.[c].value) { ret o.[c].value; } } } } ret -1; }"))                                                { ret 6; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.[c]) { if (sel v.value) { ret v.value + v.[c]; } } } } ret -1; }"))                                                                                       { ret 7; }
    if (!sema_checked.sema_clean("tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\nfun f(r: res[i64, u32]) i64 { $each c in $cases(res[i64, u32]) { $if (c.has_payload) { $if (c.type == i64) { if (sel r.[c]) { ret r.[c]; } } } } ret -1; }"))                                                                                      { ret 9; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { ret v.[c]; } } ret 0; }", "a tag payload requires a `sel` guard for its case"))                                                                              { ret 10; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { if (sel v.[c]) { ret v.[c]; } } ret 0; }", "this tag case takes no payload"))                                                                                                      { ret 11; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.[c] && v.[c] > 3) { ret v.[c]; } } } ret 0; }", "a tag payload requires a `sel` guard for its case"))                                              { ret 12; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.[c] || v.[c] > 3) { ret 1; } } } ret 0; }", "a tag payload requires a `sel` guard for its case"))                                                  { ret 13; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { if (sel v.[c]) { v = Reply.empty{}; } } ret 0; }", "cannot assign to this place inside a guard"))                                                                                  { ret 14; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: ^Reply) u8 { $each c in $cases(Reply) { if (sel v.[c]) { ret 1; } } ret 0; }", "`sel` cannot test `^Reply`"))                                                                                                              { ret 15; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n#[packed] tag Pk: u8 { a; b: u32; }\nfun f(v: Pk) u32 { $each c in $cases(Pk) { $if (c.has_payload) { if (sel v.[c]) { val q: *u32 = ?v.[c]; ret @q; } } } ret 0; }", "cannot take the address of a payload of a `#[packed]` tag")) { ret 16; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() i64 { $each c in $cases(Reply) { if (sel make().[c]) { ret 1; } } ret 0; }\nfun make() Reply { ret Reply.empty{}; }", "`sel` tests a place"))                                                                               { ret 17; }
    ret 0;
}

test case_descriptor__construction_and_foreign_owners {
    # `T.[c]{...}` constructs through the single-case rule; a descriptor from another nominal type or generic instantiation is refused in every position
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { $if (c.has_payload) { ret Reply.[c]{1}; } } ret Reply.empty{}; }"))                                                                                     { ret 1; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { $if (c.has_payload) {} $or { ret Reply.[c]{}; } } ret Reply.empty{}; }"))                                                                               { ret 2; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun build[T](x: T) Box[T] { $each c in $cases(Box[T]) { $if (c.has_payload) { ret Box[T].[c]{x}; } } ret Box[T].none{}; }\nfun g() Box[u32] { ret build[u32](7); }"))                              { ret 3; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\ndef R: Box[u32];\nfun f() R { $each c in $cases(R) { $if (c.has_payload) { ret R.[c]{7}; } } ret R.none{}; }"))                                                                                    { ret 4; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nval g: Reply = Reply.value{42};\nfun f() i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel g.[c]) { ret g.[c]; } } } ret 0; }"))                                                      { ret 6; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { ret Reply.[c]{1}; } ret Reply.empty{}; }", "this tag case takes no payload"))                                                                    { ret 7; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { $if (c.has_payload) { ret Reply.[c]{}; } } ret Reply.empty{}; }", "this tag case requires a payload"))                                           { ret 8; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { $if (c.has_payload) { ret Reply.[c]{1, 2}; } } ret Reply.empty{}; }", "a tag case carries exactly one payload"))                                 { ret 9; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { $if (c.has_payload) { ret Reply.[c]{1u32}; } } ret Reply.empty{}; }", "type mismatch"))                                                          { ret 10; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Other { $each c in $cases(Reply) { $if (c.has_payload) { ret Other.[c]{1}; } } ret Other.empty{}; }", "this case descriptor belongs to `Reply`"))                                   { ret 11; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Box[u64] { $each c in $cases(Box[u32]) { $if (c.has_payload) { ret Box[u64].[c]{1}; } } ret Box[u64].none{}; }", "this case descriptor belongs to `Box[u32]`"))                     { ret 12; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Other) i64 { $each c in $cases(Reply) { if (sel v.[c]) { ret 1; } } ret 0; }", "this case descriptor belongs to `Reply`"))                                                         { ret 13; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Box[u64]) u64 { $each c in $cases(Box[u32]) { if (sel v.[c]) { ret 1; } } ret 0; }", "this case descriptor belongs to `Box[u32]`"))                                                { ret 14; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Other) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.value) { ret v.[c]; } } } ret 0; }", "the instance type does not match the case descriptor's owning tag")) { ret 15; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec P { a: u8; }\nfun f(v: Reply) u8 { $each c in $fields(P) { if (sel v.[c]) { ret 1; } } ret 0; }", "must be a comptime case descriptor"))                                                { ret 16; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec P { a: u8; }\nfun f() Reply { $each c in $fields(P) { ret Reply.[c]{1}; } ret Reply.empty{}; }", "must be a comptime case descriptor"))                                                 { ret 17; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec P { a: u8; }\nfun f(p: P) u8 { $each c in $cases(Reply) { $if (c.has_payload) { ret p.[c]; } } ret 0; }", "the instance type does not match the case descriptor's owning tag"))         { ret 18; }
    ret 0;
}

test offset_of__folds_from_the_checked_layout {
    # `$offset_of(T, payload_case)` and record offsets fold in gates and type positions from the one checked layout
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n$if ($offset_of(Reply, value) == 8) {} $or { $error(\"offset\"); }"))                                                                                                                    { ret 1; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n#[packed] tag Pk: u8 { a; b: u32; }\n$if ($offset_of(Pk, b) == 1) {} $or { $error(\"packed\"); }"))                                                                                      { ret 2; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n$if ($offset_of(Box[u8], some) == 1) {} $or { $error(\"generic\"); }\n$if ($offset_of(Box[u64], some) == 8) {} $or { $error(\"generic\"); }"))                                           { ret 3; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec Pair { a: u8; b: u64; }\n$if ($offset_of(Pair, b) == 8) {} $or { $error(\"record\"); }"))                                                                                            { ret 4; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec Holder { buf: [$offset_of(Reply, value)]u8; }\n$if ($size_of(Holder) == 8) {} $or { $error(\"type position\"); }"))                                                                  { ret 6; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n$if ($size_of(Reply) == 16) {} $or { $error(\"size\"); }\n$if ($align_of(Reply) == 8) {} $or { $error(\"align\"); }\n$if ($size_of(^Reply) == 16) {} $or { $error(\"secret size\"); }")) { ret 7; }
    if (!sema_checked.sema_clean("tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\n$if ($offset_of(res[i64, u32], ok) == 8) {} $or { $error(\"res\"); }\n$if ($offset_of(opt[u8], some) == 1) {} $or { $error(\"opt\"); }"))                                                        { ret 8; }
    if (!sema_checked.sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun of[T]() u64 { ret $offset_of(Box[T], some); }\nfun g() u64 { ret of[u64](); }"))                                                                                                     { ret 9; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { ret $offset_of(Reply, empty); }", "has no payload, so it has no offset"))                                                                                           { ret 10; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n$if ($offset_of(Reply, empty) == 0) {}", "has no payload, so it has no offset"))                                                                                                  { ret 11; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { ret $offset_of(Reply, nope); }", "unknown tag case `nope`"))                                                                                                        { ret 12; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec Pair { a: u8; }\nfun f() u64 { ret $offset_of(Pair, nope); }", "no such field `nope`"))                                                                                       { ret 13; }
    if (!sema_checked.sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { ret $offset_of(Reply, 1); }", "`$offset_of` names its member by a bare identifier"))                                                                                { ret 14; }
    ret 0;
}

