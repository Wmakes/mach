test canonical_tags__specialize_across_modules {
    if (!sema_checked.sema_clean2("use t.lib; use t.lib.res; use t.lib.opt; fun f() res[i64, u32] { val a: opt[i64] = lib.wrap[i64](42); val b: opt[i64] = lib.wrap[i64](7); ret lib.result[i64, u32](42); }", "pub tag res[T, E]: u8 { err: E; ok: T; } pub tag opt[T]: u8 { none; some: T; } pub fun wrap[T](v: T) opt[T] { ret opt[T].some{v}; } pub fun result[T, E](v: T) res[T, E] { ret res[T, E].ok{v}; }")) { ret 1; }
    if (!sema_checked.sema_clean("tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\nfun wrap[T](v: T) opt[T] { ret opt[T].some{v}; } fun f() opt[err[u32]] { ret wrap[err[u32]](err[u32].ok{}); }"))                                                                                                                                                            { ret 2; }
    ret 0;
}

test canonical_tags__are_ordinary_declarations {
    # the compiler knows nothing about these names: a module declares them as std does, or as anything else
    if (!sema_checked.sema_clean("tag res[T, E]: u8 { err: E; ok: T; } val a: res[i64, u32] = res[i64, u32].ok{1};")) { ret 1; }
    if (!sema_checked.sema_clean("tag opt[T]: u8 { none; some: T; }"))                                                { ret 2; }
    if (!sema_checked.sema_clean("rec res { field: i64; }"))                                                          { ret 3; }
    # declaring one twice in a module is the ordinary duplicate definition
    if (!sema_checked.sema_rejects_with("tag res[T, E]: u8 { err: E; ok: T; } tag res[T, E]: u8 { err: E; ok: T; }", "duplicate definition: `res` is already bound in this scope")) { ret 6; }
    ret 0;
}

