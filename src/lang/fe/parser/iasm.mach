use std.types.size.usize;
use std.types.string.str;

use diagnostic_kind: mach.lang.diagnostic.kind;
use ast_id:          mach.lang.fe.ast.id;
use ast_stmt:        mach.lang.fe.ast.stmt;
use mach.lang.fe.parser.state;
use mach.lang.fe.token;
use lang_source: mach.lang.source;

pub fun parse_asm(p: *state.Parser) ast_id.StmtId {
    val start: token.Token = state.advance(p);

    var isa: lang_source.Span;
    isa.offset = 0;
    isa.len    = 0;

    if (state.at(p, token.KIND_IDENT)) {
        isa = state.advance(p).span;
    }
    or {
        state.error_at_current(p, diagnostic_kind.ASM_ISA_MISSING, "expected ISA tag after 'asm'");
    }

    var body: lang_source.Span;
    body.offset = 0;
    body.len    = 0;
    var end_span: lang_source.Span = start.span;

    if (state.at(p, token.KIND_LBRACE)) {
        val lbrace:     token.Token = state.advance(p);
        val body_start: usize       = lbrace.span.offset + lbrace.span.len;
        collect_body(p, body_start, start.span, ?body, ?end_span);
        seek_to_offset(p, end_span.offset + end_span.len);
    }
    or {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_TOKEN, "expected '{' to open inline assembly body");
    }

    var asm_stmt: ast_stmt.StmtAsm;
    asm_stmt.isa  = isa;
    asm_stmt.body = body;

    var node: ast_stmt.Stmt;
    node.span      = state.span_of(start.span, end_span);
    node.kind      = ast_stmt.STMT_KIND_ASM;
    node.data.asm_ = asm_stmt;
    ret state.push_stmt(p, node);
}

fun seek_to_offset(p: *state.Parser, offset: usize) {
    for (p.pos < p.tokens.len && p.tokens.tokens[p.pos].span.offset < offset) {
        p.pos = p.pos + 1;
    }
}

fun collect_body(p: *state.Parser, start_offset: usize, asm_span: lang_source.Span, body: *lang_source.Span, end_span: *lang_source.Span) {
    val src:   str   = p.tokens.source;
    var depth: usize = 1;
    var i:     usize = start_offset;

    for (src[i] != 0) {
        val c: u8 = src[i];
        if (c == '{'::u8) {
            depth = depth + 1;
        }
        or (c == '}'::u8) {
            depth = depth - 1;
            if (depth == 0) {
                body.offset     = start_offset;
                body.len        = i - start_offset;
                end_span.offset = i;
                end_span.len    = 1;
                ret;
            }
        }
        i = i + 1;
    }

    state.error_at(p, diagnostic_kind.ASM_UNTERMINATED, asm_span, "unterminated asm body");
    body.offset     = start_offset;
    body.len        = i - start_offset;
    end_span.offset = i;
    end_span.len    = 0;
}
