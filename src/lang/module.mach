use std.types.bool.bool;
use std.types.char.char;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.intern;

# a module's index in the session's module table
pub rec ModuleId {
    index: u32;
}

pub val MODULE_NIL: ModuleId = ModuleId{index: 0xFFFFFFFF};

# a module's identity across sessions, keyed by its fully qualified name
pub rec StableModuleId {
    index: u32;
}

pub val STABLE_MODULE_NIL: StableModuleId = StableModuleId{index: 0xFFFFFFFF};

# a project numbers its modules from 0 below BUFFER_BASE, and a standalone
# editor buffer's module is BUFFER_BASE past its file's index, so no project
# module takes a buffer's id and a table keyed by module serves both
pub val BUFFER_BASE: u32 = 0x80000000;

# the module of the standalone buffer over the file with index `file`, none
# past the last id the buffer range holds
pub fun buffer_id(file: u32) opt[ModuleId] {
    if (file >= MODULE_NIL.index - BUFFER_BASE) { ret opt[ModuleId].none{}; }
    ret opt[ModuleId].some{id(BUFFER_BASE + file)};
}

# the index of the file whose standalone buffer is the module `m`, none when
# `m` is a project's module or nil
pub fun buffer_file(m: ModuleId) opt[u32] {
    if (m.index < BUFFER_BASE || is_nil(m)) { ret opt[u32].none{}; }
    ret opt[u32].some{m.index - BUFFER_BASE};
}

pub fun id(index: u32) ModuleId {
    var m: ModuleId;
    m.index = index;
    ret m;
}

pub fun index(m: ModuleId) u32 {
    ret m.index;
}

pub fun same(left: ModuleId, right: ModuleId) bool {
    ret left.index == right.index;
}

pub fun is_nil(m: ModuleId) bool {
    ret m.index == MODULE_NIL.index;
}

pub fun stable_id(index: u32) StableModuleId {
    var m: StableModuleId;
    m.index = index;
    ret m;
}

pub fun stable_index(m: StableModuleId) u32 {
    ret m.index;
}

pub fun stable_same(left: StableModuleId, right: StableModuleId) bool {
    ret left.index == right.index;
}

pub fun stable_is_nil(m: StableModuleId) bool {
    ret m.index == STABLE_MODULE_NIL.index;
}

# the module name of a source path under a package: the id, then the path without its suffix, its separators dotted
pub fun compose_fqn(alloc: *A.Allocator, itn: *intern.Interner, id_text: str, rel_text: str) res[intern.StrId, fail.Fail] {
    val rel_stripped: View = strip_mach_suffix(rel_text);

    val id_len: usize             = str_len(id_text);
    val total:  usize             = id_len + 1 + rel_stripped.len;
    val r_buf:  res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel r_buf.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_buf.err)}; }
    val buf: *u8 = r_buf.ok;

    var k: usize = 0;
    var j: usize = 0;
    for (j < id_len) {
        buf[k] = id_text[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[k] = '.';
    k      = k + 1;
    j      = 0;
    for (j < rel_stripped.len) {
        val c: u8 = rel_stripped.data[j];
        if (c == '/' || c == '\\') { buf[k] = '.'; }
        or                         { buf[k] = c; }
        k = k + 1;
        j = j + 1;
    }

    val r: res[intern.StrId, A.Error] = intern.bytes_add(itn, buf::str, k);
    A.deallocate[u8](alloc, buf, total);
    if (sel r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r.ok};
}

fun strip_mach_suffix(s: str) View {
    val suffix: str   = ".mach";
    val s_len:  usize = str_len(s);
    if (!str_ends_with(s, suffix)) { ret view(s::*char, s_len); }
    ret view(s::*char, s_len - str_len(suffix));
}
