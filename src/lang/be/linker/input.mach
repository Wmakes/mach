# the inputs a link reads and the contract of the synthetic ones it appends.
# a synthesizer looks at the inputs so far and either makes one more object
# image or declines, and the link appends what it makes as an ordinary input, so
# resolution and dead-stripping treat it like any other definition
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.growth;
use mach.lang.session;
use lang_target:      mach.lang.target;
use catalog_artifact: mach.lang.target.catalog.artifact;
use target_of:        mach.lang.target.of;

use mach.lang.be.linker.atoms.AtomPlan;
use mach.lang.be.linker.atoms.build_atom_plan;
use mach.lang.be.linker.atoms.free_atom_plan;
use mach.lang.be.linker.atoms.init_atom_plan;
use mach.lang.be.linker.common.total_sections;
use mach.lang.be.linker.gc.LinkRoots;

# the caller's images, borrowed, followed by the synthetic ones the set owns.
# the caller's array is copied only when the first synthetic image is appended
pub rec InputSet {
    images:   *target_of.ObjectImage;
    count:    u32;
    cap:      u32;
    borrowed: u32;
}

# what a synthesizer reads of the link it serves
pub rec LinkContext {
    s:     *session.Session;
    tgt:   *lang_target.Binding;
    mode:  catalog_artifact.Kind;
    roots: *LinkRoots;
    atoms: InputAtoms;
}

# the atom plan of the inputs as they stood when a synthesizer first asked for
# it, with the section bases it was built over
pub rec InputAtoms {
    plan:         AtomPlan;
    sec_base:     *u32;
    module_count: u32;
    built:        bool;
}

# one synthetic input: true with `out` filled when the link needs it, false
# when it does not
pub def Synthesizer: fun(*LinkContext, *InputSet, *target_of.ObjectImage) res[bool, fail.Fail];

pub fun input_set_borrow(images: *target_of.ObjectImage, count: u32) InputSet {
    ret InputSet{images: images, count: count, cap: 0, borrowed: count};
}

# appends `img` to the set, which owns it from then on, and a refusal leaves it the caller's
pub fun input_set_append(alloc: *A.Allocator, set: *InputSet, img: *target_of.ObjectImage) err[fail.Fail] {
    if (set.count == 0xFFFFFFFF) {
        ret err[fail.Fail].err{fail.message("too many input objects to append a synthetic one")};
    }
    if (set.cap == 0) {
        var fresh: *target_of.ObjectImage = nil;
        var cap:   u32                    = 0;
        val grown: err[A.Error]           = growth.reserve[target_of.ObjectImage](alloc, ?fresh, ?cap, set.count::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
        var i: u32 = 0;
        for (i < set.count) {
            fresh[i] = set.images[i];
            i        = i + 1;
        }
        set.images = fresh;
        set.cap    = cap;
    }
    val room: err[A.Error] = growth.reserve[target_of.ObjectImage](alloc, ?set.images, ?set.cap, set.count::usize + 1);
    if (sel room.err) { ret err[fail.Fail].err{fail.refused(room.err)}; }
    set.images[set.count] = @img;
    set.count             = set.count + 1;
    ret err[fail.Fail].ok{};
}

pub fun input_set_dnit(alloc: *A.Allocator, set: *InputSet) {
    var i: u32 = set.borrowed;
    for (i < set.count) {
        target_of.object_image_dnit(?set.images[i]);
        i = i + 1;
    }
    if (set.cap > 0) { A.deallocate[target_of.ObjectImage](alloc, set.images, set.cap::usize); }
    set.images = nil;
    set.count  = 0;
    set.cap    = 0;
}

pub fun link_context(s: *session.Session, tgt: *lang_target.Binding, mode: catalog_artifact.Kind, roots: *LinkRoots) LinkContext {
    var ctx: LinkContext;
    ctx.s     = s;
    ctx.tgt   = tgt;
    ctx.mode  = mode;
    ctx.roots = roots;
    init_atom_plan(?ctx.atoms.plan);
    ctx.atoms.sec_base     = nil;
    ctx.atoms.module_count = 0;
    ctx.atoms.built        = false;
    ret ctx;
}

pub fun link_context_dnit(ctx: *LinkContext) {
    val alloc: *A.Allocator = ctx.s.alloc;
    free_atom_plan(alloc, ?ctx.atoms.plan);
    if (ctx.atoms.sec_base != nil) { A.deallocate[u32](alloc, ctx.atoms.sec_base, ctx.atoms.module_count::usize); }
    ctx.atoms.sec_base     = nil;
    ctx.atoms.module_count = 0;
    ctx.atoms.built        = false;
}

# the atom plan of the inputs so far, built on the first request
pub fun context_atoms(ctx: *LinkContext, inputs: *InputSet) res[*InputAtoms, fail.Fail] {
    if (ctx.atoms.built) { ret res[*InputAtoms, fail.Fail].ok{?ctx.atoms}; }
    if (inputs.count == 0) {
        ret res[*InputAtoms, fail.Fail].err{fail.message("an atom plan needs at least one input")};
    }
    val alloc: *A.Allocator       = ctx.s.alloc;
    val sb_r:  res[*u32, A.Error] = A.zallocate[u32](alloc, inputs.count::usize);
    if (sel sb_r.err) { ret res[*InputAtoms, fail.Fail].err{fail.refused(sb_r.err)}; }
    ctx.atoms.sec_base     = sb_r.ok;
    ctx.atoms.module_count = inputs.count;
    val sec_total_r: res[u32, fail.Fail] = total_sections(inputs.images, inputs.count);
    if (sel sec_total_r.err) { ret res[*InputAtoms, fail.Fail].err{sec_total_r.err}; }
    val built: err[fail.Fail] = build_atom_plan(ctx.s, inputs.images, inputs.count, ctx.atoms.sec_base,
        sec_total_r.ok, true, ctx.roots, ctx.tgt.isa, ?ctx.atoms.plan);
    if (sel built.err) { ret res[*InputAtoms, fail.Fail].err{built.err}; }
    ctx.atoms.built = true;
    ret res[*InputAtoms, fail.Fail].ok{?ctx.atoms};
}

# hands the built atom plan over to the caller, leaving the context without one
pub fun context_take_atoms(ctx: *LinkContext, out: *AtomPlan) bool {
    if (!ctx.atoms.built) { ret false; }
    @out = ctx.atoms.plan;
    init_atom_plan(?ctx.atoms.plan);
    ctx.atoms.built = false;
    ret true;
}
