use mach.lang.be.linker.gc.build_reloc_refs;
use mach.lang.be.linker.gc.collect_dead_atoms;
use mach.lang.be.linker.gc.reloc_ref_lower;

rec AtomDropCountUnit {}

rec AtomDrop {
    section: u32;
    start:   u32;
    end:     u32;
    resume:  u32;
}

rec AtomSection {
    first:    u32;
    count:    u32;
    live_len: u32;
}

pub rec AtomPlan {
    drops:         *AtomDrop;
    drop_count:    u32;
    drop_cap:      u32;
    sections:      *AtomSection;
    section_count: u32;
    removed_bytes: u64;
    active:        bool;
}

rec AtomCandidate {
    module: u32;
    symbol: u32;
}

pub val ATOM_OWNS: u32 = 0xFFFFFFFF;

fun mergeable_atom_eligible(modules: *target_of.ObjectImage, m: u32, sc: u32,
    atoms: *AtomPlan, flat: u32) bool {
    val sec: *target_of.Section = ?modules[m].sections[sc];
    if ((sec.flags & target_of.SEC_FLAG_MERGEABLE) == 0) { ret false; }
    if (!is_loadable_kind(sec.kind))                     { ret false; }
    if (atom_live_len(atoms, flat, sec.len) != sec.len)  { ret false; }
    var ri: u32 = 0;
    for (ri < modules[m].reloc_count) {
        if (target_of.section_index(modules[m].relocations[ri].section) == sc) { ret false; }
        ri = ri + 1;
    }
    ret true;
}

fun mergeable_atoms_match(a: *target_of.Section, b: *target_of.Section) bool {
    if (!intern.str_same(a.name, b.name) || a.kind != b.kind) { ret false; }
    if (a.len != b.len || a.align != b.align)                 { ret false; }
    if (a.len == 0)                                           { ret true; }
    if (a.bytes == nil || b.bytes == nil)                     { ret false; }
    ret memory.raw_equal(a.bytes::ptr, b.bytes::ptr, a.len::usize);
}

pub fun plan_atom_coalescing(alloc: *A.Allocator, modules: *target_of.ObjectImage, module_count: u32,
    sec_base: *u32, sec_total: u32,
    atoms: *AtomPlan) res[*u32, fail.Fail] {
    if (sec_total == 0) { ret res[*u32, fail.Fail].ok{nil}; }
    val ar: res[*u32, A.Error] = A.allocate[u32](alloc, sec_total::usize);
    if (sel ar.err) { ret res[*u32, fail.Fail].err{fail.refused(ar.err)}; }
    val dup: *u32 = ar.ok;
    var i:   u32  = 0;
    for (i < sec_total) {
        dup[i] = ATOM_OWNS;
        i      = i + 1;
    }

    var m: u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val flat: u32 = sec_base[m] + sc;
            if (!mergeable_atom_eligible(modules, m, sc, atoms, flat)) {
                sc = sc + 1;
                cnt;
            }
            val sec: *target_of.Section = ?modules[m].sections[sc];

            var wm: u32 = 0;
            for (wm <= m && dup[flat] == ATOM_OWNS) {
                var wc: u32 = 0;
                for (wc < modules[wm].section_count && dup[flat] == ATOM_OWNS) {
                    val wflat: u32 = sec_base[wm] + wc;
                    if (wflat >= flat) {
                        wc = wc + 1;
                        cnt;
                    }
                    if (dup[wflat] != ATOM_OWNS) {
                        wc = wc + 1;
                        cnt;
                    }
                    if (!mergeable_atom_eligible(modules, wm, wc, atoms, wflat)) {
                        wc = wc + 1;
                        cnt;
                    }
                    if (mergeable_atoms_match(?modules[wm].sections[wc], sec)) { dup[flat] = wflat; }
                    wc = wc + 1;
                }
                wm = wm + 1;
            }
            sc = sc + 1;
        }
        m = m + 1;
    }
    ret res[*u32, fail.Fail].ok{dup};
}

pub fun init_atom_plan(plan: *AtomPlan) {
    plan.drops         = nil;
    plan.drop_count    = 0;
    plan.drop_cap      = 0;
    plan.sections      = nil;
    plan.section_count = 0;
    plan.removed_bytes = 0;
    plan.active        = false;
}

pub fun free_atom_plan(alloc: *A.Allocator, plan: *AtomPlan) {
    if (plan == nil) { ret; }
    if (plan.drops != nil && plan.drop_cap > 0) {
        A.deallocate[AtomDrop](alloc, plan.drops, plan.drop_cap::usize);
    }
    if (plan.sections != nil && plan.section_count > 0) {
        A.deallocate[AtomSection](alloc, plan.sections, plan.section_count::usize);
    }
    init_atom_plan(plan);
}

fun atom_drop_cmp(a: *AtomDrop, b: *AtomDrop) i64 {
    if (a.section < b.section) { ret -1; }
    if (a.section > b.section) { ret 1; }
    if (a.start < b.start)     { ret -1; }
    if (a.start > b.start)     { ret 1; }
    if (a.end < b.end)         { ret -1; }
    if (a.end > b.end)         { ret 1; }
    ret 0;
}

fun atom_resume_offset(dst: u32, end: u32, section_align: u32) u32 {
    if (end <= dst) { ret dst; }
    var a: u32 = section_align;
    if (a == 0) { a = 1; }
    ret dst + (end - dst) % a;
}

fun unreferenced_local(m: *target_of.ObjectImage, sy: u32) bool {
    if (sy >= m.symbol_count) { ret false; }
    val sym: *target_of.Symbol = ?m.symbols[sy];
    if ((sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) != 0) { ret false; }
    if (target_of.section_is_external(sym.section))       { ret false; }
    var ri: u32 = 0;
    for (ri < m.reloc_count) {
        val r: *target_of.Relocation = ?m.relocations[ri];
        if ((r.sym == sy || (target_of.is_difference(r.kind) && r.sym2 == sy))
            && !(target_of.section_index(r.section) < m.section_count && m.sections[target_of.section_index(r.section)].kind == target_of.SK_DEBUG)) {
            ret false;
        }
        ri = ri + 1;
    }
    ret true;
}

fun atom_is_carrier_anchor(m: *target_of.ObjectImage, owner: *target_of.Symbol,
    other: *target_of.Symbol, start: u32, end: u32) bool {
    if (start != 0 || owner.offset != 0)                                                                                            { ret false; }
    if (target_of.section_index(owner.section) >= m.section_count || end != m.sections[target_of.section_index(owner.section)].len) { ret false; }
    if (!target_of.section_same(other.section, owner.section) || other.offset != 0 || other.size != 0)                              { ret false; }
    if (other.flags != 0 || !intern.str_same(other.name, m.sections[target_of.section_index(owner.section)].name))                  { ret false; }
    ret true;
}

fun atom_reloc_crosses_candidate(modules: *target_of.ObjectImage, reference: *AtomRelocRef,
    r: *target_of.Relocation,
    candidate_module: u32, candidate_section: u32,
    start: u32, end: u32) bool {
    val source_module: u32 = reference.source_module;
    val width:         u64 = reference.width::u64;
    if (source_module == candidate_module && target_of.section_index(r.section) == candidate_section
        && r.offset::u64 >= start::u64
        && r.offset::u64 + width <= end::u64) {
        ret false;
    }

    val target_module: u32 = reference.target_module;
    val target_symbol: u32 = reference.target_symbol;

    val target: *target_of.Symbol = ?modules[target_module].symbols[target_symbol];
    if (target_module != candidate_module || target_of.section_index(target.section) != candidate_section) { ret false; }
    if (target.offset > modules[candidate_module].sections[candidate_section].len)                         { ret false; }

    if (target.offset >= start && target.offset < end)    { ret true; }
    if (reference.addend_mode == of_reloc.ADDEND_IGNORED) { ret false; }

    var bias_min: i64 = 0;
    var bias_max: i64 = 0;
    atom_field_bias(r, reference.addend_mode, reference.text_bias_min, reference.text_bias_max,
        target_of.section_index(r.section) < modules[source_module].section_count
        && modules[source_module].sections[target_of.section_index(r.section)].kind == target_of.SK_TEXT,
        ?bias_min, ?bias_max);
    if ((bias_min > 0 && r.addend > 9223372036854775807 - bias_min)
        || (bias_min < 0 && r.addend < (-9223372036854775807 - 1) - bias_min)
        || (bias_max > 0 && r.addend > 9223372036854775807 - bias_max)
        || (bias_max < 0 && r.addend < (-9223372036854775807 - 1) - bias_max)) {
        ret true;
    }

    var effective_min: u32 = 0;
    var effective_max: u32 = 0;
    if (!atom_effective_offset(target.offset, r.addend + bias_min, ?effective_min)
        || !atom_effective_offset(target.offset, r.addend + bias_max, ?effective_max)) {
        ret true;
    }
    if (target.offset < start && effective_max >= start) { ret true; }
    if (target.offset >= end && effective_min < end)     { ret true; }
    ret false;
}

pub fun atom_offset_dead(plan: *AtomPlan, section: u32, off: u32) bool {
    if (plan == nil || !plan.active || section >= plan.section_count) { ret false; }
    val meta: *AtomSection = ?plan.sections[section];
    var i:    u32          = meta.first;
    val end:  u32          = meta.first + meta.count;
    for (i < end) {
        val drop: *AtomDrop = ?plan.drops[i];
        if (off < drop.start) { ret false; }
        if (off < drop.end)   { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun atom_live_offset(plan: *AtomPlan, section: u32, off: u32) u32 {
    if (plan == nil || !plan.active || section >= plan.section_count) { ret off; }
    val meta:       *AtomSection = ?plan.sections[section];
    var src_cursor: u32          = 0;
    var dst_cursor: u32          = 0;
    var i:          u32          = meta.first;
    val end:        u32          = meta.first + meta.count;
    for (i < end) {
        val drop: *AtomDrop = ?plan.drops[i];
        if (off < drop.start) { ret dst_cursor + (off - src_cursor); }
        if (off < drop.end)   { ret drop.resume; }
        src_cursor = drop.end;
        dst_cursor = drop.resume;
        i          = i + 1;
    }
    ret dst_cursor + (off - src_cursor);
}

pub fun atom_live_len(plan: *AtomPlan, section: u32, original_len: u32) u32 {
    if (plan == nil || !plan.active || section >= plan.section_count) { ret original_len; }
    ret plan.sections[section].live_len;
}

pub fun copy_live_section(dst: *u8, src: *u8, src_len: u32, plan: *AtomPlan, section: u32) {
    if (plan == nil || !plan.active || section >= plan.section_count
        || plan.sections[section].count == 0) {
        memory.copy[u8](dst, src, src_len::usize);
        ret;
    }

    val meta:       *AtomSection = ?plan.sections[section];
    var src_cursor: u32          = 0;
    var dst_cursor: u32          = 0;
    var i:          u32          = meta.first;
    val end:        u32          = meta.first + meta.count;
    for (i < end) {
        val drop: *AtomDrop = ?plan.drops[i];
        val n:    u32       = drop.start - src_cursor;
        if (n > 0) {
            memory.copy[u8](?dst[dst_cursor], ?src[src_cursor], n::usize);
            dst_cursor = dst_cursor + n;
        }
        src_cursor = drop.end;
        dst_cursor = drop.resume;
        i          = i + 1;
    }
    if (src_cursor < src_len) {
        memory.copy[u8](?dst[dst_cursor], ?src[src_cursor], (src_len - src_cursor)::usize);
    }
}

# a gap the link opens in a section's live bytes: `len` bytes placed before the
# byte at input offset `offset`, or after the last when offset is the length
pub rec AtomGap {
    section: u32;
    offset:  u32;
    len:     u32;
}

# opens each gap as an empty drop whose resume lies `len` bytes on, so every
# offset at or past it moves with the bytes after it and whatever maps an offset
# through the plan sees the gap. gaps come sorted by section and offset, at live
# offsets, each a multiple of its section's alignment so no drop's padding moves
pub fun atom_plan_open_gaps(alloc: *A.Allocator, modules: *target_of.ObjectImage, module_count: u32,
    sec_total: u32, plan: *AtomPlan, gaps: *AtomGap, gap_count: u32) err[fail.Fail] {
    if (gap_count == 0) { ret err[fail.Fail].ok{}; }
    val old_count: u32 = plan.drop_count;
    if (old_count > 0xFFFFFFFF - gap_count) {
        ret err[fail.Fail].err{fail.message("atom drop count overflow")};
    }
    val cap: u32                     = old_count + gap_count;
    val dr:  res[*AtomDrop, A.Error] = A.allocate[AtomDrop](alloc, cap::usize);
    if (sel dr.err) { ret err[fail.Fail].err{fail.refused(dr.err)}; }
    val drops: *AtomDrop                  = dr.ok;
    val sr:    res[*AtomSection, A.Error] = A.zallocate[AtomSection](alloc, sec_total::usize);
    if (sel sr.err) {
        A.deallocate[AtomDrop](alloc, drops, cap::usize);
        ret err[fail.Fail].err{fail.refused(sr.err)};
    }
    val sections: *AtomSection = sr.ok;

    var n:    u32 = 0;
    var di:   u32 = 0;
    var gi:   u32 = 0;
    var flat: u32 = 0;
    var m:    u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val sec:  *target_of.Section = ?modules[m].sections[sc];
            val meta: *AtomSection       = ?sections[flat];
            meta.first = n;
            var src_cursor: u32 = 0;
            var dst_cursor: u32 = 0;
            for ((di < old_count && plan.drops[di].section == flat)
                || (gi < gap_count && gaps[gi].section == flat)) {
                val drop_here: bool = di < old_count && plan.drops[di].section == flat;
                val gap_here:  bool = gi < gap_count && gaps[gi].section == flat;
                if (gap_here && (!drop_here || gaps[gi].offset <= plan.drops[di].start)) {
                    dst_cursor       = dst_cursor + (gaps[gi].offset - src_cursor) + gaps[gi].len;
                    drops[n].section = flat;
                    drops[n].start   = gaps[gi].offset;
                    drops[n].end     = gaps[gi].offset;
                    drops[n].resume  = dst_cursor;
                    src_cursor       = gaps[gi].offset;
                    gi               = gi + 1;
                }
                or {
                    drops[n]   = plan.drops[di];
                    dst_cursor = dst_cursor + (drops[n].start - src_cursor);
                    if (drops[n].end < sec.len) {
                        dst_cursor = atom_resume_offset(dst_cursor, drops[n].end, sec.align);
                    }
                    drops[n].resume = dst_cursor;
                    src_cursor      = drops[n].end;
                    di              = di + 1;
                }
                n = n + 1;
            }
            meta.count    = n - meta.first;
            meta.live_len = dst_cursor + (sec.len - src_cursor);
            flat          = flat + 1;
            sc            = sc + 1;
        }
        m = m + 1;
    }
    if (n != cap) {
        A.deallocate[AtomDrop](alloc, drops, cap::usize);
        A.deallocate[AtomSection](alloc, sections, sec_total::usize);
        ret err[fail.Fail].err{fail.message("a code gap names no section of the link")};
    }

    if (plan.drops != nil && plan.drop_cap > 0) {
        A.deallocate[AtomDrop](alloc, plan.drops, plan.drop_cap::usize);
    }
    if (plan.sections != nil && plan.section_count > 0) {
        A.deallocate[AtomSection](alloc, plan.sections, plan.section_count::usize);
    }
    plan.drops         = drops;
    plan.drop_count    = n;
    plan.drop_cap      = cap;
    plan.sections      = sections;
    plan.section_count = sec_total;
    plan.active        = true;
    ret err[fail.Fail].ok{};
}

# the atom plan of a final image: losing weak duplicates and every range no
# root reaches become drops
pub fun build_atom_plan(s: *session.Session, modules: *target_of.ObjectImage, module_count: u32,
    sec_base: *u32, sec_total: u32, enabled: bool,
    roots: *LinkRoots, arch: *isa.IsaVTable, plan: *AtomPlan) err[fail.Fail] {
    val fsb_r: err[fail.Fail] = fill_section_bases(modules, module_count, sec_base);
    if (sel fsb_r.err) { ret fsb_r; }
    if (!enabled)      { ret err[fail.Fail].ok{}; }
    if (roots == nil)  { ret err[fail.Fail].err{fail.message("a final image has no roots")}; }

    val symbol_total_r: res[u32, fail.Fail] = total_symbols(modules, module_count);
    if (sel symbol_total_r.err) { ret err[fail.Fail].err{symbol_total_r.err}; }
    val symbol_total: u32 = symbol_total_r.ok;
    var m:            u32 = 0;

    var candidates: *AtomCandidate = nil;
    if (symbol_total > 0) {
        val cr: res[*AtomCandidate, A.Error] =
            A.zallocate[AtomCandidate](s.alloc, symbol_total::usize);
        if (sel cr.err) {
            ret err[fail.Fail].err{fail.refused(cr.err)};
        }
        candidates = cr.ok;
    }
    fin {
        if (candidates != nil) { A.deallocate[AtomCandidate](s.alloc, candidates, symbol_total::usize); }
    }

    var winners: map.Map[intern.StrId, AtomWinner] =
        map.init[intern.StrId, AtomWinner](s.alloc);
    fin { map.dnit[intern.StrId, AtomWinner](?winners); }
    var candidate_count: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (target_of.section_is_external(sym.section) || target_of.section_is_absolute(sym.section)) {
                sy = sy + 1;
                cnt;
            }
            if (target_of.section_index(sym.section) >= modules[m].section_count) {
                ret err[fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_MALFORMED, oor_section_message(s, sym.name, modules[m].name))};
            }
            if ((sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) == 0) {
                sy = sy + 1;
                cnt;
            }

            val weak:     bool             = (sym.flags & target_of.SYM_OBJ_FLAG_WEAK) != 0;
            val existing: opt[*AtomWinner] =
                map.get[intern.StrId, AtomWinner](?winners, ?sym.name);
            if (sel existing.some) {
                val cur: *AtomWinner = existing.some;
                if (weak) {
                    candidates[candidate_count].module = m;
                    candidates[candidate_count].symbol = sy;
                    candidate_count                    = candidate_count + 1;
                    sy                                 = sy + 1;
                    cnt;
                }
                if (!cur.weak) {
                    ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_DUPLICATE_SYMBOL, dup_message(s, sym.name))};
                }
                candidates[candidate_count].module = cur.module;
                candidates[candidate_count].symbol = cur.symbol;
                candidate_count                    = candidate_count + 1;
                cur.module                         = m;
                cur.symbol                         = sy;
                cur.weak                           = false;
                sy                                 = sy + 1;
                cnt;
            }

            var winner: AtomWinner;
            winner.module = m;
            winner.symbol = sy;
            winner.weak   = weak;
            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, AtomWinner](?winners, sym.name, winner);
            if (sel ins.err) {
                ret err[fail.Fail].err{fail.refused(ins.err)};
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    val fw: err[fail.Fail] = add_fallback_winners(modules, module_count, ?winners);
    if (sel fw.err) { ret fw; }

    var ref_total: u32                           = 0;
    val refs_r:    res[*AtomRelocRef, fail.Fail] = build_reloc_refs(s, modules, module_count,
        sec_base, ?winners, arch, ?ref_total);
    if (sel refs_r.err) { ret err[fail.Fail].err{refs_r.err}; }
    val refs: *AtomRelocRef = refs_r.ok;
    fin {
        if (refs != nil) { A.deallocate[AtomRelocRef](s.alloc, refs, ref_total::usize); }
    }

    var dead_count: u32                        = 0;
    val dead_r:     res[*DeadRange, fail.Fail] = collect_dead_atoms(s, modules, module_count,
        sec_base, sec_total, ?winners, refs, ref_total, arch, roots, ?dead_count);
    if (sel dead_r.err) { ret err[fail.Fail].err{dead_r.err}; }
    val dead: *DeadRange = dead_r.ok;
    fin {
        if (dead != nil) { A.deallocate[DeadRange](s.alloc, dead, dead_count::usize); }
    }

    val drop_cap_r: res[u32, lang_checked.Cause] = add_u32_counts[AtomDropCountUnit](candidate_count, dead_count);
    if (sel drop_cap_r.err) { ret err[fail.Fail].err{fail.message("atom drop count exceeds the u32 limit")}; }
    val drop_cap: u32 = drop_cap_r.ok;
    if (drop_cap == 0) { ret err[fail.Fail].ok{}; }
    val dr: res[*AtomDrop, A.Error] = A.zallocate[AtomDrop](s.alloc, drop_cap::usize);
    if (sel dr.err) { ret err[fail.Fail].err{fail.refused(dr.err)}; }
    val drops:      *AtomDrop = dr.ok;
    var drop_count: u32       = 0;

    var ci: u32 = 0;
    for (ci < candidate_count) {
        val cm:   u32                = candidates[ci].module;
        val cy:   u32                = candidates[ci].symbol;
        val sym:  *target_of.Symbol  = ?modules[cm].symbols[cy];
        val sec:  *target_of.Section = ?modules[cm].sections[target_of.section_index(sym.section)];
        val need: u32                = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_WEAK | target_of.SYM_OBJ_FLAG_FUNCTION;
        if ((sym.flags & need) != need || sec.kind != target_of.SK_TEXT || sec.bytes == nil
            || sym.offset >= sec.len) {
            ci = ci + 1;
            cnt;
        }

        val start: u32 = sym.offset;
        var end:   u32 = 0;
        if (sym.size > 0) {
            val sized_end: u64 = start::u64 + sym.size::u64;
            if (sized_end > sec.len::u64) {
                ci = ci + 1;
                cnt;
            }
            end = sized_end::u32;
        }
        or {
            end = sec.len;
            var nsy: u32 = 0;
            for (nsy < modules[cm].symbol_count) {
                val other: *target_of.Symbol = ?modules[cm].symbols[nsy];
                if (target_of.section_same(other.section, sym.section)
                    && (other.flags & (target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION))
                    == (target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FUNCTION)
                    && other.offset > start && other.offset < end) {
                    end = other.offset;
                }
                nsy = nsy + 1;
            }
        }
        if (end <= start) {
            ci = ci + 1;
            cnt;
        }

        var safe: bool = true;
        var sy:   u32  = 0;
        for (sy < modules[cm].symbol_count) {
            if (sy != cy) {
                val other: *target_of.Symbol = ?modules[cm].symbols[sy];
                if (target_of.section_same(other.section, sym.section)
                    && !atom_is_carrier_anchor(?modules[cm], sym, other, start, end)
                    && !unreferenced_local(?modules[cm], sy)) {
                    if (other.offset >= start && other.offset < end) { safe = false; }
                    if (other.size > 0) {
                        val other_end: u64 = other.offset::u64 + other.size::u64;
                        if (other.offset < end && other_end > start::u64) {
                            safe = false;
                        }
                    }
                }
            }
            sy = sy + 1;
        }

        var ri: u32 = 0;
        for (safe && ri < modules[cm].reloc_count) {
            val r: *target_of.Relocation = ?modules[cm].relocations[ri];
            if (target_of.section_same(r.section, sym.section)) {
                val safety_traits: res[of_reloc.RelocTraits, of_reloc.RelocError] = atom_reloc_traits(
                    r, ?modules[cm].sections[target_of.section_index(r.section)], arch, modules[cm].codegen);
                if (sel safety_traits.err) {
                    safe = false;
                }
                if (sel safety_traits.ok) {
                    val rstart: u64 = r.offset::u64;
                    val rend:   u64 = rstart
                        + safety_traits.ok.field_width::u64;
                    if (rstart < end::u64 && rend > start::u64
                        && (rstart < start::u64 || rend > end::u64)) {
                        safe = false;
                    }
                }
            }
            ri = ri + 1;
        }

        val candidate_flat: u32 = sec_base[cm] + target_of.section_index(sym.section);
        var ref_i:          u32 = reloc_ref_lower(refs, ref_total, candidate_flat);
        for (safe && ref_i < ref_total
            && refs[ref_i].target_section == candidate_flat) {
            val rm: u32 = refs[ref_i].source_module;
            val rx: u32 = refs[ref_i].reloc;
            if (atom_reloc_crosses_candidate(modules, ?refs[ref_i],
                ?modules[rm].relocations[rx], cm, target_of.section_index(sym.section), start, end)) {
                safe = false;
            }
            ref_i = ref_i + 1;
        }
        if (safe) {
            drops[drop_count].section = sec_base[cm] + target_of.section_index(sym.section);
            drops[drop_count].start   = start;
            drops[drop_count].end     = end;
            drops[drop_count].resume  = 0;
            drop_count                = drop_count + 1;
        }
        ci = ci + 1;
    }

    var di: u32 = 0;
    for (di < dead_count) {
        drops[drop_count].section = dead[di].section;
        drops[drop_count].start   = dead[di].start;
        drops[drop_count].end     = dead[di].end;
        drops[drop_count].resume  = 0;
        drop_count                = drop_count + 1;
        di                        = di + 1;
    }

    if (drop_count == 0) {
        A.deallocate[AtomDrop](s.alloc, drops, drop_cap::usize);
        ret err[fail.Fail].ok{};
    }

    sort.sort_by[AtomDrop](drops, drop_count::usize, atom_drop_cmp);

    var merged_count: u32 = 0;
    di = 0;
    for (di < drop_count) {
        if (merged_count > 0
            && drops[merged_count - 1].section == drops[di].section
            && drops[di].start <= drops[merged_count - 1].end) {
            if (drops[di].end > drops[merged_count - 1].end) {
                drops[merged_count - 1].end = drops[di].end;
            }
        }
        or {
            drops[merged_count] = drops[di];
            merged_count        = merged_count + 1;
        }
        di = di + 1;
    }

    val sr: res[*AtomSection, A.Error] =
        A.zallocate[AtomSection](s.alloc, sec_total::usize);
    if (sel sr.err) {
        A.deallocate[AtomDrop](s.alloc, drops, drop_cap::usize);
        ret err[fail.Fail].err{fail.refused(sr.err)};
    }
    val sections: *AtomSection = sr.ok;

    di = 0;
    var flat: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val sec:  *target_of.Section = ?modules[m].sections[sc];
            val meta: *AtomSection       = ?sections[flat];
            meta.first = di;
            var src_cursor: u32 = 0;
            var dst_cursor: u32 = 0;
            for (di < merged_count && drops[di].section == flat) {
                dst_cursor = dst_cursor + (drops[di].start - src_cursor);
                if (drops[di].end < sec.len) {
                    dst_cursor =
                        atom_resume_offset(dst_cursor, drops[di].end, sec.align);
                }
                drops[di].resume = dst_cursor;
                src_cursor       = drops[di].end;
                di               = di + 1;
            }
            meta.count    = di - meta.first;
            meta.live_len = dst_cursor + (sec.len - src_cursor);
            flat          = flat + 1;
            sc            = sc + 1;
        }
        m = m + 1;
    }

    plan.drops         = drops;
    plan.drop_count    = merged_count;
    plan.drop_cap      = drop_cap;
    plan.sections      = sections;
    plan.section_count = sec_total;
    plan.removed_bytes = 0;
    flat               = 0;
    m                  = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            plan.removed_bytes = plan.removed_bytes
                + (modules[m].sections[sc].len - sections[flat].live_len)::u64;
            flat = flat + 1;
            sc   = sc + 1;
        }
        m = m + 1;
    }
    plan.active = true;
    ret err[fail.Fail].ok{};
}

pub fun symbol_is_defined(modules: *target_of.ObjectImage, m: u32, sy: u32) bool {
    val sym: *target_of.Symbol = ?modules[m].symbols[sy];
    ret !target_of.section_is_external(sym.section) && target_of.section_index(sym.section) < modules[m].section_count;
}

# whether the bytes a reference to definition sy of module m plus addend
# addresses were dropped from the image
pub fun definition_ref_is_dead(modules: *target_of.ObjectImage, m: u32, sy: u32,
    addend: i64, sec_base: *u32, atoms: *AtomPlan) bool {
    if (sy == target_of.SYMBOL_NONE || !symbol_is_defined(modules, m, sy)) { ret false; }
    val sym: *target_of.Symbol = ?modules[m].symbols[sy];
    val eff: i64               = sym.offset::i64 + addend;
    if (eff < 0 || eff > 0xFFFFFFFF) { ret false; }
    ret atom_offset_dead(atoms, sec_base[m] + target_of.section_index(sym.section), eff::u32);
}

pub fun reloc_source_live(modules: *target_of.ObjectImage, m: u32, r: *target_of.Relocation,
    sec_base: *u32, atoms: *AtomPlan) bool {
    if (atoms == nil || !atoms.active)                                  { ret true; }
    if (target_of.section_index(r.section) >= modules[m].section_count) { ret true; }
    ret !atom_offset_dead(atoms, sec_base[m] + target_of.section_index(r.section), r.offset);
}

# whether a live relocation still names symbol_name; a reference from debug
# information describes code rather than needing the symbol, so it never
# counts, except an unwind entry's personality, which the unwinder calls
pub fun import_symbol_live(modules: *target_of.ObjectImage, module_count: u32,
    symbol_name: intern.StrId, sec_base: *u32,
    atoms: *AtomPlan) bool {
    if (atoms == nil || !atoms.active) { ret true; }
    var saw: bool = false;
    if (live_reference(modules, module_count, symbol_name, sec_base, atoms, ?saw)) { ret true; }
    ret !saw;
}

# whether a live relocation names symbol_name, a name nothing relocates
# counting as unreferenced
pub fun symbol_reference_live(modules: *target_of.ObjectImage, module_count: u32,
    symbol_name: intern.StrId, sec_base: *u32,
    atoms: *AtomPlan) bool {
    var saw: bool = false;
    ret live_reference(modules, module_count, symbol_name, sec_base, atoms, ?saw);
}

fun live_reference(modules: *target_of.ObjectImage, module_count: u32,
    symbol_name: intern.StrId, sec_base: *u32,
    atoms: *AtomPlan, saw: *bool) bool {
    var m: u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *target_of.Relocation = ?modules[m].relocations[ri];
            if (intern.str_same(target_of.reloc_symbol_name(?modules[m], r), symbol_name)) {
                @saw = true;
                val from_debug: bool = target_of.section_index(r.section) < modules[m].section_count
                    && modules[m].sections[target_of.section_index(r.section)].kind == target_of.SK_DEBUG
                    && !is_personality_reloc(?modules[m], r);
                if (!from_debug && reloc_source_live(modules, m, r, sec_base, atoms)) { ret true; }
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    ret false;
}

pub fun has_function_branch_reloc(modules: *target_of.ObjectImage, module_count: u32,
    symbol_name: intern.StrId, sec_base: *u32,
    atoms: *AtomPlan) bool {
    var m: u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *target_of.Relocation = ?modules[m].relocations[ri];
            if (intern.str_same(target_of.reloc_symbol_name(?modules[m], r), symbol_name) && is_function_branch_kind(r.kind)
                && reloc_source_live(modules, m, r, sec_base, atoms)) {
                ret true;
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    ret false;
}

# a live relocation loads the symbol's address from a GOT slot, or names it as
# an unwind entry's personality, which the image reaches through one
pub fun has_got_reloc(modules: *target_of.ObjectImage, module_count: u32,
    symbol_name: intern.StrId, sec_base: *u32,
    atoms: *AtomPlan) bool {
    var m: u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *target_of.Relocation = ?modules[m].relocations[ri];
            if (intern.str_same(target_of.reloc_symbol_name(?modules[m], r), symbol_name)
                && (is_got_kind(r.kind) || is_personality_reloc(?modules[m], r))
                && reloc_source_live(modules, m, r, sec_base, atoms)) {
                ret true;
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    ret false;
}
