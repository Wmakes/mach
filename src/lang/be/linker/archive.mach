use std.collections.map;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs: std.filesystem;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.StrError;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_join;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.growth;
use mach.lang.intern;
use mach.lang.session;
use lang_target: mach.lang.target;
use target_of:   mach.lang.target.of;
use mach.lang.target.of.ar;

use mach.lang.be.linker.resolve.is_undefined_extern;
use mach.lang.be.linker.resolve.weak_fallback_name;

rec ArchiveResolution {
    providers:  map.Map[intern.StrId, u32];
    unresolved: map.Map[intern.StrId, u32];
}

pub fun validate_link_inputs(images: *target_of.ObjectImage, count: u32) err[fail.Fail] {
    if (count > 0 && images == nil) {
        ret err[fail.Fail].err{fail.message("nil input object collection")};
    }
    var i: u32 = 0;
    for (i < count) {
        val valid: err[fail.Fail] = target_of.validate_object_view(?images[i]);
        if (sel valid.err) {
            ret valid;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# each input carries its origin: an object mach wrote, or the user's input,
# whose relocations are theirs and whose defects are the input's
pub fun read_objects(s: *session.Session, tgt: *lang_target.Binding, inputs: *target_of.ObjectInput,
    input_count: u32, seed: *target_of.ObjectImage, seed_count: u32,
    required: intern.StrId,
    module_count: *u32) res[*target_of.ObjectImage, fail.Fail] {
    @module_count = 0;
    if (tgt.of.parse_object == nil) {
        ret res[*target_of.ObjectImage, fail.Fail].err{fail.message("object format has no parser")};
    }
    val seed_valid: err[fail.Fail] = validate_link_inputs(seed, seed_count);
    if (sel seed_valid.err) {
        ret res[*target_of.ObjectImage, fail.Fail].err{seed_valid.err};
    }
    val alloc: *A.Allocator = s.alloc;

    var modules: *target_of.ObjectImage = nil;
    var count:   u32                    = 0;
    var cap:     u32                    = 0;

    var state: ArchiveResolution;
    init_archive_resolution(alloc, ?state);
    if (!intern.str_is_nil(required)) {
        val rr: err[fail.Fail] = archive_require(?state, required);
        if (sel rr.err) {
            free_archive_resolution(?state);
            ret res[*target_of.ObjectImage, fail.Fail].err{rr.err};
        }
    }
    var si: u32 = 0;
    for (si < seed_count) {
        val nr: err[fail.Fail] = archive_note_image(
            s, tgt.of.import_address_prefix, ?state, ?seed[si]);
        if (sel nr.err) {
            free_archive_resolution(?state);
            ret res[*target_of.ObjectImage, fail.Fail].err{nr.err};
        }
        si = si + 1;
    }

    var i: u32 = 0;
    for (i < input_count) {
        if (inputs[i].path == nil) {
            free_archive_resolution(?state);
            free_modules_to(alloc, modules, count, cap);
            ret res[*target_of.ObjectImage, fail.Fail].err{fail.message("nil object path")};
        }

        val path:   str                   = inputs[i].path::str;
        val origin: target_of.RelocOrigin = inputs[i].origin;

        val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
        if (sel rb.err) {
            free_archive_resolution(?state);
            free_modules_to(alloc, modules, count, cap);
            val refused: fail.Fail           = fail.fs_environment(diagnostic_kind.FS_READ, rb.err);
            val why:     res[str, fail.Fail] = read_message(s, path, fail.describe(refused));
            if (sel why.err) { ret res[*target_of.ObjectImage, fail.Fail].err{why.err}; }
            ret res[*target_of.ObjectImage, fail.Fail].err{fail.with_text(refused, why.ok)};
        }
        var buf: Vector[u8] = rb.ok;

        var input_r: err[fail.Fail];
        if (ar.is_archive(buf.data, buf.len)) {
            input_r = parse_archive(s, tgt, path, buf.data, buf.len, origin,
                ?state, ?modules, ?count, ?cap);
        }
        or {
            val loose: err[fail.Fail] = parse_loose(alloc, ?s.interner, tgt, path, buf.data, buf.len, origin, ?modules, ?count, ?cap);
            input_r = loose;
            if (sel loose.ok) {
                val accepted: *target_of.ObjectImage = modules;
                input_r = archive_note_image(
                    s, tgt.of.import_address_prefix, ?state, ?accepted[count - 1]);
            }
        }

        collections_vector.dnit[u8](?buf);
        if (sel input_r.err) {
            free_archive_resolution(?state);
            free_modules_to(alloc, modules, count, cap);
            # an object mach wrote that does not read back is mach's defect
            if (origin == target_of.RELOC_CODEGEN) { ret res[*target_of.ObjectImage, fail.Fail].err{fail.as_internal(input_r.err)}; }
            ret res[*target_of.ObjectImage, fail.Fail].err{input_r.err};
        }

        i = i + 1;
    }

    if (cap > count) {
        val fitted: err[A.Error] = growth.resize[target_of.ObjectImage](alloc, ?modules, ?cap, count::usize);
        if (sel fitted.err) {
            free_archive_resolution(?state);
            free_modules_to(alloc, modules, count, cap);
            ret res[*target_of.ObjectImage, fail.Fail].err{fail.refused(fitted.err)};
        }
    }

    free_archive_resolution(?state);
    @module_count = count;
    ret res[*target_of.ObjectImage, fail.Fail].ok{modules};
}

fun init_archive_resolution(alloc: *A.Allocator, state: *ArchiveResolution) {
    state.providers  = map.init[intern.StrId, u32](alloc);
    state.unresolved = map.init[intern.StrId, u32](alloc);
}

fun free_archive_resolution(state: *ArchiveResolution) {
    map.dnit[intern.StrId, u32](?state.providers);
    map.dnit[intern.StrId, u32](?state.unresolved);
}

fun archive_require(state: *ArchiveResolution,
    name: intern.StrId) err[fail.Fail] {
    if (map.contains[intern.StrId, u32](?state.providers, ?name)) {
        ret err[fail.Fail].ok{};
    }
    val inserted: res[bool, A.Error] = map.insert[intern.StrId, u32](?state.unresolved, name, 1);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

fun archive_symbol_provides(img: *target_of.ObjectImage, sym: *target_of.Symbol) bool {
    if ((sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret false; }
    if (target_of.section_is_external(sym.section)) {
        ret (sym.flags & (target_of.SYM_OBJ_FLAG_FALLBACK | target_of.SYM_OBJ_FLAG_ALIAS))
            == (target_of.SYM_OBJ_FLAG_FALLBACK | target_of.SYM_OBJ_FLAG_ALIAS);
    }
    if (target_of.section_index(sym.section) < img.section_count
        && img.sections[target_of.section_index(sym.section)].kind == target_of.SK_DEBUG) { ret false; }
    ret true;
}

fun archive_import_alias(s: *session.Session, prefix: str,
    symbol: intern.StrId) res[intern.StrId, fail.Fail] {
    if (str_empty(prefix)) { ret res[intern.StrId, fail.Fail].ok{symbol}; }
    val no: opt[str] = intern.get(?s.interner, symbol);
    if (sel no.none) { ret res[intern.StrId, fail.Fail].err{fail.message("import name not interned")}; }
    val name: str = no.some;
    if (str_starts_with(name, prefix)) { ret res[intern.StrId, fail.Fail].ok{symbol}; }
    val jr: res[str, StrError] = str_join(s.alloc, prefix, name);
    if (sel jr.err) { ret res[intern.StrId, fail.Fail].err{fail.str_refused(jr.err)}; }
    val joined: str                        = jr.ok;
    val ir:     res[intern.StrId, A.Error] = intern.add(?s.interner, joined);
    str_free(s.alloc, joined);
    if (sel ir.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(ir.err)}; }
    ret res[intern.StrId, fail.Fail].ok{ir.ok};
}

fun archive_note_provider(state: *ArchiveResolution,
    name: intern.StrId) err[fail.Fail] {
    val ir: res[bool, A.Error] =
        map.insert[intern.StrId, u32](?state.providers, name, 1);
    if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }
    map.remove[intern.StrId, u32](?state.unresolved, ?name);
    ret err[fail.Fail].ok{};
}

fun archive_note_image(s: *session.Session, import_address_prefix: str,
    state: *ArchiveResolution,
    img: *target_of.ObjectImage) err[fail.Fail] {
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val sym: *target_of.Symbol = ?img.symbols[i];
        if (archive_symbol_provides(img, sym)) {
            val nr: err[fail.Fail] = archive_note_provider(state, sym.name);
            if (sel nr.err) { ret nr; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < img.import_count) {
        val nr: err[fail.Fail] = archive_note_provider(state, img.imports[i].symbol);
        if (sel nr.err) { ret nr; }
        val ar: res[intern.StrId, fail.Fail] =
            archive_import_alias(s, import_address_prefix, img.imports[i].symbol);
        if (sel ar.err) {
            ret err[fail.Fail].err{ar.err};
        }
        val an: err[fail.Fail] =
            archive_note_provider(state, ar.ok);
        if (sel an.err) { ret an; }
        i = i + 1;
    }
    i = 0;
    for (i < img.symbol_count) {
        val sym: *target_of.Symbol = ?img.symbols[i];
        if (!is_undefined_extern(sym)) {
            i = i + 1;
            cnt;
        }
        if ((sym.flags & target_of.SYM_OBJ_FLAG_FALLBACK) != 0) {
            val fr: res[intern.StrId, fail.Fail] = weak_fallback_name(img, sym);
            if (sel fr.err) {
                ret err[fail.Fail].err{fr.err};
            }
            val rr: err[fail.Fail] =
                archive_require(state, fr.ok);
            if (sel rr.err) { ret rr; }
            if ((sym.flags & target_of.SYM_OBJ_FLAG_SEARCH) != 0) {
                val sr: err[fail.Fail] = archive_require(state, sym.name);
                if (sel sr.err) { ret sr; }
            }
        }
        or ((sym.flags & target_of.SYM_OBJ_FLAG_WEAK) == 0) {
            val ur: err[fail.Fail] = archive_require(state, sym.name);
            if (sel ur.err) { ret ur; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun archive_image_needed(s: *session.Session, import_address_prefix: str,
    state: *ArchiveResolution,
    img: *target_of.ObjectImage) res[bool, fail.Fail] {
    var i: u32 = 0;
    for (i < img.symbol_count) {
        val sym: *target_of.Symbol = ?img.symbols[i];
        if (archive_symbol_provides(img, sym)
            && map.contains[intern.StrId, u32](?state.unresolved, ?sym.name)) {
            ret res[bool, fail.Fail].ok{true};
        }
        i = i + 1;
    }
    i = 0;
    for (i < img.import_count) {
        if (map.contains[intern.StrId, u32](?state.unresolved, ?img.imports[i].symbol)) {
            ret res[bool, fail.Fail].ok{true};
        }
        val ar: res[intern.StrId, fail.Fail] =
            archive_import_alias(s, import_address_prefix, img.imports[i].symbol);
        if (sel ar.err) {
            ret res[bool, fail.Fail].err{ar.err};
        }
        val alias: intern.StrId = ar.ok;
        if (map.contains[intern.StrId, u32](?state.unresolved, ?alias)) {
            ret res[bool, fail.Fail].ok{true};
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

# append an empty image to the module table and return its index
fun module_add(alloc: *A.Allocator, modules: **target_of.ObjectImage, count: *u32, cap: *u32) res[u32, fail.Fail] {
    val old:   u32          = @count;
    val grown: err[A.Error] = growth.reserve[target_of.ObjectImage](alloc, modules, cap, old::usize + 1);
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }

    val arr:  *target_of.ObjectImage = @modules;
    val slot: *target_of.ObjectImage = ?arr[old];
    @slot = target_of.object_image_init(alloc, nil, intern.STR_NIL);

    @count = old + 1;
    ret res[u32, fail.Fail].ok{old};
}

fun parse_loose(alloc: *A.Allocator, itn: *intern.Interner, tgt: *lang_target.Binding,
    path: str, buf: *u8, buf_len: usize, origin: target_of.RelocOrigin,
    modules: **target_of.ObjectImage, count: *u32, cap: *u32) err[fail.Fail] {
    val gr: res[u32, fail.Fail] = module_add(alloc, modules, count, cap);
    if (sel gr.err) { ret err[fail.Fail].err{gr.err}; }
    val ix:  u32                    = gr.ok;
    val arr: *target_of.ObjectImage = @modules;
    val pr:  err[fail.Fail]         = tgt.of.parse_object(alloc, itn, buf, buf_len, ?arr[ix]);
    if (sel pr.err) { ret pr; }
    target_of.set_relocation_origin(?arr[ix], origin);
    val nr: res[intern.StrId, A.Error] = intern.add(itn, path);
    if (sel nr.ok) { arr[ix].name = nr.ok; }
    ret err[fail.Fail].ok{};
}

fun parse_archive(s: *session.Session, tgt: *lang_target.Binding, path: str, buf: *u8, buf_len: usize,
    origin: target_of.RelocOrigin, state: *ArchiveResolution, modules: **target_of.ObjectImage,
    count: *u32, cap: *u32) err[fail.Fail] {
    val alloc:           *A.Allocator           = s.alloc;
    var candidates:      *target_of.ObjectImage = nil;
    var candidate_count: u32                    = 0;
    var candidate_cap:   u32                    = 0;
    var pos:             usize                  = ar.first_member();
    for (true) {
        val st: ar.Step = ar.next_member(buf, buf_len, pos);
        if (!st.ok) {
            free_modules_to(alloc, candidates, candidate_count, candidate_cap);
            ret err[fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_MALFORMED, read_message(s, path, "malformed archive member header"))};
        }
        if (st.done) { brk; }

        if (!ar.is_special(st.member)) {
            val gr: res[u32, fail.Fail] =
                module_add(alloc, ?candidates, ?candidate_count, ?candidate_cap);
            if (sel gr.err) {
                free_modules_to(alloc, candidates, candidate_count, candidate_cap);
                ret err[fail.Fail].err{gr.err};
            }
            val ix: u32            = gr.ok;
            val pr: err[fail.Fail] =
                tgt.of.parse_object(alloc, ?s.interner, st.member.data, st.member.len,
                ?candidates[ix]);
            if (sel pr.err) {
                free_modules_to(alloc, candidates, candidate_count, candidate_cap);
                ret pr;
            }
            target_of.set_relocation_origin(?candidates[ix], origin);
        }

        pos = st.next;
    }

    if (candidate_count == 0) {
        free_modules_to(alloc, candidates, candidate_count, candidate_cap);
        ret err[fail.Fail].ok{};
    }
    val sr: res[*bool, A.Error] = A.zallocate[bool](alloc, candidate_count::usize);
    if (sel sr.err) {
        free_modules_to(alloc, candidates, candidate_count, candidate_cap);
        ret err[fail.Fail].err{fail.refused(sr.err)};
    }
    val selected: *bool = sr.ok;

    var progress: bool = true;
    for (progress) {
        progress = false;
        var i: u32 = 0;
        for (i < candidate_count) {
            if (selected[i]) {
                i = i + 1;
                cnt;
            }
            val needed_r: res[bool, fail.Fail] =
                archive_image_needed(
                s, tgt.of.import_address_prefix, state, ?candidates[i]);
            if (sel needed_r.err) {
                free_archive_candidates(alloc, candidates, candidate_count,
                    candidate_cap, selected);
                ret err[fail.Fail].err{needed_r.err};
            }
            if (!needed_r.ok) {
                i = i + 1;
                cnt;
            }

            val gr: res[u32, fail.Fail] = module_add(alloc, modules, count, cap);
            if (sel gr.err) {
                free_archive_candidates(alloc, candidates, candidate_count,
                    candidate_cap, selected);
                ret err[fail.Fail].err{gr.err};
            }
            val dst:      u32                    = gr.ok;
            val accepted: *target_of.ObjectImage = @modules;
            accepted[dst] = candidates[i];
            selected[i]   = true;
            val nr: err[fail.Fail] = archive_note_image(
                s, tgt.of.import_address_prefix, state, ?accepted[dst]);
            if (sel nr.err) {
                free_archive_candidates(alloc, candidates, candidate_count,
                    candidate_cap, selected);
                ret nr;
            }
            progress = true;
            i        = i + 1;
        }
    }

    free_archive_candidates(alloc, candidates, candidate_count,
        candidate_cap, selected);
    ret err[fail.Fail].ok{};
}

fun free_archive_candidates(alloc: *A.Allocator, candidates: *target_of.ObjectImage,
    count: u32, cap: u32, selected: *bool) {
    var i: u32 = 0;
    for (i < count) {
        if (!selected[i]) { target_of.object_image_dnit(?candidates[i]); }
        i = i + 1;
    }
    A.deallocate[bool](alloc, selected, count::usize);
    A.deallocate[target_of.ObjectImage](alloc, candidates, cap::usize);
}

fun read_message(s: *session.Session, path: str, reason: str) res[str, fail.Fail] {
    ret fail.format_intern(?s.interner, s.alloc, "cannot read object '{}': {}", path, reason);
}

pub fun free_modules(alloc: *A.Allocator, modules: *target_of.ObjectImage, module_count: u32) {
    free_modules_to(alloc, modules, module_count, module_count);
}

fun free_modules_to(alloc: *A.Allocator, modules: *target_of.ObjectImage, n: u32, cap: u32) {
    if (modules == nil) { ret; }
    var i: u32 = 0;
    for (i < n) {
        target_of.object_image_dnit(?modules[i]);
        i = i + 1;
    }
    if (cap > 0) {
        A.deallocate[target_of.ObjectImage](alloc, modules, cap::usize);
    }
}
