use mach.lang.fail;
use mach.lang.intern;
use target_of: mach.lang.target.of;
use A:         std.allocator;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

pub fun combine(alloc: *A.Allocator, itn: *intern.Interner,
    inputs: *target_of.ObjectImage, count: u32, machine_flags: u32,
    attributes: *u8, attributes_len: u32) res[target_of.ObjectImage, fail.Fail] {
    if (alloc == nil || itn == nil || inputs == nil || count == 0
        || (attributes_len != 0 && attributes == nil)) {
        ret res[target_of.ObjectImage, fail.Fail].err{fail.message("relocatable: incomplete input ownership")};
    }
    var sections:    u32 = 0;
    var symbols:     u32 = 0;
    var relocations: u32 = 0;
    var frames:      u32 = 0;
    var imports:     u32 = 0;
    var indirects:   u32 = 0;
    var requests:    u32 = 0;
    var i:           u32 = 0;
    for (i < count) {
        val input: *target_of.ObjectImage = ?inputs[i];
        val valid: err[fail.Fail]         = target_of.validate_object_view(input);
        if (sel valid.err)         { ret res[target_of.ObjectImage, fail.Fail].err{valid.err}; }
        if (input.interner != itn) { ret res[target_of.ObjectImage, fail.Fail].err{fail.message("relocatable: input names have a different owner")}; }
        if (input.section_count > 0xFFFFFFFF - sections
            || input.symbol_count > 0xFFFFFFFF - symbols
            || input.reloc_count > 0xFFFFFFFF - relocations
            || input.frame_count > 0xFFFFFFFF - frames
            || input.import_count > 0xFFFFFFFF - imports
            || input.indirect_count > 0xFFFFFFFF - indirects
            || input.export_request_count > 0xFFFFFFFF - requests) {
            ret res[target_of.ObjectImage, fail.Fail].err{fail.message("relocatable: combined table exceeds its index range")};
        }
        sections    = sections + input.section_count;
        symbols     = symbols + input.symbol_count;
        relocations = relocations + input.reloc_count;
        frames      = frames + input.frame_count;
        imports     = imports + input.import_count;
        indirects   = indirects + input.indirect_count;
        requests    = requests + input.export_request_count;
        i           = i + 1;
    }
    var output:   target_of.ObjectImage = target_of.object_image_init(alloc, itn, inputs[0].name);
    var complete: bool                  = false;
    # the combination is a codegen image when every input is one, and its
    # symbols bound atoms when every input's do
    output.codegen      = true;
    output.symbol_atoms = true;
    i                   = 0;
    for (i < count) {
        if (!inputs[i].codegen)                            { output.codegen = false; }
        if (!inputs[i].codegen && !inputs[i].symbol_atoms) { output.symbol_atoms = false; }
        i = i + 1;
    }
    fin {
        if (!complete) { target_of.object_image_dnit(?output); }
    }
    if (sections > 0) {
        val storage: res[*target_of.Section, A.Error] = A.allocate[target_of.Section](alloc, sections::usize);
        if (sel storage.err) { ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(storage.err)}; }
        output.sections    = storage.ok;
        output.section_cap = sections;
    }
    if (symbols > 0) {
        val storage: res[*target_of.Symbol, A.Error] = A.allocate[target_of.Symbol](alloc, symbols::usize);
        if (sel storage.err) { ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(storage.err)}; }
        output.symbols    = storage.ok;
        output.symbol_cap = symbols;
    }
    if (relocations > 0) {
        val storage: res[*target_of.Relocation, A.Error] = A.allocate[target_of.Relocation](alloc, relocations::usize);
        if (sel storage.err) { ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(storage.err)}; }
        output.relocations = storage.ok;
        output.reloc_cap   = relocations;
    }
    if (frames > 0) {
        val storage: res[*target_of.FrameUnwind, A.Error] = A.allocate[target_of.FrameUnwind](alloc, frames::usize);
        if (sel storage.err) { ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(storage.err)}; }
        output.frames    = storage.ok;
        output.frame_cap = frames;
    }
    if (imports > 0) {
        val storage: res[*target_of.ImportDecl, A.Error] = A.allocate[target_of.ImportDecl](alloc, imports::usize);
        if (sel storage.err) { ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(storage.err)}; }
        output.imports    = storage.ok;
        output.import_cap = imports;
    }
    if (indirects > 0) {
        val storage: res[*target_of.NativeIndirect, A.Error] = A.allocate[target_of.NativeIndirect](alloc, indirects::usize);
        if (sel storage.err) { ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(storage.err)}; }
        output.indirects    = storage.ok;
        output.indirect_cap = indirects;
    }
    if (requests > 0) {
        val storage: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, requests::usize);
        if (sel storage.err) { ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(storage.err)}; }
        output.export_requests    = storage.ok;
        output.export_request_cap = requests;
    }
    if (attributes_len > 0) {
        val storage: res[*u8, A.Error] = A.allocate[u8](alloc, attributes_len::usize);
        if (sel storage.err) { ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(storage.err)}; }
        output.attributes     = storage.ok;
        output.attributes_len = attributes_len;
        memory.copy[u8](output.attributes, attributes, attributes_len::usize);
    }
    output.machine_flags = machine_flags;
    i                    = 0;
    for (i < count) {
        val input:           *target_of.ObjectImage = ?inputs[i];
        val section_base:    u32                    = output.section_count;
        val symbol_base:     u32                    = output.symbol_count;
        val relocation_base: u32                    = output.reloc_count;
        var j:               u32                    = 0;
        for (j < input.section_count) {
            var section: target_of.Section = input.sections[j];
            section.bytes = nil;
            if (section.kind != target_of.SK_BSS && section.len > 0) {
                val storage: res[*u8, A.Error] = A.allocate[u8](alloc, section.len::usize);
                if (sel storage.err) { ret res[target_of.ObjectImage, fail.Fail].err{fail.refused(storage.err)}; }
                section.bytes = storage.ok;
                memory.copy[u8](section.bytes, input.sections[j].bytes, section.len::usize);
            }
            if (section.native.link_section != 0)                { section.native.link_section = section_base + section.native.link_section; }
            if (section.native.link_symbol != 0)                 { section.native.link_symbol = symbol_base + section.native.link_symbol; }
            if ((section.flags & target_of.SEC_FLAG_GROUP) != 0) { target_of.group_rebase(?section, section_base); }
            output.sections[output.section_count] = section;
            output.section_count                  = output.section_count + 1;
            j                                     = j + 1;
        }
        j = 0;
        for (j < input.symbol_count) {
            var symbol: target_of.Symbol = input.symbols[j];
            if (!target_of.section_is_external(symbol.section) && !target_of.section_is_absolute(symbol.section)) { symbol.section = target_of.section_id(section_base + target_of.section_index(symbol.section)); }
            if ((symbol.flags & target_of.SYM_OBJ_FLAG_FALLBACK) != 0)                                            { symbol.fallback = symbol_base + symbol.fallback; }
            output.symbols[output.symbol_count] = symbol;
            output.symbol_count                 = output.symbol_count + 1;
            j                                   = j + 1;
        }
        j = 0;
        for (j < input.reloc_count) {
            var relocation: target_of.Relocation = input.relocations[j];
            relocation.section = target_of.section_id(section_base + target_of.section_index(relocation.section));
            relocation.sym     = symbol_base + relocation.sym;
            if (target_of.is_difference(relocation.kind)) { relocation.sym2 = symbol_base + relocation.sym2; }
            if (relocation.pair != 0)                     { relocation.pair = relocation_base + relocation.pair; }
            output.relocations[output.reloc_count] = relocation;
            output.reloc_count                     = output.reloc_count + 1;
            j                                      = j + 1;
        }
        j = 0;
        for (j < input.frame_count) {
            var frame: target_of.FrameUnwind = input.frames[j];
            frame.section                     = target_of.section_id(section_base + target_of.section_index(frame.section));
            output.frames[output.frame_count] = frame;
            output.frame_count                = output.frame_count + 1;
            j                                 = j + 1;
        }
        j = 0;
        for (j < input.indirect_count) {
            var entry: target_of.NativeIndirect = input.indirects[j];
            entry.section = target_of.section_id(section_base + target_of.section_index(entry.section));
            if (entry.flags == 0) { entry.symbol = symbol_base + entry.symbol; }
            output.indirects[output.indirect_count] = entry;
            output.indirect_count                   = output.indirect_count + 1;
            j                                       = j + 1;
        }
        j = 0;
        for (j < input.export_request_count) {
            output.export_requests[output.export_request_count] = input.export_requests[j];
            output.export_request_count                         = output.export_request_count + 1;
            j                                                   = j + 1;
        }
        j = 0;
        for (j < input.import_count) {
            output.imports[output.import_count] = input.imports[j];
            output.import_count                 = output.import_count + 1;
            j                                   = j + 1;
        }
        i = i + 1;
    }
    val valid: err[fail.Fail] = target_of.validate_owned_object(?output);
    if (sel valid.err) { ret res[target_of.ObjectImage, fail.Fail].err{valid.err}; }
    complete = true;
    ret res[target_of.ObjectImage, fail.Fail].ok{output};
}
