use std.collections.map;
use std.collections.sort;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use lang_checked:    mach.lang.checked;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.session;
use mach.lang.target.isa;
use target_of: mach.lang.target.of;
use mach.lang.target.of.cfi;
use of_reloc: mach.lang.target.of.reloc;

use mach.lang.be.linker.common.ExportSurface;
use mach.lang.be.linker.common.add_u32_counts;
use mach.lang.be.linker.common.atom_effective_offset;
use mach.lang.be.linker.common.atom_field_bias;
use mach.lang.be.linker.common.atom_reloc_traits;
use mach.lang.be.linker.common.is_exported_symbol;
use mach.lang.be.linker.common.is_loadable_kind;
use mach.lang.be.linker.common.named_message;

rec AtomRelocRefCountUnit {}

rec GcAtomCountUnit {}

# what the image must keep regardless of references
# ---
# entry:      the entry symbol, or STR_NIL for an image without one
# exports:    every exported definition is kept, for a shared object
# names:      further definitions the caller reaches by name
# name_count: number of names
pub rec LinkRoots {
    entry:      intern.StrId;
    exports:    bool;
    names:      *intern.StrId;
    name_count: u32;
    # the `fwd` re-exports the link's objects asked for; nil outside a link that exports
    surface: *ExportSurface;
    # the link carries foreign frame descriptions into its unwind tables and
    # rebases the ones it keeps, so each lives only with its function; false
    # keeps every frame description section whole
    carries_frames: bool;
}

pub rec AtomWinner {
    module: u32;
    symbol: u32;
    weak:   bool;
}

pub rec AtomRelocRef {
    target_section: u32;
    target_module:  u32;
    target_symbol:  u32;
    source_module:  u32;
    reloc:          u32;
    width:          u32;
    addend_mode:    of_reloc.RelocAddendMode;
    text_bias_min:  i32;
    text_bias_max:  i32;
}

# a byte range of one flattened section that nothing live reaches
pub rec DeadRange {
    section: u32;
    start:   u32;
    end:     u32;
}

# how reachability treats a section: a root is kept whole unconditionally, a
# whole section is one atom, a split section is one atom per defined symbol, a
# dependent section lives exactly while the section it belongs to does, and a
# records section is cut into unwind records, each living exactly while the
# function it describes does
def Disposition: u8;

val DISPOSITION_ROOT:      Disposition = 0;
val DISPOSITION_WHOLE:     Disposition = 1;
val DISPOSITION_SPLIT:     Disposition = 2;
val DISPOSITION_DEPENDENT: Disposition = 3;
val DISPOSITION_RECORDS:   Disposition = 4;

val GC_NONE: u32 = 0xFFFFFFFF;

rec GcAtom {
    module: u32;
    flat:   u32;
    start:  u32;
    end:    u32;
    cover:  u32;
    # a record's field whose relocation names the function it describes
    field: u32;
    # the atom this one lives through, GC_NONE for one reachable on its own
    owner: u32;
    # the next atom sharing this one's owner
    sibling: u32;
}

rec GcSym {
    flat:   u32;
    offset: u32;
    size:   u32;
    sized:  bool;
}

rec GcSite {
    flat:   u32;
    offset: u32;
    reloc:  u32;
}

rec GcState {
    sec_total:   u32;
    syms:        *GcSym;
    sym_total:   u32;
    sym_first:   *u32;
    sym_count:   *u32;
    sites:       *GcSite;
    site_total:  u32;
    site_first:  *u32;
    site_count:  *u32;
    atoms:       *GcAtom;
    atom_cap:    u32;
    atom_total:  u32;
    atom_first:  *u32;
    atom_count:  *u32;
    disposition: *Disposition;
    live:        *u8;
    work:        *u32;
    work_count:  u32;
    # per atom: the first atom living through it
    dependents: *u32;
    # per section: whether any of its atoms is live, the first section living
    # through it, the next section sharing its owner, and the next member of
    # its group
    sec_live:      *u8;
    sec_dependent: *u32;
    sec_sibling:   *u32;
    group_next:    *u32;
}

fun reloc_ref_cmp(a: *AtomRelocRef, b: *AtomRelocRef) i64 {
    if (a.target_section < b.target_section) { ret -1; }
    if (a.target_section > b.target_section) { ret 1; }
    if (a.source_module < b.source_module)   { ret -1; }
    if (a.source_module > b.source_module)   { ret 1; }
    if (a.reloc < b.reloc)                   { ret -1; }
    if (a.reloc > b.reloc)                   { ret 1; }
    ret 0;
}

pub fun reloc_ref_lower(refs: *AtomRelocRef, count: u32, section: u32) u32 {
    var lo: u32 = 0;
    var hi: u32 = count;
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (refs[mid].target_section < section) { lo = mid + 1; }
        or                                      { hi = mid; }
    }
    ret lo;
}

# a name no object defines binds to the fallback of the first COFF weak
# external naming it, as the address resolution binds it, so that weak
# external stands as the name's winner
pub fun add_fallback_winners(modules: *target_of.ObjectImage, module_count: u32,
    winners: *map.Map[intern.StrId, AtomWinner]) err[fail.Fail] {
    val relation: u32 = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_FALLBACK;
    var m:        u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (target_of.section_is_external(sym.section) && (sym.flags & relation) == relation
                && !map.contains[intern.StrId, AtomWinner](winners, ?sym.name)) {
                val ins: res[bool, A.Error] = map.insert[intern.StrId, AtomWinner](winners, sym.name,
                    AtomWinner{module: m, symbol: sy, weak: true});
                if (sel ins.err) { ret err[fail.Fail].err{fail.refused(ins.err)}; }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

# the definition a reference to symbol sy of module m binds to: a local
# definition binds to itself, a global name to its link-wide winner, and an
# unresolved COFF weak external, in whichever object it stands, to its fallback
fun resolve_reference(modules: *target_of.ObjectImage, m: u32, sy: u32,
    winners: *map.Map[intern.StrId, AtomWinner], out: *AtomWinner) bool {
    var mod:   u32   = m;
    var cur:   u32   = sy;
    var hops:  usize = 0;
    val limit: usize = winners.len + modules[m].symbol_count::usize;
    for (cur < modules[mod].symbol_count && hops <= limit) {
        val sym: *target_of.Symbol = ?modules[mod].symbols[cur];
        if ((sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) == 0
            && !target_of.section_is_external(sym.section)
            && target_of.section_index(sym.section) < modules[mod].section_count) {
            out.module = mod;
            out.symbol = cur;
            out.weak   = false;
            ret true;
        }
        val wr: opt[*AtomWinner] = map.get[intern.StrId, AtomWinner](winners, ?sym.name);
        if (sel wr.some) {
            val winner: *target_of.Symbol = ?modules[wr.some.module].symbols[wr.some.symbol];
            if (!target_of.section_is_external(winner.section)
                || (winner.flags & target_of.SYM_OBJ_FLAG_FALLBACK) == 0) {
                @out = @wr.some;
                ret true;
            }
            mod  = wr.some.module;
            cur  = winner.fallback;
            hops = hops + 1;
            cnt;
        }
        if ((sym.flags & target_of.SYM_OBJ_FLAG_FALLBACK) == 0) { ret false; }
        cur  = sym.fallback;
        hops = hops + 1;
    }
    ret false;
}

fun reloc_ref_set_target(modules: *target_of.ObjectImage, m: u32, sy: u32,
    sec_base: *u32,
    winners: *map.Map[intern.StrId, AtomWinner],
    reference: *AtomRelocRef) {
    var winner: AtomWinner;
    if (!resolve_reference(modules, m, sy, winners, ?winner)) { ret; }
    reference.target_module = winner.module;
    reference.target_symbol = winner.symbol;
    val target: *target_of.Symbol = ?modules[winner.module].symbols[winner.symbol];
    if (!target_of.section_is_external(target.section)
        && target_of.section_index(target.section) < modules[winner.module].section_count) {
        reference.target_section = sec_base[winner.module] + target_of.section_index(target.section);
    }
}

# every relocation operand outside debug sections, bound to its definition and
# sorted by the flattened section it lands in
pub fun build_reloc_refs(s: *session.Session, modules: *target_of.ObjectImage, module_count: u32,
    sec_base: *u32,
    winners: *map.Map[intern.StrId, AtomWinner],
    arch: *isa.IsaVTable, out_total: *u32) res[*AtomRelocRef, fail.Fail] {
    @out_total = 0;
    var ref_total_checked: lang_checked.Count[AtomRelocRefCountUnit] =
        lang_checked.count[AtomRelocRefCountUnit](0::usize);
    var m: u32 = 0;
    for (m < module_count) {
        val added: res[lang_checked.Count[AtomRelocRefCountUnit], lang_checked.Cause] =
            lang_checked.count_add[AtomRelocRefCountUnit](ref_total_checked,
            lang_checked.count[AtomRelocRefCountUnit](modules[m].reloc_count::usize));
        if (sel added.err) {
            ret res[*AtomRelocRef, fail.Fail].err{fail.message("atom relocation reference count overflow")};
        }
        ref_total_checked = added.ok;
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            if (target_of.is_difference(modules[m].relocations[ri].kind)) {
                val secondary: res[lang_checked.Count[AtomRelocRefCountUnit], lang_checked.Cause] =
                    lang_checked.count_add[AtomRelocRefCountUnit](ref_total_checked,
                    lang_checked.count[AtomRelocRefCountUnit](1::usize));
                if (sel secondary.err) {
                    ret res[*AtomRelocRef, fail.Fail].err{fail.message("atom relocation reference count overflow")};
                }
                ref_total_checked = secondary.ok;
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    val ref_total_fits: res[u32, lang_checked.Cause] =
        lang_checked.usize_to_u32(ref_total_checked.value);
    if (sel ref_total_fits.err) {
        ret res[*AtomRelocRef, fail.Fail].err{fail.message("atom relocation reference count exceeds the u32 limit")};
    }
    val ref_total: u32 = ref_total_fits.ok;
    if (ref_total == 0) { ret res[*AtomRelocRef, fail.Fail].ok{nil}; }
    if (arch == nil || arch.reloc == nil || arch.reloc.traits == nil) {
        ret res[*AtomRelocRef, fail.Fail].err{fail.message("target cannot describe relocations")};
    }
    val rr: res[*AtomRelocRef, A.Error] =
        A.zallocate[AtomRelocRef](s.alloc, ref_total::usize);
    if (sel rr.err) { ret res[*AtomRelocRef, fail.Fail].err{fail.refused(rr.err)}; }
    val refs: *AtomRelocRef = rr.ok;
    var rw:   u32           = 0;
    m = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val relocation: *target_of.Relocation = ?modules[m].relocations[ri];
            if (target_of.section_index(relocation.section) >= modules[m].section_count) {
                A.deallocate[AtomRelocRef](s.alloc, refs, ref_total::usize);
                ret res[*AtomRelocRef, fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_MALFORMED, named_message(s, "object '", modules[m].name, "' has a relocation against a section it does not carry", "a relocation names a section its object does not carry"))};
            }
            val from_debug: bool                 = !reloc_section_reaches(?modules[m].sections[target_of.section_index(relocation.section)]);
            var traits:     of_reloc.RelocTraits = of_reloc.traits(0, of_reloc.ADDEND_IGNORED, 0, 0);
            if (!from_debug) {
                val ref_traits: res[of_reloc.RelocTraits, of_reloc.RelocError] = atom_reloc_traits(
                    relocation, ?modules[m].sections[target_of.section_index(relocation.section)],
                    arch, modules[m].codegen);
                if (sel ref_traits.err) {
                    A.deallocate[AtomRelocRef](s.alloc, refs, ref_total::usize);
                    val why: res[str, fail.Fail] = named_message(s, "object '", modules[m].name, "' carries a relocation kind this target's catalog does not describe", "an input carries a relocation kind the target's catalog does not describe");
                    if (sel why.err) { ret res[*AtomRelocRef, fail.Fail].err{why.err}; }
                    ret res[*AtomRelocRef, fail.Fail].err{target_of.reloc_refusal(relocation.origin, diagnostic_kind.LINK_RELOCATION_UNSUPPORTED, why.ok)};
                }
                traits = ref_traits.ok;
            }
            var operand_count: u32 = 1;
            if (target_of.is_difference(relocation.kind)) { operand_count = 2; }
            var operand: u32 = 0;
            for (operand < operand_count) {
                refs[rw].target_section = GC_NONE;
                refs[rw].target_module  = GC_NONE;
                refs[rw].target_symbol  = GC_NONE;
                refs[rw].source_module  = m;
                refs[rw].reloc          = ri;
                refs[rw].width          = traits.field_width;
                refs[rw].addend_mode    = traits.addend_mode;
                refs[rw].text_bias_min  = traits.text_bias_min;
                refs[rw].text_bias_max  = traits.text_bias_max;
                var target_symbol: u32 = relocation.sym;
                if (operand == 1) {
                    target_symbol          = relocation.sym2;
                    refs[rw].addend_mode   = of_reloc.ADDEND_IGNORED;
                    refs[rw].text_bias_min = 0;
                    refs[rw].text_bias_max = 0;
                }
                if (!from_debug) {
                    reloc_ref_set_target(modules, m, target_symbol, sec_base, winners, ?refs[rw]);
                }
                rw      = rw + 1;
                operand = operand + 1;
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    sort.sort_by[AtomRelocRef](refs, ref_total::usize, reloc_ref_cmp);
    @out_total = ref_total;
    ret res[*AtomRelocRef, fail.Fail].ok{refs};
}

# whether a section's relocations can reach anything: debug information only
# describes code, but an unwind index kept in a debug section (mach-o
# `__compact_unwind`) names the lsda and personality of the functions it keeps
fun reloc_section_reaches(sec: *target_of.Section) bool {
    ret sec.kind != target_of.SK_DEBUG || (sec.flags & target_of.SEC_FLAG_UNWIND_INDEX) != 0;
}

# the disposition a section starts from; a split candidate falls back to whole
# when its atom boundaries cannot be trusted, and a records candidate to a root
# when its records cannot be read
fun section_disposition(modules: *target_of.ObjectImage, m: u32, sc: u32, carries_frames: bool) Disposition {
    val sec: *target_of.Section = ?modules[m].sections[sc];
    if ((sec.flags & (target_of.SEC_FLAG_INIT_FUNCS | target_of.SEC_FLAG_RETAIN)) != 0) { ret DISPOSITION_ROOT; }
    if ((sec.flags & target_of.SEC_FLAG_ASSOCIATED) != 0)                               { ret DISPOSITION_DEPENDENT; }
    if ((sec.flags & target_of.SEC_FLAG_UNWIND_FRAMES) != 0) {
        if (carries_frames) { ret DISPOSITION_RECORDS; }
        ret DISPOSITION_ROOT;
    }
    if ((sec.flags & target_of.SEC_FLAG_UNWIND_INDEX) != 0) { ret DISPOSITION_RECORDS; }
    if (!is_loadable_kind(sec.kind))                        { ret DISPOSITION_ROOT; }
    if (modules[m].codegen || modules[m].symbol_atoms)      { ret DISPOSITION_SPLIT; }
    ret DISPOSITION_WHOLE;
}

# the unwind record at `off`: `end` receives where it ends and `field` the
# offset of the field whose relocation names the function it describes, or
# GC_NONE for a record no function owns (a cie). a frame description section
# is read entry by entry, and an unwind index is a table of entries of its
# section's declared entry size, each naming its function first.
# false where the records end
fun unwind_record(sec: *target_of.Section, off: u32, end: *u32, field: *u32) res[bool, fail.Fail] {
    if ((sec.flags & target_of.SEC_FLAG_UNWIND_FRAMES) != 0) {
        if (sec.bytes == nil) { ret res[bool, fail.Fail].ok{false}; }
        val er: res[opt[cfi.EhEntry], fail.Fail] = cfi.eh_entry(sec.bytes, sec.len::usize, off::usize);
        if (sel er.err)     { ret res[bool, fail.Fail].err{er.err}; }
        if (sel er.ok.none) { ret res[bool, fail.Fail].ok{false}; }
        val e: cfi.EhEntry = er.ok.some;
        @end   = (e.off + e.size)::u32;
        @field = GC_NONE;
        if (!e.cie) { @field = off + 8; }
        ret res[bool, fail.Fail].ok{true};
    }
    val size: u64 = target_of.unwind_entry_size(sec);
    if (size == 0 || size > sec.len::u64 || sec.len::u64 % size != 0) {
        ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "an unwind index is not whole entries")};
    }
    if (off >= sec.len) { ret res[bool, fail.Fail].ok{false}; }
    @end   = off + size::u32;
    @field = off;
    ret res[bool, fail.Fail].ok{true};
}

# the number of atoms a records section is cut into, none when its records
# cannot be read: one per record, and one for whatever follows the last
fun unwind_record_count(sec: *target_of.Section) opt[u32] {
    var n:     u32 = 0;
    var off:   u32 = 0;
    var end:   u32 = 0;
    var field: u32 = 0;
    for (off < sec.len) {
        val rr: res[bool, fail.Fail] = unwind_record(sec, off, ?end, ?field);
        if (sel rr.err) { ret opt[u32].none{}; }
        if (!rr.ok) {
            ret opt[u32].some{n + 1};
        }
        n   = n + 1;
        off = end;
    }
    ret opt[u32].some{n};
}

fun gc_sym_cmp(a: *GcSym, b: *GcSym) i64 {
    if (a.flat < b.flat)     { ret -1; }
    if (a.flat > b.flat)     { ret 1; }
    if (a.offset < b.offset) { ret -1; }
    if (a.offset > b.offset) { ret 1; }
    if (a.size < b.size)     { ret -1; }
    if (a.size > b.size)     { ret 1; }
    ret 0;
}

fun gc_state_free(alloc: *A.Allocator, st: *GcState) {
    val sections: usize = st.sec_total::usize;
    if (st.syms != nil)          { A.deallocate[GcSym](alloc, st.syms, st.sym_total::usize); }
    if (st.sites != nil)         { A.deallocate[GcSite](alloc, st.sites, st.site_total::usize); }
    if (st.atoms != nil)         { A.deallocate[GcAtom](alloc, st.atoms, st.atom_cap::usize); }
    if (st.live != nil)          { A.deallocate[u8](alloc, st.live, st.atom_cap::usize); }
    if (st.work != nil)          { A.deallocate[u32](alloc, st.work, st.atom_cap::usize); }
    if (st.sym_first != nil)     { A.deallocate[u32](alloc, st.sym_first, sections); }
    if (st.sym_count != nil)     { A.deallocate[u32](alloc, st.sym_count, sections); }
    if (st.site_first != nil)    { A.deallocate[u32](alloc, st.site_first, sections); }
    if (st.site_count != nil)    { A.deallocate[u32](alloc, st.site_count, sections); }
    if (st.atom_first != nil)    { A.deallocate[u32](alloc, st.atom_first, sections); }
    if (st.atom_count != nil)    { A.deallocate[u32](alloc, st.atom_count, sections); }
    if (st.disposition != nil)   { A.deallocate[Disposition](alloc, st.disposition, sections); }
    if (st.dependents != nil)    { A.deallocate[u32](alloc, st.dependents, st.atom_cap::usize); }
    if (st.sec_live != nil)      { A.deallocate[u8](alloc, st.sec_live, sections); }
    if (st.sec_dependent != nil) { A.deallocate[u32](alloc, st.sec_dependent, sections); }
    if (st.sec_sibling != nil)   { A.deallocate[u32](alloc, st.sec_sibling, sections); }
    if (st.group_next != nil)    { A.deallocate[u32](alloc, st.group_next, sections); }
}

fun gc_fill_none(dst: *u32, count: u32) {
    var i: u32 = 0;
    for (i < count) {
        dst[i] = GC_NONE;
        i      = i + 1;
    }
}

fun gc_atom_set(st: *GcState, at: u32, m: u32, flat: u32, start: u32, end: u32, cover: u32) {
    st.atoms[at].module  = m;
    st.atoms[at].flat    = flat;
    st.atoms[at].start   = start;
    st.atoms[at].end     = end;
    st.atoms[at].cover   = cover;
    st.atoms[at].field   = GC_NONE;
    st.atoms[at].owner   = GC_NONE;
    st.atoms[at].sibling = GC_NONE;
}

fun gc_zallocate_u32(alloc: *A.Allocator, count: u32, out: **u32) err[fail.Fail] {
    val r: res[*u32, A.Error] = A.zallocate[u32](alloc, count::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    @out = r.ok;
    ret err[fail.Fail].ok{};
}

# the index of the atom of a flattened section that holds offset off; the last
# atom holds the section's end offset
fun gc_atom_at(st: *GcState, flat: u32, off: u32) u32 {
    val first: u32 = st.atom_first[flat];
    val count: u32 = st.atom_count[flat];
    if (count == 0 || off < st.atoms[first].start) { ret GC_NONE; }
    var lo: u32 = 0;
    var hi: u32 = count;
    for (hi - lo > 1) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (st.atoms[first + mid].start <= off) { lo = mid; }
        or                                      { hi = mid; }
    }
    ret first + lo;
}

fun gc_index_symbols(alloc: *A.Allocator, st: *GcState, modules: *target_of.ObjectImage,
    module_count: u32, sec_base: *u32) err[fail.Fail] {
    var total: u32 = 0;
    var m:     u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (!target_of.section_is_external(sym.section) && target_of.section_index(sym.section) < modules[m].section_count
                && modules[m].sections[target_of.section_index(sym.section)].kind != target_of.SK_DEBUG) {
                total = total + 1;
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    val fr: err[fail.Fail] = gc_zallocate_u32(alloc, st.sec_total, ?st.sym_first);
    if (sel fr.err) { ret fr; }
    val cr: err[fail.Fail] = gc_zallocate_u32(alloc, st.sec_total, ?st.sym_count);
    if (sel cr.err) { ret cr; }
    if (total == 0) { ret err[fail.Fail].ok{}; }
    val sr: res[*GcSym, A.Error] = A.zallocate[GcSym](alloc, total::usize);
    if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
    st.syms      = sr.ok;
    st.sym_total = total;

    var w: u32 = 0;
    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (!target_of.section_is_external(sym.section) && target_of.section_index(sym.section) < modules[m].section_count
                && modules[m].sections[target_of.section_index(sym.section)].kind != target_of.SK_DEBUG) {
                st.syms[w].flat   = sec_base[m] + target_of.section_index(sym.section);
                st.syms[w].offset = sym.offset;
                st.syms[w].size   = sym.size;
                st.syms[w].sized  = sym.size > 0 && (sym.flags & target_of.SYM_OBJ_FLAG_SIZE_UNKNOWN) == 0;
                w                 = w + 1;
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    sort.sort_by[GcSym](st.syms, total::usize, gc_sym_cmp);
    var i: u32 = 0;
    for (i < total) {
        val flat: u32 = st.syms[i].flat;
        if (st.sym_count[flat] == 0) { st.sym_first[flat] = i; }
        st.sym_count[flat] = st.sym_count[flat] + 1;
        i                  = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun gc_index_sites(alloc: *A.Allocator, st: *GcState, modules: *target_of.ObjectImage,
    module_count: u32, sec_base: *u32) err[fail.Fail] {
    var total: u32 = 0;
    var m:     u32 = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            if (reloc_section_reaches(?modules[m].sections[target_of.section_index(modules[m].relocations[ri].section)])) {
                total = total + 1;
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    val fr: err[fail.Fail] = gc_zallocate_u32(alloc, st.sec_total, ?st.site_first);
    if (sel fr.err) { ret fr; }
    val cr: err[fail.Fail] = gc_zallocate_u32(alloc, st.sec_total, ?st.site_count);
    if (sel cr.err) { ret cr; }
    if (total == 0) { ret err[fail.Fail].ok{}; }
    val sr: res[*GcSite, A.Error] = A.zallocate[GcSite](alloc, total::usize);
    if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
    st.sites      = sr.ok;
    st.site_total = total;

    var w: u32 = 0;
    m = 0;
    for (m < module_count) {
        var ri: u32 = 0;
        for (ri < modules[m].reloc_count) {
            val r: *target_of.Relocation = ?modules[m].relocations[ri];
            if (reloc_section_reaches(?modules[m].sections[target_of.section_index(r.section)])) {
                st.sites[w].flat   = sec_base[m] + target_of.section_index(r.section);
                st.sites[w].offset = r.offset;
                st.sites[w].reloc  = ri;
                w                  = w + 1;
            }
            ri = ri + 1;
        }
        m = m + 1;
    }
    sort.sort[GcSite](st.sites, total::usize);
    var i: u32 = 0;
    for (i < total) {
        val flat: u32 = st.sites[i].flat;
        if (st.site_count[flat] == 0) { st.site_first[flat] = i; }
        st.site_count[flat] = st.site_count[flat] + 1;
        i                   = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the section offsets a relocation operand may address around its target: the
# symbol alone when the addend is ignored or belongs to a difference, otherwise
# the addend and the field bias atom_field_bias gives, clamped to the section's
# start; false when that span leaves the u32 range
fun reference_span(r: *target_of.Relocation, traits: of_reloc.RelocTraits, source_text: bool,
    second_operand: bool, target_offset: u32, lo: *u32, hi: *u32) bool {
    @lo = target_offset;
    @hi = target_offset;
    # a difference's constant belongs to the difference, not to either operand
    if (second_operand || target_of.is_difference(r.kind) || traits.addend_mode == of_reloc.ADDEND_IGNORED) { ret true; }
    var bias_min: i64 = 0;
    var bias_max: i64 = 0;
    atom_field_bias(r, traits.addend_mode, traits.text_bias_min, traits.text_bias_max, source_text,
        ?bias_min, ?bias_max);
    if ((bias_min > 0 && r.addend > 9223372036854775807 - bias_min)
        || (bias_min < 0 && r.addend < (-9223372036854775807 - 1) - bias_min)
        || (bias_max > 0 && r.addend > 9223372036854775807 - bias_max)
        || (bias_max < 0 && r.addend < (-9223372036854775807 - 1) - bias_max)) {
        ret false;
    }
    if (!atom_effective_offset(target_offset, r.addend + bias_max, hi)) { ret false; }
    if (atom_effective_offset(target_offset, r.addend + bias_min, lo))  { ret true; }
    # an operand addresses no byte before its section, whatever low bias a field of unknown instruction allows
    if (target_offset::i64 + r.addend + bias_min >= 0) { ret false; }
    @lo = 0;
    ret true;
}

# one atom per distinct sized symbol start, each running to the next start;
# false when the section's symbols and references do not respect those edges
fun split_atoms(st: *GcState, modules: *target_of.ObjectImage, m: u32, sc: u32, flat: u32,
    refs: *AtomRelocRef, ref_total: u32,
    arch: *isa.IsaVTable) bool {
    val sec:   *target_of.Section = ?modules[m].sections[sc];
    val first: u32                = st.atom_total;
    val sf:    u32                = st.sym_first[flat];
    val sn:    u32                = st.sym_count[flat];
    var n:     u32                = 0;
    var i:     u32                = sf;
    for (i < sf + sn) {
        val sym: *GcSym = ?st.syms[i];
        if (!sym.sized) {
            i = i + 1;
            cnt;
        }
        if (sym.offset::u64 + sym.size::u64 > sec.len::u64) { ret false; }
        if (n == 0 && sym.offset != 0)                      { ret false; }
        if (n > 0) {
            val prev: *GcAtom = ?st.atoms[first + n - 1];
            if (sym.offset == prev.start && sym.offset + sym.size == prev.cover) {
                i = i + 1;
                cnt;
            }
            if (sym.offset < prev.cover) { ret false; }
            prev.end = sym.offset;
        }
        gc_atom_set(st, first + n, m, flat, sym.offset, sec.len, sym.offset + sym.size);
        n = n + 1;
        i = i + 1;
    }
    if (n == 0) { ret false; }
    st.atom_total       = first + n;
    st.atom_count[flat] = n;

    i = sf;
    for (i < sf + sn) {
        val sym: *GcSym = ?st.syms[i];
        if (!sym.sized) {
            val holder: u32 = gc_atom_at(st, flat, sym.offset);
            if (holder == GC_NONE || sym.offset >= st.atoms[holder].cover) { ret false; }
        }
        i = i + 1;
    }

    var si: u32 = st.site_first[flat];
    val se: u32 = si + st.site_count[flat];
    for (si < se) {
        val r:      *target_of.Relocation                          = ?modules[m].relocations[st.sites[si].reloc];
        val traits: res[of_reloc.RelocTraits, of_reloc.RelocError] = atom_reloc_traits(r, sec, arch, modules[m].codegen);
        if (sel traits.err) { ret false; }
        val holder: u32 = gc_atom_at(st, flat, r.offset);
        if (holder == GC_NONE || r.offset::u64 + traits.ok.field_width::u64 > st.atoms[holder].end::u64) {
            ret false;
        }
        si = si + 1;
    }

    var ref_i: u32 = reloc_ref_lower(refs, ref_total, flat);
    for (ref_i < ref_total && refs[ref_i].target_section == flat) {
        val reference: *AtomRelocRef          = ?refs[ref_i];
        val target:    *target_of.Symbol      = ?modules[m].symbols[reference.target_symbol];
        val source:    *target_of.ObjectImage = ?modules[reference.source_module];
        val r:         *target_of.Relocation  = ?source.relocations[reference.reloc];
        val traits:    of_reloc.RelocTraits   = of_reloc.traits(reference.width, reference.addend_mode,
            reference.text_bias_min, reference.text_bias_max);
        var lo: u32 = 0;
        var hi: u32 = 0;
        if (!reference_span(r, traits, source.sections[target_of.section_index(r.section)].kind == target_of.SK_TEXT,
            false, target.offset, ?lo, ?hi)) {
            ret false;
        }
        ref_i = ref_i + 1;
    }
    ret true;
}

# one atom per unwind record, and one for whatever follows the last
fun record_atoms(st: *GcState, modules: *target_of.ObjectImage, m: u32, sc: u32, flat: u32) {
    val sec:   *target_of.Section = ?modules[m].sections[sc];
    val first: u32                = st.atom_total;
    var n:     u32                = 0;
    var off:   u32                = 0;
    var end:   u32                = 0;
    var field: u32                = 0;
    for (off < sec.len) {
        val rr:   res[bool, fail.Fail] = unwind_record(sec, off, ?end, ?field);
        var more: bool                 = false;
        if (sel rr.ok) { more = rr.ok; }
        if (!more) {
            gc_atom_set(st, first + n, m, flat, off, sec.len, sec.len);
            n   = n + 1;
            off = sec.len;
            cnt;
        }
        gc_atom_set(st, first + n, m, flat, off, end, end);
        st.atoms[first + n].field = field;
        n                         = n + 1;
        off                       = end;
    }
    if (n == 0) {
        gc_atom_set(st, first, m, flat, 0, sec.len, sec.len);
        n = 1;
    }
    st.atom_total       = first + n;
    st.atom_count[flat] = n;
}

# settles each section's disposition, and the number of atoms the records
# sections add beyond one per section
fun gc_classify(st: *GcState, modules: *target_of.ObjectImage, module_count: u32, sec_base: *u32,
    carries_frames: bool, extra: *u32) bool {
    @extra = 0;
    var m: u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val flat: u32                = sec_base[m] + sc;
            val sec:  *target_of.Section = ?modules[m].sections[sc];
            # debug information about one function (a coff associative .debug$S) goes with it
            st.disposition[flat] = DISPOSITION_ROOT;
            if (reloc_section_reaches(sec)) {
                st.disposition[flat] = section_disposition(modules, m, sc, carries_frames);
            }
            or ((sec.flags & target_of.SEC_FLAG_ASSOCIATED) != 0) { st.disposition[flat] = DISPOSITION_DEPENDENT; }
            if (st.disposition[flat] == DISPOSITION_RECORDS) {
                val count: opt[u32] = unwind_record_count(sec);
                if (sel count.none) { st.disposition[flat] = DISPOSITION_ROOT; }
                if (sel count.some) {
                    val n: u32 = count.some;
                    if (n > 1) {
                        if (@extra > 0xFFFFFFFF - n) { ret false; }
                        @extra = @extra + n - 1;
                    }
                }
            }
            sc = sc + 1;
        }
        m = m + 1;
    }
    ret true;
}

fun gc_atomize(st: *GcState, modules: *target_of.ObjectImage, module_count: u32,
    sec_base: *u32, refs: *AtomRelocRef, ref_total: u32,
    arch: *isa.IsaVTable) {
    var m: u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val flat: u32                = sec_base[m] + sc;
            val sec:  *target_of.Section = ?modules[m].sections[sc];
            val at:   u32                = st.atom_total;
            st.atom_first[flat] = at;
            st.atom_count[flat] = 0;
            if (sec.kind == target_of.SK_DEBUG && st.disposition[flat] != DISPOSITION_DEPENDENT
                && st.disposition[flat] != DISPOSITION_RECORDS) {
                sc = sc + 1;
                cnt;
            }
            if (st.disposition[flat] == DISPOSITION_RECORDS) {
                record_atoms(st, modules, m, sc, flat);
                sc = sc + 1;
                cnt;
            }
            if (st.disposition[flat] == DISPOSITION_SPLIT
                && split_atoms(st, modules, m, sc, flat, refs, ref_total, arch)) {
                sc = sc + 1;
                cnt;
            }
            if (st.disposition[flat] == DISPOSITION_SPLIT) { st.disposition[flat] = DISPOSITION_WHOLE; }
            gc_atom_set(st, at, m, flat, 0, sec.len, sec.len);
            st.atom_total       = at + 1;
            st.atom_count[flat] = 1;
            sc                  = sc + 1;
        }
        m = m + 1;
    }
}

# the section and the offsets a relocation operand reaches, false when it names
# nothing the link places; a span it cannot compute is an error only against a
# split section, whose one atom it would have to choose
fun gc_reference_target(st: *GcState, modules: *target_of.ObjectImage, m: u32, r: *target_of.Relocation,
    traits: of_reloc.RelocTraits, second_operand: bool, sec_base: *u32,
    winners: *map.Map[intern.StrId, AtomWinner], flat: *u32, lo: *u32, hi: *u32) res[bool, fail.Fail] {
    var sy: u32 = r.sym;
    if (second_operand) { sy = r.sym2; }
    var winner: AtomWinner;
    if (!resolve_reference(modules, m, sy, winners, ?winner)) { ret res[bool, fail.Fail].ok{false}; }
    val target: *target_of.Symbol = ?modules[winner.module].symbols[winner.symbol];
    if (target_of.section_is_external(target.section)
        || target_of.section_index(target.section) >= modules[winner.module].section_count) {
        ret res[bool, fail.Fail].ok{false};
    }
    @flat = sec_base[winner.module] + target_of.section_index(target.section);
    if (st.atom_count[@flat] == 0) { ret res[bool, fail.Fail].ok{false}; }
    @lo = target.offset;
    @hi = target.offset;
    if (!reference_span(r, traits, modules[m].sections[target_of.section_index(r.section)].kind == target_of.SK_TEXT,
        second_operand, target.offset, lo, hi)) {
        if (st.atom_count[@flat] > 1) {
            ret res[bool, fail.Fail].err{fail.message("internal: a reference into a split section has no computable span")};
        }
        # a foreign field bias can put the span before a whole section's start; its one atom covers every byte
        @lo = target.offset;
        @hi = target.offset;
    }
    if (target.offset < @lo) { @lo = target.offset; }
    if (target.offset > @hi) { @hi = target.offset; }
    ret res[bool, fail.Fail].ok{true};
}

# the relocation of module m at `off` in flattened section `flat`, GC_NONE
# when none sits there
fun gc_site_at(st: *GcState, flat: u32, off: u32) u32 {
    val first: u32 = st.site_first[flat];
    var lo:    u32 = 0;
    var hi:    u32 = st.site_count[flat];
    for (lo < hi) {
        val mid: u32 = lo + (hi - lo) / 2;
        if (st.sites[first + mid].offset < off) { lo = mid + 1; }
        or                                      { hi = mid; }
    }
    if (lo < st.site_count[flat] && st.sites[first + lo].offset == off) { ret st.sites[first + lo].reloc; }
    ret GC_NONE;
}

# ties each record to the atom holding the function its field names and each
# dependent section to its owner, and rings each section group; a record or
# section whose owner the link does not place stands on its own as a root
fun gc_link_owners(st: *GcState, modules: *target_of.ObjectImage, module_count: u32, sec_base: *u32,
    winners: *map.Map[intern.StrId, AtomWinner], arch: *isa.IsaVTable) err[fail.Fail] {
    var a: u32 = 0;
    for (a < st.atom_total) {
        val atom: *GcAtom = ?st.atoms[a];
        if (atom.field == GC_NONE) {
            a = a + 1;
            cnt;
        }
        val m:  u32 = atom.module;
        val ri: u32 = gc_site_at(st, atom.flat, atom.field);
        if (ri == GC_NONE) {
            a = a + 1;
            cnt;
        }
        val r:      *target_of.Relocation                          = ?modules[m].relocations[ri];
        val traits: res[of_reloc.RelocTraits, of_reloc.RelocError] = atom_reloc_traits(
            r, ?modules[m].sections[target_of.section_index(r.section)], arch, modules[m].codegen);
        if (sel traits.err) {
            a = a + 1;
            cnt;
        }
        var flat: u32                  = 0;
        var lo:   u32                  = 0;
        var hi:   u32                  = 0;
        val tr:   res[bool, fail.Fail] = gc_reference_target(st, modules, m, r, traits.ok, false, sec_base, winners,
            ?flat, ?lo, ?hi);
        if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
        if (tr.ok) {
            val owner: u32 = gc_atom_at(st, flat, lo);
            if (owner != GC_NONE && owner != a) {
                atom.owner           = owner;
                atom.sibling         = st.dependents[owner];
                st.dependents[owner] = a;
            }
        }
        a = a + 1;
    }

    var m: u32 = 0;
    for (m < module_count) {
        var sc: u32 = 0;
        for (sc < modules[m].section_count) {
            val flat: u32                = sec_base[m] + sc;
            val sec:  *target_of.Section = ?modules[m].sections[sc];
            if (st.disposition[flat] == DISPOSITION_DEPENDENT) {
                val link: opt[u32] = target_of.associated_owner(sec);
                var kept: bool     = false;
                if (sel link.some) {
                    if (link.some < modules[m].section_count && st.atom_count[sec_base[m] + link.some] != 0) {
                        val owner: u32 = sec_base[m] + link.some;
                        st.sec_sibling[flat]    = st.sec_dependent[owner];
                        st.sec_dependent[owner] = flat;
                        kept                    = true;
                    }
                }
                if (!kept) { st.disposition[flat] = DISPOSITION_ROOT; }
            }
            gc_ring_group(st, modules, m, sec, sec_base);
            sc = sc + 1;
        }
        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

# rings the placed members of one section group, so reaching any of them
# reaches them all
fun gc_ring_group(st: *GcState, modules: *target_of.ObjectImage, m: u32, group: *target_of.Section, sec_base: *u32) {
    var first: u32 = GC_NONE;
    var prev:  u32 = GC_NONE;
    var gi:    u32 = 0;
    for (gi < target_of.group_member_count(group)) {
        val member: opt[target_of.GroupMember] = target_of.group_member_at(group, gi);
        gi = gi + 1;
        if (sel member.none)                                                            { cnt; }
        if (member.some.relocations || member.some.section >= modules[m].section_count) { cnt; }
        val flat: u32 = sec_base[m] + member.some.section;
        if (st.atom_count[flat] == 0 || st.group_next[flat] != GC_NONE) { cnt; }
        if (first == GC_NONE)                                           { first = flat; }
        or                                                              { st.group_next[prev] = flat; }
        prev = flat;
    }
    if (prev != GC_NONE && prev != first) { st.group_next[prev] = first; }
}

fun gc_mark_atom(st: *GcState, atom: u32) {
    if (atom == GC_NONE || st.live[atom] != 0) { ret; }
    st.live[atom]          = 1;
    st.work[st.work_count] = atom;
    st.work_count          = st.work_count + 1;
}

fun gc_mark_section(st: *GcState, flat: u32) {
    var a: u32 = 0;
    for (a < st.atom_count[flat]) {
        gc_mark_atom(st, st.atom_first[flat] + a);
        a = a + 1;
    }
}

fun gc_mark_symbol(st: *GcState, modules: *target_of.ObjectImage, m: u32, sy: u32, sec_base: *u32) {
    val sym: *target_of.Symbol = ?modules[m].symbols[sy];
    if (target_of.section_is_external(sym.section) || target_of.section_index(sym.section) >= modules[m].section_count) { ret; }
    gc_mark_atom(st, gc_atom_at(st, sec_base[m] + target_of.section_index(sym.section), sym.offset));
}

fun gc_mark_name(st: *GcState, modules: *target_of.ObjectImage, sec_base: *u32,
    winners: *map.Map[intern.StrId, AtomWinner], name: intern.StrId) {
    var key: intern.StrId     = name;
    val wr:  opt[*AtomWinner] = map.get[intern.StrId, AtomWinner](winners, ?key);
    if (sel wr.none) { ret; }
    var winner: AtomWinner;
    if (!resolve_reference(modules, wr.some.module, wr.some.symbol, winners, ?winner)) { ret; }
    gc_mark_symbol(st, modules, winner.module, winner.symbol, sec_base);
}

val GC_START_PREFIX: str = "__start_";
val GC_STOP_PREFIX:  str = "__stop_";

# a reference nothing defines to `__start_<name>` or `__stop_<name>` is to the
# bounds of every section called <name>, which keeps each of them whole
fun gc_mark_encapsulated(st: *GcState, modules: *target_of.ObjectImage, module_count: u32, sec_base: *u32,
    m: u32, sy: u32) {
    val nm: opt[str] = intern.get(modules[m].interner, modules[m].symbols[sy].name);
    if (sel nm.none) { ret; }
    var skip: usize = 0;
    if (str_starts_with(nm.some, GC_START_PREFIX)) { skip = str_len(GC_START_PREFIX); }
    or (str_starts_with(nm.some, GC_STOP_PREFIX))  { skip = str_len(GC_STOP_PREFIX); }
    or                                             { ret; }
    val wanted: str = (nm.some::usize + skip)::str;
    if (str_len(wanted) == 0) { ret; }
    var tm: u32 = 0;
    for (tm < module_count) {
        var sc: u32 = 0;
        for (sc < modules[tm].section_count) {
            val flat: u32 = sec_base[tm] + sc;
            if (st.atom_count[flat] > 0) {
                val sn: opt[str] = intern.get(modules[tm].interner, modules[tm].sections[sc].name);
                if (sel sn.some && str_equals(sn.some, wanted)) { gc_mark_section(st, flat); }
            }
            sc = sc + 1;
        }
        tm = tm + 1;
    }
}

# marks every atom a relocation operand's span touches, so no byte between the
# target symbol and the address the field really holds is dropped
fun gc_mark_reference(st: *GcState, modules: *target_of.ObjectImage, module_count: u32, m: u32, r: *target_of.Relocation,
    traits: of_reloc.RelocTraits, second_operand: bool, sec_base: *u32,
    winners: *map.Map[intern.StrId, AtomWinner]) err[fail.Fail] {
    var flat: u32                  = 0;
    var lo:   u32                  = 0;
    var hi:   u32                  = 0;
    val tr:   res[bool, fail.Fail] = gc_reference_target(st, modules, m, r, traits, second_operand, sec_base, winners,
        ?flat, ?lo, ?hi);
    if (sel tr.err) { ret err[fail.Fail].err{tr.err}; }
    if (!tr.ok) {
        var sy: u32 = r.sym;
        if (second_operand) { sy = r.sym2; }
        var winner: AtomWinner;
        if (sy < modules[m].symbol_count && !resolve_reference(modules, m, sy, winners, ?winner)) {
            gc_mark_encapsulated(st, modules, module_count, sec_base, m, sy);
        }
        ret err[fail.Fail].ok{};
    }
    var atom: u32 = gc_atom_at(st, flat, lo);
    val last: u32 = gc_atom_at(st, flat, hi);
    for (atom <= last) {
        gc_mark_atom(st, atom);
        atom = atom + 1;
    }
    ret err[fail.Fail].ok{};
}

fun gc_mark_roots(st: *GcState, modules: *target_of.ObjectImage, module_count: u32, sec_base: *u32,
    winners: *map.Map[intern.StrId, AtomWinner], roots: *LinkRoots) {
    var flat: u32 = 0;
    for (flat < st.sec_total) {
        if (st.disposition[flat] == DISPOSITION_ROOT) { gc_mark_section(st, flat); }
        or (st.disposition[flat] == DISPOSITION_RECORDS) {
            var a: u32 = 0;
            for (a < st.atom_count[flat]) {
                if (st.atoms[st.atom_first[flat] + a].owner == GC_NONE) { gc_mark_atom(st, st.atom_first[flat] + a); }
                a = a + 1;
            }
        }
        flat = flat + 1;
    }
    var km: u32 = 0;
    for (km < module_count) {
        var ks: u32 = 0;
        for (ks < modules[km].symbol_count) {
            if ((modules[km].symbols[ks].flags & target_of.SYM_OBJ_FLAG_RETAIN) != 0) { gc_mark_symbol(st, modules, km, ks, sec_base); }
            ks = ks + 1;
        }
        km = km + 1;
    }
    if (!intern.str_is_nil(roots.entry)) { gc_mark_name(st, modules, sec_base, winners, roots.entry); }
    var ni: u32 = 0;
    for (ni < roots.name_count) {
        gc_mark_name(st, modules, sec_base, winners, roots.names[ni]);
        ni = ni + 1;
    }
    if (!roots.exports) { ret; }
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            if (is_exported_symbol(?modules[m], ?modules[m].symbols[sy], roots.surface)) {
                gc_mark_name(st, modules, sec_base, winners, modules[m].symbols[sy].name);
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
}

# a live atom reaches what its relocations name, the records describing it,
# and, the first time its section is reached, the sections living through that
# section and the rest of its group
fun gc_propagate(st: *GcState, modules: *target_of.ObjectImage, module_count: u32, sec_base: *u32,
    winners: *map.Map[intern.StrId, AtomWinner], arch: *isa.IsaVTable) err[fail.Fail] {
    for (st.work_count > 0) {
        st.work_count = st.work_count - 1;
        val ai:   u32     = st.work[st.work_count];
        val atom: *GcAtom = ?st.atoms[ai];
        val m:    u32     = atom.module;
        if (st.sec_live[atom.flat] == 0) {
            st.sec_live[atom.flat] = 1;
            if (st.group_next[atom.flat] != GC_NONE) { gc_mark_section(st, st.group_next[atom.flat]); }
            var dep_sec: u32 = st.sec_dependent[atom.flat];
            for (dep_sec != GC_NONE) {
                gc_mark_section(st, dep_sec);
                dep_sec = st.sec_sibling[dep_sec];
            }
        }
        var dep: u32 = st.dependents[ai];
        for (dep != GC_NONE) {
            gc_mark_atom(st, dep);
            dep = st.atoms[dep].sibling;
        }
        val first: u32 = st.site_first[atom.flat];
        var lo:    u32 = 0;
        var hi:    u32 = st.site_count[atom.flat];
        for (lo < hi) {
            val mid: u32 = lo + (hi - lo) / 2;
            if (st.sites[first + mid].offset < atom.start) { lo = mid + 1; }
            or                                             { hi = mid; }
        }
        var si: u32 = first + lo;
        val se: u32 = first + st.site_count[atom.flat];
        for (si < se && st.sites[si].offset < atom.end) {
            val r:      *target_of.Relocation                          = ?modules[m].relocations[st.sites[si].reloc];
            val traits: res[of_reloc.RelocTraits, of_reloc.RelocError] = atom_reloc_traits(
                r, ?modules[m].sections[target_of.section_index(r.section)], arch, modules[m].codegen);
            if (sel traits.err) {
                ret err[fail.Fail].err{fail.message("internal: a live relocation lost its traits after the reference table described it")};
            }
            val first_r: err[fail.Fail] = gc_mark_reference(st, modules, module_count, m, r, traits.ok, false, sec_base, winners);
            if (sel first_r.err) { ret first_r; }
            if (target_of.is_difference(r.kind)) {
                val second_r: err[fail.Fail] = gc_mark_reference(st, modules, module_count, m, r, traits.ok, true, sec_base, winners);
                if (sel second_r.err) { ret second_r; }
            }
            si = si + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

# the byte ranges of a final image that no root reaches through relocations.
# an unwind record, an associated section and a section group member are
# reached with the function, owner or group they belong to, and a reference to
# `__start_<name>` or `__stop_<name>` reaches every section called <name>
# ---
# refs:       the sorted reference table from build_reloc_refs
# roots:      what the image keeps regardless of references
# dead_count: set to the number of ranges returned
# ret:        the dead ranges, nil when there are none
pub fun collect_dead_atoms(s: *session.Session, modules: *target_of.ObjectImage, module_count: u32,
    sec_base: *u32, sec_total: u32,
    winners: *map.Map[intern.StrId, AtomWinner],
    refs: *AtomRelocRef, ref_total: u32, arch: *isa.IsaVTable,
    roots: *LinkRoots, dead_count: *u32) res[*DeadRange, fail.Fail] {
    @dead_count = 0;
    if (sec_total == 0) { ret res[*DeadRange, fail.Fail].ok{nil}; }
    val alloc: *A.Allocator = s.alloc;
    var st:    GcState;
    st.sec_total = sec_total;
    fin { gc_state_free(alloc, ?st); }

    val symbols_r: err[fail.Fail] = gc_index_symbols(alloc, ?st, modules, module_count, sec_base);
    if (sel symbols_r.err) { ret res[*DeadRange, fail.Fail].err{symbols_r.err}; }
    val sites_r: err[fail.Fail] = gc_index_sites(alloc, ?st, modules, module_count, sec_base);
    if (sel sites_r.err) { ret res[*DeadRange, fail.Fail].err{sites_r.err}; }

    val dr: res[*Disposition, A.Error] = A.zallocate[Disposition](alloc, sec_total::usize);
    if (sel dr.err) { ret res[*DeadRange, fail.Fail].err{fail.refused(dr.err)}; }
    st.disposition = dr.ok;
    var record_atoms: u32 = 0;
    if (!gc_classify(?st, modules, module_count, sec_base, roots.carries_frames, ?record_atoms)) {
        ret res[*DeadRange, fail.Fail].err{fail.message("reachability atom count exceeds the u32 limit")};
    }

    val base_r: res[u32, lang_checked.Cause] = add_u32_counts[GcAtomCountUnit](st.sym_total, sec_total);
    if (sel base_r.err) { ret res[*DeadRange, fail.Fail].err{fail.message("reachability atom count exceeds the u32 limit")}; }
    val cap_r: res[u32, lang_checked.Cause] = add_u32_counts[GcAtomCountUnit](base_r.ok, record_atoms);
    if (sel cap_r.err) { ret res[*DeadRange, fail.Fail].err{fail.message("reachability atom count exceeds the u32 limit")}; }
    st.atom_cap = cap_r.ok;
    val ar: res[*GcAtom, A.Error] = A.zallocate[GcAtom](alloc, st.atom_cap::usize);
    if (sel ar.err) { ret res[*DeadRange, fail.Fail].err{fail.refused(ar.err)}; }
    st.atoms = ar.ok;
    val lr: res[*u8, A.Error] = A.zallocate[u8](alloc, st.atom_cap::usize);
    if (sel lr.err) { ret res[*DeadRange, fail.Fail].err{fail.refused(lr.err)}; }
    st.live = lr.ok;
    val wr: err[fail.Fail] = gc_zallocate_u32(alloc, st.atom_cap, ?st.work);
    if (sel wr.err) { ret res[*DeadRange, fail.Fail].err{wr.err}; }
    val depr: err[fail.Fail] = gc_zallocate_u32(alloc, st.atom_cap, ?st.dependents);
    if (sel depr.err) { ret res[*DeadRange, fail.Fail].err{depr.err}; }
    gc_fill_none(st.dependents, st.atom_cap);
    val fr: err[fail.Fail] = gc_zallocate_u32(alloc, sec_total, ?st.atom_first);
    if (sel fr.err) { ret res[*DeadRange, fail.Fail].err{fr.err}; }
    val cr: err[fail.Fail] = gc_zallocate_u32(alloc, sec_total, ?st.atom_count);
    if (sel cr.err) { ret res[*DeadRange, fail.Fail].err{cr.err}; }
    val slr: res[*u8, A.Error] = A.zallocate[u8](alloc, sec_total::usize);
    if (sel slr.err) { ret res[*DeadRange, fail.Fail].err{fail.refused(slr.err)}; }
    st.sec_live = slr.ok;
    val sdr: err[fail.Fail] = gc_zallocate_u32(alloc, sec_total, ?st.sec_dependent);
    if (sel sdr.err) { ret res[*DeadRange, fail.Fail].err{sdr.err}; }
    gc_fill_none(st.sec_dependent, sec_total);
    val ssr: err[fail.Fail] = gc_zallocate_u32(alloc, sec_total, ?st.sec_sibling);
    if (sel ssr.err) { ret res[*DeadRange, fail.Fail].err{ssr.err}; }
    gc_fill_none(st.sec_sibling, sec_total);
    val gnr: err[fail.Fail] = gc_zallocate_u32(alloc, sec_total, ?st.group_next);
    if (sel gnr.err) { ret res[*DeadRange, fail.Fail].err{gnr.err}; }
    gc_fill_none(st.group_next, sec_total);

    gc_atomize(?st, modules, module_count, sec_base, refs, ref_total, arch);
    val linked: err[fail.Fail] = gc_link_owners(?st, modules, module_count, sec_base, winners, arch);
    if (sel linked.err) { ret res[*DeadRange, fail.Fail].err{linked.err}; }
    gc_mark_roots(?st, modules, module_count, sec_base, winners, roots);
    val propagated: err[fail.Fail] = gc_propagate(?st, modules, module_count, sec_base, winners, arch);
    if (sel propagated.err) { ret res[*DeadRange, fail.Fail].err{propagated.err}; }

    var count: u32 = 0;
    var a:     u32 = 0;
    for (a < st.atom_total) {
        if (st.live[a] == 0 && st.atoms[a].end > st.atoms[a].start) { count = count + 1; }
        a = a + 1;
    }
    if (count == 0) { ret res[*DeadRange, fail.Fail].ok{nil}; }
    val out_r: res[*DeadRange, A.Error] = A.allocate[DeadRange](alloc, count::usize);
    if (sel out_r.err) { ret res[*DeadRange, fail.Fail].err{fail.refused(out_r.err)}; }
    val out: *DeadRange = out_r.ok;
    var w:   u32        = 0;
    a = 0;
    for (a < st.atom_total) {
        if (st.live[a] == 0 && st.atoms[a].end > st.atoms[a].start) {
            out[w].section = st.atoms[a].flat;
            out[w].start   = st.atoms[a].start;
            out[w].end     = st.atoms[a].end;
            w              = w + 1;
        }
        a = a + 1;
    }
    @dead_count = count;
    ret res[*DeadRange, fail.Fail].ok{out};
}
