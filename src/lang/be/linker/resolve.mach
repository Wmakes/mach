use std.collections.map;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use lang_checked:    mach.lang.checked;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.session;
use catalog_artifact: mach.lang.target.catalog.artifact;
use target_of:        mach.lang.target.of;

use mach.lang.be.linker.atoms.AtomPlan;
use mach.lang.be.linker.atoms.atom_live_offset;
use mach.lang.be.linker.atoms.atom_offset_dead;
use mach.lang.be.linker.common.dup_message;
use mach.lang.be.linker.common.name_intern;
use mach.lang.be.linker.common.oor_section_message;
use mach.lang.be.linker.input.InputSet;
use mach.lang.be.linker.input.LinkContext;
use mach.lang.be.linker.merge.Placement;

rec CommonStorageUnit {}

pub rec SymbolLoc {
    vaddr:         u64;
    section_vaddr: u64;
    merged_index:  u32;
    weak:          bool;
    fallback:      intern.StrId;
}

pub fun synthesize_common_storage(ctx: *LinkContext, inputs: *InputSet, out: *target_of.ObjectImage) res[bool, fail.Fail] {
    val s:            *session.Session       = ctx.s;
    val modules:      *target_of.ObjectImage = inputs.images;
    val module_count: u32                    = inputs.count;
    val allocates:    opt[bool]              = catalog_artifact.allocates_commons(ctx.mode);
    if (sel allocates.none) { ret res[bool, fail.Fail].err{fail.unknown_catalog(s.alloc, "artifact kind", ctx.mode::u32)}; }
    if (!allocates.some || modules == nil || module_count == 0) {
        ret res[bool, fail.Fail].ok{false};
    }
    val alloc: *A.Allocator = s.alloc;

    var defined: map.Map[intern.StrId, u32] = map.init[intern.StrId, u32](alloc);
    var slot:    map.Map[intern.StrId, u32] = map.init[intern.StrId, u32](alloc);
    var names:   Vector[intern.StrId]       = collections_vector.init[intern.StrId](alloc);
    var sizes:   Vector[u32]                = collections_vector.init[u32](alloc);
    var aligns:  Vector[u32]                = collections_vector.init[u32](alloc);
    var offs:    Vector[u32]                = collections_vector.init[u32](alloc);
    fin {
        map.dnit[intern.StrId, u32](?defined);
        map.dnit[intern.StrId, u32](?slot);
        collections_vector.dnit[intern.StrId](?names);
        collections_vector.dnit[u32](?sizes);
        collections_vector.dnit[u32](?aligns);
        collections_vector.dnit[u32](?offs);
    }

    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (target_of.section_is_absolute(sym.section)
                || (!target_of.section_is_external(sym.section) && target_of.section_index(sym.section) < modules[m].section_count)) {
                val get_r: opt[*u32] = map.get[intern.StrId, u32](?defined, ?sym.name);
                if (sel get_r.none) {
                    val di: res[bool, A.Error] = map.insert[intern.StrId, u32](?defined, sym.name, 0);
                    if (sel di.err) { ret res[bool, fail.Fail].err{fail.refused(di.err)}; }
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if ((sym.flags & target_of.SYM_OBJ_FLAG_COMMON) == 0) {
                sy = sy + 1;
                cnt;
            }
            val get_r2: opt[*u32] = map.get[intern.StrId, u32](?defined, ?sym.name);
            if (sel get_r2.some) {
                sy = sy + 1;
                cnt;
            }

            var al: u32 = sym.align;
            if (al == 0) { al = 1; }
            val ex: opt[*u32] = map.get[intern.StrId, u32](?slot, ?sym.name);
            if (sel ex.some) {
                val at: u32 = @ex.some;
                if (sym.size > sizes.data[at]) { sizes.data[at] = sym.size; }
                if (al > aligns.data[at])      { aligns.data[at] = al; }
                sy = sy + 1;
                cnt;
            }
            val ins: res[bool, A.Error] = map.insert[intern.StrId, u32](?slot, sym.name, names.len::u32);
            if (sel ins.err) { ret res[bool, fail.Fail].err{fail.refused(ins.err)}; }
            val push_n: res[usize, A.Error] = collections_vector.push[intern.StrId](?names, sym.name);
            if (sel push_n.err) { ret res[bool, fail.Fail].err{fail.refused(push_n.err)}; }
            val push_s: res[usize, A.Error] = collections_vector.push[u32](?sizes, sym.size);
            if (sel push_s.err) { ret res[bool, fail.Fail].err{fail.refused(push_s.err)}; }
            val push_a: res[usize, A.Error] = collections_vector.push[u32](?aligns, al);
            if (sel push_a.err) { ret res[bool, fail.Fail].err{fail.refused(push_a.err)}; }
            sy = sy + 1;
        }
        m = m + 1;
    }
    if (names.len == 0) { ret res[bool, fail.Fail].ok{false}; }

    var total:     lang_checked.Offset[CommonStorageUnit] = lang_checked.offset[CommonStorageUnit](0::usize);
    var sec_align: u32                                    = 1;
    var n:         usize                                  = 0;
    for (n < names.len) {
        if (aligns.data[n] > sec_align) { sec_align = aligns.data[n]; }
        val align_r: res[lang_checked.Alignment[CommonStorageUnit], lang_checked.Cause] =
            lang_checked.alignment[CommonStorageUnit](aligns.data[n]::usize);
        if (sel align_r.err) {
            ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "common storage member has invalid alignment")};
        }
        val aligned_r: res[lang_checked.Offset[CommonStorageUnit], lang_checked.Cause] =
            lang_checked.align_offset_up[CommonStorageUnit](total,
            align_r.ok);
        if (sel aligned_r.err) {
            ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "common storage layout overflow")};
        }
        total = aligned_r.ok;
        if (total.value > 0x7FFFFFFF) {
            ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "common storage exceeds 2 GiB")};
        }
        val push_o: res[usize, A.Error] = collections_vector.push[u32](?offs, total.value::u32);
        if (sel push_o.err) { ret res[bool, fail.Fail].err{fail.refused(push_o.err)}; }
        val grown_r: res[lang_checked.Offset[CommonStorageUnit], lang_checked.Cause] =
            lang_checked.offset_add[CommonStorageUnit](total, lang_checked.count[CommonStorageUnit](sizes.data[n]::usize));
        if (sel grown_r.err) {
            ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.LINK_SIZE_LIMIT, "common storage layout overflow")};
        }
        total = grown_r.ok;
        n     = n + 1;
    }

    val image_name_r: res[intern.StrId, fail.Fail] = name_intern(s, "<common-storage>");
    if (sel image_name_r.err) { ret res[bool, fail.Fail].err{image_name_r.err}; }
    val section_name_r: res[intern.StrId, fail.Fail] = name_intern(s, ".bss");
    if (sel section_name_r.err) { ret res[bool, fail.Fail].err{section_name_r.err}; }
    @out = target_of.object_image_init(alloc, ?s.interner, image_name_r.ok);
    var complete: bool = false;
    fin {
        if (!complete) { target_of.object_image_dnit(out); }
    }
    # each common is its own atom, collected when nothing reaches it
    out.symbol_atoms = true;

    var sec: target_of.Section;
    sec.name  = section_name_r.ok;
    sec.kind  = target_of.SK_BSS;
    sec.bytes = nil;
    sec.len   = total.value::u32;
    sec.align = sec_align;
    sec.flags = 0;
    val sec_r: res[u32, fail.Fail] = target_of.section_install(out, ?sec);
    if (sel sec_r.err) { ret res[bool, fail.Fail].err{sec_r.err}; }
    val sec_ix: u32 = sec_r.ok;

    n = 0;
    for (n < names.len) {
        var osym: target_of.Symbol;
        osym.name     = names.data[n];
        osym.section  = target_of.section_id(sec_ix);
        osym.offset   = offs.data[n];
        osym.size     = sizes.data[n];
        osym.flags    = target_of.SYM_OBJ_FLAG_GLOBAL | target_of.SYM_OBJ_FLAG_OBJECT;
        osym.fallback = target_of.SYMBOL_NONE;
        osym.align    = aligns.data[n];
        val sa: res[u32, fail.Fail] = target_of.symbol_add(out, osym);
        if (sel sa.err) { ret res[bool, fail.Fail].err{sa.err}; }
        n = n + 1;
    }

    val valid: err[fail.Fail] = target_of.validate_owned_object(out);
    if (sel valid.err) { ret res[bool, fail.Fail].err{valid.err}; }
    complete = true;
    ret res[bool, fail.Fail].ok{true};
}

pub fun weak_fallback_name(img: *target_of.ObjectImage,
    sym: *target_of.Symbol) res[intern.StrId, fail.Fail] {
    if ((sym.flags & target_of.SYM_OBJ_FLAG_FALLBACK) == 0) {
        ret res[intern.StrId, fail.Fail].err{fail.message("symbol has no weak fallback")};
    }
    if (sym.fallback >= img.symbol_count || sym.fallback == target_of.SYMBOL_NONE) {
        ret res[intern.StrId, fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "weak fallback index is out of range")};
    }
    ret res[intern.StrId, fail.Fail].ok{img.symbols[sym.fallback].name};
}

pub fun resolved_symbol_name(sym_locs: *map.Map[intern.StrId, SymbolLoc],
    name: intern.StrId) res[intern.StrId, fail.Fail] {
    var cur:  intern.StrId = name;
    var hops: usize        = 0;
    for (hops <= sym_locs.len) {
        val lr: opt[*SymbolLoc] =
            map.get[intern.StrId, SymbolLoc](sym_locs, ?cur);
        if (sel lr.none) {
            ret res[intern.StrId, fail.Fail].ok{cur};
        }
        val loc: *SymbolLoc = lr.some;
        if (intern.str_is_nil(loc.fallback)) {
            ret res[intern.StrId, fail.Fail].ok{cur};
        }
        cur  = loc.fallback;
        hops = hops + 1;
    }
    ret res[intern.StrId, fail.Fail].err{fail.user(diagnostic_kind.LINK_WEAK_FALLBACK, "weak fallback cycle")};
}

pub fun collect_symbols(s: *session.Session, modules: *target_of.ObjectImage, module_count: u32,
    placements: *Placement, sec_base: *u32,
    sym_locs: *map.Map[intern.StrId, SymbolLoc], have_vaddrs: bool,
    atoms: *AtomPlan) err[fail.Fail] {
    var m: u32 = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (target_of.section_is_external(sym.section)) {
                sy = sy + 1;
                cnt;
            }
            if (!target_of.section_is_absolute(sym.section) && target_of.section_index(sym.section) >= modules[m].section_count) {
                ret err[fail.Fail].err{fail.user_of(diagnostic_kind.OBJECT_MALFORMED, oor_section_message(s, sym.name, modules[m].name))};
            }
            if ((sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) == 0) {
                sy = sy + 1;
                cnt;
            }

            val is_weak:       bool = (sym.flags & target_of.SYM_OBJ_FLAG_WEAK) != 0;
            var vaddr:         u64  = sym.absolute_value;
            var section_vaddr: u64  = 0;
            var merged_index:  u32  = target_of.SECTION_ABSOLUTE;
            if (!target_of.section_is_absolute(sym.section)) {
                val flat: u32 = sec_base[m] + target_of.section_index(sym.section);
                if (atom_offset_dead(atoms, flat, sym.offset)) {
                    sy = sy + 1;
                    cnt;
                }
                val pl: *Placement = ?placements[flat];
                merged_index = pl.merged_index;
                vaddr        = 0;
                if (have_vaddrs) {
                    vaddr         = pl.vaddr + atom_live_offset(atoms, flat, sym.offset)::u64;
                    section_vaddr = pl.vaddr - pl.offset::u64;
                }
            }

            val existing: opt[*SymbolLoc] =
                map.get[intern.StrId, SymbolLoc](sym_locs, ?sym.name);
            if (sel existing.some) {
                val cur: *SymbolLoc = existing.some;
                if (is_weak) {
                    sy = sy + 1;
                    cnt;
                }
                if (!cur.weak) { ret err[fail.Fail].err{fail.user_of(diagnostic_kind.LINK_DUPLICATE_SYMBOL, dup_message(s, sym.name))}; }
                cur.vaddr         = vaddr;
                cur.section_vaddr = section_vaddr;
                cur.merged_index  = merged_index;
                cur.weak          = false;
                cur.fallback      = intern.STR_NIL;
                sy                = sy + 1;
                cnt;
            }

            var loc: SymbolLoc;
            loc.vaddr         = vaddr;
            loc.section_vaddr = section_vaddr;
            loc.merged_index  = merged_index;
            loc.weak          = is_weak;
            loc.fallback      = intern.STR_NIL;

            val ins: res[bool, A.Error] =
                map.insert[intern.StrId, SymbolLoc](sym_locs, sym.name, loc);
            if (sel ins.err) {
                ret err[fail.Fail].err{fail.refused(ins.err)};
            }

            sy = sy + 1;
        }
        m = m + 1;
    }

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if (!is_undefined_extern(sym)
                || (sym.flags & target_of.SYM_OBJ_FLAG_FALLBACK) == 0) {
                sy = sy + 1;
                cnt;
            }
            val fr: res[intern.StrId, fail.Fail] = weak_fallback_name(?modules[m], sym);
            if (sel fr.err) {
                ret err[fail.Fail].err{fr.err};
            }
            val fallback: intern.StrId = fr.ok;
            if (intern.str_is_nil(fallback)) {
                ret err[fail.Fail].err{fail.user(diagnostic_kind.OBJECT_MALFORMED, "weak fallback has no symbol name")};
            }
            val existing: opt[*SymbolLoc] =
                map.get[intern.StrId, SymbolLoc](sym_locs, ?sym.name);
            if (sel existing.some) {
                val cur: *SymbolLoc = existing.some;
                if (!intern.str_is_nil(cur.fallback) && !intern.str_same(cur.fallback, fallback)) {
                    ret err[fail.Fail].err{fail.user(diagnostic_kind.LINK_WEAK_FALLBACK, "conflicting weak fallback targets")};
                }
            }
            if (sel existing.none) {
                var loc: SymbolLoc;
                loc.vaddr         = 0;
                loc.section_vaddr = 0;
                loc.merged_index  = 0;
                loc.weak          = true;
                loc.fallback      = fallback;
                val ir: res[bool, A.Error] =
                    map.insert[intern.StrId, SymbolLoc](sym_locs, sym.name, loc);
                if (sel ir.err) {
                    ret err[fail.Fail].err{fail.refused(ir.err)};
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }

    m = 0;
    for (m < module_count) {
        var sy: u32 = 0;
        for (sy < modules[m].symbol_count) {
            val sym: *target_of.Symbol = ?modules[m].symbols[sy];
            if ((sym.flags & target_of.SYM_OBJ_FLAG_FALLBACK) != 0) {
                val rr: res[intern.StrId, fail.Fail] =
                    resolved_symbol_name(sym_locs, sym.name);
                if (sel rr.err) {
                    ret err[fail.Fail].err{rr.err};
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun is_undefined_extern(sym: *target_of.Symbol) bool {
    if (!target_of.section_is_external(sym.section))      { ret false; }
    if ((sym.flags & target_of.SYM_OBJ_FLAG_GLOBAL) == 0) { ret false; }
    ret true;
}
