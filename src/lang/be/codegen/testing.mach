#[testing]
pub fun defined_fn_exact(s: *session.Session, m: *me_ir.Module, name: str) u32 {
    if (m == nil) { ret 0; }
    var hits: u32 = 0;
    var fi:   u32 = 0;
    for (fi < m.function_len) {
        val f: *me_ir.Function = ?m.functions[fi];
        if ((f.flags & me_ir.FN_FLAG_EXTERN) == 0) {
            val nm: opt[str] = intern.get(?s.interner, f.name);
            if (sel nm.some && str_equals(nm.some, name)) { hits = hits + 1; }
        }
        fi = fi + 1;
    }
    ret hits;
}

#[testing]
pub fun app(buf: *u8, w: usize, text: str) usize {
    var i: usize = 0;
    var k: usize = w;
    for (i < str_len(text)) {
        buf[k] = text[i];
        k      = k + 1;
        i      = i + 1;
    }
    ret k;
}

#[testing]
pub val RV32_MEM: usize = 262144;

#[testing]
val RV32_CODE: u32 = 0x1000;

#[testing]
val RV32_STACK: u32 = 0x3FFF0;

#[testing]
pub fun rv32_run(mem: *u8, off: u32, args: *u32, nargs: u32,
    lo: *u32, hi: *u32, steps: *u32) bool {
    var core: refcore.Core;
    var i:    usize = 0;
    for (i < 32) {
        core.x[i] = 0;
        core.f[i] = 0;
        i         = i + 1;
    }
    core.frm     = 0;
    core.refused = "";

    core.x[1] = refcore.RETURN_SENTINEL;
    core.x[2] = RV32_STACK;
    core.pc   = RV32_CODE + off;

    var k: u32 = 0;
    for (k < nargs && k < 8) {
        core.x[(10 + k)::usize] = args[k];
        k                       = k + 1;
    }
    for (k < nargs) {
        val at: u32 = RV32_STACK + (k - 8) * 4;
        var b:  u32 = 0;
        for (b < 4) {
            mem[(at + b)::usize] = ((args[k] >> (b * 8)) & 0xFF)::u8;
            b                    = b + 1;
        }
        k = k + 1;
    }

    if (!refcore.exec_reference(mem, RV32_MEM, ?core)) { ret false; }
    @lo    = core.x[10];
    @hi    = core.x[11];
    @steps = core.steps;
    ret true;
}

#[testing]
pub val RV32_MUL: u32 = 0;

#[testing]
pub val RV32_XOR: u32 = 1;

#[testing]
pub val RV32_ADD: u32 = 2;

#[testing]
pub val RV32_EQ: u32 = 3;

#[testing]
pub val RV32_LTU: u32 = 4;

#[testing]
pub val RV32_LTS: u32 = 5;

#[testing]
pub val RV32_SHL: u32 = 6;

#[testing]
pub val RV32_SHRU: u32 = 7;

#[testing]
pub val RV32_SHRS: u32 = 8;

#[testing]
pub val RV32_DIVU: u32 = 9;

#[testing]
val RV32_FNS: u32 = 11;

#[testing]
fun rv32_probe_name(slot: u32) str {
    if (slot == RV32_MUL)  { ret "mul64"; }
    if (slot == RV32_XOR)  { ret "xor64"; }
    if (slot == RV32_ADD)  { ret "add64"; }
    if (slot == RV32_EQ)   { ret "eq64"; }
    if (slot == RV32_LTU)  { ret "ltu64"; }
    if (slot == RV32_LTS)  { ret "lts64"; }
    if (slot == RV32_SHL)  { ret "shl64"; }
    if (slot == RV32_SHRU) { ret "shru64"; }
    if (slot == RV32_SHRS) { ret "shrs64"; }
    if (slot == RV32_DIVU) { ret "divu64"; }
    ret "remu64";
}

# the linkage name of the one defined function a probe name tails, which the
# captured link must keep because only the sweep reaches it
#[testing]
fun rv32_probe_symbol(images: *target_of.ObjectImage, count: u32, itn: *intern.Interner, want: str, out: *str) bool {
    var hits: u32 = 0;
    var m:    u32 = 0;
    for (m < count) {
        var sy: u32 = 0;
        for (sy < images[m].symbol_count) {
            val sym:     *target_of.Symbol = ?images[m].symbols[sy];
            val looked:  opt[str]          = intern.get(itn, sym.name);
            val defined: bool              = (sym.flags & target_of.SYM_OBJ_FLAG_FUNCTION) != 0 && !target_of.section_is_external(sym.section);
            if (sel looked.some) {
                val nm: str = looked.some;
                if (defined && name_tail_is(nm, want)) {
                    hits = hits + 1;
                    @out = nm;
                }
            }
            sy = sy + 1;
        }
        m = m + 1;
    }
    ret hits == 1;
}

#[testing]
fun rv32_probe_offset(img: *linker.CapturedImage, itn: *intern.Interner, want: str, off: *u32) bool {
    var hits:  u32 = 0;
    var found: u64 = 0;
    var i:     u32 = 0;
    for (i < img.symbol_count) {
        val looked: opt[str] = intern.get(itn, img.symbols[i].name);
        if (sel looked.some) {
            val nm: str = looked.some;
            if (name_tail_is(nm, want)) {
                hits  = hits + 1;
                found = img.symbols[i].vaddr;
            }
        }
        i = i + 1;
    }
    if (hits != 1) { ret false; }
    @off = (found - img.base)::u32;
    ret true;
}

#[testing]
pub fun name_tail_is(name: str, tail: str) bool {
    val n: usize = str_len(name);
    val t: usize = str_len(tail);
    if (t == 0 || t > n)                 { ret false; }
    if (n > t && name[n - t - 1] != '.') { ret false; }
    var i: usize = 0;
    for (i < t) {
        if (name[n - t + i] != tail[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
pub fun rv32_link_captured(p: *project.Project, mem: *u8, len_out: *u32, offs: *u32) bool {
    val alloc: *A.Allocator = p.alloc;
    if (p.emit_len == 0) { ret false; }

    val ir: res[*target_of.ObjectImage, A.Error] = A.allocate[target_of.ObjectImage](alloc, p.emit_len::usize);
    if (sel ir.err) { ret false; }
    val images:  *target_of.ObjectImage = ir.ok;
    var missing: bool                   = false;
    var i:       u32                    = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, (p.topo[i])::u32);
        if (m.object_image == nil) { missing = true; }
        or                         { images[i] = @m.object_image; }
        i = i + 1;
    }

    var probes:      [RV32_FNS]str;
    var probe_count: u32 = 0;
    if (offs != nil) { probe_count = RV32_FNS; }
    var pk: u32 = 0;
    for (!missing && pk < probe_count) {
        if (!rv32_probe_symbol(images, p.emit_len, ?p.s.interner, rv32_probe_name(pk), ?probes[pk])) {
            missing = true;
        }
        pk = pk + 1;
    }
    var cap:    linker.CapturedImage;
    var linked: bool = false;
    if (!missing) {
        val lr: err[fail.Fail] = linker.link_images_captured(p.s, ?p.linkage, ?p.diags, ?p.target, images,
            p.emit_len, nil::*target_of.DynLib, 0, "rv32probe"::*u8, false,
            target_of.image_options_default(catalog_subsystem.CONSOLE), ?probes[0], probe_count, ?cap);
        linked = sel lr.ok;
    }
    A.deallocate[target_of.ObjectImage](alloc, images, p.emit_len::usize);
    if (!linked) { ret false; }

    var ok: bool = cap.len > 0 && RV32_CODE::usize + cap.len < RV32_STACK::usize;
    if (ok && offs != nil) {
        var k: u32 = 0;
        for (k < RV32_FNS) {
            if (!rv32_probe_offset(?cap, ?p.s.interner, rv32_probe_name(k), ?offs[k])) { ok = false; }
            k = k + 1;
        }
    }
    if (ok) {
        var z: usize = 0;
        for (z < RV32_MEM) {
            mem[z] = 0;
            z      = z + 1;
        }
        z = 0;
        for (z < cap.len) {
            mem[RV32_CODE::usize + z] = cap.bytes[z];
            z                         = z + 1;
        }
        @len_out = cap.len::u32;
    }
    linker.captured_image_dnit(?cap, alloc);
    ret ok;
}

#[testing]
pub fun rv32_build_linked(s: *session.Session, alloc: *A.Allocator, src: str, tgt: str,
    mem: *u8, len_out: *u32) bool {
    ret rv32_build_linked_at(s, alloc, ct_edge_manifest(), "", src, tgt, mem, len_out);
}

#[testing]
pub fun rv32_build_linked_at(s: *session.Session, alloc: *A.Allocator, manifest_text: str, profile: str,
    src: str, tgt: str, mem: *u8, len_out: *u32) bool {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = driver.scaffold(alloc, manifest_text, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret false; }
    val root: str = root_r.ok;

    var ok:         bool                            = false;
    var tsel_12976: manifest.Selectors              = manifest.t_selectors("", tgt, profile);
    val pr:         res[project.Project, fail.Fail] = driver.build_project(s, root, ?tsel_12976);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (run_codegen_ok(?p) == 0) { ok = rv32_link_captured(?p, mem, len_out, nil::*u32); }
        project.dnit_project(?p);
    }
    fs.remove_all(alloc, root);
    ret ok;
}

#[testing]
pub fun divide_manifest() str {
    ret "[project]\nmach = \">=5\"\nid = \"divtrap\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.linux-x86_64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[artifact.divtrap]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/divtrap\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
}

# the pipeline's verdict on one program: 0 accepted, 1 rejected (a reported diagnostic, or the constant-time
# validator's refusal, which the backend still surfaces as an internal failure naming the oblivious function), -1 apparatus
#[testing]
pub fun pipeline_verdict(alloc: *A.Allocator, text: str, found: pipeline.OptLevel) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val root_r: res[str, fail.Fail] = driver.scaffold(alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret -1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    val pr: res[project.Project, fail.Fail] = back_half_opt(?s, root, found);
    if (sel pr.err) {
        val f: fail.Fail = pr.err;
        if (sel f.reported)                                                  { ret 1; }
        if (sel f.message && str_contains(fail.describe(f), "#[oblivious]")) { ret 1; }
        ret -1;
    }
    var p: project.Project = pr.ok;
    project.dnit_project(?p);
    ret 0;
}

# the freestanding entry stub shared by the native tag fixtures
#[testing]
pub fun tag_start_stub() str {
    ret "\n#[symbol(\"_start\")]\npub fun start() {\n    $if ($mach.build.arch == $mach.arch.x86_64) {\n        asm x86_64 {\n            mov rdi, [rsp]\n            and rsp, -16\n            call main\n            mov rdi, rax\n            mov rax, 60\n            syscall\n        }\n    }\n    $or ($mach.build.arch == $mach.arch.aarch64) {\n        asm aarch64 {\n            ldr x0, [sp]\n            bl main\n            mov x8, 93\n            svc 0\n        }\n    }\n    $or {\n        asm riscv64 {\n            ld a0, 0(sp)\n            call main\n            li a7, 93\n            ecall\n        }\n    }\n}\n";
}

# builds a freestanding tag fixture for one target and profile and runs it; the fixture exits 0 when every check holds
#[testing]
pub fun tag_native_case(alloc: *A.Allocator, target_name: str, runner_name: str, release: bool, program: str, label: str) i32 {
    ret tag_native_case_files(alloc, divide_manifest(), nil, nil, 0, target_name, runner_name, release, program, label);
}

# the same with the project's manifest and extra files at the project root (a C probe and the script that compiles it)
#[testing]
pub fun tag_native_case_files(alloc: *A.Allocator, manifest_text: str, root_names: *str, root_texts: *str, root_count: u32,
    target_name: str, runner_name: str, release: bool, program: str, label: str) i32 {
    var runner: str = "";
    if (!str_empty(runner_name)) {
        val rr: res[str, exec.Error] = exec.resolve(alloc, runner_name);
        if (sel rr.err) {
            print.print("tag-native: runner absent, arm skipped: ");
            print.print(runner_name);
            print.print("\n");
            ret 0;
        }
        runner = rr.ok;
    }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = program;
    if (root_count == 0) { texts[0] = driver.joined(alloc, program, "\n", tag_start_stub()); }
    val root_r: res[str, fail.Fail] = driver.scaffold(alloc, manifest_text, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    var ri:   u32 = 0;
    for (ri < root_count) {
        val fp:            str             = driver.joined(alloc, root, "/", root_names[ri]);
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(fp, root_texts[ri], str_len(root_texts[ri]), 420);
        if (sel write_bytes_r.err) {
            fs.remove_all(alloc, root);
            ret 1;
        }
        ri = ri + 1;
    }

    var bad: i32                               = 0;
    val mr:  res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) {
        fs.remove_all(alloc, root);
        ret 1;
    }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = target_name;
    if (release) {
        rq.profile = "release";
        rq.opt     = pipeline.OPT_RELEASE;
    }
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan_to_run(alloc, ?s, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) {
        fs.remove_all(alloc, root);
        ret 1;
    }
    var bp:        build_plan.BuildPlan     = pr.ok;
    var published: publication.Publications = publication.init(alloc);
    fin { publication.dnit(?published); }
    val br: res[outcome.BuildOutcome, fail.Fail] = engine.execute_warm(?bp, 0, ?s, ?published, alloc, nil);
    if (sel br.err) {
        print.print("tag-native: build failed for ");
        print.print(label);
        print.print(" on ");
        print.print(target_name);
        print.print("\n");
        bad = 2;
    }
    if (sel br.ok) {
        val bo: outcome.BuildOutcome = br.ok;
        if (bo.severity != outcome.BUILD_OK || bo.artifacts.len != 1) { bad = 3; }
        or {
            var trapped: bool = false;
            var code:    i32  = 0;
            if (!engine.run_with_argc(root, runner, bo.artifacts.data[0].path, 1, ?trapped, ?code)) { bad = 4; }
            or (trapped || code != 0) {
                print.print("tag-native: ");
                print.print(label);
                print.print(" on ");
                print.print(target_name);
                var profile_name: str = "debug";
                if (release) { profile_name = "release"; }
                print.print(" ");
                print.print(profile_name);
                print.printf(" (trapped {}, exit {})\n", trapped::u8, code);
                bad = 5;
            }
        }
    }
    val remove_all_r: err[fs.FsError] = fs.remove_all(alloc, root);
    if (sel remove_all_r.err) { bad = 6; }
    ret bad;
}

# runs one fixture on the three native linux targets in both profiles
#[testing]
pub fun tag_native_all(alloc: *A.Allocator, program: str, label: str) i32 {
    var release: bool = false;
    var pass:    u32  = 0;
    for (pass < 2) {
        if (tag_native_case(alloc, "linux-x86_64", "", release, program, label) != 0)              { ret 1; }
        if (tag_native_case(alloc, "linux-arm64", "qemu-aarch64", release, program, label) != 0)   { ret 2; }
        if (tag_native_case(alloc, "linux-riscv64", "qemu-riscv64", release, program, label) != 0) { ret 3; }
        release = true;
        pass    = pass + 1;
    }
    ret 0;
}

# true when sema, lowering or codegen rejects the text with a diagnostic carrying the needle
#[testing]
pub fun pipeline_rejects_with(alloc: *A.Allocator, text: str, needle: str) bool {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;
    val root_r: res[str, fail.Fail] = driver.scaffold(alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret false; }
    val root: str = root_r.ok;
    fin { fs.remove_all(alloc, root); }
    val pr: res[project.Project, fail.Fail] = back_half_opt(?s, root, pipeline.OPT_DEBUG);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
        ret false;
    }
    ret fail.is_reported(pr.err) && diagnostic.error_says(?s.diags, needle);
}

#[testing]
pub fun spv_manifest(alloc: *A.Allocator, dep_alias: str) str {
    val head: str = "[project]\nmach = \">=5\"\nid = \"spvcase\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[profile.debug]\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n\n[artifact.spvcase]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/spvcase\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
    if (str_len(dep_alias) == 0::usize) { ret head; }
    val a: str = driver.joined(alloc, head, "\n[dep.", dep_alias);
    val b: str = driver.joined(alloc, a, "]\npath = \"", dep_alias);
    ret driver.joined(alloc, b, "\"\n", "");
}

#[testing]
fun spv_dep_manifest(alloc: *A.Allocator, id: str) str {
    ret driver.joined(alloc, "[project]\nmach = \">=5\"\nid = \"", id, "\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[profile.debug]\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n");
}

#[testing]
pub fun write_node_multi(alloc: *A.Allocator, dir: str, manifest_text: str,
    names: *str, texts: *str, n: u32) err[fail.Fail] {
    val d1: err[fs.FsError] = fs.create_dir_all(alloc, dir, 493);
    if (sel d1.err) { ret err[fail.Fail].err{fail.fs_refused(d1.err)}; }
    val src_dir: str             = driver.joined(alloc, dir, "/", "src");
    val d2:      err[fs.FsError] = fs.create_dir_all(alloc, src_dir, 493);
    if (sel d2.err) { ret err[fail.Fail].err{fail.fs_refused(d2.err)}; }
    val mf: str             = driver.joined(alloc, dir, "/", manifest.MANIFEST_FILE);
    val w0: err[fs.FsError] = fs.write_bytes(mf, manifest_text, str_len(manifest_text), 420);
    if (sel w0.err) { ret err[fail.Fail].err{fail.fs_refused(w0.err)}; }
    var i: u32 = 0;
    for (i < n) {
        val sf: str             = driver.joined(alloc, src_dir, "/", names[i]);
        val w:  err[fs.FsError] = fs.write_bytes(sf, texts[i], str_len(texts[i]), 420);
        if (sel w.err) { ret err[fail.Fail].err{fail.fs_refused(w.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
pub fun spv_lower(s: *session.Session, alloc: *A.Allocator,
    names: *str, texts: *str, n: u32,
    dep_id: str, dep_names: *str, dep_texts: *str, dep_n: u32) res[project.Project, fail.Fail] {
    ret spv_lower_debug(s, alloc, names, texts, n, dep_id, dep_names, dep_texts, dep_n, false);
}

#[testing]
pub fun spv_lower_debug(s: *session.Session, alloc: *A.Allocator,
    names: *str, texts: *str, n: u32,
    dep_id: str, dep_names: *str, dep_texts: *str, dep_n: u32, debug: bool) res[project.Project, fail.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_spv_test");
    if (sel tf_r.err) { ret res[project.Project, fail.Fail].err{fail.message(fail.fs_text(tf_r.err))}; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret res[project.Project, fail.Fail].err{fail.refused(dup_r.err)}; }
    val root: str = dup_r.ok;

    var alias: str = "";
    if (dep_n > 0) { alias = dep_id; }
    val wr: err[fail.Fail] = write_node_multi(alloc, root, spv_manifest(alloc, alias), names, texts, n);
    if (sel wr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, fail.Fail].err{wr.err};
    }

    if (dep_n > 0) {
        val dep_dir: str            = driver.joined(alloc, root, "/dep/", dep_id);
        val dw:      err[fail.Fail] = write_node_multi(alloc, dep_dir, spv_dep_manifest(alloc, dep_id), dep_names, dep_texts, dep_n);
        if (sel dw.err) {
            fs.remove_all(alloc, root);
            ret res[project.Project, fail.Fail].err{dw.err};
        }
        if (!git.scratch_repo(alloc, root, "https://example.invalid/spvcase.git")) {
            fs.remove_all(alloc, root);
            ret res[project.Project, fail.Fail].err{fail.user(diagnostic_kind.FS_WRITE, "failed to initialize SPIR-V dependency fixture repository")};
        }
    }

    # git under a dependency fixture stays inside its scratch tree
    if (dep_n > 0) { s.environ = git.scratch_environ(); }
    var tsel_14660: manifest.Selectors              = manifest.t_selectors("", "spirv", "");
    val pr:         res[project.Project, fail.Fail] = driver.build_project(s, root, ?tsel_14660);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p:      project.Project = pr.ok;
    var handed: bool            = false;
    fin {
        if (!handed) { project.dnit_project(?p); }
    }
    var req: request.BuildRequest = p.req;
    req.debug = debug;
    val reconfigured: err[fail.Fail] = driver.reconfigure(?p, req);
    if (sel reconfigured.err) { ret res[project.Project, fail.Fail].err{reconfigured.err}; }

    val sr2: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel sr2.err) { ret res[project.Project, fail.Fail].err{sr2.err}; }
    val lr: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel lr.err) { ret res[project.Project, fail.Fail].err{lr.err}; }
    handed = true;
    ret res[project.Project, fail.Fail].ok{p};
}

#[testing]
pub fun spv_diag_fired(alloc: *A.Allocator, src: str, needle: str) bool {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret false; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;
    val pr: res[project.Project, fail.Fail] = spv_lower(?s, alloc, ?names[0], ?texts[0], 1, "", nil, nil, 0);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }
    val fired: bool = diagnostic.error_says(?s.diags, needle);
    session.dnit(?s);
    ret fired;
}

#[testing]
pub fun manifest_x64_linux() str {
    ret "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{target.name}/{profile.name}\"\n\n[target.lx64]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.work}/bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = true\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n";
}

#[testing]
pub fun le16(b: *u8, off: usize) u64 {
    ret b[off]::u64 | (b[off + 1]::u64 << 8);
}

#[testing]
pub fun le32(b: *u8, off: usize) u64 {
    ret b[off]::u64 | (b[off + 1]::u64 << 8) | (b[off + 2]::u64 << 16) | (b[off + 3]::u64 << 24);
}

#[testing]
pub fun agg_call_src() str {
    ret "rec Small { a: u32; b: u32; }\nrec Big { a: u32; b: u32; c: u32; d: u32; e: u32; f: u32; g: u32; h: u32; }\nrec Inner { x: u32; y: u32; }\nrec Nest { i: Inner; z: u32; }\nrec WithArr { v: [4]u32; t: u32; }\nrec WithVec { v: u32x4; t: u32; }\n\nfun sum_small(p: Small) u32 { ret p.a + p.b * 10; }\nfun make_small() Small { ret Small{a: 7, b: 6}; }\nfun sum_big(p: Big) u32 { ret p.a + p.b * 10 + p.c * 100 + p.d * 1000 + p.e * 10000 + p.f * 100000 + p.g * 1000000 + p.h * 10000000; }\nfun sum_nest(p: Nest) u32 { ret p.i.x + p.i.y * 10 + p.z * 100; }\nfun sum_arr(p: WithArr) u32 { ret p.v[0] + p.v[1] * 10 + p.v[2] * 100 + p.v[3] * 1000 + p.t * 10000; }\nfun sum_vec(p: WithVec) u32 { ret p.v[0] + p.v[1] * 10 + p.v[2] * 100 + p.v[3] * 1000 + p.t * 10000; }\n\n#[output(0)] var o_small: u32;\n#[output(1)] var o_small_ctl: u32;\n#[output(2)] var o_ret: u32;\n#[output(3)] var o_big: u32;\n#[output(4)] var o_big_ctl: u32;\n#[output(5)] var o_nest: u32;\n#[output(6)] var o_nest_ctl: u32;\n#[output(7)] var o_arr: u32;\n#[output(8)] var o_arr_ctl: u32;\n#[output(9)] var o_vec: u32;\n#[output(10)] var o_vec_ctl: u32;\n\n#[stage(\"vertex\")]\nfun vs() {\n    val s: Small = Small{a: 7, b: 6};\n    o_small = sum_small(s);\n    o_small_ctl = s.a + s.b * 10;\n\n    val r: Small = make_small();\n    o_ret = r.a + r.b * 10;\n\n    val b: Big = Big{a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8};\n    o_big = sum_big(b);\n    o_big_ctl = b.a + b.b * 10 + b.c * 100 + b.d * 1000 + b.e * 10000 + b.f * 100000 + b.g * 1000000 + b.h * 10000000;\n\n    val nn: Nest = Nest{i: Inner{x: 4, y: 3}, z: 2};\n    o_nest = sum_nest(nn);\n    o_nest_ctl = nn.i.x + nn.i.y * 10 + nn.z * 100;\n\n    val wa: WithArr = WithArr{v: [4]u32{9, 8, 7, 6}, t: 5};\n    o_arr = sum_arr(wa);\n    o_arr_ctl = wa.v[0] + wa.v[1] * 10 + wa.v[2] * 100 + wa.v[3] * 1000 + wa.t * 10000;\n\n    val qv: WithVec = WithVec{v: u32x4{2, 3, 4, 5}, t: 1};\n    o_vec = sum_vec(qv);\n    o_vec_ctl = qv.v[0] + qv.v[1] * 10 + qv.v[2] * 100 + qv.v[3] * 1000 + qv.t * 10000;\n}\n\nfun main() i32 { ret 0; }\n";
}

# the first error the store holds after a rejected pass, or the failure's
# own text when the pass failed without reporting
#[testing]
pub fun codegen_outcome_text(s: *session.Session, f: fail.Fail) str {
    if (!fail.is_reported(f)) { ret fail.describe(f); }
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (diagnostic_kind.is_error(d.kind)) { ret d.message; }
        i = i + 1;
    }
    ret fail.describe(f);
}

#[testing]
pub fun planned_link_images(s: *session.Session, l: *linkage.Linkage, tgt: *lang_target.Binding, images: *target_of.ObjectImage,
    image_count: u32, dynlibs: *target_of.DynLib, dynlib_count: u32,
    out_path: *u8, name: *u8, mode: catalog_artifact.Kind, pie: bool,
    image_options: target_of.ImageOptions) err[fail.Fail] {
    if (out_path == nil || str_len(out_path::str) == 0) { ret linker.link_images(s, l, ?s.diags, tgt, images, image_count, dynlibs, dynlib_count, nil, name, mode, pie, image_options); }
    ret linker.link_images(s, l, ?s.diags, tgt, images, image_count, dynlibs, dynlib_count, out_path::str, name, mode, pie, image_options);
}

#[testing]
pub fun ext_manifest(alloc: *A.Allocator, isa_name: str, os_name: str, abi_name: str, exts: str) str {
    var line: str = "";
    if (str_len(exts) != 0) {
        val l: res[str, std_format.FormatError] = std_format.sprint(alloc, "extensions = {}\n", exts);
        if (sel l.err) { ret ""; }
        line = l.ok;
    }
    val r: res[str, std_format.FormatError] = std_format.sprint(alloc,
        "[project]\nmach = \">=5\"\nid = \"exts\"\nversion = \"0.0.0\"\nsrc = \"src\"\nwork = \"out/{{target.name}}/{{profile.name}}\"\n\n[target.t]\nisa = \"{}\"\nos = \"{}\"\nabi = \"{}\"\n{}\n[artifact.exts]\nkind = \"static\"\nentry = \"main.mach\"\nout = \"{{project.work}}/lib/exts.a\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\noptimize = false\ndebug = false\nsimd = \"scalarize\"\n[profile.release]\noptimize = true\ndebug = false\nsimd = \"scalarize\"\n",
        isa_name, os_name, abi_name, line);
    if (sel r.err) { ret ""; }
    ret r.ok;
}
