#[testing]
pub fun inline_function(s: *session.Session, m: *me_ir.Module, name: str) *me_ir.Function {
    if (m == nil) { ret nil; }
    var i: u32 = 0;
    for (i < m.function_len) {
        if (project.id_is(?s.interner, m.functions[i].name, name)) { ret ?m.functions[i]; }
        i = i + 1;
    }
    ret nil;
}

#[testing]
pub fun inline_ops(fn: *me_ir.Function, kind: ir_instruction.InstrKind) u32 {
    if (fn == nil) { ret 0xFFFFFFFF; }
    var count: u32 = 0;
    var bi:    u32 = 0;
    for (bi < fn.block_count) {
        val block: *me_ir.Block = ?fn.blocks[bi];
        var ii:    u32          = 0;
        for (ii < block.instr_count) {
            val ins: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, block.instructions[ii]);
            if (sel ins.some && ins.some.kind == kind) { count = count + 1; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret count;
}

#[testing]
pub fun inline_calls_of(s: *session.Session, m: *me_ir.Module, name: str) u32 {
    ret inline_ops(inline_function(s, m, name), ir_instruction.OP_CALL);
}

#[testing]
pub fun inline_asm_body_has(s: *session.Session, fn: *me_ir.Function, ordinal: u32, needle: str) bool {
    var seen: u32 = 0;
    var bi:   u32 = 0;
    for (bi < fn.block_count) {
        var ii: u32 = 0;
        for (ii < fn.blocks[bi].instr_count) {
            val iid: me_ir.InstructionId              = fn.blocks[bi].instructions[ii];
            val ins: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, iid);
            if (sel ins.some && ins.some.kind == ir_instruction.OP_ASM) {
                if (seen == ordinal) {
                    var key:     me_ir.InstructionId = iid;
                    val payload: opt[*me_ir.IrAsm]   = map.get[me_ir.InstructionId, me_ir.IrAsm](?fn.asm_blocks, ?key);
                    if (sel payload.none) { ret false; }
                    val body: opt[str] = intern.get(?s.interner, payload.some.body);
                    ret sel body.some && str_contains(body.some, needle);
                }
                seen = seen + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

#[testing]
pub fun back_half_opt(s: *session.Session, root: str, found: pipeline.OptLevel) res[project.Project, fail.Fail] {
    var pick: manifest.Selectors              = manifest.t_selectors("", "", "");
    val pr:   res[project.Project, fail.Fail] = driver.build_project(s, root, ?pick);
    if (sel pr.err) { ret pr; }
    var p:      project.Project = pr.ok;
