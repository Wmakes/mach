    }
    var req: request.BuildRequest = p.req;
    req.opt = found;
    val reconfigured: err[fail.Fail] = driver.reconfigure(?p, req);
    if (sel reconfigured.err) { ret res[project.Project, fail.Fail].err{reconfigured.err}; }
    val rs: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel rs.err) { ret res[project.Project, fail.Fail].err{rs.err}; }
    val rl: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel rl.err) { ret res[project.Project, fail.Fail].err{rl.err}; }
    val rc: err[fail.Fail] = driver.run_codegen_pass(?p);
    if (sel rc.err) { ret res[project.Project, fail.Fail].err{rc.err}; }
    handed = true;
    ret res[project.Project, fail.Fail].ok{p};
}

#[testing]
fun sema_errs(text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret -1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;

    val pr: res[project.Project, fail.Fail] = driver.scaffold_build(?s, ?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1, "");
    if (sel pr.err) { ret -1; }
    var p: project.Project = pr.ok;

    var errs: i32 = diagnostic.error_count(?s.diags)::i32;
    if (errs == 0) {
        errs = -1;
        val sem: err[fail.Fail] = driver.run_sema_pass(?p);
        if (sel sem.ok) { errs = diagnostic.error_count(?s.diags)::i32; }
        or (sel sem.err) {
            if (fail.is_reported(sem.err)) {
                val reported: usize = diagnostic.error_count(?s.diags);
                if (reported > 0) { errs = reported::i32; }
            }
        }
    }

    project.dnit_project(?p);
    ret errs;
}

#[testing]
pub fun sema_clean(text: str) bool {
    ret sema_errs(text) == 0;
}

#[testing]
fun lower_errs(text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret -1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;

    val pr: res[project.Project, fail.Fail] = driver.scaffold_build(?s, ?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1, "");
    if (sel pr.err) { ret -1; }
    var p: project.Project = pr.ok;

    var errs: i32 = diagnostic.error_count(?s.diags)::i32;
    if (errs == 0) {
        errs = -1;
        val sem: err[fail.Fail] = driver.run_sema_pass(?p);
        if (sel sem.ok) {
            val low: err[fail.Fail] = driver.run_lower_pass(?p);
            errs = diagnostic.error_count(?s.diags)::i32;
            if (sel low.err && errs == 0) { errs = 1; }
        }
    }

    project.dnit_project(?p);
    ret errs;
}

#[testing]
pub fun lower_clean(text: str) bool {
    ret lower_errs(text) == 0;
}

#[testing]
pub fun sema_rejects(text: str) bool {
    ret sema_errs(text) > 0;
}

#[testing]
pub fun sema_rejects_with(text: str, needle: str) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = text;

    val pr: res[project.Project, fail.Fail] = driver.scaffold_build(?s, ?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1, "");
    if (sel pr.err) {
        ret fail.is_reported(pr.err)
            && diagnostic.error_says(?s.diags, needle);
    }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    val sem: err[fail.Fail] = driver.run_sema_pass(?p);
    ret sel sem.err
        && fail.is_reported(sem.err)
        && diagnostic.error_says(?s.diags, needle);
}

