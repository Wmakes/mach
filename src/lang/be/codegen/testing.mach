# the same through a chosen optimization level, so the release pipeline's SROA and mem2reg run before inspection
#[testing]
pub fun vec_lower_opt(s: *session.Session, alloc: *A.Allocator, src: str, target_name: str, found: pipeline.OptLevel) res[project.Project, fail.Fail] {
    ret vec_lower_req(s, alloc, src, target_name, found, false);
}

# the same with the loop vectorizer on or off, whatever the profile says
#[testing]
pub fun vec_lower_req(s: *session.Session, alloc: *A.Allocator, src: str, target_name: str, found: pipeline.OptLevel, vectorize: bool) res[project.Project, fail.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = driver.scaffold(alloc, manifest_spirv(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret res[project.Project, fail.Fail].err{root_r.err}; }
    val root: str                             = root_r.ok;
    var tsel: manifest.Selectors              = manifest.t_selectors("", target_name, "");
    val pr:   res[project.Project, fail.Fail] = driver.build_project(s, root, ?tsel);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p:      project.Project = pr.ok;
    var handed: bool            = false;
    fin {
        if (!handed) { project.dnit_project(?p); }
    }
    var req: request.BuildRequest = p.req;
    req.opt = found;
    if (!vectorize) {
        val at: opt[usize] = pipeline.pass_named("vectorize");
        if (sel at.some) { pipeline.set_add(?req.skips, at.some); }
    }
    val reconfigured: err[fail.Fail] = driver.reconfigure(?p, req);
    if (sel reconfigured.err) { ret res[project.Project, fail.Fail].err{reconfigured.err}; }
    val se: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) { ret res[project.Project, fail.Fail].err{se.err}; }
    val le: err[fail.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) { ret res[project.Project, fail.Fail].err{le.err}; }
    handed = true;
    ret res[project.Project, fail.Fail].ok{p};
}

#[testing]
pub fun count_vector_typed_instrs(p: *project.Project) u32 {
    var n:  u32 = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *me_ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *me_ir.Function = ?m.functions[fi];
                var bi: u32             = 0;
                for (bi < fn.block_count) {
                    val blk: *me_ir.Block = ?fn.blocks[bi];
                    var ix:  u32          = 0;
                    for (ix < blk.instr_count) {
                        val ins: *ir_instruction.Instruction = ?fn.instrs[ir_id.instruction_index(blk.instructions[ix])];
                        if (ir_type.is_vector(?m.types, ins.ty)) { n = n + 1; }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    ret n;
}

