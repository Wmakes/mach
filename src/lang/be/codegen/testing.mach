#[testing]
pub fun sema_rejects_at(src: str, needle: str, want_offset: usize, want_len: usize) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, fail.Fail] = driver.scaffold_build(?s, ?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1, "");
    if (sel pr.err) { ret false; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    val se: err[fail.Fail] = driver.run_sema_pass(?p);
    if (!(sel se.err && fail.is_reported(se.err))) { ret false; }
    var i: usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (diagnostic_kind.is_error(d.kind)
            && str_contains(d.message, needle)
            && d.loc.span.offset == want_offset
            && d.loc.span.len == want_len) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
pub fun vec_sema(s: *session.Session, alloc: *A.Allocator, src: str) res[project.Project, fail.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    ret vec_sema_n(s, alloc, ?names[0], ?texts[0], 1);
}

#[testing]
pub fun vec_sema_n(s: *session.Session, alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[project.Project, fail.Fail] {
    val pr: res[project.Project, fail.Fail] = driver.scaffold_build(s, alloc, driver.fixture_manifest(), names, texts, n, "");
    if (sel pr.err) { ret pr; }
    var p:  project.Project = pr.ok;
    val se: err[fail.Fail]  = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, fail.Fail].err{se.err};
    }
    ret res[project.Project, fail.Fail].ok{p};
}

#[testing]
fun vec_diagnostic_n(names: *str, texts: *str, n: u32, needle: str, note: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, fail.Fail] = driver.scaffold_build(?s, ?alloc, driver.fixture_manifest(), names, texts, n, "");
    if (sel pr.err) {
        if (!fail.is_reported(pr.err)) { ret 1; }
        if (note) {
            if (diagnostic.note_says(?s.diags, needle)) { ret 0; }
        }
        or {
            if (diagnostic.error_says(?s.diags, needle)) { ret 0; }
        }
        ret 1;
    }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val checked: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel checked.ok) {
        if (!note) { ret 1; }
    }
    or (sel checked.err) {
        if (!fail.is_reported(checked.err)) { ret 1; }
    }
    var hit: bool = diagnostic.error_says(?s.diags, needle);
    if (note) { hit = diagnostic.note_says(?s.diags, needle); }
    if (hit)  { ret 0; }
    var di: usize = 0;
    for (di < diagnostic.len(?s.diags)) {
        print.println(s.diags.items.data[di].message);
        di = di + 1;
    }
    ret 1;
}

#[testing]
pub fun vec_diag(src: str, needle: str) i32 {
    var names: [1]str = [1]str{"main.mach"};
    var texts: [1]str = [1]str{src};
    ret vec_diagnostic_n(?names[0], ?texts[0], 1, needle, false);
}

#[testing]
def CodegenTestPhase: u8;

#[testing]
pub val CODEGEN_TEST_SETUP: CodegenTestPhase = 0;

#[testing]
val CODEGEN_TEST_SEMA: CodegenTestPhase = 1;

#[testing]
val CODEGEN_TEST_LOWER: CodegenTestPhase = 2;

#[testing]
val CODEGEN_TEST_SELECT: CodegenTestPhase = 3;

#[testing]
val CODEGEN_TEST_CODEGEN: CodegenTestPhase = 4;

#[testing]
val CODEGEN_TEST_ARTIFACT: CodegenTestPhase = 5;

#[testing]
def CodegenTestStatus: u8;

#[testing]
pub val CODEGEN_TEST_SETUP_FAILURE: CodegenTestStatus = 0;

#[testing]
val CODEGEN_TEST_TARGET_UNAVAILABLE: CodegenTestStatus = 1;

#[testing]
val CODEGEN_TEST_EMPTY_SELECTION: CodegenTestStatus = 2;

#[testing]
val CODEGEN_TEST_NAMED_CASE_MISSING: CodegenTestStatus = 3;

#[testing]
val CODEGEN_TEST_NAMED_CASE_EXECUTED: CodegenTestStatus = 4;

#[testing]
val CODEGEN_TEST_EXPECTED_EXCLUSION: CodegenTestStatus = 5;

#[testing]
val CODEGEN_TEST_COMPILER_REJECTION: CodegenTestStatus = 6;

#[testing]
val CODEGEN_TEST_ARTIFACT_FAILURE: CodegenTestStatus = 7;

#[testing]
val CODEGEN_TEST_PASS: CodegenTestStatus = 8;

#[testing]
def CodegenTestExpected: u8;

#[testing]
pub val CODEGEN_EXPECT_PASS: CodegenTestExpected = 0;

#[testing]
pub val CODEGEN_EXPECT_EXCLUSION: CodegenTestExpected = 1;

#[testing]
pub def CodegenTestCase: u8;

#[testing]
pub val CODEGEN_CASE_NONE: CodegenTestCase = 0;

#[testing]
pub val CODEGEN_CASE_VECTOR_ADD: CodegenTestCase = 1;

#[testing]
pub val CODEGEN_CASE_VECTOR_BUILD: CodegenTestCase = 2;

#[testing]
pub val CODEGEN_CASE_PUBLIC_MUL: CodegenTestCase = 3;

#[testing]
pub val CODEGEN_CASE_DECLASSIFIED_MUL: CodegenTestCase = 4;

#[testing]
pub val CODEGEN_CASE_MEMZERO: CodegenTestCase = 5;

#[testing]
pub val CODEGEN_CASE_PUBLIC_SHIFT: CodegenTestCase = 6;

#[testing]
pub val CODEGEN_CASE_SECRET_SHIFT: CodegenTestCase = 7;

#[testing]
val CODEGEN_CASE_WIDE_SECRET_RETURN: CodegenTestCase = 8;

#[testing]
val CODEGEN_CASE_WIDE_SECRET_CALL: CodegenTestCase = 9;

#[testing]
val CODEGEN_CASE_SECRET_MEMORY_ADDRESS: CodegenTestCase = 10;

#[testing]
pub val CODEGEN_CASE_SECRET_MUL: CodegenTestCase = 11;

#[testing]
pub rec CodegenTestOutcome {
    status:    CodegenTestStatus;
    phase:     CodegenTestPhase;
    case_id:   CodegenTestCase;
    case_name: str;
}

#[testing]
pub fun codegen_outcome(status: CodegenTestStatus, phase: CodegenTestPhase,
    case_id: CodegenTestCase, case_name: str) CodegenTestOutcome {
    var out: CodegenTestOutcome;
    out.status    = status;
    out.phase     = phase;
    out.case_id   = case_id;
    out.case_name = case_name;
    ret out;
}

#[testing]
fun codegen_phase_name(phase: CodegenTestPhase) str {
    if (phase == CODEGEN_TEST_SETUP)    { ret "setup"; }
    if (phase == CODEGEN_TEST_SEMA)     { ret "sema"; }
    if (phase == CODEGEN_TEST_LOWER)    { ret "lower"; }
    if (phase == CODEGEN_TEST_SELECT)   { ret "selection"; }
    if (phase == CODEGEN_TEST_CODEGEN)  { ret "codegen"; }
    if (phase == CODEGEN_TEST_ARTIFACT) { ret "artifact"; }
    ret "unknown";
}

#[testing]
fun codegen_status_name(status: CodegenTestStatus) str {
    if (status == CODEGEN_TEST_SETUP_FAILURE)       { ret "setup failure"; }
    if (status == CODEGEN_TEST_TARGET_UNAVAILABLE)  { ret "target unavailable"; }
    if (status == CODEGEN_TEST_EMPTY_SELECTION)     { ret "empty selection"; }
    if (status == CODEGEN_TEST_NAMED_CASE_MISSING)  { ret "named case missing"; }
    if (status == CODEGEN_TEST_NAMED_CASE_EXECUTED) { ret "excluded case executed"; }
    if (status == CODEGEN_TEST_EXPECTED_EXCLUSION)  { ret "expected exclusion"; }
    if (status == CODEGEN_TEST_COMPILER_REJECTION)  { ret "compiler rejection"; }
    if (status == CODEGEN_TEST_ARTIFACT_FAILURE)    { ret "artifact failure"; }
    if (status == CODEGEN_TEST_PASS)                { ret "pass"; }
    ret "unknown";
}

#[testing]
fun codegen_expected_name(expected: CodegenTestExpected) str {
    if (expected == CODEGEN_EXPECT_PASS)      { ret "generated artifact"; }
    if (expected == CODEGEN_EXPECT_EXCLUSION) { ret "generated artifact without excluded case"; }
    ret "unknown";
}

#[testing]
fun codegen_outcome_matches(got: CodegenTestOutcome, expected: CodegenTestExpected,
    case_id: CodegenTestCase) bool {
    if (got.case_id != case_id || got.phase != CODEGEN_TEST_ARTIFACT) { ret false; }
    if (expected == CODEGEN_EXPECT_PASS)                              { ret got.status == CODEGEN_TEST_PASS; }
    if (expected == CODEGEN_EXPECT_EXCLUSION)                         { ret got.status == CODEGEN_TEST_EXPECTED_EXCLUSION; }
    ret false;
}

#[testing]
pub fun codegen_result(got: CodegenTestOutcome, expected: CodegenTestExpected,
    case_id: CodegenTestCase) i32 {
    if (codegen_outcome_matches(got, expected, case_id)) { ret 0; }
    print.eprintlnf("codegen oracle '{}': expected {}, reached {} with {}",
        got.case_name, codegen_expected_name(expected), codegen_phase_name(got.phase),
        codegen_status_name(got.status));
    ret 1;
}

#[testing]
fun codegen_case_selected(p: *project.Project, case_id: CodegenTestCase) bool {
    if (case_id == CODEGEN_CASE_NONE) { ret false; }
    var saw_public_mul: bool = false;
    var saw_declassify: bool = false;
    var ti:             u32  = 0;
    for (ti < p.topo_len) {
        val m: *me_ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *me_ir.Function = ?m.functions[fi];
                var ii: u32             = 0;
                for (ii < fn.instr_len) {
                    val ins: *ir_instruction.Instruction = ?fn.instrs[ii];
                    if (ins.kind == ir_instruction.OP_DECLASSIFY) { saw_declassify = true; }

                    var operands_public: bool = true;
                    var oi:              u32  = 0;
                    for (oi < ins.operand_count) {
                        if (ins.operands[oi].secret) { operands_public = false; }
                        oi = oi + 1;
                    }
                    if (ins.kind == ir_instruction.OP_MUL && !ins.secret && operands_public) {
                        saw_public_mul = true;
                    }
                    if (case_id == CODEGEN_CASE_SECRET_MUL
                        && ins.kind == ir_instruction.OP_MUL && !operands_public) { ret true; }

                    if (case_id == CODEGEN_CASE_VECTOR_ADD
                        && ins.kind == ir_instruction.OP_ADD
                        && ir_type.is_vector(?m.types, ins.ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == ir_instruction.OP_VEC_BUILD) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == ir_instruction.OP_STORE && ins.operand_count >= 1
                        && ins.operands[0].kind == value.VAL_CONST_AGG
                        && ir_type.is_vector(?m.types, ins.operands[0].ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_VECTOR_BUILD
                        && ins.kind == ir_instruction.OP_LOAD
                        && ir_type.is_vector(?m.types, ins.ty)) { ret true; }
                    if (case_id == CODEGEN_CASE_PUBLIC_MUL && saw_public_mul) { ret true; }
                    if (case_id == CODEGEN_CASE_MEMZERO
                        && ins.kind == ir_instruction.OP_MEMZERO) { ret true; }
                    if ((case_id == CODEGEN_CASE_PUBLIC_SHIFT || case_id == CODEGEN_CASE_SECRET_SHIFT)
                        && (ins.kind == ir_instruction.OP_SHL || ins.kind == ir_instruction.OP_SHR_S
                        || ins.kind == ir_instruction.OP_SHR_U)
                        && ins.operand_count >= 2) {
                        val count_secret: bool = ins.operands[1].secret;
                        if (case_id == CODEGEN_CASE_SECRET_SHIFT && count_secret)  { ret true; }
                        if (case_id == CODEGEN_CASE_PUBLIC_SHIFT && !count_secret) { ret true; }
                    }
                    if (case_id == CODEGEN_CASE_WIDE_SECRET_RETURN
                        && ins.kind == ir_instruction.OP_RET && ins.operand_count >= 1
                        && ins.operands[0].secret
                        && ir_type.byte_size_for_machine(?m.types, ins.operands[0].ty, resolved.layout_machine(?p.target.target))
                        > p.target.isa.pointer_width) { ret true; }
                    if (case_id == CODEGEN_CASE_WIDE_SECRET_CALL
                        && ins.kind == ir_instruction.OP_CALL && ins.secret
                        && ir_type.byte_size_for_machine(?m.types, ins.ty, resolved.layout_machine(?p.target.target))
                        > p.target.isa.pointer_width) { ret true; }
                    if (case_id == CODEGEN_CASE_SECRET_MEMORY_ADDRESS) {
                        if (ins.kind == ir_instruction.OP_LOAD && ins.operand_count >= 1
                            && ins.operands[0].secret) { ret true; }
                        if (ins.kind == ir_instruction.OP_STORE && ins.operand_count >= 2
                            && ins.operands[1].secret) { ret true; }
                        if (ins.kind == ir_instruction.OP_MEMZERO && ins.operand_count >= 1
                            && ins.operands[0].secret) { ret true; }
                    }
                    ii = ii + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    if (case_id == CODEGEN_CASE_DECLASSIFIED_MUL) {
        ret saw_declassify && saw_public_mul;
    }
    ret false;
}

#[testing]
fun codegen_artifact_valid(p: *project.Project) bool {
    if (p.emit_len == 0) { ret false; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.object_image == nil || m.object_image.sections == nil
            || m.object_image.section_count == 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
pub fun run_codegen_case(p: *project.Project, case_name: str, case_id: CodegenTestCase,
    excluded: CodegenTestCase, expected: CodegenTestExpected) CodegenTestOutcome {
    val se: err[fail.Fail] = driver.run_sema_pass(p);
    if (sel se.err) {
        ret codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_SEMA, case_id, case_name);
    }
    val le: err[fail.Fail] = driver.run_lower_pass(p);
    if (sel le.err) {
        ret codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_LOWER, case_id, case_name);
    }
    if (p.emit_len == 0) {
        ret codegen_outcome(CODEGEN_TEST_EMPTY_SELECTION, CODEGEN_TEST_SELECT, case_id, case_name);
    }
    if (!codegen_case_selected(p, case_id)) {
        ret codegen_outcome(CODEGEN_TEST_NAMED_CASE_MISSING, CODEGEN_TEST_SELECT, case_id, case_name);
    }
    if (expected == CODEGEN_EXPECT_EXCLUSION
        && (excluded == CODEGEN_CASE_NONE || codegen_case_selected(p, excluded))) {
        ret codegen_outcome(CODEGEN_TEST_NAMED_CASE_EXECUTED, CODEGEN_TEST_SELECT, case_id, case_name);
    }

    val ce: err[fail.Fail] = driver.run_codegen_pass(p);
    if (sel ce.err) {
        ret codegen_outcome(CODEGEN_TEST_COMPILER_REJECTION, CODEGEN_TEST_CODEGEN, case_id, case_name);
    }
    if (!codegen_artifact_valid(p)) {
        ret codegen_outcome(CODEGEN_TEST_ARTIFACT_FAILURE, CODEGEN_TEST_ARTIFACT, case_id, case_name);
    }
    if (expected == CODEGEN_EXPECT_EXCLUSION) {
        ret codegen_outcome(CODEGEN_TEST_EXPECTED_EXCLUSION, CODEGEN_TEST_ARTIFACT, case_id, case_name);
    }
    ret codegen_outcome(CODEGEN_TEST_PASS, CODEGEN_TEST_ARTIFACT, case_id, case_name);
}

#[testing]
pub fun vec_codegen_defined(src: str, case_name: str, case_id: CodegenTestCase) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) {
        ret codegen_result(codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) {
        ret codegen_result(codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, fail.Fail] = driver.scaffold_build(?s, ?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1, "");
    if (sel pr.err) {
        ret codegen_result(codegen_outcome(CODEGEN_TEST_SETUP_FAILURE, CODEGEN_TEST_SETUP,
            case_id, case_name), CODEGEN_EXPECT_PASS, case_id);
    }
    var p:   project.Project    = pr.ok;
    val got: CodegenTestOutcome = run_codegen_case(?p, case_name, case_id,
        CODEGEN_CASE_NONE, CODEGEN_EXPECT_PASS);
    project.dnit_project(?p);
    ret codegen_result(got, CODEGEN_EXPECT_PASS, case_id);
}

# codegen rejects the program: the pass answers `reported` and the refusal is
# an error on the session's diagnostic store, never text on the failure
#[testing]
pub fun run_codegen_err(p: *project.Project, needle: str) i32 {
    val se: err[fail.Fail] = driver.run_sema_pass(p);
    if (sel se.err) { ret 1; }
    val le: err[fail.Fail] = driver.run_lower_pass(p);
    if (sel le.err) { ret 1; }
    val ce: err[fail.Fail] = driver.run_codegen_pass(p);
    if (sel ce.ok)                                  { ret 1; }
    if (!fail.is_reported(ce.err))                  { ret 2; }
    if (diagnostic.error_count(?p.s.diags) == 0)    { ret 3; }
    if (!diagnostic.error_says(?p.s.diags, needle)) { ret 4; }
    ret 0;
}

#[testing]
pub fun run_codegen_ok(p: *project.Project) i32 {
    val se: err[fail.Fail] = driver.run_sema_pass(p);
    if (sel se.err) { ret 1; }
    val le: err[fail.Fail] = driver.run_lower_pass(p);
    if (sel le.err) { ret 1; }
    val ce: err[fail.Fail] = driver.run_codegen_pass(p);
    if (sel ce.err) { ret 1; }
    ret 0;
}

#[testing]
pub fun codegen_target_ok(src: str, target_name: str) i32 {
    ret codegen_profile_ok(src, target_name, "");
}

#[testing]
pub fun codegen_profile_ok(src: str, target_name: str, profile: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root:      str                             = root_r.ok;
    var tsel_1773: manifest.Selectors              = manifest.t_selectors("", target_name, profile);
    val pr:        res[project.Project, fail.Fail] = driver.build_project(?s, root, ?tsel_1773);
    fs.remove_all(?alloc, root);
    if (sel pr.err) { ret 1; }
    var p: project.Project = pr.ok;

    val code: i32 = run_codegen_ok(?p);
    project.dnit_project(?p);
    ret code;
}

#[testing]
pub fun codegen_profile_rejects(src: str, target_name: str, profile: str, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = driver.scaffold(?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root:      str                             = root_r.ok;
    var tsel_1821: manifest.Selectors              = manifest.t_selectors("", target_name, profile);
    val pr:        res[project.Project, fail.Fail] = driver.build_project(?s, root, ?tsel_1821);
    fs.remove_all(?alloc, root);
    if (sel pr.err) { ret 1; }
    var p: project.Project = pr.ok;

    val code: i32 = run_codegen_err(?p, needle);
    project.dnit_project(?p);
    ret code;
}

#[testing]
pub fun lower_rejects(src: str, needle: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val pr: res[project.Project, fail.Fail] = driver.scaffold_build(?s, ?alloc, driver.fixture_manifest(), ?names[0], ?texts[0], 1, "");
    if (sel pr.err) { ret 1; }
    var p: project.Project = pr.ok;

    var code: i32            = 1;
    val se:   err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel se.ok) {
        val le: err[fail.Fail] = driver.run_lower_pass(?p);
        if (sel le.err && diagnostic.error_says(?p.s.diags, needle)) { code = 0; }
    }
    project.dnit_project(?p);
    ret code;
}

