# the language reference as a test reads it to hold a page to the compiler's own
# tables: its pages read whole from the project root, and the markdown shapes
# those tests read, a production of grammar.md, a table, a code span
#
# a test reads the list a page copies and the table it copies it from, and fails
# naming the first word that is in one and not the other
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A:  std.allocator;
use fs: std.filesystem;
use std.print;
use types_path: std.types.path;

use mach.lang.checkout;
use lang_source: mach.lang.source;

# the page at `path`, relative to the project root, read whole; none when it cannot be read
#[testing]
pub fun page(alloc: *A.Allocator, path: str) opt[str] {
    val at: opt[str] = checkout.root(alloc);
    if (sel at.none) { ret opt[str].none{}; }
    val full: res[str, A.Error] = types_path.join(alloc, at.some, path);
    if (sel full.err) { ret opt[str].none{}; }
    val text: res[str, fs.FsError] = fs.read_string(alloc, full.ok);
    if (sel text.err) { ret opt[str].none{}; }
    ret opt[str].some{text.ok};
}

# the offset of the first `needle` at or after `from`; the text's length when there is none
#[testing]
pub fun find(text: str, from: usize, needle: str) usize {
    val n:  usize = str_len(text);
    val nl: usize = str_len(needle);
    var p:  usize = from;
    for (p + nl <= n) {
        if (str_region_equals(text, p, nl, needle)) { ret p; }
        p = p + 1;
    }
    ret n;
}

# the offset just past the line that `at` stands in, its newline included
#[testing]
pub fun line_next(text: str, at: usize) usize {
    val n: usize = str_len(text);
    var p: usize = at;
    for (p < n && text[p] != '\n') { p = p + 1; }
    if (p < n) { ret p + 1; }
    ret n;
}

# whether `sp` of `text` spells exactly `s`, reading a table's escaped `\|` as `|`
#[testing]
pub fun spells(text: str, sp: lang_source.Span, s: str) bool {
    val n: usize = str_len(s);
    var p: usize = sp.offset;
    var k: usize = 0;
    for (p < sp.offset + sp.len) {
        if (text[p] == '\\' && p + 1 < sp.offset + sp.len && text[p + 1] == '|') { p = p + 1; }
        if (k >= n || text[p] != s[k])                                           { ret false; }
        p = p + 1;
        k = k + 1;
    }
    ret k == n;
}

# a copy of `sp` of `text`, for a failing test's report
#[testing]
pub fun spelled(alloc: *A.Allocator, text: str, sp: lang_source.Span) str {
    val made: res[*u8, A.Error] = A.allocate[u8](alloc, sp.len + 1);
    if (sel made.err) { ret "(out of memory)"; }
    val buf: *u8   = made.ok;
    var i:   usize = 0;
    for (i < sp.len) {
        buf[i] = text[sp.offset + i]::u8;
        i      = i + 1;
    }
    buf[sp.len] = 0;
    ret buf::str;
}

# the heading level of the line at `at`, 0 when it is no heading
#[testing]
fun heading_level(text: str, at: usize) usize {
    var p: usize = at;
    for (text[p] == '#') { p = p + 1; }
    if (p == at || text[p] != ' ') { ret 0; }
    ret p - at;
}

# the body of the section whose heading line is exactly `title`, as "## Keys": from
# the line after it to the next heading of its level or above, outside code blocks
#[testing]
pub fun section(text: str, title: str) opt[lang_source.Span] {
    val n:     usize = str_len(text);
    val tl:    usize = str_len(title);
    var at:    usize = 0;
    var fence: bool  = false;
    var level: usize = 0;
    var start: usize = 0;
    for (at < n) {
        val next: usize = line_next(text, at);
        if (str_region_equals(text, at, 3, "```")) { fence = !fence; }
        or (!fence) {
            val l: usize = heading_level(text, at);
            if (level != 0 && l != 0 && l <= level) {
                ret opt[lang_source.Span].some{lang_source.Span{offset: start, len: at - start}};
            }
            if (level == 0 && l != 0 && str_region_equals(text, at, tl, title) && (text[at + tl] == '\n' || at + tl == n)) {
                level = l;
                start = next;
            }
        }
        at = next;
    }
    if (level == 0) { ret opt[lang_source.Span].none{}; }
    ret opt[lang_source.Span].some{lang_source.Span{offset: start, len: n - start}};
}

# the next `"..."` terminal of a production from `at` up to `end`, its quotes
# left out; an annotation `(* ... *)` is passed over
#[testing]
fun terminal_next(text: str, at: *usize, end: usize, out: *lang_source.Span) bool {
    var p: usize = @at;
    for (p < end) {
        if (text[p] == '(' && text[p + 1] == '*') {
            p = find(text, p + 2, "*)") + 2;
            cnt;
        }
        if (text[p] == '"') {
            var e: usize = p + 1;
            for (e < end && text[e] != '"') { e = e + 1; }
            if (e >= end) { ret false; }
            @out = lang_source.Span{offset: p + 1, len: e - p - 1};
            @at  = e + 1;
            ret true;
        }
        p = p + 1;
    }
    @at = end;
    ret false;
}

# the next code span `` `...` `` from `at` up to `end`, its backticks left out
#[testing]
pub fun code_next(text: str, at: *usize, end: usize, out: *lang_source.Span) bool {
    var p: usize = @at;
    for (p < end) {
        if (text[p] == '`') {
            var e: usize = p + 1;
            for (e < end && text[e] != '`' && text[e] != '\n') { e = e + 1; }
            if (e >= end || text[e] != '`') { ret false; }
            @out = lang_source.Span{offset: p + 1, len: e - p - 1};
            @at  = e + 1;
            ret true;
        }
        p = p + 1;
    }
    @at = end;
    ret false;
}

# the rows of the table whose header line begins `header` at or after `from`:
# the lines after its separator, up to the first line that is not a row
#[testing]
pub fun table(text: str, from: usize, header: str) opt[lang_source.Span] {
    val n:  usize = str_len(text);
    var at: usize = find(text, from, header);
    for (at < n && at > 0 && text[at - 1] != '\n') { at = find(text, at + 1, header); }
    if (at >= n) { ret opt[lang_source.Span].none{}; }
    val start: usize = line_next(text, line_next(text, at));
    var end:   usize = start;
    for (end < n && text[end] == '|') { end = line_next(text, end); }
    ret opt[lang_source.Span].some{lang_source.Span{offset: start, len: end - start}};
}

# the next row of a table body from `at`, as the span of its line
#[testing]
pub fun row_next(text: str, at: *usize, end: usize, out: *lang_source.Span) bool {
    val p: usize = @at;
    if (p >= end) { ret false; }
    val next: usize = line_next(text, p);
    @out = lang_source.Span{offset: p, len: next - p};
    @at  = next;
    ret true;
}

# the `index`th cell of the row `row`, from 0, trimmed of blanks; none past its last
#[testing]
pub fun cell(text: str, row: lang_source.Span, index: usize) opt[lang_source.Span] {
    val end: usize = row.offset + row.len;
    var p:   usize = row.offset + 1;
    var k:   usize = 0;
    for (p < end) {
        var e: usize = p;
        for (e < end && text[e] != '|' && text[e] != '\n') {
            if (text[e] == '\\') { e = e + 1; }
            e = e + 1;
        }
        if (e >= end || text[e] != '|') { ret opt[lang_source.Span].none{}; }
        if (k == index) {
            var s: usize = p;
            var t: usize = e;
            for (s < t && text[s] == ' ') { s = s + 1; }
            for (t > s && text[t - 1] == ' ') { t = t - 1; }
            ret opt[lang_source.Span].some{lang_source.Span{offset: s, len: t - s}};
        }
        k = k + 1;
        p = e + 1;
    }
    ret opt[lang_source.Span].none{};
}

# how a list writes its words: the quoted terminals of a production, or code spans
#[testing]
def Words: u8;

#[testing]
pub val WORDS_QUOTED: Words = 0;
#[testing]
pub val WORDS_CODE:   Words = 1;

# the next word of `words` from `at` up to `end`
#[testing]
fun word_next(text: str, at: *usize, end: usize, words: Words, out: *lang_source.Span) bool {
    if (words == WORDS_QUOTED) { ret terminal_next(text, at, end, out); }
    ret code_next(text, at, end, out);
}

# the position of the name `sp` spells among the `count` names `names` gives; a
# name of nil is outside the set
#[testing]
pub fun index_of(text: str, sp: lang_source.Span, names: fun(usize) str, count: usize) opt[usize] {
    var i: usize = 0;
    for (i < count) {
        val name: str = names(i);
        if (name != nil && spells(text, sp, name)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# whether the words of `within` are the names `names` gives, each listed once: a
# word that names none of them, a name listed twice and a name not listed each
# fail, reported under `what`. `names` answers nil for a position outside the set
#[testing]
pub fun agree(alloc: *A.Allocator, what: str, text: str, within: lang_source.Span, words: Words, names: fun(usize) str, count: usize) bool {
    val made: res[*u8, A.Error] = A.allocate[u8](alloc, count + 1);
    if (sel made.err) {
        print.eprintlnf("{}: out of memory", what);
        ret false;
    }
    val seen: *u8   = made.ok;
    var i:    usize = 0;
    for (i < count) {
        seen[i] = 0;
        i       = i + 1;
    }
    var at: usize = within.offset;
    var w:  lang_source.Span;
    for (word_next(text, ?at, within.offset + within.len, words, ?w)) {
        val k: opt[usize] = index_of(text, w, names, count);
        if (sel k.none) {
            print.eprintlnf("{}: `{}` is not in the compiler's table", what, spelled(alloc, text, w));
            ret false;
        }
        if (seen[k.some] != 0) {
            print.eprintlnf("{}: `{}` is listed twice", what, spelled(alloc, text, w));
            ret false;
        }
        seen[k.some] = 1;
    }
    i = 0;
    for (i < count) {
        val name: str = names(i);
        if (name != nil && seen[i] == 0) {
            print.eprintlnf("{}: `{}` is in the compiler's table and missing from the page", what, name);
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

# the line that begins with `lead`, from its first offset past `lead` to its end
#[testing]
pub fun line_after(text: str, lead: str) opt[lang_source.Span] {
    val n:  usize = str_len(text);
    var at: usize = find(text, 0, lead);
    for (at < n && at > 0 && text[at - 1] != '\n') { at = find(text, at + 1, lead); }
    if (at >= n) { ret opt[lang_source.Span].none{}; }
    val start: usize = at + str_len(lead);
    var end:   usize = line_next(text, start);
    if (end > start && text[end - 1] == '\n') { end = end - 1; }
    ret opt[lang_source.Span].some{lang_source.Span{offset: start, len: end - start}};
}

# the row of the table body `rows` whose first cell spells `first`
#[testing]
pub fun row_named(text: str, rows: lang_source.Span, first: str) opt[lang_source.Span] {
    var at:   usize = rows.offset;
    var line: lang_source.Span;
    for (row_next(text, ?at, rows.offset + rows.len, ?line)) {
        val c: opt[lang_source.Span] = cell(text, line, 0);
        if (sel c.none)                  { cnt; }
        if (spells(text, c.some, first)) { ret opt[lang_source.Span].some{line}; }
    }
    ret opt[lang_source.Span].none{};
}

# `a`, `b` and `c` written one after another into `buf` of `cap` bytes, cut short
# to fit, and terminated
#[testing]
pub fun joined(buf: *u8, cap: usize, a: str, b: str, c: str) str {
    var o: usize = 0;
    var i: usize = 0;
    for (i < str_len(a) && o + 1 < cap) {
        buf[o] = a[i]::u8;
        o      = o + 1;
        i      = i + 1;
    }
    i = 0;
    for (i < str_len(b) && o + 1 < cap) {
        buf[o] = b[i]::u8;
        o      = o + 1;
        i      = i + 1;
    }
    i = 0;
    for (i < str_len(c) && o + 1 < cap) {
        buf[o] = c[i]::u8;
        o      = o + 1;
        i      = i + 1;
    }
    buf[o] = 0;
    ret buf::str;
}

# the page at `path`, reported on stderr when it cannot be read
#[testing]
pub fun page_or_report(alloc: *A.Allocator, path: str) opt[str] {
    val text: opt[str] = page(alloc, path);
    if (sel text.none) { print.eprintlnf("reference: cannot read {} from the project root", path); }
    ret text;
}
